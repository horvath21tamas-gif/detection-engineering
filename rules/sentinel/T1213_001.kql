DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*/rest/api/space*", "*/rest/api/content*", "*/doexportpage.action*", "*/exportword*", "*pages/viewpage.action*pageId=*", "*/pages/exportpdf.action*", "*/pages/exportword.action*")) and (FolderPath in ("*\curl.exe", "*\wget.exe", "*\powershell.exe", "*\pwsh.exe", "*\python.exe", "*\confluence-cli.exe", "*\node.exe", "*\java.exe")) and (((ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe", "*\rundll32.exe", "*\cmd.exe", "*\taskhostw.exe")) and (IntegrityLevel in ("Medium", "High"))) or (ProcessCommandLine in ("* > *", "* -OutFile *", "* -o *", "*\Users\Public\*", "*\Temp\*", "*\AppData\Local\Temp\*"))) and (not ((FolderPath in ("*C:\Program Files\Atlassian\*", "*C:\Program Files (x86)\Atlassian\*")) or (User in ("NT AUTHORITY\SYSTEM*", "DOMAIN\svc_*", "DOMAIN\backup_*")) or (ProcessCommandLine in ("*confluence-healthcheck*", "*inventory-agent*", "*--version*", "*-help*"))))