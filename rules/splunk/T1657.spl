Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\nircmd.exe", "*\\python.exe", "*\\wscript.exe") CommandLine IN ("*Get-Clipboard*", "*Set-Clipboard*", "*System.Windows.Forms.Clipboard*", "*WriteProcessMemory*", "*regex*") CommandLine IN ("*invoice*", "*payment*", "*bank_statement*", "*iban*", "*.pdf*", "*.xlsx*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\msedge.exe", "*\\chrome.exe") OR Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR Image="*\\Program Files\\*" OR CommandLine IN ("*Inventory*", "*Backup*", "*SignService*"))
