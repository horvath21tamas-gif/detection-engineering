DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\w32tm.exe", "*\tzutil.exe", "*\net.exe", "*\net1.exe")) or (ProcessCommandLine in ("*Get-Date*", "*Get-TimeZone*", "*[System.DateTime]::Now*"))) and ((ProcessCommandLine in ("* /query*", "* /g*", "*time \*")) or ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\httpd.exe", "*\wsmprovhost.exe")) and IntegrityLevel =~ "Medium") or (ProcessCommandLine in ("*findstr*", "*select-string*", "* > *", "*$time =*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\svchost.exe", "*\CcmExec.exe", "*\msiexec.exe", "*\explorer.exe")) or (ProcessCommandLine in ("*Program Files*", "*\AppData\Local\Google\Chrome*"))))