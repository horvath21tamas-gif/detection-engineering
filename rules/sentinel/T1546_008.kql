DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where TargetObject contains "Microsoft\Windows NT\CurrentVersion\SilentProcessExit\" and ((TargetObject endswith "\MonitorProcess" or (TargetObject endswith "\ReportingMode" and Details =~ "0x00000001")) or (Details in ("*powershell*", "*cmd.exe*", "*regsvr32*", "*mshta*", "*\Users\Public\*", "*\AppData\Local\Temp\*", "*cscript*", "*wscript*"))) and (not (((FolderPath in ("*\devenv.exe", "*\windbg.exe", "*\msiexec.exe", "*\trustedinstaller.exe", "*\svchost.exe")) and User =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\WerFault.exe", "*\wermgr.exe"))))