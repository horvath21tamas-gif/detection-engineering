Message IN ("*mount -o remount,rw*", "*mount -uw*", "*config-transaction*") OR Message IN ("*xxd *", "*dd if=*", "*insmod*", "*gdb *", "*setenforce 0*") Message IN ("*/bin/*", "*/sbin/*", "*/lib/modules*", "*/boot/*") NOT (user_name IN ("svc-system-update*", "installer*") OR Message IN ("*show *", "*cat *", "*grep *"))
