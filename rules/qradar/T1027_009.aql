SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%[System.Reflection.Assembly]::Load(%','%Reflection.Emit%','%GetManifestResourceStream%','%LoadModule%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%FromBase64String%','% [byte[]]%','%BitConverter%','%IO.MemoryStream%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.dat%','%.bin%','%.png%','%.resources%')) AND NOT (""Filename"" ILIKE ENUMERATION('C:\Windows\Microsoft.NET\Framework%','C:\Program Files\Common Files\Microsoft Shared\%','C:\Windows\System32\wbem\WmiPrvSE.exe%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%/package%','%/update%','%ngen.exe%'))
