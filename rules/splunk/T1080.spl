TargetFilename IN ("*\\*", "*:\\*") TargetFilename IN ("*.docm", "*.dotm", "*.xlsm", "*.lnk", "*.vbs", "*.ps1", "*.bat", "*.chm") (Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\certutil.exe", "*\\bitsadmin.exe", "*\\curl.exe", "*\\wget.exe") IntegrityLevel="Medium") OR filename=".*\\.(pdf|docx|xlsx|txt)\\.(exe|vbs|ps1|lnk|bat)$" NOT (Image IN ("*\\winword.exe", "*\\excel.exe", "*\\explorer.exe") Image IN ("*C:\\Program Files\\Microsoft Office\\*", "*C:\\Windows\\System32\\msiexec.exe*") username="NT AUTHORITY\\SYSTEM")
