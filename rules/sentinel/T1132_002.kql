DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine =~ "(-bxor|bit\.bxor|\[char\[\]\]|::FromCharacterCode|\.replace\()" and ProcessCommandLine match "(*i)([`]{2,}.*){2,}") or ((ParentProcessName =~ "(winword\.exe|excel\.exe|outlook\.exe|w3wp\.exe)$" and FolderPath =~ "(rundll32\.exe|regsvr32\.exe|colorcpl\.exe)$") and ProcessCommandLine =~ "(-bxor|bit\.bxor|\[char\[\]\]|::FromCharacterCode|\.replace\()")) and (not (ProcessCommandLine =~ "(C:\Program Files\|Microsoft\Exchange|Chocolatey|NuGet)" and UserName =~ "NT AUTHORITY\SYSTEM"))