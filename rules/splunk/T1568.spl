
| rex field=CommandLine "(?<CommandLineMatch>(?i).*[a-z0-9]{18,}\\.(top|xyz|pw|icu|bid|monster|live|club|ga|tk).*)"
| eval CommandLineCondition=if(isnotnull(CommandLineMatch), "true", "false")
| search (CommandLine IN ("*Resolve-DnsName*", "*[System.Net.Dns]::*", "*nslookup*", "*dnscmd*", "* -querytype*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\mshta.exe", "*\\cmd.exe")) OR (CommandLineCondition="true" Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\mshta.exe", "*\\cmd.exe") NOT (CommandLine IN ("*C:\\Program Files\\*", "*Microsoft\\Azure*", "*internal.corp*", "*Check-Connectivity*") OR username="NT AUTHORITY\\SYSTEM"))
