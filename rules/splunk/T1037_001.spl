TargetObject="*\\Environment\\UserInitMprLogonScript*" Details IN ("*powershell*", "*pwsh*", "*cmd.exe*", "*mshta*", "*cscript*", "*wscript*", "*rundll32*", "*regsvr32*", "*bitsadmin*") OR Details IN ("*:\\Users\\*", "*:\\ProgramData\\*", "*:\\Temp\\*", "*:\\Windows\\Temp\\*", "*AppData\\*", "*C:\\PerfLogs\\*") NOT (Image IN ("*\\System32\\gpupdate.exe", "*\\System32\\reg.exe", "*\\trustedinstaller.exe", "*\\System32\\svchost.exe") OR (Details IN ("*\\NETLOGON\\*", "*C:\\Windows\\System32\\GroupPolicy\\*") Details IN ("C:\\Program Files\\*", "C:\\Program Files (x86)\\*")))
