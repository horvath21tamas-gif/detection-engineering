DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*\.\PhysicalDrive*", "*\.\Harddisk*", "*\.\Volume{*")) and ((FolderPath endswith "\dd.exe" and (ProcessCommandLine in ("*if=/dev/zero*", "*if=/dev/urandom*", "*of=\.\PhysicalDrive*", "*of=\.\Harddisk*"))) or (FolderPath endswith "\sdelete.exe" and (ProcessCommandLine in ("* -z*", "* -p *", "* -c *"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Clear-Disk*", "*-RemoveData*"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Format-Volume*", "*-Force*", "*-Confirm:$false*"))))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe", "*\httpd.exe", "*\rundll32.exe", "*\mshta.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*"))) and (not (User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe", "*\vds.exe")))) and (not ((ParentProcessName in ("*\CcmExec.exe", "*\msiexec.exe", "*\setup.exe")) and (ParentProcessName in ("*\ConfigurationManager\*", "*\IntuneManagementExtension\*")))) and (not (FolderPath in ("C:\Program Files\*", "C:\Program Files (x86)\*")))