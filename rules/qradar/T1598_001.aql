SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\outlook.exe','%\teams.exe','%\slack.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%redirect_uri=%','%client_id=%','%response_type=token%','%login_hint=%','%verify-account%','%password-reset%','%azure-edge.net%')) OR (""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%--incognito%','%--inprivate%','%--new-window%','%--headless%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%redirect_uri=%','%client_id=%','%response_type=token%','%login_hint=%','%verify-account%','%password-reset%','%azure-edge.net%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%login.microsoftonline.com%','%okta.com%','%duosecurity.com%','%auth.%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%office.com/setup%','%akamai.net%','%windowsupdate.com%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%.local%','%.lan%','%http://10.%','%http://192.168.%'))
