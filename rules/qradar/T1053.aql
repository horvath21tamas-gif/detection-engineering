SELECT UTF8(payload) as search_payload from events where ("Image" LIKE ('%\schtasks.exe','%\at.exe','%\powershell.exe','%\cmd.exe')) AND ("Process CommandLine" LIKE ('%schtasks%','%/create%','%/sc%','%Register-ScheduledTask%','%New-ScheduledTask%','%at %')) AND ("Process CommandLine" LIKE ('%\AppData\%','%\Users\Public\%','%\ProgramData\%','%\Temp\%','%powershell%','%cmd.exe%','%wscript%','%cscript%','%mshta%','%rundll32%','%.ps1%','%.vbs%','%.js%')) AND NOT ("username" LIKE ('%SYSTEM%','%LOCAL SERVICE%','%NETWORK SERVICE%') OR "Process CommandLine" LIKE ('%\Microsoft\Windows\%','%Windows Defender%','%OneDrive%','%GoogleUpdate%','%Adobe%'))
