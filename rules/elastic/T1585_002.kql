(Operation:(New\-Mailbox OR Add\-MailboxPermission OR Set\-Mailbox OR New\-InboxRule)) AND ((Parameters:(*AccessRights\=FullAccess* OR *ForwardingAddress* OR *ForwardingSmtpAddress* OR *DeliverToMailboxAndForward\=True*)) OR (ClientInfoString:(*Client\=Microsoft.Exchange.Management* OR *PowerShell* OR *Custom\-Context\-Script*))) AND (NOT (ClientInfoString:*Client\=MSExchangeRPC* OR (UserId:(*SVC_Okta* OR *AzureADConnect* OR *Sync_*))))
