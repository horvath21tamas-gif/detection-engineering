(Image="*\\attrib.exe" CommandLine="* +s*") OR CommandLine IN ("* > *:*", "*type *:*", "*expand *:*", "*makecab *:*") OR (Image="*\\reg.exe" CommandLine IN ("*SpecialAccounts\\UserList*", "* /d 0*")) ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\mshta.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\browser.exe", "*\\chrome.exe") OR CommandLine IN ("*\\Users\\Public\\*", "*\\Windows\\Temp\\*", "*\\AppData\\Roaming\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\Windows\\servicing\\TrustedInstaller.exe*", "*\\CcmExec.exe*") OR CommandLine IN ("*AppData\\Local\\Packages*", "*desktop.ini*"))
