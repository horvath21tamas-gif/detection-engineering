SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%/.env%','%/.git/%','%/.ssh/%','%/config.php%','%/web.config%','%/settings.py%','%/.aws/credentials%') OR ""Filename"" ILIKE ENUMERATION('%\ffuf.exe','%\gobuster.exe','%\dirsearch.exe','%\nikto.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% -wordlist%','% -w %','% --threads%','% -recursive%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% --banner%','% --header "User-Agent:%','%whatweb%','%Wappalyzer%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%localhost:%','%127.0.0.1%','%::1%','%.local%','%.test%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe')) AND NOT (""Filename"" ILIKE ENUMERATION('%\OneDrive.exe','%\Dropbox.exe','%\Teams.exe'))
