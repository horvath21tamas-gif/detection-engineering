DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\wmic.exe", "*\reg.exe")) or (ProcessCommandLine in ("*Get-Package*", "*Get-ItemProperty*", "*product get name*", "*software list*"))) and ((ProcessCommandLine in ("*defender*", "*sentinel*", "*crowdstrike*", "*falcon*", "*carbonblack*", "*fireeye*", "*tanium*", "*sophos*", "*symantec*", "*kaspersky*", "*mcafee*")) or (ProcessCommandLine in ("* > *", "*ConvertTo-Json*", "*Export-Csv*", "*findstr*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe")) and IntegrityLevel =~ "Medium")) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\CcmExec.exe", "*\svchost.exe", "*\msiexec.exe")) or (ProcessCommandLine in ("*Program Files*", "*Google\Update*"))))