SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%Services\W32Time\TimeProviders\%' AND "Target Object" ILIKE '%DllName' AND (NOT (("Target Details" LIKE '%w32time.dll%' OR "Target Details" LIKE '%vmictimeprovider.dll%')) OR ("Target Details" LIKE '%:\\%' OR "Target Details" LIKE '%\\%' OR "Target Details" LIKE '%AppData%' OR "Target Details" LIKE '%Temp%' OR "Target Details" LIKE '%C:\\Users\\%')) AND NOT ""Filename"" ILIKE '%\trustedinstaller.exe'
