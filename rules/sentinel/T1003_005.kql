DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*cachedump*", "*lsadump::cache*", "*Get-CachedCredentials*", "*dcc2*")) or (FolderPath endswith "\reg.exe" and (ProcessCommandLine in ("* save *", "*hklm\security*", "*\cache*")))) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\wsmprovhost.exe", "*\psexesvc.exe", "*\wmiprvse.exe")) or (ProcessCommandLine in ("*.tmp*", "*.log*", "*C:\Users\Public\*", "*C:\Windows\Temp\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) and ParentProcessName endswith "\services.exe"))