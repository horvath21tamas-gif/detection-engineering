((process.executable:*\\wevtutil.exe AND (process.command_line:(*Security* OR *System* OR *Setup* OR *PowerShell*))) OR ((process.executable:*\\fsutil.exe AND (process.command_line:*usn* AND process.command_line:*deletejournal*)) OR (process.command_line:(*del\ * OR *Remove\-Item*)) OR (process.command_line:(*\\Windows\\Prefetch\\* OR *\\System32\\config\\Journal*)))) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\chrome.exe OR *\\msedge.exe OR *\\w3wp.exe OR *\\powershell.exe)) OR (NOT ((winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND (process.parent.executable:(*\\services.exe OR *\\svchost.exe OR *\\msiexec.exe))) OR (process.command_line:(*cleanmgr.exe* OR *CCM\\Temp* OR *HealthCheck*)))))
