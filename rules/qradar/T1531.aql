SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\net.exe','%\net1.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\dsmod.exe','%\dsrm.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% user %','%Remove-LocalUser%','%Remove-ADUser%','%Disable-LocalUser%','%Disable-ADAccount%','%Set-LocalUser -AccountExpires%','%dsrm%','%dsmod user -disabled yes%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% /delete%','% /active:no%','% /logoff%','%-Confirm:$false%','%-Force%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpoint.exe','%\httpd.exe','%\php-cgi.exe','%\rundll32.exe','%\explorer.exe')) AND (("Parent Process CommandLine" LIKE '%-EncodedCommand%' OR "Parent Process CommandLine" LIKE '%-NonInteractive%')) AND NOT (("Process "Process CommandLine"" ILIKE ENUMERATION('%Add-LocalUser%','% /add%','%WDAGUtilityAccount%','%DefaultAccount%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\services.exe')) AND "username" ILIKE 'NT AUTHORITY\%')
