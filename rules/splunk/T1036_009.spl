Image IN ("*.pdf.exe", "*.doc.exe", "*.docx.exe", "*.xls.exe", "*.xlsx.exe", "*.ppt.exe", "*.pptx.exe", "*.txt.exe", "*.jpg.exe", "*.jpeg.exe", "*.png.exe", "*.zip.exe", "*.rar.exe") OR CommandLine IN ("*‮*", "*\\u202e*", "*%E2%80%AE*") Image IN ("*\\Users\\*", "*\\Downloads\\*", "*\\Desktop\\*", "*\\AppData\\Local\\Temp\\*", "*\\AppData\\Roaming\\*", "*\\Users\\Public\\*") OR ParentImage IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe", "*\\outlook.exe", "*\\thunderbird.exe", "*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\acrord32.exe", "*\\winrar.exe", "*\\7zFM.exe", "*\\explorer.exe") NOT (Image IN ("*\\node_modules\\*", "*\\bin\\Debug\\*", "*\\bin\\Release\\*", "*\\AppData\\Local\\Programs\\*") OR username IN ("NT AUTHORITY\\SYSTEM", "NT AUTHORITY\\LOCAL SERVICE", "NT AUTHORITY\\NETWORK SERVICE") OR ParentImage IN ("*\\msiexec.exe", "*\\trustedinstaller.exe"))
