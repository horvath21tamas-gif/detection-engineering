DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*rest/api/*", "*api/v2/spaces*", "*api/v2/pages*", "*rest/api/2/issue*", "*_vti_bin/lists.asmx*", "*Get-SPO*", "*export-sharepoint*")) and ((ProcessCommandLine in ("*export*", "*backup*", "*download-all*", "*recursive*", "*dump*")) or (FolderPath in ("*\Users\*", "*\Temp\*", "*\AppData\*", "*\Public\*"))) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\httpd.exe", "*\python.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Program Files\Atlassian\*", "*C:\Program Files\Microsoft Monitoring Agent\*", "*C:\Windows\CCM\*")) or username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*healthcheck*", "*ping*"))))