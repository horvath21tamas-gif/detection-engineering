ParentImage IN ("*\\WINWORD.EXE", "*\\EXCEL.EXE", "*\\POWERPNT.EXE", "*\\OUTLOOK.EXE", "*\\MSACCESS.EXE") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\regsvr32.exe", "*\\bitsadmin.exe", "*\\certutil.exe", "*\\wscript.exe", "*\\cscript.exe") CommandLine IN ("*http://*", "*https://*", "*-enc*", "*Invoke-Expression*", "*IEX*", "*DownloadString*", "*FromBase64String*", "*/c*", "*/r*") OR CommandLine IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Microsoft\\Office\\*", "*\\INetCache\\*") NOT (ParentCommandLine IN ("*\\Addins\\*", "*\\VSTO\\*", "*\\Program Files\\Microsoft Office\\*") OR User IN ("*SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*"))
