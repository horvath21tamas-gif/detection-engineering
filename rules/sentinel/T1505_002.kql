DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\appcmd.exe" and OriginalFileName =~ "appcmd.exe") and (ProcessCommandLine in ("*install module*", "*add module*", "*uninstall module*", "*remove module*", "*image-path*", "*dllpath*"))) or ((((FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\notepad.exe", "*\cmd.exe")) and (ProcessCommandLine in ("*\inetsrv\Config\applicationHost.config*", "*\inetsrv\Config\web.config*"))) or (ProcessCommandLine in ("*\AppData\*", "*\Temp\*", "*\Users\Public\*", "*\PerfLogs\*", "*\ProgramData\*", "*\Downloads\*", "*\Desktop\*"))) and (not ((username =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Windows\System32\inetsrv\iissetup.exe*", "*\Windows\SoftwareDistribution\*"))) or (FolderPath in ("*\ngen.exe", "*\msiexec.exe", "*\svchost.exe")))))