SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\tasklist.exe','%\qprocess.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Get-Process%','%gps %','%process where%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%msmpeng%','%cb.exe%','%falcon%','%sentinel%','%cyvera%','%fireeye%','%tanium%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%lsass%','%winlogon%','%explorer%','%spoolsv%') OR (""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\httpd.exe','%\winword.exe','%\powershell.exe')) AND "Integrity Level"='Medium') AND NOT ("username" ILIKE 'NT AUTHORITY\%' OR ""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\brave.exe','%\svchost.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Program Files%','%/all /v%'))
