SELECT UTF8(payload) as search_payload from events where "Target Object" IMATCHES '\\Software\\Microsoft\\Office\\.*\\(Addins\\LoadBehavior|Options\\OPEN|Outlook\\WebView\\URL|Security\\Trusted Documents\\TrustRecords)$' AND ("Target Details" IMATCHES '(\\AppData\\Local\\Temp\\|C:\\Users\\Public\\|\\Downloads\\|http)' OR ""Filename"" IMATCHES '(powershell\.exe|cmd\.exe|wscript\.exe|cscript\.exe|reg\.exe|bitsadmin\.exe)$') AND NOT (""Filename"" IMATCHES '(msiexec\.exe|setup\.exe|OfficeClickToRun\.exe)$' AND "Target Details" IMATCHES '(C:\\Program Files\\|C:\\Program Files \(x86\)\\)')
