Image IN ("*\\net.exe", "*\\net1.exe") OR CommandLine IN ("*localgroup*", "*group *", "*Get-ADGroup*", "*Get-DomainGroup*", "*Get-NetLocalGroup*", "*Get-ADPrincipalGroupMembership*") CommandLine IN ("*Admins*", "*Domain Admins*", "*Enterprise Admins*", "*Remote Desktop Users*", "*DnsAdmins*", "*Schema Admins*") OR CommandLine IN ("* > *", "*ConvertTo-Json*", "*Export-Csv*", "*format-list*") OR (ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe", "*\\powershell.exe") IntegrityLevel="Medium") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\Program Files\\Tanium\\*", "*\\Program Files\\Splunk\\*", "*\\Windows\\System32\\CcmExec.exe*") OR CommandLine="*net localgroup*")
