SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\fsutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%usn%','%deletejournal%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Windows\Prefetch\%','%\Windows\AppCompat\Programs\Amcache.hve%','%\System32\config\journal%') OR ""Filename"" ILIKE ENUMERATION('%\sdelete.exe','%\sdelete64.exe') OR ""Filename"" ILIKE '%\cipher.exe' AND "Process "Process CommandLine"" ILIKE '% /w%' OR ""Filename"" ILIKE '%\powershell.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Remove-Item%','% -Recurse%','% -Force%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\w3wp.exe','%\sqlservr.exe','%\powershell.exe','%\cmd.exe') OR NOT (""Filename"" ILIKE ENUMERATION('%\cleanmgr.exe','%\dism.exe') OR ""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\TiWorker.exe') OR "Process "Process CommandLine"" ILIKE '%\Windows\SoftwareDistribution\Download%' OR "username" ILIKE 'NT AUTHORITY\%'))
