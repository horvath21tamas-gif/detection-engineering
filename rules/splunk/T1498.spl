Image IN ("*\\hping3.exe", "*\\loic.exe", "*\\hoic.exe", "*\\iperf.exe", "*\\iperf3.exe", "*\\pktmon.exe") CommandLine IN ("*--flood*", "*--rand-source*", "*-u -b*", "*--syn*", "*--udp*", "*-i u1*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\chrome.exe", "*\\rundll32.exe", "*\\outlook.exe") Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR Image IN ("*\\Program Files\\NetworkMonitoring\\*", "*\\Azure\\*") OR CommandLine IN ("*Speedtest*", "*HealthCheck*"))
