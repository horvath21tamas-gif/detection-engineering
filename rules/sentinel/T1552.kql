DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*password=*", "*pwd=*", "*connectionstring*", "*access_key*", "*secret_key*", "*id_rsa*", "*id_dsa*", "*id_ed25519*", "*amzn.mws*", "*BEGIN RSA PRIVATE*", "*BEGIN OPENSSH PRIVATE*", "*BEGIN PGP PRIVATE*")) or (((ProcessCommandLine in ("*findstr*", "*/s*", "*/i*")) or (ProcessCommandLine in ("*grep*", "*-r*")) or (ProcessCommandLine in ("*Get-ChildItem*", "*-Recurse*", "*-Include*")) or (ProcessCommandLine in ("*dir*", "*/s*")) or (ProcessCommandLine in ("*where*", "*/r*"))) and (ProcessCommandLine in ("*.config*", "*.xml*", "*.ini*", "*.yml*", "*.env*", "*.bak*", "*.old*", "*.history*", "*ConsoleHost_history*", "*.aws\credentials*", "*.ssh\*", "*.azure\*", "*.docker\config.json*")))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\php-cgi.exe", "*\nginx.exe")) and (FolderPath in ("*\findstr.exe", "*\grep.exe", "*\powershell.exe"))) and ((ProcessCommandLine in ("*base64*", "*certutil -encode*", "* > *", "*>>*", "* | clip*", "*curl *", "*wget *", "*scp *", "*Invoke-WebRequest*", "*-enc*", "*-EncodedCommand*", "*IEX*", "*Invoke-Expression*")) or (not (User in ("*NT AUTHORITY\SYSTEM*", "*NT AUTHORITY\LOCAL SERVICE*", "*NT AUTHORITY\NETWORK SERVICE*")))) and (not ((FolderPath in ("*\Windows\System32\SearchIndexer.exe*", "*\Microsoft Visual Studio\*", "*\Git\usr\bin\grep.exe*", "*\explorer.exe*")) and ParentProcessName endswith "\explorer.exe"))