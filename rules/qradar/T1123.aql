SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%winmm.dll,mciSendString%','%record%','%save%','%open new type waveaudio%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Get-MicrophoneAudio%','%Start-AudioCapture%','%waveInStart%','%naudio%')) AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\rundll32.exe','%\mshta.exe','%\wscript.exe')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\w3wp.exe')) AND "Integrity Level"='Medium' AND NOT (""Filename"" ILIKE ENUMERATION('%\Teams.exe%','%\Zoom.exe%','%\webex%','%\slack.exe%','%\discord.exe%','%\whatsapp.exe%') OR ""Filename"" ILIKE 'C:\Program Files\Google\Chrome\%' OR ""Filename"" ILIKE 'C:\Program Files (x86)\Microsoft\Edge\%')
