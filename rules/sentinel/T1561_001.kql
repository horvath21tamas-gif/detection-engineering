DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\dd.exe", "*\sdelete.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe")) and (ProcessCommandLine in ("*\.\PhysicalDrive*", "*\.\Harddisk*", "*if=/dev/zero*", "*if=/dev/urandom*", "*of=\.\*", "* -z *", "* -p *", "*Clear-Disk*", "*Initialize-Disk*")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\rundll32.exe", "*\explorer.exe")) or (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\msiexec.exe", "*\CcmExec.exe", "*\setup.exe")) or (ProcessCommandLine in ("*Program Files*", "*vds.exe*"))))