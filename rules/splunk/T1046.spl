
| rex field=CommandLine "(?<CommandLineMatch>(?i).*(10\\.|172\\.16\\.|192\\.168\\.).*(\\/24|\\/16).*)"
| eval CommandLineCondition=if(isnotnull(CommandLineMatch), "true", "false")
| search Image IN ("*\\nmap.exe", "*\\portqry.exe", "*\\telnet.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\netstat.exe") CommandLine IN ("*foreach*", "*ForEach-Object*", "*for /L*", "*1..254*", "*1..255*", "*Test-NetConnection*", "*System.Net.Sockets.TcpClient*", "*New-Object Net.Sockets.TcpClient*") OR CommandLineCondition="true" OR (CommandLine IN ("*-Port 445*", "*-Port 3389*", "*-Port 5985*", "*-Port 22*", "*-Port 80*", "*-p 445*", "*-p 3389*", "*-p 22*", "*-p 1-1024*", "*-p-*") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\httpd.exe") IntegrityLevel="Medium") username="*\\*" NOT username="NT AUTHORITY\\SYSTEM" NOT (Image IN ("*\\Program Files\\Zabbix\\*", "*\\Program Files\\Tanium\\*", "*\\Program Files\\Nessus\\*") OR ParentImage IN ("*\\services.exe", "*\\svchost.exe") OR CommandLine IN ("*healthcheck*", "*monitor*"))
