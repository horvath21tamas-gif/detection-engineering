process.command_line:/^[D-Z]:\\.*/ AND (process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\mshta.exe OR *\\rundll32.exe OR *\\regsvr32.exe OR *\\scrcons.exe)) AND process.parent.executable.caseless:*\\explorer.exe AND (NOT ((process.command_line:(*setup.exe* OR *install.exe* OR *autorun.inf*)) OR process.executable.caseless:*C\:\\Windows\\* OR process.command_line:*\\YourCompanyShare\\*))
