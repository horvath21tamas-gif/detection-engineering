CommandLine IN ("*sigthief*", "*copy-signature*", "*osslsigncode*", "*deltasig*") OR CommandLine IN ("*petools *", "*sethc.exe*", "*strings -d*", "*strip -s*") CommandLine IN ("*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*", "*\\Windows\\Temp\\*", "*\\PerfLogs\\*") NOT ((Image IN ("*\\Microsoft SDKs\\*", "*\\Windows Kits\\*", "*\\Visual Studio\\*") CommandLine="*signtool.exe sign*") OR User IN ("*svc-build*", "*cicd*"))
