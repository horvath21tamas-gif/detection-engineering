Image="*\\mmc.exe" OR OriginalFileName="mmc.exe" ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\powershell.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe") OR CommandLine IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*", "*\\Downloads\\*", "*\\*", "*http*") NOT (ParentImage="*\\explorer.exe" CommandLine="*C:\\Windows\\System32\\*" User="*Admin*")
