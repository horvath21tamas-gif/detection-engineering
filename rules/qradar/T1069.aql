SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\net.exe','%\net1.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%localgroup%','%group %','%Get-ADGroup%','%Get-DomainGroup%','%Get-NetLocalGroup%','%Get-ADPrincipalGroupMembership%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Admins%','%Domain Admins%','%Enterprise Admins%','%Remote Desktop Users%','%DnsAdmins%','%Schema Admins%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% > %','%ConvertTo-Json%','%Export-Csv%','%format-list%') OR (""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\httpd.exe','%\winword.exe','%\powershell.exe')) AND "Integrity Level"='Medium') AND NOT ("username" ILIKE 'NT AUTHORITY\%' OR ""Parent Filename"" ILIKE ENUMERATION('%\Program Files\Tanium\%','%\Program Files\Splunk\%','%\Windows\System32\CcmExec.exe%') OR "Process "Process CommandLine"" ILIKE '%net localgroup%')
