CommandLine IN ("*New-Object -ComObject Outlook.Application*", "*CreateObject(\"Outlook.Application\")*", "*.GetNamespace(\"MAPI\")*", "*GetDefaultFolder(6)*", "*GetDefaultFolder(5)*") CommandLine IN ("*.SaveAs*", "*.Attachments*", "*.Visible = $false*", "*.Display = 0*", "*SilentlyContinue*") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\mshta.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\Microsoft Office\\*", "*C:\\Program Files (x86)\\Microsoft Office\\*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*HealthCheck.ps1*", "*SignatureUpdater*", "*Outlook_Integration*"))
