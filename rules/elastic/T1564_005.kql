((process.executable.caseless:(*\\diskpart.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\mountvol.exe OR *\\vhdmount.exe)) AND (process.command_line:(*Mount\-VHD* OR *Mount\-DiskImage* OR *attach\ vdisk* OR *create\ vdisk* OR *Mount\-WindowsImage* OR *Mount\-Disk*))) AND ((process.parent.executable.caseless:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\chrome.exe OR *\\msedge.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\mshta.exe OR *\\powershell.exe OR *\\cmd.exe)) OR ((process.command_line:(*\\Users\\* OR *\\Downloads\\* OR *\\Temp\\* OR *\\AppData\\* OR *.iso* OR *.vhd* OR *.vhdx* OR *.img*)) AND (NOT (winlog.event_data.username:"NT AUTHORITY\\SYSTEM" OR (process.parent.executable.caseless:(*\\Windows\\System32\\svchost.exe* OR *\\Program\ Files\\Hyper\-V\\* OR *\\Program\ Files\\Microsoft\ Visual\ Studio\\* OR *\\CcmExec.exe*)) OR (process.command_line:(*Program\ Files* OR *WindowsImageBackup* OR *WinRE* OR *System\ Center*))))))
