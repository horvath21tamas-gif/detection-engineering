SELECT UTF8(payload) as search_payload from events where (("LoadedImage" LIKE '%\user32.dll%' OR "LoadedImage" LIKE '%\advapi32.dll%' OR "LoadedImage" LIKE '%\win32u.dll%')) AND "Image" ILIKE '%.exe' AND NOT (("Image" LIKE '%C:\Windows\System32\%' OR "Image" LIKE '%C:\Windows\SysWOW64\%')) AND NOT (("Image" LIKE '%\explorer.exe%' OR "Image" LIKE '%\chrome.exe%' OR "Image" LIKE '%\msedge.exe%' OR "Image" LIKE '%\firefox.exe%' OR "Image" LIKE '%\teams.exe%'))
