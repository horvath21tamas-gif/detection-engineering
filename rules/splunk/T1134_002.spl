CommandLine IN ("*runas /token*", "*make_token*", "*steal_token*", "*Invoke-TokenManipulation*", "*CPAU.exe*", "*load_privilege*") OR (ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\cscript.exe", "*\\wscript.exe") User="*SYSTEM*" logonid="0x3e7") NOT (ParentImage IN ("*\\services.exe", "*\\wininit.exe", "*\\lsass.exe", "*\\winlogon.exe") OR Image IN ("*\\conhost.exe", "*\\WerFault.exe", "*\\WmiPrvSE.exe") OR ParentCommandLine="*svchost.exe -k*" OR Image IN ("*\\Program Files\\Windows Defender\\*", "*\\Program Files\\CrowdStrike\\*", "*\\SentinelOne\\*"))
