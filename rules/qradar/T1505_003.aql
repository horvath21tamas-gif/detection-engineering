SELECT UTF8(payload) as search_payload from events where (("cs-method" LIKE '%POST%' OR "cs-method" LIKE '%PUT%')) AND (("cs-uri-stem" LIKE '%.php%' OR "cs-uri-stem" LIKE '%.asp%' OR "cs-uri-stem" LIKE '%.aspx%' OR "cs-uri-stem" LIKE '%.jsp%' OR "cs-uri-stem" LIKE '%.phtml%')) AND (("cs-uri-query" LIKE '%cmd=%' OR "cs-uri-query" LIKE '%exec=%' OR "cs-uri-query" LIKE '%powershell=%' OR "cs-uri-query" LIKE '%whoami%' OR "cs-uri-query" LIKE '%net user%' OR "cs-uri-query" LIKE '%command=%' OR "cs-uri-query" LIKE '%shell%' OR "cs-uri-query" LIKE '%curl%' OR "cs-uri-query" LIKE '%wget%'))
