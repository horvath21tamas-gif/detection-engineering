DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*/PlistBuddy", "*/defaults", "*/plutil", "*/launchctl")) and ((ProcessCommandLine in ("*/Library/LaunchAgents/*", "*/Library/LaunchDaemons/*", "*/Users/*", "*/System/Library/LaunchAgents/*", "*/System/Library/LaunchDaemons/*", "*/Library/StartupItems/*")) or (ProcessCommandLine in ("*RunAtLoad*", "*ProgramArguments*", "*KeepAlive*", "*StartInterval*", "*StartCalendarInterval*", "*LaunchEvents*", "*Label*", "*WatchPaths*", "*QueueDirectories*")) or (ProcessCommandLine in ("*bootstrap*", "*bootout*", "*load *", "*unload *"))) and ((ParentProcessName in ("*/Safari.app/*", "*/Google Chrome.app/*", "*/Microsoft Word.app/*", "*/Microsoft Excel.app/*", "*/Mail.app/*", "*/zoom.us.app/*", "*/Slack.app/*")) or (ParentProcessName in ("*/bash", "*/zsh", "*/sh", "*/osascript")) or (User contains "root" and IntegrityLevel =~ "Medium")) and (not (FolderPath in ("/usr/sbin/softwareupdate*", "/System/Library/*", "/usr/libexec/*"))) and (not (FolderPath in ("*/Jamf/*", "*/Intune/*", "*/Kandji/*", "*/Mosyle/*")))