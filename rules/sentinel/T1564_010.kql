DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\powershell.exe", "*\cmd.exe", "*\wmic.exe", "*\certutil.exe", "*\svchost.exe", "*\schtasks.exe")) and ProcessCommandLine matches regex "^(.*\\\\)?(powershell\\.exe|cmd\\.exe|svchost\\.exe|wmic\\.exe)\\s*$" and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\mshta.exe", "*\chrome.exe", "*\msedge.exe", "*\w3wp.exe")) or (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\Windows\System32\services.exe*", "*\Windows\System32\wininit.exe*")) or ProcessCommandLine contains " -k ")))