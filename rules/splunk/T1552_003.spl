CommandLine IN ("*.bash_history*", "*.zsh_history*", "*.fish_history*", "*ConsoleHost_history.txt*", "*.mysql_history*", "*.psql_history*", "*.python_history*") CommandLine IN ("*base64*", "*certutil -encode*", "*curl *", "*wget *", "*nc *", "*scp *", "* > *", "*>>*", "* | clip*", "*Invoke-WebRequest*") OR CommandLine IN ("*-enc*", "*-EncodedCommand*", "*IEX*", "*Invoke-Expression*") OR ParentImage IN ("*\\httpd.exe", "*\\nginx.exe", "*\\php-cgi.exe", "*\\wsmprovhost.exe", "*\\psexesvc.exe", "*\\wmiprvse.exe", "*\\cmd.exe", "*\\powershell.exe") NOT (User IN ("*NT AUTHORITY\\SYSTEM*", "*NT AUTHORITY\\LOCAL SERVICE*", "*NT AUTHORITY\\NETWORK SERVICE*")) NOT (Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\bash.exe", "*\\zsh.exe", "*\\conhost.exe", "*\\cmd.exe"))
