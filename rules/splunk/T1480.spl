Image IN ("*\\whoami.exe", "*\\hostname.exe", "*\\nltest.exe", "*\\systeminfo.exe", "*\\net.exe", "*\\net1.exe") CommandLine IN ("*/domain*", "*/dsgetdc*", "*TRUSTED_DOMAIN*", "*AD_DOMAIN*", "*USERDOMAIN*", "*COMPUTERNAME*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\mshta.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\browser.exe", "*\\chrome.exe", "*\\firefox.exe") OR Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Downloads\\*") NOT (username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\Windows\\System32\\svchost.exe*", "*\\Program Files\\Microsoft Monitoring Agent\\*", "*\\CcmExec.exe*") CommandLine IN ("*gpresult*", "*logon*"))
