Image IN ("*/python", "*/python3", "*/python2", "*/pythonw.exe") CommandLine IN ("*import socket*", "*pty.spawn*", "*base64.b64decode*", "*requests.get*", "*os.system*") OR ParentImage IN ("*/httpd", "*/apache2", "*/nginx", "*/php-fpm", "*/w3wp.exe", "*/sqlservr.exe", "*/redis-server") NOT (CommandLine IN ("*yum *", "*dnf *", "*cloud-init*", "*aws-cli*") OR ParentImage IN ("*/systemd", "*/sbin/init") OR (username="root" Parentprocessname="/usr/sbin/sshd"))
