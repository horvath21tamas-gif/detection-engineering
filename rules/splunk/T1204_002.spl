ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\acrord32.exe", "*\\acrobat.exe", "*\\7zFM.exe", "*\\winrar.exe") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\certutil.exe", "*\\rundll32.exe", "*\\regsvr32.exe", "*\\scrcons.exe", "*\\bitsadmin.exe") OR CommandLine IN ("*-enc*", "* -w hidden*", "*DownloadString*", "*Invoke-WebRequest*", "*http*", "*javascript:*", "*vbscript:*", "*GlobalTemp*") NOT (CommandLine IN ("*\\AppData\\Local\\Microsoft\\Office\\*", "*Template.dotm*") OR ParentImage="*C:\\Program Files\\*")
