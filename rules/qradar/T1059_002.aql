SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%/osascript' AND (""Process CommandLine"" ILIKE ENUMERATION('%do shell script%','%curl %','%python%','%eval%','%base64%') OR ""Parent Filename"" ILIKE ENUMERATION('%/Safari','%/Google Chrome','%/Microsoft Edge','%/Mail','%/Slack','%/Telegram','%/Terminal')) AND NOT (""Process CommandLine"" ILIKE '%/Library/Application Support/Jamf/%' OR ""Process CommandLine"" ILIKE '%com.apple.quarantine%' OR ""Parent Filename"" ILIKE '%/launchd')
