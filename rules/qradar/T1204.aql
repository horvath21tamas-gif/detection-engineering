SELECT UTF8(payload) as search_payload from events where ("ParentImage" LIKE ('%\WINWORD.EXE','%\EXCEL.EXE','%\POWERPNT.EXE','%\OUTLOOK.EXE','%\MSACCESS.EXE')) AND ((processname LIKE '%\cmd.exe' OR processname LIKE '%\powershell.exe' OR processname LIKE '%\pwsh.exe' OR processname LIKE '%\mshta.exe' OR processname LIKE '%\rundll32.exe' OR processname LIKE '%\regsvr32.exe' OR processname LIKE '%\bitsadmin.exe' OR processname LIKE '%\certutil.exe'))
