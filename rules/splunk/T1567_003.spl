Image IN ("*\\ffmpeg.exe", "*\\ffprobe.exe", "*\\mkvmerge.exe", "*\\youtube-upload.exe") CommandLine IN ("*youtube.googleapis.com*", "*vimeo.com/api*") CommandLine IN ("* -attach *", "* -metadata *", "* -map_metadata *", "* -f nut *", "* -vcodec copy -acodec copy*") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powershell.exe", "*\\rundll32.exe") NOT (Image IN ("*\\Program Files\\Adobe\\*", "*\\Program Files\\OBS Studio\\*", "*\\Program Files\\Blackmagic Design\\*") OR CommandLine="* --version*" OR username="NT AUTHORITY\\SYSTEM") | table Time,SourceImage,ParentImage,CommandLine,ProcessId,SourceUsername,DestinationUrl
