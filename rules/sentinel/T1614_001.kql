DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\reg.exe", "*\wmic.exe")) or (ProcessCommandLine in ("*Get-Culture*", "*Get-WinSystemLocale*", "*Get-KeyboardLayout*", "*os get MUILanguages*"))) or (ProcessCommandLine in ("*Keyboard Layout\Preload*", "*Control Panel\International*", "*00000419*", "*00000422*", "*00000423*"))) and (((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\powershell.exe")) and IntegrityLevel =~ "Medium") or (ProcessCommandLine in ("*findstr*", "*select-string*", "* > *", "*ConvertTo-Json*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\msiexec.exe", "*\CcmExec.exe", "*\svchost.exe")) or ProcessCommandLine contains "Program Files"))