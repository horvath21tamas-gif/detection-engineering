SELECT UTF8(payload) as search_payload from events where ("ParentImage" LIKE ('%\WINWORD.EXE','%\EXCEL.EXE','%\POWERPNT.EXE','%\OUTLOOK.EXE','%\MSACCESS.EXE')) AND (processname LIKE ('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\mshta.exe','%\rundll32.exe','%\regsvr32.exe','%\bitsadmin.exe','%\certutil.exe')) 