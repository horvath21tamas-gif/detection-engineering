(Image="*\\dd.exe" CommandLine="*of=\\.\\PhysicalDrive*" CommandLine="*bs=512*" CommandLine IN ("*count=1*", "*if=/dev/zero*", "*if=/dev/urandom*")) OR (CommandLine IN ("*\\.\\PhysicalDrive*", "*\\.\\Harddisk*", "*\\.\\Volume{*") (Image="*\\diskpart.exe" CommandLine IN ("* clean*", "* clean all*")) OR (Image="*\\diskpart.exe" CommandLine IN ("* delete partition*", "* delete volume*")) OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine="*Clear-Disk*" CommandLine="*-RemoveData*" CommandLine="*-Confirm:$false*") OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine="*Remove-Partition*" CommandLine="*-Confirm:$false*")) ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe", "*\\httpd.exe", "*\\mshta.exe", "*\\rundll32.exe") OR Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Windows\\Temp\\*") NOT (User="NT AUTHORITY*" ParentImage IN ("*\\services.exe", "*\\svchost.exe", "*\\vds.exe")) NOT (ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe", "*\\setup.exe") ParentImage IN ("*\\ConfigurationManager\\*", "*\\IntuneManagementExtension\\*")) NOT (CommandLine IN ("*diskpart /s*", "*\\deployment\\scripts\\*", "*\\imaging\\*"))
