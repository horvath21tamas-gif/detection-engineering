SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\wget.exe','%\curl.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% --mirror%','% -m %','% --recursive%','% -r %','% --no-parent%')) OR ""Filename"" ILIKE '%\powershell.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%foreach%','%while%')) OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%confluence%','%sharepoint%','%wiki.%','%tudastar%','%onboarding%','%network-diagram%','%credential%','%jelszo%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\brave.exe'))) AND NOT ((("UserName" LIKE '%svc_deploy%' OR "UserName" LIKE '%svc_wiki_backup%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%--update%','%/check-updates%'))) AND NOT (""Filename"" ILIKE ENUMERATION('%\SearchIndexer.exe','%\SearchHost.exe'))
