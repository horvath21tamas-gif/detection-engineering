CommandLine IN ("*stratum+tcp://*", "*stratum+ssl://*", "*--url=*", "*--user=*", "*--pass=*", "*--algo=*", "*--donate-level=*", "*cryptonight*", "*nicehash*") CommandLine IN ("*--cpu-max-threads-hint*", "*--cpu-no-yield*", "*--randomx-1gb-pages*", "*--cuda-devices*", "*--opencl-platform*") OR (Image IN ("*\\AppData\\Local\\Temp\\*", "*\\AppData\\Roaming\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Windows\\Temp\\*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\powershell.exe", "*\\cmd.exe")) NOT (username="NT AUTHORITY\\SYSTEM" OR Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*Azure*", "*Telemetry*", "*Diagnostic*"))
