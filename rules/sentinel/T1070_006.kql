DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Get-Item*", "*Get-ChildItem*", "*IO.File*"))) or ((FolderPath in ("*\nircmd.exe", "*\setmace.exe", "*\timestomp.exe", "*\touch.exe")) or (ProcessCommandLine in ("*setfiletime*", "*setmace*")))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\chrome.exe", "*\msedge.exe", "*\w3wp.exe", "*\sqlservr.exe", "*\powershell.exe")) or (not ((username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\msiexec.exe", "*\TiWorker.exe"))) or (ProcessCommandLine in ("*C:\Windows\SoftwareDistribution\*", "*C:\Program Files\Common Files\Microsoft Shared\*")) or FolderPath endswith "\git.exe")))