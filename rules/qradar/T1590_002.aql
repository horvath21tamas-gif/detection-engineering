SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('% -type=AXFR%','% -query=AXFR%','% -type=ANY%','% -type=SOA%','% -type=TXT%','%ls -d%','% -q=srv%') OR (""Filename"" ILIKE ENUMERATION('%\dig.exe','%\host.exe','%\dnscmd.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% /enumzones%','% /zoneprint%'))) AND NOT "Process "Process CommandLine"" ILIKE '%nslookup.exe%' AND NOT (("UserName" LIKE '%svc_monitoring%' OR "UserName" LIKE '%AD_Sync_Account%'))
