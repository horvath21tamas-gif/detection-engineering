DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((operationName in ("Add device", "Register device")) and result =~ "success" and (not (['initiatedBy.app.displayName'] in ("Microsoft Intune", "Microsoft Device Registration Service", "Azure Active Directory")))) or (['additionalDetails.value'] in ("*Python*", "*Go-http-client*", "*Postman*", "*curl*"))