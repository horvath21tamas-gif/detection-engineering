CommandLine IN ("*rest/api/*", "*api/v2/spaces*", "*api/v2/pages*", "*rest/api/2/issue*", "*_vti_bin/lists.asmx*", "*Get-SPO*", "*export-sharepoint*") CommandLine IN ("*export*", "*backup*", "*download-all*", "*recursive*", "*dump*") OR Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\AppData\\*", "*\\Public\\*") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\w3wp.exe", "*\\httpd.exe", "*\\python.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\Atlassian\\*", "*C:\\Program Files\\Microsoft Monitoring Agent\\*", "*C:\\Windows\\CCM\\*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*healthcheck*", "*ping*"))
