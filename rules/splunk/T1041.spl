CommandLine IN ("* [System.IO.MemoryStream]*", "* [System.Convert]::ToBase64*", "* .ReadBytes(*", "* .ReadAllBytes(*", "*Compress-Archive*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\regsvcs.exe", "*\\mshta.exe", "*\\certutil.exe") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\wmiprvse.exe", "*\\svchost.exe") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*Windows\\Logs*", "*softwareupdate*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
