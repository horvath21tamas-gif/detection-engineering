Image IN ("*\\7z.exe", "*\\7za.exe", "*\\winrar.exe", "*\\rar.exe", "*\\tar.exe", "*\\zip.exe") OR OriginalFileName IN ("7z.exe", "7za.exe", "WinRAR.exe", "rar.exe", "tar.exe") CommandLine IN ("* -p*", "* -hp*", "* -v*", "* -ta*", "* -sdel*", "* -m0=*") OR CommandLine IN ("*\\Desktop*", "*\\Documents*", "*\\AppData\\Local\\Microsoft\\Outlook*", "*C:\\inetpub\\*", "*C:\\Users\\Public*") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\w3wp.exe") IntegrityLevel="Medium" NOT (CommandLine IN ("*C:\\Program Files\\Backup*", "*C:\\Windows\\Temp\\Inv*") OR ParentImage IN ("*C:\\Program Files\\Microsoft Monitoring Agent\\*", "*C:\\Program Files\\Veritas\\*") OR username="NT AUTHORITY\\SYSTEM")
