SELECT UTF8(payload) as search_payload from events where (("operation_name" LIKE '%TerminateInstances%' OR "operation_name" LIKE '%Microsoft.Compute/virtualMachines/delete%' OR "operation_name" LIKE '%v1.compute.instances.delete%')) AND "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%boto3%' OR "user_agent" LIKE '%curl%' OR "user_agent" LIKE '%postman%' OR "user_agent" LIKE '%Mozilla%')) AND NOT (("user_name" LIKE '%svc-terraform%' OR "user_name" LIKE '%svc-ansible%' OR "user_name" LIKE '%aws-autoscaling%' OR "user_name" LIKE '%cloud-controller%') OR ("user_name" LIKE '%system-internal%' OR "user_name" LIKE '%scaling-manager%'))
