Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\robocopy.exe", "*\\xcopy.exe", "*\\bitsadmin.exe", "*\\certutil.exe", "*\\curl.exe") CommandLine IN ("*\\C$\\*", "*\\ADMIN$\\*", "*\\IPC$\\*", "*c$*", "*admin$*") CommandLine IN ("*.exe*", "*.dll*", "*.ps1*", "*.vbs*", "*.bat*", "*.zip*", "*.7z*", "*.vhd*", "*.iso*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\httpd.exe", "*\\w3wp.exe", "*\\sqlservr.exe") IntegrityLevel="Medium" NOT (Image IN ("*\\CcmExec.exe", "*\\msiexec.exe") OR CommandLine IN ("*\\SoftwareDistribution\\*", "*\\HealthCheck\\*", "*AppData\\Local\\Google\\Chrome*") OR username="NT AUTHORITY\\SYSTEM") | table Time,SourceImage,ParentImage,CommandLine,ProcessId,SourceUsername,IntegrityLevel
