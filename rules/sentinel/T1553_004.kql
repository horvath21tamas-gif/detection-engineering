DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\certutil.exe", "*\certmgr.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("* Root*", "* AuthRoot*", "* Cert:\LocalMachine\Root*", "* Cert:\CurrentUser\Root*")) and ((ProcessCommandLine in ("* -f*", "* -user*", "* -enterprise*", "* -silent*")) or (ProcessCommandLine in ("*\AppData\*", "*\Users\Public\*", "*\Downloads\*", "*\Desktop\*", "*\PerfLogs\*", "*\ProgramData\*", "*\Temp\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\acrord32.exe", "*\mshta.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\regsvr32.exe"))) and (not ((ParentProcessName in ("C:\Windows\System32\gpscript.exe*", "C:\Windows\System32\svchost.exe*", "C:\Windows\servicing\TrustedInstaller.exe*", "C:\Program Files\Microsoft Configuration Manager\*")) and (User in ("NT AUTHORITY\SYSTEM*", "NT AUTHORITY\NETWORK SERVICE*")))) and (not (ParentProcessName in ("*\gpupdate.exe", "*\mmc.exe")))