SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('%/var/run/secrets/kubernetes.io/serviceaccount%','%/run/secrets/%','%.docker/config.json%','%/etc/kubernetes/admin.conf%','%secret.yml%') OR ""Process CommandLine"" ILIKE '%env%' AND ""Process CommandLine"" ILIKE '%grep%' OR ""Process CommandLine"" ILIKE '%printenv%' AND ""Process CommandLine"" ILIKE '%token%' OR ""Process CommandLine"" ILIKE '%cat%' AND ""Process CommandLine"" ILIKE '%base64%' OR ""Process CommandLine"" ILIKE '%export%') AND (""Parent Filename"" ILIKE ENUMERATION('%/sh','%/bash','%/zsh','%/dash','%/kubectl')) AND (""Parent Filename"" ILIKE ENUMERATION('%/nginx%','%/httpd%','%/php%')) AND NOT ((""Process CommandLine"" ILIKE ENUMERATION('%/usr/local/bin/docker-entrypoint.sh%','%/init.sh%')) AND "username"='fluentd' AND ""Filename"" ILIKE '%/usr/bin/promtail%')
