DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\logman.exe" and ProcessCommandLine contains " stop " and (ProcessCommandLine in ("*EventLog-System*", "*EventLog-Security*", "*Microsoft-Windows-DotNETRuntime*", "*Microsoft-Windows-Web-Http*", "*NT Kernel Logger*", "*Circular Kernel Context Logger*"))) or (FolderPath endswith "\logman.exe" and ProcessCommandLine contains " delete " and (ProcessCommandLine in ("*EventLog*", "*Kernel*", "*trace*"))) or (FolderPath endswith "\wecutil.exe" and ProcessCommandLine contains " /e:false") or (FolderPath endswith "\wecutil.exe" and (ProcessCommandLine contains " ds " and ProcessCommandLine contains "Subscription")) or (FolderPath endswith "\netsh.exe" and (ProcessCommandLine contains "advfirewall" and ProcessCommandLine contains "add rule" and ProcessCommandLine contains "block" and ProcessCommandLine contains "remoteport=443") and (ProcessCommandLine in ("*remoteip=*", "*defender*", "*security*", "*edr*", "*telemetry*", "*crowdstrike*", "*sentinel*", "*carbonblack*"))) or (FolderPath endswith "\powershell.exe" and (ProcessCommandLine contains "New-NetFirewallRule" and ProcessCommandLine contains "-Action Block" and ProcessCommandLine contains "-Direction Outbound") and (ProcessCommandLine in ("*443*", "*defender*", "*security*", "*edr*", "*telemetry*", "*crowdstrike*", "*sentinel*", "*carbonblack*")))) and (not (ProcessCommandLine in ("*Microsoft Monitoring Agent*", "*SplunkUniversalForwarder*", "*AzureMonitorAgent*", "*Elastic Agent*", "*SCOM*", "*Defender for Endpoint*", "*Docker*"))) and (not (User startswith "NT AUTHORITY" and ParentProcessName endswith "\services.exe")) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe", "*\rundll32.exe", "*\mshta.exe"))