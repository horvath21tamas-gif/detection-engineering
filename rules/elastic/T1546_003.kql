((process.executable.caseless:*\\wmic.exe AND (process.command_line:(*root\\subscription* OR *__EventFilter* OR *CommandLineEventConsumer* OR *FilterToConsumerBinding*))) OR ((process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe)) AND (process.command_line:(*Register\-WmiEvent* OR *Set\-WmiInstance* OR *New\-CimInstance* OR *root\\subscription*)))) AND (NOT (user.name:*SYSTEM* OR (process.executable.caseless:(*\\Microsoft\ Monitoring\ Agent\\* OR *\\SCOM\\* OR *\\System\ Center\\* OR *\\Tanium\\* OR *\\Qualys\\* OR *\\CrowdStrike\\* OR *\\SentinelOne\\* OR *\\SplunkUniversalForwarder\\* OR *\\Datadog\\* OR *\\Elastic\\Agent\\*)) OR (process.command_line:(*HealthCheck* OR *Inventory* OR *Monitoring*))))
