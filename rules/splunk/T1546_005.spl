CommandLine IN ("*.bashrc*", "*.bash_profile*", "*.zshrc*", "*.profile*", "*/etc/profile*", "*/etc/bash.bashrc*") CommandLine IN ("*DEBUG*", "*EXIT*", "*RETURN*") CommandLine IN ("*curl*", "*wget*", "*base64*", "*python*", "*/dev/tcp/*", "*sh -i*", "*nc *") NOT (ParentImage IN ("*/ansible-playbook", "*/chef-client", "*/salt-minion", "*/puppet", "*/dpkg", "*/apt") OR CommandLine IN ("*rbenv rehash*", "*pyenv*", "*bash_completion*"))
