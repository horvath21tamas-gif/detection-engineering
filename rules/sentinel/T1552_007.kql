DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*/var/run/secrets/kubernetes.io/serviceaccount*", "*/run/secrets/*", "*/etc/kubernetes/admin.conf*", "*/root/.kube/config*", "*.docker/config.json*", "*/.aws/credentials*", "*/.azure/*", "*/.config/gcloud/*")) or (ProcessCommandLine in ("*token*", "*authorization*", "*kubeconfig*", "*client-secret*", "*access_key*", "*secret_key*")) or ((ProcessCommandLine in ("*env*", "*|*")) or (ProcessCommandLine in ("*printenv*", "*|*")) or (ProcessCommandLine in ("*set*", "*|*")) or (ProcessCommandLine in ("*export*", "*|*"))) or ((ProcessCommandLine in ("*cat*", "*base64*")) or (ProcessCommandLine in ("*cat*", "*grep*")) or (ProcessCommandLine in ("*xxd*", "*hexdump*")))) and (((FolderPath in ("*/sh", "*/bash", "*/dash", "*/zsh")) and (ProcessCommandLine in ("*-i*", "*-c*"))) or (ParentProcessName in ("*/nginx", "*/httpd", "*/apache2", "*/php-fpm", "*/node", "*/gunicorn", "*/uwsgi")) or (ParentProcessName in ("*kubectl*", "*containerd*", "*docker*", "*cri-o*"))) and (not ((ProcessCommandLine in ("*docker-entrypoint.sh*", "*/init.sh*", "*/usr/local/bin/start.sh*")) and (FolderPath in ("*/usr/bin/promtail*", "*/usr/bin/fluentd*", "*/usr/bin/telegraf*", "*/pause*")) and (User in ("fluentd", "root"))))