SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%/spctl' AND ""Process CommandLine"" ILIKE '%assess%' OR ""Filename"" ILIKE '%/xattr' AND (""Process CommandLine"" ILIKE ENUMERATION('%-d com.apple.quarantine%','%-rc com.apple.quarantine%','%--delete com.apple.quarantine%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/tmp/%','%/private/var/tmp/%','%/Users/Shared/%','%/Downloads/%','%/Volumes/%','%/Library/Application Support/%')) AND (""Parent Filename"" ILIKE ENUMERATION('%/sh','%/bash','%/zsh','%/python','%/python3','%/perl','%/php','%/osascript','%/launchctl','%/cron') OR ""Parent Filename"" ILIKE ENUMERATION('%/Microsoft Word','%/Microsoft Excel','%/Preview','%/Google Chrome','%/Safari'))) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('/System/Library/%','/usr/libexec/%','/usr/sbin/softwareupdate%','/Applications/Xcode.app/%','/Applications/Install %')) AND (""Filename"" ILIKE ENUMERATION('/usr/bin/codesign%','/usr/bin/productbuild%'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/Terminal','%/iTerm2'))
