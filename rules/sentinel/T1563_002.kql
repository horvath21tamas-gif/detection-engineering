DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\tscon.exe", "*\mstsc.exe")) and (OriginalFileName in ("tscon.exe", "mstsc.exe"))) and ((ProcessCommandLine in ("* /shadow:*", "* /no-consent-prompt*", "* /control*", "* /dest:rdp-tcp#*")) or ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\psexesvc.exe", "*\wsmprovhost.exe", "*\httpd.exe")) and IntegrityLevel =~ "System")) and (not ((ParentProcessName in ("*\svchost.exe", "*\Taskmgr.exe")) and (ProcessCommandLine in ("*C:\Program Files\Remote Desktop*", "*Citrix*", "*VMware*")) and username =~ "NT AUTHORITY\NETWORK SERVICE"))