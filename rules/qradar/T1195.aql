SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\Update%','%\Upgrade%','%\Installer%','%\Setup%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\winget.exe','%\dism.exe')) AND (""Filename"" ILIKE ENUMERATION('%\whoami.exe','%\net.exe','%\net1.exe','%\ipconfig.exe','%\nltest.exe','%\nbtstat.exe','%\systeminfo.exe','%\tasklist.exe','%\nslookup.exe') OR ""Filename"" ILIKE ENUMERATION('%\procdump.exe','%\nanodump.exe','%\vssadmin.exe','%\reg.exe')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%C:\Program Files\%','%C:\Program Files (x86)\%') OR ""Parent Filename"" ILIKE '%\Windows\servicing\TrustedInstaller.exe%' OR "Process "Process CommandLine"" ILIKE ENUMERATION('%/configure%','%/update%'))
