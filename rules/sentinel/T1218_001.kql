DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\hh.exe" and OriginalFileName =~ "hh.exe") and (IntegrityLevel in ("Low", "Medium")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*")) or (ProcessCommandLine in ("*http://*", "*https://*", "*ftp://*")) or (ProcessCommandLine in ("*its:*", "*mk:@MSITStore*", "*ms-its:*")) or ProcessCommandLine contains "-decompile" or ((ProcessCommandLine in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*", "*\Downloads\*")) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe", "*\chrome.exe", "*\msedge.exe"))) or (ProcessCommandLine in ("*.txt*", "*.jpg*", "*.png*", "*.dat*", "*.tmp*"))) and (not ((FolderPath in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*")) and ((ParentProcessName in ("C:\Program Files\*", "C:\Program Files (x86)\*")) and IntegrityLevel =~ "High"))) and (not User startswith "NT AUTHORITY\")