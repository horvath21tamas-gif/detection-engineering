Image="*\\reg.exe" OR CommandLine IN ("*reg query*", "*Get-ItemProperty*", "*Get-ChildItem -Path Registry::*") CommandLine IN ("* /s *", "* -Recurse*") OR CommandLine IN ("*\\System\\CurrentControlSet\\Control\\Lsa*", "*\\Software\\Microsoft\\Windows\\CurrentVersion\\Run*", "*\\Software\\Policies\\Microsoft\\Windows Defender*", "*\\SECURITY\\Policy\\Secrets*", "*\\Control\\SecurityProviders\\WDigest*", "*Putty\\Sessions*", "*Software\\ORL\\WinVNC3*") OR (ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe") IntegrityLevel="Medium") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\msiexec.exe", "*\\svchost.exe", "*\\CcmExec.exe") OR CommandLine="*Microsoft\\Windows\\CurrentVersion\\Uninstall*")
