Image="*/osascript" OR OriginalFileName="osascript" CommandLine IN ("*with administrator privileges*", "*do shell script*", "*display dialog*") ParentImage IN ("*/Applications/Google Chrome.app/*", "*/Applications/Safari.app/*", "*/Applications/Microsoft Word.app/*", "*/Applications/Microsoft Excel.app/*", "*/Applications/Slack.app/*", "*/Applications/Microsoft Teams.app/*", "*/private/tmp/*", "*/Users/Shared/*") NOT (ParentImage IN ("*/Library/Application Support/JamfSoftware/*", "*/usr/local/bin/kandji*", "*/System/Library/PrivateFrameworks/*") OR Image="*/usr/sbin/softwareupdate*" OR username="root")
