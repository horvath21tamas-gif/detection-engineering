SELECT UTF8(payload) as search_payload from events where (("Message" LIKE '%copy tftp flash%' OR "Message" LIKE '%copy ftp flash%' OR "Message" LIKE '%request system software add%' OR "Message" LIKE '%update firmware%' OR "Message" LIKE '%boot system flash%' OR "Message" LIKE '%install activate%')) AND (("Message" LIKE '%tftp%' OR "Message" LIKE '%unauthenticated%' OR "Message" LIKE '%unknown source%' OR "Message" LIKE '%checksum failed%') OR NOT (("SourceIP" LIKE '%10.50.0.10%' OR "SourceIP" LIKE '%10.50.0.11%'))) AND NOT (("Message" LIKE '%copy running-config%' OR "Message" LIKE '%copy startup-config%' OR "Message" LIKE '%archive config%'))
