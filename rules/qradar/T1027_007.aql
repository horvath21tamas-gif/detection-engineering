SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%strip %','%sstrip %','%objcopy %','%eu-strip %') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% -s %','%-Wl,-s%','%-strip-all%','%/NODEBUG%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.exe%','%.dll%','%.sys%','%.elf%','%.so%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Jenkins\%','%\GitLab-Runner\%','%\Azure Pipelines\%','%\Visual Studio\%','%\bin\mingw%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\devenv.exe%','%\msbuild.exe%')) OR ("UserName" LIKE '%svc-build%' OR "UserName" LIKE '%cicd-agent%'))
