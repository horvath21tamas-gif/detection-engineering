DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\taskkill.exe" or (ProcessCommandLine in ("* /f /im csrss.exe*", "* /f /im wininit.exe*", "* /f /im smss.exe*", "* /f /im services.exe*"))) or (FolderPath endswith "\ntsd.exe" and (ProcessCommandLine in ("*-pn csrss.exe*", "*-pn wininit.exe*", "*-c q*")))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\rundll32.exe", "*\outlook.exe")) or (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\CcmExec.exe", "*\msiexec.exe", "*\TiWorker.exe")) or (ProcessCommandLine in ("*HealthCheck*", "*Diagnostic*"))))