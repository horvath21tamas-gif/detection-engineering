Image="*\\taskkill.exe" OR CommandLine IN ("* /f /im csrss.exe*", "* /f /im wininit.exe*", "* /f /im smss.exe*", "* /f /im services.exe*") OR (Image="*\\ntsd.exe" CommandLine IN ("*-pn csrss.exe*", "*-pn wininit.exe*", "*-c q*")) ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\outlook.exe") OR Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe", "*\\TiWorker.exe") OR CommandLine IN ("*HealthCheck*", "*Diagnostic*"))
