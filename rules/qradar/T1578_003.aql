SELECT Time, user_name, operation_name, user_agent, mfa_authenticated, resource_id, subscription_id, tenant_id from events where (("operation_name" LIKE '%TerminateInstances%' OR "operation_name" LIKE '%Microsoft.Compute/virtualMachines/delete%' OR "operation_name" LIKE '%v1.compute.instances.delete%' OR "operation_name" LIKE '%DeleteVM%' OR "operation_name" LIKE '%DeleteInstance%' OR "operation_name" LIKE '%Compute.instances.delete%')) AND "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%boto3%' OR "user_agent" LIKE '%curl%' OR "user_agent" LIKE '%postman%' OR "user_agent" LIKE '%Mozilla%' OR "user_agent" LIKE '%powershell%' OR "user_agent" LIKE '%Terraform%' OR "user_agent" LIKE '%Pulumi%')) AND NOT (("user_name" LIKE '%svc-terraform%' OR "user_name" LIKE '%svc-ansible%' OR "user_name" LIKE '%aws-autoscaling%' OR "user_name" LIKE '%cloud-controller%' OR "user_name" LIKE '%svc-pulumi%') OR ("user_name" LIKE '%system-internal%' OR "user_name" LIKE '%scaling-manager%' OR "user_name" LIKE '%azuremonitor%' OR "user_name" LIKE '%loganalytics%'))
