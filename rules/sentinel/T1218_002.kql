DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\control.exe" and OriginalFileName =~ "control.exe") and (IntegrityLevel in ("Low", "Medium")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe", "*\chrome.exe", "*\msedge.exe")) or (ProcessCommandLine in ("*http://*", "*https://*", "*\\*")) or ((ProcessCommandLine in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*", "*\Downloads\*", "*\PerfLogs\*")) and (ProcessCommandLine in ("*.dll*", "*.tmp*", "*.dat*", "*.png*", "*.jpg*", "*.txt*")))) and (not ((FolderPath in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*")) and (ParentProcessName endswith "\explorer.exe" and IntegrityLevel =~ "High" and (ProcessCommandLine in ("*.cpl*", "*C:\Windows\System32\*"))))) and (not User startswith "NT AUTHORITY\")