DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\diskpart.exe", "*\powershell.exe", "*\pwsh.exe", "*\mountvol.exe", "*\vhdmount.exe")) and (ProcessCommandLine in ("*Mount-VHD*", "*Mount-DiskImage*", "*attach vdisk*", "*create vdisk*", "*Mount-WindowsImage*", "*Mount-Disk*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\powershell.exe", "*\cmd.exe")) or ((ProcessCommandLine in ("*\Users\*", "*\Downloads\*", "*\Temp\*", "*\AppData\*", "*.iso*", "*.vhd*", "*.vhdx*", "*.img*")) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\Windows\System32\svchost.exe*", "*\Program Files\Hyper-V\*", "*\Program Files\Microsoft Visual Studio\*", "*\CcmExec.exe*")) or (ProcessCommandLine in ("*Program Files*", "*WindowsImageBackup*", "*WinRE*", "*System Center*"))))))