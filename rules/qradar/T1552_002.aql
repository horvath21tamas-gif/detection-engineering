SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%Software\SimonTatham\PuTTY\Sessions%','%Software\Martin Prikryl\WinSCP 2\Sessions%','%Software\Microsoft\Terminal Server Client\Servers%','%Software\ORL\WinVNC3%','%ControlSet001\Control\Lsa\Data%','%ControlSet001\Control\Lsa\JD%','%ControlSet001\Control\Lsa\Skew1%','%SAM\SAM\Domains\Account\Users%','%Software\Cisco\AnyConnect%','%Software\OpenVPN%','%Software\Microsoft\Windows\CurrentVersion\Internet Settings\Credentials%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%reg%','%query%','%/s%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%reg%','%export%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%regedit%','%/e%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Get-ItemProperty%','%Registry::%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Invoke-Expression%','%Export-Registry%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\wsmprovhost.exe','%\psexesvc.exe','%\wmiprvse.exe','%\httpd.exe','%\nginx.exe','%\php-cgi.exe')) AND (""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Windows\System32\svchost.exe','%\Windows\System32\msiexec.exe','%\Windows\System32\wbem\wmiprvse.exe','%\Windows\System32\TrustedInstaller.exe')) AND "username" ILIKE 'NT AUTHORITY%')
