DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("*VirtualAlloc*", "*VirtualProtect*", "*WriteProcessMemory*", "*CreateRemoteThread*", "*NtMapViewOfSection*", "*QueueUserAPC*")) and (ProcessCommandLine in ("*0x20*", "*0x40*", "*0x3000*"))) or ((ProcessCommandLine in ("*[System.Reflection.Assembly]::Load(*", "*Reflection.Emit*", "*Marshal.Copy*", "*[Activator]::CreateInstance(*", "*[AppDomain]::CurrentDomain*")) and (ProcessCommandLine in ("*FromBase64String*", "*IO.MemoryStream*", "*IO.Compression*", "*ConvertFrom-SecureString*", "*AES*")))) and ((FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Temp\*", "*\ProgramData\*")) or (ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\explorer.exe", "*\wsmprovhost.exe"))) and (not ((FolderPath in ("*\Visual Studio\*", "*\MSBuild.exe*", "*\dotnet.exe*", "*\GitHub\*", "*\Jenkins\*", "*\AzureDevOps\*")) and (User in ("*svc-build*", "*ci*", "*cicd*", "*jenkins*"))))