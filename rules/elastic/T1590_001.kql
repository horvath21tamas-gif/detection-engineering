(((process.executable:*\\ipconfig.exe AND (process.command_line:(*\ \/all* OR *\ \/displaydns*))) OR (process.executable:*\\route.exe AND process.command_line:*\ print*) OR (process.executable:*\\arp.exe AND process.command_line:*\ \-a*) OR (process.executable:*\\netsh.exe AND process.command_line:*\ interface\ ipv4\ show*)) OR (process.command_line:(*ifconfig.me* OR *icanhazip.com* OR *ident.me* OR *api.ipify.org* OR *checkip.amazonaws.com*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND (process.parent.executable:(*\\services.exe OR *\\svchost.exe OR *\\msiexec.exe)))) AND (NOT (process.executable:*\\AppData\\Local\\Temp\\* AND (process.command_line:(*\-\-check\-connection* OR *\-\-update*))))
