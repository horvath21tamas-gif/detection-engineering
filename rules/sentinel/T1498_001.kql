DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\hping3.exe", "*\loic.exe", "*\hoic.exe", "*\iperf.exe", "*\iperf3.exe", "*\nping.exe", "*\pktmon.exe")) and (ProcessCommandLine in ("*--flood*", "*--syn*", "*--udp*", "*-u -b 0*", "*-i u*", "*--icmp*", "*--rand-source*")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\chrome.exe", "*\rundll32.exe", "*\outlook.exe")) and (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (FolderPath in ("*\Program Files\NetworkMonitoring\*", "*\Azure\*")) or (ProcessCommandLine in ("*Speedtest*", "*HealthCheck*"))))