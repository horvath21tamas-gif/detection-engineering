DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (Message in ("*import-target*", "*export-target*", "*ip route vrf*", "*switchport mode trunk*", "*vlan-stacking*", "*brctl addif*", "*set protocols evpn*")) and ((Message in ("*native vlan*", "*permit any*", "*allow-all*", "*no shutdown*")) or (Message in ("*line vty*", "*console*", "*ssh-session*"))) and (not ((SourceIP in ("10.50.0.10", "10.50.0.11")) or (Message in ("*switchport mode access*", "*description *"))))