Image IN ("*\\driverquery.exe", "*\\pnputil.exe", "*\\sc.exe") OR CommandLine IN ("*query type= driver*", "*enum-drivers*") OR CommandLine IN ("*Win32_PnPSignedDriver*", "*Win32_SystemDriver*", "*Get-WindowsDriver*", "*Get-PnpDevice*") CommandLine IN ("* > *", "* | clip*", "*ConvertTo-Json*", "*Export-Csv*", "*/fo csv*", "*base64*") OR (ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe", "*\\excel.exe") Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*")) NOT (Image IN ("*\\Program Files\\Tanium\\*", "*\\Program Files\\Splunk\\*", "*\\Program Files\\Datadog\\*") username="NT AUTHORITY\\SYSTEM")
