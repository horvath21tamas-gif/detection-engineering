(CommandLine IN ("*VirtualAlloc*", "*VirtualProtect*", "*WriteProcessMemory*", "*CreateRemoteThread*", "*GetDelegateForFunctionPointer*") CommandLine IN ("*0x40*", "*0x20*", "*0x3000*")) OR (CommandLine IN ("*[System.Reflection.Assembly]::Load(*", "*Reflection.Emit*", "*Marshal.Copy*") CommandLine IN ("*FromBase64String*", "*IO.MemoryStream*", "*IO.Compression*")) NOT (Image IN ("*\\Visual Studio\\*", "*\\MSBuild.exe*") User IN ("*svc-build*", "*cicd*"))
