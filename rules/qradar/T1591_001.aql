SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%site_list%','%adatkozpont%','%telephely%','%szekhaz%','%belepteto%','%kamera%','%riaszto%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%floorplan%','%alaprajz%','%building_layout%') OR (""Filename"" ILIKE ENUMERATION('%\findstr.exe','%\grep.exe','%\where.exe','%\7z.exe','%\powershell.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.dwg%','%.vsdx%','%.kmz%','%.kml%'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe')) AND NOT (""Filename"" ILIKE ENUMERATION('%\acad.exe','%\visio.exe','%\GoogleEarth.exe')) AND NOT (("UserName" LIKE '%facility%' OR "UserName" LIKE '%phys_sec%' OR "UserName" LIKE '%gondnoksag%' OR "UserName" LIKE '%biztonsag%'))
