SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\msbuild.exe','%\csc.exe','%\jsc.exe','%\vbc.exe') OR ("ImageName" LIKE '%MSBuild.exe%' OR "ImageName" LIKE '%csc.exe%' OR "ImageName" LIKE '%jsc.exe%' OR "ImageName" LIKE '%vbc.exe%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\wmiprvse.exe','%\mshta.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%http%','%\%','%\AppData\%','%\Temp\%','%\Users\Public\%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\Microsoft Visual Studio\%','%\Common7\IDE\%','%\BuildAgent\%','%\Jenkins\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%C:\Program Files (x86)\Microsoft Visual Studio%','%C:\Windows\Microsoft.NET\Framework%')))
