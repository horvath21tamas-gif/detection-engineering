Image IN ("*\\powershell.exe", "*\\pwsh.exe") OR CommandLine IN ("*New-InboxRule*", "*Set-InboxRule*", "*Set-Mailbox*") OR CommandLine IN ("*ForwardTo*", "*ForwardAsAttachmentTo*", "*RedirectTo*", "*DeliverToMailboxAndForward*") OR Image="*\\mgc.exe" OR CommandLine IN ("*messageRules*", "*mailFolders*") NOT (ParentImage IN ("*\\explorer.exe", "*\\outlook.exe") condition="not selection_powershell_rules") NOT (User IN ("*svc_exchange_migration*", "*adm_helpdesk_mail*", "*it_ops_automation*")) NOT username="NT AUTHORITY\\SYSTEM"
