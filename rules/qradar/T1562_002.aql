SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\wevtutil.exe' AND "Process "Process CommandLine"" ILIKE '%/e:false%' OR ""Filename"" ILIKE '%\wevtutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% cl %','% clear-log%')) OR ""Filename"" ILIKE '%\sc.exe' AND "Process "Process CommandLine"" ILIKE '%config%' AND "Process "Process CommandLine"" ILIKE '%eventlog%' AND "Process "Process CommandLine"" ILIKE '%start=%' AND "Process "Process CommandLine"" ILIKE '%disabled%' OR (""Filename"" ILIKE ENUMERATION('%\net.exe','%\net1.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%stop%','%eventlog%')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Set-Service%','%eventlog%','%Stopped%')) OR ""Filename"" ILIKE '%\reg.exe' AND "Process "Process CommandLine"" ILIKE '%add%' AND "Process "Process CommandLine"" ILIKE '%HKLM\SYSTEM\CurrentControlSet\Services\EventLog%' AND "Process "Process CommandLine"" ILIKE '%Start%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%0x4%','% 4%')) OR ""Filename"" ILIKE '%\reg.exe' AND "Process "Process CommandLine"" ILIKE '%add%' AND "Process "Process CommandLine"" ILIKE '%\Services\EventLog\%' AND "Process "Process CommandLine"" ILIKE '%Enabled%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%0x0%','% 0%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\w3wp.exe','%\mshta.exe','%\rundll32.exe') OR NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe','%\msiexec.exe')) OR ""Parent Filename"" ILIKE ENUMERATION('%\ConfigurationManager\%','%\IntuneManagementExtension\%','%\PDQDeploy\%','%\ManageEngine\%') OR "Process "Process CommandLine"" ILIKE '%TrustedInstaller%'))
