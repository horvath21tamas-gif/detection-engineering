CommandLine="*PATH=*" CommandLine IN ("PATH=/tmp:*", "PATH=/var/tmp:*", "PATH=/dev/shm:*", "PATH=/home/*", "PATH=/run/user/*") Image IN ("*/sudo", "*/pkexec", "*/su", "*/mount", "*/umount", "*/passwd", "*/chsh", "*/newgrp", "*/crontab") CommandLine IN ("* sudo *", "* pkexec *", "* su *", "* mount *", "* umount *", "* passwd *", "* chsh *", "* newgrp *", "* crontab *") NOT (CommandLine IN ("*secure_path=*", "*/usr/sbin:/usr/bin:/sbin:/bin*")) NOT (ParentImage IN ("*/bash", "*/zsh", "*/fish", "*/tmux", "*/screen"))
