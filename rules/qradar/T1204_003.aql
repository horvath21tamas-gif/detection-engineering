SELECT UTF8(payload) as search_payload from events where "Process "Process CommandLine"" IMATCHES '^[D-Z]:\\.*' AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe','%\regsvr32.exe','%\scrcons.exe')) AND ""Parent Filename"" ILIKE '%\explorer.exe' AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%setup.exe%','%install.exe%','%autorun.inf%') OR ""Filename"" ILIKE '%C:\Windows\%' OR "Process "Process CommandLine"" ILIKE '%\YourCompanyShare\%')
