source="WinEventLog:Security" (EventCode=5136 ObjectClass="trustedDomain" AttributeCommonName IN ("trustAttributes", "msDS-TrustForestTrustInfo", "trustDirection")) OR EventCode IN (4706, 4716) OR (Image IN ("*\\netdom.exe", "*\\nltest.exe") CommandLine IN ("* trust *", "*/quarantine*", "*/enable_sidhistory*")) NOT (SubjectUserSid="S-1-5-18" SubjectUserName="*$" SubjectUserName="*SVC_TrustAdmin*")
