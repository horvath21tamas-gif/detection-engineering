SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\wscript.exe','%\cscript.exe')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\mshta.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%http%','%xmlhttp%','%adodb.stream%','% -e:vbscript.encode%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%\slmgr.vbs%','%\manage-bde.vbs%','%\prnmngr.vbs%','%\pubprn.vbs%') OR ""Parent Filename"" ILIKE '%\services.exe')
