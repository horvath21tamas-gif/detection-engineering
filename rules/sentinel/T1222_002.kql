DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*/chmod", "*/chown", "*/chattr")) and (((ProcessCommandLine in ("*+s*", "*u+s*", "*+i*", "*+a*", "*777*", "*666*", "* +x *")) and (ProcessCommandLine in ("*/tmp/*", "*/dev/shm/*", "*/var/tmp/*"))) or (ProcessCommandLine in ("*/etc/shadow*", "*/etc/sudoers*", "*/etc/passwd*", "*/root/.ssh*", "*/var/spool/cron*", "*/etc/crontab*", "*/bin/sh*", "*/bin/bash*")) or (User in ("www-data", "apache", "nginx", "nobody", "mysql", "postgres"))) and (not ((ParentProcessName in ("*/bin/apt", "*/bin/dpkg", "*/bin/yum", "*/bin/dnf", "*/bin/rpm", "*/sbin/cloud-init")) or (ProcessCommandLine in ("* --help*", "* --version*"))))