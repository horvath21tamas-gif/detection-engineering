CommandLine IN ("* -Recurse*", "* /s *", "* -Include *", "* -Filter *", "*robocopy*", "*xcopy*") CommandLine IN ("*\\\\*", "*net use*", "*net view*") CommandLine IN ("*.doc*", "*.pdf*", "*.xls*", "*.pst*", "*.kdbx*", "*.key*", "*.config*", "*id_rsa*") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\w3wp.exe", "*\\rundll32.exe", "*\\explorer.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\Microsoft System Center\\*", "*C:\\Windows\\CCM\\*", "*C:\\Program Files\\Veritas\\*", "*C:\\Program Files\\Commvault\\*") OR CommandLine IN ("*SoftwareDistribution*", "*.log*") OR username="NT AUTHORITY\\SYSTEM")
