SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\wsmprovhost.exe','%\installutil.exe','%\regasm.exe','%\regsvcs.exe','%\mshta.exe','%\dotnet.exe')) AND "LoadedImage" ILIKE '%.dll' AND (("LoadedImage" LIKE '%\\Users\\%' OR "LoadedImage" LIKE '%\\AppData\\%' OR "LoadedImage" LIKE '%\\Temp\\%' OR "LoadedImage" LIKE '%\\ProgramData\\%')) AND NOT (("LoadedImage" LIKE '%\\Windows\\assembly\\%' OR "LoadedImage" LIKE '%\\assembly\\GAC%' OR "LoadedImage" LIKE '%\\assembly\\GAC_MSIL%' OR "LoadedImage" LIKE '%\\assembly\\GAC_32%' OR "LoadedImage" LIKE '%\\assembly\\GAC_64%' OR "LoadedImage" LIKE '%\\Microsoft.NET\\%')) AND NOT (("LoadedImage" LIKE '%\\Windows\\System32\\%' OR "LoadedImage" LIKE '%\\Windows\\SysWOW64\\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\devenv.exe','%\msbuild.exe','%\csc.exe','%\vbc.exe','%\nunit.exe','%\resharper.exe'))
