DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\sc.exe" or OriginalFileName =~ "sc.exe" or (FolderPath in ("*\powershell.exe", "*\pwsh.exe"))) and (ProcessCommandLine in ("* create *", "* config *", "* binPath*", "*New-Service*", "*Set-Service*")) and ((ProcessCommandLine in ("*:\Windows\Temp\*", "*:\Users\Public\*", "*:\ProgramData\*", "*\AppData\Local\Temp\*", "*admin$*", "*c$*", "*\127.0.0.1\*")) or (ProcessCommandLine in ("*cmd.exe /c*", "*cmd.exe /k*", "*powershell.exe -enc*", "* -ExecutionPolicy Bypass *"))) and (not ((ParentProcessName in ("*\msiexec.exe", "*\TrustedInstaller.exe", "*\CcmExec.exe")) or (username =~ "NT AUTHORITY\SYSTEM" and ProcessCommandLine contains "C:\Windows\System32\")))