winlog.event_data.filename:\^\[D\-Z\]\:\\.* AND ((file.path:(*\\.* OR *\\autorun* OR *\:*)) AND (file.path:(*.dat OR *.bin OR *.lnk OR *.vbs OR *.ps1))) AND (process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\rundll32.exe OR *\\regsvr32.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\scrcons.exe)) AND (NOT ((process.executable.caseless:(*\\explorer.exe OR *\\msiexec.exe)) AND (file.path:(*$RECYCLE.BIN* OR *System\ Volume\ Information* OR *Found.000*)) AND winlog.event_data.username:"NT AUTHORITY\\SYSTEM"))
