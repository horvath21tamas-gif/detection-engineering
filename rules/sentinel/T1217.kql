DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*\User Data\*\Bookmarks*", "*\User Data\*\History*", "*\User Data\*\Login Data*", "*\User Data\Local State*", "*\Profiles\*\places.sqlite*", "*\Profiles\*\key4.db*")) and (IntegrityLevel in ("Low", "Medium")) and ((((FolderPath in ("*\findstr.exe", "*\grep.exe", "*\sqlite3.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*type *", "*copy *", "*Get-ChildItem -Recurse*"))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\httpd.exe")) and (FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\brave.exe")))) or (ProcessCommandLine in ("* > *", "*Export-Csv*", "*ConvertTo-Json*", "*base64*")) or (ProcessCommandLine in ("*\Users\Public\*", "*\AppData\Local\Temp\*", "*\Temp\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Program Files\Splunk\*", "*\Program Files\Tanium\*", "*\CcmExec.exe*", "*\Ivanti\*", "*\PDQ\*"))))