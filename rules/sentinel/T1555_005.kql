DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*.kdbx*", "*.opvault*", "*.agilekeychain*", "*vault.db*", "*key3.db*", "*key4.db*")) and (((ProcessCommandLine in ("*copy *", "*type *", "*7z*", "*rar*", "*zip*", "*esentutl*", "*tar *", "*gzip *")) and (FolderPath in ("*\sqlite3.exe", "*\7z.exe", "*\rar.exe", "*\tar.exe", "*\gzip.exe"))) or ((FolderPath in ("*\Users\*", "*\AppData\Local\Temp\*", "*\Downloads\*", "*\Public\*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\python.exe", "*\node.exe")))) and (not (((FolderPath in ("*\Program Files\KeePass*", "*\Program Files\1Password*", "*\Program Files\Bitwarden*")) and (ParentProcessName in ("*\services.exe", "*\svchost.exe")) and username =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\OneDrive.exe", "*\Dropbox.exe", "*\GoogleDriveFS.exe", "*\Box\Box.exe"))))