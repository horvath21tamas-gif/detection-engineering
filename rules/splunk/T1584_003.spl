Image IN ("*\\aws.exe", "*\\az.exe", "*\\mgc.exe", "*\\gcloud.exe") OR CommandLine IN ("*delete-virtual-mfa-device*", "*deactivate-mfa-device*", "*create-access-key*", "*add-password*", "*update-login-profile*", "*create-service-principal*") NOT (User IN ("*svc_terraform*", "*svc_deploy*", "*github_actions_runner*") OR Image IN ("*\\Terraform\\*", "*\\actions-runner\\*", "*\\Jenkins\\*")) NOT (ParentImage="*\\explorer.exe" condition="not selection_cloud_identity_ops") NOT (CommandLine IN ("*get-caller-identity*", "*sts get-session-token*"))
