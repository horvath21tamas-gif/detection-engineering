DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((processcommandline =~ "(FromBase64String|ToBase64String|-decode\s|-encode\s|\[System\.Text\.Encoding\]::|BXAAR|TVqQA)" and processcommandline match "(*i).*[a-z0-9+/]{500,}.*") or ((Parentprocessname =~ "(winword\.exe|excel\.exe|w3wp\.exe|sqlservr\.exe)$" and processname =~ "(rundll32\.exe|regsvr32\.exe|colorcpl\.exe)$") and processcommandline =~ "(FromBase64String|ToBase64String|-decode\s|-encode\s|\[System\.Text\.Encoding\]::|BXAAR|TVqQA)")) and (not (processcommandline =~ "(C:\Windows\System32\wbem\WmiPrvSE\.exe|CCM\Cache|Microsoft\.Cloud\.Data)" and processname =~ "powershell_ise\.exe$" and UserName =~ "NT AUTHORITY\SYSTEM"))