SELECT UTF8(payload) as search_payload from events where (("Service Name " LIKE '%PSEXEC%' OR "Service Name " LIKE '%PAExec%' OR "Service Name " LIKE '%RemCom%' OR "Service Name " LIKE '%CSEXEC%' OR "Service Name " LIKE '%ATSVC%')) AND (""Filename"" ILIKE ENUMERATION('%\ADMIN$%','%\C$\Windows\%','%\Users\Public\%','%\AppData\Local\Temp\%','%\Windows\Temp\%') OR NOT (("Machine ID" LIKE '%MGMT-%' OR "Machine ID" LIKE '%SCCM-%' OR "Machine ID" LIKE '%DEPLOY-%' OR "Machine ID" LIKE '%ADMIN-%') OR ("UserName" LIKE '%svc_%' OR "UserName" LIKE '%admin_%' OR "UserName" LIKE '%deploy%' OR "UserName" LIKE '%sccm%' OR "UserName" LIKE '%ansible%' OR "UserName" LIKE '%pdq%') OR ""Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Tanium\%')))
