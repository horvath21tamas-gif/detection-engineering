Image IN ("*\\pagodo.exe", "*\\ghunt.exe", "*\\dork-cli.exe", "*\\snakedork.exe") OR CommandLine IN ("*google-dork*", "*bing-scraper*") OR (CommandLine="*--headless*" CommandLine="*webdriver*" CommandLine IN ("*google.com/search*", "*bing.com/search*")) OR Image IN ("*\\curl.exe", "*\\wget.exe", "*\\python.exe", "*\\pwsh.exe") OR (CommandLine="*site:*" CommandLine="*filetype:*") OR CommandLine IN ("*intitle:\"index of\"*", "*inurl:admin*") NOT (ParentImage="*\\explorer.exe" condition="not selection_specialized_tools") NOT (ParentImage IN ("*\\code.exe", "*\\devenv.exe", "*\\idea64.exe") CommandLine IN ("*msdn.microsoft.com*", "*stackoverflow.com*", "*github.com*")) NOT (CommandLine IN ("*--type=renderer*", "*--type=utility*", "*--type=gpu-process*"))
