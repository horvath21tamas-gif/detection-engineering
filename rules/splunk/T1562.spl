Image IN ("*\\net.exe", "*\\net1.exe", "*\\sc.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\taskkill.exe") OR filename IN ("net.exe", "net1.exe", "sc.exe", "PowerShell.EXE", "taskkill.exe") CommandLine IN ("*stop*", "*delete*", "*disable*", "*kill*", "*/F*") CommandLine IN ("*WinDefend*", "*MpsSvc*", "*Sense*", "*MsSense*", "*SentinelAgent*", "*CarbonBlack*", "*CylanceSvc*", "*CrowdStrike*", "*Symantec*", "*Sophos*", "*McAfee*") NOT (ParentImage IN ("*\\CcmExec.exe", "*\\Gpscript.exe"))
