SrcIp IN ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*") UriStem IN ("*/api/users*", "*/api/employees*", "*/api/profiles*", "*/directory*", "*/people*", "*/staff*", "*/team*", "*/search/users*", "*/lookup*") UriQuery IN ("*email=*", "*user=*", "*username=*", "*name=*", "*employee*", "*account*") Method="GET" UserAgent IN ("*curl*", "*wget*", "*python*", "*requests*", "*go-http-client*", "*httpclient*", "*libwww*", "*axios*", "*scanner*", "*probe*") Status IN (200, 206) NOT (UserAgent IN ("*Mozilla*", "*Chrome*", "*Firefox*", "*Safari*", "*Edge*", "*HeadlessChrome*") OR UserAgent IN ("*Googlebot*", "*Bingbot*", "*Slurp*", "*DuckDuckBot*", "*Yandex*", "*Baiduspider*", "*Ahrefs*", "*Semrush*", "*MJ12bot*") OR UserAgent IN ("*uptime*", "*pingdom*", "*datadog*", "*newrelic*", "*zabbix*", "*prometheus*")) | table SrcIp,Method,UriStem,UriQuery,Status,UserAgent
