((process.command_line:(*get\-signin\-token* OR *r\=signin* OR *sts\ get\-session\-token* OR *gcloud\ auth\ print\-access\-token* OR *okta\-auth\-token* OR *portal.azure.com* OR *account.google.com\/ServiceLogin* OR *login.microsoftonline.com*)) OR (((process.executable:(*\\chrome.exe OR *\\msedge.exe OR *\\firefox.exe)) AND (process.command_line:(*\-\-incognito* OR *\-\-new\-window* OR *\-\-app\=* OR *console.aws.amazon.com* OR *portal.azure.com* OR *cloud.google.com* OR *okta.com*))) AND ((process.parent.executable:(*\\wsmprovhost.exe OR *\\httpd.exe OR *\\sqlservr.exe OR *\\taskhostw.exe OR *\\explorer.exe)) AND process.parent.executable:*\\AppData\\Local\\Temp\\* AND (process.parent.command_line:(*\-NonInteractive* OR *\-EncodedCommand* OR *\/c\ powershell*)))) OR ((process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe)) AND (process.command_line:(*\-NonInteractive* OR *\-EncodedCommand* OR *\/c*)))) AND (NOT ((process.command_line:(*sso\ login* OR *login\ \-\-use\-device\-code* OR *az\ login* OR *aws\ sso\ login*)) AND (winlog.computer_name:(*ADMIN\-VDI\-* OR *DEV\-VM\-*))))
