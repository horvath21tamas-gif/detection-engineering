CommandLine IN ("* --SocksPort *", "* --ControlPort *", "* --DataDirectory *", "* -socks5-chain *", "* -forward-chain *", "*proxychains*") Image IN ("*\\AppData\\*", "*\\Temp\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Windows\\Temp\\*") OR Image IN ("*\\tor.exe", "*\\gost.exe", "*\\proxychains.exe", "*\\powershell.exe", "*\\rundll32.exe") NOT (Image IN ("*\\Program Files\\Tor Browser\\*", "*\\Program Files\\BraveSoftware\\*", "*\\Program Files (x86)\\*") OR CommandLine="*127.0.0.1*" OR username="NT AUTHORITY\\SYSTEM")
