CommandLine IN ("*/webhooks/*", "*api.telegram.org/bot*", "*raw.githubusercontent.com*", "*transfer.sh*", "*file.io*", "*pastebin.com/raw/*", "*webhook.site*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*", "*\\PerfLogs\\*", "*\\Windows\\Tasks\\*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\curl.exe", "*\\certutil.exe", "*\\bitsadmin.exe") CommandLine IN ("* -F *", "* --data *", "* -d *", "*downloadstring*", "*invoke-webrequest*", "*uploadfile*") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*chocolatey*", "*microsoft.com*", "*pnp.microsoft.com*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
