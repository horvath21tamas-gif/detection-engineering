SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\flashrom.exe','%\FPTW64.exe','%\AfuEfix64.exe','%\H2OFFT-W.exe') OR ("ImageName" LIKE '%FPTW64.exe%' OR "ImageName" LIKE '%flashrom.exe%') OR ""Filename"" ILIKE '%\mountvol.exe' AND "Process "Process CommandLine"" ILIKE '% /s%') AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\wmiprvse.exe')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\Dell\CommandUpdate\%','%\Lenovo\SystemUpdate\%','%\HP\HP Support Assistant\%')) AND ""Filename"" ILIKE '%C:\Windows\System32\SystemSettingsAdminFlows.exe%')
