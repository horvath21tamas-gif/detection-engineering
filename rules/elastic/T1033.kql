((process.executable:(*\\whoami.exe OR *\\quser.exe OR *\\qwinsta.exe)) OR (process.command_line:(*net\ user\ * OR *net\ localgroup\ * OR *$env\:username*))) AND ((process.command_line:(*\ \/priv* OR *\ \/groups* OR *\ \/all* OR *\ \/fo\ csv*)) OR ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\httpd.exe OR *\\wsmprovhost.exe)) AND winlog.event_data.IntegrityLevel:Medium) OR (process.command_line:(*\ \>\ * OR *findstr* OR *select\-string*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\svchost.exe OR *\\msiexec.exe OR *\\CcmExec.exe)) OR (process.command_line:(*Program\ Files* OR *AppData\\Local\\Temp*))))
