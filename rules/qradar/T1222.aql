SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\icacls.exe','%\takeown.exe','%\cacls.exe','%\attrib.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%:f%','% /grant%','%Everyone:%','%Authenticated Users:%','%/setowner%','%/inheritance:r%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\mshta.exe','%\wscript.exe','%\cscript.exe','%\httpd.exe','%\nginx.exe','%\php-cgi.exe','%\sqlservr.exe') OR ""Filename"" ILIKE ENUMERATION('%\Users\%','%\Temp\%','%\AppData\%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\Windows\servicing\TrustedInstaller.exe%','%\CcmExec.exe%','%\Program Files\Microsoft Visual Studio\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Microsoft\Windows\SoftwareDistribution%','%AppData\Local\Packages%')))
