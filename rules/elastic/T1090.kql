((process.command_line:(*listenport\=* OR *connectaddress\=*)) OR (process.command_line:(*\ \-socks5\ * OR *\ \-reverse\ * OR *\ \-L\:* OR *\ \-R\:* OR *\ \-\-proxy\-server\=*))) AND (process.executable:(*\\netsh.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\rundll32.exe OR *\\regsvr32.exe)) AND (NOT ((process.command_line:(*C\:\\Program\ Files\\Docker* OR *C\:\\Program\ Files\\WSL* OR *127.0.0.1* OR *\:\:1*)) AND winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND process.parent.executable:*\\services.exe))
