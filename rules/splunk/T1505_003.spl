("cs-method" IN ("POST", "PUT", "PATCH") "cs-uri-stem" IN ("*/uploads/*", "*/upload/*", "*/files/*", "*/images/*", "*/tmp/*", "*/data/*", "*/public/*") "cs-uri-stem" IN ("*.php", "*.phtml", "*.php5", "*.asp", "*.aspx", "*.jsp", "*.ashx", "*.cgi", "*.pl")) OR ("cs-uri-stem" IN ("*.php", "*.phtml", "*.php5", "*.asp", "*.aspx", "*.jsp", "*.ashx", "*.cgi", "*.pl") "cs-uri-query" IN ("*cmd=*", "*exec=*", "*system=*", "*powershell=*", "*whoami*", "*net user*", "*id*", "*uname*", "*curl *", "*wget *", "*base64*", "*eval(*", "*shell=*") "sc-status" IN (200, 201, 202) "cs-user-agent" IN ("*curl*", "*wget*", "*python*", "*powershell*", "*httpclient*", "*libwww*", "*java*", "*perl*") NOT ("cs-uri-stem" IN ("*/wp-admin/*", "*/wp-json/*", "*/administrator/*", "*/api/*", "*/rest/*", "*/media/*", "*/uploads/plugins/*", "*/uploads/themes/*")))
