DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("*kerberoast*", "*asreproast*", "*asreq*", "*golden*", "*silver*", "*ptt*", "*tgtdelegate*", "*ms-mcs-admpwd*")) and (FolderPath in ("*\rubeus.exe", "*\mimikatz.exe", "*\powershell.exe", "*\pwsh.exe", "*\klist.exe"))) or (ProcessCommandLine in ("* /rc4*", "* 0x17*", "* /aes128:*", "* /aes256:*", "* /ticket:*", "* /service:*", "* /outfile:*", "* /format:hashcat*", "* /format:john*"))) and (((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\php-cgi.exe", "*\psexesvc.exe")) and IntegrityLevel =~ "Medium") or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*"))) and (not ((username =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Windows\System32\lsass.exe", "*\Windows\System32\svchost.exe")) and ParentProcessName endswith "\services.exe") or (FolderPath in ("*C:\Program Files\Microsoft Monitoring Agent\*", "*C:\Program Files\Azure\*", "*C:\Program Files\RSAT\*"))))