Image="*\\attrib.exe" CommandLine="* +h*" CommandLine="* +s*" ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\mshta.exe", "*\\powershell.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe") OR CommandLine IN ("*\\Users\\Public\\*", "*\\Windows\\Temp\\*", "*\\AppData\\Roaming\\*", "*\\AppData\\Local\\Temp\\*", "*\\Downloads\\*") NOT (username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\Windows\\servicing\\TrustedInstaller.exe*", "*\\CcmExec.exe*", "*\\Windows\\System32\\wbem\\WMIC.exe*") CommandLine IN ("*desktop.ini*", "*attrib +h +s system32*", "*Program Files*")) | table Time,SourceImage,ParentImage,CommandLine,SourceUsername,TargetFilePath,FileAttributes
