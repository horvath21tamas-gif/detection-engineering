Image IN ("*\\hdparm.exe", "*\\nvflash.exe", "*\\mlxfwmanager.exe", "*\\wd-fw-update.exe") OR OriginalFileName IN ("nvflash.exe", "hdparm.exe", "FPTW64.exe") CommandLine IN ("* -f *", "* --write*", "* -update*", "* -s *") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\wscript.exe") OR Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Public\\*") NOT (Image IN ("*C:\\Program Files\\*", "*C:\\Program Files (x86)\\*") ParentImage="*\\svchost.exe" username="NT AUTHORITY\\SYSTEM")
