SELECT Time, user_name, operation_name, request_parameters, user_agent, mfa_authenticated, resource_id, subscription_id, tenant_id, source_ip from events where (("operation_name" LIKE '%RunInstances%' OR "operation_name" LIKE '%Microsoft.Compute/virtualMachines/write%' OR "operation_name" LIKE '%v1.compute.instances.insert%' OR "operation_name" LIKE '%CreateVirtualMachine%' OR "operation_name" LIKE '%Instances:Insert%')) AND (("request_parameters" LIKE '%p3.%' OR "request_parameters" LIKE '%p4.%' OR "request_parameters" LIKE '%g4.%' OR "request_parameters" LIKE '%c5.24xlarge%' OR "request_parameters" LIKE '%Standard_ND%' OR "request_parameters" LIKE '%Standard_NC%' OR "request_parameters" LIKE '%n1-highcpu-%' OR "request_parameters" LIKE '%n1-ultramem-%' OR "request_parameters" LIKE '%A100%' OR "request_parameters" LIKE '%V100%') OR "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%boto3%' OR "user_agent" LIKE '%postman%' OR "user_agent" LIKE '%curl%' OR "user_agent" LIKE '%Terraform%' OR "user_agent" LIKE '%Pulumi%'))) AND NOT (("user_name" LIKE '%svc-terraform%' OR "user_name" LIKE '%svc-github-actions%' OR "user_name" LIKE '%aws-autoscaling%' OR "user_name" LIKE '%svc-packer%' OR "user_name" LIKE '%svc-azure-devops%') OR ("user_name" LIKE '%system-internal%' OR "user_name" LIKE '%cloud-controller%'))
