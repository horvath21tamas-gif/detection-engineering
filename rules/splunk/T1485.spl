Image IN ("*\\vssadmin.exe", "*\\wmic.exe", "*\\sdelete.exe", "*\\cipher.exe", "*\\wbadmin.exe", "*\\powershell.exe") CommandLine IN ("*delete shadows*", "*shadowcopy delete*", "*shadowstorage*", "*delete catalog -quiet*") OR CommandLine IN ("* -p *", "* -z *", "* /w:*", "* -s *", "*del /f /s /q*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\rundll32.exe", "*\\httpd.exe", "*\\7zFM.exe") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*") NOT (username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\msiexec.exe", "*\\CcmExec.exe") CommandLine IN ("*cleanmgr.exe*", "*\\AppData\\Local\\Temp*"))
