DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\attrib.exe" and (ProcessCommandLine contains " +h" and ProcessCommandLine contains " +s")) or (ProcessCommandLine in ("* > *:*", "*type *:*", "*expand *:*", "*makecab *:*", "*findstr /v *:*", "*start *:*")) or (FolderPath endswith "\reg.exe" and (ProcessCommandLine contains "SpecialAccounts\UserList" and ProcessCommandLine contains " /d 0"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\mshta.exe", "*\wscript.exe", "*\cscript.exe", "*\chrome.exe", "*\msedge.exe", "*\browser.exe")) or (ProcessCommandLine in ("*\Users\Public\*", "*\Windows\Temp\*", "*\AppData\Roaming\*", "*\Downloads\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\Windows\servicing\TrustedInstaller.exe*", "*\CcmExec.exe*", "*\Windows\System32\wbem\WMIC.exe*")) and (ProcessCommandLine in ("*AppData\Local\Packages*", "*desktop.ini*", "*Program Files*"))))