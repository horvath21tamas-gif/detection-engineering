SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\mmc.exe' AND "ImageName"='mmc.exe' AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\rundll32.exe','%\mshta.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Public\%','%\Downloads\%','%\%','%http://%','%https://%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%/a%','%-Embedding%')) AND (("Integrity Level" LIKE '%Medium%' OR "Integrity Level" LIKE '%Low%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Windows\System32\%','%\Windows\SysWOW64\%','%eventvwr.msc%','%services.msc%','%compmgmt.msc%','%gpedit.msc%','%devmgmt.msc%','%taskschd.msc%') OR ""Parent Filename"" ILIKE '%\explorer.exe' AND "Integrity Level"='High')
