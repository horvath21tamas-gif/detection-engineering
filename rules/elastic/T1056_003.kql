(((process.executable:*\\certutil.exe AND (process.command_line:(*\-exportPFX* OR *\-user\ \-export* OR *\-p\ *))) OR ((process.executable:(*\\powershell.exe OR *\\pwsh.exe)) AND (process.command_line:(*Export\-PfxCertificate* OR *Export\-Certificate* OR *\ \-Password*)))) OR (process.command_line:(*crypto\:\:certificates* OR *crypto\:\:keys* OR *patch* OR *certificates\ \/pvk*)) OR (process.command_line:(*copy\ * OR *move\ * OR *type\ *))) AND (process.executable:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Public\\*)) AND (NOT ((process.executable:(*\\Windows\\System32\\certsrv.exe* OR *\\Windows\\System32\\certmgr.dll*)) OR (process.parent.executable:(*\\services.exe OR *\\svchost.exe)) OR user.name:NT\ AUTHORITY\\*))
