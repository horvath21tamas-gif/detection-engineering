SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\robocopy.exe','%\xcopy.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%copy %','%xcopy %','%robocopy %','%Copy-Item%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\svchost.exe%','%\lsass.exe%','%\services.exe%','%\explorer.exe%','%\winlogon.exe%','%\csrss.exe%','%\smss.exe%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%C:\Windows\System32\%','%C:\Windows\SysWOW64\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\ProgramData\%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\Installer\%','%\Microsoft Configuration Manager\%','%\Windows\CCM\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Tanium\%','%\Setup\%','%\Update\%'))
