SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('%securityd%','%keychain.db%')) AND (""Filename"" ILIKE ENUMERATION('%/lldb','%/gcore','%/vmmap','%/heap') OR ""Process CommandLine"" ILIKE ENUMERATION('%attach%','%memory read%','%dump%','%save%') OR ""Filename"" ILIKE ENUMERATION('%/Users/%','%/tmp/%','%/var/tmp/%','%/Library/Caches/%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/usr/bin/sysdiagnose','%/usr/libexec/periodic-wrapper','%/System/Library/CoreServices/ReportCrash'))
