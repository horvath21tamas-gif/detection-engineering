SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/sh','%/bash','%/zsh','%/dash','%/ash')) AND (""Parent Filename"" ILIKE ENUMERATION('%/httpd','%/apache2','%/nginx','%/php-fpm','%/python','%/node','%/mysqld','%/postgres','%/redis-server') OR ""Process CommandLine"" ILIKE ENUMERATION('%/dev/tcp/%','%/dev/udp/%','%interactive%','%>&%','%0>&1%') OR ""Process CommandLine"" ILIKE '%curl%' AND ""Process CommandLine"" ILIKE '%|%' AND ""Process CommandLine"" ILIKE '%sh%' OR ""Process CommandLine"" ILIKE '%wget%' AND ""Process CommandLine"" ILIKE '%-O-%') AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/systemd','%/sbin/init') OR ""Process CommandLine"" ILIKE ENUMERATION('%/var/lib/apt/%','%/tmp/terraform_%','%logrotate%') OR "username"='root' AND "Parentprocessname"='/usr/sbin/sshd')
