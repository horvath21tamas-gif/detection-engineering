CommandLine IN ("*/rest/api/space*", "*/rest/api/content*", "*/doexportpage.action*", "*/exportword*", "*pages/viewpage.action*pageId=*") Image IN ("*\\curl.exe", "*\\wget.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\python.exe", "*\\confluence-cli.exe") (ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\winword.exe", "*\\excel.exe", "*\\rundll32.exe") IntegrityLevel="Medium") OR CommandLine IN ("* > *", "* -OutFile *", "* -o *", "*\\Users\\Public\\*", "*\\Temp\\*") NOT (Image IN ("*C:\\Program Files\\Atlassian\\*", "*C:\\Program Files (x86)\\Atlassian\\*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*confluence-healthcheck*", "*inventory-agent*"))
