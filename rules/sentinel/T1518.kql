DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\wmic.exe", "*\reg.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Get-Package*", "*Get-ItemProperty*", "*product get name*", "*software list*", "*Get-WmiObject*", "*Get-CimInstance*"))) and ((ProcessCommandLine in ("*defender*", "*sentinel*", "*crowdstrike*", "*falcon*", "*carbonblack*", "*fireeye*", "*tanium*", "*sophos*", "*symantec*", "*kaspersky*", "*mcafee*", "*EDR*", "*HIPS*", "*AV*")) or (ProcessCommandLine in ("* > *", "* | *", "*ConvertTo-Json*", "*Export-Csv*", "*findstr*", "*Select-String*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe", "*\outlook.exe")) and IntegrityLevel =~ "Medium")) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\CcmExec.exe", "*\svchost.exe", "*\msiexec.exe", "*\explorer.exe")) and (ProcessCommandLine in ("*Program Files*", "*Google\Update*", "*Windows Defender*", "*Microsoft Security*"))))