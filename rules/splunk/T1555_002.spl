CommandLine IN ("*securityd*", "*keychain.db*") Image IN ("*/lldb", "*/gcore", "*/vmmap", "*/heap") OR CommandLine IN ("*attach*", "*memory read*", "*dump*", "*save*") OR Image IN ("*/Users/*", "*/tmp/*", "*/var/tmp/*", "*/Library/Caches/*") NOT (ParentImage IN ("*/usr/bin/sysdiagnose", "*/usr/libexec/periodic-wrapper", "*/System/Library/CoreServices/ReportCrash"))
