Image="*\\tscon.exe" OriginalFileName="tscon.exe" CommandLine IN ("* /dest:console*", "*dest:rdp-tcp#*", "* /password*") OR (ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\psexesvc.exe", "*\\wsmprovhost.exe", "*\\winword.exe") IntegrityLevel="System") NOT (ParentImage IN ("*\\svchost.exe", "*\\winlogon.exe") CommandLine IN ("*vmsvga*", "*Citrix*", "*C:\\Program Files\\*") username="NT AUTHORITY\\NETWORK SERVICE") | table Time,SourceImage,ParentImage,CommandLine,SourceUsername,IntegrityLevel
