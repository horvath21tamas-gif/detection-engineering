SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\mmc.exe' OR "ImageName"='mmc.exe') AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\powershell.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Public\%','%\Downloads\%','%\%','%http%')) AND NOT (""Parent Filename"" ILIKE '%\explorer.exe' AND "Process "Process CommandLine"" ILIKE '%C:\Windows\System32\%' AND "username" ILIKE '%Admin%')
