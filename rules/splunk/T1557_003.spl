(CommandLine IN ("*--dns*", "*--gateway*", "*--lease*", "*--dhcp*", "*dhcp-server*", "*rogue*", "*spoof*") Image IN ("*\\python.exe", "*\\pythonw.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe")) OR CommandLine IN ("*Responder*", "*bettercap*", "*ettercap*", "*Inveigh*", "*mitm6*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*") User="NT AUTHORITY\\*" NOT (Image IN ("C:\\Program Files\\VMware\\*", "C:\\Program Files (x86)\\VMware\\*", "C:\\Program Files\\Oracle\\VirtualBox\\*", "C:\\Program Files\\Docker\\*", "C:\\Program Files\\Microsoft\\Hyper-V\\*") OR (Image="*\\System32\\svchost.exe" CommandLine="*dhcpssvc*") OR Image IN ("*\\Program Files\\Microsoft Configuration Manager\\*", "*\\Program Files\\Wireshark\\*", "*\\Program Files\\nmap\\*"))
