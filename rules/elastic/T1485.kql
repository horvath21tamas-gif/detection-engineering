(process.executable:(*\\vssadmin.exe OR *\\wmic.exe OR *\\sdelete.exe OR *\\cipher.exe OR *\\wbadmin.exe OR *\\powershell.exe)) AND ((process.command_line:(*delete\ shadows* OR *shadowcopy\ delete* OR *shadowstorage* OR *delete\ catalog\ \-quiet*)) OR (process.command_line:(*\ \-p\ * OR *\ \-z\ * OR *\ \/w\:* OR *\ \-s\ * OR *del\ \/f\ \/s\ \/q*))) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\rundll32.exe OR *\\httpd.exe OR *\\7zFM.exe)) AND (process.executable:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND (process.parent.executable:(*\\msiexec.exe OR *\\CcmExec.exe)) AND (process.command_line:(*cleanmgr.exe* OR *\\AppData\\Local\\Temp*))))
