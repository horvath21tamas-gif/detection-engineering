SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\rundll32.exe' AND (("Process CommandLine" LIKE '%javascript:%' OR "Process CommandLine" LIKE '%RunHTMLApplication%' OR "Process CommandLine" LIKE '%mshtml%' OR "Process CommandLine" LIKE '%http://%' OR "Process CommandLine" LIKE '%https://%' OR "Process CommandLine" LIKE '%scrobj.dll%' OR "Process CommandLine" LIKE '%shell32.dll%' OR "Process CommandLine" LIKE '%ShellExec_RunDLL%')) AND (("ParentImage" LIKE '%\\powershell.exe%' OR "ParentImage" LIKE '%\\pwsh.exe%' OR "ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\mshta.exe%') OR ("Process CommandLine" LIKE '%\\Users\\%' OR "Process CommandLine" LIKE '%\\AppData\\%' OR "Process CommandLine" LIKE '%\\Temp\\%' OR "Process CommandLine" LIKE '%\\Downloads\\%')) AND NOT (("Process CommandLine" LIKE '%\\Windows\\System32\\%' OR "Process CommandLine" LIKE '%\\Windows\\SysWOW64\\%') OR ("ParentImage" LIKE '%\\Windows\\Installer\\%' OR "ParentImage" LIKE '%\\Program Files\\%' OR "ParentImage" LIKE '%\\Program Files (x86%')\%','%\DriverStore\%','%\Dell\%','%\HP\%','%\Lenovo\%','%\Intel\%'))
