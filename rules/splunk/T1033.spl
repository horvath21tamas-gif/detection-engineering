Image IN ("*\\whoami.exe", "*\\quser.exe", "*\\qwinsta.exe") OR CommandLine IN ("*net user *", "*net localgroup *", "*$env:username*") CommandLine IN ("* /priv*", "* /groups*", "* /all*", "* /fo csv*") OR (ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\httpd.exe", "*\\wsmprovhost.exe") IntegrityLevel="Medium") OR CommandLine IN ("* > *", "*findstr*", "*select-string*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\svchost.exe", "*\\msiexec.exe", "*\\CcmExec.exe") OR CommandLine IN ("*Program Files*", "*AppData\\Local\\Temp*"))
