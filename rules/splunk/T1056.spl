(Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\cscript.exe") CommandLine IN ("*user32.dll,SetWindowsHook*", "*[User32]::GetAsyncKeyState*", "*GetKeyboardState*", "*RawInput*")) OR (CommandLine IN ("* >> *", "*out-file*") Image IN ("*\\Users\\*", "*\\Temp\\*")) OR CommandLine IN ("*Invoke-Keystrokes*", "*Get-Keystrokes*", "*keylog_recorder*", "*logkeys*") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") CommandLine="*node_modules*" User="NT AUTHORITY\\*")
