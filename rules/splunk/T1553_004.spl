Image IN ("*\\certutil.exe", "*\\certmgr.exe", "*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("* Root*", "* AuthRoot*", "* Cert:\\LocalMachine\\Root*", "* Cert:\\CurrentUser\\Root*") CommandLine IN ("* -f*", "* -user*", "* -enterprise*", "* -silent*") OR CommandLine IN ("*\\AppData\\*", "*\\Users\\Public\\*", "*\\Downloads\\*", "*\\Desktop\\*", "*\\PerfLogs\\*", "*\\ProgramData\\*", "*\\Temp\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\acrord32.exe", "*\\mshta.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\regsvr32.exe") NOT (ParentImage IN ("C:\\Windows\\System32\\gpscript.exe*", "C:\\Windows\\System32\\svchost.exe*", "C:\\Windows\\servicing\\TrustedInstaller.exe*", "C:\\Program Files\\Microsoft Configuration Manager\\*") User IN ("NT AUTHORITY\\SYSTEM*", "NT AUTHORITY\\NETWORK SERVICE*")) NOT (ParentImage IN ("*\\gpupdate.exe", "*\\mmc.exe"))
