Image IN ("*\\wscript.exe", "*\\cscript.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\regsvr32.exe", "*\\mshta.exe", "*\\rundll32.exe") CommandLine IN ("*.jpg*", "*.jpeg*", "*.png*", "*.gif*", "*.txt*", "*.log*", "*.pdf*", "*.doc*", "*.docx*", "*.xls*", "*.xlsx*", "*.ppt*", "*.pptx*", "*.tmp*", "*.ini*", "*.dat*", "*.cfg*") CommandLine IN ("*\\Users\\*", "*\\Downloads\\*", "*\\Temp\\*", "*\\Windows\\Temp\\*", "*\\ProgramData\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe", "*\\winrar.exe", "*\\7zFM.exe", "*\\explorer.exe") NOT ((username IN ("NT AUTHORITY\\SYSTEM", "NT AUTHORITY\\LOCAL SERVICE", "NT AUTHORITY\\NETWORK SERVICE") ParentImage="*\\services.exe") OR ParentImage IN ("*\\msiexec.exe", "*\\trustedinstaller.exe") OR CommandLine IN ("*C:\\Windows\\ccmcache\\*", "*healthcheck.txt*", "*Telemetry*"))
