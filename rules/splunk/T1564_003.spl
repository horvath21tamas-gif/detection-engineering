Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\mshta.exe", "*\\cscript.exe", "*\\wscript.exe") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\acrord32.exe", "*\\sqlservr.exe", "*\\w3wp.exe") OR CommandLine IN ("* -enc*", "* -e *", "* -nop*", "* -noni*", "*iex*", "*downloadstring*", "*frombase64string*", "*Invoke-Expression*") NOT (username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\Windows\\System32\\ServerManager.exe*", "*\\Configuration Manager\\*", "*\\HealthService.exe*", "*\\CcmExec.exe*") CommandLine IN ("*Chocolatey*", "*Splunk*", "*Logitech*", "*SCCM*", "*Microsoft.WSUS*"))
| regex CommandLine="(-w\\s*h|-window\\s*h|-win\\s*h|-wind\\s*h|showwindow\\s*=\\s*0|windowstyle\\s*1|sw_hide)" | table Time,SourceImage,ParentImage,CommandLine,SourceUsername
