DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((["*"] contains "no logging" or ["*"] contains "no logging buffer" or ["*"] contains "no logging console" or ["*"] contains "clear logging") or (["*"] contains "no service password-encryption" or ["*"] contains "no password-encryption") or (["*"] contains "privilege level 15" or ["*"] contains "transport input telnet" or ["*"] contains "permit any any") or (["*"] contains "copy running-config tftp" or ["*"] contains "copy running-config ftp" or ["*"] contains "copy running-config scp")) and (not ((SourceAddress in ("10.0.50.10", "10.0.50.100")) or ProcessCommandLine =~ "show running-config"))