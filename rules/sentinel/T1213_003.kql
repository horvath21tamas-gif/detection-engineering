DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*/wiki/display/*", "*/wiki/pages/viewpage*", "*stackoverflow.com/c/*", "*.wiki.git*", "*/rest/api/content*expand=body*")) and (FolderPath in ("*\wget.exe", "*\httrack.exe", "*\python.exe", "*\curl.exe", "*\git.exe")) and ((ProcessCommandLine in ("* --mirror*", "* --recursive*", "* -r *", "* --level *", "* clone *", "* --accept pdf,docx,zip*")) or ((ParentProcessName in ("*\w3wp.exe", "*\cmd.exe", "*\powershell.exe")) and IntegrityLevel =~ "Medium")) and (not ((FolderPath in ("*C:\Program Files\Elastic\*", "*C:\Program Files\Splunk\*")) or username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*healthcheck*", "* --version*"))))