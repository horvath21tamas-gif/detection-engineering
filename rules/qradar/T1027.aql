SELECT UTF8(payload) as search_payload from events where ("Image" LIKE ('%\powershell.exe','%\pwsh.exe')) AND ("Process CommandLine" LIKE ('%-enc%','%-encodedcommand%')) AND ("Process CommandLine" LIKE ('%Invoke-WebRequest%','%iwr%','%wget%','%curl%','%DownloadString%','%DownloadFile%','%Net.WebClient%'))
