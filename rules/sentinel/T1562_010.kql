DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("* -version 2*", "* -ver 2*", "* -v 2*", "* -Version 2.0*")) and ((ProcessCommandLine in ("* -enc*", "* -encodedcommand*", "*FromBase64String*", "*IEX *", "*Invoke-Expression*")) or (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*")))) or ((FolderPath in ("*\reg.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*LmCompatibilityLevel*", "*NtlmMinClientSec*", "*NtlmMinServerSec*", "*RestrictSendingNTLMTraffic*")) and ProcessCommandLine matches regex "(?i).*(\\s(0|1|2)\\b).*") or (ProcessCommandLine in ("*SchUseStrongCrypto*", "*SystemDefaultTlsVersions*", "*SSL 2.0*", "*SSL 3.0*")) or (ProcessCommandLine in ("*DisableAntiSpyware*", "*DisableRealtimeMonitoring*", "*Set-MpPreference*"))) and (IntegrityLevel in ("Medium", "High", "System")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe", "*\php-cgi.exe", "*\mshta.exe", "*\rundll32.exe", "*\wmiprvse.exe")) or (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*"))) and (not ((username in ("NT AUTHORITY\SYSTEM", "NT AUTHORITY\NETWORK SERVICE")) and (ParentProcessName in ("*\services.exe*", "*\svchost.exe*", "*\CcmExec.exe*", "*\Program Files\Microsoft Monitoring Agent\*")) and (ProcessCommandLine in ("*AzureAD*", "*Exchange*", "*Intune*", "*ConfigurationManager*"))))