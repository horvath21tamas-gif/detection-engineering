DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where TargetFilename matches regex "(\\\\Default\\\\Cookies|\\\\Default\\\\Network\\\\Cookies|\\\\Profiles\\\\.*\\.default-release\\\\cookies\\.sqlite|\\\\Local State)$" and (FolderPath matches regex "(\\\\Users\\\\|\\\\Temp\\\\|\\\\AppData\\\\Local\\\\|\\\\AppData\\\\Roaming\\\\|\\\\Public\\\\)" or FolderPath matches regex "(powershell\\.exe|pwsh\\.exe|cmd\\.exe|cscript\\.exe|wscript\\.exe|python\\.exe)$") and (not (FolderPath matches regex "(chrome\\.exe|msedge\\.exe|firefox\\.exe|brave\\.exe|opera\\.exe)$" or (FolderPath matches regex "^(C:\\\\Program Files\\\\|C:\\\\Program Files \\(x86\\)\\\\|C:\\\\Windows\\\\System32\\\\)" and username =~ "NT AUTHORITY\SYSTEM")))