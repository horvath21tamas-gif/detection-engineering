SELECT UTF8(payload) as search_payload from events where (("Operation" LIKE '%New-Mailbox%' OR "Operation" LIKE '%Add-MailboxPermission%' OR "Operation" LIKE '%Set-Mailbox%' OR "Operation" LIKE '%New-InboxRule%')) AND (("Parameters" LIKE '%AccessRights=FullAccess%' OR "Parameters" LIKE '%ForwardingAddress%' OR "Parameters" LIKE '%ForwardingSmtpAddress%' OR "Parameters" LIKE '%DeliverToMailboxAndForward=True%') OR ("ClientInfoString" LIKE '%Client=Microsoft.Exchange.Management%' OR "ClientInfoString" LIKE '%PowerShell%' OR "ClientInfoString" LIKE '%Custom-Context-Script%')) AND NOT ("ClientInfoString" ILIKE '%Client=MSExchangeRPC%' OR ("UserId" LIKE '%SVC_Okta%' OR "UserId" LIKE '%AzureADConnect%' OR "UserId" LIKE '%Sync_%'))
