DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*raw.githubusercontent.com*", "*pastebin.com/raw/*", "*gist.githubusercontent.com/raw*", "*api.telegram.org/bot*", "*t.me/s/*", "*api.twitter.com/2/tweets*")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\wscript.exe", "*\cscript.exe", "*\wmiprvse.exe")) or (FolderPath in ("*\certutil.exe", "*\bitsadmin.exe", "*\curl.exe", "*\powershell.exe", "*\rundll32.exe"))) and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) and (ProcessCommandLine in ("*winget*", "*chocolatey*", "*microsoft.com*")) and username =~ "NT AUTHORITY\SYSTEM" and ParentProcessName endswith "\explorer.exe"))