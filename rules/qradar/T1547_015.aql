SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%Classes\CLSID\%' AND "Target Object" ILIKE '%\InprocServer32\(Default)' AND (("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%:\\Windows\\Temp\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%AppData\\Local\\Temp\\%' OR "Target Details" LIKE '%C:\\PerfLogs\\%') OR (("Target Details" LIKE '%.tmp%' OR "Target Details" LIKE '%.dat%' OR "Target Details" LIKE '%.js%' OR "Target Details" LIKE '%.vbs%')) AND (("Target Details" LIKE '%scrobj.dll%' OR "Target Details" LIKE '%script:%'))) AND NOT (""Filename"" ILIKE ENUMERATION('%\Microsoft\OneDrive\OneDrive.exe','%\Microsoft\Teams\current\Teams.exe','%\System32\msiexec.exe','%\trustedinstaller.exe','%\AppData\Local\Microsoft\Edge\Application\msedge.exe') OR ("Target Details" LIKE '%C:\\Program Files\\%' OR "Target Details" LIKE '%C:\\Program Files (x86%')\%','%C:\Windows\System32\%'))
