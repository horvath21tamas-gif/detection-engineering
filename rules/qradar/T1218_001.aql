SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\hh.exe' AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\powershell.exe','%\cmd.exe','%\chrome.exe','%\msedge.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%http%','%its:%','%mk:@MSITStore%','%-decompile%','%.txt%','%.jpg%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\%','%\Users\Public\%','%\Downloads\%','%\Temp\%'))) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('C:\Program Files\%','C:\Program Files (x86)\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%http%','%-decompile%')))
