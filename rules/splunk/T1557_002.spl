(Image="*\\reg.exe" CommandLine="*1*") OR CommandLine IN ("*arpspoof*", "*bettercap*", "*ettercap*", "* -i *", "* -t *", "* -m arp*", "*.sniff*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*") Image IN ("*\\python.exe", "*\\pythonw.exe", "*\\powershell.exe") NOT ((ParentImage IN ("*\\Program Files\\VMware\\*", "*\\Program Files\\Oracle\\VirtualBox\\*") username="NT AUTHORITY\\SYSTEM") OR Image IN ("*\\Program Files\\Wireshark\\*", "*\\Program Files\\Cisco\\*", "*\\System32\\nbtstat.exe*", "*\\System32\\pathping.exe*"))
