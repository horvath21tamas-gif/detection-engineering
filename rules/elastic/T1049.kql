((process.executable:(*\\netstat.exe OR *\\net.exe OR *\\net1.exe OR *\\nbtstat.exe OR *\\arp.exe)) OR (process.command_line:(*Get\-NetTCPConnection* OR *Get\-NetUDPEndpoint* OR *net\ session* OR *net\ use* OR *net\ view*))) AND ((process.command_line:(*\ \-ano* OR *\ \-na\ * OR *\ \-p\ tcp* OR *\ \-s\ *)) OR ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\httpd.exe OR *\\wsmprovhost.exe)) AND winlog.event_data.IntegrityLevel:Medium) OR (process.command_line:(*findstr* OR *select\-string* OR *\ \>\ * OR *ConvertTo\-Json*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\svchost.exe OR *\\CcmExec.exe OR *\\msiexec.exe)) OR (process.command_line:(*Program\ Files* OR *Splunk* OR *healthcheck*))))
