DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ParentProcessName endswith "\sqlservr.exe" and ((FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\bitsadmin.exe", "*\certutil.exe", "*\net.exe", "*\net1.exe", "*\whoami.exe", "*\systeminfo.exe", "*\nltest.exe", "*\scrcons.exe")) or (ProcessCommandLine in ("*sp_configure*", "*xp_cmdshell*", "*RECONFIGURE*", "*show advanced options*", "*Ole Automation Procedures*"))) and (not (ParentProcessName endswith "\sqlagent.exe" or (FolderPath contains "\Microsoft SQL Server\...\Setup\" and ProcessCommandLine contains "sqlagent.exe -i")))