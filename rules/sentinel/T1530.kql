DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\aws.exe", "*\az.exe", "*\gsutil.exe", "*\rclone.exe", "*\mc.exe", "*\s3cmd.exe")) and ((ProcessCommandLine in ("*--access-key*", "*--secret-key*", "*--connection-string*", "*SharedAccessSignature*", "*--account-key*", "*--secret-access-key*", "*--sas-token*")) or (ProcessCommandLine in ("* s3 sync *", "* storage blob download-batch *", "* cp --recursive *", "* cp -r *", "* ls -R *", "* --include \"*.*\"*", "* rsync *", "* azcopy *"))) and ((ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\nginx.exe", "*\powershell.exe", "*\cmd.exe", "*\pwsh.exe")) and IntegrityLevel =~ "Medium" and User startswith "USER_") and (not ((ProcessCommandLine in ("*Azure-Log-Collector*", "*C:\Program Files\Microsoft SDKs\*", "*cloud-init*", "*backup.ps1*")) and username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\Jenkins\*", "*\TeamCity\*", "*\GitLabRunner\*"))))