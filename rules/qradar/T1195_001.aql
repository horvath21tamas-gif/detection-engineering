SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\node.exe','%\npm.cmd','%\python.exe','%\pip.exe','%\msbuild.exe','%\dotnet.exe','%\csc.exe','%\cmake.exe')) AND (""Filename"" ILIKE ENUMERATION('%\whoami.exe','%\net.exe','%\net1.exe','%\ipconfig.exe','%\nltest.exe','%\systeminfo.exe','%\nslookup.exe','%\certutil.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%curl %','%wget %','%Invoke-WebRequest%','%DownloadString%','%env%','%base64%')) AND NOT ("Process "Process CommandLine"" ILIKE '%\node_modules\.bin\%' OR ""Filename"" ILIKE '%\AppData\Local\npm-cache\%' OR ""Filename"" ILIKE '%\site-packages\%' OR "Process "Process CommandLine"" ILIKE '%setup.py install%')
