Image IN ("*\\dnscmd.exe", "*\\nsupdate.exe") OR CommandLine IN ("* /ZoneResetMasters*", "* /Config *", "* /ZoneAdd *", "* /RecordAdd *") OR (ParentImage IN ("*\\dns.exe", "*\\named.exe", "*\\coredns.exe") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\whoami.exe", "*\\certutil.exe", "*\\curl.exe")) NOT (username="NT AUTHORITY\\SYSTEM" CommandLine="* /RecordAdd *") NOT (User IN ("*svc_dns_mgr*", "*adm_net_ops*") Image="*\\System32\\ServerManager.exe*") NOT (ParentImage="*\\explorer.exe" condition="not selection_dns_critical_ops")
