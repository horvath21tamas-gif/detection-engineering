SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('%.bashrc%','%.bash_profile%','%.zshrc%','%.profile%','%/etc/profile%','%/etc/bash.bashrc%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%DEBUG%','%EXIT%','%RETURN%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%curl%','%wget%','%base64%','%python%','%/dev/tcp/%','%sh -i%','%nc %')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/ansible-playbook','%/chef-client','%/salt-minion','%/puppet','%/dpkg','%/apt') OR ""Process CommandLine"" ILIKE ENUMERATION('%rbenv rehash%','%pyenv%','%bash_completion%'))
