Image="*\\wevtutil.exe" OR CommandLine IN ("*Get-WinEvent*", "*Get-EventLog*", "*enum-logs*", "*el *") CommandLine IN ("* -ListLog *", "* get-log *", "* /f:json*", "*ConvertTo-Json*", "* > *") OR (ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe") IntegrityLevel="Medium") NOT (username="NT AUTHORITY\\SYSTEM" Image IN ("*\\Program Files\\SplunkUniversalForwarder\\*", "*\\Program Files\\Elastic\\Agent\\*", "*\\Windows\\System32\\CcmExec.exe*") CommandLine="*Get-WinEvent -FilterHashtable*")
