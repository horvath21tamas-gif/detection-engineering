SELECT UTF8(payload) as search_payload from events where "Target Object" IMATCHES '\\Software\\Microsoft\\Office\\.*\\Outlook\\(WebView\\URL|Security\\EnableRoamingFolderHomepages|Security\\EnableExternalFolderHomepages)$' AND ("Target Details" IMATCHES '(http|script|file://|C:\\Users\\Public|C:\\Windows\\Temp)' OR ""Filename"" IMATCHES '(powershell\.exe|pwsh\.exe|cmd\.exe|reg\.exe|cscript\.exe|wscript\.exe)$') AND NOT ("Target Details" IMATCHES '(https://outlook\.office365\.com|res://)' AND ""Filename"" IMATCHES 'gpscript\.exe$')
