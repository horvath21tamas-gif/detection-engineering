DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ProcessCommandLine matches regex ".*\\\\Winlogon\\\\(SpecialAccounts\\\\UserList|UserList).*" and ProcessCommandLine matches regex ".*(/d\\s*0|REG_DWORD).*" and (((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powershell.exe", "*\cmd.exe", "*\mshta.exe", "*\cscript.exe", "*\wscript.exe", "*\bash.exe")) and (FolderPath in ("*\Users\*", "*\Temp\*", "*\AppData\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\Windows\System32\svchost.exe*", "*\Windows\servicing\TrustedInstaller.exe*", "*\CcmExec.exe*", "*\Program Files\Microsoft SQL Server\*", "*\Program Files\Microsoft Visual Studio\*")) and (ProcessCommandLine in ("*InstallShield*", "*msiexec*", "*SQLSetup*")))))