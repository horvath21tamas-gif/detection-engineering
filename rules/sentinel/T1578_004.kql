DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (operation_name in ("*ModifyImageAttribute*", "*CopyImage*", "*Microsoft.Compute/images/write*", "*v1.compute.images.setLabels*")) and ((request_parameters in ("*all*", "*public*", "*grantee*")) or (mfa_authenticated =~ "false" and (user_agent in ("*kali*", "*python-requests*", "*boto3*", "*curl*", "*postman*")))) and (not ((user_name in ("svc-packer*", "svc-terraform*", "image-pipeline-admin*", "azure-image-builder*")) or (user_name in ("*system-internal*", "*service-linked-role*"))))