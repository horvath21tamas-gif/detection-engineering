"cs-uri-query" IN ("*<script*", "*</script*", "*<svg*", "*<iframe*", "*javascript:*", "*onerror=*", "*onload=*", "*%3cscript*", "*%3csvg*", "*%3ciframe*", "*%6a%61%76%61%73%63%72%69%70%74*") OR ("cs-method"="POST" "cs-uri-query" IN ("*<script*", "*javascript:*", "*onerror=*")) "sc-status" IN (200, 403, 500) NOT ("cs-user-agent" IN ("*sqlmap*", "*nikto*", "*acunetix*", "*burp*", "*nessus*", "*zap*", "*w3af*") OR "cs-uri-stem" IN ("*.js", "*.css", "*.png", "*.jpg", "*.gif", "*.svg"))
