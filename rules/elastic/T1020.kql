((process.command_line:(*\ \-p* OR *\ \-hp* OR *\ \-mhe\=on* OR *\ \-mx9* OR *\ \-ta*)) OR (process.executable:(*\\rclone.exe OR *\\mega.exe OR *\\file.exe OR *\\powershell.exe OR *\\curl.exe))) AND (process.executable:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Public\\* OR *\\PerfLogs\\*)) AND (process.command_line:(*copy\ * OR *sync\ * OR *ftp* OR *http* OR *\-\-config*)) AND (NOT ((process.executable:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) OR (process.command_line:(*localhost* OR *127.0.0.1*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR process.parent.executable:*\\services.exe))
