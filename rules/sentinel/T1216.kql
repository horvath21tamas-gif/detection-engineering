DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\wscript.exe", "*\cscript.exe")) or (OriginalFileName in ("wscript.exe", "cscript.exe"))) and (ProcessCommandLine in ("*pubprn.vbs*", "*slmgr.vbs*", "*manage-bde.wsf*", "*SyncAppvPublishingServer.vbs*", "*Adsiedit.vbs*")) and ((ProcessCommandLine in ("*http*", "*script:*", "*soap:*", "*\*", "* /e:*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\powershell.exe", "*\cmd.exe"))) and (not ((ParentProcessName in ("*\explorer.exe", "*\svchost.exe")) and (ProcessCommandLine in ("*C:\Windows\System32\*", "*C:\Windows\SysWOW64\*")) and User =~ "NT AUTHORITY\SYSTEM"))