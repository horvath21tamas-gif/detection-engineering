SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\rundll32.exe','%\regsvr32.exe','%\mshta.exe','%\cscript.exe','%\wscript.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%SetWindowsHook%','%GetAsyncKeyState%','%GetKeyboardState%','%user32.dll%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\%','%\Temp\%','%\Public\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\Windows\System32\%','%\Program Files\%','%\Program Files (x86)\%') OR (""Filename"" ILIKE ENUMERATION('%\AnyDesk.exe','%\TeamViewer.exe','%\tv_w32.exe','%\RemoteDesktopManager.exe')) AND "username" ILIKE 'NT AUTHORITY\%')
