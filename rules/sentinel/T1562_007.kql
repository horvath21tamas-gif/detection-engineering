DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((eventName in ("AuthorizeSecurityGroupIngress", "AuthorizeSecurityGroupEgress", "RevokeSecurityGroupIngress", "RevokeSecurityGroupEgress", "CreateSecurityGroup", "DeleteSecurityGroup")) or (eventName in ("CreateNetworkAclEntry", "ReplaceNetworkAclEntry", "DeleteNetworkAclEntry")) or (eventName in ("UpdateWebACL", "PutWebACL", "DeleteWebACL", "UpdateRuleGroup"))) and ((['requestParameters.ipPermissions.items.ipRanges.items.cidrIp'] =~ "0.0.0.0/0" and ['requestParameters.ipPermissions.items.ipv6Ranges.items.cidrIpv6'] =~ "::/0") or ['requestParameters.ipPermissions.items.ipProtocol'] =~ "-1" or ((['requestParameters.ipPermissions.items.fromPort'] in (22, 3389, 5985, 5986)) and (['requestParameters.ipPermissions.items.toPort'] in (22, 3389, 5985, 5986)))) and (['userIdentity.type'] =~ "Root" or ['userIdentity.sessionContext.attributes.mfaAuthenticated'] =~ "false" or (userAgent in ("*python-requests*", "*curl*", "*wget*", "*kali*", "*postman*", "*bot*")) or userAgent contains "aws-cli") and (not ((['userIdentity.arn'] in ("*role/Terraform*", "*role/CloudFormation*", "*role/AWSServiceRole*", "*role/SecurityAutomation*", "*role/OrganizationAccountAccessRole*")) or (['userIdentity.invokedBy'] in ("autoscaling.amazonaws.com", "elasticloadbalancing.amazonaws.com"))))