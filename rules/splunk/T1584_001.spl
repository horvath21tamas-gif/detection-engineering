Image IN ("*\\aws.exe", "*\\az.exe", "*\\flarectl.exe", "*\\gcloud.exe") OR CommandLine IN ("*change-resource-record-sets*", "*network dns record-sets create*", "*dns record create*") OR CommandLine IN ("*NS*", "*SOA*", "*MX*") OR CommandLine IN ("*--batch*", "*--file*", "*transaction*") NOT (User IN ("*svc_terraform*", "*svc_deploy*", "*adm_netops_infra*") OR Image IN ("*\\Terraform\\*", "*\\actions-runner\\*")) NOT (CommandLine IN ("*TXT*", "*_acme-challenge*")) NOT (ParentImage="*\\explorer.exe" condition="not selection_domain_hijacking")
