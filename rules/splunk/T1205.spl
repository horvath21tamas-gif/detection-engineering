(Image="*\\netsh.exe" OR OriginalFileName="netsh.exe" CommandLine IN ("*advfirewall firewall add rule*", "*action=allow*", "*protocol=UDP*", "*protocol=ICMP*", "*localport=any*")) OR Image IN ("*\\tcpdump.exe", "*\\windump.exe", "*\\scapy.exe", "*\\nmap.exe") OR CommandLine IN ("* -i *", "*sniffer*") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe") Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Downloads\\*") NOT (Image="*C:\\Windows\\System32\\svchost.exe*" OR username="NT AUTHORITY\\SYSTEM" OR CommandLine="*description=*")
