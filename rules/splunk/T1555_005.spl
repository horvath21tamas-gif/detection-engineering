CommandLine IN ("*.kdbx*", "*.opvault*", "*.agilekeychain*", "*vault.db*", "*key3.db*", "*key4.db*") (CommandLine IN ("*copy *", "*type *", "*7z*", "*rar*", "*zip*", "*esentutl*", "*tar *", "*gzip *") Image IN ("*\\sqlite3.exe", "*\\7z.exe", "*\\rar.exe", "*\\tar.exe", "*\\gzip.exe")) OR (Image IN ("*\\Users\\*", "*\\AppData\\Local\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\python.exe", "*\\node.exe")) NOT ((Image IN ("*\\Program Files\\KeePass*", "*\\Program Files\\1Password*", "*\\Program Files\\Bitwarden*") ParentImage IN ("*\\services.exe", "*\\svchost.exe") username="NT AUTHORITY\\SYSTEM") OR Image IN ("*\\OneDrive.exe", "*\\Dropbox.exe", "*\\GoogleDriveFS.exe", "*\\Box\\Box.exe"))
