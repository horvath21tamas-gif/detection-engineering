Image IN ("*\\diskpart.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\mountvol.exe", "*\\vhdmount.exe") CommandLine IN ("*Mount-VHD*", "*Mount-DiskImage*", "*attach vdisk*", "*create vdisk*", "*Mount-WindowsImage*", "*Mount-Disk*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\powershell.exe", "*\\cmd.exe") OR (CommandLine IN ("*\\Users\\*", "*\\Downloads\\*", "*\\Temp\\*", "*\\AppData\\*", "*.iso*", "*.vhd*", "*.vhdx*", "*.img*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\Windows\\System32\\svchost.exe*", "*\\Program Files\\Hyper-V\\*", "*\\Program Files\\Microsoft Visual Studio\\*", "*\\CcmExec.exe*") OR CommandLine IN ("*Program Files*", "*WindowsImageBackup*", "*WinRE*", "*System Center*"))) | table Time,SourceImage,ParentImage,CommandLine,SourceUsername
