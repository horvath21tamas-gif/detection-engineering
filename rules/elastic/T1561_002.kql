(process.executable:(*\\diskpart.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\dd.exe OR *\\format.com)) AND (process.command_line:(*clean* OR *delete\ partition* OR *Remove\-Partition* OR *Clear\-Disk* OR *\\.\\PhysicalDrive* OR *count\=1\ bs\=512*)) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\httpd.exe OR *\\rundll32.exe OR *\\services.exe)) OR (process.executable:(*\\Temp\\* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\CcmExec.exe OR *\\setup.exe)) OR (process.command_line:(*vds.exe* OR *scripts\\deployment*))))
