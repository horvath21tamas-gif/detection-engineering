SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\net.exe','%\net1.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%localgroup%','%Get-LocalGroup%','%Get-LocalGroupMember%','%Get-NetLocalGroup%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Administrators%','%Remote Desktop Users%','%Remote Management Users%','%Power Users%','%Distributed COM Users%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% > %','%ConvertTo-Json%','%Export-Csv%','%findstr%') OR (""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\httpd.exe','%\winword.exe','%\outlook.exe')) AND "Integrity Level"='Medium') AND NOT ("username" ILIKE 'NT AUTHORITY\%' OR ""Parent Filename"" ILIKE ENUMERATION('%\Program Files\Tanium\%','%\Program Files\Elastic\Agent\%','%\Windows\System32\CcmExec.exe%') OR "Process "Process CommandLine"" ILIKE '%Program Files%')
