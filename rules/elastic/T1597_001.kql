((process.command_line:(*AXFR* OR *\ \-query\=any* OR *\ \-type\=any* OR *\ \-t\ any* OR *\ \-q\ any* OR *\ \-t\ TXT* OR *\ \-t\ MX*)) OR ((process.executable.caseless:(*\\subfinder.exe OR *\\amass.exe OR *\\dnsrecon.exe OR *\\fierce.exe OR *\\knockpy.exe)) OR (process.command_line:(*\ \-active* OR *\ \-passive* OR *\ \-brute* OR *\ \-enum*)))) AND (NOT ((winlog.event_data.processcommandline:("nslookup " OR "ping " OR "tracert ")) OR winlog.event_data.condition:"not selection_dns_recon")) AND (NOT (process.executable.caseless:(*\\Windows\\System32\\dns.exe* OR *\\Windows\\System32\\lsass.exe*))) AND (NOT ((user.name:(*svc_monitoring* OR *svc_network*)) AND (process.executable.caseless:(*\\Zabbix\\* OR *\\Nagios\\* OR *\\SolarWinds\\*))))
