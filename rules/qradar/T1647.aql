SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/PlistBuddy','%/defaults','%/plutil','%/launchctl')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/Library/LaunchAgents/%','%/Library/LaunchDaemons/%','%/Users/%','%/System/Library/LaunchAgents/%','%/System/Library/LaunchDaemons/%','%/Library/StartupItems/%') OR ""Process CommandLine"" ILIKE ENUMERATION('%RunAtLoad%','%ProgramArguments%','%KeepAlive%','%StartInterval%','%StartCalendarInterval%','%LaunchEvents%','%Label%','%WatchPaths%','%QueueDirectories%') OR ""Process CommandLine"" ILIKE ENUMERATION('%bootstrap%','%bootout%','%load %','%unload %')) AND (""Parent Filename"" ILIKE ENUMERATION('%/Safari.app/%','%/Google Chrome.app/%','%/Microsoft Word.app/%','%/Microsoft Excel.app/%','%/Mail.app/%','%/zoom.us.app/%','%/Slack.app/%') OR ""Parent Filename"" ILIKE ENUMERATION('%/bash','%/zsh','%/sh','%/osascript') OR "User" ILIKE '%root%' AND "IntegrityLevel"='Medium') AND NOT (""Filename"" ILIKE ENUMERATION('/usr/sbin/softwareupdate%','/System/Library/%','/usr/libexec/%')) AND NOT (""Filename"" ILIKE ENUMERATION('%/Jamf/%','%/Intune/%','%/Kandji/%','%/Mosyle/%'))
