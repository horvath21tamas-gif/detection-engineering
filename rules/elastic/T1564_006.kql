(process.executable.caseless:(*\\docker.exe OR *\\dockerd.exe OR *\\VBoxManage.exe OR *\\VBoxHeadless.exe OR *\\vmrun.exe OR *\\vmware\-kvm.exe OR *\\vboxmanage.exe OR *\\qemu\-system\-x86_64.exe)) AND ((process.parent.executable.caseless:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\w3wp.exe OR *\\php\-cgi.exe OR *\\httpd.exe OR *\\nginx.exe OR *\\mshta.exe OR *\\powershell.exe OR *\\cmd.exe)) OR ((process.command_line:(*\-\-rm* OR *\-\-privileged* OR *\-\-net\=host* OR *\-\-entrypoint* OR *\-\-device* OR *nogui* OR *startvm* OR *\ \-it\ * OR *\-\-detach*)) AND (NOT ((process.parent.executable.caseless:(*\\Common7\\IDE\\devenv.exe* OR *\\bin\\code.exe* OR *\\Program\ Files\\Docker\\* OR *\\Program\ Files\\VMware\\* OR *\\Program\ Files\\VirtualBox\\*)) OR (process.command_line:(*docker\-desktop* OR *docker\-compose* OR *minikube* OR *vagrant*))))))
