DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Downloads\*", "*\Desktop\*", "*\PerfLogs\*")) and (((ProcessCommandLine in ("*ping 127.0.0.1 -n *", "*ping ::1 -n *")) and processcommandline match ".* -n (*:[1-9][0-9]{2,}|[1-9][0-9]{3,}).*") or ((ProcessCommandLine in ("*choice /t*", "*choice /d y /t*")) and processcommandline match ".* /t (*:[6-9][0-9]|[1-9][0-9]{2,}).*") or (ProcessCommandLine contains "timeout /t" and processcommandline match ".* /t (*:[1-9][0-9]{2,}).*")) and (not (((ParentProcessName in ("*\msiexec.exe", "*\TrustedInstaller.exe", "*\CcmExec.exe")) and username =~ "NT AUTHORITY\SYSTEM") or (ProcessCommandLine in ("*net use*", "*subst*", "*net time*"))))