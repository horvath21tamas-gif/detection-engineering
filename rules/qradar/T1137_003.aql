SELECT UTF8(payload) as search_payload from events where "Target Object" IMATCHES '(\\Software\\Microsoft\\Office\\|\\Software\\WOW6432Node\\Microsoft\\Office\\).*\\Outlook\\Forms\\(Registry|Cache)$' AND (""Filename"" IMATCHES '(outlook\.exe|msiexec\.exe|powershell\.exe|cmd\.exe|reg\.exe|cscript\.exe|wscript\.exe)$' OR "Target Details" IMATCHES '(CLSID|\.dll|\.vbs|http)') AND NOT "Target Details" IMATCHES '(C:\\Program Files\\|C:\\Program Files \(x86\)\\)'
