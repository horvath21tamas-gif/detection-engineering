DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\sc.exe", "*\tasklist.exe", "*\net.exe", "*\net1.exe")) or (ProcessCommandLine in ("*Get-Service*", "*Get-WmiObject Win32_Service*", "*Get-CimInstance Win32_Service*"))) and ((ProcessCommandLine in ("*query*", "*state= all*", "*config*", "*sdshow*")) or ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\httpd.exe", "*\wsmprovhost.exe", "*\powershell.exe")) and IntegrityLevel =~ "Medium") or (ProcessCommandLine in ("*findstr*", "*select-string*", "*where-object*", "* > *", "*ConvertTo-Json*"))) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\svchost.exe", "*\msiexec.exe", "*\CcmExec.exe")) or (ProcessCommandLine in ("*Program Files*", "*Splunk*", "*Tanium*"))))