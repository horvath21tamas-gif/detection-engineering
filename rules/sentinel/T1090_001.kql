DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*10.*", "*192.168.*", "*172.16.*", "*172.17.*", "*172.18.*", "*172.19.*", "*172.2*", "*172.3*")) and (ProcessCommandLine in ("*listenaddress=0.0.0.0*", "*listenport=*", "*connectport=*")) and (FolderPath in ("*\netsh.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\plink.exe", "*\socat.exe")) and (not ((ProcessCommandLine in ("*127.0.0.1*", "*::1*", "*C:\Program Files\Docker*", "*C:\Program Files\WSL*", "*C:\Windows\System32\WSL*")) and username =~ "NT AUTHORITY\SYSTEM" and ParentProcessName endswith "\services.exe"))