(Image="*/spctl" CommandLine="*assess*") OR (Image="*/xattr" CommandLine IN ("*-d com.apple.quarantine*", "*-rc com.apple.quarantine*", "*--delete com.apple.quarantine*") CommandLine IN ("*/tmp/*", "*/private/var/tmp/*", "*/Users/Shared/*", "*/Downloads/*", "*/Volumes/*", "*/Library/Application Support/*") ParentImage IN ("*/sh", "*/bash", "*/zsh", "*/python", "*/python3", "*/perl", "*/php", "*/osascript", "*/launchctl", "*/cron") OR ParentImage IN ("*/Microsoft Word", "*/Microsoft Excel", "*/Preview", "*/Google Chrome", "*/Safari")) NOT (ParentImage IN ("/System/Library/*", "/usr/libexec/*", "/usr/sbin/softwareupdate*", "/Applications/Xcode.app/*", "/Applications/Install *") Image IN ("/usr/bin/codesign*", "/usr/bin/productbuild*")) NOT (ParentImage IN ("*/Terminal", "*/iTerm2"))
