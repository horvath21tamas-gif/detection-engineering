DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*password=*", "*pwd=*", "*connectionstring*", "*access_key*", "*secret_key*", "*id_rsa*", "*id_dsa*", "*amzn.mws*", "*BEGIN RSA PRIVATE*")) or (((ProcessCommandLine contains "findstr" and ProcessCommandLine contains "/s" and ProcessCommandLine contains "/i") or (ProcessCommandLine contains "Get-ChildItem" and ProcessCommandLine contains "-Recurse" and ProcessCommandLine contains "-Include") or (ProcessCommandLine contains "grep" and ProcessCommandLine contains "-r")) and (ProcessCommandLine in ("*.config*", "*.xml*", "*.ini*", "*.bak*", "*.old*", "*.history*", "*ConsoleHost_history*", "*.aws\credentials*", "*.ssh\*")))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\httpd.exe")) and (FolderPath in ("*\findstr.exe", "*\grep.exe", "*\powershell.exe"))) and (not ((FolderPath in ("*\Windows\System32\SearchIndexer.exe*", "*\Microsoft Visual Studio\*", "*\Git\usr\bin\grep.exe*")) and username =~ "NT AUTHORITY\SYSTEM"))