DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((((FolderPath in ("*\wmic.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Win32_BaseBoard*", "*Win32_BIOS*", "*Win32_ComputerSystem*", "*Win32_ComputerSystemProduct*", "*csproduct get uuid*", "*bios get serialnumber*"))) and (ProcessCommandLine in ("*VMware*", "*VirtualBox*", "*VBOX*", "*QEMU*", "*Xen*", "*KVM*", "*Hyper-V*"))) or (((FolderPath in ("*\cmd.exe", "*\powershell.exe")) and (ProcessCommandLine in ("*getmac*", "*ipconfig /all*", "*arp -a*", "*get-netadapter*", "*netsh interface show interface*"))) and (ProcessCommandLine in ("*00-05-69*", "*00-0C-29*", "*00-50-56*", "*08-00-27*"))) or (ProcessCommandLine in ("*VBoxGuest*", "*vboxservice*", "*vmtoolsd*", "*vmmouse*", "*vmhgfs*", "*vboxguest.sys*", "*vmsrvc*", "*\System32\drivers\*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\mshta.exe", "*\wscript.exe", "*\cscript.exe", "*\chrome.exe", "*\msedge.exe", "*\acrord32.exe", "*\w3wp.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\AppData\Roaming\*", "*\Users\Public\*", "*\Downloads\*"))) and (IntegrityLevel in ("Medium", "High")) and (not ((FolderPath in ("*\Program Files\Lansweeper\*", "*\Program Files\SCCM\*", "*\Program Files\Tanium\*", "*\Program Files\Qualys\*", "*\Program Files\Microsoft Monitoring Agent\*")) or ((username in ("NT AUTHORITY\SYSTEM", "NT AUTHORITY\NETWORK SERVICE")) and (ParentProcessName in ("*\Windows\System32\services.exe*", "*\svchost.exe*")))))