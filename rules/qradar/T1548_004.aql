SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%/osascript' AND "OriginalFileName"='osascript' AND (""Process CommandLine"" ILIKE ENUMERATION('%with administrator privileges%','%do shell script%','%display dialog%')) AND (""Parent Filename"" ILIKE ENUMERATION('%/Applications/Google Chrome.app/%','%/Applications/Safari.app/%','%/Applications/Microsoft Word.app/%','%/Applications/Microsoft Excel.app/%','%/Applications/Slack.app/%','%/Applications/Microsoft Teams.app/%','%/private/tmp/%','%/Users/Shared/%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/Library/Application Support/JamfSoftware/%','%/usr/local/bin/kandji%','%/System/Library/PrivateFrameworks/%') OR ""Filename"" ILIKE '%/usr/sbin/softwareupdate%' OR "username"='root')
