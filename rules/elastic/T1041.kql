(process.command_line:(*\[System.IO.MemoryStream\]* OR *System.Convert\]\:\:ToBase64* OR *.ReadBytes\(* OR *.ReadAllBytes\(* OR *Get\-Content\ \-Encoding\ Byte* OR *FromBase64String\(* OR *Compress\-Archive* OR *System.IO.Compression* OR *GZipStream*)) AND (process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\rundll32.exe OR *\\regsvcs.exe OR *\\mshta.exe OR *\\certutil.exe OR *\\wmic.exe OR *\\cscript.exe OR *\\wscript.exe)) AND ((process.executable:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Public\\*)) OR (process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\wmiprvse.exe OR *\\wsmprovhost.exe OR *\\svchost.exe))) AND winlog.event_data.IntegrityLevel:Medium AND (NOT ((process.executable:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) OR (process.command_line:(*Windows\\Logs* OR *softwareupdate* OR *defender*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR process.parent.executable:*\\services.exe))
