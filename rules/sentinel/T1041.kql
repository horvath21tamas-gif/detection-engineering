DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*[System.IO.MemoryStream]*", "*System.Convert]::ToBase64*", "*.ReadBytes(*", "*.ReadAllBytes(*", "*Get-Content -Encoding Byte*", "*FromBase64String(*", "*Compress-Archive*", "*System.IO.Compression*", "*GZipStream*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\rundll32.exe", "*\regsvcs.exe", "*\mshta.exe", "*\certutil.exe", "*\wmic.exe", "*\cscript.exe", "*\wscript.exe")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\wmiprvse.exe", "*\wsmprovhost.exe", "*\svchost.exe"))) and IntegrityLevel =~ "Medium" and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*Windows\Logs*", "*softwareupdate*", "*defender*")) or username =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))