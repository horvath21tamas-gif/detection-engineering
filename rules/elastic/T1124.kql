((process.executable:(*\\w32tm.exe OR *\\tzutil.exe OR *\\net.exe OR *\\net1.exe)) OR (process.command_line:(*Get\-Date* OR *Get\-TimeZone* OR *\[System.DateTime\]\:\:Now*))) AND ((process.command_line:(*\ \/query* OR *\ \/g* OR *time\ \\*)) OR ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\httpd.exe OR *\\wsmprovhost.exe)) AND winlog.event_data.IntegrityLevel:Medium) OR (process.command_line:(*findstr* OR *select\-string* OR *\ \>\ * OR *$time\ \=*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\svchost.exe OR *\\CcmExec.exe OR *\\msiexec.exe OR *\\explorer.exe)) OR (process.command_line:(*Program\ Files* OR *\\AppData\\Local\\Google\\Chrome*))))
