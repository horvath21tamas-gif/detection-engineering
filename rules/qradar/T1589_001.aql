SELECT SrcIp, Method, UriStem, Status, UserAgent from events where (("SrcIp" LIKE '%1.%' OR "SrcIp" LIKE '%2.%' OR "SrcIp" LIKE '%3.%' OR "SrcIp" LIKE '%4.%' OR "SrcIp" LIKE '%5.%' OR "SrcIp" LIKE '%6.%' OR "SrcIp" LIKE '%7.%' OR "SrcIp" LIKE '%8.%' OR "SrcIp" LIKE '%9.%')) AND (("UriStem" LIKE '%/api/auth%' OR "UriStem" LIKE '%/api/login%' OR "UriStem" LIKE '%/api/token%' OR "UriStem" LIKE '%/api/session%' OR "UriStem" LIKE '%/api/password%' OR "UriStem" LIKE '%/auth/api%' OR "UriStem" LIKE '%/v1/auth%' OR "UriStem" LIKE '%/v2/auth%')) AND (("RequestBody" LIKE '%username%' OR "RequestBody" LIKE '%email%' OR "RequestBody" LIKE '%password%' OR "RequestBody" LIKE '%pass%' OR "RequestBody" LIKE '%pwd%' OR "RequestBody" LIKE '%secret%')) AND "Method"='POST' AND (("UserAgent" LIKE '%curl%' OR "UserAgent" LIKE '%wget%' OR "UserAgent" LIKE '%python%' OR "UserAgent" LIKE '%requests%' OR "UserAgent" LIKE '%go-http-client%' OR "UserAgent" LIKE '%httpclient%' OR "UserAgent" LIKE '%axios%' OR "UserAgent" LIKE '%libwww%' OR "UserAgent" LIKE '%scanner%' OR "UserAgent" LIKE '%probe%')) AND (("Status" LIKE '%401%' OR "Status" LIKE '%403%' OR "Status" LIKE '%404%' OR "Status" LIKE '%422%')) AND NOT (("UserAgent" LIKE '%Mozilla%' OR "UserAgent" LIKE '%Chrome%' OR "UserAgent" LIKE '%Firefox%' OR "UserAgent" LIKE '%Safari%' OR "UserAgent" LIKE '%Edge%' OR "UserAgent" LIKE '%HeadlessChrome%') OR ("UriStem" LIKE '%/sso%' OR "UriStem" LIKE '%/oauth%' OR "UriStem" LIKE '%/openid%' OR "UriStem" LIKE '%/saml%' OR "UriStem" LIKE '%/idp%' OR "UriStem" LIKE '%/federation%') OR ("UserAgent" LIKE '%nessus%' OR "UserAgent" LIKE '%qualys%' OR "UserAgent" LIKE '%openvas%' OR "UserAgent" LIKE '%acunetix%' OR "UserAgent" LIKE '%nuclei%' OR "UserAgent" LIKE '%zabbix%' OR "UserAgent" LIKE '%prometheus%' OR "UserAgent" LIKE '%uptime%' OR "UserAgent" LIKE '%pingdom%' OR "UserAgent" LIKE '%datadog%' OR "UserAgent" LIKE '%newrelic%'))
