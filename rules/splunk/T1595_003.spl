SrcIp IN ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*") UriStem IN ("*/login*", "*/signin*", "*/auth*", "*/admin*", "*/administrator*", "*/wp-login*", "*/wp-admin*", "*/account*", "*/user*") UriQuery IN ("*user=*", "*username=*", "*login=*", "*email=*", "*account=*") Status IN (401, 403, 404) UserAgent IN ("*python*", "*curl*", "*wget*", "*httpclient*", "*go-http-client*", "*libwww*", "*scrapy*") NOT (UserAgent IN ("*Mozilla*", "*Chrome*", "*Safari*", "*Firefox*", "*Edge*") OR UserAgent IN ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nikto*", "*nuclei*", "*zap*", "*burp*") OR UriStem IN ("*.css", "*.js", "*.png", "*.jpg", "*.ico", "*.svg", "*.woff", "*.json")) | table SrcIp,UriStem,UriQuery,Status,UserAgent
