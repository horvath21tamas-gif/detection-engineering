(eventSource="guardduty.amazonaws.com" eventName IN ("DeleteDetector", "UpdateDetector", "DeleteMembers", "DisassociateMembers", "DeleteThreatIntelSet", "DeleteIPSet")) OR (eventSource="securityhub.amazonaws.com" eventName IN ("DisableSecurityHub", "BatchDisableStandards", "CreateFilter", "UpdateFilter", "BatchUpdateFindings")) OR (eventSource="inspector2.amazonaws.com" eventName IN ("UpdateConfiguration", "Disable")) userIdentity.type="Root" OR userIdentity.type="IAMUser" OR userAgent IN ("*curl*", "*python*", "*postman*", "*httpclient*", "*boto3*", "*aws-cli*") NOT (userIdentity.arn IN ("*Security-Infrastructure-Terraform*", "*AWSServiceRoleForGuardDuty*", "*AWSServiceRoleForSecurityHub*", "*OrganizationAccountAccessRole*") OR sourceIPAddress IN ("10.*", "192.168.*", "172.*", "127.*")) | table eventTime,eventSource,eventName,userIdentity.type,userIdentity.arn,sourceIPAddress,userAgent,awsRegion
