SELECT UTF8(payload) as search_payload from events where ((""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\winword.exe','%\excel.exe','%\outlook.exe')) AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\mshta.exe','%\cmd.exe')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%System.Windows.Forms.Form%','%Windows.Forms.TextBox%','%PasswordChar%','%.ShowDialog()%','%TopMost = $true%','%credui.dll%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%PromptForCredential%','%Get-Credential%','%Net.NetworkCredential%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\Program Files\%','%\Program Files (x86)\%') OR "username" ILIKE 'NT AUTHORITY\%' OR "Process "Process CommandLine"" ILIKE ENUMERATION('%--type=utility%','%--type=renderer%'))
