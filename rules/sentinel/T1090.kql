DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine contains "interface" and ProcessCommandLine contains "portproxy" and ProcessCommandLine contains "add" and ProcessCommandLine contains "v4tov4") and (ProcessCommandLine in ("*listenport=*", "*connectaddress=*"))) or (ProcessCommandLine in ("* -socks5 *", "* -reverse *", "* -L:*", "* -R:*", "* --proxy-server=*"))) and (FolderPath in ("*\netsh.exe", "*\powershell.exe", "*\pwsh.exe", "*\rundll32.exe", "*\regsvr32.exe")) and (not ((ProcessCommandLine in ("*C:\Program Files\Docker*", "*C:\Program Files\WSL*", "*127.0.0.1*", "*::1*")) or username =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))