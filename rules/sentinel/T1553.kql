DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\certutil.exe", "*\certmgr.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("* Root*", "* AuthRoot*", "* TrustedPublisher*", "* Cert:\LocalMachine\Root*", "* Cert:\CurrentUser\Root*")) and ((ProcessCommandLine in ("* -f*", "* -enterprise*", "* -user*", "* -silent*")) or (ProcessCommandLine in ("*\AppData\*", "*\Users\Public\*", "*\Downloads\*", "*\Desktop\*", "*\Temp\*", "*\ProgramData\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\acrord32.exe", "*\mshta.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\regsvr32.exe")))) or ((ProcessCommandLine in ("*Zone.Identifier*", "*SaveZoneInformation*", "*LowRiskFileTypes*", "*Unblock-File*", "*streams.exe -d*")) and ((ProcessCommandLine in ("*\AppData\*", "*\Users\Public\*", "*\Downloads\*", "*\Desktop\*", "*\Temp\*", "*\ProgramData\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\acrord32.exe", "*\mshta.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\regsvr32.exe")) or (not (User in ("*NT AUTHORITY\SYSTEM*", "*NT AUTHORITY\LOCAL SERVICE*", "*NT AUTHORITY\NETWORK SERVICE*")))))) and (not ((ParentProcessName in ("C:\Windows\System32\msiexec.exe*", "C:\Windows\System32\svchost.exe*", "C:\Windows\servicing\TrustedInstaller.exe*", "C:\Program Files\Microsoft Endpoint Manager\*", "C:\Program Files\Microsoft Configuration Manager\*")) and User startswith "NT AUTHORITY\SYSTEM"))