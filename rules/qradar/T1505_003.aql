SELECT UTF8(payload) as search_payload from events where (("RequestMethod" LIKE '%POST%' OR "RequestMethod" LIKE '%PUT%' OR "RequestMethod" LIKE '%PATCH%')) AND (("cs-uri-stem" LIKE '%/uploads/%' OR "cs-uri-stem" LIKE '%/upload/%' OR "cs-uri-stem" LIKE '%/files/%' OR "cs-uri-stem" LIKE '%/images/%' OR "cs-uri-stem" LIKE '%/tmp/%' OR "cs-uri-stem" LIKE '%/data/%' OR "cs-uri-stem" LIKE '%/public/%')) AND (("cs-uri-stem" LIKE '%.php%' OR "cs-uri-stem" LIKE '%.phtml%' OR "cs-uri-stem" LIKE '%.php5%' OR "cs-uri-stem" LIKE '%.asp%' OR "cs-uri-stem" LIKE '%.aspx%' OR "cs-uri-stem" LIKE '%.jsp%' OR "cs-uri-stem" LIKE '%.ashx%' OR "cs-uri-stem" LIKE '%.cgi%' OR "cs-uri-stem" LIKE '%.pl%')) OR (("cs-uri-stem" LIKE '%.php%' OR "cs-uri-stem" LIKE '%.phtml%' OR "cs-uri-stem" LIKE '%.php5%' OR "cs-uri-stem" LIKE '%.asp%' OR "cs-uri-stem" LIKE '%.aspx%' OR "cs-uri-stem" LIKE '%.jsp%' OR "cs-uri-stem" LIKE '%.ashx%' OR "cs-uri-stem" LIKE '%.cgi%' OR "cs-uri-stem" LIKE '%.pl%')) AND (("URL" LIKE '%cmd=%' OR "URL" LIKE '%exec=%' OR "URL" LIKE '%system=%' OR "URL" LIKE '%powershell=%' OR "URL" LIKE '%whoami%' OR "URL" LIKE '%net user%' OR "URL" LIKE '%id%' OR "URL" LIKE '%uname%' OR "URL" LIKE '%curl %' OR "URL" LIKE '%wget %' OR "URL" LIKE '%base64%' OR "URL" LIKE '%eval(%' OR "URL" LIKE '%shell=%')) AND (("sc-status" LIKE '%200%' OR "sc-status" LIKE '%201%' OR "sc-status" LIKE '%202%')) AND (("cs-user-agent" LIKE '%curl%' OR "cs-user-agent" LIKE '%wget%' OR "cs-user-agent" LIKE '%python%' OR "cs-user-agent" LIKE '%powershell%' OR "cs-user-agent" LIKE '%httpclient%' OR "cs-user-agent" LIKE '%libwww%' OR "cs-user-agent" LIKE '%java%' OR "cs-user-agent" LIKE '%perl%')) AND NOT (("cs-uri-stem" LIKE '%/wp-admin/%' OR "cs-uri-stem" LIKE '%/wp-json/%' OR "cs-uri-stem" LIKE '%/administrator/%' OR "cs-uri-stem" LIKE '%/api/%' OR "cs-uri-stem" LIKE '%/rest/%' OR "cs-uri-stem" LIKE '%/media/%' OR "cs-uri-stem" LIKE '%/uploads/plugins/%' OR "cs-uri-stem" LIKE '%/uploads/themes/%'))
