DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ParentProcessName in ("*\lsass.exe", "*\logonui.exe", "*\lsm.exe", "*\spoolsv.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\net.exe", "*\whoami.exe", "*\nltest.exe"))) or (ProcessCommandLine in ("* -inject *", "* -leak *", "* --pipe *", "*reflectiveloader*"))) and (not ((FolderPath endswith "\WerFault.exe" and ParentProcessName endswith "\lsass.exe") or ((FolderPath in ("*\CrowdStrike\*", "*\SentinelOne\*", "*\Windows Defender\*")) and username =~ "NT AUTHORITY\SYSTEM")))