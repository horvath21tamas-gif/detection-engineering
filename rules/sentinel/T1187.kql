DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*@80\*", "*@SSL\*", "*davwwwroot*", "*\*\IPC$*")) or (ProcessCommandLine in ("*EfsRpcOpenFileRaw*", "*RpcRemoteFindFirstPrinterChangeNotification*", "*lsarpc*", "*efsrpc*")) or ProcessCommandLine matches regex "\\\\\\\\[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\\\.*\\$") and ((FolderPath in ("*\Users\*", "*\Temp\*", "*\Downloads\*")) and (FolderPath in ("*\powershell.exe", "*\cmd.exe", "*\python.exe", "*\rundll32.exe"))) and (not ((ProcessCommandLine in ("*\SYSVOL\*", "*\NETLOGON\*")) and (ParentProcessName in ("*\services.exe", "*\svchost.exe")) and username =~ "NT AUTHORITY\SYSTEM"))