SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\brave.exe','%\firefox.exe','%\iexplore.exe')) AND (""Filename"" ILIKE ENUMERATION('%\wscript.exe','%\cscript.exe','%\mshta.exe','%\powershell.exe','%\cmd.exe','%\scrcons.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.vbs%','%.jse%','%.hta%','%.wsf%','%.iso%','%.vhd%','%.vba%','%.lnk%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Downloads\%','%\Users\Public\%','%\INetCache\%')) AND NOT (("Process "Process CommandLine"" ILIKE ENUMERATION('%update%','%setup.exe%','%installer.exe%')) AND (""Filename"" ILIKE ENUMERATION('C:\Program Files\%','C:\Windows\System32\%')))
