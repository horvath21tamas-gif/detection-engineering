(Image="*\\logman.exe" CommandLine="*stop*" CommandLine IN ("*EventLog-System*", "*EventLog-Security*", "*Microsoft-Windows-DotNETRuntime*", "*Microsoft-Windows-Web-Http*", "*NT Kernel Logger*", "*Circular Kernel Context Logger*")) OR (Image="*\\logman.exe" CommandLine="*delete*" CommandLine IN ("*EventLog*", "*Kernel*")) OR (Image="*\\wecutil.exe" CommandLine="* /e:false*") OR (Image="*\\wecutil.exe" CommandLine="* ds *") OR (Image IN ("*\\netsh.exe", "*\\powershell.exe") CommandLine="*firewall*" CommandLine="*add rule*" CommandLine="*block*" CommandLine="*remoteport=443*" CommandLine IN ("*remoteip=*", "*security*", "*defender*", "*crowdstrike*", "*sentinel*", "*carbonblack*", "*edr*", "*telemetry*")) ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe", "*\\powershell.exe", "*\\cmd.exe", "*\\rundll32.exe") OR NOT (CommandLine IN ("*Microsoft Monitoring Agent*", "*SplunkUniversalForwarder*", "*AzureMonitorAgent*", "*Elastic Agent*", "*Docker*") OR (User="NT AUTHORITY*" ParentImage="*\\services.exe"))
