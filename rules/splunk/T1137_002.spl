
| rex field=Details "(?<DetailsMatch>(\\\\AppData\\\\Local\\\\|\\\\AppData\\\\Roaming\\\\|C:\\\\Users\\\\Public\\\\|C:\\\\Windows\\\\Temp\\\\|\\\\Downloads\\\\|\\\\\\\\))"
| eval DetailsCondition=if(isnotnull(DetailsMatch), "true", "false")
| rex field=Image "(?<ImageMatch>(powershell\\.exe|pwsh\\.exe|cmd\\.exe|reg\\.exe|cscript\\.exe|wscript\\.exe|rundll32\\.exe)$)"
| eval ImageCondition=if(isnotnull(ImageMatch), "true", "false")
| rex field=Details "(?<DetailsMatch2>(C:\\\\Program Files\\\\|C:\\\\Program Files \\(x86\\)\\\\))"
| eval DetailsCondition2=if(isnotnull(DetailsMatch2), "true", "false")
| rex field=Image "(?<ImageMatch2>(msiexec\\.exe|OfficeClickToRun\\.exe)$)"
| eval ImageCondition2=if(isnotnull(ImageMatch2), "true", "false")
| search DetailsCondition="true" OR ImageCondition="true" NOT (DetailsCondition2="true" OR ImageCondition2="true")
| regex TargetObject="\\\\Software\\\\Microsoft\\\\Office\\\\.*\\\\Office Test\\\\Special\\\\Defrag$"
