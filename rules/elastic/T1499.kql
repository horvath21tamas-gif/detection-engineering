((process.command_line:(*\ \/f\ \/im\ lsass.exe* OR *\ \/f\ \/im\ csrss.exe* OR *\ \/f\ \/im\ wininit.exe* OR *\ \/f\ \/im\ smss.exe* OR *\ \/f\ \/im\ services.exe*)) OR (process.command_line:(*while\($true\)* OR *for\(;;\)* OR *\:\:MemoryStream* OR *AllocHGlobal* OR *foreach\($i\ in\ 1..1gb\)* OR *\:loop* OR *\-Recursive* OR *Get\-Random*))) AND ((process.parent.executable.caseless:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\rundll32.exe OR *\\httpd.exe OR *\\nginx.exe OR *\\apache.exe)) AND (process.executable.caseless:(*\\Temp\\* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\* OR *\\Downloads\\*))) AND (NOT (winlog.event_data.username:"NT AUTHORITY\\SYSTEM" AND (process.parent.executable.caseless:(*\\CcmExec.exe OR *\\msiexec.exe OR *\\TiWorker.exe OR *\\TrustedInstaller.exe)) AND (process.command_line:(*HealthCheck* OR *Diagnostic* OR *Update* OR *Patch* OR *Maintenance*))))
