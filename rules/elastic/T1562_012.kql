((eventSource:guardduty.amazonaws.com AND (eventName:(DeleteDetector OR UpdateDetector OR DeleteMembers OR DisassociateMembers OR DeleteThreatIntelSet OR DeleteIPSet))) OR (eventSource:securityhub.amazonaws.com AND (eventName:(DisableSecurityHub OR BatchDisableStandards OR CreateFilter OR UpdateFilter OR BatchUpdateFindings))) OR (eventSource:inspector2.amazonaws.com AND (eventName:(UpdateConfiguration OR Disable)))) AND (userIdentity.type:Root OR userIdentity.type:IAMUser OR (userAgent:(*curl* OR *python* OR *postman* OR *httpclient* OR *boto3* OR *aws\-cli*))) AND (NOT ((userIdentity.arn:(*Security\-Infrastructure\-Terraform* OR *AWSServiceRoleForGuardDuty* OR *AWSServiceRoleForSecurityHub* OR *OrganizationAccountAccessRole*)) OR (sourceIPAddress:(10.* OR 192.168.* OR 172.* OR 127.*))))
