DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\vncviewer.exe", "*\winvnc.exe", "*\tvnserver.exe", "*\uvnc_settings.exe")) or (OriginalFileName in ("vncviewer.exe", "winvnc.exe", "tvnserver.exe"))) and ((FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\*", "*\PerfLogs\*", "*\*")) or (ProcessCommandLine in ("* -connect *", "* -password *", "* -passwd *", "* -nomsgbox*", "* -noauth*", "* -remoterefresh*")) or ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\psexesvc.exe", "*\wsmprovhost.exe")) and IntegrityLevel =~ "System"))) and (not ((FolderPath in ("*C:\Program Files\RealVNC\*", "*C:\Program Files\TightVNC\*", "*C:\Program Files\UltraVNC\*")) or ProcessCommandLine contains "service" or User =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))