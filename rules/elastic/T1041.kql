(process.command_line:(*\ \[System.IO.MemoryStream\]* OR *\ \[System.Convert\]\:\:ToBase64* OR *\ .ReadBytes\(* OR *\ .ReadAllBytes\(* OR *Compress\-Archive*)) AND (process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\rundll32.exe OR *\\regsvcs.exe OR *\\mshta.exe OR *\\certutil.exe)) AND ((process.executable:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Public\\*)) OR (process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\wmiprvse.exe OR *\\svchost.exe))) AND (NOT ((process.executable:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) OR (process.command_line:(*Windows\\Logs* OR *softwareupdate*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR process.parent.executable:*\\services.exe))
