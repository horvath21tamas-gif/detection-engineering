(ParentImage IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe", "*\\winword.exe", "*\\excel.exe", "*\\outlook.exe") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\mshta.exe", "*\\cmd.exe")) OR CommandLine IN ("*System.Windows.Forms.Form*", "*Windows.Forms.TextBox*", "*PasswordChar*", "*.ShowDialog()*", "*TopMost = $true*", "*credui.dll*") OR CommandLine IN ("*PromptForCredential*", "*Get-Credential*", "*Net.NetworkCredential*") NOT ((Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") username="NT AUTHORITY\\SYSTEM") OR CommandLine IN ("*--type=utility*", "*--type=renderer*"))
