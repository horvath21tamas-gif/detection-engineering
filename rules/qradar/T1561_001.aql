SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%\.\PhysicalDrive%','%\.\Harddisk%','%\.\Volume{%')) AND (""Filename"" ILIKE '%\dd.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%if=/dev/zero%','%if=/dev/urandom%','%of=\.\PhysicalDrive%','%of=\.\Harddisk%')) OR ""Filename"" ILIKE '%\sdelete.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -z%','% -p %','% -c %')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Clear-Disk%','%-RemoveData%')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Format-Volume%','%-Force%','%-Confirm:$false%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\w3wp.exe','%\httpd.exe','%\rundll32.exe','%\mshta.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe','%\vds.exe'))) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\CcmExec.exe','%\msiexec.exe','%\setup.exe')) AND (""Parent Filename"" ILIKE ENUMERATION('%\ConfigurationManager\%','%\IntuneManagementExtension\%'))) AND NOT (""Filename"" ILIKE ENUMERATION('C:\Program Files\%','C:\Program Files (x86)\%'))
