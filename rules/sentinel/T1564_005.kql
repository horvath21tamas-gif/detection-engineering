DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\diskpart.exe", "*\powershell.exe", "*\pwsh.exe")) or (ProcessCommandLine in ("*Mount-VHD*", "*Mount-DiskImage*", "*attach vdisk*", "*create vdisk*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe")) or ((ProcessCommandLine in ("*\Users\*", "*\Downloads\*", "*\Temp\*", "*\AppData\*", "*.iso*", "*.vhd*", "*.vhdx*")) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\Windows\System32\svchost.exe*", "*\Program Files\Hyper-V\*", "*\Program Files\Microsoft Visual Studio\*", "*\CcmExec.exe*")) or (ProcessCommandLine in ("*Program Files*", "*WindowsImageBackup*"))))))