(process.executable.caseless:(*\\wevtutil.exe OR *\\sed.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\sqlite3.exe OR *\\attrib.exe OR *\\netsh.exe OR *\\reg.exe OR *\\cmd.exe)) AND (process.command_line:(*\ cl\ * OR *\ clear\-log\ * OR *\ \-replace\ * OR *\ s\/* OR *\ \>\ * OR *Out\-File* OR *Set\-Content* OR *\ set\ dns\ * OR *\ set\ proxy\ * OR *AutoConfigURL* OR *ProxyEnable* OR *ProxyServer*)) AND ((process.command_line:(*\\etc\\hosts* OR *\\System32\\winevt\\* OR *\\System32\\config\\* OR *.config* OR *.db*)) OR (process.parent.executable.caseless:(*\\winword.exe OR *\\excel.exe OR *\\httpd.exe OR *\\rundll32.exe OR *\\explorer.exe))) AND (NOT ((process.parent.executable.caseless:(*\\CcmExec.exe OR *\\msiexec.exe)) OR (process.command_line:(*Program\ Files* OR *Get\-EventLog*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM"))
