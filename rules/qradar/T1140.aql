SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\certutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-decode%','%-decodehex%')) OR (""Filename"" ILIKE ENUMERATION('%\expand.exe','%\extrac32.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.txt%','%.jpg%','%.png%','%.xml%','%.log%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\nginx.exe','%\httpd.exe','%\mshta.exe') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\Temp\%','%\AppData\%','%.exe%','%.dll%','%.vbs%','%.ps1%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\Windows\servicing\TrustedInstaller.exe%','%\CcmExec.exe%','%\Package Cache\%')) AND (""Filename"" ILIKE ENUMERATION('%\Program Files\%','%\Windows\System32\%')) AND "Process "Process CommandLine"" ILIKE '%Microsoft\Windows\SoftwareDistribution%'))
