DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("*asreproast*", "* /user:*")) and FolderPath endswith "\rubeus.exe") or (ProcessCommandLine in ("*GetNPUsers*", "*-no-pass*", "*-format hashcat*", "*-format john*")) or (ProcessCommandLine contains "Get-DomainUser" and ProcessCommandLine contains "DONT_REQ_PREAUTH") or ((ProcessCommandLine in ("*1.2.840.113556.1.4.803:=4194304*", "*userAccountControl:1.2.840.113556.1.4.803:=4194304*", "*-band 4194304*", "*0x400000*")) and (ProcessCommandLine in ("*/format:hashcat*", "*/format:john*", "*/outfile:*", "*.hash*", "*.txt*")))) and (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\wmiprvse.exe", "*\httpd.exe", "*\w3wp.exe", "*\mshta.exe", "*\rundll32.exe")) and (not (User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe", "*\lsass.exe")))) and (not (FolderPath in ("*\RSAT\*", "*\Active Directory\*", "*\Microsoft Monitoring Agent\*")))