SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\trufflehog.exe','%\gitleaks.exe','%\shhgit.exe','%\git-secrets.exe','%\detect-secrets.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%trufflehog%','%gitleaks%','%scan --repo%') OR ""Filename"" ILIKE '%\git.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% log -G%','% log -S%','% rev-list --all%','% log --pretty=format%','% grep --cached%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%password=%','%api_key%','%client_secret%','%private_key%','%access_token%','%jelszo%','%titok%'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\code.exe','%\idea64.exe','%\visualstudio.exe','%\eclipse.exe')) AND NOT ((("UserName" LIKE '%svc_jenkins%' OR "UserName" LIKE '%github_runner%' OR "UserName" LIKE '%gitlab_runner%' OR "UserName" LIKE '%azure_devops%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%npm %','%nuget %','%dotnet %'))) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%git pull%','%git push%','%git commit%','%git clone%','%git fetch%'))
