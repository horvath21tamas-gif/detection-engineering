Image IN ("*\\fsquirt.exe", "*\\bttransfer.exe", "*\\BTTray.exe") CommandLine IN ("*Bluetooth.Radio*", "*System.Net.Sockets.AddressFamily::BlueTooth*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powershell.exe", "*\\wscript.exe", "*\\cmd.exe", "*\\schtasks.exe") OR CommandLine IN ("*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*", "* -send*", "* /send*") NOT (ParentImage="*\\explorer.exe" Image="*\\Program Files\\*" username="NT AUTHORITY\\SYSTEM")
