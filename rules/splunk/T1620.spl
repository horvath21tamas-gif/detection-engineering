(CommandLine IN ("*VirtualAlloc*", "*VirtualProtect*", "*WriteProcessMemory*", "*CreateRemoteThread*", "*NtMapViewOfSection*", "*QueueUserAPC*") CommandLine IN ("*0x20*", "*0x40*", "*0x3000*")) OR (CommandLine IN ("*[System.Reflection.Assembly]::Load(*", "*Reflection.Emit*", "*Marshal.Copy*", "*[Activator]::CreateInstance(*", "*[AppDomain]::CurrentDomain*") CommandLine IN ("*FromBase64String*", "*IO.MemoryStream*", "*IO.Compression*", "*ConvertFrom-SecureString*", "*AES*")) Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Temp\\*", "*\\ProgramData\\*") OR ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\explorer.exe", "*\\wsmprovhost.exe") NOT (Image IN ("*\\Visual Studio\\*", "*\\MSBuild.exe*", "*\\dotnet.exe*", "*\\GitHub\\*", "*\\Jenkins\\*", "*\\AzureDevOps\\*") User IN ("*svc-build*", "*ci*", "*cicd*", "*jenkins*"))
