Image IN ("*\\aws.exe", "*\\az.exe", "*\\gcloud.exe", "*\\gsutil.exe", "*\\snowball.exe") CommandLine IN ("* s3 sync *", "* storage copy *", "* cp *", "* --access-key *", "* --secret-key *", "* --profile *", "* --request-payer *", "* --no-sign-request *", "* make-public *", "* bucket-to-bucket*", "* gs://*") OR (Image IN ("*\\Users\\*", "*\\Temp\\*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpoint.exe", "*\\httpd.exe", "*\\php-cgi.exe", "*\\rundll32.exe", "*\\taskhostw.exe") ParentCommandLine IN ("*-EncodedCommand*", "*-NonInteractive*")) NOT (ParentImage IN ("*\\msiexec.exe", "*\\services.exe", "*\\explorer.exe") CommandLine IN ("* terraform *", "* ansible *", "* Jenkins *", "* CI/CD *") User="NT AUTHORITY\\*")
