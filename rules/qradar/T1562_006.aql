SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\logman.exe' AND "Process "Process CommandLine"" ILIKE '%stop%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%EventLog-System%','%EventLog-Security%','%Microsoft-Windows-DotNETRuntime%','%Microsoft-Windows-Web-Http%','%NT Kernel Logger%','%Circular Kernel Context Logger%')) OR ""Filename"" ILIKE '%\logman.exe' AND "Process "Process CommandLine"" ILIKE '%delete%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%EventLog%','%Kernel%')) OR ""Filename"" ILIKE '%\wecutil.exe' AND "Process "Process CommandLine"" ILIKE '% /e:false%' OR ""Filename"" ILIKE '%\wecutil.exe' AND "Process "Process CommandLine"" ILIKE '% ds %' OR (""Filename"" ILIKE ENUMERATION('%\netsh.exe','%\powershell.exe')) AND "Process "Process CommandLine"" ILIKE '%firewall%' AND "Process "Process CommandLine"" ILIKE '%add rule%' AND "Process "Process CommandLine"" ILIKE '%block%' AND "Process "Process CommandLine"" ILIKE '%remoteport=443%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%remoteip=%','%security%','%defender%','%crowdstrike%','%sentinel%','%carbonblack%','%edr%','%telemetry%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\w3wp.exe','%\powershell.exe','%\cmd.exe','%\rundll32.exe') OR NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%Microsoft Monitoring Agent%','%SplunkUniversalForwarder%','%AzureMonitorAgent%','%Elastic Agent%','%Docker%') OR "username" ILIKE 'NT AUTHORITY%' AND ""Parent Filename"" ILIKE '%\services.exe'))
