Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe") OR CommandLine IN ("*--headless*", "*--remote-debugging-port*", "*--disable-gpu*", "*--user-data-dir=*") OR Image IN ("*\\python.exe", "*\\node.exe") OR CommandLine IN ("*selenium*", "*puppeteer*", "*playwright*", "*tweepy*", "*instaloader*") NOT (User IN ("*mkt_automation*", "*social_media_mgr*") CommandLine="*C:\\Program Files\\Social_Tools\\*") NOT (ParentImage IN ("*\\code.exe", "*\\idea64.exe") CommandLine IN ("*localhost*", "*127.0.0.1*")) NOT (ParentImage="*\\explorer.exe" condition="not selection_headless_automation")
