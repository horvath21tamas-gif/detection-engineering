((process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\powershell_ise.exe)) OR (winlog.event_data.filename:(PowerShell.EXE OR pwsh.dll OR powershell_ise.EXE))) AND (((process.command_line:(*Set\-MpPreference* OR *Add\-MpPreference*)) AND ((process.command_line:(*DisableRealtimeMonitoring* OR *DisableBehaviorMonitoring* OR *DisableIOAVProtection* OR *ExclusionPath* OR *ExclusionExtension* OR *ExclusionProcess* OR *MAPSReporting* OR *SubmitSamplesConsent*)) OR (process.command_line:(*1* OR *$true* OR *NeverSend*)))) OR (process.command_line:(*\ \-disablere* OR *\ \-excl*))) AND (NOT ((process.parent.executable.caseless:(*\\CcmExec.exe OR *\\Gpscript.exe)) AND process.command_line:*Specific_Safe_Admin_Script.ps1*))
