SELECT UTF8(payload) as search_payload from events where "TargetImage" ILIKE '%\lsass.exe' AND (("Granted Access" LIKE '%0x10%' OR "Granted Access" LIKE '%0x20%' OR "Granted Access" LIKE '%0x30%' OR "Granted Access" LIKE '%0x40%' OR "Granted Access" LIKE '%0x50%' OR "Granted Access" LIKE '%0x1000%' OR "Granted Access" LIKE '%0x1010%' OR "Granted Access" LIKE '%0x1410%' OR "Granted Access" LIKE '%0x143a%' OR "Granted Access" LIKE '%0x1f0fff%' OR "Granted Access" LIKE '%0x1fffff%')) AND (""Filename"" ILIKE ENUMERATION('%\procdump.exe','%\procdump64.exe','%\mimikatz.exe','%\rundll32.exe','%\taskmgr.exe','%\powershell.exe','%\pwsh.exe','%\wmic.exe','%\comsvcs.dll') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\ProgramData\%','%\Windows\Temp\%')) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\System32\%','C:\Windows\SysWOW64\%')) AND ""Filename"" ILIKE '%\taskmgr.exe')
