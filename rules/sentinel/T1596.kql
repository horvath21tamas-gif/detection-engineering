DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\shodan.exe", "*\censys.exe", "*\amass.exe", "*\masscan.exe")) or (ProcessCommandLine in ("*search --fields*", "*host --facets*", "*view --snmp*", "*crt.sh*"))) or ((FolderPath in ("*\curl.exe", "*\wget.exe", "*\python.exe", "*\pwsh.exe")) or (ProcessCommandLine in ("*api.shodan.io*", "*api.censys.io*", "*api.virustotal.com*", "*otx.alienvault.com*", "*api.binaryedge.io*")))) and (not ((username in ("NT AUTHORITY\SYSTEM", "NT AUTHORITY\NETWORK SERVICE")) and (FolderPath in ("*\SentinelOne\*", "*\CrowdStrike\*", "*\Microsoft Security Client\*")))) and (not ((ParentProcessName in ("*\code.exe", "*\java.exe")) and (ProcessCommandLine in ("*--config*", "*--verify*")))) and (not (FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe")))