DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\wmic.exe", "*\pnputil.exe", "*\driverquery.exe", "*\devcon.exe")) or (ProcessCommandLine in ("*Get-PnpDevice*", "*Get-WmiObject*", "*gwmi *"))) and ((ProcessCommandLine in ("*Win32_USBController*", "*Win32_DiskDrive*", "*Win32_NetworkAdapter*", "*USBSTOR*", "* /enum-devices*", "* /deviceid*")) or (ProcessCommandLine in ("* > *", "*ConvertTo-Json*", "*format-list*")) or ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe")) and IntegrityLevel =~ "Medium")) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\svchost.exe", "*\msiexec.exe")) or ProcessCommandLine contains "Program Files"))