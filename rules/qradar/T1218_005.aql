SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\mshta.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%http://%','%https://%','%.hta%','%javascript:%','%vbscript:%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\rundll32.exe')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\Installer\%','%\Program Files\%','%\Program Files (x86)\%','%\Microsoft Configuration Manager\%','%\Windows\CCM\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Tanium\%'))
