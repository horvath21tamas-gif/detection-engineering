SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\makecat.exe','%\signtool.exe','%\pvk2pfx.exe','%\inf2cat.exe','%\certutil.exe')) AND "Process "Process CommandLine"" ILIKE '%.cat%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\%','%\Users\Public\%','%\Downloads\%','%\Desktop\%','%\PerfLogs\%','%\Temp\%','%\ProgramData\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\acrord32.exe','%\mshta.exe','%\wscript.exe','%\cscript.exe','%\rundll32.exe','%\regsvr32.exe','%\cmd.exe','%\powershell.exe','%\pwsh.exe') OR NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%'))) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('C:\Windows\servicing\TrustedInstaller.exe%','C:\Windows\System32\svchost.exe%','C:\Windows\System32\dism.exe%','C:\Windows\System32\TiWorker.exe%','C:\Program Files\Microsoft Configuration Manager\%')) AND "username" ILIKE 'NT AUTHORITY\SYSTEM%') AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Windows Kits\%','%\WDK\%'))
