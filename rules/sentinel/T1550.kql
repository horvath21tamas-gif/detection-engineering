DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((EventID =~ 4624 and LogonType =~ 9 and LogonProcessName =~ "seclogo" and AuthenticationPackage =~ "Negotiate") or ((EventID in (4768, 4769)) and TicketEncryptionType =~ "0x17") or (EventID =~ 4624 and LogonType =~ 3 and AuthenticationPackage =~ "NTLM" and (IpAddress in ("127.0.0.1", "::1")))) and (not (TargetUserName endswith "$" or SubjectUserName endswith "$" or (ProcessName in ("*\Windows\System32\svchost.exe*", "*\Windows\System32\lsass.exe*"))))