(Image:(*\/sh OR *\/bash OR *\/zsh OR *\/dash OR *\/ash)) AND ((ParentImage:(*\/httpd OR *\/apache2 OR *\/nginx OR *\/php\-fpm OR *\/python OR *\/node OR *\/mysqld OR *\/postgres OR *\/redis\-server)) OR ((CommandLine:(*\/dev\/tcp\/* OR *\/dev\/udp\/* OR *interactive* OR *\>\&* OR *0\>\&1*)) OR (CommandLine:*curl* AND CommandLine:*\|* AND CommandLine:*sh*) OR (CommandLine:*wget* AND CommandLine:*\-O\-*))) AND (NOT ((ParentImage:(*\/systemd OR *\/sbin\/init)) OR (CommandLine:(*\/var\/lib\/apt\/* OR *\/tmp\/terraform_* OR *logrotate*)) OR (username:root AND Parentprocessname:\/usr\/sbin\/sshd)))
