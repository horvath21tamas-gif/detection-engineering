SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%.exe' AND (("LoadedImage" LIKE '%\\user32.dll%' OR "LoadedImage" LIKE '%\\advapi32.dll%' OR "LoadedImage" LIKE '%\\win32u.dll%')) AND (("LoadedImage" LIKE '%user32.dll%' OR "LoadedImage" LIKE '%advapi32.dll%')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\ProgramData\%')) AND NOT (""Filename"" ILIKE ENUMERATION('C:\Windows\System32\%','C:\Windows\SysWOW64\%') OR ""Filename"" ILIKE ENUMERATION('%\explorer.exe','%\chrome.exe','%\msedge.exe','%\firefox.exe','%\teams.exe','%\outlook.exe','%\slack.exe','%\zoom.exe') OR ""Filename"" ILIKE ENUMERATION('%\Accessibility\%','%\Screen Recorder\%','%\ScreenCapture\%','%\Security\%','%\Antivirus\%','%\EDR\%','%\Defender\%','%\CrowdStrike\%','%\SentinelOne\%'))
