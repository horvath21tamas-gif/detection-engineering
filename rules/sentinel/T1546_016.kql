DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ParentProcessName endswith "\msiexec.exe" and (ParentProcessCommandLine in ("*\Users\*", "*\Downloads\*", "*\Desktop\*", "*\AppData\Local\Temp\*", "*\Windows\Temp\*", "*\PerfLogs\*")) and ((FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\bitsadmin.exe", "*\certutil.exe", "*\mshta.exe", "*\regsvr32.exe", "*\scrcons.exe", "*\rundll32.exe")) or (ProcessCommandLine in ("*http*", "*ftp*", "*-enc*", "*-ExecutionPolicy Bypass*", "*DownloadString*", "*Invoke-WebRequest*"))) and (not ((ParentProcessCommandLine in ("*C:\Windows\ccmcache\*", "*C:\Windows\IME\*", "*C:\Program Files\*", "*C:\Program Files (x86)\*")) and username =~ "NT AUTHORITY\SYSTEM"))