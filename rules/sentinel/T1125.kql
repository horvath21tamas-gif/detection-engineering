DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*avicap32.dll*", "*capCreateCaptureWindow*", "*ksuser.dll*", "*mfplat.dll*", "*Windows.Media.Capture*")) or ((FolderPath in ("*\ffmpeg.exe", "*\vlc.exe")) or (ProcessCommandLine in ("*-dshow*", "*-f dshow*", "*-video_size*", "*capture*")))) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\rundll32.exe", "*\regsvr32.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*\Microsoft Teams\*", "*\Zoom.exe*", "*\Webex.exe*", "*\Slack.exe*", "*C:\Windows\System32\CameraSettingsUIHost.exe*")) or ProcessCommandLine contains "skype.exe" or User =~ "NT AUTHORITY\SYSTEM"))