(Image IN ("*\\reg.exe", "*\\powershell.exe", "*\\pwsh.exe") OR CommandLine IN ("* add *", "*Set-ItemProperty*", "*New-ItemProperty*") CommandLine IN ("*Control Panel\\Desktop\\Wallpaper*", "*Microsoft\\Windows\\CurrentVersion\\Policies\\System*", "*legalnoticecaption*", "*legalnoticetext*")) OR Image IN ("*\\cmd.exe", "*\\xcopy.exe", "*\\robocopy.exe") OR CommandLine IN ("*Windows\\Web\\Wallpaper*", "*.jpg*", "*.png*", "* /y*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\explorer.exe") NOT (ParentImage IN ("*\\CcmExec.exe", "*\\gpscript.exe") OR CommandLine="*company_logo*" OR username="NT AUTHORITY\\SYSTEM")
