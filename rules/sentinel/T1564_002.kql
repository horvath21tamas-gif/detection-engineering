DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*Winlogon\SpecialAccounts\UserList*", "*Winlogon\UserList*")) and (ProcessCommandLine in ("* /d 0*", "*REG_DWORD*")) and (((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powershell.exe", "*\cmd.exe", "*\mshta.exe", "*\cscript.exe", "*\wscript.exe", "*\bash.exe")) or (FolderPath in ("*\Users\*", "*\Temp\*", "*\AppData\*"))) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\Windows\System32\svchost.exe*", "*\Windows\servicing\TrustedInstaller.exe*", "*\CcmExec.exe*", "*\Program Files\Microsoft SQL Server\*")))))