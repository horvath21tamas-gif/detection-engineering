SELECT UTF8(payload) as search_payload from events where (("ParentImage" LIKE '%\\WINWORD.EXE%' OR "ParentImage" LIKE '%\\EXCEL.EXE%' OR "ParentImage" LIKE '%\\POWERPNT.EXE%' OR "ParentImage" LIKE '%\\OUTLOOK.EXE%' OR "ParentImage" LIKE '%\\MSACCESS.EXE%')) AND (("Filename" LIKE '%\\cmd.exe%' OR "Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%' OR "Filename" LIKE '%\\mshta.exe%' OR "Filename" LIKE '%\\rundll32.exe%' OR "Filename" LIKE '%\\regsvr32.exe%' OR "Filename" LIKE '%\\bitsadmin.exe%' OR "Filename" LIKE '%\\certutil.exe%'))
