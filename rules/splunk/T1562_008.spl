eventName IN ("StopLogging", "DeleteTrail", "DeleteEventDataStore") OR (eventName="UpdateTrail" requestParameters.enableLogFileValidation=false OR requestParameters.kmsKeyId="") OR (eventName IN ("PutEventSelectors", "UpdateEventDataStore") requestParameters.includeManagementEvents=false) OR (eventSource="s3.amazonaws.com" eventName IN ("DeleteBucket", "PutBucketLifecycleConfiguration", "PutBucketVersioning", "PutBucketPolicy") requestParameters.bucketName IN ("*log*", "*trail*", "*audit*", "*security*", "*telemetry*")) userIdentity.type="Root" OR userIdentity.sessionContext.attributes.mfaAuthenticated="false" OR userAgent IN ("*python-requests*", "*curl*", "*wget*", "*kali*", "*postman*", "*bot*") OR userAgent="*aws-cli*" NOT (userIdentity.arn IN ("*role/Terraform*", "*role/CloudFormation*", "*role/Security-Automation*", "*role/OrganizationAccountAccessRole*", "*role/AWSServiceRoleForCloudTrail*") OR userIdentity.invokedBy IN ("cloudtrail.amazonaws.com", "config.amazonaws.com")) | table eventTime,eventName,userIdentity.arn,userIdentity.type,userAgent,sourceIPAddress,requestParameters,awsRegion
