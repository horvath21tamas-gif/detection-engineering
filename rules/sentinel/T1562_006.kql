DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\logman.exe" and ProcessCommandLine contains "stop" and (ProcessCommandLine in ("*EventLog-System*", "*EventLog-Security*", "*Microsoft-Windows-DotNETRuntime*", "*Microsoft-Windows-Web-Http*"))) or (FolderPath endswith "\wecutil.exe" and (ProcessCommandLine in ("* ds *", "* /e:false*"))) or ProcessCommandLine contains "remoteip=") and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\w3wp.exe", "*\powershell.exe", "*\cmd.exe")) or (not ((User =~ "NT AUTHORITY\SYSTEM" and ParentProcessName endswith "\services.exe") or (ProcessCommandLine in ("*C:\Program Files\Microsoft Monitoring Agent\*", "*C:\Program Files\SplunkUniversalForwarder\*", "*C:\Program Files\Docker\*")))))