CommandLine IN ("*--privileged*", "*--cap-add=SYS_ADMIN*", "*--cap-add=SYS_PTRACE*", "*--pid=host*", "*--net=host*", "*--ipc=host*", "*--security-opt=seccomp=unconfined*", "*--security-opt=apparmor=unconfined*") OR CommandLine IN ("*-v /:/*", "*-v /proc:/proc*", "*-v /sys:/sys*", "*-v /var/run/docker.sock:/var/run/docker.sock*", "*-v /run/containerd:/run/containerd*", "*-v /etc/kubernetes:/etc/kubernetes*", "*-v /root/.ssh:/root/.ssh*") ParentImage IN ("*/bash", "*/sh", "*/zsh", "*/python", "*/ruby", "*/php", "*/node") NOT (Image IN ("*kube-proxy*", "*calico/node*", "*cilium*", "*datadog/agent*", "*node-exporter*", "*istio-proxy*", "*fluentd*", "*prometheus*") username="root")
