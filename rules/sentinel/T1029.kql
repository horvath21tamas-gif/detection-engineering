DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (EventData in ("*\rclone.exe*", "*\bitsadmin.exe*", "*\certutil.exe*", "*\megatools.exe*", "*curl *", "*powershell*")) and ((EventData in ("* sync *", "* upload *", "* -post *", "* -transfer *", "* -ExecutionPolicy Bypass *", "*WebClient.UploadFile*")) or (EventData in ("*<Interval>PT5M</Interval>*", "*<Interval>PT10M</Interval>*", "*<StartBoundary>202[0-9]-[0-9]{2}-[0-9]{2}T0[0-3]:*"))) and (not ((EventData in ("*\Windows\System32\Tasks\Microsoft*", "*\Program Files\*")) or SubjectUserName =~ "SYSTEM" or (EventData in ("*Telemetry*", "*Windows Update*"))))