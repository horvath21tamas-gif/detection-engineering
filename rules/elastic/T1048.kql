(((process.executable.caseless:(*\\plink.exe OR *\\pscp.exe OR *\\ncat.exe OR *\\nc.exe OR *\\socat.exe OR *\\iodine.exe OR *\\ssh.exe OR *\\curl.exe OR *\\wget.exe)) AND (process.command_line:(*\ \-R\ * OR *\ \-L\ * OR *\ \-D\ * OR *\ \-X\ * OR *\ \-N\ * OR *\ \-ssh* OR *\ \-proxy* OR *\ \-listen* OR *\ \-connect*))) OR process.command_line:/(?i).* -l ([5-9][0-9]{2,}|[1-9][0-9]{3,}).*/) AND (process.executable.caseless:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Public\\* OR *\\PerfLogs\\*)) AND winlog.event_data.IntegrityLevel:Medium AND (NOT ((process.executable.caseless:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) OR (process.command_line:(*127.0.0.1* OR *localhost* OR *intranet*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM" OR (process.parent.executable.caseless:(*\\services.exe OR *\\svchost.exe))))
