SELECT Time, user_name, operation_name, request_parameters, user_agent, mfa_authenticated, resource_id from events where (("operation_name" LIKE '%ModifyImageAttribute%' OR "operation_name" LIKE '%CopyImage%' OR "operation_name" LIKE '%Microsoft.Compute/images/write%' OR "operation_name" LIKE '%v1.compute.images.setLabels%' OR "operation_name" LIKE '%UpdateImagePermissions%' OR "operation_name" LIKE '%SetImageAccessPolicy%')) AND (("request_parameters" LIKE '%all%' OR "request_parameters" LIKE '%public%' OR "request_parameters" LIKE '%grantee%' OR "request_parameters" LIKE '%Everyone%' OR "request_parameters" LIKE '%AuthenticatedUsers%') OR "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%boto3%' OR "user_agent" LIKE '%curl%' OR "user_agent" LIKE '%postman%' OR "user_agent" LIKE '%powershell%' OR "user_agent" LIKE '%Terraform%'))) AND NOT (("user_name" LIKE '%svc-packer%' OR "user_name" LIKE '%svc-terraform%' OR "user_name" LIKE '%image-pipeline-admin%' OR "user_name" LIKE '%azure-image-builder%' OR "user_name" LIKE '%svc-pulumi%') OR ("user_name" LIKE '%system-internal%' OR "user_name" LIKE '%service-linked-role%' OR "user_name" LIKE '%azuremonitor%' OR "user_name" LIKE '%loganalytics%'))
