DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\aws.exe", "*\az.exe", "*\gsutil.exe", "*\rclone.exe", "*\mc.exe")) and ((ProcessCommandLine in ("*--access-key*", "*--secret-key*", "*--connection-string*", "*SharedAccessSignature*", "*--account-key*")) or (ProcessCommandLine in ("* s3 sync *", "* storage blob download-batch *", "* cp --recursive *", "* cp -r *", "* ls -R *", "* --include \"*.*\"*"))) and ((ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\nginx.exe", "*\powershell.exe", "*\cmd.exe")) and IntegrityLevel =~ "Medium") and (not ((ProcessCommandLine in ("*Azure-Log-Collector*", "*C:\Program Files\Microsoft SDKs\*", "*cloud-init*")) or User =~ "NT AUTHORITY\SYSTEM" or ParentProcessName contains "\Jenkins\"))