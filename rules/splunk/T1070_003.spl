(Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*Search-Mailbox*", "*New-MailboxSearch*", "*Export-Mailbox*", "* -DeleteContent*", "* -Force*", "* -Purge*")) OR CommandLine IN ("*Security*", "*Alert*", "*Phish*", "*Login*") ParentImage IN ("*\\w3wp.exe", "*\\winword.exe", "*\\excel.exe", "*\\mshta.exe", "*\\php-cgi.exe", "*\\powershell.exe", "*\\cmd.exe") OR NOT (User="NT AUTHORITY\\*" OR CommandLine IN ("*Discovery Management*", "*Compliance*", "*Retention*") OR ParentImage="*\\ExSetup.exe")
