source="WinEventLog:Microsoft-Windows-Sysmon/Operational" Operation="Created" ConsumerType IN ("CommandLineEventConsumer", "ActiveScriptEventConsumer") Destination IN ("*powershell*", "*cmd.exe*", "*mshta*", "*regsvr32*", "*scrcons.exe*", "*C:\\Users\\*", "*C:\\Windows\\Temp\\*") OR Query IN ("*SELECT * FROM __InstanceModificationEvent WITHIN*", "*SELECT * FROM Win32_LocalTime*") NOT ((Image IN ("*\\CcmExec.exe", "*\\TaniumClient.exe", "*\\MonitoringHost.exe", "*\\ltsvc.exe") username="NT AUTHORITY\\SYSTEM") OR Name IN ("SCM Event Log Consumer", "BVTConsumer"))
