DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ParentProcessName in ("*\CcmExec.exe", "*\PDQDeployService.exe", "*\AdminArsenal.exe", "*\PSEXESVC.exe", "*\BatchPatch.exe", "*\GMSCAgent.exe", "*\ManageEngine\UEMS_Agent\bin\dcoptimizationservice.exe")) and ((FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\bitsadmin.exe", "*\certutil.exe", "*\rundll32.exe", "*\regsvr32.exe", "*\mshta.exe")) or (ProcessCommandLine in ("*-enc*", "*DownloadString*", "*http*", "*IEX*", "*Invoke-WebRequest*", "*lsass*", "*vssadmin*"))) and (not ((ProcessCommandLine in ("*C:\Windows\CCM\SystemTemp\*", "*PolicyNames*", "*SoftwareCenter*", "*Configuration Manager*")) or (username =~ "NT AUTHORITY\SYSTEM" and ProcessCommandLine contains "C:\Windows\ccmcache\")))