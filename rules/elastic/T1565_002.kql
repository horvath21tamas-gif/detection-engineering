(process.executable.caseless:(*\\netsh.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\reg.exe OR *\\cmd.exe)) AND ((process.command_line:(*set\ dns* OR *set\ proxy* OR *winhttp\ set\ proxy* OR *AutoConfigURL* OR *ProxyServer* OR *ProxyEnable* OR *Internet\ Settings*)) OR (process.command_line:(*\\etc\\hosts* OR *System32\\drivers\\etc\\hosts* OR *\ \>\>\ * OR *Set\-Content* OR *Add\-Content*))) AND (process.parent.executable.caseless:(*\\winword.exe OR *\\excel.exe OR *\\httpd.exe OR *\\rundll32.exe OR *\\explorer.exe)) AND (NOT ((process.parent.executable.caseless:(*\\msiexec.exe OR *\\CcmExec.exe)) OR (process.command_line:(*127.0.0.1* OR *localhost*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM"))
