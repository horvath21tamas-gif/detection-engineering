Image="*\\hh.exe" OriginalFileName="hh.exe" IntegrityLevel IN ("Low", "Medium") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*") OR CommandLine IN ("*http://*", "*https://*", "*ftp://*") OR CommandLine IN ("*its:*", "*mk:@MSITStore*", "*ms-its:*") OR CommandLine="*-decompile*" OR (CommandLine IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*", "*\\Downloads\\*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\chrome.exe", "*\\msedge.exe")) OR CommandLine IN ("*.txt*", "*.jpg*", "*.png*", "*.dat*", "*.tmp*") NOT (Image IN ("C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*") ParentImage IN ("C:\\Program Files\\*", "C:\\Program Files (x86)\\*") IntegrityLevel="High") NOT User="NT AUTHORITY\\*"
