DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ImageLoaded in ("*\user32.dll", "*\advapi32.dll", "*\win32u.dll")) and FolderPath endswith ".exe" and (not (FolderPath in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*"))) and (not (FolderPath in ("*\explorer.exe", "*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\teams.exe")))