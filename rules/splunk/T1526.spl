Image IN ("*\\aws.exe", "*\\az.cmd", "*\\az.exe", "*\\gcloud.cmd", "*\\gcloud.exe", "*\\azcli.exe") CommandLine IN ("*lambda list-functions*", "*secretsmanager list-secrets*", "*eks list-clusters*", "*keyvault list*", "*webapp list*", "*functionapp list*", "*functions list*", "*container clusters list*", "*storage account list*", "*projects list*") CommandLine IN ("*--query*", "*--output json*", "*| jq*", "*| base64*", "* > *", "* | clip*", "*| tee*", "*| Out-File*") OR ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wsmprovhost.exe", "*\\httpd.exe", "*\\rundll32.exe") NOT (ParentImage IN ("*\\Jenkins\\*", "*\\GitLab-Runner\\*", "*\\Terraform\\*", "*\\Ansible\\*", "*\\OctopusDeploy\\*") username="NT AUTHORITY\\SYSTEM" CommandLine IN ("*-NonInteractive*", "*-EncodedCommand*"))
