(process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\mshta.exe OR *\\cscript.exe OR *\\wscript.exe)) AND process.command_line:/(-w\s*h|-window\s*h|-win\s*h|-wind\s*h|showwindow\s*=\s*0|windowstyle\s*1|sw_hide)/ AND ((process.parent.executable.caseless:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\chrome.exe OR *\\msedge.exe OR *\\acrord32.exe OR *\\sqlservr.exe OR *\\w3wp.exe)) OR (process.command_line:(*\ \-enc* OR *\ \-e\ * OR *\ \-nop* OR *\ \-noni* OR *iex* OR *downloadstring* OR *frombase64string* OR *Invoke\-Expression*))) AND (NOT (winlog.event_data.username:"NT AUTHORITY\\SYSTEM" AND (process.parent.executable.caseless:(*\\Windows\\System32\\ServerManager.exe* OR *\\Configuration\ Manager\\* OR *\\HealthService.exe* OR *\\CcmExec.exe*)) AND (process.command_line:(*Chocolatey* OR *Splunk* OR *Logitech* OR *SCCM* OR *Microsoft.WSUS*))))
