SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\netsh.exe','%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%wfp%','%callout%','%add-filter%','%add callout%','%fwpm%','%netsh wfp%','%netsh advfirewall%')) OR (""Filename"" ILIKE ENUMERATION('%\sc.exe','%\reg.exe')) AND "Process "Process CommandLine"" ILIKE '%create%' AND "Process "Process CommandLine"" ILIKE '%type=%' AND "Process "Process CommandLine"" ILIKE '%kernel%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Temp\%','%\AppData\%','%\Users\Public\%','%\ProgramData\%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe','%\TrustedInstaller.exe','%\msiexec.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\python.exe','%\wscript.exe','%\cscript.exe')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Program Files\Windows Defender\%','%\Program Files\CrowdStrike\%','%\Program Files\SentinelOne\%','%\Program Files\Microsoft Security\%')) AND "username" ILIKE 'NT AUTHORITY\%')
