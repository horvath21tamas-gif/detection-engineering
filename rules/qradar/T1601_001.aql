SELECT UTF8(payload) as search_payload from events where (("Message" LIKE '%mount -o remount%' OR "Message" LIKE '%rw%' OR "Message" LIKE '%mount -uw%' OR "Message" LIKE '%config-transaction%') OR ("Message" LIKE '%xxd %' OR "Message" LIKE '%dd if=%' OR "Message" LIKE '%insmod%' OR "Message" LIKE '%gdb %' OR "Message" LIKE '%setenforce 0%')) AND (("Message" LIKE '%/bin/%' OR "Message" LIKE '%/sbin/%' OR "Message" LIKE '%/lib/modules%' OR "Message" LIKE '%/boot/%')) AND NOT (("user_name" LIKE '%svc-system-update%' OR "user_name" LIKE '%installer%') OR ("Message" LIKE '%show %' OR "Message" LIKE '%cat %' OR "Message" LIKE '%grep %'))
