DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "/osascript" or OriginalFileName =~ "osascript") and (ProcessCommandLine in ("*with administrator privileges*", "*do shell script*", "*display dialog*")) and (ParentProcessName in ("*/Applications/Google Chrome.app/*", "*/Applications/Safari.app/*", "*/Applications/Microsoft Word.app/*", "*/Applications/Microsoft Excel.app/*", "*/Applications/Slack.app/*", "*/Applications/Microsoft Teams.app/*", "*/private/tmp/*", "*/Users/Shared/*")) and (not ((ParentProcessName in ("*/Library/Application Support/JamfSoftware/*", "*/usr/local/bin/kandji*", "*/System/Library/PrivateFrameworks/*")) or FolderPath contains "/usr/sbin/softwareupdate" or username =~ "root"))