Image IN ("*\\rclone.exe", "*\\azcopy.exe", "*\\gsutil.exe") OR CommandLine IN ("* config create*", "* mb *", "* storage buckets create*", "* make-bucket*") OR Image IN ("*\\curl.exe", "*\\wget.exe", "*\\python.exe", "*\\pwsh.exe") OR CommandLine IN ("*api.slack.com/services/T*", "*discord.com/api/webhooks*", "*api.telegram.org/bot*", "*github.com/settings/tokens*") NOT (Image IN ("*\\OneDrive.exe", "*\\Dropbox.exe", "*\\googledrivesync.exe") OR Image="*\\Veeam\\*") NOT (User IN ("*svc_backup*", "*svc_deploy*", "*adm_infra_deploy*") Image IN ("*\\actions-runner\\*", "*\\Jenkins\\*")) NOT (ParentImage IN ("*\\code.exe", "*\\idea64.exe", "*\\devenv.exe")) NOT (ParentImage="*\\explorer.exe" condition="not selection_storage_provisioning")
