SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%cpassword%','%password=%','%pwd=%','%userPassword%','%SecureString%','%ConvertTo-SecureString%','%Get-GPPPassword%','%unattend.xml%','%sysprep.xml%','%web.config%','%Groups.xml%','%ScheduledTasks.xml%','%Services.xml%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\SYSVOL\%','%\Policies\%','%\Windows\Panther\%','%\Windows\System32\sysprep\%','%\inetpub\wwwroot\%','%\ProgramData\%','%\Users\%')) AND ((""Filename"" ILIKE ENUMERATION('%\findstr.exe','%\find.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\grep.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Select-String%','%Get-ChildItem%','%dir %','%type %','%gc %')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-EncodedCommand%','%IEX%','%Invoke-Expression%','%DownloadString%') OR ""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\psexesvc.exe','%\wmiprvse.exe')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\svchost.exe','%\taskhostw.exe','%\gpscript.exe')) AND "username" ILIKE 'NT AUTHORITY\SYSTEM%')
