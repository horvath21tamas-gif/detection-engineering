DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*.aws\credentials*", "*.azure\azureProfile.json*", "*.azure\accessTokens.json*", "*.config\gcloud\*", "*.docker\config.json*")) and ((ProcessCommandLine in ("*base64*", "* | clip*", "* > *", "*curl*", "*type *", "*Get-Content*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\php-cgi.exe", "*\psexesvc.exe")) and (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*")))) and (not ((FolderPath in ("*\aws.exe", "*\az.cmd", "*\gcloud.cmd", "*\docker.exe")) and username =~ "NT AUTHORITY\SYSTEM"))