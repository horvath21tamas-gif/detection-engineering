DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\tcpdump.exe", "*\windump.exe", "*\scapy.exe", "*\nmap.exe")) or (OriginalFileName in ("tcpdump.exe", "windump.exe", "scapy.exe"))) or (ProcessCommandLine in ("*advfirewall firewall add rule*", "*action=allow*", "*protocol=UDP*", "*protocol=ICMP*", "*localport=any*"))) and ((ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe")) and (FolderPath in ("*\Users\*", "*\Temp\*", "*\Downloads\*", "*\AppData\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or FolderPath contains "C:\Windows\System32\svchost.exe" or ProcessCommandLine contains "description="))