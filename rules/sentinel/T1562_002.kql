DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\wevtutil.exe" and (ProcessCommandLine contains " sl " and ProcessCommandLine contains "/e:false")) or (FolderPath endswith "\wevtutil.exe" and (ProcessCommandLine in ("* cl *", "* clear-log *"))) or (FolderPath endswith "\sc.exe" and (ProcessCommandLine contains " config " and ProcessCommandLine contains " eventlog " and ProcessCommandLine contains " start=" and ProcessCommandLine contains " disabled")) or (FolderPath endswith "\sc.exe" and (ProcessCommandLine contains " stop " and ProcessCommandLine contains " eventlog ")) or ((FolderPath in ("*\net.exe", "*\net1.exe")) and (ProcessCommandLine contains " stop " and ProcessCommandLine contains " eventlog ")) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine contains "Stop-Service" and ProcessCommandLine contains "eventlog")) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine contains "Set-Service" and ProcessCommandLine contains "eventlog" and ProcessCommandLine contains "Disabled")) or (FolderPath endswith "\reg.exe" and (ProcessCommandLine contains " add " and ProcessCommandLine contains "HKLM\SYSTEM\CurrentControlSet\Services\EventLog" and ProcessCommandLine contains " Start") and (ProcessCommandLine in ("* 4*", "*0x4*"))) or (FolderPath endswith "\reg.exe" and (ProcessCommandLine contains " add " and ProcessCommandLine contains "\Services\EventLog\" and ProcessCommandLine contains " Enabled") and (ProcessCommandLine in ("* 0*", "*0x0*"))) or (FolderPath endswith "\reg.exe" and (ProcessCommandLine contains "DependOnService" and ProcessCommandLine contains "EventLog"))) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\w3wp.exe", "*\mshta.exe", "*\rundll32.exe")) and (not (User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe", "*\msiexec.exe")))) and (not (ParentProcessName in ("*\ConfigurationManager\*", "*\IntuneManagementExtension\*", "*\PDQDeploy\*", "*\ManageEngine\*", "*\BigFix\*"))) and (not User contains "TrustedInstaller")