CommandLine IN ("*.MainWindowTitle*", "*Get-Process | select*", "*Get-Process | Where-Object*") OR CommandLine IN ("*EnumWindows*", "*GetWindowText*", "*GetForegroundWindow*") CommandLine IN ("* > *", "* | Export-Csv*", "*ConvertTo-Json*", "*base64*", "* | clip*") OR (ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe", "*\\excel.exe") Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*")) NOT (username="NT AUTHORITY\\SYSTEM" Image IN ("*\\Program Files\\AnyDesk\\*", "*\\Program Files\\TeamViewer\\*"))
