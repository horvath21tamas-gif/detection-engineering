SELECT username, "Filename", "Parent Filename", Process "Process CommandLine", Integrity Level, Process Path, File Hash from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%rest/api/%','%api/v2/spaces%','%api/v2/pages%','%rest/api/2/issue%','%_vti_bin/lists.asmx%','%Get-SPO%','%export-sharepoint%','%Get-PnP%','%/wiki/pages/viewpage%','%.wiki.git%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%export%','%backup%','%download-all%','%recursive%','%dump%','%--mirror%','%--all%','%--depth%','%clone%','%archive%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\Temp\%','%\AppData\Local\Temp\%','%\Public\%','%-OutFile%','%>%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\w3wp.exe','%\httpd.exe','%\python.exe','%\node.exe')) AND (("Integrity Level" LIKE '%Medium%' OR "Integrity Level" LIKE '%High%')) AND NOT (""Filename"" ILIKE ENUMERATION('%C:\Program Files\Atlassian\%','%C:\Program Files\Microsoft Monitoring Agent\%','%C:\Windows\CCM\%','%C:\Program Files\Elastic\%','%C:\Program Files\Splunk\%') OR ("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%DOMAIN\\svc_%' OR "UserName" LIKE '%DOMAIN\\backup_%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%healthcheck%','%ping%','%--version%','%-help%'))
