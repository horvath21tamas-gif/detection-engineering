(CommandLine="*:Zone.Identifier*" CommandLine IN ("*Remove-Item*", "*Set-Content*", "*Clear-Content*", "*streams.exe*", "*cmd /c del*", "*powershell -command*", "*del *") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe")) OR CommandLine IN ("*reg add*", "*reg delete*", "*Set-ItemProperty*") CommandLine IN ("*\\Downloads\\*", "*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Desktop\\*") NOT (Image IN ("*\\msiexec.exe", "*\\setup.exe", "*\\chrome.exe", "*\\msedge.exe") username="NT AUTHORITY\\SYSTEM")
