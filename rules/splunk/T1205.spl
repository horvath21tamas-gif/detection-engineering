(Image="*\\netsh.exe" OriginalFileName="netsh.exe" CommandLine="*advfirewall firewall add rule*" CommandLine="*action=allow*" CommandLine="*protocol=UDP*" CommandLine IN ("*protocol=ICMP*", "*localport=any*", "*remoteport=any*")) OR (Image IN ("*\\tcpdump.exe", "*\\windump.exe", "*\\scapy.exe", "*\\nmap.exe", "*\\hping.exe") CommandLine IN ("* -i *", "*sniffer*", "*npcap*", "*winpcap*")) ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe") Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\AppData\\*", "*\\ProgramData\\*") NOT (User="NT AUTHORITY\\*" Image IN ("*\\Windows\\System32\\svchost.exe*", "*\\Program Files\\Windows Defender\\*", "*\\Program Files\\CrowdStrike\\*", "*\\Program Files\\SentinelOne\\*") CommandLine="*description=*")
