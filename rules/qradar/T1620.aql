SELECT UTF8(payload) as search_payload from events where (("Process "Process CommandLine"" ILIKE ENUMERATION('%VirtualAlloc%','%VirtualProtect%','%WriteProcessMemory%','%CreateRemoteThread%','%NtMapViewOfSection%','%QueueUserAPC%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%0x20%','%0x40%','%0x3000%')) OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%[System.Reflection.Assembly]::Load(%','%Reflection.Emit%','%Marshal.Copy%','%[Activator]::CreateInstance(%','%[AppDomain]::CurrentDomain%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%FromBase64String%','%IO.MemoryStream%','%IO.Compression%','%ConvertFrom-SecureString%','%AES%'))) AND (""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Temp\%','%\ProgramData\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\explorer.exe','%\wsmprovhost.exe')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Visual Studio\%','%\MSBuild.exe%','%\dotnet.exe%','%\GitHub\%','%\Jenkins\%','%\AzureDevOps\%')) AND (("UserName" LIKE '%svc-build%' OR "UserName" LIKE '%ci%' OR "UserName" LIKE '%cicd%' OR "UserName" LIKE '%jenkins%')))
