SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%' OR "Filename" LIKE '%\\bitsadmin.exe%' OR "Filename" LIKE '%\\certutil.exe%')) AND (("Process CommandLine" LIKE '%http://%' OR "Process CommandLine" LIKE '%https://%' OR "Process CommandLine" LIKE '%Invoke-WebRequest%' OR "Process CommandLine" LIKE '%iwr %' OR "Process CommandLine" LIKE '%DownloadFile%' OR "Process CommandLine" LIKE '%bitsadmin /transfer%' OR "Process CommandLine" LIKE '%certutil -urlcache%')) AND (("Process CommandLine" LIKE '%IEX%' OR "Process CommandLine" LIKE '%Invoke-Expression%' OR "Process CommandLine" LIKE '%| iex%' OR "Process CommandLine" LIKE '%-enc%' OR "Process CommandLine" LIKE '%FromBase64String%') OR ("Process CommandLine" LIKE '%\\Users\\%' OR "Process CommandLine" LIKE '%\\AppData\\%' OR "Process CommandLine" LIKE '%\\Temp\\%' OR "Process CommandLine" LIKE '%\\Downloads\\%')) AND (("ParentImage" LIKE '%\\WINWORD.EXE%' OR "ParentImage" LIKE '%\\EXCEL.EXE%' OR "ParentImage" LIKE '%\\POWERPNT.EXE%' OR "ParentImage" LIKE '%\\OUTLOOK.EXE%' OR "ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\mshta.exe%')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\CCM\\%' OR "ParentImage" LIKE '%\\Microsoft Configuration Manager\\%' OR "ParentImage" LIKE '%\\PDQ\\%' OR "ParentImage" LIKE '%\\Ivanti\\%' OR "ParentImage" LIKE '%\\ManageEngine\\%' OR "ParentImage" LIKE '%\\Tanium\\%' OR "ParentImage" LIKE '%\\Intune\\%' OR "ParentImage" LIKE '%\\Microsoft\\EdgeUpdate\\%' OR "ParentImage" LIKE '%\\Google\\Update\\%'))
