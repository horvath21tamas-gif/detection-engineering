Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\python.exe", "*\\ruby.exe") CommandLine IN ("*while($true)*", "*for(;;)*", "*:loop*", "*foreach($i in 1..1gb)*", "*AllocHGlobal*", "*::MemoryStream*", "*New-Object System.Collections.ArrayList*", "*Start-Job*", "*Start-ThreadJob*", "*Thread.Sleep*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\powerpnt.exe", "*\\httpd.exe", "*\\nginx.exe", "*\\rundll32.exe", "*\\explorer.exe") Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*") NOT (username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe", "*\\devenv.exe", "*\\powershellISE.exe") CommandLine IN ("*HealthCheck*", "*Diagnostic*", "*AzureAD*", "*System Center*", "*Test-Connection*"))
