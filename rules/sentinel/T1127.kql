DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath =~ "(msbuild\.exe|csc\.exe|jsc\.exe|vbc\.exe)$" and OriginalFileName =~ "(MSBuild\.exe|csc\.exe|jsc\.exe|vbc\.exe)$") and (ParentProcessName =~ "(winword\.exe|excel\.exe|powerpnt\.exe|outlook\.exe|chrome\.exe|msedge\.exe|wmiprvse\.exe|mshta\.exe)$" or ProcessCommandLine =~ "(http|\\|\AppData\|\Temp\|\Users\Public\)") and (not (ParentProcessName =~ "(\Microsoft Visual Studio\|\Common7\IDE\|\BuildAgent\|\Jenkins\)" and ProcessCommandLine =~ "(C:\Program Files \(x86\)\Microsoft Visual Studio|C:\Windows\Microsoft\.NET\Framework)"))