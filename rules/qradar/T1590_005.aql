SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\aws.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% iam list-%','% s3api list-%','% secretsmanager list-secrets%')) OR ""Filename"" ILIKE '%\az.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% network nsg list%','% account list%','% keyvault list%')) OR (""Filename"" ILIKE ENUMERATION('%\gcloud.exe','%\gsutil.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% projects list%','% iam roles list%'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\jenkins.exe','%\git-remote-http.exe','%\gitlab-runner.exe','%\terraform.exe','%\ansible.exe')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%--version%','% help%','%--help%')) AND NOT (("UserName" LIKE '%SVC_%' OR "UserName" LIKE '%SA_%' OR "UserName" LIKE '%AUTO_%'))
