SELECT UTF8(payload) as search_payload from events where "Target Object" IMATCHES '\\Software\\Microsoft\\Office\\.*\\Security\\(VBAWarnings|Trusted Locations\\|Trusted Documents\\DisableTrustedDocuments|BlockContentExecutionFromInternet)$' AND ("Target Details" IMATCHES 'DWORD \(0x0000000[01]\)' OR ""Filename"" IMATCHES '(winword\.exe|excel\.exe|outlook\.exe|svchost\.exe|msiexec\.exe|powershell\.exe|cmd\.exe|reg\.exe|wscript\.exe|cscript\.exe)$') AND NOT "Target Details" IMATCHES '(\\\\InternalStorage\\Templates|C:\\Program Files\\)'
