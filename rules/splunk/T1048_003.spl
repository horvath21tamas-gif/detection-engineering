
| rex field=CommandLine "(?<CommandLineMatch>(?i)nslookup.*[a-zA-Z0-9+/=]{30,}\\.)"
| eval CommandLineCondition=if(isnotnull(CommandLineMatch), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch2>.* -l (1[0-9]{3}|[2-9][0-9]{3}).*)"
| eval CommandLineCondition2=if(isnotnull(CommandLineMatch2), "true", "false")
| search CommandLine IN ("* -type=TXT*", "* -querytype=TXT*", "* -q=TXT*", "* -class=IN*") OR CommandLineCondition="true" OR (CommandLine="*ping *" CommandLineCondition2="true") (Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\certutil.exe", "*\\nslookup.exe")) OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\wscript.exe", "*\\cscript.exe") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*microsoft.com*", "*127.0.0.1*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
