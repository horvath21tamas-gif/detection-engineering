DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\driverquery.exe", "*\pnputil.exe", "*\sc.exe")) or (ProcessCommandLine in ("*query type= driver*", "*enum-drivers*"))) or (ProcessCommandLine in ("*Win32_PnPSignedDriver*", "*Win32_SystemDriver*", "*Get-WindowsDriver*", "*Get-PnpDevice*"))) and ((ProcessCommandLine in ("* > *", "* | clip*", "*ConvertTo-Json*", "*Export-Csv*", "*/fo csv*", "*base64*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe")) and (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*")))) and (not ((FolderPath in ("*\Program Files\Tanium\*", "*\Program Files\Splunk\*", "*\Program Files\Datadog\*")) and User =~ "NT AUTHORITY\SYSTEM"))