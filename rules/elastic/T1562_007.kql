winlog.channel:System AND (((winlog.event_data.eventName:(AuthorizeSecurityGroupIngress OR CreateSecurityGroup OR DeleteSecurityGroup OR PutManagedRuleSet OR UpdateFirewall)) AND ((requestParameters.ipPermissions.items.ipRanges.items.cidrIp:(0.0.0.0\/0 OR \:\:\/0)) AND requestParameters.ipPermissions.items.ipProtocol:\-1)) AND ((userIdentity.type:Root OR (winlog.event_data.userAgent:(*kali* OR *python\-requests* OR *curl* OR *postman*))) AND (NOT ((userIdentity.arn:(*role\/Terraform\-Execution\-Role* OR *role\/AWS\-CloudFormation\-Stack* OR *role\/Azure\-DevOps\-Service\-Principal*)) AND winlog.event_data.sourceIPAddress:10.0.0.0\/8))))
