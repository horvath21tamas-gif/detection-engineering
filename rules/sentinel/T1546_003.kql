DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\wmic.exe" and (ProcessCommandLine in ("*root\subscription*", "*__EventFilter*", "*CommandLineEventConsumer*", "*FilterToConsumerBinding*"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Register-WmiEvent*", "*Set-WmiInstance*", "*New-CimInstance*", "*root\subscription*")))) and (not (User contains "SYSTEM" or (FolderPath in ("*\Microsoft Monitoring Agent\*", "*\SCOM\*", "*\System Center\*", "*\Tanium\*", "*\Qualys\*", "*\CrowdStrike\*", "*\SentinelOne\*", "*\SplunkUniversalForwarder\*", "*\Datadog\*", "*\Elastic\Agent\*")) or (ProcessCommandLine in ("*HealthCheck*", "*Inventory*", "*Monitoring*"))))