(process.executable:*\\powercfg.exe OR process.pe.original_file_name:PowerCfg.exe) AND ((process.command_line:(*\ \-hibernate\ off* OR *\ \-x\ * OR *\ \-setacvalueindex\ * OR *\ \-requestsoverride\ * OR *\ SCHEME_MIN\ *)) OR (process.command_line:(*\ 0* OR *\ 000*))) AND (process.parent.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\psexec.exe)) AND (NOT (process.parent.executable:*C\:\\Windows\\System32\\SystemSettingsAdminFlows.exe* OR process.command_line:*monitor\-timeout\-ac*))
