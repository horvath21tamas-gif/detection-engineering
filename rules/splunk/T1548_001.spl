(Image="*/chmod" CommandLine IN ("*u+s*", "*g+s*", "*4755*", "*4777*", "*2755*", "*4000*", "*2000*") CommandLine IN ("*/tmp/*", "*/dev/shm/*", "*/var/tmp/*", "*/home/*", "*/run/*") OR ParentImage IN ("*/bash", "*/zsh", "*/sh")) OR (Image="*/find" CommandLine IN ("*-perm -4000*", "*-perm -2000*")) NOT (ParentImage IN ("*/apt", "*/dpkg", "*/yum", "*/dnf", "*/rpm", "*/ansible", "*/puppet") OR username="root")
