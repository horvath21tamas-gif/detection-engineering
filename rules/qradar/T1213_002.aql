SELECT username, "Filename", "Parent Filename", Process "Process CommandLine", Integrity Level, Process Path, File Hash from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%Get-PnP%','%Get-SPO%','%Connect-PnPOnline%','%Microsoft.SharePoint.PowerShell%','%/_api/web/lists%','%/_api/search/query%','%Export-PnPListItem%','%Get-PnPListItem%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -All%','% -Recurse%','% -PageSize 1000%','% -Limit All%','% -BatchSize %','% -AsJob%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\Public\%','%\Windows\Temp\%','%\AppData\Local\Temp\%','% -OutFile %','% -Path %')) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\w3wp.exe','%\explorer.exe','%\taskhostw.exe')) AND (("Integrity Level" LIKE '%Medium%' OR "Integrity Level" LIKE '%High%')) AND NOT (""Filename"" ILIKE ENUMERATION('%C:\Program Files\SharePoint Online Management Shell\%','%C:\Program Files\Microsoft SDKs\SharePoint\%','%C:\Program Files\Office\root\Office%','%C:\Program Files\OneDrive\%') OR ("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%DOMAIN\\svc_%' OR "UserName" LIKE '%DOMAIN\\backup_%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%OfficeClickToRun.exe%','%OneDrive.exe%','%HealthCheck%','% --version%','% -help%'))
