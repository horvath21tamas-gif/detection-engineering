SrcIp IN ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*") Method IN ("GET", "HEAD") UriStem IN ("*/version*", "*/about*", "*/status*", "*/info*", "*/build*", "*/debug*", "*/admin*", "*/server-info*", "*/actuator*", "*/metrics*") UriQuery IN ("*version*", "*build*", "*release*", "*software*", "*application*", "*component*", "*module*", "*plugin*", "*stack*") UserAgent IN ("*curl*", "*wget*", "*python*", "*httpclient*", "*go-http-client*", "*libwww*", "*scanner*", "*probe*") Status IN (200, 401, 403, 404) NOT (UserAgent IN ("*Mozilla*", "*Chrome*", "*Safari*", "*Firefox*", "*Edge*") OR UserAgent IN ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nikto*", "*nuclei*", "*zap*", "*zabbix*", "*prometheus*", "*uptime*", "*pingdom*") OR (UriStem IN ("*/api*", "*/health*") UriStem IN ("*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.woff", "*.woff2", "*.json"))) | table SrcIp,Method,UriStem,UriQuery,Status,UserAgent
