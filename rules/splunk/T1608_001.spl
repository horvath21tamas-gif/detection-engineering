Image IN ("*\\curl.exe", "*\\wget.exe", "*\\rclone.exe", "*\\aws.exe", "*\\az.exe", "*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("* -F *", "* --upload-file *", "* s3 cp *", "* storage blob upload *", "* rclone copy *", "* Invoke-RestMethod *", "* -Method Post *") CommandLine IN ("*github.com*", "*gitlab.com*", "*s3.amazonaws.com*", "*blob.core.windows.net*", "*transfer.sh*", "*mega.nz*", "*pastebin.com*") NOT ((Image IN ("*\\Jenkins\\*", "*\\GitLab-Runner\\*", "*\\AzureDevOps\\*") CommandLine IN ("*\\Program Files\\*", "*backup_config.json*") username="SYSTEM") OR ParentImage IN ("*\\chrome.exe", "*\\msedge.exe"))
