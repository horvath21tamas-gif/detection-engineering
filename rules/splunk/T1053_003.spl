Image IN ("*/echo", "*/tee", "*/sed", "*/cat", "*/printf") CommandLine IN ("*/etc/cron.d/*", "*/etc/cron.daily/*", "*/etc/cron.hourly/*", "*/etc/cron.monthly/*", "*/etc/cron.weekly/*", "*/var/spool/cron/*", "*/etc/crontab*") CommandLine IN ("*bash -i*", "*python*", "*curl*", "*wget*", "*base64*", "*/dev/tcp/*", "*nc *", "*chmod +x*") NOT (ParentImage IN ("*/ansible", "*/salt-minion", "*/puppet", "*/chef-client") OR (username="root" ParentImage IN ("*/dpkg", "*/rpm", "*/apt")))
