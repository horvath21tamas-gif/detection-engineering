(CommandLine IN ("*ipinfo.io*", "*ifconfig.me*", "*icanhazip.com*", "*api.ipify.org*", "*checkip.amazonaws.com*", "*ip-api.com*", "*ipwho.is*", "*freegeoip*") Image IN ("*\\curl.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wget.exe") CommandLine IN ("*Invoke-WebRequest*", "*Invoke-RestMethod*", "*nslookup*", "*Resolve-DnsName*")) OR (CommandLine IN ("*Keyboard Layout\\Preload*", "*Control Panel\\International*", "*MUILanguages*", "*GeoID*", "*Get-ItemProperty*", "*reg query*") CommandLine IN ("*Get-Culture*", "*Get-WinSystemLocale*", "*Get-TimeZone*", "*Get-UICulture*")) (ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\wsmprovhost.exe", "*\\httpd.exe", "*\\mshta.exe") IntegrityLevel="Medium") OR Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Temp\\*", "*\\ProgramData\\*") OR CommandLine IN ("* > *", "*| Out-File*", "*ConvertTo-Json*", "*findstr*", "*select-string*") NOT (User IN ("NT AUTHORITY\\*", "NT SERVICE\\*")) NOT (ParentImage IN ("*\\msiexec.exe", "*\\CcmExec.exe", "*\\svchost.exe", "*\\IntuneManagementExtension.exe") Image IN ("*\\Program Files\\*", "*\\Splunk\\*", "*\\Tanium\\*"))
