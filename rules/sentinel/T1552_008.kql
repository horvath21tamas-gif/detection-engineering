DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ProcessCommandLine contains "cpassword" and ((FolderPath in ("*\findstr.exe", "*\grep.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe")) or (ProcessCommandLine in ("*Get-GPPPassword*", "*Select-String*", "*type *"))) and (ProcessCommandLine in ("*SYSVOL*", "*Policies*", "*Groups.xml*", "*ScheduledTasks.xml*", "*Services.xml*")) and (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\psexesvc.exe")) and (not (User =~ "NT AUTHORITY\SYSTEM" and FolderPath endswith "\svchost.exe"))