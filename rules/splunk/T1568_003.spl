CommandLine IN ("* -querytype TXT*", "* -q TXT*", "*Resolve-DnsName*", "* -Type TXT*", "* -Type SRV*", "* -querytype SRV*") CommandLine IN ("*[Convert]::*", "* -bxor*", "*.Substring(*", "*.Split(*", "* [int]*", "* [byte]*", "*.ToCharArray(*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\mshta.exe") NOT (CommandLine IN ("*_vlmcs._tcp*", "*chocolatey*", "*domain-verification*", "*letsencrypt*", "*acme-challenge*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\services.exe", "*\\explorer.exe")) | table Time,SourceImage,ParentImage,CommandLine,ProcessId,SourceUsername,IntegrityLevel
