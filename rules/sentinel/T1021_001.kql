DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (EventID =~ 4624 and LogonType =~ 10) and (not ((IpAddress in ("10.*", "192.168.*", "172.16.*", "172.17.*", "172.18.*", "172.19.*", "172.20.*", "172.21.*", "172.22.*", "172.23.*", "172.24.*", "172.25.*", "172.26.*", "172.27.*", "172.28.*", "172.29.*", "172.30.*", "172.31.*")) or (WorkstationName in ("JUMP-*", "BASTION-*", "MGMT-*")) or (TargetUserName in ("*$*", "*SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*")) or (TargetUserName in ("admin*", "svc_*"))))