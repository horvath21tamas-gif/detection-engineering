SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE '%kerberos::golden%' AND "Process "Process CommandLine"" ILIKE '%/krbtgt:%' OR ""Filename"" ILIKE '%\rubeus.exe' AND "Process "Process CommandLine"" ILIKE '%golden%' AND "Process "Process CommandLine"" ILIKE '%/krbtgt:%' OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%/krbtgt:%','%/aes256:%','%/aes128:%')) AND "Process "Process CommandLine"" ILIKE '%/sid:%' AND "Process "Process CommandLine"" ILIKE '%/id:%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/ptt%','%kerberos::ptt%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wsmprovhost.exe','%\psexesvc.exe','%\wmiprvse.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe'))) AND NOT (""Filename"" ILIKE ENUMERATION('%\Microsoft Monitoring Agent\%','%\Azure\%','%\RSAT\%'))
