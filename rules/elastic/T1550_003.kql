winlog.channel:Security AND ((((event.code:(4768 OR 4769)) AND winlog.event_data.TicketEncryptionType:0x17 AND winlog.event_data.Status:0x0) OR (event.code:4768 AND (winlog.event_data.TicketOptions:(0x40810000 OR 0x40810010))) OR (event.code:4688 AND (process.command_line:(*klist\ purge* OR *kerberos\:\:ptt* OR *monitor\ \/interval*)))) AND (NOT (winlog.event_data.TargetUserName:*$ AND winlog.event_data.ServicePrincipalName:*krbtgt*)))
