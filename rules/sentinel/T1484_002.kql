DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((EventID =~ 5136 and ObjectClass =~ "trustedDomain" and (AttributeCommonName in ("trustAttributes", "msDS-TrustForestTrustInfo", "trustDirection"))) or (EventID in (4706, 4716)) or ((FolderPath in ("*\netdom.exe", "*\nltest.exe")) and (ProcessCommandLine in ("* trust *", "*/quarantine*", "*/enable_sidhistory*")))) and (not (SubjectUserSid =~ "S-1-5-18" and SubjectUserName endswith "$" and SubjectUserName contains "SVC_TrustAdmin"))