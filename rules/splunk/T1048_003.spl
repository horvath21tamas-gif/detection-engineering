CommandLine IN ("* -type=TXT*", "* -querytype=TXT*", "* -q=TXT*", "* -class=IN*") OR processcommandline="(*i)nslookup.*[A-Za-z0-9+/=]{30,}\\." OR (CommandLine="*ping *" processcommandline=".* -l (1[0-9]{3}|[2-9][0-9]{3}).*") (Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\certutil.exe", "*\\nslookup.exe")) OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\wscript.exe", "*\\cscript.exe") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*microsoft.com*", "*127.0.0.1*", "*localhost*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
