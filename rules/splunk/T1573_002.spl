CommandLine IN ("*ServerCertificateValidationCallback*", "*return $true*", "*ServicePointManager]::Expect100Continue*", "*SecurityProtocolType]::Tls12*") OR CommandLine IN ("*RSACryptoServiceProvider*", "*FromXmlString*", "*ImportSubjectPublicKeyInfo*", "*X509Certificate2*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\regsvr32.exe") NOT (CommandLine IN ("*C:\\Program Files\\*", "*Microsoft\\Azure*", "*HealthCheck*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
