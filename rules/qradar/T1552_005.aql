SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%\.aws\credentials%','%\.aws\config%','%\.azure\azureProfile.json%','%\.azure\accessTokens.json%','%\.config\gcloud\%','%\.docker\config.json%','%\AppData\Roaming\gcloud\%','%\AppData\Roaming\AWS\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%aws_access_key_id%','%aws_secret_access_key%','%clientSecret%','%refreshToken%','%access_token%','%private_key%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%base64%','%certutil -encode%','% | clip%','% > %','%>>%','%Invoke-WebRequest%','%curl %','%wget %','%scp %','%nc %') OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Get-Content%','%gc %','%-enc%','%-EncodedCommand%','%IEX%','%Invoke-Expression%')) OR (""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\psexesvc.exe','%\wmiprvse.exe','%\cmd.exe','%\powershell.exe','%\httpd.exe','%\php-cgi.exe')) AND (""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%'))) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\aws.exe','%\az.cmd','%\az.exe','%\gcloud.cmd','%\gcloud.exe','%\docker.exe')) AND ""Parent Filename"" ILIKE '%\explorer.exe' AND "username" ILIKE '%NT AUTHORITY%') AND NOT (""Parent Filename"" ILIKE ENUMERATION('%jenkins%','%azuredevops%','%gitlab-runner%','%teamcity%'))
