Image IN ("*\\aws.exe", "*\\az.exe", "*\\doctl.exe", "*\\gcloud.exe") OR CommandLine IN ("*authorize-security-group-ingress*", "*add-metadata*", "*vm user set*", "*instance-templates create*", "*network-security-groups rule create*") OR Image IN ("*\\chisel.exe", "*\\frpc.exe", "*\\gost.exe", "*\\nps.exe") OR CommandLine IN ("* client *", "* -secret *", "* -proxy *", "* R:*") NOT (User IN ("*svc_terraform*", "*svc_ansible*", "*adm_cloud_infra*") OR Image IN ("*\\Terraform\\*", "*\\Ansible\\*")) NOT (CommandLine IN ("*sandbox*", "*test-env*", "*127.0.0.1*")) NOT (ParentImage="*\\explorer.exe" condition="not selection_vps_control")
