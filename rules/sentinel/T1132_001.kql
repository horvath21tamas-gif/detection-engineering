DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*TVqQA*", "*TVpQA*", "*f0VMR*", "*UEsDB*")) or ((ProcessCommandLine in ("*FromBase64String(*", "* -decode *", "*[System.Convert]::*", "*IO.MemoryStream*", "*DeflateStream*")) and ProcessCommandLine matches regex "(?i).*[a-z0-9+/=]{1500,}.*")) and (((FolderPath in ("*\winword.exe", "*\excel.exe", "*\w3wp.exe", "*\sqlservr.exe", "*\spoolsv.exe")) or (ParentProcessName in ("*\outlook.exe", "*\chrome.exe"))) or (not ((FolderPath in ("*\Program Files\*", "*\ccm\*", "*\AzureConnectedMachineAgent\*")) or (ProcessCommandLine in ("*Chocolatey*", "*NuGet*", "*Microsoft.Cloud.Data*")) or User =~ "NT AUTHORITY\SYSTEM")))