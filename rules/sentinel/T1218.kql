DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\rundll32.exe", "*\regsvr32.exe", "*\msiexec.exe", "*\installutil.exe", "*\mshta.exe", "*\control.exe", "*\cmstp.exe", "*\odbcconf.exe", "*\hh.exe")) and (OriginalFileName in ("rundll32.exe", "regsvr32.exe", "msiexec.exe", "installutil.exe", "mshta.exe", "control.exe", "cmstp.exe", "odbcconf.exe", "hh.exe"))) and (IntegrityLevel in ("Low", "Medium")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\brave.exe", "*\sqlservr.exe", "*\w3wp.exe", "*\pwsh.exe", "*\powershell.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe")) or (ProcessCommandLine in ("*http://*", "*https://*", "*ftp://*", "*javascript:*", "*vbscript:*", "*scrobj.dll*", "*ms-its:*", "*its:*", "*mk:@MSITStore*", "*.txt*", "*.dat*", "*.inf*", "*.dll*", "*.png*", "*.jpg*", "*.tmp*")) or (ProcessCommandLine in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Downloads\*", "*\Temp\*", "*\PerfLogs\*")) or (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*"))) and (not ((username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("C:\Windows\System32\svchost.exe*", "C:\Windows\CCM\CcmExec.exe*", "C:\Program Files\Microsoft.Management\Services.IntuneWindowsAgent.exe*")) and ProcessCommandLine contains "C:\Windows\Installer\") or (ParentProcessName endswith "\explorer.exe" and (FolderPath in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*")) and IntegrityLevel =~ "High")))