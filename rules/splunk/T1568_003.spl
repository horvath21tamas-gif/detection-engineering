CommandLine IN ("* -querytype TXT*", "* -q TXT*", "*Resolve-DnsName*", "* -Type TXT*") CommandLine IN ("*[Convert]::*", "* -bxor*", "*.Substring(*", "*.Split(*", "* [int]*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe") NOT (CommandLine IN ("*_vlmcs._tcp*", "*chocolatey*", "*domain-verification*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
