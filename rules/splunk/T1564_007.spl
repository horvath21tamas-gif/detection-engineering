CommandLine IN ("*VBAWarnings*", "*AccessVBOM*", "*ExtensionHardness*", "*TrustRecords*") OR Image IN ("*\\scrcons.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe") OR CommandLine IN ("*ExecuteExcel4Macro*", "*VBAProject.bin*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe") OR NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\Windows\\System32\\svchost.exe*", "*\\Windows\\CCM\\CcmExec.exe*") OR CommandLine IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*"))
