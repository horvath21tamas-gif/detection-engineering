DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\wevtutil.exe" or (ProcessCommandLine in ("*Get-WinEvent*", "*Get-EventLog*", "*enum-logs*", "*el *"))) and ((ProcessCommandLine in ("* -ListLog *", "* get-log *", "* /f:json*", "*ConvertTo-Json*", "* > *")) or ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe")) and IntegrityLevel =~ "Medium")) and (not (User =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Program Files\SplunkUniversalForwarder\*", "*\Program Files\Elastic\Agent\*", "*\Windows\System32\CcmExec.exe*")) and ProcessCommandLine contains "Get-WinEvent -FilterHashtable"))