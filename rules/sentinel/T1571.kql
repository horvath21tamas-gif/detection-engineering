DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\rundll32.exe", "*\mshta.exe", "*\regsvr32.exe", "*\certutil.exe", "*\scrcons.exe", "*\bitsadmin.exe")) and (not (RemotePort in (53, 80, 443, 8080, 8443, 5985, 5986))) and (not (RemoteIP in ("10.*", "192.168.*", "172.16.*", "172.17.*", "172.18.*", "172.19.*", "172.2*", "172.3*", "127.*", "169.254.*"))) and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or User =~ "NT AUTHORITY\SYSTEM"))