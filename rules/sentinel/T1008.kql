DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*try{*", "*}catch{*", "*ErrorAction SilentlyContinue*", "*ErrorAction 0*", "*trap{*")) and (ProcessCommandLine in ("*Resolve-DnsName*", "*nslookup*", "*Net.Sockets.TcpClient*", "*System.Net.WebClient*", "*raw.githubusercontent.com*", "*DownloadString*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe")) and (not ((ProcessCommandLine in ("*C:\Program Files\*", "*Microsoft\Azure*", "*WindowsUpdate*", "*Chocolatey*")) or username =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))