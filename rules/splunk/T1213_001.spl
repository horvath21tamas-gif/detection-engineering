CommandLine IN ("*/rest/api/space*", "*/rest/api/content*", "*/doexportpage.action*", "*/exportword*", "*pages/viewpage.action*pageId=*", "*/pages/exportpdf.action*", "*/pages/exportword.action*") Image IN ("*\\curl.exe", "*\\wget.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\python.exe", "*\\confluence-cli.exe", "*\\node.exe", "*\\java.exe") (ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\winword.exe", "*\\excel.exe", "*\\rundll32.exe", "*\\cmd.exe", "*\\taskhostw.exe") IntegrityLevel IN ("Medium", "High")) OR CommandLine IN ("* > *", "* -OutFile *", "* -o *", "*\\Users\\Public\\*", "*\\Temp\\*", "*\\AppData\\Local\\Temp\\*") NOT (Image IN ("*C:\\Program Files\\Atlassian\\*", "*C:\\Program Files (x86)\\Atlassian\\*") OR User IN ("NT AUTHORITY\\SYSTEM*", "DOMAIN\\svc_*", "DOMAIN\\backup_*") OR CommandLine IN ("*confluence-healthcheck*", "*inventory-agent*", "*--version*", "*-help*")) | table User,Image,ParentImage,CommandLine,IntegrityLevel,CurrentDirectory,Hashes
