SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('%--privileged%','%--cap-add=SYS_ADMIN%','%--cap-add=SYS_PTRACE%','%--pid=host%','%--net=host%','%--ipc=host%') OR ""Process CommandLine"" ILIKE ENUMERATION('%-v /:/%','%/var/run/docker.sock%','%/run/containerd%','%/etc/kubernetes%','%/root/.ssh%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%kube-proxy%','%calico/node%','%cilium%','%datadog/agent%','%node-exporter%','%istio-proxy%')) AND "username"='root')
