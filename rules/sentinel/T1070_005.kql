DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\net.exe", "*\net1.exe")) and (ProcessCommandLine in ("*", "* /y*", "* /yes*"))) or ((FolderPath endswith "\cmdkey.exe" and ProcessCommandLine contains " /delete") or (FolderPath endswith "\vaultcmd.exe" and ProcessCommandLine contains " /delete"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\chrome.exe", "*\msedge.exe", "*\outlook.exe", "*\w3wp.exe", "*\powershell.exe", "*\cmd.exe")) or (not ((User startswith "NT AUTHORITY\" and ParentProcessName endswith "\services.exe") or ParentProcessName endswith "\explorer.exe" or (ProcessCommandLine in ("*logon.bat*", "*netlogon*", "*gpo*", "*group policy*")))))