DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\aws.exe", "*\az.cmd", "*\gcloud.cmd")) and (ProcessCommandLine in ("*ec2 describe-instances*", "*s3 ls*", "*rds describe-db-instances*", "*ec2 describe-security-groups*", "*vm list*", "*storage account list*", "*network vnet list*", "*compute instances list*")) and ((ProcessCommandLine in ("*--query*", "*--output json*", "* | jq*", "* | base64*", "* > *")) or (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\httpd.exe"))) and (not ((ParentProcessName in ("*\Jenkins\*", "*\GitLab-Runner\*", "*\Terraform\*", "*\Ansible\*")) and username =~ "NT AUTHORITY\SYSTEM"))