CommandLine IN ("*\\\\*", "*net use*", "*dir /s /b*", "*Get-ChildItem -Recurse*", "*robocopy*", "*findstr /s /i*") CommandLine IN ("* > *", "* -OutFile *", "*Compress-Archive*", "*7z.exe a*", "*tar.exe -c*") OR CommandLine IN ("*.kdbx*", "*.xlsx*", "*.pdf*", "*id_rsa*", "*password*", "*confidential*") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\w3wp.exe", "*\\httpd.exe", "*\\rundll32.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\Veritas\\*", "*C:\\Program Files\\Commvault\\*", "*C:\\Windows\\CCM\\*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine="*SoftwareDistribution*")
