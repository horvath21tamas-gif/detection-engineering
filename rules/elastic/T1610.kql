(Image:(*\/docker OR *\/kubectl OR *\/podman OR *\/crictl)) AND (CommandLine:(*\ run\ * OR *\ apply\ * OR *\ create\ *)) AND (((CommandLine:(*\ \-\-privileged* OR *\ \-\-cap\-add\=SYS_ADMIN* OR *\ \-\-cap\-add\=ALL*)) OR (CommandLine:(*\ \-\-network\=host* OR *\ \-\-pid\=host* OR *\ \-\-ipc\=host*)) OR (CommandLine:(*\-v\ \/var\/run\/docker.sock* OR *\-v\ \/\:\/host* OR *\-v\ \/etc\/shadow*))) OR (CommandLine:(*docker.io\/* OR *quay.io\/* OR *ghcr.io\/* OR *bitnami\/*))) AND (NOT ((username:(terraform OR ansible\-runner OR kube\-system)) OR (CommandLine:(*my\-company.azurecr.io* OR *internal\-registry.local*))))
