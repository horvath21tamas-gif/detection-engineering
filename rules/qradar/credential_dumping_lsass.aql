SELECT UTF8(payload) as search_payload from events where "TargetImage" LIKE '%\lsass.exe' AND (("Granted Access" LIKE '%0x10%' OR "Granted Access" LIKE '%0x30%' OR "Granted Access" LIKE '%0x50%' OR "Granted Access" LIKE '%0x1fffff%')) AND (("Filename" LIKE '%\procdump.exe%' OR "Filename" LIKE '%\rundll32.exe%' OR "Filename" LIKE '%\taskmgr.exe%'))
