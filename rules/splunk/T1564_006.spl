Image IN ("*\\docker.exe", "*\\dockerd.exe", "*\\VBoxManage.exe", "*\\VBoxHeadless.exe", "*\\vmrun.exe", "*\\vmware-kvm.exe", "*\\vboxmanage.exe", "*\\qemu-system-x86_64.exe") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe", "*\\php-cgi.exe", "*\\httpd.exe", "*\\nginx.exe", "*\\mshta.exe", "*\\powershell.exe", "*\\cmd.exe") OR (CommandLine IN ("*--rm*", "*--privileged*", "*--net=host*", "*--entrypoint*", "*--device*", "*nogui*", "*startvm*", "* -it *", "*--detach*") NOT (ParentImage IN ("*\\Common7\\IDE\\devenv.exe*", "*\\bin\\code.exe*", "*\\Program Files\\Docker\\*", "*\\Program Files\\VMware\\*", "*\\Program Files\\VirtualBox\\*") OR CommandLine IN ("*docker-desktop*", "*docker-compose*", "*minikube*", "*vagrant*"))) | table Time,SourceImage,ParentImage,CommandLine,SourceUsername
