SELECT username, "Filename", "Parent Filename", Process "Process CommandLine", Hostname from events where (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wmic.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%systeminfo%','%hostname%','%whoami%','%wmic os%','%wmic computersystem%','%wmic bios%','%Get-ComputerInfo%','%Get-CimInstance%','%Get-WmiObject%','%ver%','%echo %PROCESSOR_ARCHITECTURE%%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%&%','%&&%','%;%','%|%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\explorer.exe','%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\mshta.exe','%\rundll32.exe','%\wscript.exe','%\cscript.exe')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\SCCM\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\TanService\%','%\CarbonBlack\%','%\CrowdStrike\%','%\Defender\%'))
