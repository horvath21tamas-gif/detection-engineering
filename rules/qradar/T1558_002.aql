SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE '%kerberos::golden%' AND "Process "Process CommandLine"" ILIKE '%/service:%' OR ""Filename"" ILIKE '%\rubeus.exe' AND "Process "Process CommandLine"" ILIKE '%silver%' AND "Process "Process CommandLine"" ILIKE '%/service:%' OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%/service:cifs%','%/service:http%','%/service:mssql%','%/service:ldap%','%/spn:cifs/%','%/spn:http/%','%/spn:mssql%','%/spn:ldap%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/rc4:%','%/aes128:%','%/aes256:%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/sid:%','%S-1-5-21-%'))) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/ptt%','%kerberos::ptt%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wsmprovhost.exe','%\wmiprvse.exe','%\psexesvc.exe','%\httpd.exe','%\w3wp.exe','%\mshta.exe','%\rundll32.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe'))) AND NOT (""Filename"" ILIKE ENUMERATION('%\Microsoft Monitoring Agent\%','%\Azure\%','%\RSAT\%'))
