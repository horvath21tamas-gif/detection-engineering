DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*csproduct get uuid*", "*diskdrive get serialnumber*", "*bios get serialnumber*", "*MachineGuid*")) or (ProcessCommandLine in ("*get-adpdmomainsid*", "*objectSid*", "*machineObjectGuid*"))) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) or (ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\winword.exe", "*\excel.exe"))) and (not (User =~ "NT AUTHORITY\SYSTEM" or (FolderPath in ("*\Windows\System32\wbem\WmiPrvSE.exe*", "*\Windows\System32\svchost.exe*", "*\Program Files\Microsoft Monitoring Agent\*", "*\Program Files\Tanium\*", "*\Program Files (x86)\Kaspersky Lab\*")) or (ProcessCommandLine in ("*InTune*", "*AzureAD*"))))