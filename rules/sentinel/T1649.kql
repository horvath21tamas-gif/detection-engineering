DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*crypto::export*", "*crypto::certificates*", "*crypto::capi*", "*sekurlsa::crypto*", "*certificates /export*", "*find-certificate*", "*Certify.exe*", "*SharpDPAPI*")) or ["*"] contains "selection_certutil_binary and selection_certutil_export_flags" or ["*"] contains "selection_powershell_binary and selection_ps_certificate_export") and (ProcessCommandLine in ("*.pfx*", "*.p12*", "*.p7b*", "*\Users\Public\*", "*\AppData\Local\Temp\*", "*\ProgramData\*", "*C:\PerfLogs\*")) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\psexesvc.exe", "*\rundll32.exe", "*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\httpd.exe", "*\w3wp.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*")) or IntegrityLevel =~ "Medium") and (not (User in ("NT AUTHORITY\*", "NT SERVICE\*"))) and (not ParentProcessName endswith "\msiexec.exe") and (not (FolderPath in ("C:\Program Files\*", "C:\Program Files (x86)\*")))