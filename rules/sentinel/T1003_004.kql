DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath endswith "\reg.exe" and ProcessCommandLine contains "hklm\security") or (FolderPath endswith "\powershell.exe" and ProcessCommandLine contains "SECURITY")) or (ProcessCommandLine in ("*lsadump*", "*secretsdump*", "*dump-lsa*", "*Get-LSASecrets*", "*cachedump*"))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\psexesvc.exe", "*\wmiprvse.exe", "*\httpd.exe")) or (ProcessCommandLine in ("*.tmp*", "*.log*", "*.txt*", "*C:\Users\Public\*", "*C:\Windows\Temp\*", "*C:\PerfLogs\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\services.exe", "*\msiexec.exe")) and (FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*"))))