DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*.kdbx*", "*.opvault*", "*.agilekeychain*", "*vault.db*", "*key3.db*", "*key4.db*")) and (((ProcessCommandLine in ("*copy *", "*type *", "*7z*", "*rar*", "*zip*", "*esentutl*")) or FolderPath endswith "\sqlite3.exe") or ((FolderPath in ("*\Users\*", "*\AppData\Local\Temp\*", "*\Public\*")) and (FolderPath in ("*\powershell.exe", "*\cmd.exe", "*\python.exe")))) and (not (((FolderPath in ("*\Program Files\KeePass*", "*\Program Files\1Password*", "*\Program Files\Bitwarden*")) and (ParentProcessName in ("*\services.exe", "*\svchost.exe")) and username =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\OneDrive.exe", "*\Dropbox.exe"))))