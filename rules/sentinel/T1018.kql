DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\nltest.exe", "*\nslookup.exe", "*\net.exe", "*\net1.exe", "*\arp.exe", "*\qwinsta.exe")) or (ProcessCommandLine in ("*Get-ADComputer*", "*Get-DomainController*", "*Get-NetComputer*"))) and ((ProcessCommandLine in ("*/dclist:*", "*/dsgetdc:*", "*/domain_trusts*", "*view /domain*", "*-type=SRV*", "*_ldap._tcp*")) or (ProcessCommandLine in ("*ConvertTo-Json*", "*Export-Csv*", "* > *", "*for /L*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe", "*\powershell.exe")) and IntegrityLevel =~ "Medium")) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\svchost.exe", "*\CcmExec.exe", "*\msiexec.exe")) or (ProcessCommandLine in ("*Program Files*", "*nslookup -q=srv*"))))