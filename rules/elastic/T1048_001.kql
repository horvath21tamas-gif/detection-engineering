(process.executable:(*\\pscp.exe OR *\\psftp.exe OR *\\scp.exe OR *\\sftp.exe OR *\\rclone.exe OR *\\winscp.com)) AND ((process.command_line:(*\ \-pw\ * OR *\ \-batch* OR *\ \-hostkey\ * OR *\ \-ls\ * OR *copy* OR *sync*)) OR ((process.executable:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Public\\*)) OR (process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\powershell.exe)))) AND (NOT ((process.executable:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) OR (process.command_line:(*127.0.0.1* OR *localhost*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR process.parent.executable:*\\services.exe))
