DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (GrantedAccess in ("0x1410", "0x1411", "0x1438", "0x143a", "0x1F1FFF")) and CallTrace contains "unknown" and (TargetImage in ("*\lsass.exe", "*\svchost.exe", "*\explorer.exe", "*\winlogon.exe", "*\spoolsv.exe", "*\runtimebroker.exe")) and (not (SourceImage =~ "C:\Windows\System32\csrss.exe" or (SourceImage in ("*\MsMpEng.exe", "*\CcmExec.exe")) or (CallTrace in ("*clr.dll+*", "*wer.dll+*", "*ntdll.dll+LdrpWorkItem*")) or condition =~ "selection_source_equals_target"))