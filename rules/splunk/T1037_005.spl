TargetFilename IN ("/Library/StartupItems/*", "/System/Library/StartupItems/*") Image IN ("*/bash", "*/sh", "*/zsh", "*/python", "*/python3", "*/perl", "*/curl", "*/wget", "*/nc") OR TargetFilename IN ("*.sh", "*.py", "*.pl", "*.php") NOT ((Image IN ("*/installd", "*/systempreferences", "*/softwareupdated", "*/package_script_service") username="root") OR Image IN ("*/jamf*", "*/kandji*", "*/managedclient*"))
