DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\netstat.exe", "*\nmap.exe", "*\portqry.exe", "*\telnet.exe", "*\powershell.exe", "*\pwsh.exe")) and ((ProcessCommandLine in ("*foreach*", "*for /L*", "*1..254*", "*Test-NetConnection*", "*System.Net.Sockets.TcpClient*")) or ((ProcessCommandLine in ("*-Port 445*", "*-Port 3389*", "*-Port 5985*", "*-Port 22*", "*-Port 80*")) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\winword.exe", "*\httpd.exe")) and IntegrityLevel =~ "Medium"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (FolderPath in ("*\Program Files\Zabbix\*", "*\Program Files\Tanium\*", "*\Windows\System32\wbem\wmiprvse.exe*"))))