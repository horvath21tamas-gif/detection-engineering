(process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\mshta.exe OR *\\cscript.exe OR *\\wscript.exe)) AND (process.command_line:(*\ \-w\ h* OR *\ \-window\ h* OR *\ \-win\ h* OR *\ \-wind\ h* OR *showwindow\=0* OR *windowstyle\ 1* OR *sw_hide*)) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\chrome.exe OR *\\msedge.exe OR *\\acrord32.exe OR *\\sqlservr.exe OR *\\w3wp.exe)) OR (process.command_line:(*\ \-enc* OR *\ \-e\ * OR *\ \-nop* OR *\ \-noni* OR *iex* OR *downloadstring* OR *frombase64string*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\Windows\\System32\\ServerManager.exe* OR *\\Configuration\ Manager\\* OR *\\HealthService.exe*)) OR (process.command_line:(*Chocolatey* OR *Splunk* OR *Logitech*))))
