SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\mountvol.exe','%\bcdedit.exe') OR ("ImageName" LIKE '%mountvol.exe%' OR "ImageName" LIKE '%bcdedit.exe%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% /s%','%nointegritychecks%','%testsigning%','%loadoptions DDISABLE_INTEGRITY_CHECKS%','%path \EFI\%','%recoveryenabled no%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\psexec.exe','%\python.exe')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\Temp\%')) AND NOT (""Parent Filename"" ILIKE '%\svchost.exe' OR ""Filename"" ILIKE '%C:\Windows\System32\SystemSettingsAdminFlows.exe%' OR "Process "Process CommandLine"" ILIKE '%recoverysequence%')
