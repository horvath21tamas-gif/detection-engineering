Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\move.exe", "*\\copy.exe", "*\\xcopy.exe", "*\\robocopy.exe") CommandLine IN ("*move *", "*copy *", "*echo *", "*Set-Content*", "*replace*") CommandLine IN ("*\\inetpub\\wwwroot\\*", "*\\var\\www\\*", "*\\htdocs\\*", "*\\WordPress\\*") ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\php-cgi.exe", "*\\nginx.exe", "*\\rundll32.exe") OR Image="*\\Temp\\*" NOT (CommandLine IN ("*deploy*", "*Jenkins*", "*AzureDevOps*", "*site_update*") OR ParentImage="*\\msiexec.exe" OR username="NT AUTHORITY\\SYSTEM")
