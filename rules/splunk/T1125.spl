CommandLine IN ("*avicap32.dll*", "*capCreateCaptureWindow*", "*ksuser.dll*", "*mfplat.dll*", "*Windows.Media.Capture*") OR Image IN ("*\\ffmpeg.exe", "*\\vlc.exe") OR CommandLine IN ("*-dshow*", "*-f dshow*", "*-video_size*", "*capture*") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\w3wp.exe", "*\\rundll32.exe", "*\\regsvr32.exe") IntegrityLevel="Medium" NOT (Image IN ("*\\Microsoft Teams\\*", "*\\Zoom.exe*", "*\\Webex.exe*", "*\\Slack.exe*", "*C:\\Windows\\System32\\CameraSettingsUIHost.exe*") OR CommandLine="*skype.exe*" OR username="NT AUTHORITY\\SYSTEM")
