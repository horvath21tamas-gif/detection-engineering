DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\msiexec.exe" and OriginalFileName =~ "msiexec.exe") and (IntegrityLevel in ("Low", "Medium")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*")) or (ProcessCommandLine in ("*http://*", "*https://*", "*ftp://*")) or ((ProcessCommandLine in ("* /q*", "* /quiet*", "* /qn*", "* /i *", "* /package *", "* /update *", "* /p *", "* /y *", "* /z *")) and ((ProcessCommandLine in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Downloads\*", "*\Temp\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe", "*\chrome.exe", "*\msedge.exe", "*\brave.exe"))))) and (not ((FolderPath in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*")) and ((ParentProcessName in ("*\ccmexec.exe", "*\intunemanagementextension.exe", "*\msiexec.exe", "*\svchost.exe")) and IntegrityLevel =~ "High"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and ParentProcessName endswith "\trustedinstaller.exe"))