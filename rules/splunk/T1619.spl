Image IN ("*\\aws.exe", "*\\az.cmd", "*\\gcloud.cmd", "*\\gsutil.py", "*\\rclone.exe") CommandLine IN ("*s3 ls*", "*s3api list-objects*", "*s3api list-object-versions*", "*storage blob list*", "*storage container list*", "*storage ls*", "*storage objects list*", "*ls -R*") CommandLine IN ("*--recursive*", "*--query*", "*--output json*", "* | jq*", "* > *", "*| Out-File*", "*base64*") OR ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wsmprovhost.exe", "*\\httpd.exe", "*\\taskeng.exe") OR Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Temp\\*", "*\\ProgramData\\*") NOT (ParentImage IN ("*\\Veeam\\*", "*\\Commvault\\*", "*\\terraform.exe*", "*\\azcopy.exe*", "*\\rclone.exe*") User IN ("NT AUTHORITY\\*", "SYSTEM*", "svc-backup*", "svc-automation*")) NOT (User IN ("*cloudadmin*", "*svc-cloudops*", "*svc-storage*"))
