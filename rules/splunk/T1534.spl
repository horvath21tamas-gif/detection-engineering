(ParentImage="*\\outlook.exe" Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\rundll32.exe", "*\\mshta.exe") CommandLine IN ("* /a *", "* /c ipm.note*", "* /m *", "*outlook.application*") OR CommandLine IN ("*.iso*", "*.vhd*", "*.img*", "*.htm*", "*.html*", "*.lnk*", "*.zip*", "*\\*")) OR (ParentImage IN ("*\\browser.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe", "*\\httpd.exe", "*\\php-cgi.exe", "*\\explorer.exe /embedding") NOT (CommandLine IN ("*C:\\Program Files\\Microsoft Office*", "*Adobe\\Acrobat*", "*Salesforce*", "*Zoom*", "*Teams*") User="NT AUTHORITY\\*" Image IN ("*\\conhost.exe", "*\\explorer.exe")))
