SELECT UTF8(payload) as search_payload from events where "type"='SYSCALL' AND "syscall"='ptrace' AND (("a0" LIKE '%0x4%' OR "a0" LIKE '%0x5%' OR "a0" LIKE '%0x10%')) AND (("exe" LIKE '%/bin/python%' OR "exe" LIKE '%/bin/php%' OR "exe" LIKE '%/bin/perl%' OR "exe" LIKE '%/bin/node%' OR "exe" LIKE '%/usr/sbin/nginx%' OR "exe" LIKE '%/usr/sbin/apache%' OR "exe" LIKE '%/usr/bin/socat%' OR "exe" LIKE '%/usr/bin/nc%') OR NOT ((("exe" LIKE '%/usr/bin/gdb%' OR "exe" LIKE '%/usr/bin/strace%' OR "exe" LIKE '%/usr/bin/ltrace%' OR "exe" LIKE '%/usr/bin/auditd%' OR "exe" LIKE '%/opt/datadog/agent%')) AND "auid"='4294967295'))
