processcommandline IN ("(*i)([\\s\\t,;]{50,})", "(*i)(set\\s+[a-z0-9]{1,3}=\\s*[^&]{1,5}&[\\s\\t]*){8,}", "(*i)([\\%\\!\\^\\`]{3,}.*){5,}") Image IN ("*\\powershell.exe", "*\\cmd.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\mshta.exe", "*\\rundll32.exe") NOT (Image IN ("*\\Windows\\System32\\wbem\\WmiPrvSE.exe*", "*\\Program Files\\*", "*\\Windows\\System32\\msiexec.exe*") CommandLine IN ("*Microsoft.Cloud.Data*", "*chocolatey*") username="NT AUTHORITY\\SYSTEM")
