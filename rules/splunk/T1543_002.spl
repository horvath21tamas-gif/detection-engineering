TargetFilename IN ("*/etc/systemd/system/*", "*/usr/lib/systemd/system/*", "*/lib/systemd/system/*", "*/.config/systemd/user/*") TargetFilename="*.service" Image IN ("*/bash", "*/sh", "*/zsh", "*/python3", "*/perl", "*/curl", "*/wget", "*/nc", "*/php") OR CommandLine IN ("*ExecStart=/tmp/*", "*ExecStart=/dev/shm/*", "*ExecStart=/var/tmp/*", "*ExecStart=python*", "*ExecStart=perl*") NOT (ParentImage IN ("*/ansible-playbook", "*/chef-client", "*/salt-minion", "*/puppet", "*/dpkg", "*/apt-get", "*/dnf", "*/yum") username="root")
