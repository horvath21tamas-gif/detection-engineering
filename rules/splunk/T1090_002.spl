CommandLine IN ("*proxy-user=*", "*proxy-password=*", "*http-proxy-user=*", "*https-proxy-pass=*", "* -U *", "* -P *") OR (CommandLine IN ("*--proxy-pac-url=*", "*--proxy-server=http*", "* -setproxy *", "* -proxybaseurl:*") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cscript.exe", "*\\wscript.exe") Image IN ("*\\certutil.exe", "*\\bitsadmin.exe", "*\\curl.exe", "*\\rundll32.exe", "*\\regsvr32.exe")) NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*localhost*", "*127.0.0.1*", "*microsoft.com*", "*windowsupdate*") OR username="NT AUTHORITY\\SYSTEM")
