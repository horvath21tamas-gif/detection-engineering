SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/systemctl','%/systemd-analyze')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/tmp/%','%/var/tmp/%','%/dev/shm/%','%/home/%','%/root/%','%/dev/tcp/%') OR ""Process CommandLine"" ILIKE ENUMERATION('%ExecStart=%','%Restart=always%','%base64%','%curl%','%wget%') OR ""Parent Filename"" ILIKE ENUMERATION('%/bash','%/sh','%/zsh','%/python','%/apache2','%/nginx','%/php')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/ansible','%/salt-minion','%/puppet','%/chef-client','%/dpkg','%/apt','%/yum','%/dnf') OR "username"='root' AND ""Process CommandLine"" ILIKE '%daemon-reload%')
