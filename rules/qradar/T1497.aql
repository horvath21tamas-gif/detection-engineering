SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\Local\Temp\%','%\Downloads\%','%\Public\%','%\PerfLogs\%')) AND (("Process "Process CommandLine"" ILIKE ENUMERATION('%Win32_BIOS%','%Win32_ComputerSystem%','%Win32_BaseBoard%','%Win32_DiskDrive%','%Win32_VideoController%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%VMware%','%VBOX%','%VirtualBox%','%QEMU%','%Hyper-V%','%Parallels%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%timeout /t%','%ping 127.0.0.1 -n%','%choice /c y /n /t%')) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\System32\wbem\WmiPrvSE.exe%','C:\Program Files\Microsoft Configuration Manager\%','C:\Program Files (x86)\%')) AND ""Parent Filename"" ILIKE '%\svchost.exe')
