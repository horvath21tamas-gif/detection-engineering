CommandLine IN ("*$false*", "*$null*", "* /dev/null*") OR CommandLine IN ("*HistoryBufferSize*", "*0*") OR CommandLine="*reg*" OR CommandLine="*Console\\HistoryBufferSize*" OR CommandLine IN ("*Remove-Item*", "*del *", "*rm *") OR CommandLine IN ("*\\ConsoleHost_history.txt*", "*\\.bash_history*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe", "*\\mshta.exe") OR NOT (ParentImage IN ("*\\Common7\\IDE\\devenv.exe*", "*\\Microsoft VS Code\\Code.exe*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine="*AppData\\Local\\Temp\\SDI*")
