SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\reg.exe','%\powershell.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\schtasks.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Microsoft\Windows\CurrentVersion\Run%','%\Microsoft\Windows\CurrentVersion\RunOnce%','%\Microsoft\Windows\CurrentVersion\RunService%','%\Group Policy\Scripts%','%\Start Menu\Programs\Startup%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\ProgramData\%','%C:\Windows\Temp\%','%http%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Microsoft\Windows\CloudExperienceHost%','%OneDrive.exe%','%Teams.exe%','%AdobeCollabSync.exe%','%GoogleUpdate.exe%'))
