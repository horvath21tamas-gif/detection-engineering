(process.command_line:(*AesManaged* OR *RijndaelManaged* OR *CryptoStream* OR *CreateEncryptor* OR *ICryptoTransform* OR *CreateDecryptor*)) AND (process.command_line:(*Net.Sockets.TcpClient* OR *Net.Sockets.Socket* OR *IO.MemoryStream* OR *NetworkStream*)) AND (process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\mshta.exe OR *\\rundll32.exe)) AND (NOT ((process.command_line:(*C\:\\Program\ Files\\* OR *Microsoft\\Azure* OR *HealthCheck* OR *SoftwareDistribution*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM" OR (process.parent.executable.caseless:(*\\services.exe OR *\\explorer.exe))))
