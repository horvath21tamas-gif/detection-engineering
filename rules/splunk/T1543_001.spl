TargetFilename="*/Library/LaunchAgents/*" TargetFilename="*.plist" Image IN ("*/bash", "*/zsh", "*/sh", "*/python", "*/python3", "*/curl", "*/wget", "*/Safari", "*/Google Chrome", "*/terminal") OR TargetCodeSignature IN ("*unsigned*", "*Developer ID Application:*") NOT (Image IN ("*/installd", "*/package_script_service", "*/softwareupdated", "*/jamf", "*/kandji-agent") username="root")
