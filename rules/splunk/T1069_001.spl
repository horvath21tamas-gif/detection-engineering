Image IN ("*\\net.exe", "*\\net1.exe") CommandLine IN ("*localgroup*", "*Get-LocalGroup*", "*Get-LocalGroupMember*", "*Get-NetLocalGroup*") CommandLine IN ("*Administrators*", "*Remote Desktop Users*", "*Remote Management Users*", "*Power Users*", "*Distributed COM Users*") OR CommandLine IN ("* > *", "*ConvertTo-Json*", "*Export-Csv*", "*findstr*") OR (ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe", "*\\outlook.exe") IntegrityLevel="Medium") NOT (User="NT AUTHORITY\\*" OR ParentImage IN ("*\\Program Files\\Tanium\\*", "*\\Program Files\\Elastic\\Agent\\*", "*\\Windows\\System32\\CcmExec.exe*") OR CommandLine="*Program Files*")
