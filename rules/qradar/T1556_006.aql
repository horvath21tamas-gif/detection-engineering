SELECT UTF8(payload) as search_payload from events where (("operationName" LIKE '%Update user%' OR "operationName" LIKE '%Update mfa registered phone number%' OR "operationName" LIKE '%Add user auth method%' OR "operationName" LIKE '%Admin registered security info%' OR "operationName" LIKE '%User registered security info%')) AND ("result"='success' AND (("userAgent" LIKE '%python%' OR "userAgent" LIKE '%curl%' OR "userAgent" LIKE '%wget%' OR "userAgent" LIKE '%powershell%' OR "userAgent" LIKE '%postman%')) OR "initiatedBy.userPrincipalName" ILIKE '%admin%' AND "targetResources.userPrincipalName" ILIKE '%admin%') AND NOT ("initiatedBy.userPrincipalName" ILIKE '%.onmicrosoft.com' AND "ipAddress"='1.2.3.4' OR "userAgent"='MyTrustedMigrationBot/2.1')
