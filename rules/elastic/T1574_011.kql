registry.path:HKLM\\SYSTEM\\CurrentControlSet\\Services\\* AND (registry.path:(*\\ImagePath OR *\\ServiceDll OR *\\Parameters\\ServiceDll)) AND (winlog.event_data.Details:(*.exe* OR *.dll*)) AND (winlog.event_data.Details:(*\\Users\\* OR *\\ProgramData\\* OR *\\AppData\\* OR *\\Temp\\*)) AND (NOT (winlog.event_data.Details:(*\\Windows\\* OR *\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*))) AND (NOT (process.executable:(*\\Windows\\System32\\services.exe* OR *\\Windows\\System32\\svchost.exe* OR *\\Windows\\System32\\msiexec.exe* OR *\\Windows\\servicing\\*))) AND (NOT (user.name:(*NT\ AUTHORITY\\SYSTEM* OR *NT\ SERVICE\\TrustedInstaller*)))
