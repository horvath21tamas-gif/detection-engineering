((process.command_line:(*ipinfo.io* OR *ifconfig.me* OR *icanhazip.com* OR *api.ipify.org* OR *checkip.amazonaws.com* OR *ip\-api.com*)) OR (process.command_line:(*Keyboard\ Layout\\Preload* OR *Control\ Panel\\International* OR *MUILanguages* OR *GeoID*)) OR (process.command_line:(*Get\-Culture* OR *Get\-WinSystemLocale* OR *Get\-TimeZone*))) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\powerpnt.exe OR *\\outlook.exe OR *\\wsmprovhost.exe OR *\\httpd.exe)) AND winlog.event_data.IntegrityLevel:Medium) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\msiexec.exe OR *\\CcmExec.exe OR *\\svchost.exe)) OR (process.command_line:(*Program\ Files* OR *Splunk*))))
