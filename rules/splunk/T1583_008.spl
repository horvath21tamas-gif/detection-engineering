Image IN ("*\\aws.exe", "*\\az.exe", "*\\gcloud.exe") OR CommandLine IN ("* configure *", "* iam create-user*", "* login --service-principal*", "* account set *", "* organizations create*") OR Image IN ("*\\python.exe", "*\\pwsh.exe") OR (CommandLine="*boto3*" CommandLine="*.aws/credentials*") OR CommandLine IN ("*DefaultAzureCredential*", "*GoogleCredentials*") NOT (User IN ("*svc_jenkins*", "*svc_terraform*", "*gitlab_runner*", "*adm_cloud_deploy*") Image IN ("*\\Program Files\\Terraform\\*", "*\\actions-runner\\*")) NOT (ParentImage IN ("*\\code.exe", "*\\devenv.exe", "*\\idea64.exe")) NOT (ParentImage="*\\explorer.exe" condition="not selection_cloud_bootstrap")
