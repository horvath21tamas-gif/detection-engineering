
| rex field=CommandLine "(?<CommandLineMatch>( /domain| /all| -ComputerName|foreach|\\\\\\\\\\\\\\\\\\*))"
| eval CommandLineCondition=if(isnotnull(CommandLineMatch), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch2>(password|confidential|backup|config|credentials|key))"
| eval CommandLineCondition2=if(isnotnull(CommandLineMatch2), "true", "false")
| rex field=ParentImage "(?<ParentImageMatch>(cmd\\.exe|powershell\\.exe|wsmprovhost\\.exe|httpd\\.exe|winword\\.exe)$)"
| eval ParentImageCondition=if(isnotnull(ParentImageMatch), "true", "false")
| rex field=Image "(?<ImageMatch>(\\\\Program Files\\\\Tanium\\\\|\\\\Program Files\\\\Splunk\\\\|\\\\Windows\\\\System32\\\\CcmExec\\.exe)$)"
| eval ImageCondition=if(isnotnull(ImageMatch), "true", "false")
| rex field=CommandLine "(?<CommandLineMatch3>net share)"
| eval CommandLineCondition3=if(isnotnull(CommandLineMatch3), "true", "false")
| search CommandLineCondition="true" OR CommandLineCondition2="true" OR (ParentImageCondition="true" IntegrityLevel="Medium") NOT (username="NT AUTHORITY\\SYSTEM" OR ImageCondition="true" OR CommandLineCondition3="true")
| regex Image="(Snaffler\\.exe|SharpShares\\.exe|PowerView\\.ps1|net\\.exe|net1\\.exe)$"
| regex CommandLine="(view|Invoke-ShareFinder|Get-NetShare|Find-DomainShare)"
