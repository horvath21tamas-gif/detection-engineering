SELECT UTF8(payload) as search_payload from events where (("Process "Process CommandLine"" ILIKE ENUMERATION('%--dns%','%--gateway%','%--lease%','%--dhcp%','%dhcp-server%','%rogue%','%spoof%')) AND (""Filename"" ILIKE ENUMERATION('%\python.exe','%\pythonw.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Responder%','%bettercap%','%ettercap%','%Inveigh%','%mitm6%')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Downloads\%','%\Public\%')) AND "username" ILIKE 'NT AUTHORITY\%' AND NOT (""Filename"" ILIKE ENUMERATION('C:\Program Files\VMware\%','C:\Program Files (x86)\VMware\%','C:\Program Files\Oracle\VirtualBox\%','C:\Program Files\Docker\%','C:\Program Files\Microsoft\Hyper-V\%') OR ""Filename"" ILIKE '%\System32\svchost.exe' AND "Process "Process CommandLine"" ILIKE '%dhcpssvc%' OR ""Filename"" ILIKE ENUMERATION('%\Program Files\Microsoft Configuration Manager\%','%\Program Files\Wireshark\%','%\Program Files\nmap\%'))
