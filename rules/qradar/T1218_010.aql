SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\regsvr32.exe' AND (("Process CommandLine" LIKE '%/i:%' OR "Process CommandLine" LIKE '%/n%' OR "Process CommandLine" LIKE '%/s%' OR "Process CommandLine" LIKE '%scrobj.dll%' OR "Process CommandLine" LIKE '%.sct%' OR "Process CommandLine" LIKE '%http://%' OR "Process CommandLine" LIKE '%https://%')) AND (("Process CommandLine" LIKE '%\\Users\\%' OR "Process CommandLine" LIKE '%\\AppData\\%' OR "Process CommandLine" LIKE '%\\Temp\\%' OR "Process CommandLine" LIKE '%\\Downloads\\%') OR ("ParentImage" LIKE '%\\powershell.exe%' OR "ParentImage" LIKE '%\\pwsh.exe%' OR "ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\mshta.exe%')) AND NOT (("ParentImage" LIKE '%\\Windows\\Installer\\%' OR "ParentImage" LIKE '%\\Program Files\\%' OR "ParentImage" LIKE '%\\Program Files (x86%')\%','%\Microsoft\EdgeUpdate\%','%\Google\Update\%','%\Adobe\%','%\Mozilla\%','%\Citrix\%') OR ("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%'))
