SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/docker','%/kubectl','%/podman','%/crictl')) AND (""Process CommandLine"" ILIKE ENUMERATION('% run %','% apply %','% create %')) AND (""Process CommandLine"" ILIKE ENUMERATION('% --privileged%','% --cap-add=SYS_ADMIN%','% --cap-add=ALL%') OR ""Process CommandLine"" ILIKE ENUMERATION('% --network=host%','% --pid=host%','% --ipc=host%') OR ""Process CommandLine"" ILIKE ENUMERATION('%-v /var/run/docker.sock%','%-v /:/host%','%-v /etc/shadow%') OR ""Process CommandLine"" ILIKE ENUMERATION('%docker.io/%','%quay.io/%','%ghcr.io/%','%bitnami/%')) AND NOT (("UserName" LIKE '%terraform%' OR "UserName" LIKE '%ansible-runner%' OR "UserName" LIKE '%kube-system%') OR ""Process CommandLine"" ILIKE ENUMERATION('%my-company.azurecr.io%','%internal-registry.local%'))
