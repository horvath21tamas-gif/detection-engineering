DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("* /f /im lsass.exe*", "* /f /im csrss.exe*", "* /f /im wininit.exe*", "* /f /im smss.exe*", "* /f /im services.exe*")) or (ProcessCommandLine in ("*while($true)*", "*for(;;)*", "*::MemoryStream*", "*AllocHGlobal*", "*foreach($i in 1..1gb)*", "*:loop*", "*-Recursive*", "*Get-Random*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\rundll32.exe", "*\httpd.exe", "*\nginx.exe", "*\apache.exe")) and (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*", "*\Downloads\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\CcmExec.exe", "*\msiexec.exe", "*\TiWorker.exe", "*\TrustedInstaller.exe")) and (ProcessCommandLine in ("*HealthCheck*", "*Diagnostic*", "*Update*", "*Patch*", "*Maintenance*"))))