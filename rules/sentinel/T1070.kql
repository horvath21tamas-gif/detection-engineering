DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\wevtutil.exe" and (ProcessCommandLine in ("*Security*", "*System*", "*Setup*", "*PowerShell*"))) or ((FolderPath endswith "\fsutil.exe" and (ProcessCommandLine contains "usn" and ProcessCommandLine contains "deletejournal")) or (ProcessCommandLine in ("*del *", "*Remove-Item*")) or (ProcessCommandLine in ("*\Windows\Prefetch\*", "*\System32\config\Journal*")))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\w3wp.exe", "*\powershell.exe")) or (not ((User =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\services.exe", "*\svchost.exe", "*\msiexec.exe"))) or (ProcessCommandLine in ("*cleanmgr.exe*", "*CCM\Temp*", "*HealthCheck*")))))