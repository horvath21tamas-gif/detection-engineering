DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ParentProcessName in ("*\mmc.exe", "*\excel.exe", "*\outlook.exe", "*\visio.exe", "*\explorer.exe", "*\dcomcnfg.exe", "*\word.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\mshta.exe", "*\rundll32.exe", "*\cscript.exe", "*\wscript.exe", "*\scrcons.exe")) and ((ProcessCommandLine in ("* -enc *", "* -w hidden*", "* -nop*", "* /c *", "*DownloadString*", "*bypass*")) or (ParentProcessCommandLine in ("* /automation*", "* -embedding*")))) and (not ((ProcessCommandLine in ("*C:\Windows\System32\*", "*.msc*")) or ParentProcessCommandLine contains "servermanager.msc" or username =~ "NT AUTHORITY\SYSTEM"))