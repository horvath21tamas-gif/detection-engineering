filename="^[D-Z]:\\.*" TargetFilename IN ("*\\.*", "*\\autorun*", "*:*") TargetFilename IN ("*.dat", "*.bin", "*.lnk", "*.vbs", "*.ps1") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\rundll32.exe", "*\\regsvr32.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\scrcons.exe") NOT (Image IN ("*\\explorer.exe", "*\\msiexec.exe") TargetFilename IN ("*$RECYCLE.BIN*", "*System Volume Information*", "*Found.000*") username="NT AUTHORITY\\SYSTEM")
