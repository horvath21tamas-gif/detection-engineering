SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\odbcconf.exe' AND "ImageName"='odbcconf.exe' AND (("Integrity Level" LIKE '%Low%' OR "Integrity Level" LIKE '%Medium%')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\ProgramData\%') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%REGSVR%','%regsvr%','%/a%','%{REGSVR%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Public\%','%\Downloads\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%http://%','%https://%','%\\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%.txt%','%.dat%','%.png%','%.tmp%','%.inf%') OR ""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe','%\chrome.exe','%\msedge.exe'))) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\System32\%','C:\Windows\SysWOW64\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\trustedinstaller.exe')) AND "Integrity Level"='High') AND NOT "username" ILIKE 'NT AUTHORITY\%'
