Image IN ("*/docker", "*/kubectl", "*/podman", "*/crictl") CommandLine IN ("* run *", "* apply *", "* create *") CommandLine IN ("* --privileged*", "* --cap-add=SYS_ADMIN*", "* --cap-add=ALL*") OR CommandLine IN ("* --network=host*", "* --pid=host*", "* --ipc=host*") OR CommandLine IN ("*-v /var/run/docker.sock*", "*-v /:/host*", "*-v /etc/shadow*") OR CommandLine IN ("*docker.io/*", "*quay.io/*", "*ghcr.io/*", "*bitnami/*") NOT (username IN ("terraform", "ansible-runner", "kube-system") OR CommandLine IN ("*my-company.azurecr.io*", "*internal-registry.local*"))
