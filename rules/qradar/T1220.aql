SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\wmic.exe' AND "Process "Process CommandLine"" ILIKE '%/FORMAT%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%http%','%ftp%','%:\Users\%','%:\ProgramData\%','%\AppData\%','%\Temp\%','%\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%.txt%','%.png%','%.jpg%','%.pdf%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%:\Windows\System32\wbem\%','%:\Windows\SysWOW64\wbem\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%csv.xsl%','%htable.xsl%','%hform.xsl%','%texttable.xsl%','%xml.xsl%'))
