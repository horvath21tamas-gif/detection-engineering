(Image:(*\/az OR *\/aws OR *\/gcloud OR *\/kubectl)) AND ((CommandLine:(*list\-access\-keys* OR *export\-credentials* OR *get\-secret*)) OR (CommandLine:(*stop\-logging* OR *delete\-trail* OR *disable\-policy* OR *delete\-flow\-log*)) OR (CommandLine:(*make\-public* OR *add\-iam\-policy\-binding* OR *modify\-instance\-attribute\ \-\-attribute\ disableApiTermination* OR *create\-presigned\-url*))) AND (NOT ((username:(deployment\-service\-account OR terraform\-runner)) OR (CommandLine:(*\-\-describe* OR *\-\-list*))))
