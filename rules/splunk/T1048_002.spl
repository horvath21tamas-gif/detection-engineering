Image IN ("*\\curl.exe", "*\\wget.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\bitsadmin.exe", "*\\certutil.exe") CommandLine IN ("* -F *", "* --data-binary*", "* -T *", "* -k*", "* --insecure*", "*UploadFile(*", "*PutAsync(*", "*PostAsync(*") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\explorer.exe") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*microsoft.com*", "*office.com*", "*127.0.0.1*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
