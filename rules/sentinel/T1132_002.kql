DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*-bxor*", "*bit.bxor*", "*[char[]]*", "*::FromCharacterCode*", "*.replace(*")) and ProcessCommandLine matches regex "(?i)([`]{2,}.*){2,}") or ((((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe")) or (FolderPath in ("*\rundll32.exe", "*\regsvr32.exe", "*\colorcpl.exe"))) and (ProcessCommandLine in ("*-bxor*", "*bit.bxor*", "*[char[]]*", "*::FromCharacterCode*", "*.replace(*"))) and (not ((ProcessCommandLine in ("*C:\Program Files\*", "*Microsoft\Exchange*", "*Chocolatey*", "*NuGet*")) or User =~ "NT AUTHORITY\SYSTEM")))