SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('% > /tmp/%','% > /var/tmp/%','% > /dev/shm/%','% > /home/%') OR ""Process CommandLine"" ILIKE ENUMERATION('%/etc/shadow%','%/etc/passwd%') OR ""Process CommandLine"" ILIKE '%/etc/shadow%' OR ""Process CommandLine"" ILIKE ENUMERATION('%unshadow %','%mimipenguin%','%linpeas.sh%')) AND NOT ((""Process CommandLine"" ILIKE ENUMERATION('%/usr/sbin/pwconv%','%/usr/sbin/useradd%','%/usr/sbin/usermod%','%logrotate%')) AND ""Parent Filename"" ILIKE '/etc/cron.%')
