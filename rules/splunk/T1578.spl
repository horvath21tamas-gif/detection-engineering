operation_name IN ("*DeleteSnapshot*", "*ModifyInstanceAttribute*", "*RevokeSecurityGroupIngress*", "*AuthorizeSecurityGroupIngress*", "*DeleteVpcPeeringConnection*", "*ModifyNetworkAcl*", "*ModifyImageAttribute*", "*CopySnapshot*", "*SetSnapshotPermissions*") request_parameters IN ("*0.0.0.0/0*", "*::/0*", "*all*", "*public*", "*grantee*", "*Add.UserId*") OR (mfa_authenticated="false" user_agent IN ("*kali*", "*python-requests*", "*curl*", "*postman*", "*boto3*")) NOT (user_name IN ("svc-terraform*", "svc-ansible*", "svc-packer*", "svc-github-actions*") OR user_name IN ("*system-internal*", "*cloud-controller*", "*service-linked-role*")) | table Time,user_name,operation_name,request_parameters,user_agent,mfa_authenticated,resource_id,subscription_id,tenant_id,source_ip
