DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\curl.exe", "*\wget.exe", "*\powershell.exe", "*\pwsh.exe", "*\certutil.exe", "*\bitsadmin.exe")) and (ProcessCommandLine in ("*icanhazip.com*", "*ipinfo.io*", "*api.ipify.org*", "*ifconfig.me*", "*checkip.amazonaws.com*", "*ident.me*", "*ipecho.net*", "*ip-api.com*", "*whatismyip*")) and (((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\cmd.exe")) and IntegrityLevel =~ "Medium") or (ProcessCommandLine in ("*-urlcache*", "*Invoke-WebRequest*", "*iwr *", "*DownloadString*", "*content.asstring*"))) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\svchost.exe", "*\CcmExec.exe", "*\msiexec.exe")) or (ProcessCommandLine in ("*Program Files*", "*node_modules*", "*azcopy*"))))