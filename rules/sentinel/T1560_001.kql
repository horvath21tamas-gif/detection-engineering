DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\7z.exe", "*\7za.exe", "*\winrar.exe", "*\rar.exe", "*\tar.exe", "*\zip.exe")) or (OriginalFileName in ("7z.exe", "7za.exe", "WinRAR.exe", "rar.exe", "tar.exe"))) and ((ProcessCommandLine in ("* -p*", "* -hp*", "* -v*", "* -ta*", "* -sdel*", "* -m0=*")) or (ProcessCommandLine in ("*\Desktop*", "*\Documents*", "*\AppData\Local\Microsoft\Outlook*", "*C:\inetpub\*", "*C:\Users\Public*"))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\w3wp.exe")) and IntegrityLevel =~ "Medium") and (not ((ProcessCommandLine in ("*C:\Program Files\Backup*", "*C:\Windows\Temp\Inv*")) or (ParentProcessName in ("*C:\Program Files\Microsoft Monitoring Agent\*", "*C:\Program Files\Veritas\*")) or User =~ "NT AUTHORITY\SYSTEM"))