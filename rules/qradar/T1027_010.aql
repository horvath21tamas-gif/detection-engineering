SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%^e^%','%^p^%','%^s^%','%^^^%','%"^%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%:~%','%%:%','%!:%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%'+'%','%'-join'%','%[char[]]%','%::Reverse%','%.Replace(%','%bxor%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% -enc %','% -e %','% -encodedcommand %','% FromBase64String%','% IO.Compression%')) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\System32\msiexec.exe%','C:\Program Files\Common Files\Microsoft Shared\%','C:\Windows\System32\wbem\WmiPrvSE.exe%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/package%','%/update%','%Data Source=%')))
