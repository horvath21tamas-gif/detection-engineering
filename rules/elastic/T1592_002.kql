(SrcIp:(1.* OR 2.* OR 3.* OR 4.* OR 5.* OR 6.* OR 7.* OR 8.* OR 9.*)) AND (Method:(GET OR HEAD)) AND (UriStem:(*\/version* OR *\/about* OR *\/status* OR *\/info* OR *\/build* OR *\/debug* OR *\/admin* OR *\/server\-info* OR *\/actuator* OR *\/metrics*)) AND (UriQuery:(*version* OR *build* OR *release* OR *software* OR *application* OR *component* OR *module* OR *plugin* OR *stack*)) AND (UserAgent:(*curl* OR *wget* OR *python* OR *httpclient* OR *go\-http\-client* OR *libwww* OR *scanner* OR *probe*)) AND (Status:(200 OR 401 OR 403 OR 404)) AND (NOT ((UserAgent:(*Mozilla* OR *Chrome* OR *Safari* OR *Firefox* OR *Edge*)) OR (UserAgent:(*nessus* OR *qualys* OR *openvas* OR *acunetix* OR *nikto* OR *nuclei* OR *zap* OR *zabbix* OR *prometheus* OR *uptime* OR *pingdom*)) OR ((UriStem:(*\/api* OR *\/health*)) AND (UriStem:(*.css OR *.js OR *.png OR *.jpg OR *.svg OR *.ico OR *.woff OR *.woff2 OR *.json)))))
