DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*New-InboxRule*", "*Set-InboxRule*", "*Set-MailboxForwardingConfiguration*")) and (((ProcessCommandLine in ("*DeleteMessage*", "*PermanentDelete*", "*MarkAsRead*", "*MoveToFolder*")) and (ProcessCommandLine in ("*Security*", "*Alert*", "*Password*", "*MFA*", "*Sign-in*", "*Phish*", "*Compromise*", "*Unauthorized*"))) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\msedge.exe", "*\chrome.exe", "*\mshta.exe"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*Spam*", "*Junk*", "*Internal-Auto-Forward*")) or ParentProcessName contains "\Windows\System32\svchost.exe"))