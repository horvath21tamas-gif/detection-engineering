DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\python.exe", "*\nircmd.exe", "*\mshta.exe")) and (ProcessCommandLine in ("*Get-Clipboard*", "*Set-Clipboard*", "*Clipboard*", "*System.Windows.Forms.Clipboard*", "*WriteProcessMemory*", "*ReadProcessMemory*", "*SetWindowsHook*", "*Add-Type*")) and (ProcessCommandLine in ("*invoice*", "*payment*", "*bank*", "*iban*", "*swift*", "*account number*", "*.pdf*", "*.xlsx*", "*.csv*")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\iexplore.exe", "*\firefox.exe", "*\rundll32.exe", "*\w3wp.exe", "*\httpd.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\ProgramData\*", "*\Windows\Temp\*"))) and (not (User startswith "NT AUTHORITY\" and (FolderPath in ("C:\Program Files\*", "C:\Program Files (x86)\*")) and (ProcessCommandLine in ("*Backup*", "*Inventory*", "*AccountingService*", "*SignService*"))))