DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (["*"] contains "selection_runas_binary and selection_runas_flags and selection_runas_payload" or ["*"] contains "selection_account_tools and selection_account_creation and selection_deceptive_names") and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\w3wp.exe", "*\rundll32.exe")) or (not ((FolderPath in ("C:\Program Files\*", "C:\Program Files (x86)\*")) and ParentProcessName startswith "C:\Program Files\" and (User in ("NT AUTHORITY\*", "NT SERVICE\*"))))) and (not (ProcessCommandLine in ("*SmartCard*", "*Domain Admins*")))