Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\python.exe", "*\\nircmd.exe", "*\\mshta.exe") CommandLine IN ("*Get-Clipboard*", "*Set-Clipboard*", "*Clipboard*", "*System.Windows.Forms.Clipboard*", "*WriteProcessMemory*", "*ReadProcessMemory*", "*SetWindowsHook*", "*Add-Type*") CommandLine IN ("*invoice*", "*payment*", "*bank*", "*iban*", "*swift*", "*account number*", "*.pdf*", "*.xlsx*", "*.csv*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\iexplore.exe", "*\\firefox.exe", "*\\rundll32.exe", "*\\w3wp.exe", "*\\httpd.exe") OR Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Windows\\Temp\\*") NOT (User="NT AUTHORITY\\*" Image IN ("C:\\Program Files\\*", "C:\\Program Files (x86)\\*") CommandLine IN ("*Backup*", "*Inventory*", "*AccountingService*", "*SignService*"))
