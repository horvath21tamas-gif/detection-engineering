DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\nginx.exe", "*\php-cgi.exe", "*\tomcat.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*index.html*", "*index.php*", "*default.aspx*", "*logo.*", "*echo *", "*move *", "*copy *", "*Set-Content*")) and (ProcessCommandLine in ("*\inetpub\wwwroot\*", "*\var\www\*", "*\htdocs\*")) and (not ((User in ("AD\svc_deploy", "AD\github_actions")) or (ProcessCommandLine in ("*node_modules*", "*npm install*", "*composer install*")) or ParentProcessName endswith "\msiexec.exe"))