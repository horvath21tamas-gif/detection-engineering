Image IN ("*\\sherlock.exe", "*\\theHarvester.exe", "*\\social-analyzer.exe", "*\\photon.exe", "*\\spiderfoot.exe") OR CommandLine IN ("*twint*", "*instagram-scraper*", "*ghunt*") OR (CommandLine IN ("*--headless*", "*--remote-debugging-port*", "*--disable-gpu*", "*webdriver*", "*user-data-dir*") Image IN ("*\\python.exe", "*\\node.exe", "*\\curl.exe") OR CommandLine IN ("*linkedin.com/in/*", "*twitter.com/*", "*facebook.com/*", "*glassdoor.com/Reviews*")) NOT (CommandLine IN ("*--type=utility*", "*--type=gpu-process*", "*--type=renderer*") OR ParentImage IN ("*\\chrome.exe", "*\\msedge.exe")) NOT (User IN ("*hr_user*", "*recruiter*", "*mkt_lead*") CommandLine IN ("*campaign*", "*talent*")) NOT (ParentImage="*\\explorer.exe" condition="not selection_specialized_tools")
