DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (SrcIp in ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*")) and (UriStem in ("*/login*", "*/signin*", "*/auth*", "*/account*", "*/user*", "*/users*", "*/password*", "*/forgot*", "*/reset*")) and (UriQuery in ("*user=*", "*username=*", "*email=*", "*login=*", "*account=*", "*upn=*", "*principal=*")) and (Method in ("GET", "POST")) and (UserAgent in ("*curl*", "*wget*", "*python*", "*go-http-client*", "*httpclient*", "*axios*", "*requests*", "*scanner*", "*probe*")) and (Status in (401, 403, 404)) and (not ((UserAgent in ("*Mozilla*", "*Chrome*", "*Firefox*", "*Safari*", "*Edge*")) or (UriStem in ("*/sso*", "*/oauth*", "*/openid*", "*/saml*", "*/idp*", "*/federation*")) or (UserAgent in ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nuclei*", "*zabbix*", "*prometheus*", "*uptime*", "*pingdom*", "*datadog*", "*newrelic*")) or (UriStem in ("*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.woff", "*.woff2"))))