CommandLine IN ("*System.IO.Compression*", "*Compress-Archive*", "*zipfile*", "*IO.Compression.FileSystem*") CommandLine IN ("* -enc *", "* -e *", "* -DestinationPath *", "* -Update*", "* [Convert]::ToBase64*") OR CommandLine IN ("*\\Desktop*", "*\\Documents*", "*\\AppData\\Local\\Microsoft\\Outlook*", "*C:\\inetpub\\*", "*C:\\Users\\Public*") ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\winword.exe", "*\\cmd.exe", "*\\powershell.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\Microsoft Visual Studio\\*", "*C:\\Program Files\\Azure\\*") OR CommandLine IN ("*C:\\Windows\\CCM\\*", "*C:\\ProgramData\\Microsoft\\Intune\\*") OR username="NT AUTHORITY\\SYSTEM")
