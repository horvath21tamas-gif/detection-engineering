ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\regsvr32.exe") CommandLine IN ("*DDEAUTO*", "*DDE *", "*/c start*", "*http*", "*powershell -e*") NOT (CommandLine IN ("*workbook*", "*dde_link*", "*RTD*") OR ParentImage="*Program Files*")
