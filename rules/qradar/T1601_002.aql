SELECT UTF8(payload) as search_payload from events where (("Message" LIKE '%software install%' OR "Message" LIKE '%request system software add%' OR "Message" LIKE '%firmware upgrade%' OR "Message" LIKE '%boot system flash%' OR "Message" LIKE '%install activate%' OR "Message" LIKE '%request platform software%')) AND (("Message" LIKE '%tftp://%' OR "Message" LIKE '%http://%' OR "Message" LIKE '%ftp://%' OR "Message" LIKE '%.bin%' OR "Message" LIKE '%.tar%') OR ("Message" LIKE '%signature validation failed%' OR "Message" LIKE '%hash mismatch%' OR "Message" LIKE '%invalid image signature%' OR "Message" LIKE '%checksum error%' OR "Message" LIKE '%not a trusted image%')) AND NOT (("SourceIP" LIKE '%10.50.0.10%' OR "SourceIP" LIKE '%10.50.0.11%') OR ("Message" LIKE '%scp://%' OR "Message" LIKE '%https://%' OR "Message" LIKE '%sftp://%'))
