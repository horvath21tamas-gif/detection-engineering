Image IN ("*\\vncviewer.exe", "*\\winvnc.exe", "*\\tvnserver.exe", "*\\uvnc_settings.exe") OR OriginalFileName IN ("vncviewer.exe", "winvnc.exe", "tvnserver.exe") Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\*", "*\\PerfLogs\\*", "*\\*") OR CommandLine IN ("* -connect *", "* -password *", "* -passwd *", "* -nomsgbox*", "* -noauth*", "* -remoterefresh*") OR (ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\psexesvc.exe", "*\\wsmprovhost.exe") IntegrityLevel="System") NOT (Image IN ("*C:\\Program Files\\RealVNC\\*", "*C:\\Program Files\\TightVNC\\*", "*C:\\Program Files\\UltraVNC\\*") OR CommandLine="*service*" OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
