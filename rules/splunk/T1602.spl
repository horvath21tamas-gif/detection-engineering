CommandLine IN ("* -Recurse*", "* /s *", "* -Include *", "* -Filter *", "*robocopy*", "*xcopy*", "*Copy-Item*", "*Copy-File*") CommandLine IN ("*\\\\*", "*net use*", "*net view*", "*New-PSDrive*") CommandLine IN ("*.doc*", "*.docx*", "*.xls*", "*.xlsx*", "*.pdf*", "*.pst*", "*.kdbx*", "*.key*", "*.config*", "*id_rsa*", "*.zip*", "*.7z*", "*.rar*") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\w3wp.exe", "*\\rundll32.exe", "*\\explorer.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\Microsoft System Center\\*", "*C:\\Windows\\CCM\\*", "*C:\\Program Files\\Veritas\\*", "*C:\\Program Files\\Commvault\\*", "*C:\\Program Files\\Veeam\\*") OR CommandLine IN ("*SoftwareDistribution*", "*.log*") OR username="NT AUTHORITY\\SYSTEM") | table CommandLine,ParentImage,User
