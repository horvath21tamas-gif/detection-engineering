Image IN ("*\\aws.exe", "*\\az.exe", "*\\gcloud.exe", "*\\sam.exe", "*\\sls.exe") OR CommandLine IN ("*update-function-configuration*", "*update-function-code*", "*functionapp config set*", "*functions deploy*", "*lambda publish-layer-version*") CommandLine IN ("*--layers*", "*--variables*", "*--environment*", "*--image-uri*", "*--role*") NOT (User IN ("*svc_deploy*", "*svc_pipeline*", "*github_actions*") OR Image IN ("*\\actions-runner\\*", "*\\Jenkins\\*", "*\\AzureDevOps\\*")) NOT (CommandLine IN ("*--stage dev*", "*--stage test*", "*sandbox*", "*local-test*")) NOT (ParentImage="*\\explorer.exe" condition="not selection_high_risk_params")
