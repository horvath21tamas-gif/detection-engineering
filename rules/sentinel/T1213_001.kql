DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*/rest/api/space*", "*/rest/api/content*", "*/doexportpage.action*", "*/exportword*", "*pages/viewpage.action*pageId=*")) and (FolderPath in ("*\curl.exe", "*\wget.exe", "*\powershell.exe", "*\pwsh.exe", "*\python.exe", "*\confluence-cli.exe")) and (((ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe", "*\rundll32.exe")) and IntegrityLevel =~ "Medium") or (ProcessCommandLine in ("* > *", "* -OutFile *", "* -o *", "*\Users\Public\*", "*\Temp\*"))) and (not ((FolderPath in ("*C:\Program Files\Atlassian\*", "*C:\Program Files (x86)\Atlassian\*")) or username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*confluence-healthcheck*", "*inventory-agent*"))))