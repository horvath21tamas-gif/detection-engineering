SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\wmic.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/node:%','%process%','%call%','%create%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%cmd.exe%','%powershell.exe%','%pwsh.exe%','%rundll32.exe%','%mshta.exe%','%regsvr32.exe%','%bitsadmin%','%certutil%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\WINWORD.EXE','%\EXCEL.EXE','%\POWERPNT.EXE')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\SCCM\%','%\Tanium\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Ansible\%','%\SaltStack\%','%\Puppet\%'))
