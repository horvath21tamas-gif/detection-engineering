Image IN ("*\\wscript.exe", "*\\cscript.exe") OR OriginalFileName IN ("wscript.exe", "cscript.exe") CommandLine="*pubprn.vbs*" CommandLine IN ("*script:*", "*http*", "*soap:*", "*\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\powershell.exe") NOT (ParentImage IN ("*\\explorer.exe", "*\\svchost.exe") CommandLine="*127.0.0.1*" username="NT AUTHORITY\\SYSTEM")
