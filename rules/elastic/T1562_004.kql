(process.executable.caseless:*\\netsh.exe OR winlog.event_data.filename:netsh.exe) AND (process.command_line:(*advfirewall* OR *firewall*)) AND (process.command_line:(*add* OR *set*)) AND (process.command_line:(*action\=allow* OR *enable\=yes*)) AND (NOT ((process.parent.executable.caseless:(*\\CcmExec.exe OR *\\msiexec.exe)) AND (process.command_line:(*show* OR *monitor* OR *profile\ state*))))
