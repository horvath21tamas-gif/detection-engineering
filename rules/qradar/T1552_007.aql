SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('%/var/run/secrets/kubernetes.io/serviceaccount%','%/run/secrets/%','%/etc/kubernetes/admin.conf%','%/root/.kube/config%','%.docker/config.json%','%/.aws/credentials%','%/.azure/%','%/.config/gcloud/%') OR ""Process CommandLine"" ILIKE ENUMERATION('%token%','%authorization%','%kubeconfig%','%client-secret%','%access_key%','%secret_key%') OR ""Process CommandLine"" ILIKE ENUMERATION('%env%','%|%') OR ""Process CommandLine"" ILIKE ENUMERATION('%printenv%','%|%') OR ""Process CommandLine"" ILIKE ENUMERATION('%set%','%|%') OR ""Process CommandLine"" ILIKE ENUMERATION('%export%','%|%') OR ""Process CommandLine"" ILIKE ENUMERATION('%cat%','%base64%') OR ""Process CommandLine"" ILIKE ENUMERATION('%cat%','%grep%') OR ""Process CommandLine"" ILIKE ENUMERATION('%xxd%','%hexdump%')) AND ((""Filename"" ILIKE ENUMERATION('%/sh','%/bash','%/dash','%/zsh')) AND (""Process CommandLine"" ILIKE ENUMERATION('%-i%','%-c%')) OR ""Parent Filename"" ILIKE ENUMERATION('%/nginx','%/httpd','%/apache2','%/php-fpm','%/node','%/gunicorn','%/uwsgi') OR ""Parent Filename"" ILIKE ENUMERATION('%kubectl%','%containerd%','%docker%','%cri-o%')) AND NOT ((""Process CommandLine"" ILIKE ENUMERATION('%docker-entrypoint.sh%','%/init.sh%','%/usr/local/bin/start.sh%')) AND (""Filename"" ILIKE ENUMERATION('%/usr/bin/promtail%','%/usr/bin/fluentd%','%/usr/bin/telegraf%','%/pause%')) AND (("UserName" LIKE '%fluentd%' OR "UserName" LIKE '%root%')))
