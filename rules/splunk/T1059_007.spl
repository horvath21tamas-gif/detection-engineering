Image IN ("*\\wscript.exe", "*\\cscript.exe") CommandLine IN ("*.js*", "*.jse*") ParentImage IN ("*\\chrome.exe", "*\\msedge.exe", "*\\brave.exe", "*\\outlook.exe", "*\\winword.exe", "*\\excel.exe", "*\\mshta.exe") OR CommandLine IN ("*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*", "*\\Downloads\\*", "*C:\\ProgramData\\*") OR CommandLine IN ("* -e:jscript*", "*http*", "*xmlhttp*", "*adodb.stream*", "* -b*") NOT (CommandLine="*C:\\Windows\\System32\\*" OR ParentImage="*\\services.exe" OR CommandLine="*UevAgent.js*")
