Image IN ("*\\regsvcs.exe", "*\\regasm.exe") OriginalFileName IN ("regsvcs.exe", "RegAsm.exe") IntegrityLevel IN ("Low", "Medium") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*") OR (CommandLine IN ("* /U *", "* /uninstall *", "* /regfile*") CommandLine IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*") OR CommandLine IN ("*http://*", "*https://*", "*\\\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\powerpnt.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe")) NOT (Image IN ("C:\\Windows\\Microsoft.NET\\Framework\\*", "C:\\Windows\\Microsoft.NET\\Framework64\\*") ParentImage IN ("*\\msiexec.exe", "*\\trustedinstaller.exe") IntegrityLevel="High") NOT User="NT AUTHORITY\\*"
