DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\whoami.exe", "*\quser.exe", "*\qwinsta.exe")) and (ProcessCommandLine in ("*net user *", "*net localgroup *", "*$env:username*"))) and ((ProcessCommandLine in ("* /priv*", "* /groups*", "* /all*", "* /fo csv*")) or ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\httpd.exe", "*\wsmprovhost.exe")) and IntegrityLevel =~ "Medium") or (ProcessCommandLine in ("* > *", "*findstr*", "*select-string*"))) and (not ((User in ("NT AUTHORITY\SYSTEM", "NT AUTHORITY\LOCAL SERVICE", "NT AUTHORITY\NETWORK SERVICE")) or (ParentProcessName in ("*\svchost.exe", "*\msiexec.exe", "*\CcmExec.exe")) or (ProcessCommandLine in ("*Program Files*", "*AppData\Local\Temp*"))))