DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*\User Data\*\Bookmarks*", "*\User Data\*\History*", "*\User Data\*\Login Data*", "*\User Data\Local State*", "*\Profiles\*\places.sqlite*", "*\Profiles\*\key4.db*")) and ((FolderPath in ("*\findstr.exe", "*\grep.exe", "*\sqlite3.exe", "*\powershell.exe", "*\pwsh.exe")) or (ProcessCommandLine in ("*type *", "*copy *", "*Get-ChildItem -Recurse*"))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\httpd.exe")) and (FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\brave.exe")))) or (((ProcessCommandLine in ("*\User Data\*\Bookmarks*", "*\User Data\*\History*", "*\User Data\*\Login Data*", "*\User Data\Local State*", "*\Profiles\*\places.sqlite*", "*\Profiles\*\key4.db*")) and (ProcessCommandLine in ("* > *", "*Export-Csv*", "*ConvertTo-Json*", "*base64*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Program Files\Splunk\*", "*\Program Files\Tanium\*", "*\CcmExec.exe*")))))