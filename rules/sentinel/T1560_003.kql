DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*[System.IO.File]::ReadAllBytes*", "*[System.IO.File]::WriteAllBytes*", "*MemoryStream*", "*Get-Content -Encoding Byte*"))) and (ProcessCommandLine in ("*[Convert]::ToBase64String*", "*[Convert]::FromBase64String*", "*-bxor*", "*-band*", "*-bor*", "*::ToCharArray()*")) and (ProcessCommandLine contains "Get-ChildItem" and ProcessCommandLine contains "-Recurse") and (ProcessCommandLine in ("*.zip*", "*.dat*", "*.tmp*", "*.log*", "*Out-File*", "*Set-Content*"))) and ((ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\rundll32.exe", "*\mshta.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*"))) and (not (User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe")))) and (not (FolderPath in ("C:\Program Files\Microsoft Monitoring Agent\*", "C:\Program Files\Splunk\*", "C:\Program Files\Elastic\Agent\*"))) and (not (ParentProcessName in ("*\AzureDevOps\*", "*\Jenkins\*", "*\GitLab\*")))