((process.command_line:(*\ \-type\=AXFR* OR *\ \-query\=AXFR* OR *\ \-type\=ANY* OR *\ \-type\=SOA* OR *\ \-type\=TXT* OR *ls\ \-d* OR *\ \-q\=srv*)) OR ((process.executable:(*\\dig.exe OR *\\host.exe OR *\\dnscmd.exe)) AND (process.command_line:(*\ \/enumzones* OR *\ \/zoneprint*)))) AND (NOT process.command_line:*nslookup.exe*) AND (NOT (user.name:(*svc_monitoring* OR *AD_Sync_Account*)))
