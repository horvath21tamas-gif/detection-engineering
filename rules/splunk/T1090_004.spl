CommandLine IN ("* -H \"Host:*", "* -H 'Host:*", "* -Header \"Host:*", "* --header \"Host:*", "*.Headers.Add(\"Host\"*", "*Set-Item -Path env:http_proxy*") CommandLine IN ("*cloudfront.net*", "*azureedge.net*", "*cloudflare.com*", "*fastly.net*", "*google.com*", "*microsoft.com*", "*s3.amazonaws.com*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\curl.exe", "*\\certutil.exe", "*\\bitsadmin.exe", "*\\rundll32.exe") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") CommandLine IN ("*localhost*", "*127.0.0.1*") username="NT AUTHORITY\\SYSTEM" ParentImage="*\\services.exe")
