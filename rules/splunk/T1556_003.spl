name IN ("/etc/pam.d/*", "/lib/security/*", "/lib64/security/*", "/usr/lib/security/*", "/usr/lib64/security/*") nametype IN ("CREATE", "DELETE") OR Image IN ("*/vim", "*/nano", "*/sed", "*/awk", "*/python*", "*/perl", "*/insmod") NOT ((Image IN ("*/apt", "*/dpkg", "*/yum", "*/dnf", "*/rpm", "*/pam-auth-update") Image IN ("*/ansible/*", "*/salt-minion*", "*/chef-client*", "*/puppet*")) OR ParentImage="*/unattended-upgrade")
