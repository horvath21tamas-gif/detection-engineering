SELECT UTF8(payload) as search_payload from events where (("Target Object" LIKE '%\\Software\\Microsoft\\Office\\%' OR "Target Object" LIKE '%\\Software\\WOW6432Node\\Microsoft\\Office\\%')) AND (("Target Object" LIKE '%\\Outlook\\Forms\\Registry%' OR "Target Object" LIKE '%\\Outlook\\Forms\\Cache%')) AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\reg.exe','%\cscript.exe','%\wscript.exe') OR ("Target Details" LIKE '%CLSID%' OR "Target Details" LIKE '%.dll%' OR "Target Details" LIKE '%.vbs%' OR "Target Details" LIKE '%http%')) AND NOT (("Target Details" LIKE '%C:\\Program Files\\%' OR "Target Details" LIKE '%C:\\Program Files (x86%')\%'))
