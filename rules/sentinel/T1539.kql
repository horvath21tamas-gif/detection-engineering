| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*\User Data\Local State*", "*\User Data\Default\Network\Cookies*", "*\User Data\Default\Cookies*", "*\User Data\Default\Login Data*", "*\User Data\Profile*", "*\BraveSoftware\Brave-Browser\User Data*", "*\Opera Software\Opera Stable*", "*\Mozilla\Firefox\Profiles\*", "*cookies.sqlite*", "*key4.db*", "*logins.json*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\python.exe", "*\sqlite3.exe", "*\certutil.exe", "*\curl.exe", "*\rundll32.exe", "*\mshta.exe", "*\7z.exe", "*\tar.exe")) and (ProcessCommandLine in ("*copy *", "*type *", "*Get-Content*", "*base64*", "*FromBase64String*", "*master_key*", "*os_crypt*", "*CryptUnprotectData*", "*DPAPI*", "*decrypt*", "*export*", "*.json*", "*.sqlite*", "*.db*")) and (not ((FolderPath in ("*\Google\Chrome\Application\chrome.exe*", "*\Microsoft\Edge\Application\msedge.exe*", "*\Mozilla Firefox\firefox.exe*", "*\Brave-Browser\Application\brave.exe*", "*\Opera\launcher.exe*")) or User startswith "NT AUTHORITY\" or (FolderPath in ("*\Veeam\*", "*\Acronis\*", "*\Windows Defender\*", "*\SentinelOne\*", "*\CrowdStrike\*"))))