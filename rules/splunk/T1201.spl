Image IN ("*\\net.exe", "*\\net1.exe") OR CommandLine IN ("*accounts*", "*Get-DomainPolicy*", "*Get-ADDefaultDomainPasswordPolicy*", "*Get-ADFineGrainedPasswordPolicy*") CommandLine IN ("*lockoutthreshold*", "*minpwdlength*", "*lockoutduration*", "*pwdcomplexity*") OR CommandLine IN ("* > *", "*ConvertTo-Json*", "*Export-Csv*") OR (ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe", "*\\powershell.exe") IntegrityLevel="Medium") NOT (username="NT AUTHORITY\\SYSTEM" OR ComputerName="*DC-*" OR CommandLine IN ("*logon.bat*", "*Program Files*"))
