Image IN ("*/PlistBuddy", "*/defaults", "*/plutil", "*/launchctl") CommandLine IN ("*/Library/LaunchAgents/*", "*/Library/LaunchDaemons/*", "*/Users/*", "*/System/Library/LaunchAgents/*", "*/System/Library/LaunchDaemons/*", "*/Library/StartupItems/*") OR CommandLine IN ("*RunAtLoad*", "*ProgramArguments*", "*KeepAlive*", "*StartInterval*", "*StartCalendarInterval*", "*LaunchEvents*", "*Label*", "*WatchPaths*", "*QueueDirectories*") OR CommandLine IN ("*bootstrap*", "*bootout*", "*load *", "*unload *") ParentImage IN ("*/Safari.app/*", "*/Google Chrome.app/*", "*/Microsoft Word.app/*", "*/Microsoft Excel.app/*", "*/Mail.app/*", "*/zoom.us.app/*", "*/Slack.app/*") OR ParentImage IN ("*/bash", "*/zsh", "*/sh", "*/osascript") OR (User="*root*" IntegrityLevel="Medium") NOT (Image IN ("/usr/sbin/softwareupdate*", "/System/Library/*", "/usr/libexec/*")) NOT (Image IN ("*/Jamf/*", "*/Intune/*", "*/Kandji/*", "*/Mosyle/*"))
