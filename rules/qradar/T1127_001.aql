SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\msbuild.exe' OR "ImageName"='MSBuild.exe') AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\wmiprvse.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%http%','%\%','%\AppData\%','%\Temp\%','%.xml%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\Microsoft Visual Studio\%','%\Common7\IDE\%','%\BuildAgent\%','%\Jenkins\%','%\ServiceFabric\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/p:Configuration=%','%.sln%','%.csproj%')) AND "username" ILIKE '%svc_build%')
