(Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe") CommandLine IN ("*.html*", "*.htm*", "*.js*") CommandLine IN ("* -WindowStyle Hidden*", "* -ExecutionPolicy Bypass*", "*login*", "*auth*", "*verify*", "*token*")) OR (ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe") Image IN ("*\\powershell.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe") CommandLine IN ("* -WindowStyle Hidden*", "* -ExecutionPolicy Bypass*", "*login*", "*auth*", "*verify*", "*token*") NOT (CommandLine IN ("*SharePoint*", "*Microsoft365*", "*GraphAPI*") username="NT AUTHORITY\\SYSTEM") NOT (CommandLine IN ("*--type=utility*", "*--type=renderer*", "*--type=gpu-process*")) NOT (ParentImage IN ("*\\Windows\\Installer\\*", "*\\ConfigMgr\\*")))
