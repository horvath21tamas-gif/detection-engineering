SELECT UTF8(payload) as search_payload from events where ("Image" ILIKE '%\wmic.exe' AND (("Process CommandLine" LIKE '%root\\subscription%' OR "Process CommandLine" LIKE '%__EventFilter%' OR "Process CommandLine" LIKE '%CommandLineEventConsumer%' OR "Process CommandLine" LIKE '%FilterToConsumerBinding%')) OR (("Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%')) AND (("Process CommandLine" LIKE '%Register-WmiEvent%' OR "Process CommandLine" LIKE '%Set-WmiInstance%' OR "Process CommandLine" LIKE '%New-CimInstance%' OR "Process CommandLine" LIKE '%root\\subscription%'))) AND NOT ("username" ILIKE '%SYSTEM%' OR ("Filename" LIKE '%\\Microsoft Monitoring Agent\\%' OR "Filename" LIKE '%\\SCOM\\%' OR "Filename" LIKE '%\\System Center\\%' OR "Filename" LIKE '%\\Tanium\\%' OR "Filename" LIKE '%\\Qualys\\%' OR "Filename" LIKE '%\\CrowdStrike\\%' OR "Filename" LIKE '%\\SentinelOne\\%' OR "Filename" LIKE '%\\SplunkUniversalForwarder\\%' OR "Filename" LIKE '%\\Datadog\\%' OR "Filename" LIKE '%\\Elastic\\Agent\\%') OR ("Process CommandLine" LIKE '%HealthCheck%' OR "Process CommandLine" LIKE '%Inventory%' OR "Process CommandLine" LIKE '%Monitoring%'))
