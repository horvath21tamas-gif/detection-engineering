SELECT UTF8(payload) as search_payload from events where (("TargetFilename" LIKE '%/.local/share/applications/%' OR "TargetFilename" LIKE '%/.config/autostart/%' OR "TargetFilename" LIKE '%/Desktop/%')) AND "TargetFilename" ILIKE '%.desktop' AND (("Details" LIKE '%Exec=sudo%' OR "Details" LIKE '%Exec=pkexec%' OR "Details" LIKE '%Exec=gksudo%' OR "Details" LIKE '%Exec=/tmp/%' OR "Details" LIKE '%Exec=/dev/shm/%')) AND NOT (""Filename"" ILIKE ENUMERATION('%/apt','%/dpkg','%/yum','%/dnf','%/rpm') OR "username"='root') OR (("TargetFilename" LIKE '%/.local/share/applications/%' OR "TargetFilename" LIKE '%/.config/autostart/%' OR "TargetFilename" LIKE '%/Desktop/%')) AND "TargetFilename" ILIKE '%.desktop' AND (""Filename"" ILIKE ENUMERATION('%/wget','%/curl','%/python','%/perl','%/bash')) AND (""Parent Filename"" ILIKE ENUMERATION('%/apache%','%/nginx%','%/node%','%/php%'))
