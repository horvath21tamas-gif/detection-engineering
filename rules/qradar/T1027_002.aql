SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\upx.exe','%\mpress.exe','%\aspack.exe','%\pecompact.exe','%\fsg.exe','%\themida.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -9%','% --ultra-brute%','% --brute%','% -f%','% -o %') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%','%\Downloads\%','%\Desktop\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Visual Studio\%','%\Jenkins\%','%\GitLab-Runner\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\msbuild.exe%','%\devenv.exe%')))
