Image IN ("*\\aws.exe", "*\\az.cmd", "*\\gcloud.cmd", "*\\oci.exe", "*\\ibmcloud.exe") CommandLine IN ("*ec2 describe-instances*", "*ec2 describe-security-groups*", "*s3 ls*", "*rds describe-db-instances*", "*vm list*", "*compute instances list*", "*network vnet list*", "*storage account list*", "*buckets list*", "*projects list*") CommandLine IN ("*--query*", "*--output json*", "* | jq*", "* | base64*", "* > *", "*>>*", "*| ConvertTo-Json*", "*| Out-File*") OR ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wsmprovhost.exe", "*\\httpd.exe", "*\\explorer.exe") NOT (ParentImage IN ("*\\Jenkins\\*", "*\\GitLab-Runner\\*", "*\\Terraform\\*", "*\\Ansible\\*", "*\\Pulumi\\*", "*\\Octopus\\*") username="NT AUTHORITY\\SYSTEM") | table Time,CommandLine,ParentImage,User,Image,ProcessID
