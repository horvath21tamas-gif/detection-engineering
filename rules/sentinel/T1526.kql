DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\aws.exe", "*\az.cmd", "*\az.exe", "*\gcloud.cmd", "*\gcloud.exe", "*\azcli.exe")) and (ProcessCommandLine in ("*lambda list-functions*", "*secretsmanager list-secrets*", "*eks list-clusters*", "*keyvault list*", "*webapp list*", "*functionapp list*", "*functions list*", "*container clusters list*", "*storage account list*", "*projects list*")) and ((ProcessCommandLine in ("*--query*", "*--output json*", "*| jq*", "*| base64*", "* > *", "* | clip*", "*| tee*", "*| Out-File*")) or (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\rundll32.exe"))) and (not ((ParentProcessName in ("*\Jenkins\*", "*\GitLab-Runner\*", "*\Terraform\*", "*\Ansible\*", "*\OctopusDeploy\*")) and username =~ "NT AUTHORITY\SYSTEM" and (ProcessCommandLine in ("*-NonInteractive*", "*-EncodedCommand*"))))