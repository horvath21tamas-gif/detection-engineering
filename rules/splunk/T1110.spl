CommandLine IN ("* -P *", "* -L *", "* -p *", "* -u *", "*passlist*", "*userlist*", "*wordlist*", "*.dic*", "*.lst*") OR (Image IN ("*\\net.exe", "*\\net1.exe", "*\\cmd.exe", "*\\powershell.exe") CommandLine IN ("*use *", "*Test-ComputerSecureChannel*", "*New-Object System.DirectoryServices.DirectoryEntry*", "*LogonUser*")) Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*") Image IN ("*\\python.exe", "*\\pythonw.exe") NOT ((ParentImage IN ("*\\Program Files\\Microsoft Azure AD Connect\\*", "*\\Program Files\\Puppet Labs\\*", "*\\Program Files\\Ansible\\*") username="NT AUTHORITY\\SYSTEM") OR Image IN ("*\\chrome.exe", "*\\msedge.exe"))
