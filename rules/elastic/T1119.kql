winlog.event_data.processcommandline:\(\\s\(\-Recurse\|\/s\)\\s.*\(\*\\.\)\)\|copy\\s\+\*\\. AND winlog.event_data.processcommandline:\(\\.doc\|\\.docx\|\\.pdf\|\\.xls\|\\.xlsx\|\\.pst\|\\.key\|\\.msg\|\\.pfx\|\\.rdp\)$ AND winlog.event_data.processcommandline:\(\\Users\\Public\|\\Windows\\Temp\|\\AppData\\Local\\Temp\|C\:\\ProgramData\) AND (winlog.event_data.Parentprocessname:\(w3wp\\.exe\|httpd\\.exe\|powershell\\.exe\|cmd\\.exe\)$ AND winlog.event_data.IntegrityLevel:Medium) AND (NOT ((process.executable.caseless:(*C\:\\Program\ Files\\Microsoft\ Monitoring\ Agent\\* OR *C\:\\Windows\\CCM\\* OR *\\OneDrive.exe*)) OR winlog.event_data.processcommandline:\(\-Filter\\s\+\*\\.log\|HealthCheck\) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM"))
