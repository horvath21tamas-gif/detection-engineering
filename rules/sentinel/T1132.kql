DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine =~ "(FromBase64String|ToBase64String|-decode\s|-encode\s|\[System\.Text\.Encoding\]::|BXAAR|TVqQA)" and ProcessCommandLine match "(*i).*[a-z0-9+/]{500,}.*") or ((ParentProcessName =~ "(winword\.exe|excel\.exe|w3wp\.exe|sqlservr\.exe)$" and FolderPath =~ "(rundll32\.exe|regsvr32\.exe|colorcpl\.exe)$") and ProcessCommandLine =~ "(FromBase64String|ToBase64String|-decode\s|-encode\s|\[System\.Text\.Encoding\]::|BXAAR|TVqQA)")) and (not (ProcessCommandLine =~ "(C:\Windows\System32\wbem\WmiPrvSE\.exe|CCM\Cache|Microsoft\.Cloud\.Data)" and FolderPath =~ "powershell_ise\.exe$" and UserName =~ "NT AUTHORITY\SYSTEM"))