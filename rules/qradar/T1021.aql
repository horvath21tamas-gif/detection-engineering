SELECT UTF8(payload) as search_payload from events where "EventID"=4624 AND (("Logon Type" LIKE '%2%' OR "Logon Type" LIKE '%10%')) AND NOT "Target User Name" LIKE '%$' AND NOT (("Target User Name" LIKE '%SYSTEM%' OR "Target User Name" LIKE '%LOCAL SERVICE%' OR "Target User Name" LIKE '%NETWORK SERVICE%')) AND NOT (("Source IP" LIKE '%127.0.0.1%' OR "Source IP" LIKE '%::1%'))
