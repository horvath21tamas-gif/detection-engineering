CommandLine IN ("*password=*", "*pwd=*", "*connectionstring*", "*access_key*", "*secret_key*", "*id_rsa*", "*id_dsa*", "*amzn.mws*", "*BEGIN RSA PRIVATE*") OR ((CommandLine="*findstr*" CommandLine="*/s*" CommandLine="*/i*") OR (CommandLine="*Get-ChildItem*" CommandLine="*-Recurse*" CommandLine="*-Include*") OR (CommandLine="*grep*" CommandLine="*-r*") CommandLine IN ("*.config*", "*.xml*", "*.ini*", "*.bak*", "*.old*", "*.history*", "*ConsoleHost_history*", "*.aws\\credentials*", "*.ssh\\*")) ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\httpd.exe") Image IN ("*\\findstr.exe", "*\\grep.exe", "*\\powershell.exe") NOT (Image IN ("*\\Windows\\System32\\SearchIndexer.exe*", "*\\Microsoft Visual Studio\\*", "*\\Git\\usr\\bin\\grep.exe*") username="NT AUTHORITY\\SYSTEM")
