SELECT UTF8(payload) as search_payload from events where (("ParentImage" LIKE '%\\WINWORD.EXE%' OR "ParentImage" LIKE '%\\EXCEL.EXE%' OR "ParentImage" LIKE '%\\POWERPNT.EXE%' OR "ParentImage" LIKE '%\\OUTLOOK.EXE%' OR "ParentImage" LIKE '%\\MSACCESS.EXE%')) AND (("Filename" LIKE '%\\cmd.exe%' OR "Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%' OR "Filename" LIKE '%\\mshta.exe%' OR "Filename" LIKE '%\\rundll32.exe%' OR "Filename" LIKE '%\\regsvr32.exe%' OR "Filename" LIKE '%\\bitsadmin.exe%' OR "Filename" LIKE '%\\certutil.exe%' OR "Filename" LIKE '%\\wscript.exe%' OR "Filename" LIKE '%\\cscript.exe%')) AND (("Process CommandLine" LIKE '%http://%' OR "Process CommandLine" LIKE '%https://%' OR "Process CommandLine" LIKE '%-enc%' OR "Process CommandLine" LIKE '%Invoke-Expression%' OR "Process CommandLine" LIKE '%IEX%' OR "Process CommandLine" LIKE '%DownloadString%' OR "Process CommandLine" LIKE '%FromBase64String%' OR "Process CommandLine" LIKE '%/c%' OR "Process CommandLine" LIKE '%/r%') OR ("Process CommandLine" LIKE '%\\Users\\%' OR "Process CommandLine" LIKE '%\\AppData\\%' OR "Process CommandLine" LIKE '%\\Temp\\%' OR "Process CommandLine" LIKE '%\\Microsoft\\Office\\%' OR "Process CommandLine" LIKE '%\\INetCache\\%')) AND NOT (("ParentCommandLine" LIKE '%\\Addins\\%' OR "ParentCommandLine" LIKE '%\\VSTO\\%' OR "ParentCommandLine" LIKE '%\\Program Files\\Microsoft Office\\%') OR ("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%'))
