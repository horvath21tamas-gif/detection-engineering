Image IN ("*\\wevtutil.exe", "*\\sed.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\sqlite3.exe", "*\\attrib.exe") CommandLine IN ("* cl *", "* clear-log *", "* -replace *", "* s/*", "* > *", "*Out-File*", "*Set-Content*") CommandLine IN ("*\\etc\\hosts*", "*\\System32\\winevt\\*", "*\\System32\\config\\*", "*.config*", "*.db*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\explorer.exe") NOT (ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe") OR CommandLine="*Program Files*" OR username="NT AUTHORITY\\SYSTEM" OR CommandLine="*Get-EventLog*")
