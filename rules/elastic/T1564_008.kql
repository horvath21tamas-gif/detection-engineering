(process.command_line:(*New\-InboxRule* OR *Set\-InboxRule* OR *Set\-MailboxForwardingConfiguration* OR *Remove\-InboxRule*)) AND (((process.command_line:(*DeleteMessage* OR *PermanentDelete* OR *MarkAsRead* OR *MoveToFolder* OR *ForwardTo*)) AND (process.command_line:(*Security* OR *Alert* OR *Password* OR *MFA* OR *Sign\-in* OR *Phish* OR *Compromise* OR *Unauthorized* OR *Breach*))) OR (process.parent.executable.caseless:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\msedge.exe OR *\\chrome.exe OR *\\mshta.exe OR *\\powershell.exe))) AND (NOT (winlog.event_data.username:"NT AUTHORITY\\SYSTEM" OR (process.command_line:(*Spam* OR *Junk* OR *Internal\-Auto\-Forward*)) OR (process.parent.executable.caseless:(*\\Windows\\System32\\svchost.exe* OR *\\ExchangeManagementShell\\*))))
