(CommandLine IN ("*copy *", "*type *", "*tar *", "*7z*", "*powershell*") NOT (Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe", "*\\GoogleUpdate.exe", "*\\MicrosoftEdgeUpdate.exe")) NOT (Image IN ("*\\migwiz.exe", "*\\OneDrive.exe") CommandLine IN ("*MigLog*", "*settings*"))) OR ((Image="*\\powershell.exe" CommandLine IN ("*Get-Credential*", "*prompt*", "*CredentialPrompt*", "*-WindowStyle Hidden*")) OR (Image="*\\msg.exe" CommandLine="*") NOT (ParentImage IN ("*\\CcmExec.exe", "*\\gpscript.exe")))
