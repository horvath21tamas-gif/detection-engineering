SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\net.exe','%\net1.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%','% /y%','% /yes%')) OR ""Filename"" ILIKE '%\cmdkey.exe' AND "Process "Process CommandLine"" ILIKE '% /delete%' OR ""Filename"" ILIKE '%\vaultcmd.exe' AND "Process "Process CommandLine"" ILIKE '% /delete%') AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\chrome.exe','%\msedge.exe','%\outlook.exe','%\w3wp.exe','%\powershell.exe','%\cmd.exe') OR NOT ("username" ILIKE 'NT AUTHORITY\%' AND ""Parent Filename"" ILIKE '%\services.exe' OR ""Parent Filename"" ILIKE '%\explorer.exe' OR "Process "Process CommandLine"" ILIKE ENUMERATION('%logon.bat%','%netlogon%','%gpo%','%group policy%')))
