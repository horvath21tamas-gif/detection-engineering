DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine contains "kerberos::golden" and ProcessCommandLine contains "/krbtgt:") or (FolderPath endswith "\rubeus.exe" and (ProcessCommandLine contains "golden" and ProcessCommandLine contains "/krbtgt:")) or (((ProcessCommandLine in ("*/krbtgt:*", "*/aes256:*", "*/aes128:*")) and (ProcessCommandLine contains "/sid:" and ProcessCommandLine contains "/id:")) and (ProcessCommandLine in ("*/ptt*", "*kerberos::ptt*")))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\psexesvc.exe", "*\wmiprvse.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*"))) and (not (User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe")))) and (not (FolderPath in ("*\Microsoft Monitoring Agent\*", "*\Azure\*", "*\RSAT\*")))