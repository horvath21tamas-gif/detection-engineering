Image IN ("*\\ssh.exe", "*\\sshd.exe") OR OriginalFileName IN ("ssh.exe", "sshd.exe") CommandLine IN ("* -L *", "* -R *", "* -D *", "* -N*", "* -f*") OR (ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\httpd.exe", "*\\winword.exe") CommandLine IN ("*StrictHostKeyChecking=no*", "*UserKnownHostsFile=/dev/null*")) OR (ParentImage="*\\sshd.exe" CommandLine IN ("* -enc *", "* -w hidden*", "*IEX*", "*DownloadString*")) NOT (ParentImage IN ("*\\Git\\*", "*\\VSCode\\*", "*\\JetBrains\\*") OR CommandLine IN ("*git-upload-pack*", "*git-receive-pack*", "*vscode-remote*") OR username="NT AUTHORITY\\SYSTEM")
