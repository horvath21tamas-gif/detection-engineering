DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*\\*", "*net use*", "*dir /s /b*", "*Get-ChildItem -Recurse*", "*robocopy*", "*findstr /s /i*")) and ((ProcessCommandLine in ("* > *", "* -OutFile *", "*Compress-Archive*", "*7z.exe a*", "*tar.exe -c*")) or (ProcessCommandLine in ("*.kdbx*", "*.xlsx*", "*.pdf*", "*id_rsa*", "*password*", "*confidential*"))) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\httpd.exe", "*\rundll32.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Program Files\Veritas\*", "*C:\Program Files\Commvault\*", "*C:\Windows\CCM\*")) or username =~ "NT AUTHORITY\SYSTEM" or ProcessCommandLine contains "SoftwareDistribution"))