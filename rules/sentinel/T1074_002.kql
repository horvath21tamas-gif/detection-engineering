DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*\\*", "*net use *", "*New-SmbMapping*", "*Push-Location *")) and (ProcessCommandLine in ("*robocopy *", "*xcopy *", "* /MOVE*", "* /E /H /K*", "*Compress-Archive *", "*7z.exe a *")) and ((ProcessCommandLine in ("* -m0*", "* -mx0*", "* -p*", "* -hp*", "*type * >> *")) or ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\httpd.exe")) and IntegrityLevel =~ "Medium")) and (not ((FolderPath in ("*C:\Windows\System32\wbem\WmiPrvSE.exe*", "*C:\Program Files\Microsoft\*", "*C:\Program Files\Veritas\*")) or User =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*SoftwareDistribution*", "*AppData\Roaming*"))))