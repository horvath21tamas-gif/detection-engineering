SELECT UTF8(payload) as search_payload from events where (("Process "Process CommandLine"" ILIKE ENUMERATION('%AADInternals%','%MSAL.PS%','%Okta.Auth%','%Connect-AzureAD%','%Connect-MgGraph%','%AcquireToken%','%DeviceCodeCredential%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Invoke-AADIntMFAFlood%','%while($true)%','%for($i=0%','%Start-Sleep%','%Send-PushNotification%','%ApproveSignIn%','%ShowPasswordPrompt%')) OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%puppeteer%','%selenium-webdriver%','%Playwright%','%--headless%','%--disable-gpu%','%--remote-debugging-port%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-WindowStyle Hidden%','%-ExecutionPolicy Bypass%','%-NonInteractive%','%-EncodedCommand%'))) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-WindowStyle Hidden%','%-ExecutionPolicy Bypass%','%-NonInteractive%','%-EncodedCommand%') OR ""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\psexesvc.exe','%\taskeng.exe','%\schtasks.exe') OR ""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\ProgramData\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\Microsoft Azure AD Connect\%','%\Microsoft Azure AD Sync\%','%\OneDrive\%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\%' OR "UserName" LIKE '%NT SERVICE\\%')) AND NOT (""Parent Filename"" ILIKE '%\explorer.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Connect-MgGraph -Scopes%','%Connect-AzureAD%')))
