SELECT UTF8(payload) as search_payload from events where ("LoadedImage" LIKE ('%\user32.dll','%\advapi32.dll','%\win32u.dll')) AND processname LIKE '%.exe' AND NOT ((processname LIKE 'C:\Windows\System32\%' OR processname LIKE 'C:\Windows\SysWOW64\%')) AND NOT ((processname LIKE '%\explorer.exe' OR processname LIKE '%\chrome.exe' OR processname LIKE '%\msedge.exe' OR processname LIKE '%\firefox.exe' OR processname LIKE '%\teams.exe'))
