Image IN ("*\\notepad.exe", "*\\calc.exe", "*\\mspaint.exe", "*\\winver.exe", "*\\colorcpl.exe", "*\\spoolsv.exe", "*\\scrcons.exe") OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\regsvr32.exe", "*\\mshta.exe", "*\\certutil.exe") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe")) IntegrityLevel="Medium" NOT (Image IN ("*\\chrome.exe*", "*\\msedge.exe*", "*\\firefox.exe*", "*\\googleupdate.exe*") OR DestinationHostname IN ("*.microsoft.com", "*.windowsupdate.com", "*.digicert.com", "*.amazontrust.com", "*ocsp.globalsign.com"))
