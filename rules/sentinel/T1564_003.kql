DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\mshta.exe", "*\cscript.exe", "*\wscript.exe")) and (ProcessCommandLine in ("* -w h*", "* -window h*", "* -win h*", "* -wind h*", "*showwindow=0*", "*windowstyle 1*", "*sw_hide*")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\acrord32.exe", "*\sqlservr.exe", "*\w3wp.exe")) or (ProcessCommandLine in ("* -enc*", "* -e *", "* -nop*", "* -noni*", "*iex*", "*downloadstring*", "*frombase64string*"))) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\Windows\System32\ServerManager.exe*", "*\Configuration Manager\*", "*\HealthService.exe*")) or (ProcessCommandLine in ("*Chocolatey*", "*Splunk*", "*Logitech*"))))