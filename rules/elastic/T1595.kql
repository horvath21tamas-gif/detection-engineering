(SrcIp:(1.* OR 2.* OR 3.* OR 4.* OR 5.* OR 6.* OR 7.* OR 8.* OR 9.*)) AND (Method:(GET OR HEAD OR OPTIONS)) AND (UriStem:(*\/admin* OR *\/login* OR *\/config* OR *\/setup* OR *\/debug* OR *\/test* OR *\/backup* OR *\/old* OR *\/dev* OR *\/server\-status* OR *\/phpinfo* OR *\/.git* OR *\/.env* OR *\/wp\-admin* OR *\/actuator*)) AND (UserAgent:(*curl* OR *wget* OR *python* OR *go\-http\-client* OR *libwww* OR *scanner* OR *probe* OR *masscan* OR *nmap* OR *zgrab* OR *httpclient* OR *axios* OR *requests*)) AND (Status:(200 OR 301 OR 302 OR 401 OR 403 OR 404)) AND (NOT ((UserAgent:(*Mozilla* OR *Chrome* OR *Firefox* OR *Safari* OR *Edge*)) OR (UserAgent:(*nessus* OR *qualys* OR *openvas* OR *acunetix* OR *nikto* OR *nuclei* OR *zabbix* OR *prometheus* OR *uptime* OR *pingdom* OR *datadog* OR *newrelic*)) OR ((UriStem:(*\/health* OR *\/metrics* OR *\/status\/health* OR *\/api*)) AND (UriStem:(*.css OR *.js OR *.png OR *.jpg OR *.svg OR *.ico OR *.woff OR *.woff2 OR *.map)))))
