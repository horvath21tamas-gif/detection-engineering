DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*:\PerfLogs\*", "*:\Users\Public\*", "*:\Windows\Temp\*", "*:\RECYCLER\*", "*:\ProgramData\*", "*\AppData\Local\Temp\*")) and ((ProcessCommandLine in ("* -m0*", "* -mx0*", "* -p *", "* -hp*", "* -ta*", "*type * >> *")) or ((FolderPath in ("*\7z.exe", "*\rar.exe", "*\makecab.exe", "*\powershell.exe", "*\tar.exe")) or (ProcessCommandLine in ("*Compress-Archive*", "*xcopy *", "*robocopy *")))) and ((ParentProcessName in ("*\w3wp.exe", "*\powershell.exe", "*\cmd.exe", "*\httpd.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Windows\CCM\*", "*C:\Program Files\Microsoft\*")) or username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*SoftwareDistribution*", "*C:\Windows\Installer*", "*OneDrive.exe*", "*AppData\Local\Microsoft\Teams*"))))