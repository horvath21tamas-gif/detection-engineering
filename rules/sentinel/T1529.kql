DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\shutdown.exe", "*\init.exe", "*\powershell.exe", "*\pwsh.exe")) and ProcessCommandLine contains " /a" and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\powerpoint.exe", "*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\httpd.exe", "*\rundll32.exe", "*\wscript.exe", "*\cscript.exe")) and (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\CcmExec.exe", "*\TiWorker.exe", "*\msiexec.exe", "*\svchost.exe", "*\Sppsvc.exe")) and (ProcessCommandLine in ("*HealthCheck*", "*Diagnostic*", "*AzureAD*", "*Update*", "*Patch*"))))