DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "/spctl" and (ProcessCommandLine in ("*--master-disable*", "*label-disable*"))) or ((FolderPath endswith "/xattr" and (ProcessCommandLine in ("*-d com.apple.quarantine*", "*-rc com.apple.quarantine*"))) and (ParentProcessName in ("*/sh", "*/bash", "*/zsh", "*/python", "*/php")) and (ProcessCommandLine in ("*/tmp/*", "*/Users/Shared/*", "*/private/var/tmp/*", "*/Downloads/*")))) and (not (ParentProcessName in ("/System/Library/*", "/usr/sbin/softwareupdate*", "/Applications/Xcode.app/*")))