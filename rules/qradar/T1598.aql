SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%copy %','%type %','%tar %','%7z%','%powershell%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\GoogleUpdate.exe','%\MicrosoftEdgeUpdate.exe')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\migwiz.exe','%\OneDrive.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%MigLog%','%settings%'))) OR (""Filename"" ILIKE '%\powershell.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Get-Credential%','%prompt%','%CredentialPrompt%','%-WindowStyle Hidden%')) OR ""Filename"" ILIKE '%\msg.exe' AND "Process "Process CommandLine"" ILIKE '%') AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\CcmExec.exe','%\gpscript.exe'))
