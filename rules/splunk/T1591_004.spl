CommandLine IN ("*Get-ADUser -Filter *", "*Get-ADUser -Filter \"Enabled -eq*", "*Get-ADGroupMember -Identity \"Domain Admins\"*", "*dsquery user -limit 0*") OR CommandLine IN ("*net user /domain*", "*net group /domain*") OR CommandLine IN ("*(&(objectCategory=person)(objectClass=user))*", "*distinguishedName*", "*userPrincipalName*", "*samaccountname*") NOT (Image IN ("*\\Lansweeper\\*", "*\\Tanium\\*", "*\\SCCM\\*") OR ParentImage IN ("*\\miiserver.exe", "*\\Microsoft.IdentityManagement.Service.exe")) NOT (ParentImage IN ("*\\mmc.exe", "*\\ServerManager.exe") OR username="NT AUTHORITY\\SYSTEM")
