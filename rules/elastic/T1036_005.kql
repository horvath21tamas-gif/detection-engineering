(process.executable.caseless:(*\\cmd.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\robocopy.exe OR *\\xcopy.exe)) AND (process.command_line:(*copy\ * OR *xcopy\ * OR *robocopy\ * OR *Copy\-Item*)) AND (process.command_line:(*\\svchost.exe* OR *\\lsass.exe* OR *\\services.exe* OR *\\explorer.exe* OR *\\winlogon.exe* OR *\\csrss.exe* OR *\\smss.exe*)) AND (process.command_line:(*C\:\\Windows\\System32\\* OR *C\:\\Windows\\SysWOW64\\*)) AND (process.command_line:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\ProgramData\\*)) AND (NOT ((user.name:(*NT\ AUTHORITY\\SYSTEM* OR *LOCAL\ SERVICE* OR *NETWORK\ SERVICE*)) OR (process.parent.executable.caseless:(*\\Windows\\Installer\\* OR *\\Microsoft\ Configuration\ Manager\\* OR *\\Windows\\CCM\\* OR *\\PDQ\\* OR *\\Ivanti\\* OR *\\ManageEngine\\* OR *\\Tanium\\* OR *\\Setup\\* OR *\\Update\\*))))
