SrcIp IN ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*") Action IN ("deny", "drop", "reset") Protocol="tcp" Status IN (400, 401, 403, 404, 408, 444, 499) NOT (DestIp IN ("10.*", "192.168.*", "172.16.*", "172.17.*", "172.18.*", "172.19.*", "172.20.*", "172.21.*", "172.22.*", "172.23.*", "172.24.*", "172.25.*", "172.26.*", "172.27.*", "172.28.*", "172.29.*", "172.30.*", "172.31.*") OR UserAgent IN ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*burp*", "*nikto*", "*zabbix*", "*nagios*") OR UserAgent IN ("*googlebot*", "*bingbot*", "*yandex*", "*ahrefs*", "*semrush*", "*uptimerobot*", "*pingdom*") OR SrcIp IN ("34.*", "35.*", "52.*", "54.*")) | table SrcIp,DestIp,DestPort,Action,Status
