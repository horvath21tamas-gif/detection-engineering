SELECT UTF8(payload) as search_payload from events where (("Process "Process CommandLine"" ILIKE ENUMERATION('%ipinfo.io%','%ifconfig.me%','%icanhazip.com%','%api.ipify.org%','%checkip.amazonaws.com%','%ip-api.com%','%ipwho.is%','%freegeoip%')) AND (""Filename"" ILIKE ENUMERATION('%\curl.exe','%\powershell.exe','%\pwsh.exe','%\wget.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Invoke-WebRequest%','%Invoke-RestMethod%','%nslookup%','%Resolve-DnsName%')) OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%Keyboard Layout\Preload%','%Control Panel\International%','%MUILanguages%','%GeoID%','%Get-ItemProperty%','%reg query%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Get-Culture%','%Get-WinSystemLocale%','%Get-TimeZone%','%Get-UICulture%'))) AND ((""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\wsmprovhost.exe','%\httpd.exe','%\mshta.exe')) AND "Integrity Level"='Medium' OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Temp\%','%\ProgramData\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% > %','%| Out-File%','%ConvertTo-Json%','%findstr%','%select-string%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\%' OR "UserName" LIKE '%NT SERVICE\\%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\CcmExec.exe','%\svchost.exe','%\IntuneManagementExtension.exe')) AND (""Filename"" ILIKE ENUMERATION('%\Program Files\%','%\Splunk\%','%\Tanium\%')))
