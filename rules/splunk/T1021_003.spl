ParentImage IN ("*\\mmc.exe", "*\\excel.exe", "*\\outlook.exe", "*\\visio.exe", "*\\explorer.exe", "*\\dcomcnfg.exe", "*\\word.exe") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\scrcons.exe") CommandLine IN ("* -enc *", "* -w hidden*", "* -nop*", "* /c *", "*DownloadString*", "*bypass*") OR ParentCommandLine IN ("* /automation*", "* -embedding*") NOT (CommandLine IN ("*C:\\Windows\\System32\\*", "*.msc*") OR ParentCommandLine="*servermanager.msc*" OR username="NT AUTHORITY\\SYSTEM")
