SELECT eventTime, eventSource, eventName, userIdentity.type, userIdentity.arn, sourceIPAddress, userAgent, awsRegion from events where ("eventSource"='guardduty.amazonaws.com' AND (("eventName" LIKE '%DeleteDetector%' OR "eventName" LIKE '%UpdateDetector%' OR "eventName" LIKE '%DeleteMembers%' OR "eventName" LIKE '%DisassociateMembers%' OR "eventName" LIKE '%DeleteThreatIntelSet%' OR "eventName" LIKE '%DeleteIPSet%')) OR "eventSource"='securityhub.amazonaws.com' AND (("eventName" LIKE '%DisableSecurityHub%' OR "eventName" LIKE '%BatchDisableStandards%' OR "eventName" LIKE '%CreateFilter%' OR "eventName" LIKE '%UpdateFilter%' OR "eventName" LIKE '%BatchUpdateFindings%')) OR "eventSource"='inspector2.amazonaws.com' AND (("eventName" LIKE '%UpdateConfiguration%' OR "eventName" LIKE '%Disable%'))) AND ("userIdentity.type"='Root' OR "userIdentity.type"='IAMUser' OR ("userAgent" LIKE '%curl%' OR "userAgent" LIKE '%python%' OR "userAgent" LIKE '%postman%' OR "userAgent" LIKE '%httpclient%' OR "userAgent" LIKE '%boto3%' OR "userAgent" LIKE '%aws-cli%')) AND NOT (("userIdentity.arn" LIKE '%Security-Infrastructure-Terraform%' OR "userIdentity.arn" LIKE '%AWSServiceRoleForGuardDuty%' OR "userIdentity.arn" LIKE '%AWSServiceRoleForSecurityHub%' OR "userIdentity.arn" LIKE '%OrganizationAccountAccessRole%') OR ("sourceIPAddress" LIKE '%10.%' OR "sourceIPAddress" LIKE '%192.168.%' OR "sourceIPAddress" LIKE '%172.%' OR "sourceIPAddress" LIKE '%127.%'))
