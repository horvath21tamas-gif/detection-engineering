SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%\Software\Classes\CLSID\%' AND (("Target Object" LIKE '%\\InprocServer32%' OR "Target Object" LIKE '%\\LocalServer32%')) AND (("Target Details" LIKE '%\\Users\\%' OR "Target Details" LIKE '%\\AppData\\%' OR "Target Details" LIKE '%\\Temp\\%' OR "Target Details" LIKE '%\\ProgramData\\%' OR "Target Details" LIKE '%\\Downloads\\%')) AND (("Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%' OR "Filename" LIKE '%\\cmd.exe%' OR "Filename" LIKE '%\\wscript.exe%' OR "Filename" LIKE '%\\cscript.exe%' OR "Filename" LIKE '%\\mshta.exe%' OR "Filename" LIKE '%\\rundll32.exe%' OR "Filename" LIKE '%\\regsvr32.exe%')) AND NOT ("username" ILIKE '%SYSTEM%' OR ("Target Details" LIKE '%C:\\Windows\\System32\\%' OR "Target Details" LIKE '%C:\\Windows\\SysWOW64\\%') OR ("Filename" LIKE '%\\Windows\\Installer\\%' OR "Filename" LIKE '%\\Microsoft\\EdgeUpdate\\%' OR "Filename" LIKE '%\\Google\\Update\\%' OR "Filename" LIKE '%\\Mozilla Maintenance Service\\%' OR "Filename" LIKE '%\\Adobe\\%' OR "Filename" LIKE '%\\Microsoft\\Teams\\Update\\%'))
