TargetImage IN ("*\\explorer.exe", "*\\dwm.exe", "*\\taskhostw.exe") GrantedAccess IN ("*0x28*", "*0x20*", "*0x1fffff*") NOT ((SourceImage IN ("*\\Visual Studio\\*", "*\\WinDbg\\*", "*\\Windows Defender\\*", "*\\CrowdStrike\\*", "*\\SentinelOne\\*", "*\\CarbonBlack\\*", "*\\Tanium\\*") SourceImage IN ("*\\procmon.exe", "*\\procexp.exe", "*\\taskmgr.exe")) OR Sourceusername="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\explorer.exe")
