DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\dnscmd.exe", "*\nsupdate.exe")) or (ProcessCommandLine in ("* /ZoneResetMasters*", "* /Config *", "* /ZoneAdd *", "* /RecordAdd *"))) or ((ParentProcessName in ("*\dns.exe", "*\named.exe", "*\coredns.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\whoami.exe", "*\certutil.exe", "*\curl.exe")))) and (not (username =~ "NT AUTHORITY\SYSTEM" and ProcessCommandLine contains " /RecordAdd ")) and (not ((User in ("*svc_dns_mgr*", "*adm_net_ops*")) and FolderPath contains "\System32\ServerManager.exe")) and (not (ParentProcessName endswith "\explorer.exe" and condition =~ "not selection_dns_critical_ops"))