DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\flashrom.exe", "*\FPTW64.exe", "*\AFUWINx64.exe", "*\UEFITool.exe")) or (OriginalFileName in ("FPTW64.exe", "flashrom.exe", "AFUWINx64.exe", "UEFITool.exe"))) and (ProcessCommandLine in ("* /d *", "* /f *", "* /p *", "* -write*", "* -save*", "* /capsule*")) and ((ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe")) or (FolderPath in ("*\Users\*", "*\Temp\*", "*\Downloads\*"))) and (not ((FolderPath in ("*C:\Program Files\*", "*C:\Program Files (x86)\*")) or ParentProcessName endswith "\svchost.exe" or User =~ "NT AUTHORITY\SYSTEM"))