SELECT UTF8(payload) as search_payload from events where (("eventName" LIKE '%DeleteDetector%' OR "eventName" LIKE '%UpdateDetector%' OR "eventName" LIKE '%DeleteThreatIntelSet%' OR "eventName" LIKE '%DeleteIPSet%') OR (("eventName" LIKE '%CreateFilter%' OR "eventName" LIKE '%UpdateFilter%' OR "eventName" LIKE '%CreateSuppressionRule%')) AND (("requestParameters.action" LIKE '%ARCHIVE%' OR "requestParameters.action" LIKE '%SUPPRESS%'))) AND ("userIdentity.type"='Root' OR ("userAgent" LIKE '%python-requests%' OR "userAgent" LIKE '%kali%' OR "userAgent" LIKE '%curl%' OR "userAgent" LIKE '%postman%') OR "userIdentity.sessionContext.attributes.mfaAuthenticated"='false') AND NOT ((("userIdentity.arn" LIKE '%role/Security-Infrastructure-Terraform%' OR "userIdentity.arn" LIKE '%role/AWS-Service-Role%')) AND "sourceIPAddress"='10.0.0.0/8')
