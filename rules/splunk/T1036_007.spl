Image IN ("*.pdf.exe*", "*.docx.exe*", "*.xlsx.exe*", "*.txt.exe*", "*.jpg.exe*", "*.png.exe*", "*.zip.exe*", "*.pdf.vbs*", "*.txt.vbs*", "*.pdf.js*", "*.pdf.ps1*", "*.pdf.scr*") Image IN ("*\\Downloads\\*", "*\\Desktop\\*", "*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Content.Outlook\\*") OR ParentImage IN ("*\\chrome.exe", "*\\msedge.exe", "*\\outlook.exe", "*\\winrar.exe", "*\\7zFM.exe", "*\\explorer.exe") NOT (Image IN ("*.min.js*", "*.js.map*", "*.config.xml*") OR Image IN ("C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*", "C:\\Program Files\\*", "C:\\Program Files (x86)\\*") OR username="NT AUTHORITY\\SYSTEM")
