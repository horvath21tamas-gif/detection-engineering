((process.executable:*\\taskkill.exe AND (process.command_line:(*\ \/f\ \/im\ csrss.exe* OR *\ \/f\ \/im\ wininit.exe* OR *\ \/f\ \/im\ smss.exe* OR *\ \/f\ \/im\ services.exe*))) OR (process.executable:*\\ntsd.exe AND (process.command_line:(*\-pn\ csrss.exe* OR *\-pn\ wininit.exe* OR *\-pn\ smss.exe* OR *\-c\ q*)))) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\rundll32.exe OR *\\httpd.exe OR *\\nginx.exe OR *\\apache.exe)) AND (process.executable:(*\\Temp\\* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\* OR *\\Downloads\\*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND (process.parent.executable:(*\\CcmExec.exe OR *\\msiexec.exe OR *\\TiWorker.exe OR *\\TrustedInstaller.exe)) AND (process.command_line:(*HealthCheck* OR *Diagnostic* OR *Update* OR *Patch* OR *Maintenance*))))
