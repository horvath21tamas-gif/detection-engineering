SELECT UTF8(payload) as search_payload from events where ("Image" ILIKE '%\netsh.exe' OR "ImageName"='netsh.exe') AND ("Process CommandLine" ILIKE ENUMERATION('%advfirewall%','%firewall%')) AND ("Process CommandLine" ILIKE ENUMERATION('%add%','%set%')) AND ("Process CommandLine" ILIKE ENUMERATION('%action=allow%','%enable=yes%')) AND NOT (("ParentImage" ILIKE ENUMERATION('%\CcmExec.exe','%\msiexec.exe')) AND ("Process CommandLine" ILIKE ENUMERATION('%show%','%monitor%','%profile state%')))
