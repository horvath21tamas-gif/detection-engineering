Image IN ("*\\trufflehog.exe", "*\\gitleaks.exe", "*\\shhgit.exe", "*\\git-secrets.exe", "*\\detect-secrets.exe") OR CommandLine IN ("*trufflehog*", "*gitleaks*", "*scan --repo*") OR (Image="*\\git.exe" CommandLine IN ("* log -G*", "* log -S*", "* rev-list --all*", "* log --pretty=format*", "* grep --cached*") CommandLine IN ("*password=*", "*api_key*", "*client_secret*", "*private_key*", "*access_token*", "*jelszo*", "*titok*")) NOT (ParentImage IN ("*\\code.exe", "*\\idea64.exe", "*\\visualstudio.exe", "*\\eclipse.exe")) NOT (User IN ("*svc_jenkins*", "*github_runner*", "*gitlab_runner*", "*azure_devops*") CommandLine IN ("*npm *", "*nuget *", "*dotnet *")) NOT (CommandLine IN ("*git pull*", "*git push*", "*git commit*", "*git clone*", "*git fetch*"))
