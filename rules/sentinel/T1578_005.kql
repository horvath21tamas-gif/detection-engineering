DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (operation_name in ("*AuthorizeSecurityGroupIngress*", "*CreateNetworkAclEntry*", "*Microsoft.Network/networkSecurityGroups/securityRules/write*", "*v1.compute.networks.updatePolicy*")) and (request_parameters in ("*0.0.0.0/0*", "*::/0*", "*all*", "*any*")) and ((request_parameters in ("*22*", "*3389*", "*445*", "*5985*", "*3306*", "*5432*", "*1433*")) or (mfa_authenticated =~ "false" and (user_agent in ("*kali*", "*python-requests*", "*boto3*", "*postman*", "*curl*")))) and (not ((user_name in ("svc-terraform*", "svc-ansible*", "cloud-formation-manager*")) or (user_name in ("*system-internal*", "*elasticloadbalancing*"))))