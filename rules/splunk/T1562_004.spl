Image="*\\netsh.exe" OR OriginalFileName="netsh.exe" CommandLine IN ("*advfirewall*", "*firewall*") CommandLine IN ("*add*", "*set*") CommandLine IN ("*action=allow*", "*enable=yes*") NOT (ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe") CommandLine IN ("*show*", "*monitor*", "*profile state*"))
