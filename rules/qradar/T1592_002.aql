SELECT SrcIp, Method, UriStem, UriQuery, Status, UserAgent from events where (("SrcIp" LIKE '%1.%' OR "SrcIp" LIKE '%2.%' OR "SrcIp" LIKE '%3.%' OR "SrcIp" LIKE '%4.%' OR "SrcIp" LIKE '%5.%' OR "SrcIp" LIKE '%6.%' OR "SrcIp" LIKE '%7.%' OR "SrcIp" LIKE '%8.%' OR "SrcIp" LIKE '%9.%')) AND (("Method" LIKE '%GET%' OR "Method" LIKE '%HEAD%')) AND (("UriStem" LIKE '%/version%' OR "UriStem" LIKE '%/about%' OR "UriStem" LIKE '%/status%' OR "UriStem" LIKE '%/info%' OR "UriStem" LIKE '%/build%' OR "UriStem" LIKE '%/debug%' OR "UriStem" LIKE '%/admin%' OR "UriStem" LIKE '%/server-info%' OR "UriStem" LIKE '%/actuator%' OR "UriStem" LIKE '%/metrics%')) AND (("UriQuery" LIKE '%version%' OR "UriQuery" LIKE '%build%' OR "UriQuery" LIKE '%release%' OR "UriQuery" LIKE '%software%' OR "UriQuery" LIKE '%application%' OR "UriQuery" LIKE '%component%' OR "UriQuery" LIKE '%module%' OR "UriQuery" LIKE '%plugin%' OR "UriQuery" LIKE '%stack%')) AND (("UserAgent" LIKE '%curl%' OR "UserAgent" LIKE '%wget%' OR "UserAgent" LIKE '%python%' OR "UserAgent" LIKE '%httpclient%' OR "UserAgent" LIKE '%go-http-client%' OR "UserAgent" LIKE '%libwww%' OR "UserAgent" LIKE '%scanner%' OR "UserAgent" LIKE '%probe%')) AND (("Status" LIKE '%200%' OR "Status" LIKE '%401%' OR "Status" LIKE '%403%' OR "Status" LIKE '%404%')) AND NOT (("UserAgent" LIKE '%Mozilla%' OR "UserAgent" LIKE '%Chrome%' OR "UserAgent" LIKE '%Safari%' OR "UserAgent" LIKE '%Firefox%' OR "UserAgent" LIKE '%Edge%') OR ("UserAgent" LIKE '%nessus%' OR "UserAgent" LIKE '%qualys%' OR "UserAgent" LIKE '%openvas%' OR "UserAgent" LIKE '%acunetix%' OR "UserAgent" LIKE '%nikto%' OR "UserAgent" LIKE '%nuclei%' OR "UserAgent" LIKE '%zap%' OR "UserAgent" LIKE '%zabbix%' OR "UserAgent" LIKE '%prometheus%' OR "UserAgent" LIKE '%uptime%' OR "UserAgent" LIKE '%pingdom%') OR (("UriStem" LIKE '%/api%' OR "UriStem" LIKE '%/health%')) AND (("UriStem" LIKE '%.css%' OR "UriStem" LIKE '%.js%' OR "UriStem" LIKE '%.png%' OR "UriStem" LIKE '%.jpg%' OR "UriStem" LIKE '%.svg%' OR "UriStem" LIKE '%.ico%' OR "UriStem" LIKE '%.woff%' OR "UriStem" LIKE '%.woff2%' OR "UriStem" LIKE '%.json%')))
