SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\brave.exe','%\opera.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\mshta.exe','%\cscript.exe','%\wscript.exe','%\certutil.exe','%\scrcons.exe','%\regsvr32.exe','%\rundll32.exe')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%--type=renderer%','%--type=gpu-process%','%--type=utility%','%--type=crashpad-handler%','%--type=extension%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%dw20.exe%','%ie_to_edge_stub.exe%') OR ""Filename"" ILIKE ENUMERATION('%\Google\Update\%','%\Microsoft\EdgeUpdate\%'))
