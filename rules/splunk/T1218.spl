Image IN ("*\\rundll32.exe", "*\\regsvr32.exe", "*\\msiexec.exe", "*\\installutil.exe", "*\\mshta.exe", "*\\control.exe", "*\\cmstp.exe", "*\\odbcconf.exe") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\brave.exe", "*\\sqlservr.exe", "*\\w3wp.exe") OR (CommandLine IN ("*http*", "*ftp*", "*javascript:*", "*vbscript:*", "*scrobj.dll*", "*.txt*", "*.png*", "*.jpg*", "*.dat*", "*.inf*") CommandLine IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Downloads\\*", "*\\PerfLogs\\*")) NOT (username="NT AUTHORITY\\SYSTEM" ParentImage="C:\\Windows\\System32\\svchost.exe*" CommandLine="*C:\\Windows\\Installer\\*")
