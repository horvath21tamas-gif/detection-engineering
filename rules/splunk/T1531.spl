Image IN ("*\\net.exe", "*\\net1.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\dsmod.exe", "*\\dsrm.exe") CommandLine IN ("* user *", "*Remove-LocalUser*", "*Remove-ADUser*", "*Disable-LocalUser*", "*Disable-ADAccount*", "*Set-LocalUser -AccountExpires*", "*dsrm*", "*dsmod user -disabled yes*") CommandLine IN ("* /delete*", "* /active:no*", "* /logoff*", "*-Confirm:$false*", "*-Force*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpoint.exe", "*\\httpd.exe", "*\\php-cgi.exe", "*\\rundll32.exe", "*\\explorer.exe") ParentCommandLine IN ("*-EncodedCommand*", "*-NonInteractive*") NOT (CommandLine IN ("*Add-LocalUser*", "* /add*", "*WDAGUtilityAccount*", "*DefaultAccount*") ParentImage IN ("*\\msiexec.exe", "*\\services.exe") User="NT AUTHORITY\\*")
