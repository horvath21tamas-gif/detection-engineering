DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((eventName in ("StopLogging", "DeleteTrail", "DeleteEventDataStore")) or (eventName =~ "UpdateTrail" and (['requestParameters.enableLogFileValidation'] =~ false or ['requestParameters.kmsKeyId'] =~ "")) or ((eventName in ("PutEventSelectors", "UpdateEventDataStore")) and ['requestParameters.includeManagementEvents'] =~ false) or ((eventSource =~ "s3.amazonaws.com" and (eventName in ("DeleteBucket", "PutBucketLifecycleConfiguration", "PutBucketVersioning", "PutBucketPolicy"))) and (['requestParameters.bucketName'] in ("*log*", "*trail*", "*audit*", "*security*", "*telemetry*")))) and (['userIdentity.type'] =~ "Root" or ['userIdentity.sessionContext.attributes.mfaAuthenticated'] =~ "false" or (userAgent in ("*python-requests*", "*curl*", "*wget*", "*kali*", "*postman*", "*bot*")) or userAgent contains "aws-cli") and (not ((['userIdentity.arn'] in ("*role/Terraform*", "*role/CloudFormation*", "*role/Security-Automation*", "*role/OrganizationAccountAccessRole*", "*role/AWSServiceRoleForCloudTrail*")) or (['userIdentity.invokedBy'] in ("cloudtrail.amazonaws.com", "config.amazonaws.com"))))