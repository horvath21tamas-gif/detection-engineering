SrcIp IN ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*") UriStem IN ("*/system*", "*/hardware*", "*/device*", "*/diagnostics*", "*/status*", "*/mgmt*", "*/management*", "*/admin*", "*/cgi-bin*") UriQuery IN ("*cpu*", "*cores*", "*architecture*", "*arch*", "*model*", "*vendor*", "*manufacturer*", "*serial*", "*board*", "*chip*", "*memory*", "*ram*") UserAgent IN ("*curl*", "*wget*", "*python*", "*httpclient*", "*go-http-client*", "*libwww*", "*probe*") NOT (UserAgent IN ("*Mozilla*", "*Chrome*", "*Safari*", "*Firefox*", "*Edge*") OR UserAgent IN ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nikto*", "*nuclei*", "*zap*", "*zabbix*", "*uptime*", "*pingdom*") OR (UriStem IN ("*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.woff", "*.woff2", "*.json") UriStem="*/api*")) | table SrcIp,UriStem,UriQuery,UserAgent,Status
