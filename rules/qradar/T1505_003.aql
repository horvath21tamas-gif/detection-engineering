SELECT UTF8(payload) as search_payload from events where ("cs-(method" LIKE '%POST%' OR method" LIKE '%PUT%')) AND ("cs-uri-(stem" LIKE '%.php%' OR stem" LIKE '%.asp%' OR stem" LIKE '%.aspx%' OR stem" LIKE '%.jsp%' OR stem" LIKE '%.phtml%')) AND ("cs-uri-(query" LIKE '%cmd=%' OR query" LIKE '%exec=%' OR query" LIKE '%powershell=%' OR query" LIKE '%whoami%' OR query" LIKE '%net user%' OR query" LIKE '%command=%' OR query" LIKE '%shell%' OR query" LIKE '%curl%' OR query" LIKE '%wget%'))
