winlog.channel:Microsoft\-Windows\-Sysmon\/Operational AND (((event.code:10 AND (winlog.event_data.TargetImage:(*\\lsass.exe OR *\\svchost.exe OR *\\explorer.exe OR *\\browser.exe)) AND (winlog.event_data.GrantedAccess:(0x1F1FFF OR 0x1F3FFF OR 0x1438))) OR (event.code:8 AND (process.executable:(*\\Users\\* OR *\\Temp\\* OR *\\AppData\\*)) AND winlog.event_data.condition:selection_remote_thread\ and\ NOT\ \(SourceProcessId\ \=\=\ TargetProcessId\))) AND (process.executable:(*\\winword.exe OR *\\excel.exe OR *\\powershell.exe OR *\\rundll32.exe)) AND (NOT ((process.executable:(*\\CcmExec.exe OR *\\MsMpEng.exe OR *\\Taskmgr.exe OR *\\Sysmon.exe)) OR winlog.event_data.CallTrace:*unknown* OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM)))
