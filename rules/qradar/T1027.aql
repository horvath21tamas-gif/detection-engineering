SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%')) AND (("Process CommandLine" LIKE '%-enc%' OR "Process CommandLine" LIKE '%-encodedcommand%')) AND (("Process CommandLine" LIKE '%-nop%' OR "Process CommandLine" LIKE '%-noni%' OR "Process CommandLine" LIKE '%-windowstyle hidden%' OR "Process CommandLine" LIKE '%-w hidden%')) AND (("Process CommandLine" LIKE '%Invoke-WebRequest%' OR "Process CommandLine" LIKE '%iwr %' OR "Process CommandLine" LIKE '%wget %' OR "Process CommandLine" LIKE '%curl %' OR "Process CommandLine" LIKE '%DownloadString%' OR "Process CommandLine" LIKE '%DownloadFile%' OR "Process CommandLine" LIKE '%Net.WebClient%' OR "Process CommandLine" LIKE '%http://%' OR "Process CommandLine" LIKE '%https://%')) AND (("Process CommandLine" LIKE '%IEX%' OR "Process CommandLine" LIKE '%Invoke-Expression%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\Installer\\%' OR "ParentImage" LIKE '%\\Microsoft Configuration Manager\\%' OR "ParentImage" LIKE '%\\Windows\\CCM\\%' OR "ParentImage" LIKE '%\\PDQ\\%' OR "ParentImage" LIKE '%\\Ivanti\\%' OR "ParentImage" LIKE '%\\Tanium\\%' OR "ParentImage" LIKE '%\\ManageEngine\\%' OR "ParentImage" LIKE '%\\Automation\\%' OR "ParentImage" LIKE '%\\Scripts\\%'))
