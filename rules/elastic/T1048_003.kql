((process.command_line:(*\ \-type\=TXT* OR *\ \-querytype\=TXT* OR *\ \-q\=TXT* OR *\ \-class\=IN*)) OR winlog.event_data.processcommandline:\(?i\)nslookup.*\[A\-Za\-z0\-9\+\/\=\]\{30,\}\\. OR (process.command_line:*ping\ * AND winlog.event_data.processcommandline:.*\ \-l\ \(1\[0\-9\]\{3\}\|\[2\-9\]\[0\-9\]\{3\}\).*)) AND (((process.executable.caseless:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Public\\*)) AND (process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\certutil.exe OR *\\nslookup.exe))) OR (process.parent.executable.caseless:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\wscript.exe OR *\\cscript.exe))) AND (NOT ((process.executable.caseless:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) OR (process.command_line:(*microsoft.com* OR *127.0.0.1* OR *localhost*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM" OR process.parent.executable.caseless:*\\services.exe))
