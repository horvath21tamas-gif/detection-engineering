((process.executable:*\\netsh.exe AND process.pe.original_file_name:netsh.exe AND (process.command_line:*advfirewall\ firewall\ add\ rule* AND process.command_line:*action\=allow* AND process.command_line:*protocol\=UDP*) AND (process.command_line:(*protocol\=ICMP* OR *localport\=any* OR *remoteport\=any*))) OR ((process.executable:(*\\tcpdump.exe OR *\\windump.exe OR *\\scapy.exe OR *\\nmap.exe OR *\\hping.exe)) AND (process.command_line:(*\ \-i\ * OR *sniffer* OR *npcap* OR *winpcap*)))) AND ((process.parent.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\wscript.exe OR *\\cscript.exe)) AND (process.executable:(*\\Users\\* OR *\\Temp\\* OR *\\Downloads\\* OR *\\AppData\\* OR *\\ProgramData\\*))) AND (NOT (user.name:NT\ AUTHORITY\\* AND (process.executable:(*\\Windows\\System32\\svchost.exe* OR *\\Program\ Files\\Windows\ Defender\\* OR *\\Program\ Files\\CrowdStrike\\* OR *\\Program\ Files\\SentinelOne\\*)) AND process.command_line:*description\=*))
