DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\odbcconf.exe" or OriginalFileName =~ "odbcconf.exe") and (ProcessCommandLine in ("*REGSVR*", "*regsvr*", "* /a *")) and ((ProcessCommandLine in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*", "*\Downloads\*", "*.txt*", "*.dat*", "*.png*", "*\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\powershell.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe"))) and (not (ParentProcessName startswith "C:\Windows\Installer\" and User =~ "NT AUTHORITY\SYSTEM"))