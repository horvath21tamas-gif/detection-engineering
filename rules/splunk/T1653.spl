Image="*\\powercfg.exe" OR OriginalFileName="PowerCfg.exe" CommandLine IN ("* -hibernate off*", "* -x *", "* -setacvalueindex *", "* -requestsoverride *", "* SCHEME_MIN *") OR CommandLine IN ("* 0*", "* 000*") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\psexec.exe") NOT (ParentImage="*C:\\Windows\\System32\\SystemSettingsAdminFlows.exe*" OR CommandLine="*monitor-timeout-ac*")
