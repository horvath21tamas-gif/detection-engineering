SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\InstallUtil.exe' AND "ImageName"='InstallUtil.exe' AND (("Integrity Level" LIKE '%Low%' OR "Integrity Level" LIKE '%Medium%')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\ProgramData\%') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('% /u %','% /uninstall %','% /LogToConsole=false%','% /logfile=%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Public\%','%\Downloads\%','%\PerfLogs\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%http://%','%https://%','%\\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe'))) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\Microsoft.NET\Framework\%','C:\Windows\Microsoft.NET\Framework64\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\trustedinstaller.exe')) AND "Integrity Level"='High') AND NOT "username" ILIKE 'NT AUTHORITY\%'
