DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath endswith "\certutil.exe" and (ProcessCommandLine in ("*-exportPFX*", "*-user -export*", "*-p *"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Export-PfxCertificate*", "*Export-Certificate*", "* -Password*")))) or (ProcessCommandLine in ("*crypto::certificates*", "*crypto::keys*", "*patch*", "*certificates /pvk*")) or (ProcessCommandLine in ("*copy *", "*move *", "*type *"))) and (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*")) and (not ((FolderPath in ("*\Windows\System32\certsrv.exe*", "*\Windows\System32\certmgr.dll*")) and (ParentProcessName in ("*\services.exe", "*\svchost.exe")) and User =~ "NT AUTHORITY\SYSTEM"))