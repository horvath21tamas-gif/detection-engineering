SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\wevtutil.exe' AND "Process "Process CommandLine"" ILIKE '% sl %' AND "Process "Process CommandLine"" ILIKE '%/e:false%' OR ""Filename"" ILIKE '%\wevtutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% cl %','% clear-log %')) OR ""Filename"" ILIKE '%\sc.exe' AND "Process "Process CommandLine"" ILIKE '% config %' AND "Process "Process CommandLine"" ILIKE '% eventlog %' AND "Process "Process CommandLine"" ILIKE '% start=%' AND "Process "Process CommandLine"" ILIKE '% disabled%' OR ""Filename"" ILIKE '%\sc.exe' AND "Process "Process CommandLine"" ILIKE '% stop %' AND "Process "Process CommandLine"" ILIKE '% eventlog %' OR (""Filename"" ILIKE ENUMERATION('%\net.exe','%\net1.exe')) AND "Process "Process CommandLine"" ILIKE '% stop %' AND "Process "Process CommandLine"" ILIKE '% eventlog %' OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND "Process "Process CommandLine"" ILIKE '%Stop-Service%' AND "Process "Process CommandLine"" ILIKE '%eventlog%' OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND "Process "Process CommandLine"" ILIKE '%Set-Service%' AND "Process "Process CommandLine"" ILIKE '%eventlog%' AND "Process "Process CommandLine"" ILIKE '%Disabled%' OR ""Filename"" ILIKE '%\reg.exe' AND "Process "Process CommandLine"" ILIKE '% add %' AND "Process "Process CommandLine"" ILIKE '%HKLM\SYSTEM\CurrentControlSet\Services\EventLog%' AND "Process "Process CommandLine"" ILIKE '% Start%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% 4%','%0x4%')) OR ""Filename"" ILIKE '%\reg.exe' AND "Process "Process CommandLine"" ILIKE '% add %' AND "Process "Process CommandLine"" ILIKE '%\Services\EventLog\%' AND "Process "Process CommandLine"" ILIKE '% Enabled%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% 0%','%0x0%')) OR ""Filename"" ILIKE '%\reg.exe' AND "Process "Process CommandLine"" ILIKE '%DependOnService%' AND "Process "Process CommandLine"" ILIKE '%EventLog%') AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\w3wp.exe','%\mshta.exe','%\rundll32.exe')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe','%\msiexec.exe'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\ConfigurationManager\%','%\IntuneManagementExtension\%','%\PDQDeploy\%','%\ManageEngine\%','%\BigFix\%')) AND NOT "username" ILIKE '%TrustedInstaller%'
