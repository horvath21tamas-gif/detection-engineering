Image IN ("*\\tscon.exe", "*\\mstsc.exe") OR OriginalFileName IN ("tscon.exe", "mstsc.exe") CommandLine IN ("* /shadow:*", "* /no-consent-prompt*", "* /control*", "* /dest:rdp-tcp#*") OR (ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\psexesvc.exe", "*\\wsmprovhost.exe", "*\\httpd.exe") IntegrityLevel="System") NOT (ParentImage IN ("*\\svchost.exe", "*\\Taskmgr.exe") OR CommandLine IN ("*C:\\Program Files\\Remote Desktop*", "*Citrix*", "*VMware*") OR username="NT AUTHORITY\\NETWORK SERVICE")
