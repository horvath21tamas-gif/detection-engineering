source="WinEventLog:Security" (EventCode IN (4768, 4769) TicketEncryptionType="0x17" Status="0x0") OR (EventCode=4768 TicketOptions IN ("0x40810000", "0x40810010")) OR (EventCode=4688 CommandLine IN ("*klist purge*", "*kerberos::ptt*", "*monitor /interval*")) NOT (TargetUserName="*$" OR ServicePrincipalName="*krbtgt*" OR IpAddress="10.0.0.5")
