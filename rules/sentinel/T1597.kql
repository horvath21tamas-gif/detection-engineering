DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("* --mirror*", "* -m *", "* --recursive*", "* -r *", "* --no-parent*", "* --level=*", "* -l *")) or (FolderPath in ("*\httrack.exe", "*\cygwin\bin\wget.exe"))) or (ProcessCommandLine in ("*/.git/*", "*/.env*", "*/web.config*", "*/robots.txt*", "*/wp-config.php*", "*/backup/*", "*/conf/*", "*/sql_dump*"))) and (not ((FolderPath in ("*\chrome.exe", "*\msedge.exe")) and (ProcessCommandLine in ("*--type=*", "*--service-sandbox-type=*")))) and (not ((FolderPath in ("*\git.exe", "*\code.exe")) or (ProcessCommandLine in ("*git pull*", "*git clone*", "*npm install*")))) and (not ((ParentProcessName in ("*\services.exe", "*\svchost.exe")) and username =~ "NT AUTHORITY\SYSTEM"))