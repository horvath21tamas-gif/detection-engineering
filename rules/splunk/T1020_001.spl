Image IN ("*\\OneDrive.exe", "*\\Dropbox.exe", "*\\googledrivesync.exe", "*\\Box.exe") CommandLine IN ("* /move *", "* /upload *", "* /shutdown*", "* -s *", "* --path *") OR CommandLine IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Windows\\Temp\\*", "*\\PerfLogs\\*", "*C:\\Temp\\*") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe") NOT (CommandLine IN ("* /background*", "* /client=personal*") OR username="NT AUTHORITY\\SYSTEM" OR Image="*\\Program Files\\*")
