((process.command_line:(*combo* OR *proxylist* OR *capture* OR *threads* OR *SentryMBA* OR *OpenBullet*)) OR (process.command_line:(*user\:pass* OR *wordlist* OR *passlist* OR *accounts.txt* OR *combos.txt*))) AND ((process.executable.caseless:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Downloads\\* OR *\\Public\\*)) AND (process.executable.caseless:(*\\python.exe OR *\\pythonw.exe OR *\\node.exe OR *\\powershell.exe))) AND (NOT ((process.executable.caseless:(*\\chrome.exe OR *\\msedge.exe OR *\\firefox.exe OR *\\brave.exe)) OR (process.parent.executable.caseless:(*\\Program\ Files\\* OR *\\Windows\\System32\\*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM"))
