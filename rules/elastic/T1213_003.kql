(process.command_line:(*\/wiki\/display\/* OR *\/wiki\/spaces\/* OR *\/wiki\/pages\/viewpage* OR *\/rest\/api\/content* OR *\/rest\/api\/content?expand\=body* OR *\/exportword* OR *\/exportpdf* OR *stackoverflow.com\/c\/* OR *.wiki.git* OR *\/_git\/* OR *\/docs\/* OR *\/knowledgebase\/* OR *\/kb\/*)) AND (process.executable:(*\\wget.exe OR *\\curl.exe OR *\\httrack.exe OR *\\python.exe OR *\\git.exe OR *\\powershell.exe OR *\\node.exe OR *\\pwsh.exe)) AND ((process.command_line:(*\ \-\-mirror* OR *\ \-\-recursive* OR *\ \-r\ * OR *\ \-\-level\ * OR *\ \-\-convert\-links* OR *\ \-\-page\-requisites* OR *\ \-\-no\-parent* OR *\ \-\-accept\ pdf* OR *\ \-\-accept\ doc* OR *\ \-\-accept\ zip* OR *\ clone\ * OR *\ archive\ * OR *\ \-\-depth\ * OR *\ \-\-bare*)) OR ((process.parent.executable:(*\\cmd.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\services.exe OR *\\w3wp.exe)) AND (winlog.event_data.IntegrityLevel:(Medium OR High))) OR (process.command_line:(*.zip* OR *.7z* OR *.tar* OR *.gz* OR *\ \-o\ * OR *\ \-\-output\ * OR *\ \-\-output\-document\=*))) AND (NOT ((process.executable:(*C\:\\Program\ Files\\Elastic\\* OR *C\:\\Program\ Files\\Splunk\\* OR *C\:\\Program\ Files\\Backup* OR *C\:\\Program\ Files\\Atlassian\\*)) OR (user.name:(NT\ AUTHORITY\\* OR DOMAIN\\svc_* OR DOMAIN\\backup_*)) OR (process.command_line:(*\ \-\-version* OR *\ healthcheck* OR *\ status* OR *\ \-\-help*))))
