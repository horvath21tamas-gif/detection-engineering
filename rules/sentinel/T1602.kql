DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("* -Recurse*", "* /s *", "* -Include *", "* -Filter *", "*robocopy*", "*xcopy*", "*Copy-Item*", "*Copy-File*")) and (ProcessCommandLine in ("*\\*", "*net use*", "*net view*", "*New-PSDrive*")) and (ProcessCommandLine in ("*.doc*", "*.docx*", "*.xls*", "*.xlsx*", "*.pdf*", "*.pst*", "*.kdbx*", "*.key*", "*.config*", "*id_rsa*", "*.zip*", "*.7z*", "*.rar*")) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\rundll32.exe", "*\explorer.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Program Files\Microsoft System Center\*", "*C:\Windows\CCM\*", "*C:\Program Files\Veritas\*", "*C:\Program Files\Commvault\*", "*C:\Program Files\Veeam\*")) or (ProcessCommandLine in ("*SoftwareDistribution*", "*.log*")) or username =~ "NT AUTHORITY\SYSTEM"))