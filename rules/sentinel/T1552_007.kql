DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*/var/run/secrets/kubernetes.io/serviceaccount*", "*/run/secrets/*", "*.docker/config.json*", "*/etc/kubernetes/admin.conf*", "*secret.yml*")) or ((ProcessCommandLine contains "env" and ProcessCommandLine contains "grep") or (ProcessCommandLine contains "printenv" and ProcessCommandLine contains "token") or (ProcessCommandLine contains "cat" and ProcessCommandLine contains "base64") or ProcessCommandLine contains "export")) and ((ParentProcessName in ("*/sh", "*/bash", "*/zsh", "*/dash", "*/kubectl")) and (ParentProcessName in ("*/nginx*", "*/httpd*", "*/php*"))) and (not ((ProcessCommandLine in ("*/usr/local/bin/docker-entrypoint.sh*", "*/init.sh*")) and User =~ "fluentd" and FolderPath contains "/usr/bin/promtail"))