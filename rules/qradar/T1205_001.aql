SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\tcpdump.exe','%\windump.exe','%\scapy.exe','%\nmap.exe','%\hping.exe')) AND (("ImageName" LIKE '%tcpdump.exe%' OR "ImageName" LIKE '%windump.exe%' OR "ImageName" LIKE '%scapy.exe%' OR "ImageName" LIKE '%nmap.exe%' OR "ImageName" LIKE '%hping.exe%')) OR "Process "Process CommandLine"" ILIKE '%advfirewall firewall add rule%' AND "Process "Process CommandLine"" ILIKE '%action=allow%' AND "Process "Process CommandLine"" ILIKE '%protocol=UDP%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%protocol=ICMP%','%localport=any%','%remoteport=any%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\Temp\%','%\Downloads\%','%\AppData\%','%\ProgramData\%')) AND NOT ("username" ILIKE 'NT AUTHORITY\%' AND (""Filename"" ILIKE ENUMERATION('%\Windows\System32\svchost.exe%','%\Program Files\Windows Defender\%','%\Program Files\CrowdStrike\%','%\Program Files\SentinelOne\%')) AND "Process "Process CommandLine"" ILIKE '%description=%')
