DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\wevtutil.exe" and ProcessCommandLine contains "/e:false") or (FolderPath endswith "\wevtutil.exe" and (ProcessCommandLine in ("* cl *", "* clear-log*"))) or (FolderPath endswith "\sc.exe" and (ProcessCommandLine contains "config" and ProcessCommandLine contains "eventlog" and ProcessCommandLine contains "start=" and ProcessCommandLine contains "disabled")) or ((FolderPath in ("*\net.exe", "*\net1.exe")) and (ProcessCommandLine in ("*stop*", "*eventlog*"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Set-Service*", "*eventlog*", "*Stopped*"))) or (FolderPath endswith "\reg.exe" and (ProcessCommandLine contains "add" and ProcessCommandLine contains "HKLM\SYSTEM\CurrentControlSet\Services\EventLog" and ProcessCommandLine contains "Start") and (ProcessCommandLine in ("*0x4*", "* 4*"))) or (FolderPath endswith "\reg.exe" and (ProcessCommandLine contains "add" and ProcessCommandLine contains "\Services\EventLog\" and ProcessCommandLine contains "Enabled") and (ProcessCommandLine in ("*0x0*", "* 0*")))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\w3wp.exe", "*\mshta.exe", "*\rundll32.exe")) or (not ((User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe", "*\msiexec.exe"))) or (ParentProcessName in ("*\ConfigurationManager\*", "*\IntuneManagementExtension\*", "*\PDQDeploy\*", "*\ManageEngine\*")) or ProcessCommandLine contains "TrustedInstaller")))