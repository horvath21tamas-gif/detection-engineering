SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\w3wp.exe','%\sqlservr.exe','%\wmiprvse.exe') OR "Process "Process CommandLine"" ILIKE '% -w %' AND "Process "Process CommandLine"" ILIKE '% hidden %' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -enc%','% -encoded%','%iex(%','%DownloadString%','%FromBase64String%'))) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%C:\Program Files\Microsoft Monitoring Agent\%','%C:\Windows\System32\Configuration\ManagedInstall%') OR ""Parent Filename"" ILIKE '%\services.exe')
