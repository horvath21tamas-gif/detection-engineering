SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\certutil.exe','%\certmgr.exe','%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% Root%','% AuthRoot%','% TrustedPublisher%','% Cert:\LocalMachine\Root%','% Cert:\CurrentUser\Root%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -f%','% -enterprise%','% -user%','% -silent%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\%','%\Users\Public\%','%\Downloads\%','%\Desktop\%','%\Temp\%','%\ProgramData\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\acrord32.exe','%\mshta.exe','%\wscript.exe','%\cscript.exe','%\rundll32.exe','%\regsvr32.exe')) OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%Zone.Identifier%','%SaveZoneInformation%','%LowRiskFileTypes%','%Unblock-File%','%streams.exe -d%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\%','%\Users\Public\%','%\Downloads\%','%\Desktop\%','%\Temp\%','%\ProgramData\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\acrord32.exe','%\mshta.exe','%\wscript.exe','%\cscript.exe','%\rundll32.exe','%\regsvr32.exe') OR NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%')))) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('C:\Windows\System32\msiexec.exe%','C:\Windows\System32\svchost.exe%','C:\Windows\servicing\TrustedInstaller.exe%','C:\Program Files\Microsoft Endpoint Manager\%','C:\Program Files\Microsoft Configuration Manager\%')) AND "username" ILIKE 'NT AUTHORITY\SYSTEM%')
