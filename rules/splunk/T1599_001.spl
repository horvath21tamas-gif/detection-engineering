Message IN ("*import-target*", "*export-target*", "*ip route vrf*", "*switchport mode trunk*", "*vlan-stacking*", "*brctl addif*", "*set protocols evpn*", "*bridge-group*") Message IN ("*native vlan*", "*permit any*", "*allow-all*", "*no shutdown*", "*spanning-tree portfast*", "*storm-control*") OR Message IN ("*line vty*", "*console*", "*ssh-session*", "*telnet-session*") NOT (SourceIP IN ("10.50.0.10", "10.50.0.11") OR Message IN ("*switchport mode access*", "*description *", "*banner motd*", "*ntp server*")) | table Time,SourceIP,User,Message,Interface,VLAN,VRF,Command
