CommandLine IN ("*crypto::*", "*crypto::export*", "*patch*", "*certificates /export*", "*find-certificate*") OR (Image="*\\certutil.exe" CommandLine IN ("*-exportPFX*", "*-exportp12*", "*-p *")) OR CommandLine IN ("*.pfx*", "*.p12*", "*.p7b*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*", "*C:\\PerfLogs\\*") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\psexesvc.exe", "*\\httpd.exe") Image IN ("*\\certutil.exe", "*\\powershell.exe") NOT (username="NT AUTHORITY\\SYSTEM" ParentImage="*\\msiexec.exe" Image="*\\Windows\\System32\\*")
