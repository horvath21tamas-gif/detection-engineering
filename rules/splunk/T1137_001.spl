TargetFilename="*\\AppData\\Roaming\\Microsoft\\Templates\\*" TargetFilename IN ("*\\Normal.dotm", "*\\NormalEmail.dotm") EventType IN ("Create", "Write", "Modify", "Rename", "Delete") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe") OR Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Windows\\Temp\\*") OR NOT (Image IN ("*\\winword.exe", "*\\outlook.exe", "*\\OfficeClickToRun.exe")) NOT (Image IN ("*\\Windows\\ccm\\*", "*\\IntuneManagementExtension\\*", "*\\Tanium\\*", "*\\Program Files\\OneDrive\\*", "*\\MigrateUser.exe*")) NOT (User IN ("NT AUTHORITY\\*", "NT SERVICE\\*"))
