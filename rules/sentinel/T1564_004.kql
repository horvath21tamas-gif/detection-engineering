DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine matches regex "(\\s>\\s.*:.*|\\stype\\s.*:.*|\\sexpand\\s.*:.*|\\smakecab\\s.*:.*|\\sfindstr\\s.*:.*)" or ProcessCommandLine matches regex "(\\sstart\\s.*:.*|wmic\\sprocess\\s+call\\s+create|control\\.exe\\s.*:.*|rundll32\\.exe\\s.*:.*|regsvr32\\.exe\\s+/s\\s.*:.*)" or (ProcessCommandLine in ("* -stream *", "*Set-Content*", "*Add-Content*", "*Get-Item*", "* -alternate *", "*Get-Content -Stream*", "*Remove-Item -Stream*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\mshta.exe", "*\w3wp.exe", "*\powershell.exe", "*\cmd.exe")) or (not ((ProcessCommandLine in ("*:Zone.Identifier*", "*:favicon*", "*:\Windows\*")) and username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\Windows\System32\svchost.exe*", "*\Windows\System32\services.exe*"))))) and (not ((ProcessCommandLine in ("*:Zone.Identifier*", "*:favicon*", "*:\Windows\*")) and username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\Windows\System32\svchost.exe*", "*\Windows\System32\services.exe*"))))