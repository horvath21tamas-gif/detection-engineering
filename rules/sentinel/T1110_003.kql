DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*Invoke-PasswordSpray*", "*Invoke-LocalPasswordSpray*", "*DomainPasswordSpray*", "*Test-ADCredential*", "*Get-ADUser*", "*userlist*", "*user-file*", "*pass-file*")) or (ProcessCommandLine contains "for /f" and ProcessCommandLine contains "net" and ProcessCommandLine contains "use")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*")) and (FolderPath in ("*\python.exe", "*\powershell.exe"))) and (not ((ParentProcessName in ("*\Program Files\Microsoft Azure AD Connect\*", "*\Program Files\Puppet Labs\*", "*\Windows\System32\inetsrv\w3wp.exe*")) and username =~ "NT AUTHORITY\SYSTEM"))