SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\outlook.exe','%\winword.exe','%\excel.exe','%\powerpnt.exe','%\mspub.exe','%\visio.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\scrcons.exe','%\hh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\AppData\Local\Microsoft\Windows\INetCache\%','%\Downloads\%','%\Users\Public\%','%C:\ProgramData\%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\AcroRd32.exe')) AND "ParentCommandLine" ILIKE '%\Common Files\Microsoft Shared\ClickToRun\%' OR ""Filename"" ILIKE ENUMERATION('%\splwow64.exe','%\werfault.exe'))
