Image IN ("*/sh", "*/bash", "*/zsh", "*/dash", "*/ash") ParentImage IN ("*/httpd", "*/apache2", "*/nginx", "*/php-fpm", "*/python", "*/node", "*/mysqld", "*/postgres", "*/redis-server") OR CommandLine IN ("*/dev/tcp/*", "*/dev/udp/*", "*interactive*", "*>&*", "*0>&1*") OR (CommandLine="*curl*" CommandLine="*|*" CommandLine="*sh*") OR (CommandLine="*wget*" CommandLine="*-O-*") NOT (ParentImage IN ("*/systemd", "*/sbin/init") OR CommandLine IN ("*/var/lib/apt/*", "*/tmp/terraform_*", "*logrotate*") OR (username="root" Parentprocessname="/usr/sbin/sshd"))
