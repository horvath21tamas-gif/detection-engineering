(Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("* -encoded*", "* -enc*", "* -e *")) OR CommandLine IN ("* 0*", "* 1*", "* 2*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe", "*\\php-cgi.exe", "*\\mshta.exe") OR NOT ((username="NT AUTHORITY\\SYSTEM" ParentImage="*\\services.exe") OR CommandLine IN ("*AzureAD*", "*Exchange*") OR ParentImage="*\\Windows\\System32\\wbem\\wmiprvse.exe*")
