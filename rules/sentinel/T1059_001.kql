DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*-enc*", "*-encodedcommand*")) and (ProcessCommandLine in ("*-nop*", "*-w hidden*", "*-windowstyle hidden*", "*-executionpolicy bypass*", "*FromBase64String*", "*IEX*", "*Invoke-Expression*")) and (ParentProcessName in ("*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe", "*\WINWORD.EXE", "*\EXCEL.EXE", "*\POWERPNT.EXE")) and (not ((User in ("*NT AUTHORITY\SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*")) or (ParentProcessName in ("*\Windows\CCM\*", "*\Microsoft Configuration Manager\*", "*\SCCM\*", "*\Tanium\*", "*\PDQ\*", "*\Ivanti\*", "*\ManageEngine\*", "*\Intune\*", "*\Elastic\*", "*\Splunk\*"))))