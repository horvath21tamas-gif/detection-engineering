CommandLine IN ("*.bash_history*", "*.zsh_history*", "*ConsoleHost_history.txt*", "*.mysql_history*", "*.psql_history*") CommandLine IN ("*base64*", "*curl*", "*wget*", "*nc *", "*scp *", "* > *", "* | clip*") OR ParentImage IN ("*\\httpd.exe", "*\\nginx.exe", "*\\php-cgi.exe", "*\\wsmprovhost.exe", "*\\psexesvc.exe") NOT (Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\bash.exe", "*\\zsh.exe", "*\\conhost.exe"))
