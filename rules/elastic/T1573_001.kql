(process.command_line:(*AesManaged* OR *RijndaelManaged* OR *.Mode\ \=\ \[System.Security.Cryptography.CipherMode\]\:\:* OR *.Padding\ \=\ \[System.Security.Cryptography.PaddingMode\]\:\:* OR *CreateEncryptor\(* OR *CreateDecryptor\(*)) AND (process.command_line:(*CryptoStream* OR *FlushFinalBlock* OR *.Key\ \=* OR *.IV\ \=*)) AND (process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\mshta.exe OR *\\rundll32.exe)) AND (NOT ((process.command_line:(*C\:\\Program\ Files\\* OR *Microsoft\\Azure* OR *SoftwareDistribution*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\services.exe OR *\\explorer.exe))))
