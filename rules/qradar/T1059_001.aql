SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%' OR "Filename" LIKE '%\\cmd.exe%')) AND (("Process CommandLine" LIKE '%-enc%' OR "Process CommandLine" LIKE '%-encodedcommand%' OR "Process CommandLine" LIKE '%-EncodedCommand%'))