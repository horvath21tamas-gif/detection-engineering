(Image="*\\wmic.exe" CommandLine IN ("*root\\subscription*", "*__EventFilter*", "*CommandLineEventConsumer*", "*FilterToConsumerBinding*")) OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*Register-WmiEvent*", "*Set-WmiInstance*", "*New-CimInstance*", "*root\\subscription*")) NOT (User="*SYSTEM*" OR Image IN ("*\\Microsoft Monitoring Agent\\*", "*\\SCOM\\*", "*\\System Center\\*", "*\\Tanium\\*", "*\\Qualys\\*", "*\\CrowdStrike\\*", "*\\SentinelOne\\*", "*\\SplunkUniversalForwarder\\*", "*\\Datadog\\*", "*\\Elastic\\Agent\\*") OR CommandLine IN ("*HealthCheck*", "*Inventory*", "*Monitoring*"))
