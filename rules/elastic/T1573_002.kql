((process.command_line:(*ServerCertificateValidationCallback* OR *return\ $true* OR *ServicePointManager\]\:\:Expect100Continue* OR *SecurityProtocolType\]\:\:Tls12*)) OR (process.command_line:(*RSACryptoServiceProvider* OR *FromXmlString* OR *ImportSubjectPublicKeyInfo* OR *X509Certificate2*))) AND (process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\rundll32.exe OR *\\regsvr32.exe)) AND (NOT ((process.command_line:(*C\:\\Program\ Files\\* OR *Microsoft\\Azure* OR *HealthCheck*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR process.parent.executable:*\\services.exe))
