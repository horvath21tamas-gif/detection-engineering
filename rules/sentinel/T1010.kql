DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*.MainWindowTitle*", "*Get-Process | select*", "*Get-Process | Where-Object*")) or (ProcessCommandLine in ("*EnumWindows*", "*GetWindowText*", "*GetForegroundWindow*"))) and ((ProcessCommandLine in ("* > *", "* | Export-Csv*", "*ConvertTo-Json*", "*base64*", "* | clip*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe")) and (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*")))) and (not (User =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Program Files\AnyDesk\*", "*\Program Files\TeamViewer\*"))))