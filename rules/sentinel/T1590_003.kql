DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath endswith "\nltest.exe" and (ProcessCommandLine in ("*/domain_trusts*", "*/all_trusts*", "*/dclist:*"))) or (FolderPath endswith "\netdom.exe" and ProcessCommandLine contains " trust ")) or ((FolderPath in ("*\net.exe", "*\net1.exe")) and (ProcessCommandLine in ("* share*", "* session*", "* view /*"))) or (ProcessCommandLine in ("*Get-NetDomainTrust*", "*Get-NetForestTrust*", "*Get-AdTrust*", "*Get-NetSession*"))) and (not (ProcessCommandLine contains "use " and (ParentProcessName in ("*\userinit.exe", "*\gpresult.exe", "*\gpscript.exe")))) and (not (User =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\services.exe", "*\svchost.exe")))) and (not (FolderPath in ("*\AdminArsenal\*", "*\SCCM\*")))