Image IN ("*\\pscp.exe", "*\\psftp.exe", "*\\scp.exe", "*\\sftp.exe", "*\\rclone.exe", "*\\winscp.com") CommandLine IN ("* -pw *", "* -batch*", "* -hostkey *", "* -ls *", "*copy*", "*sync*") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\powershell.exe") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*127.0.0.1*", "*localhost*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
