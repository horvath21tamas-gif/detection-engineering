SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%\Software\Microsoft\Office\%' AND "Target Object" ILIKE '%\Office Test\Special\Defrag' AND (("Target Details" LIKE '%\\AppData\\Local\\%' OR "Target Details" LIKE '%\\AppData\\Roaming\\%' OR "Target Details" LIKE '%C:\\Users\\Public\\%' OR "Target Details" LIKE '%C:\\Windows\\Temp\\%' OR "Target Details" LIKE '%\\Downloads\\%' OR "Target Details" LIKE '%\\%') OR ""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\reg.exe','%\cscript.exe','%\wscript.exe','%\rundll32.exe')) AND NOT (""Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\OfficeClickToRun.exe'))
