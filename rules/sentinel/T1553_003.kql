DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\makecat.exe", "*\signtool.exe", "*\pvk2pfx.exe", "*\inf2cat.exe", "*\certutil.exe")) and ProcessCommandLine contains ".cat" and ((ProcessCommandLine in ("*\AppData\*", "*\Users\Public\*", "*\Downloads\*", "*\Desktop\*", "*\PerfLogs\*", "*\Temp\*", "*\ProgramData\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\acrord32.exe", "*\mshta.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\regsvr32.exe", "*\cmd.exe", "*\powershell.exe", "*\pwsh.exe")) or (not (User in ("*NT AUTHORITY\SYSTEM*", "*NT AUTHORITY\LOCAL SERVICE*", "*NT AUTHORITY\NETWORK SERVICE*")))) and (not ((ParentProcessName in ("C:\Windows\servicing\TrustedInstaller.exe*", "C:\Windows\System32\svchost.exe*", "C:\Windows\System32\dism.exe*", "C:\Windows\System32\TiWorker.exe*", "C:\Program Files\Microsoft Configuration Manager\*")) and User startswith "NT AUTHORITY\SYSTEM")) and (not (ProcessCommandLine in ("*\Windows Kits\*", "*\WDK\*")))