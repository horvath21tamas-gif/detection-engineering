SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\bitsadmin.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/transfer%','%/addfile%','%http://%','%https://%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Downloads\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Tanium\%','%\Intune\%','%\WindowsUpdate\%'))
