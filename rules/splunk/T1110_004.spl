CommandLine IN ("*combo*", "*proxylist*", "*capture*", "*threads*", "*SentryMBA*", "*OpenBullet*") OR CommandLine IN ("*user:pass*", "*wordlist*", "*passlist*", "*accounts.txt*", "*combos.txt*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*") Image IN ("*\\python.exe", "*\\pythonw.exe", "*\\node.exe", "*\\powershell.exe") NOT (Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe", "*\\brave.exe") ParentImage IN ("*\\Program Files\\*", "*\\Windows\\System32\\*") username="NT AUTHORITY\\SYSTEM")
