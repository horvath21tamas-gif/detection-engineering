CommandLine IN ("*/wiki/display/*", "*/wiki/spaces/*", "*/wiki/pages/viewpage*", "*/rest/api/content*", "*/rest/api/content*expand=body*", "*/exportword*", "*/exportpdf*", "*stackoverflow.com/c/*", "*.wiki.git*", "*/_git/*", "*/docs/*", "*/knowledgebase/*", "*/kb/*") Image IN ("*\\wget.exe", "*\\curl.exe", "*\\httrack.exe", "*\\python.exe", "*\\git.exe", "*\\powershell.exe", "*\\node.exe", "*\\pwsh.exe") CommandLine IN ("* --mirror*", "* --recursive*", "* -r *", "* --level *", "* --convert-links*", "* --page-requisites*", "* --no-parent*", "* --accept pdf*", "* --accept doc*", "* --accept zip*", "* clone *", "* archive *", "* --depth *", "* --bare*") OR (ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\services.exe", "*\\w3wp.exe") IntegrityLevel IN ("Medium", "High")) OR CommandLine IN ("*.zip*", "*.7z*", "*.tar*", "*.gz*", "* -o *", "* --output *", "* --output-document=*") NOT (Image IN ("*C:\\Program Files\\Elastic\\*", "*C:\\Program Files\\Splunk\\*", "*C:\\Program Files\\Backup*", "*C:\\Program Files\\Atlassian\\*") OR User IN ("NT AUTHORITY\\*", "DOMAIN\\svc_*", "DOMAIN\\backup_*") OR CommandLine IN ("* --version*", "* healthcheck*", "* status*", "* --help*")) | table User,Image,ParentImage,CommandLine,IntegrityLevel,CurrentDirectory,Hashes
