SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\python.exe','%\nircmd.exe','%\mshta.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Get-Clipboard%','%Set-Clipboard%','%Clipboard%','%System.Windows.Forms.Clipboard%','%WriteProcessMemory%','%ReadProcessMemory%','%SetWindowsHook%','%Add-Type%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%invoice%','%payment%','%bank%','%iban%','%swift%','%account number%','%.pdf%','%.xlsx%','%.csv%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\iexplore.exe','%\firefox.exe','%\rundll32.exe','%\w3wp.exe','%\httpd.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\ProgramData\%','%\Windows\Temp\%')) AND NOT ("username" ILIKE 'NT AUTHORITY\%' AND (""Filename"" ILIKE ENUMERATION('C:\Program Files\%','C:\Program Files (x86)\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Backup%','%Inventory%','%AccountingService%','%SignService%')))
