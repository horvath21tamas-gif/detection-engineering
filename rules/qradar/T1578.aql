SELECT UTF8(payload) as search_payload from events where (("operation_name" LIKE '%DeleteSnapshot%' OR "operation_name" LIKE '%ModifyInstanceAttribute%' OR "operation_name" LIKE '%RevokeSecurityGroupIngress%' OR "operation_name" LIKE '%AuthorizeSecurityGroupIngress%' OR "operation_name" LIKE '%DeleteVpcPeeringConnection%')) AND (("request_parameters" LIKE '%0.0.0.0/0%' OR "request_parameters" LIKE '%::/0%' OR "request_parameters" LIKE '%all%') OR ("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%curl%' OR "user_agent" LIKE '%postman%')) AND NOT (("user_name" LIKE '%svc-terraform%' OR "user_name" LIKE '%system-internal%'))
