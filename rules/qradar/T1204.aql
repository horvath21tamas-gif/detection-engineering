SELECT UTF8(payload) as search_payload from events where (("ParentImage" LIKE '%\WINWORD.EXE%' OR "ParentImage" LIKE '%\EXCEL.EXE%' OR "ParentImage" LIKE '%\POWERPNT.EXE%' OR "ParentImage" LIKE '%\OUTLOOK.EXE%' OR "ParentImage" LIKE '%\MSACCESS.EXE%')) AND (("Image" LIKE '%\cmd.exe%' OR "Image" LIKE '%\powershell.exe%' OR "Image" LIKE '%\pwsh.exe%' OR "Image" LIKE '%\mshta.exe%' OR "Image" LIKE '%\rundll32.exe%' OR "Image" LIKE '%\regsvr32.exe%' OR "Image" LIKE '%\bitsadmin.exe%' OR "Image" LIKE '%\certutil.exe%'))
