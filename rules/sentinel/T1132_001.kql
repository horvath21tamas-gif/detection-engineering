DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine =~ "(TVqQA|TVpQA|f0VMR|UEsDB)" or (ProcessCommandLine =~ "(FromBase64String\(|-decode\s|\[System\.Convert\]::|IO\.MemoryStream|DeflateStream)" and ProcessCommandLine match "(*i).*[a-z0-9+/=]{1500,}.*")) and ((FolderPath =~ "(winword\.exe|excel\.exe|w3wp\.exe|sqlservr\.exe|spoolsv\.exe)$" and ParentProcessName =~ "(outlook\.exe|chrome\.exe)$") or (not (FolderPath =~ "(\Program Files\|\ccm\|\AzureConnectedMachineAgent\)" and ProcessCommandLine =~ "(Chocolatey|NuGet|Microsoft\.Cloud\.Data)" and UserName =~ "NT AUTHORITY\SYSTEM")))