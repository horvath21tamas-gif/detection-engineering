DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\python.exe", "*\pythonw.exe", "*\curl.exe", "*\wscript.exe", "*\cscript.exe")) and ((ProcessCommandLine in ("*\User Data\Default\Cookies*", "*\User Data\Default\Network\Cookies*", "*\User Data\Local State*", "*\Profiles\*\cookies.sqlite*")) or (ProcessCommandLine in ("*copy *", "*type *", "*tar *", "*zip *", "*Get-Content*", "*.ReadBytes*"))) and (not (((FolderPath in ("*\Google\Chrome\Application\*", "*\Microsoft\Edge\Application\*")) and (ProcessCommandLine in ("*--type=utility*", "*--utility-sub-type=network.mojom.NetworkService*"))) or (username =~ "NT AUTHORITY\SYSTEM" and FolderPath contains "\Windows\System32\svchost.exe")))