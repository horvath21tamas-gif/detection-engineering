SELECT UTF8(payload) as search_payload from events where "operationName"='Add user' AND "result"='success' AND "initiatedBy_user_userPrincipalName" ILIKE '%@%' AND ("ipAddress"='unusual_ip' OR ("userAgent" LIKE '%python-requests%' OR "userAgent" LIKE '%curl%' OR "userAgent" LIKE '%Postman%' OR "userAgent" LIKE '%Kali%')) AND NOT (("initiatedBy_app_displayName" LIKE '%Azure AD Connect%' OR "initiatedBy_app_displayName" LIKE '%Workday to Azure AD%' OR "initiatedBy_app_displayName" LIKE '%Okta Provisioning%' OR "initiatedBy_app_displayName" LIKE '%MS-PIM%'))
