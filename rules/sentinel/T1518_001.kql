DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\wmic.exe", "*\tasklist.exe", "*\sc.exe", "*\reg.exe", "*\net.exe")) or (ProcessCommandLine in ("*Get-Process*", "*Get-Service*", "*Get-ItemProperty*"))) and ((ProcessCommandLine in ("*defender*", "*sentinel*", "*falcon*", "*crowdstrike*", "*carbonblack*", "*fireeye*", "*cylance*", "*sophos*", "*antivirus*", "*firewall*")) or (ProcessCommandLine in ("*VBOX*", "*VMWARE*", "*VirtualBox*", "*Guest Additions*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe", "*\outlook.exe")) and IntegrityLevel =~ "Medium")) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\CcmExec.exe", "*\svchost.exe")) or (ProcessCommandLine in ("*Program Files*", "*Google\Update*"))))