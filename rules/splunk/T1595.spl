SrcIp IN ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*") Method IN ("GET", "HEAD", "OPTIONS") UriStem IN ("*/admin*", "*/login*", "*/config*", "*/setup*", "*/debug*", "*/test*", "*/backup*", "*/old*", "*/dev*", "*/server-status*", "*/phpinfo*", "*/.git*", "*/.env*", "*/wp-admin*", "*/actuator*") UserAgent IN ("*curl*", "*wget*", "*python*", "*go-http-client*", "*libwww*", "*scanner*", "*probe*", "*masscan*", "*nmap*", "*zgrab*", "*httpclient*", "*axios*", "*requests*") Status IN (200, 301, 302, 401, 403, 404) NOT (UserAgent IN ("*Mozilla*", "*Chrome*", "*Firefox*", "*Safari*", "*Edge*") OR UserAgent IN ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nikto*", "*nuclei*", "*zabbix*", "*prometheus*", "*uptime*", "*pingdom*", "*datadog*", "*newrelic*") OR (UriStem IN ("*/health*", "*/metrics*", "*/status/health*", "*/api*") UriStem IN ("*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.woff", "*.woff2", "*.map"))) | table SrcIp,Method,UriStem,Status,UserAgent
