source="WinEventLog:Security" EventData IN ("*\\rclone.exe*", "*\\bitsadmin.exe*", "*\\certutil.exe*", "*\\megatools.exe*", "*curl *", "*powershell*") EventData IN ("* sync *", "* upload *", "* -post *", "* -transfer *", "* -ExecutionPolicy Bypass *", "*WebClient.UploadFile*") OR EventData IN ("*<Interval>PT5M</Interval>*", "*<Interval>PT10M</Interval>*", "*<StartBoundary>202[0-9]-[0-9]{2}-[0-9]{2}T0[0-3]:*") NOT (EventData IN ("*\\Windows\\System32\\Tasks\\Microsoft*", "*\\Program Files\\*") OR SubjectUserName="SYSTEM" OR EventData="*Telemetry*")
