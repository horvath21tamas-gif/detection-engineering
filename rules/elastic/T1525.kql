(Image:(*\/docker OR *\/podman OR *\/containerd OR *\/ctr OR *\/crictl)) AND (CommandLine:(*\ run\ * OR *\ create\ * OR *\ start\ *)) AND (CommandLine:(*docker.io\/* OR *ghcr.io\/* OR *quay.io\/* OR *registry.hub.docker.com\/*)) AND (CommandLine:(*\:latest* OR *\:dev* OR *\:test* OR *\:debug*)) AND (NOT (CommandLine:(*registry.corp.local\/* OR *harbor.prod.local\/* OR *acr.company.com\/*))) AND (NOT (ParentImage:(*\/jenkins* OR *\/gitlab\-runner* OR *\/github\-actions* OR *\/azure\-pipelines* OR *\/tekton*))) AND (NOT (CommandLine:(*kube\-system* OR *istio\-system* OR *monitoring*))) AND (NOT (Hostname:(*build* OR *ci* OR *runner*)))
