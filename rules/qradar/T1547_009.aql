SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\%' OR "Filename" LIKE '%\\AppData\\Roaming\\Microsoft\\Internet Explorer\\Quick Launch\\User Pinned\\TaskBar\\%' OR "Filename" LIKE '%\\Desktop\\%')) AND "Filename" ILIKE '%.lnk' AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\bitsadmin.exe','%\certutil.exe','%\rundll32.exe')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\trustedinstaller.exe','%\is-%.tmp','%\setup.exe')) AND (""Filename"" ILIKE ENUMERATION('%\AppData\Local\Microsoft\Teams\%','%\AppData\Local\Google\Update\%')))
