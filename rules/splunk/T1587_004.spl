Image IN ("*\\csc.exe", "*\\vbc.exe", "*\\cl.exe", "*\\gcc.exe") OR CommandLine IN ("*/target:library*", "*/unsafe*") CommandLine IN ("*VirtualAllocEx*", "*WriteProcessMemory*", "*CreateRemoteThread*", "*QueueUserAPC*", "*NtMapViewOfSection*", "*0x90,0x90,0x90*", "*shellcode*") CommandLine IN ("*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*", "*C:\\Windows\\Temp\\*", "*\\PerfLogs\\*", "*\\Temporary ASP.NET Files\\*") NOT (User IN ("*svc_jenkins*", "*svc_deploy*", "*adm_build_master*") OR Image IN ("*\\Microsoft Visual Studio\\*", "*\\MSBuild\\*", "*\\actions-runner\\*")) NOT (ParentImage="*\\explorer.exe" condition="not selection_exploit_primitives")
