(Image="*/journalctl" CommandLine IN ("*--vacuum-time*", "*--vacuum-size*", "*--rotate*", "*--flush*")) OR Image IN ("*/truncate", "*/shred", "*/tee") OR CommandLine IN ("*> /var/log/*", "*>/var/log/*", "*/dev/null*") OR CommandLine IN ("*auth.log*", "*secure*", "*syslog*", "*wtmp*", "*lastlog*") ParentImage IN ("*/apache2", "*/nginx", "*/httpd", "*/php-fpm", "*/python*", "*/perl", "*/node") OR NOT (ParentImage IN ("*/logrotate", "*/systemd") OR CommandLine IN ("*logrotate.conf*", "*/var/lib/docker/containers*") OR (username="root" ParentImage="*/ansible"))
