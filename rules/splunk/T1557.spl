(Image="*\\reg.exe" CommandLine="*1*") OR CommandLine IN ("* -interface *", "* -r *", "* -f *", "* -LLMNR *", "* -NBTNS *", "* --spoof *", "*arpspoof*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*") Image IN ("*\\python.exe", "*\\pythonw.exe", "*\\powershell.exe") NOT (ParentImage IN ("*\\VMware\\*", "*\\Oracle\\VirtualBox\\*") OR (Image IN ("*\\Cisco\\AnyConnect\\*", "*\\OpenVPN\\*") username="NT AUTHORITY\\SYSTEM"))
