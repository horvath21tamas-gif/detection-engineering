Message IN ("*copy tftp flash*", "*copy ftp flash*", "*request system software add*", "*update firmware*", "*boot system flash*", "*install activate*", "*request platform software*") Message IN ("*tftp*", "*unauthenticated*", "*unknown source*", "*checksum failed*", "*hash mismatch*", "*signature validation failed*", "*untrusted image*", "*corrupt image*") NOT (SourceIP IN ("10.50.0.10", "10.50.0.11", "10.50.0.12") OR Message IN ("*copy running-config*", "*copy startup-config*", "*archive config*", "*save config*")) | table Time,SourceIP,DestinationIP,user_name,Message
