DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\pcalua.exe" and (ProcessCommandLine in ("*.exe*", "*.ps1*", "*.bat*", "*.vbs*", "*.dll*"))) or (FolderPath endswith "\forfiles.exe" and (ProcessCommandLine in ("*cmd*", "*powershell*", "*pwsh*", "*regsvr32*", "*mshta*", "*bitsadmin*"))) or (FolderPath endswith "\conhost.exe" and (ProcessCommandLine in ("* -- *", "* -e *")))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\w3wp.exe", "*\sqlservr.exe", "*\php-cgi.exe")) or (not ((username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\services.exe", "*\msiexec.exe", "*\TiWorker.exe"))) or (ProcessCommandLine in ("*\Windows\SoftwareDistribution\*", "*Program Files*")) or ParentProcessName endswith "\explorer.exe")))