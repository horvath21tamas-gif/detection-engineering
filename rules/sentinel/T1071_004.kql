DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\notepad.exe", "*\calc.exe", "*\winver.exe", "*\spoolsv.exe", "*\rundll32.exe", "*\regsvr32.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe")) and (QueryName matches regex "^.{64,255}\\..*$" or (QueryType in (16, 10, 33)))) and (IntegrityLevel =~ "Medium" and (ProcessCommandLine in ("*-enc*", "*nslookup*"))) and (not ((QueryName in ("*.microsoft.com", "*.windowsupdate.com", "*.google.com", "*.azure.com", "*.cloudfront.net", "*.akamaized.net")) or (FolderPath in ("*\chrome.exe*", "*\msedge.exe*", "*\firefox.exe*", "*\svchost.exe*"))))