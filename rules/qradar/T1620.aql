SELECT UTF8(payload) as search_payload from events where (("Process "Process CommandLine"" ILIKE ENUMERATION('%VirtualAlloc%','%VirtualProtect%','%WriteProcessMemory%','%CreateRemoteThread%','%GetDelegateForFunctionPointer%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%0x40%','%0x20%','%0x3000%')) OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%[System.Reflection.Assembly]::Load(%','%Reflection.Emit%','%Marshal.Copy%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%FromBase64String%','%IO.MemoryStream%','%IO.Compression%'))) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Visual Studio\%','%\MSBuild.exe%')) AND (("UserName" LIKE '%svc-build%' OR "UserName" LIKE '%cicd%')))
