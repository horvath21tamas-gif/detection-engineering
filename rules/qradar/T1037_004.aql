SELECT UTF8(payload) as search_payload from events where (("TargetFilename" LIKE '%/etc/rc.local%' OR "TargetFilename" LIKE '%/etc/rc.d/%' OR "TargetFilename" LIKE '%/etc/init.d/%' OR "TargetFilename" LIKE '%/etc/update-rc.d/%' OR "TargetFilename" LIKE '%/usr/lib/systemd/system-generators/%')) AND (""Filename"" ILIKE ENUMERATION('%/python','%/python3','%/perl','%/ruby','%/lua','%/bash','%/sh','%/nc','%/socat','%/curl','%/wget') OR ""Process CommandLine"" ILIKE ENUMERATION('%>>%','%tee -a%','%sed -i%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%/apt','%/dpkg','%/yum','%/dnf','%/rpm','%/zypper','%/pacman')) AND (""Filename"" ILIKE ENUMERATION('%/frontend','%/preinst','%/postinst')) OR ""Filename"" ILIKE ENUMERATION('%/ansible/%','%/salt/%','%/puppet/%'))
