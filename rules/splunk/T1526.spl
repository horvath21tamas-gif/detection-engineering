Image IN ("*\\aws.exe", "*\\az.cmd", "*\\gcloud.cmd") CommandLine IN ("*lambda list-functions*", "*secretsmanager list-secrets*", "*eks list-clusters*", "*keyvault list*", "*webapp list*", "*functionapp list*", "*functions list*", "*container clusters list*") CommandLine IN ("*--query*", "*--output json*", "* | jq*", "* | base64*", "* > *", "* | clip*") OR ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wsmprovhost.exe", "*\\httpd.exe") NOT (ParentImage IN ("*\\Jenkins\\*", "*\\GitLab-Runner\\*", "*\\Terraform\\*", "*\\Ansible\\*") username="NT AUTHORITY\\SYSTEM")
