winlog.channel:System AND ((event.code:(7036 OR 7040)) AND (winlog.event_data.ServiceName:(*WinDefend* OR *WdNisSvc* OR *Sense* OR *SecurityHealthService* OR *Sysmon* OR *EventLog* OR *SamSs* OR *VSS* OR *BITS* OR *wuauserv* OR *Backup* OR *MpsSvc*)) AND (NOT ((user.name:(*SYSTEM* OR *LOCAL\ SERVICE* OR *NETWORK\ SERVICE*)) OR (process.executable.caseless:(*\\Windows\\Installer\\* OR *\\Microsoft\\EdgeUpdate\\* OR *\\Google\\Update\\* OR *\\Mozilla\ Maintenance\ Service\\* OR *\\Adobe\\* OR *\\Microsoft\\Teams\\Update\\* OR *\\Windows\\CCM\\*)))))
