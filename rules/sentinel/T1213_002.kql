DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*Get-PnP*", "*Get-SPO*", "*Microsoft.SharePoint.PowerShell*", "*/_api/web/lists*", "*/_api/search/query*", "*Connect-PnPOnline*")) and ((ProcessCommandLine in ("* -All*", "* -Recurse*", "* -PageSize 1000*", "* -Limit All*", "*Export-PnPListItem*")) or (ProcessCommandLine in ("*\Users\Public\*", "*\Windows\Temp\*", "*\AppData\Local\Temp\*", "* -OutFile *"))) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\explorer.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Program Files\SharePoint Online Management Shell\*", "*C:\Program Files\Microsoft SDKs\SharePoint\*")) or username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*OneDrive.exe*", "*OfficeClickToRun.exe*"))))