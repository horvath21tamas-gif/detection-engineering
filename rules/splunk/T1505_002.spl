(Image="*\\appcmd.exe" OriginalFileName="appcmd.exe" CommandLine IN ("*install module*", "*add module*", "*uninstall module*", "*remove module*", "*image-path*", "*dllpath*")) OR ((Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\notepad.exe", "*\\cmd.exe") CommandLine IN ("*\\inetsrv\\Config\\applicationHost.config*", "*\\inetsrv\\Config\\web.config*")) OR CommandLine IN ("*\\AppData\\*", "*\\Temp\\*", "*\\Users\\Public\\*", "*\\PerfLogs\\*", "*\\ProgramData\\*", "*\\Downloads\\*", "*\\Desktop\\*") NOT ((username="NT AUTHORITY\\SYSTEM" Image IN ("*\\Windows\\System32\\inetsrv\\iissetup.exe*", "*\\Windows\\SoftwareDistribution\\*")) OR Image IN ("*\\ngen.exe", "*\\msiexec.exe", "*\\svchost.exe")))
