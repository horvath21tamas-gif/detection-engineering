SELECT eventTime, eventName, userIdentity.arn, userIdentity.type, sourceIPAddress, userAgent, requestParameters, awsRegion from events where (("eventName" LIKE '%AuthorizeSecurityGroupIngress%' OR "eventName" LIKE '%AuthorizeSecurityGroupEgress%' OR "eventName" LIKE '%RevokeSecurityGroupIngress%' OR "eventName" LIKE '%RevokeSecurityGroupEgress%' OR "eventName" LIKE '%CreateSecurityGroup%' OR "eventName" LIKE '%DeleteSecurityGroup%') OR ("eventName" LIKE '%CreateNetworkAclEntry%' OR "eventName" LIKE '%ReplaceNetworkAclEntry%' OR "eventName" LIKE '%DeleteNetworkAclEntry%') OR ("eventName" LIKE '%UpdateWebACL%' OR "eventName" LIKE '%PutWebACL%' OR "eventName" LIKE '%DeleteWebACL%' OR "eventName" LIKE '%UpdateRuleGroup%')) AND ("requestParameters.ipPermissions.items.ipRanges.items.cidrIp"='0.0.0.0/0' AND "requestParameters.ipPermissions.items.ipv6Ranges.items.cidrIpv6"='::/0' OR "requestParameters.ipPermissions.items.ipProtocol"='-1' OR (("requestParameters.ipPermissions.items.fromPort" LIKE '%22%' OR "requestParameters.ipPermissions.items.fromPort" LIKE '%3389%' OR "requestParameters.ipPermissions.items.fromPort" LIKE '%5985%' OR "requestParameters.ipPermissions.items.fromPort" LIKE '%5986%')) AND (("requestParameters.ipPermissions.items.toPort" LIKE '%22%' OR "requestParameters.ipPermissions.items.toPort" LIKE '%3389%' OR "requestParameters.ipPermissions.items.toPort" LIKE '%5985%' OR "requestParameters.ipPermissions.items.toPort" LIKE '%5986%'))) AND ("userIdentity.type"='Root' OR "userIdentity.sessionContext.attributes.mfaAuthenticated"='false' OR ("userAgent" LIKE '%python-requests%' OR "userAgent" LIKE '%curl%' OR "userAgent" LIKE '%wget%' OR "userAgent" LIKE '%kali%' OR "userAgent" LIKE '%postman%' OR "userAgent" LIKE '%bot%') OR "userAgent" ILIKE '%aws-cli%') AND NOT (("userIdentity.arn" LIKE '%role/Terraform%' OR "userIdentity.arn" LIKE '%role/CloudFormation%' OR "userIdentity.arn" LIKE '%role/AWSServiceRole%' OR "userIdentity.arn" LIKE '%role/SecurityAutomation%' OR "userIdentity.arn" LIKE '%role/OrganizationAccountAccessRole%') OR ("userIdentity.invokedBy" LIKE '%autoscaling.amazonaws.com%' OR "userIdentity.invokedBy" LIKE '%elasticloadbalancing.amazonaws.com%'))
