Image="*\\msbuild.exe" OR OriginalFileName="MSBuild.exe" ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\wmiprvse.exe") OR CommandLine IN ("*http*", "*\\*", "*\\AppData\\*", "*\\Temp\\*", "*.xml*") NOT (ParentImage IN ("*\\Microsoft Visual Studio\\*", "*\\Common7\\IDE\\*", "*\\BuildAgent\\*", "*\\Jenkins\\*", "*\\ServiceFabric\\*") CommandLine IN ("*/p:Configuration=*", "*.sln*", "*.csproj*") User="*svc_build*")
