(process.executable:(*\\robocopy.exe OR *\\xcopy.exe OR *\\powershell.exe OR *\\7z.exe OR *\\rar.exe OR *\\bitsadmin.exe)) AND (process.command_line:(*\ D\:\\* OR *\ E\:\\* OR *\ F\:\\* OR *\ G\:\\* OR *\ H\:\\* OR *\\Device\\HarddiskVolume* OR *\\*\\root\\*)) AND ((process.command_line:(*\ \/S\ \/E\ \/H\ \/K\ \/R\:0\ \/W\:0* OR *\ \-Recurse* OR *\ \-Hidden* OR *\ \-ExecutionPolicy\ Bypass* OR *\ a\ \-p*)) OR (process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\sqlservr.exe OR *\\wscript.exe))) AND (NOT (process.parent.executable:*\\explorer.exe OR process.executable:*\\Program\ Files\\* OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR process.command_line:*Windows\\Logs*))
