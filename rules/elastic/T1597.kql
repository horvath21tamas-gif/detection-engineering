(((process.command_line:(*\ \-\-mirror* OR *\ \-m\ * OR *\ \-\-recursive* OR *\ \-r\ * OR *\ \-\-no\-parent* OR *\ \-\-level\=* OR *\ \-l\ *)) OR (process.executable:(*\\httrack.exe OR *\\cygwin\\bin\\wget.exe))) OR (process.command_line:(*\/.git\/* OR *\/.env* OR *\/web.config* OR *\/robots.txt* OR *\/wp\-config.php* OR *\/backup\/* OR *\/conf\/* OR *\/sql_dump*))) AND (NOT ((process.executable:(*\\chrome.exe OR *\\msedge.exe)) AND (process.command_line:(*\-\-type\=* OR *\-\-service\-sandbox\-type\=*)))) AND (NOT ((process.executable:(*\\git.exe OR *\\code.exe)) OR (process.command_line:(*git\ pull* OR *git\ clone* OR *npm\ install*)))) AND (NOT ((process.parent.executable:(*\\services.exe OR *\\svchost.exe)) AND winlog.event_data.username:NT\ AUTHORITY\\SYSTEM))
