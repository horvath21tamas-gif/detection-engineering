Image IN ("*\\wevtutil.exe", "*\\sed.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\sqlite3.exe", "*\\attrib.exe", "*\\netsh.exe", "*\\reg.exe", "*\\cmd.exe") CommandLine IN ("* cl *", "* clear-log *", "* -replace *", "* s/*", "* > *", "*Out-File*", "*Set-Content*", "* set dns *", "* set proxy *", "*AutoConfigURL*", "*ProxyEnable*", "*ProxyServer*") CommandLine IN ("*\\etc\\hosts*", "*\\System32\\winevt\\*", "*\\System32\\config\\*", "*.config*", "*.db*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\explorer.exe") NOT (ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe") OR CommandLine IN ("*Program Files*", "*Get-EventLog*") OR username="NT AUTHORITY\\SYSTEM") | table Time,SourceImage,ParentImage,CommandLine,SourceUsername
