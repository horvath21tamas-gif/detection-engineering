Message IN ("*software install*", "*request system software add*", "*firmware upgrade*", "*boot system flash*", "*install activate*", "*request platform software*", "*request system firmware*", "*request image install*") Message IN ("*tftp://*", "*ftp://*", "*http://*", "*.bin*", "*.tar*", "*.img*") OR Message IN ("*signature validation failed*", "*hash mismatch*", "*invalid image signature*", "*checksum error*", "*not a trusted image*", "*image verification failed*") NOT (SourceIP IN ("10.50.0.10", "10.50.0.11", "10.50.0.12") Message IN ("*scp://*", "*sftp://*", "*https://*", "*signed image*", "*trusted repository*")) | table Time,SourceIP,DestinationIP,Message
