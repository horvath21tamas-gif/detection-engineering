(Image="*\\appcmd.exe" OR OriginalFileName="appcmd.exe" CommandLine IN ("*install module*", "*add module*", "*image-path*")) OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\notepad.exe") OR CommandLine IN ("*\\inetsrv\\Config\\applicationHost.config*", "*\\inetsrv\\Config\\web.config*") OR CommandLine IN ("*\\AppData\\*", "*\\Temp\\*", "*\\Users\\Public\\*", "*\\PerfLogs\\*", "*\\ProgramData\\*") NOT ((username="NT AUTHORITY\\SYSTEM" Image IN ("*\\Windows\\System32\\inetsrv\\iissetup.exe*", "*\\Windows\\SoftwareDistribution\\*")) OR Image="*\\ngen.exe"))
