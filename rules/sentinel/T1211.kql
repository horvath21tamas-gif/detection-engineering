DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ParentProcessName in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\acrord32.exe", "*\acrobat.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\mshta.exe", "*\regsvr32.exe", "*\schtasks.exe", "*\fodhelper.exe", "*\eventvwr.exe", "*\computerdefaults.exe", "*\whoami.exe", "*\net.exe", "*\net1.exe")) and ((ProcessCommandLine in ("*-enc*", "*-encodedcommand*", "* bypass*", "* hidden*", "*http://*", "*https://*", "*FromBase64String*", "*DownloadString*", "*Invoke-Expression*", "*IEX *")) or ((ProcessCommandLine in ("*runas*", "* /savecred*", "*token::elevate*", "*uac*")) and (IntegrityLevel in ("High", "System"))))) and (not ((ProcessCommandLine in ("*--type=renderer*", "*--type=utility*", "*--type=gpu-process*", "*--type=extension*", "*Microsoft\EdgeUpdate*")) or ((FolderPath in ("*\WerFault.exe", "*\conhost.exe")) and ParentProcessCommandLine contains "TrustedInstaller.exe")))