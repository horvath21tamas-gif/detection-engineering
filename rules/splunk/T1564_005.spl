Image IN ("*\\diskpart.exe", "*\\powershell.exe", "*\\pwsh.exe") OR CommandLine IN ("*Mount-VHD*", "*Mount-DiskImage*", "*attach vdisk*", "*create vdisk*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe") OR (CommandLine IN ("*\\Users\\*", "*\\Downloads\\*", "*\\Temp\\*", "*\\AppData\\*", "*.iso*", "*.vhd*", "*.vhdx*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\Windows\\System32\\svchost.exe*", "*\\Program Files\\Hyper-V\\*", "*\\Program Files\\Microsoft Visual Studio\\*", "*\\CcmExec.exe*") OR CommandLine IN ("*Program Files*", "*WindowsImageBackup*")))
