CommandLine IN ("*/wiki/display/*", "*/wiki/pages/viewpage*", "*stackoverflow.com/c/*", "*.wiki.git*", "*/rest/api/content*expand=body*") Image IN ("*\\wget.exe", "*\\httrack.exe", "*\\python.exe", "*\\curl.exe", "*\\git.exe") CommandLine IN ("* --mirror*", "* --recursive*", "* -r *", "* --level *", "* clone *", "* --accept pdf,docx,zip*") OR (ParentImage IN ("*\\w3wp.exe", "*\\cmd.exe", "*\\powershell.exe") IntegrityLevel="Medium") NOT (Image IN ("*C:\\Program Files\\Elastic\\*", "*C:\\Program Files\\Splunk\\*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*healthcheck*", "* --version*"))
