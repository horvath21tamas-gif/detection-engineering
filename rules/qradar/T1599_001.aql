SELECT Time, SourceIP, User, Message, Interface, VLAN, VRF, Command from events where (("Message" LIKE '%import-target%' OR "Message" LIKE '%export-target%' OR "Message" LIKE '%ip route vrf%' OR "Message" LIKE '%switchport mode trunk%' OR "Message" LIKE '%vlan-stacking%' OR "Message" LIKE '%brctl addif%' OR "Message" LIKE '%set protocols evpn%' OR "Message" LIKE '%bridge-group%')) AND (("Message" LIKE '%native vlan%' OR "Message" LIKE '%permit any%' OR "Message" LIKE '%allow-all%' OR "Message" LIKE '%no shutdown%' OR "Message" LIKE '%spanning-tree portfast%' OR "Message" LIKE '%storm-control%') OR ("Message" LIKE '%line vty%' OR "Message" LIKE '%console%' OR "Message" LIKE '%ssh-session%' OR "Message" LIKE '%telnet-session%')) AND NOT (("SourceIP" LIKE '%10.50.0.10%' OR "SourceIP" LIKE '%10.50.0.11%') OR ("Message" LIKE '%switchport mode access%' OR "Message" LIKE '%description %' OR "Message" LIKE '%banner motd%' OR "Message" LIKE '%ntp server%'))
