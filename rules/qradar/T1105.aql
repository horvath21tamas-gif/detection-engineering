SELECT UTF8(payload) as search_payload from events where (("Image" LIKE '%\powershell.exe%' OR "Image" LIKE '%\bitsadmin.exe%' OR "Image" LIKE '%\certutil.exe%')) AND (("Process CommandLine" LIKE '%Invoke-WebRequest%' OR "Process CommandLine" LIKE '%IEX%' OR "Process CommandLine" LIKE '%DownloadFile%'))
