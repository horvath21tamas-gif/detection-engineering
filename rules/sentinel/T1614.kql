DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("*ipinfo.io*", "*ifconfig.me*", "*icanhazip.com*", "*api.ipify.org*", "*checkip.amazonaws.com*", "*ip-api.com*", "*ipwho.is*", "*freegeoip*")) and ((FolderPath in ("*\curl.exe", "*\powershell.exe", "*\pwsh.exe", "*\wget.exe")) and (ProcessCommandLine in ("*Invoke-WebRequest*", "*Invoke-RestMethod*", "*nslookup*", "*Resolve-DnsName*")))) or ((ProcessCommandLine in ("*Keyboard Layout\Preload*", "*Control Panel\International*", "*MUILanguages*", "*GeoID*", "*Get-ItemProperty*", "*reg query*")) and (ProcessCommandLine in ("*Get-Culture*", "*Get-WinSystemLocale*", "*Get-TimeZone*", "*Get-UICulture*")))) and (((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\mshta.exe")) and IntegrityLevel =~ "Medium") or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Temp\*", "*\ProgramData\*")) or (ProcessCommandLine in ("* > *", "*| Out-File*", "*ConvertTo-Json*", "*findstr*", "*select-string*"))) and (not (User in ("NT AUTHORITY\*", "NT SERVICE\*"))) and (not ((ParentProcessName in ("*\msiexec.exe", "*\CcmExec.exe", "*\svchost.exe", "*\IntuneManagementExtension.exe")) and (FolderPath in ("*\Program Files\*", "*\Splunk\*", "*\Tanium\*"))))