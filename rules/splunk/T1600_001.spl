(Image="*\\bcdedit.exe" CommandLine IN ("*nointegritychecks*", "*testsigning*", "*disable-elam-drivers*", "*nx AlwaysOff*", "*bootstatuspolicy ignoreallfailures*")) OR (CommandLine IN ("*ci.dll*", "*ntoskrnl.exe*", "*lsasrv.dll*", "*winload.efi*", "*winresume.efi*") Image IN ("*\\Users\\*", "*\\AppData\\Local\\Temp\\*", "*\\Downloads\\*", "*\\Desktop\\*")) OR CommandLine IN ("*KDU.exe*", "*EfiGuard*", "*TDL.exe*", "*DSEFix*", "*BcdPatcher*") NOT ((ParentImage IN ("*\\msiexec.exe", "*\\TrustedInstaller.exe", "*\\TiWorker.exe", "*\\explorer.exe") username="NT AUTHORITY\\SYSTEM") OR Image IN ("*\\Program Files\\Dell\\*", "*\\Program Files\\HP\\*", "*\\Program Files\\Lenovo\\*", "*\\Program Files (x86)\\Lenovo\\*")) | table Time,User,Image,ParentImage,CommandLine
