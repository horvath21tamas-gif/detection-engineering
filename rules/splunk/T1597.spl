CommandLine IN ("* --mirror*", "* -m *", "* --recursive*", "* -r *", "* --no-parent*", "* --level=*", "* -l *") OR Image IN ("*\\httrack.exe", "*\\cygwin\\bin\\wget.exe") OR CommandLine IN ("*/.git/*", "*/.env*", "*/web.config*", "*/robots.txt*", "*/wp-config.php*", "*/backup/*", "*/conf/*", "*/sql_dump*") NOT (Image IN ("*\\chrome.exe", "*\\msedge.exe") CommandLine IN ("*--type=*", "*--service-sandbox-type=*")) NOT (Image IN ("*\\git.exe", "*\\code.exe") OR CommandLine IN ("*git pull*", "*git clone*", "*npm install*")) NOT (ParentImage IN ("*\\services.exe", "*\\svchost.exe") username="NT AUTHORITY\\SYSTEM")
