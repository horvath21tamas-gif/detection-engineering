SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\AppData\\Roaming\\Microsoft\\Word\\STARTUP\\%' OR "Filename" LIKE '%\\AppData\\Roaming\\Microsoft\\Excel\\XLSTART\\%' OR "Filename" LIKE '%\\AppData\\Local\\Microsoft\\Office\\AddIns\\%')) AND (("Filename" LIKE '%.wll%' OR "Filename" LIKE '%.xll%')) AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\browser.exe','%\outlook.exe')) AND NOT ((("Filename" LIKE '%\\Adobe\\%' OR "Filename" LIKE '%\\Webex\\%')) AND (""Filename"" ILIKE ENUMERATION('%C:\Program Files\%','%C:\Program Files (x86)\%')))
