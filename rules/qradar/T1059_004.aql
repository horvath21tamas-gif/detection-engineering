SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/sh','%/bash','%/zsh','%/dash')) AND ((""Parent Filename"" ILIKE ENUMERATION('%/httpd','%/apache2','%/nginx','%/php-fpm','%/node','%/python','%/java')) AND (("UserName" LIKE '%www-data%' OR "UserName" LIKE '%apache%' OR "UserName" LIKE '%nginx%' OR "UserName" LIKE '%nobody%')) OR ""Process CommandLine"" ILIKE ENUMERATION('%/dev/tcp/%','%/dev/udp/%','%>&%','%0>&1%') OR ""Process CommandLine"" ILIKE '%curl%' AND ""Process CommandLine"" ILIKE '%|%' AND ""Process CommandLine"" ILIKE '%sh%' OR ""Process CommandLine"" ILIKE '%wget%' AND ""Process CommandLine"" ILIKE '%|%' AND ""Process CommandLine"" ILIKE '%bash%') AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/systemd','%/sbin/init') OR ""Process CommandLine"" ILIKE ENUMERATION('%/var/lib/apt/%','%logrotate%','%/usr/bin/mandb%') OR "username"='root' AND "Parentprocessname"='/usr/sbin/sshd')
