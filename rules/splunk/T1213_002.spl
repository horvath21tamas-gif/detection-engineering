CommandLine IN ("*Get-PnP*", "*Get-SPO*", "*Connect-PnPOnline*", "*Microsoft.SharePoint.PowerShell*", "*/_api/web/lists*", "*/_api/search/query*", "*Export-PnPListItem*", "*Get-PnPListItem*") CommandLine IN ("* -All*", "* -Recurse*", "* -PageSize 1000*", "* -Limit All*", "* -BatchSize *", "* -AsJob*") OR CommandLine IN ("*\\Users\\Public\\*", "*\\Windows\\Temp\\*", "*\\AppData\\Local\\Temp\\*", "* -OutFile *", "* -Path *") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\w3wp.exe", "*\\explorer.exe", "*\\taskhostw.exe") IntegrityLevel IN ("Medium", "High") NOT (Image IN ("*C:\\Program Files\\SharePoint Online Management Shell\\*", "*C:\\Program Files\\Microsoft SDKs\\SharePoint\\*", "*C:\\Program Files\\Office\\root\\Office*", "*C:\\Program Files\\OneDrive\\*") OR User IN ("NT AUTHORITY\\SYSTEM*", "DOMAIN\\svc_*", "DOMAIN\\backup_*") OR CommandLine IN ("*OfficeClickToRun.exe*", "*OneDrive.exe*", "*HealthCheck*", "* --version*", "* -help*")) | table User,Image,ParentImage,CommandLine,IntegrityLevel,CurrentDirectory,Hashes
