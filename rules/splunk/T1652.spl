"selection_cli_binary and selection_cli_enum" OR "selection_powershell_binary and selection_wmi_enum" CommandLine IN ("* > *", "*Out-File*", "*Export-Csv*", "*ConvertTo-Json*", "* | clip*", "*base64*", "*certutil -encode*") OR ParentImage IN ("*\\wsmprovhost.exe", "*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\rundll32.exe", "*\\httpd.exe", "*\\w3wp.exe") OR Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Windows\\Temp\\*") OR IntegrityLevel="Medium" NOT (Image IN ("*\\Program Files\\Tanium\\*", "*\\Program Files\\Splunk\\*", "*\\Program Files\\Datadog\\*", "*\\Program Files\\Elastic\\*", "*\\Windows\\System32\\CcmExec.exe*")) NOT (User IN ("NT AUTHORITY\\*", "NT SERVICE\\*")) NOT ParentImage="*\\explorer.exe"
