SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\certutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-exportPFX%','%-user -export%','%-p %')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Export-PfxCertificate%','%Export-Certificate%','% -Password%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%crypto::certificates%','%crypto::keys%','%patch%','%certificates /pvk%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%copy %','%move %','%type %')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Public\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\Windows\System32\certsrv.exe%','%\Windows\System32\certmgr.dll%') OR ""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe') OR "username" ILIKE 'NT AUTHORITY\%')
