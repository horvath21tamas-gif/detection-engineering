Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\powershell_ise.exe") OR filename IN ("PowerShell.EXE", "pwsh.dll", "powershell_ise.EXE") (CommandLine IN ("*Set-MpPreference*", "*Add-MpPreference*") CommandLine IN ("*DisableRealtimeMonitoring*", "*DisableBehaviorMonitoring*", "*DisableIOAVProtection*", "*ExclusionPath*", "*ExclusionExtension*", "*ExclusionProcess*", "*MAPSReporting*", "*SubmitSamplesConsent*") OR CommandLine IN ("*1*", "*$true*", "*NeverSend*")) OR CommandLine IN ("* -disablere*", "* -excl*") NOT (ParentImage IN ("*\\CcmExec.exe", "*\\Gpscript.exe") CommandLine="*Specific_Safe_Admin_Script.ps1*")
