CommandLine IN ("*New-InboxRule*", "*Set-InboxRule*", "*New-TransportRule*", "*Set-Mailbox *") CommandLine IN ("*-ForwardTo*", "*-ForwardAsAttachmentTo*", "*-RedirectTo*", "*-ForwardingSmtpAddress*") CommandLine IN ("*@gmail.com*", "*@outlook.com*", "*@protonmail.*", "*@tutanota.*", "*.ru*", "*.top*", "*.zip*") CommandLine IN ("*password*", "*invoice*", "*számla*", "*transfer*", "*bank*", "*confidential*") OR (ParentImage IN ("*\\powershell.exe", "*\\w3wp.exe", "*\\cmd.exe") IntegrityLevel="Medium") NOT (CommandLine IN ("*@sajatdomain.hu*", "*HealthCheck*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine="*Standard_Admin_Script.ps1*")
