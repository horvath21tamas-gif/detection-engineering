DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("*AADInternals*", "*MSAL.PS*", "*Okta.Auth*", "*Connect-AzureAD*", "*Connect-MgGraph*", "*AcquireToken*", "*DeviceCodeCredential*")) and (ProcessCommandLine in ("*Invoke-AADIntMFAFlood*", "*while($true)*", "*for($i=0*", "*Start-Sleep*", "*Send-PushNotification*", "*ApproveSignIn*", "*ShowPasswordPrompt*"))) or ((ProcessCommandLine in ("*puppeteer*", "*selenium-webdriver*", "*Playwright*", "*--headless*", "*--disable-gpu*", "*--remote-debugging-port*")) and (ProcessCommandLine in ("*-WindowStyle Hidden*", "*-ExecutionPolicy Bypass*", "*-NonInteractive*", "*-EncodedCommand*")))) and ((ProcessCommandLine in ("*-WindowStyle Hidden*", "*-ExecutionPolicy Bypass*", "*-NonInteractive*", "*-EncodedCommand*")) or (ParentProcessName in ("*\wsmprovhost.exe", "*\psexesvc.exe", "*\taskeng.exe", "*\schtasks.exe")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\ProgramData\*"))) and (not (FolderPath in ("*\Microsoft Azure AD Connect\*", "*\Microsoft Azure AD Sync\*", "*\OneDrive\*"))) and (not (User in ("NT AUTHORITY\*", "NT SERVICE\*"))) and (not (ParentProcessName endswith "\explorer.exe" and (ProcessCommandLine in ("*Connect-MgGraph -Scopes*", "*Connect-AzureAD*"))))