DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\ssh.exe", "*\sshd.exe")) or (OriginalFileName in ("ssh.exe", "sshd.exe"))) and ((ProcessCommandLine in ("* -L *", "* -R *", "* -D *", "* -N*", "* -f*")) or ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\httpd.exe", "*\winword.exe")) and (ProcessCommandLine in ("*StrictHostKeyChecking=no*", "*UserKnownHostsFile=/dev/null*"))) or (ParentProcessName endswith "\sshd.exe" and (ProcessCommandLine in ("* -enc *", "* -w hidden*", "*IEX*", "*DownloadString*")))) and (not ((ParentProcessName in ("*\Git\*", "*\VSCode\*", "*\JetBrains\*")) or (ProcessCommandLine in ("*git-upload-pack*", "*git-receive-pack*", "*vscode-remote*")) or username =~ "NT AUTHORITY\SYSTEM"))