Image IN ("*\\wmic.exe", "*\\tasklist.exe", "*\\sc.exe", "*\\reg.exe", "*\\net.exe") OR CommandLine IN ("*Get-Process*", "*Get-Service*", "*Get-ItemProperty*") CommandLine IN ("*defender*", "*sentinel*", "*falcon*", "*crowdstrike*", "*carbonblack*", "*fireeye*", "*cylance*", "*sophos*", "*antivirus*", "*firewall*") OR CommandLine IN ("*VBOX*", "*VMWARE*", "*VirtualBox*", "*Guest Additions*") OR (ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe", "*\\excel.exe", "*\\outlook.exe") IntegrityLevel="Medium") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\CcmExec.exe", "*\\svchost.exe") OR CommandLine IN ("*Program Files*", "*Google\\Update*"))
