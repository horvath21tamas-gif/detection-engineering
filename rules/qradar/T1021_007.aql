SELECT UTF8(payload) as search_payload from events where (("operationNameValue" LIKE '%Microsoft.Compute/virtualMachines/runCommand/action%' OR "operationNameValue" LIKE '%Microsoft.Compute/virtualMachines/extensions/write%' OR "operationNameValue" LIKE '%Microsoft.Resources/deployments/write%' OR "operationNameValue" LIKE '%Microsoft.Network/networkSecurityGroups/securityRules/write%' OR "operationNameValue" LIKE '%Microsoft.Web/sites/config/listcallbacks/action%')) AND (("callerIpAddress_not_in" LIKE '%1.2.3.4/32%' OR "callerIpAddress_not_in" LIKE '%5.6.7.8/24%')) AND (("userAgent_contains" LIKE '%python-requests%' OR "userAgent_contains" LIKE '%Go-http-client%' OR "userAgent_contains" LIKE '%curl%' OR "userAgent_contains" LIKE '%Postman%' OR "userAgent_contains" LIKE '%Az.Compute%') OR "properties.authenticationMethod_not"='MFA' AND "properties.resultSignature"='Succeeded') AND NOT ("caller_contains"='service-principal' OR "userAgent_contains"='HashiCorp/Terraform' OR "operationNameValue"='Microsoft.Compute/virtualMachines/runCommand/action' AND "caller"='system-auto-patcher@company.com')
