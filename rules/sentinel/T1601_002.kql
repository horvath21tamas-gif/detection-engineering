DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (Message in ("*software install*", "*request system software add*", "*firmware upgrade*", "*boot system flash*", "*install activate*", "*request platform software*", "*request system firmware*", "*request image install*")) and ((Message in ("*tftp://*", "*ftp://*", "*http://*", "*.bin*", "*.tar*", "*.img*")) or (Message in ("*signature validation failed*", "*hash mismatch*", "*invalid image signature*", "*checksum error*", "*not a trusted image*", "*image verification failed*"))) and (not ((SourceIP in ("10.50.0.10", "10.50.0.11", "10.50.0.12")) and (Message in ("*scp://*", "*sftp://*", "*https://*", "*signed image*", "*trusted repository*"))))