SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%password=%','%pwd=%','%connectionstring%','%access_key%','%secret_key%','%id_rsa%','%id_dsa%','%id_ed25519%','%amzn.mws%','%BEGIN RSA PRIVATE%','%BEGIN OPENSSH PRIVATE%','%BEGIN PGP PRIVATE%') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%findstr%','%/s%','%/i%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%grep%','%-r%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Get-ChildItem%','%-Recurse%','%-Include%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%dir%','%/s%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%where%','%/r%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.config%','%.xml%','%.ini%','%.yml%','%.env%','%.bak%','%.old%','%.history%','%ConsoleHost_history%','%.aws\credentials%','%.ssh\%','%.azure\%','%.docker\config.json%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\wsmprovhost.exe','%\httpd.exe','%\php-cgi.exe','%\nginx.exe')) AND (""Filename"" ILIKE ENUMERATION('%\findstr.exe','%\grep.exe','%\powershell.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%base64%','%certutil -encode%','% > %','%>>%','% | clip%','%curl %','%wget %','%scp %','%Invoke-WebRequest%','%-enc%','%-EncodedCommand%','%IEX%','%Invoke-Expression%') OR NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%'))) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Windows\System32\SearchIndexer.exe%','%\Microsoft Visual Studio\%','%\Git\usr\bin\grep.exe%','%\explorer.exe%')) AND ""Parent Filename"" ILIKE '%\explorer.exe')
