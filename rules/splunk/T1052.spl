Image IN ("*\\robocopy.exe", "*\\xcopy.exe", "*\\powershell.exe", "*\\7z.exe", "*\\rar.exe", "*\\bitsadmin.exe") CommandLine IN ("* D:\\*", "* E:\\*", "* F:\\*", "* G:\\*", "* H:\\*", "*\\Device\\HarddiskVolume*", "*\\*\\root\\*") CommandLine IN ("* /S /E /H /K /R:0 /W:0*", "* -Recurse*", "* -Hidden*", "* -ExecutionPolicy Bypass*", "* a -p*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\sqlservr.exe", "*\\wscript.exe") NOT (ParentImage="*\\explorer.exe" OR Image="*\\Program Files\\*" OR username="NT AUTHORITY\\SYSTEM" OR CommandLine="*Windows\\Logs*")
