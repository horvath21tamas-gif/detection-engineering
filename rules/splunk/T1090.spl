(CommandLine="*interface*" CommandLine="*portproxy*" CommandLine="*add*" CommandLine="*v4tov4*" CommandLine IN ("*listenport=*", "*connectaddress=*")) OR CommandLine IN ("* -socks5 *", "* -reverse *", "* -L:*", "* -R:*", "* --proxy-server=*") Image IN ("*\\netsh.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\regsvr32.exe") NOT (CommandLine IN ("*C:\\Program Files\\Docker*", "*C:\\Program Files\\WSL*", "*127.0.0.1*", "*::1*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
