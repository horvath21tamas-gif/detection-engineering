DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*\User Data\Local State*", "*\User Data\Default\Network\Cookies*", "*\User Data\Default\Login Data*", "*\Profiles\*\cookies.sqlite*")) and ((FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\python.exe", "*\sqlite3.exe", "*\certutil.exe", "*\curl.exe")) or (ProcessCommandLine in ("*copy *", "*type *", "*Get-Content*", "*base64*", "*.json*"))) and (not ((FolderPath in ("*\AppData\Local\Google\Chrome\Application\chrome.exe*", "*\Microsoft\Edge\Application\msedge.exe*", "*\Program Files\Mozilla Firefox\firefox.exe*")) and username =~ "NT AUTHORITY\SYSTEM"))