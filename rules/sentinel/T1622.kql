DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (GrantedAccess in ("0x400", "0x410", "0x1000", "0x1400", "0x1F0FFF", "0x1F1FFF")) and (CallTrace in ("*IsDebuggerPresent*", "*CheckRemoteDebuggerPresent*", "*NtQueryInformationProcess*", "*NtSetInformationThread*", "*OutputDebugString*", "*DbgBreakPoint*", "*DbgUiRemoteBreakin*")) and ((CallTrace in ("*UNKNOWN*", "*Unbacked*", "*MEM_PRIVATE*")) or (SourceImage in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\ProgramData\*")) or IntegrityLevel =~ "Medium") and (not (SourceImage in ("*\devenv.exe", "*\windbg.exe", "*\x64dbg.exe", "*\ollydbg.exe", "*\code.exe", "*\pycharm64.exe"))) and (not (SourceImage in ("*\WerFault.exe", "*\vsjitdebugger.exe", "*\csrss.exe"))) and (not (CallTrace in ("*clr.dll+*", "*mscor*"))) and (not (SourceImage in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*")))