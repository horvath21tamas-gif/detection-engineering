(((process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe)) OR (process.command_line:(*New\-InboxRule* OR *Set\-InboxRule* OR *Set\-Mailbox*)) OR (process.command_line:(*ForwardTo* OR *ForwardAsAttachmentTo* OR *RedirectTo* OR *DeliverToMailboxAndForward*))) OR (process.executable.caseless:*\\mgc.exe OR (process.command_line:(*messageRules* OR *mailFolders*)))) AND (NOT ((process.parent.executable.caseless:(*\\explorer.exe OR *\\outlook.exe)) AND winlog.event_data.condition:"not selection_powershell_rules")) AND (NOT (user.name:(*svc_exchange_migration* OR *adm_helpdesk_mail* OR *it_ops_automation*))) AND (NOT winlog.event_data.username:"NT AUTHORITY\\SYSTEM")
