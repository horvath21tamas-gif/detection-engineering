Image IN ("*\\aws.exe", "*\\az.cmd", "*\\gcloud.cmd") CommandLine IN ("*ec2 describe-instances*", "*s3 ls*", "*rds describe-db-instances*", "*ec2 describe-security-groups*", "*vm list*", "*storage account list*", "*network vnet list*", "*compute instances list*") CommandLine IN ("*--query*", "*--output json*", "* | jq*", "* | base64*", "* > *") OR ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wsmprovhost.exe", "*\\httpd.exe") NOT (ParentImage IN ("*\\Jenkins\\*", "*\\GitLab-Runner\\*", "*\\Terraform\\*", "*\\Ansible\\*") username="NT AUTHORITY\\SYSTEM")
