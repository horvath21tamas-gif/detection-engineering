SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%\Software\Classes\CLSID\%' AND (("Target Object" LIKE '%\\InprocServer32%' OR "Target Object" LIKE '%\\LocalServer32%')) AND (("Target Details" LIKE '%\\Users\\%' OR "Target Details" LIKE '%\\AppData\\%' OR "Target Details" LIKE '%\\Temp\\%' OR "Target Details" LIKE '%\\ProgramData\\%' OR "Target Details" LIKE '%\\Downloads\\%')) AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe','%\regsvr32.exe')) AND NOT ("username" ILIKE '%SYSTEM%' OR ("Target Details" LIKE '%C:\\Windows\\System32\\%' OR "Target Details" LIKE '%C:\\Windows\\SysWOW64\\%') OR ""Filename"" ILIKE ENUMERATION('%\Windows\Installer\%','%\Microsoft\EdgeUpdate\%','%\Google\Update\%','%\Mozilla Maintenance Service\%','%\Adobe\%','%\Microsoft\Teams\Update\%'))
