ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\nginx.exe", "*\\php-cgi.exe", "*\\tomcat.exe") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*index.html*", "*index.php*", "*default.aspx*", "*logo.*", "*echo *", "*move *", "*copy *", "*Set-Content*") CommandLine IN ("*\\inetpub\\wwwroot\\*", "*\\var\\www\\*", "*\\htdocs\\*") NOT (username IN ("AD\\svc_deploy", "AD\\github_actions") OR CommandLine IN ("*node_modules*", "*npm install*", "*composer install*") OR ParentImage="*\\msiexec.exe")
