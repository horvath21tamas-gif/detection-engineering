(process.executable:*\\netsh.exe OR process.pe.original_file_name:netsh.exe) AND (process.command_line:(*advfirewall* OR *firewall*)) AND (process.command_line:(*add* OR *set*)) AND (process.command_line:(*action\=allow* OR *enable\=yes*)) AND (NOT ((process.parent.executable:(*\\CcmExec.exe OR *\\msiexec.exe)) AND (process.command_line:(*show* OR *monitor* OR *profile\ state*))))
