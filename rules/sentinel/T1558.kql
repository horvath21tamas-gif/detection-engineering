DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*kerberoast*", "*asreproast*", "*asreq*", "*golden*", "*silver*", "*ptt*", "*tgtdelegate*", "*ms-mcs-admpwd*")) or (ProcessCommandLine in ("* /rc4*", "* 0x17*", "* /ticket:*", "* /service:*", "* /outfile:*"))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\php-cgi.exe")) and (FolderPath in ("*\rubeus.exe", "*\powershell.exe", "*\klist.exe"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Windows\System32\lsass.exe", "*\Windows\System32\svchost.exe")) and ParentProcessName endswith "\services.exe"))