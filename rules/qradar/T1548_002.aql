SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\fodhelper.exe' AND (("Integrity Level" LIKE '%High%' OR "Integrity Level" LIKE '%System%')) AND ""Parent Filename"" ILIKE '%\fodhelper.exe' AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\rundll32.exe','%\mshta.exe','%\wscript.exe','%\cscript.exe','%\regsvr32.exe','%\python.exe')) AND NOT ("username" ILIKE '%SYSTEM%' OR ""Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\PDQ\%','%\Ivanti\%'))
