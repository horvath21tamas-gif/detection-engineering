SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\rundll32.exe','%\cscript.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%user32.dll,SetWindowsHook%','%[User32]::GetAsyncKeyState%','%GetKeyboardState%','%RawInput%')) OR ("Process "Process CommandLine"" ILIKE ENUMERATION('% >> %','%out-file%')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\Temp\%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Invoke-Keystrokes%','%Get-Keystrokes%','%keylog_recorder%','%logkeys%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Program Files\%','%\Program Files (x86)\%')) AND "Process "Process CommandLine"" ILIKE '%node_modules%' AND "username" ILIKE 'NT AUTHORITY\%')
