CommandLine IN ("*AesManaged*", "*RijndaelManaged*", "*.Mode = [System.Security.Cryptography.CipherMode]::*", "*.Padding = [System.Security.Cryptography.PaddingMode]::*", "*CreateEncryptor(*", "*CreateDecryptor(*") CommandLine IN ("*CryptoStream*", "*FlushFinalBlock*", "*.Key =*", "*.IV =*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe") NOT (CommandLine IN ("*C:\\Program Files\\*", "*Microsoft\\Azure*", "*SoftwareDistribution*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
