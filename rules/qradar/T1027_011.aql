SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\7z.exe','%\7za.exe','%\rar.exe','%\WinRAR.exe','%\zip.exe','%\compact.exe','%\makecab.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -p%','% -hp%','% -mhe=on%','% -ta%','% -r %')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%','%\PerfLogs\%','%\RECYCLER\%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Microsoft\OneDrive\%','%\Dropbox\%','%\Google\Drive\%','%\Steam\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Update%','%Install%')))
