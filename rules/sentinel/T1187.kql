DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*@80\*", "*@SSL\*", "*davwwwroot*", "*\*\IPC$*")) or ((ProcessCommandLine in ("*EfsRpcOpenFileRaw*", "*RpcRemoteFindFirstPrinterChangeNotification*")) and ProcessCommandLine matches regex "(lsarpc|efsrpc)") or ProcessCommandLine matches regex "\\\\\\\\(?:[0-9]{1,3}\\.){3}[0-9]{1,3}\\\\.*\\$") and FolderPath matches regex "(?:\\\\Users\\\\|\\\\Temp\\\\|\\\\Downloads\\\\).*(powershell\\.exe|cmd\\.exe|python\\.exe|rundll32\\.exe)$" and (not ((ProcessCommandLine in ("*\SYSVOL\*", "*\NETLOGON\*")) and ParentProcessName matches regex "(services\\.exe|svchost\\.exe)$" and username =~ "NT AUTHORITY\SYSTEM"))