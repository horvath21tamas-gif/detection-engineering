SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\mimikatz%' OR "Filename" LIKE '%\\bloodhound%' OR "Filename" LIKE '%\\sharphound%' OR "Filename" LIKE '%\\cobaltstrike%' OR "Filename" LIKE '%\\metasploit%' OR "Filename" LIKE '%\\responder%' OR "Filename" LIKE '%\\pypykatz%' OR "Filename" LIKE '%\\impacket%' OR "Filename" LIKE '%\\chisel%' OR "Filename" LIKE '%\\ngrok%') OR ("Filename" LIKE '%\\nmap.exe%' OR "Filename" LIKE '%\\nc.exe%' OR "Filename" LIKE '%\\netcat.exe%' OR "Filename" LIKE '%\\socat.exe%' OR "Filename" LIKE '%\\7z.exe%')) AND (""Filename"" ILIKE ENUMERATION('%\certutil.exe','%\bitsadmin.exe','%\powershell.exe','%\pwsh.exe','%\curl.exe','%\wget.exe','%\csc.exe','%\msbuild.exe')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\sccm\%','%\tanium\%','%\pdq\%','%\intune\%','%\chocolatey\%')) AND "AccountName "='SYSTEM')
