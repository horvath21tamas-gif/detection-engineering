SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/python','%/python3','%/python2','%/pythonw.exe')) AND (""Process CommandLine"" ILIKE ENUMERATION('%import socket%','%pty.spawn%','%base64.b64decode%','%requests.get%','%os.system%') OR ""Parent Filename"" ILIKE ENUMERATION('%/httpd','%/apache2','%/nginx','%/php-fpm','%/w3wp.exe','%/sqlservr.exe','%/redis-server')) AND NOT (""Process CommandLine"" ILIKE ENUMERATION('%yum %','%dnf %','%cloud-init%','%aws-cli%') OR ""Parent Filename"" ILIKE ENUMERATION('%/systemd','%/sbin/init') OR "username"='root' AND "Parentprocessname"='/usr/sbin/sshd')
