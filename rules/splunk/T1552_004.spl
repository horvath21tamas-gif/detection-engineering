CommandLine IN ("*BEGIN RSA PRIVATE*", "*BEGIN DSA PRIVATE*", "*BEGIN EC PRIVATE*", "*BEGIN OPENSSH PRIVATE*", "*BEGIN PGP PRIVATE*", "*BEGIN PRIVATE KEY*") OR CommandLine IN ("*.ppk*", "*.pem*", "*.key*", "*.pfx*", "*id_rsa*") CommandLine IN ("*findstr*", "*/s*") OR CommandLine IN ("*grep*", "*-r*") OR (CommandLine="*Get-ChildItem*" CommandLine="*-Recurse*") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\psexesvc.exe", "*\\httpd.exe") Image IN ("*\\findstr.exe", "*\\grep.exe", "*\\powershell.exe") NOT (username="NT AUTHORITY\\SYSTEM" Image IN ("*\\OpenSSH\\ssh-agent.exe*", "*\\Git\\usr\\bin\\ssh.exe*", "*\\Microsoft Visual Studio\\*", "*\\Windows\\System32\\certutil.exe*"))
