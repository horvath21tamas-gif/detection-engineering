(process.command_line:(*New\-MailboxExportRequest* OR *New\-ComplianceSearch* OR *Search\-Mailbox*)) AND ((process.command_line:(*\-ContentFilter* OR *\-TargetMailbox* OR *\-FilePath\ \\\\* OR *\-Subject*)) OR (process.command_line:(*password* OR *invoice* OR *budget* OR *confidential* OR *\ \-Force* OR *\ \-ErrorAction\ SilentlyContinue*))) AND ((process.parent.executable.caseless:(*\\powershell.exe OR *\\w3wp.exe OR *\\cmd.exe)) AND winlog.event_data.IntegrityLevel:High) AND (NOT ((winlog.event_data.username:("NT AUTHORITY\\SYSTEM" OR SVC_BACKUP_EXCH)) OR (process.command_line:(*HealthCheck.ps1* OR *Maintenance* OR *\\Standard_Backup_Path\\*))))
