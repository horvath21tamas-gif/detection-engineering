SELECT UTF8(payload) as search_payload from events where "operationName"='Add user' AND "result"='success' AND (("userAgent" LIKE '%AzureCLI%' OR "userAgent" LIKE '%AzurePowerShell%' OR "userAgent" LIKE '%GraphExplorer%' OR "userAgent" LIKE '%python-requests%')) AND NOT (("identity" LIKE '%Sync_%' OR "identity" LIKE '%On-Premises Directory Synchronization%' OR "identity" LIKE '%ManagedIdentity%') OR "identity" ILIKE '%MS-PIM%' OR ("identity" LIKE '%Workday_Sync%' OR "identity" LIKE '%Okta_Provisioner%'))
