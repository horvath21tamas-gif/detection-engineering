DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath =~ "(w32tm\.exe|tzutil\.exe|net\.exe|net1\.exe)$" and ProcessCommandLine =~ "(Get-Date|Get-TimeZone|\[System\.DateTime\]::Now)") and (ProcessCommandLine =~ "( /query| /g|time \)" or (ParentProcessName =~ "(winword\.exe|excel\.exe|outlook\.exe|httpd\.exe|wsmprovhost\.exe)$" and IntegrityLevel =~ "Medium") or ProcessCommandLine match "(findstr|select-string| > |\$time\s*=)") and (not (username =~ "NT AUTHORITY\SYSTEM" and ParentProcessName =~ "(svchost\.exe|CcmExec\.exe|msiexec\.exe|explorer\.exe)$" and ProcessCommandLine =~ "(Program Files|\AppData\Local\Google\Chrome)"))