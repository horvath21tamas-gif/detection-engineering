SELECT UTF8(payload) as search_payload from events where "email_content_type" ILIKE '%text/html%' AND "url" IMATCHES '.+' AND (("url" LIKE '%bit.ly/%' OR "url" LIKE '%tinyurl.com/%' OR "url" LIKE '%t.co/%' OR "url" LIKE '%rebrand.ly/%' OR "url" LIKE '%is.gd/%' OR "url" LIKE '%cutt.ly/%') OR "url_domain_age" < 30 AND "url_reputation"='low') AND (("sender_display_name" LIKE '%Microsoft%' OR "sender_display_name" LIKE '%Office 365%' OR "sender_display_name" LIKE '%OneDrive%' OR "sender_display_name" LIKE '%DocuSign%' OR "sender_display_name" LIKE '%PayPal%' OR "sender_display_name" LIKE '%Bank%')) AND NOT (("sender_domain" LIKE '%microsoft.com%' OR "sender_domain" LIKE '%office.com%' OR "sender_domain" LIKE '%docusign.com%' OR "sender_domain" LIKE '%paypal.com%')) AND NOT (("url" LIKE '%microsoft.com%' OR "url" LIKE '%google.com%' OR "url" LIKE '%amazon.com%' OR "url" LIKE '%github.com%' OR "url" LIKE '%linkedin.com%'))
