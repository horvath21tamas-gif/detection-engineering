DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\python.exe", "*\pythonw.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe")) and (ProcessCommandLine in ("* -i *", "* -r *", "* -force*", "* -wpad*", "* -p *", "*LLMNR*", "*NBTNS*", "*mDNS*", "*Responder*", "*Inveigh*", "*mitm6*", "*SMBRelay*"))) or ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (ProcessCommandLine in ("* -i *", "* -r *", "* -force*", "* -wpad*", "* -p *", "*LLMNR*", "*NBTNS*", "*mDNS*", "*Responder*", "*Inveigh*", "*mitm6*", "*SMBRelay*")))) and User startswith "NT AUTHORITY\" and (not (((FolderPath in ("*\svchost.exe", "*\lsass.exe", "*\System32\nbtstat.exe")) and username =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\Program Files\Wireshark\*", "*\Program Files\Nmap\*", "*\Program Files\CrowdStrike\*", "*\Program Files\OpenVPN\*", "*\Program Files\Microsoft\Network Monitor\*"))))