SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%\Software\Microsoft\Office\%' AND (("Target Object" LIKE '%\\Outlook\\WebView\\URL%' OR "Target Object" LIKE '%\\Outlook\\Security\\EnableRoamingFolderHomepages%' OR "Target Object" LIKE '%\\Outlook\\Security\\EnableExternalFolderHomepages%')) AND (("Target Details" LIKE '%http%' OR "Target Details" LIKE '%script%' OR "Target Details" LIKE '%file://%' OR "Target Details" LIKE '%C:\\Users\\Public%' OR "Target Details" LIKE '%C:\\Windows\\Temp%') OR ""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\reg.exe','%\cscript.exe','%\wscript.exe')) AND NOT ((("Target Details" LIKE '%https://outlook.office365.com%' OR "Target Details" LIKE '%res://%')) AND ""Filename"" ILIKE '%\gpscript.exe')
