(Image="*\\attrib.exe" CommandLine="* +h*" CommandLine="* +s*") OR CommandLine IN ("* > *:*", "*type *:*", "*expand *:*", "*makecab *:*", "*findstr /v *:*", "*start *:*") OR (Image="*\\reg.exe" CommandLine="*SpecialAccounts\\UserList*" CommandLine="* /d 0*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\mshta.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\browser.exe") OR CommandLine IN ("*\\Users\\Public\\*", "*\\Windows\\Temp\\*", "*\\AppData\\Roaming\\*", "*\\Downloads\\*") NOT (username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\Windows\\servicing\\TrustedInstaller.exe*", "*\\CcmExec.exe*", "*\\Windows\\System32\\wbem\\WMIC.exe*") CommandLine IN ("*AppData\\Local\\Packages*", "*desktop.ini*", "*Program Files*")) | table Time,SourceImage,ParentImage,CommandLine,SourceUsername,TargetFilePath,FileAttributes
