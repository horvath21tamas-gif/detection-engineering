Image="*\\rundll32.exe" CommandLine IN ("*javascript:*", "*RunHTMLApplication*", "*mshtml,*", "*http://*", "*https://*", "*scrobj.dll*", "*shell32.dll,ShellExec_RunDLL*") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe") OR CommandLine IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*") NOT (CommandLine IN ("*\\Windows\\System32\\*", "*\\Windows\\SysWOW64\\*") OR ParentImage IN ("*\\Windows\\Installer\\*", "*\\Program Files\\*", "*\\Program Files (x86)\\*", "*\\DriverStore\\*", "*\\Dell\\*", "*\\HP\\*", "*\\Lenovo\\*", "*\\Intel\\*"))
