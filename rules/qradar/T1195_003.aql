SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\flashrom.exe','%\flashprog.exe','%\RWEverything.exe','%\amifldrv64.sys','%\AfuEfix64.exe','%\H2OFFT-W.exe','%\FPT.exe')) AND (""Filename"" ILIKE ENUMERATION('%\Users\Public\%','%\AppData\Local\Temp\%','%\Downloads\%','%C:\Windows\Temp\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\outlook.exe','%\winword.exe','%\excel.exe')) AND NOT (""Filename"" ILIKE ENUMERATION('%\Dell\CommandUpdate\%','%\Lenovo\SystemUpdate\%','%\HP\SupportAssistant\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\TrustedInstaller.exe'))
