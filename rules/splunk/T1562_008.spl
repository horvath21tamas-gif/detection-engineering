source="WinEventLog:System" eventName IN ("StopLogging", "DeleteTrail", "DeleteEventBus", "DeleteDiagnosticSetting") OR (eventName="UpdateTrail" requestParameters IN ("EnableLogFileValidation: false", "KmsKeyId: \"\"")) OR (eventName IN ("DeleteBucket", "PutBucketLifecycleConfiguration", "PutBucketVersioning") requestParameters.bucketName IN ("*log*", "*audit*", "*trail*", "*telemetry*")) userIdentity.type="Root" OR NOT userIdentity.sessionContext.sessionIssuer.userName=* OR userAgent IN ("*python-requests*", "*kali*", "*bot*") NOT (userIdentity.arn IN ("*role/Terraform-Execution-Policy*", "*role/Security-ReadOnly-Auditor*", "*role/OrganizationAccountAccessRole*") sourceIPAddress="10.0.0.0/8")
