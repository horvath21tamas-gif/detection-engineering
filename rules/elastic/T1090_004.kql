(process.command_line:(*\ \-H\ \"Host\:* OR *\ \-H\ 'Host\:* OR *\ \-Header\ \"Host\:* OR *\ \-\-header\ \"Host\:* OR *.Headers.Add\(\"Host\"* OR *Set\-Item\ \-Path\ env\:http_proxy*)) AND (process.command_line:(*cloudfront.net* OR *azureedge.net* OR *cloudflare.com* OR *fastly.net* OR *google.com* OR *microsoft.com* OR *s3.amazonaws.com*)) AND (process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\curl.exe OR *\\certutil.exe OR *\\bitsadmin.exe OR *\\rundll32.exe)) AND (NOT ((process.executable:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) AND (process.command_line:(*localhost* OR *127.0.0.1*)) AND winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND process.parent.executable:*\\services.exe))
