CommandLine IN ("*get-signin-token*", "*r=signin*", "*sts get-session-token*", "*gcloud auth print-access-token*", "*okta-auth-token*", "*portal.azure.com*", "*account.google.com/ServiceLogin*", "*login.microsoftonline.com*") OR (Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe") CommandLine IN ("*--incognito*", "*--new-window*", "*--app=*", "*console.aws.amazon.com*", "*portal.azure.com*", "*cloud.google.com*", "*okta.com*") ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\sqlservr.exe", "*\\taskhostw.exe", "*\\explorer.exe") ParentImage="*\\AppData\\Local\\Temp\\*" ParentCommandLine IN ("*-NonInteractive*", "*-EncodedCommand*", "*/c powershell*")) OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe") CommandLine IN ("*-NonInteractive*", "*-EncodedCommand*", "*/c*")) NOT (CommandLine IN ("*sso login*", "*login --use-device-code*", "*az login*", "*aws sso login*") ComputerName IN ("*ADMIN-VDI-*", "*DEV-VM-*"))
