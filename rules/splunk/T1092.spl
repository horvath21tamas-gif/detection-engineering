TargetFilename IN ("*\\.*", "*\\autorun*", "*:*") OR TargetFilename IN ("*.dat", "*.bin", "*.lnk", "*.vbs", "*.ps1") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\rundll32.exe", "*\\regsvr32.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\scrcons.exe") NOT (Image IN ("*\\explorer.exe", "*\\msiexec.exe") OR TargetFilename IN ("*$RECYCLE.BIN*", "*System Volume Information*", "*Found.000*") OR username="NT AUTHORITY\\SYSTEM")
| regex TargetFilename="^[D-Z]:\\\\.*"
