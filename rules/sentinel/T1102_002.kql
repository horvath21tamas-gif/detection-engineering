DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*/sendMessage*", "*/getUpdates*", "*chat.postMessage*", "*files.upload*", "*/webhooks/*", "*invocations*", "*channels.messages*")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*", "*\PerfLogs\*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\curl.exe", "*\rundll32.exe", "*\certutil.exe", "*\cmd.exe"))) and (ProcessCommandLine in ("*api.telegram.org*", "*slack.com/api*", "*discord.com/api*", "*api.github.com*", "*graph.microsoft.com*")) and (not ((FolderPath in ("*\Local\Discord\app-*", "*\Local\slack\app-*", "*\Program Files\Microsoft\Teams*", "*\Program Files\*")) or ProcessCommandLine contains "127.0.0.1" or username =~ "NT AUTHORITY\SYSTEM"))