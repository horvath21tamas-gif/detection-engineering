ParentImage IN ("*\\explorer.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\brave.exe", "*\\firefox.exe", "*\\WINWORD.EXE", "*\\EXCEL.EXE", "*\\POWERPNT.EXE") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\mshta.exe", "*\\regsvr32.exe", "*\\schtasks.exe", "*\\sc.exe") username="NT AUTHORITY\\SYSTEM" Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*") NOT (ParentImage IN ("*\\Windows\\Installer\\*", "*\\Microsoft Configuration Manager\\*", "*\\Windows\\CCM\\*", "*\\PDQ\\*", "*\\Ivanti\\*", "*\\ManageEngine\\*", "*\\Tanium\\*", "*\\Dell\\*", "*\\HP\\*", "*\\Lenovo\\*") OR ParentImage IN ("*\\consent.exe", "*\\services.exe", "*\\svchost.exe"))
