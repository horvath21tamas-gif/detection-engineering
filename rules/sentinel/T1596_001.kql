DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\whois.exe", "*\amass.exe", "*\subfinder.exe", "*\jwhois.exe")) or (ProcessCommandLine in ("* -h *", "* --rwhois*", "* -nobanner*", "* -raw*"))) or ((FolderPath in ("*\curl.exe", "*\wget.exe", "*\python.exe", "*\powershell.exe", "*\pwsh.exe")) or (ProcessCommandLine in ("*api.whoisxmlapi.com*", "*rdap.org*", "*reverse-whois*", "*whois-history*")))) and (not ((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe")) or ParentProcessName endswith "\explorer.exe")) and (not (User =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\SentinelOne\*", "*\CrowdStrike\*", "*\Microsoft Security Client\*")))) and (not ((User in ("*svc_soc*", "*adm_net*")) and (FolderPath in ("*\Nmap\*", "*\Wireshark\*"))))