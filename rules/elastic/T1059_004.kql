(Image:(*\/sh OR *\/bash OR *\/zsh OR *\/dash)) AND (((ParentImage:(*\/httpd OR *\/apache2 OR *\/nginx OR *\/php\-fpm OR *\/node OR *\/python OR *\/java)) AND (username:(www\-data OR apache OR nginx OR nobody))) OR ((CommandLine:(*\/dev\/tcp\/* OR *\/dev\/udp\/* OR *\>\&* OR *0\>\&1*)) OR (CommandLine:*curl* AND CommandLine:*\|* AND CommandLine:*sh*) OR (CommandLine:*wget* AND CommandLine:*\|* AND CommandLine:*bash*))) AND (NOT ((ParentImage:(*\/systemd OR *\/sbin\/init)) OR (CommandLine:(*\/var\/lib\/apt\/* OR *logrotate* OR *\/usr\/bin\/mandb*)) OR (username:root AND Parentprocessname:\/usr\/sbin\/sshd)))
