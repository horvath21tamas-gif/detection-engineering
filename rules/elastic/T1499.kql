((process.command_line:(*\ \/f\ \/im\ lsass.exe* OR *\ \/f\ \/im\ csrss.exe* OR *\ \/f\ \/im\ wininit.exe* OR *\ \/f\ \/im\ smss.exe* OR *\ \/f\ \/im\ services.exe*)) OR (process.command_line:(*while\($true\)* OR *\:\:MemoryStream* OR *foreach\($i\ in\ 1..1000000\)* OR *\ \-Recursive*))) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\httpd.exe OR *\\rundll32.exe OR *\\outlook.exe)) OR (process.executable:(*\\Temp\\* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\CcmExec.exe OR *\\msiexec.exe OR *\\TiWorker.exe)) OR (process.command_line:(*HealthCheck* OR *Diagnostic*))))
