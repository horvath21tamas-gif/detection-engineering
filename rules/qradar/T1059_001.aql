SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%')) AND (("Process CommandLine" LIKE '%-enc%' OR "Process CommandLine" LIKE '%-encodedcommand%')) AND (("Process CommandLine" LIKE '%-nop%' OR "Process CommandLine" LIKE '%-w hidden%' OR "Process CommandLine" LIKE '%-windowstyle hidden%' OR "Process CommandLine" LIKE '%-executionpolicy bypass%' OR "Process CommandLine" LIKE '%FromBase64String%' OR "Process CommandLine" LIKE '%IEX%' OR "Process CommandLine" LIKE '%Invoke-Expression%')) AND (("ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\mshta.exe%' OR "ParentImage" LIKE '%\\rundll32.exe%' OR "ParentImage" LIKE '%\\WINWORD.EXE%' OR "ParentImage" LIKE '%\\EXCEL.EXE%' OR "ParentImage" LIKE '%\\POWERPNT.EXE%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\CCM\\%' OR "ParentImage" LIKE '%\\Microsoft Configuration Manager\\%' OR "ParentImage" LIKE '%\\SCCM\\%' OR "ParentImage" LIKE '%\\Tanium\\%' OR "ParentImage" LIKE '%\\PDQ\\%' OR "ParentImage" LIKE '%\\Ivanti\\%' OR "ParentImage" LIKE '%\\ManageEngine\\%' OR "ParentImage" LIKE '%\\Intune\\%' OR "ParentImage" LIKE '%\\Elastic\\%' OR "ParentImage" LIKE '%\\Splunk\\%'))
