| where TimeGenerated > ago(24h)
union *
| where (((TargetObject in ("*\SCHANNEL\Protocols\TLS 1.2\Client\Enabled*", "*\SCHANNEL\Protocols\TLS 1.3\Client\Enabled*", "*\.NETFramework\v*\System.Net.ServicePointManager.SecurityProtocol*")) and (Details in ("0x00000000", "0x00000030", "0x000000c0"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*ServerCertificateValidationCallback*", "*CheckCertificateRevocationList = $false*", "*[Net.ServicePointManager]::SecurityProtocol =*")))) and ((FolderPath in ("*\Users\*", "*\AppData\Local\Temp\*", "*\Downloads\*", "*\Public\*")) and (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wscript.exe"))) and (not (((FolderPath in ("*\msiexec.exe", "*\TrustedInstaller.exe", "*\CcmExec.exe")) and User =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\Google\Chrome\Application\*", "*\Microsoft\Edge\Application\*"))))