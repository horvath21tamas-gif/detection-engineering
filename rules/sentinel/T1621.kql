DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*AADInternals*", "*MSAL.PS*", "*Okta.Auth*", "*puppeteer*", "*selenium-webdriver*", "*Playwright*")) or (ProcessCommandLine in ("*Invoke-AADIntMFAFlood*", "*while($true)*", "*for($i=0*", "*.ShowPasswordPrompt*", "*Send-PushNotification*")) or (ProcessCommandLine in ("*-WindowStyle Hidden*", "*-ExecutionPolicy Bypass*", "*-NonInteractive*"))) and (ParentProcessName in ("*\chrome.exe", "*\msedge.exe", "*\winword.exe", "*\excel.exe", "*\taskeng.exe")) and (not ((FolderPath in ("*\Program Files\Microsoft Azure AD Connect\*", "*\Program Files\Microsoft Azure AD Sync\*")) and User =~ "NT AUTHORITY\SYSTEM"))