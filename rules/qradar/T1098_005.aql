SELECT UTF8(payload) as search_payload from events where (("operationName" LIKE '%Add device%' OR "operationName" LIKE '%Register device%')) AND "result"='success' AND NOT (("initiatedBy.app.displayName" LIKE '%Microsoft Intune%' OR "initiatedBy.app.displayName" LIKE '%Microsoft Device Registration Service%' OR "initiatedBy.app.displayName" LIKE '%Azure Active Directory%')) OR ("additionalDetails.value" LIKE '%Python%' OR "additionalDetails.value" LIKE '%Go-http-client%' OR "additionalDetails.value" LIKE '%Postman%' OR "additionalDetails.value" LIKE '%curl%')
