SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%findstr%','%/s%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%grep%','%-r%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Get-ChildItem%','%-Recurse%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%dir%','%/s%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%where%','%/r%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.config%','%.xml%','%.json%','%.yml%','%.env%','%.unattend%','%.git\config%','%.aws\credentials%','%.azure\azureProfile.json%','%id_rsa%','%id_dsa%','%id_ed25519%','%password=%','%access_key%','%secret_key%')) AND ((""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\psexesvc.exe','%\httpd.exe','%\php-cgi.exe','%\nginx.exe','%\powershell.exe','%\cmd.exe')) AND (""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%base64%','%certutil -encode%','% > %','%>>%','% | clip%','%curl %','%wget %','%scp %','%Invoke-WebRequest%','%-enc%','%-EncodedCommand%','%IEX%','%Invoke-Expression%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Windows\System32\SearchIndexer.exe%','%\Windows\System32\CompatTelRunner.exe%','%\Microsoft Visual Studio\%','%\Git\usr\bin\git.exe%')) AND ""Parent Filename"" ILIKE '%\explorer.exe')
