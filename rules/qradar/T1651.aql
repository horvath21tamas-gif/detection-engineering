SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\amazon-ssm-agent.exe','%\CaaSAgent.exe','%\WaAppAgent.exe','%\google_guest_agent.exe')) AND (""Filename"" ILIKE ENUMERATION('%\whoami.exe','%\nltest.exe','%\nbtstat.exe','%\net1.exe','%\qwinsta.exe','%\klist.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% -enc %','% -encodedcommand %','%Invoke-WebRequest%','%IEX%','%MiniDump%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Packages\Plugins\Microsoft.Azure.Monitoring%','%\Packages\Plugins\Microsoft.EnterpriseCloud.Monitoring%','%CollectGuestLogs.exe%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%AmazonCloudWatchAgent%','%ssm-document-worker.exe%'))
