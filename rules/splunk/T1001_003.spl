(CommandLine IN ("*.Headers.Add(*", "*WinHttp.WinHttpRequest*", "*msxml2.xmlhttp*", "*Net.Sockets.TcpClient*", "*Net.WebClient).Download*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\mshta.exe")) OR (CommandLine IN ("*Mozilla/4.0*", "*iPhone*", "*Googlebot*", "*Baiduspider*", "*curl/*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\mshta.exe") NOT (Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe") OR CommandLine IN ("*C:\\Program Files\\*", "*Microsoft\\Azure*", "*Chocolatey*") OR username="NT AUTHORITY\\SYSTEM"))
