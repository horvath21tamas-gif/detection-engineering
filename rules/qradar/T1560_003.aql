SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%[System.IO.File]::ReadAllBytes%','%[System.IO.File]::WriteAllBytes%','%MemoryStream%','%Get-Content -Encoding Byte%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%[Convert]::ToBase64String%','%[Convert]::FromBase64String%','%-bxor%','%-band%','%-bor%','%::ToCharArray()%')) AND "Process "Process CommandLine"" ILIKE '%Get-ChildItem%' AND "Process "Process CommandLine"" ILIKE '%-Recurse%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.zip%','%.dat%','%.tmp%','%.log%','%Out-File%','%Set-Content%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\w3wp.exe','%\httpd.exe','%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\rundll32.exe','%\mshta.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe'))) AND NOT (""Filename"" ILIKE ENUMERATION('C:\Program Files\Microsoft Monitoring Agent\%','C:\Program Files\Splunk\%','C:\Program Files\Elastic\Agent\%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\AzureDevOps\%','%\Jenkins\%','%\GitLab\%'))
