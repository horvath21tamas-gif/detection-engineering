SrcIp IN ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*") HttpMethod IN ("HEAD", "OPTIONS", "TRACE") UriStem IN ("/", "/index", "/login", "/admin") UserAgent IN ("*curl*", "*wget*", "*python*", "*httpclient*", "*go-http-client*", "*libwww*", "*probe*", "*scanner*") RequestHeaders IN ("*Accept-Language*", "*Accept-Encoding*", "*X-Forwarded-For*", "*Forwarded*", "*Via*") NOT (UserAgent IN ("*Mozilla*", "*Chrome*", "*Safari*", "*Firefox*", "*Edge*") OR UserAgent IN ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nikto*", "*nuclei*", "*zap*", "*zabbix*", "*uptime*", "*pingdom*") OR UriStem IN ("*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.woff", "*.woff2", "*.json", "*/api")) | table SrcIp,HttpMethod,UriStem,UserAgent,RequestHeaders
