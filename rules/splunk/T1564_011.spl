Image IN ("*\\WindowsSandbox.exe", "*\\wsl.exe", "*\\wslhost.exe", "*\\vmcompute.exe") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\mshta.exe", "*\\sqlservr.exe") OR (CommandLine IN ("*.wsb*", "*--exec*", "* -e *", "*--mount*", "*HostFolder*", "*LogonCommand*") CommandLine IN ("*\\Users\\*", "*\\Downloads\\*", "*\\Temp\\*", "*\\AppData\\*")) NOT (ParentImage IN ("*\\Common7\\IDE\\devenv.exe*", "*\\bin\\code.exe*", "*\\Program Files\\Docker\\*") OR CommandLine IN ("*docker-desktop*", "*Microsoft.WSL*") OR username="NT AUTHORITY\\SYSTEM") | table Time,SourceImage,ParentImage,CommandLine,SourceUsername
