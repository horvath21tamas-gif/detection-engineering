CommandLine IN ("*ipconfig /flushdns*", "*Clear-DnsClientCache*") CommandLine IN ("*Resolve-DnsName*", "*[System.Net.Dns]::*", "*while(*", "*Start-Sleep*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\regsvr32.exe") NOT (CommandLine IN ("*\\Program Files\\*", "*Microsoft\\Azure*", "*HealthCheck*", "*Chocolatey*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
