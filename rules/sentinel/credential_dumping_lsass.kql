DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where TargetImage endswith "\lsass.exe" and (GrantedAccess in ("0x10", "0x20", "0x30", "0x40", "0x50", "0x1000", "0x1010", "0x1410", "0x143a", "0x1f0fff", "0x1fffff")) and ((FolderPath in ("*\procdump.exe", "*\procdump64.exe", "*\mimikatz.exe", "*\rundll32.exe", "*\taskmgr.exe", "*\powershell.exe", "*\pwsh.exe", "*\wmic.exe", "*\comsvcs.dll")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\ProgramData\*", "*\Windows\Temp\*"))) and (not ((FolderPath in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*")) and FolderPath endswith "\taskmgr.exe"))