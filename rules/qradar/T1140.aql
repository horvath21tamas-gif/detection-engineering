SELECT UTF8(payload) as search_payload from events where ""Filename"" IMATCHES '(certutil\.exe|expand\.exe|extrac32\.exe)$' AND "Process "Process CommandLine"" IMATCHES '(-decode|-decodehex|(\.txt|\.jpg|\.png|\.xml|\.log))' AND (""Parent Filename"" IMATCHES '(cmd\.exe|powershell\.exe|pwsh\.exe|wscript\.exe|cscript\.exe|nginx\.exe|httpd\.exe|mshta\.exe)$' OR "Process "Process CommandLine"" IMATCHES '(\\Users\\|\\Temp\\|\\AppData\\).*|(\.exe|\.dll|\.vbs|\.ps1)$' AND NOT (""Parent Filename"" IMATCHES '(\\Windows\\servicing\\TrustedInstaller\.exe|\\CcmExec\.exe|\\Package Cache\\)' AND ""Filename"" IMATCHES '(\\Program Files\\|\\Windows\\System32\\)' AND "Process "Process CommandLine"" IMATCHES 'Microsoft\\Windows\\SoftwareDistribution'))
