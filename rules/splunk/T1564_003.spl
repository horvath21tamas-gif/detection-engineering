Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\mshta.exe", "*\\cscript.exe", "*\\wscript.exe") CommandLine IN ("* -w h*", "* -window h*", "* -win h*", "* -wind h*", "*showwindow=0*", "*windowstyle 1*", "*sw_hide*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\acrord32.exe", "*\\sqlservr.exe", "*\\w3wp.exe") OR CommandLine IN ("* -enc*", "* -e *", "* -nop*", "* -noni*", "*iex*", "*downloadstring*", "*frombase64string*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\Windows\\System32\\ServerManager.exe*", "*\\Configuration Manager\\*", "*\\HealthService.exe*") OR CommandLine IN ("*Chocolatey*", "*Splunk*", "*Logitech*"))
