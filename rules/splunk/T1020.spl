CommandLine IN ("* -p*", "* -hp*", "* -mhe=on*", "* -mx9*", "* -ta*") OR Image IN ("*\\rclone.exe", "*\\mega.exe", "*\\file.exe", "*\\powershell.exe", "*\\curl.exe") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*", "*\\PerfLogs\\*") CommandLine IN ("*copy *", "*sync *", "*ftp*", "*http*", "*--config*") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*localhost*", "*127.0.0.1*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
