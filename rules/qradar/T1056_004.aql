SELECT UTF8(payload) as search_payload from events where (("LoadedImage" LIKE '%\\user32.dll%' OR "LoadedImage" LIKE '%\\advapi32.dll%' OR "LoadedImage" LIKE '%\\win32u.dll%')) AND "Image" ILIKE '%.exe' AND NOT (("Filename" LIKE '%C:\\Windows\\System32\\%' OR "Filename" LIKE '%C:\\Windows\\SysWOW64\\%')) AND NOT (("Filename" LIKE '%\\explorer.exe%' OR "Filename" LIKE '%\\chrome.exe%' OR "Filename" LIKE '%\\msedge.exe%' OR "Filename" LIKE '%\\firefox.exe%' OR "Filename" LIKE '%\\teams.exe%'))
