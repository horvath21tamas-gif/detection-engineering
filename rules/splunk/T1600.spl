
| rex field=TargetObject "(?<TargetObjectMatch>SCHANNEL\\\\Protocols\\\\TLS 1\\.2\\\\Client\\\\Enabled)"
| eval TargetObjectCondition=if(isnotnull(TargetObjectMatch), "true", "false")
| rex field=TargetObject "(?<TargetObjectMatch2>SCHANNEL\\\\Protocols\\\\TLS 1\\.3\\\\Client\\\\Enabled)"
| eval TargetObjectCondition2=if(isnotnull(TargetObjectMatch2), "true", "false")
| rex field=TargetObject "(?<TargetObjectMatch3>\\\\.NETFramework\\\\v\\d+\\.\\d+\\\\System\\.Net\\.ServicePointManager\\.SecurityProtocol)"
| eval TargetObjectCondition3=if(isnotnull(TargetObjectMatch3), "true", "false")
| search (TargetObjectCondition="true" OR TargetObjectCondition2="true" OR TargetObjectCondition3="true" Details IN ("0x00000000", "0x00000030", "0x000000C0")) OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*ServerCertificateValidationCallback*", "*CheckCertificateRevocationList = $false*", "*[Net.ServicePointManager]::SecurityProtocol =*", "*[System.Net.ServicePointManager]::SecurityProtocol*")) Image IN ("*\\Users\\*", "*\\AppData\\Local\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*", "*\\Desktop\\*") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe") NOT ((Image IN ("*\\msiexec.exe", "*\\TrustedInstaller.exe", "*\\CcmExec.exe") username="NT AUTHORITY\\SYSTEM") OR Image IN ("*\\Google\\Chrome\\Application\\*", "*\\Microsoft\\Edge\\Application\\*", "*\\Mozilla Firefox\\*")) | table Time,User,Image,ParentImage,CommandLine,TargetObject,Details
