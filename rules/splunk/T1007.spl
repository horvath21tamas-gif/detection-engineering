Image IN ("*\\sc.exe", "*\\tasklist.exe", "*\\net.exe", "*\\net1.exe") OR CommandLine IN ("*Get-Service*", "*Get-WmiObject Win32_Service*", "*Get-CimInstance Win32_Service*") CommandLine IN ("*query*", "*state= all*", "*config*", "*sdshow*") OR (ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\httpd.exe", "*\\wsmprovhost.exe", "*\\powershell.exe") IntegrityLevel="Medium") OR CommandLine IN ("*findstr*", "*select-string*", "*where-object*", "* > *", "*ConvertTo-Json*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\svchost.exe", "*\\msiexec.exe", "*\\CcmExec.exe") OR CommandLine IN ("*Program Files*", "*Splunk*", "*Tanium*"))
