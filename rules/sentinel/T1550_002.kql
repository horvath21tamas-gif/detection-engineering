DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((EventID =~ 4624 and LogonType =~ 9 and LogonProcessName =~ "seclogo" and AuthenticationPackage =~ "Negotiate") or (EventID =~ 4624 and LogonType =~ 3 and AuthenticationPackage =~ "NTLM" and (IpAddress in ("127.0.0.1", "::1"))) or (ProcessCommandLine in ("*sekurlsa::pth*", "*Invoke-TheHash*", "*mimikatz.exe*", "*pth-winexe*"))) and (not (TargetUserName endswith "$" and SubjectUserName endswith "$"))