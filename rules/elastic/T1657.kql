(process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\nircmd.exe OR *\\python.exe OR *\\wscript.exe)) AND ((process.command_line:(*Get\-Clipboard* OR *Set\-Clipboard* OR *System.Windows.Forms.Clipboard* OR *WriteProcessMemory* OR *regex*)) AND (process.command_line:(*invoice* OR *payment* OR *bank_statement* OR *iban* OR *.pdf* OR *.xlsx*))) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\httpd.exe OR *\\rundll32.exe OR *\\msedge.exe OR *\\chrome.exe)) OR (process.executable:(*\\Temp\\* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR process.executable:*\\Program\ Files\\* OR (process.command_line:(*Inventory* OR *Backup* OR *SignService*))))
