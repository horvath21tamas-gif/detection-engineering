SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/az','%/aws','%/gcloud','%/kubectl')) AND (""Process CommandLine"" ILIKE ENUMERATION('%list-access-keys%','%export-credentials%','%get-secret%') OR ""Process CommandLine"" ILIKE ENUMERATION('%stop-logging%','%delete-trail%','%disable-policy%','%delete-flow-log%') OR ""Process CommandLine"" ILIKE ENUMERATION('%make-public%','%add-iam-policy-binding%','%modify-instance-attribute --attribute disableApiTermination%','%create-presigned-url%')) AND NOT (("UserName" LIKE '%deployment-service-account%' OR "UserName" LIKE '%terraform-runner%') OR ""Process CommandLine"" ILIKE ENUMERATION('%--describe%','%--list%'))
