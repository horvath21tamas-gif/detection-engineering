((TargetFilename:(*\/etc\/systemd\/system\/* OR *\/usr\/lib\/systemd\/system\/* OR *\/lib\/systemd\/system\/* OR *\/.config\/systemd\/user\/*)) AND TargetFilename:*.service) AND ((Image:(*\/bash OR *\/sh OR *\/zsh OR *\/python3 OR *\/perl OR *\/curl OR *\/wget OR *\/nc OR *\/php)) OR (CommandLine:(*ExecStart\=\/tmp\/* OR *ExecStart\=\/dev\/shm\/* OR *ExecStart\=\/var\/tmp\/* OR *ExecStart\=python* OR *ExecStart\=perl*))) AND (NOT ((ParentImage:(*\/ansible\-playbook OR *\/chef\-client OR *\/salt\-minion OR *\/puppet OR *\/dpkg OR *\/apt\-get OR *\/dnf OR *\/yum)) AND username:root))
