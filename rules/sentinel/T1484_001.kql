DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((TargetFilename contains "\Windows\SYSVOL\domain\Policies\" and (TargetFilename in ("*\GptTmpl.inf", "*\Scripts.ini", "*\ScheduledTasks.xml", "*\Registry.pol"))) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\bitsadmin.exe", "*\python.exe", "*\curl.exe"))) or ((EventID =~ 5136 and AttributeCommonName =~ "gPLink") and (not (FolderPath endswith "\Windows\System32\svchost.exe" or FolderPath endswith "\Windows\System32\mmc.exe" or User =~ "NT AUTHORITY\SYSTEM" or SubjectUserName contains "GPO_SVC_")))