(Image:(*\/systemctl OR *\/systemd\-analyze)) AND ((CommandLine:(*enable* OR *start* OR *daemon\-reload* OR *\-\-user*)) AND (CommandLine:(*base64* OR *curl* OR *wget* OR *python* OR *perl* OR *ruby* OR *nc\ * OR *sh\ \-c* OR *\/tmp\/* OR *\/var\/tmp\/* OR *\/dev\/tcp\/*))) AND (NOT ((ParentImage:(*\/apt OR *\/yum OR *\/dnf OR *\/dpkg OR *\/ansible\-playbook OR *\/salt\-minion)) OR (username:root AND (CommandLine:(*apt\-daily* OR *motd\-news* OR *logrotate*)))))
