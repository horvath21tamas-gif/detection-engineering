DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*\OneDrive - *", "*\OneDrive\*", "*\SharePoint\*", "*\Teams Files\*", "*\Google Drive\*", "*\Dropbox\*")) and (((FolderPath in ("*\robocopy.exe", "*\xcopy.exe", "*\tar.exe", "*\powershell.exe", "*\7z.exe", "*\rar.exe")) or (ProcessCommandLine in ("*Compress-Archive*", "*Start-BitsTransfer*", "*Copy-Item -Recurse*", "* -Recurse*", "* /s *"))) or (ProcessCommandLine in ("*\Users\Public\*", "*\Windows\Temp\*", "*\AppData\Local\Temp\*", "*C:\ProgramData\*", "*E:\*", "*F:\*", "*\\*"))) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\explorer.exe", "*\winword.exe", "*\excel.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*\OneDrive.exe", "*\OneDriveStandaloneUpdater.exe", "*\GoogleDriveFS.exe", "*\Dropbox.exe")) or (ProcessCommandLine in ("*C:\Program Files\*", "*C:\Windows\System32\*")) or username =~ "NT AUTHORITY\SYSTEM"))