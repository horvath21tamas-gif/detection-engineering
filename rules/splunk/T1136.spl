CommandLine IN ("*user /add*", "*user /ad*", "*New-LocalUser*", "*New-ADUser*", "*ad-user -name*") ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\sqlservr.exe", "*\\winword.exe", "*\\powershell.exe") OR (NOT (ParentImage IN ("*\\CcmExec.exe", "*\\omadmac.exe", "*\\svchost.exe") Image IN ("*\\net.exe", "*\\net1.exe") username="NT AUTHORITY\\SYSTEM") NOT (ParentImage IN ("*\\Windows\\Temp\\*", "*\\ConfigMgr\\*") CommandLine IN ("*MSSQL$*", "*IIS_*")))
