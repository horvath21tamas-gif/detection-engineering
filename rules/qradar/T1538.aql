SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%get-signin-token%','%r=signin%','%portal.azure.com%','%account.google.com/ServiceLogin%') OR (""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%--incognito%','%--new-window%','%--app=%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%console.aws.amazon.com%','%portal.azure.com%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\httpd.exe','%\sqlservr.exe')) AND ""Parent Filename"" ILIKE '%\AppData\Local\Temp\%') AND NOT (("Process "Process CommandLine"" ILIKE ENUMERATION('%sso login%','%login --use-device-code%')) AND "Computer Name" ILIKE '%ADMIN-VDI-%')
