DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*\Login Data*", "*\Cookies*", "*\Web Data*", "*\key4.db*", "*\logins.json*")) and (((ProcessCommandLine in ("*copy *", "*type *", "*add *", "*tar *", "*Get-Content*", "*cp *")) or (FolderPath in ("*\sqlite3.exe", "*\esentutl.exe"))) or ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (FolderPath in ("*\python.exe", "*\powershell.exe", "*\cmd.exe", "*\cscript.exe")))) and (not (((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\brave.exe")) and (ParentProcessName in ("*\Program Files\*", "*\Windows\System32\*"))) or ((FolderPath in ("*\Program Files\Veeam\*", "*\Program Files\Microsoft OneDrive\*")) and username =~ "NT AUTHORITY\SYSTEM")))