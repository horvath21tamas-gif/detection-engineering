SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\openssl.exe','%\keytool.exe','%\certutil.exe','%\makecert.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -selfsign %','% -genrsa %','% -keyout %','% -export %','% -req -new %')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\Public\%','%\AppData\Local\Temp\%','%\PerfLogs\%','%C:\Windows\Temp\%','%\ProgramData\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\Program Files\%','%\Program Files (x86)\%','%\System32\%')) AND NOT (("UserName" LIKE '%svc_pki%' OR "UserName" LIKE '%adm_infra%' OR "UserName" LIKE '%svc_deploy%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\setup.exe','%\install.exe'))
