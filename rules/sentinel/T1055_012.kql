DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (GrantedAccess in ("*0x1410*", "*0x1411*", "*0x1438*", "*0x1F1FFF*")) and CallTrace contains "unknown" and (TargetImage in ("*\svchost.exe", "*\werfault.exe", "*\regasm.exe", "*\vbc.exe", "*\cvtres.exe", "*\smartscreen.exe")) and (SourceImage in ("*\Users\*", "*\Temp\*", "*\AppData\*")) and (not (SourceProcessName =~ "C:\Windows\System32\csrss.exe" or (SourceImage in ("*\MsMpEng.exe", "*\CcmExec.exe")) or (CallTrace in ("*clr.dll+*", "*wer.dll+*", "*ntdll.dll+LdrpWorkItem*")) or condition =~ "SourceProcessName == TargetImage"))