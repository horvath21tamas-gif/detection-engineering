SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%System\CurrentControlSet\Control\Lsa%' AND (("Target Object" LIKE '%\\Notification Packages%' OR "Target Object" LIKE '%\\Authentication Packages%' OR "Target Object" LIKE '%\\Security Packages%')) AND (NOT (("Target Details" LIKE '%scecli%' OR "Target Details" LIKE '%msv1_0%' OR "Target Details" LIKE '%kerberos%' OR "Target Details" LIKE '%tspkg%' OR "Target Details" LIKE '%pku2u%' OR "Target Details" LIKE '%livessp%' OR "Target Details" LIKE '%cloudap%' OR "Target Details" LIKE '%wdigest%' OR "Target Details" LIKE '%schannel%' OR "Target Details" LIKE '%negotiate%')) OR ("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%C:\\Windows\\Temp\\%' OR "Target Details" LIKE '%.sys%' OR "Target Details" LIKE '%.tmp%') OR "Target Details" ILIKE '%:\%') AND NOT (""Filename"" ILIKE ENUMERATION('%\trustedinstaller.exe','%\System32\msiexec.exe'))
