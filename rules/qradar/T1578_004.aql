SELECT UTF8(payload) as search_payload from events where (("operation_name" LIKE '%ModifyImageAttribute%' OR "operation_name" LIKE '%CopyImage%' OR "operation_name" LIKE '%Microsoft.Compute/images/write%' OR "operation_name" LIKE '%v1.compute.images.setLabels%')) AND (("request_parameters" LIKE '%all%' OR "request_parameters" LIKE '%public%' OR "request_parameters" LIKE '%grantee%') OR "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%boto3%' OR "user_agent" LIKE '%curl%' OR "user_agent" LIKE '%postman%'))) AND NOT (("user_name" LIKE '%svc-packer%' OR "user_name" LIKE '%svc-terraform%' OR "user_name" LIKE '%image-pipeline-admin%' OR "user_name" LIKE '%azure-image-builder%') OR ("user_name" LIKE '%system-internal%' OR "user_name" LIKE '%service-linked-role%'))
