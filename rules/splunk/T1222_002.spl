Image IN ("*/chmod", "*/chown", "*/chattr") (CommandLine IN ("*+s*", "*u+s*", "*+i*", "*+a*", "*777*", "*666*", "* +x *") CommandLine IN ("*/tmp/*", "*/dev/shm/*", "*/var/tmp/*")) OR CommandLine IN ("*/etc/shadow*", "*/etc/sudoers*", "*/etc/passwd*", "*/root/.ssh*", "*/var/spool/cron*", "*/etc/crontab*", "*/bin/sh*", "*/bin/bash*") OR username IN ("www-data", "apache", "nginx", "nobody", "mysql", "postgres") NOT (ParentImage IN ("*/bin/apt", "*/bin/dpkg", "*/bin/yum", "*/bin/dnf", "*/bin/rpm", "*/sbin/cloud-init") OR CommandLine IN ("* --help*", "* --version*"))
