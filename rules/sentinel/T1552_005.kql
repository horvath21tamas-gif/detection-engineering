DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*\.aws\credentials*", "*\.aws\config*", "*\.azure\azureProfile.json*", "*\.azure\accessTokens.json*", "*\.config\gcloud\*", "*\.docker\config.json*", "*\AppData\Roaming\gcloud\*", "*\AppData\Roaming\AWS\*")) or (ProcessCommandLine in ("*aws_access_key_id*", "*aws_secret_access_key*", "*clientSecret*", "*refreshToken*", "*access_token*", "*private_key*"))) and ((ProcessCommandLine in ("*base64*", "*certutil -encode*", "* | clip*", "* > *", "*>>*", "*Invoke-WebRequest*", "*curl *", "*wget *", "*scp *", "*nc *")) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Get-Content*", "*gc *", "*-enc*", "*-EncodedCommand*", "*IEX*", "*Invoke-Expression*"))) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\psexesvc.exe", "*\wmiprvse.exe", "*\cmd.exe", "*\powershell.exe", "*\httpd.exe", "*\php-cgi.exe")) and (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*")))) and (not (User in ("*NT AUTHORITY\SYSTEM*", "*NT AUTHORITY\LOCAL SERVICE*", "*NT AUTHORITY\NETWORK SERVICE*"))) and (not ((FolderPath in ("*\aws.exe", "*\az.cmd", "*\az.exe", "*\gcloud.cmd", "*\gcloud.exe", "*\docker.exe")) and ParentProcessName endswith "\explorer.exe" and User contains "NT AUTHORITY")) and (not (ParentProcessName in ("*jenkins*", "*azuredevops*", "*gitlab-runner*", "*teamcity*")))