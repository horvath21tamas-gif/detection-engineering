SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%System\CurrentControlSet\Services\%' AND "Target Object" ILIKE '%\ImagePath' AND (("Target Details" LIKE '%\\Users\\%' OR "Target Details" LIKE '%\\AppData\\%' OR "Target Details" LIKE '%\\Temp\\%' OR "Target Details" LIKE '%\\Public\\%' OR "Target Details" LIKE '%\\Downloads\\%' OR "Target Details" LIKE '%C:\\PerfLogs\\%' OR "Target Details" LIKE '%\\OneDrive\\%' OR "Target Details" LIKE '%\\Dropbox\\%') OR ("Target Details" LIKE '%cmd.exe%' OR "Target Details" LIKE '%powershell.exe%' OR "Target Details" LIKE '%pwsh.exe%' OR "Target Details" LIKE '%cscript.exe%' OR "Target Details" LIKE '%wscript.exe%' OR "Target Details" LIKE '%mshta.exe%' OR "Target Details" LIKE '%rundll32.exe%' OR "Target Details" LIKE '%explorer.exe /embedding%' OR "Target Details" LIKE '%regsvr32.exe%')) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\servicing\%','C:\Windows\System32\svchost.exe%','C:\Windows\sysnative\svchost.exe%','C:\Windows\System32\sc.exe%')) AND "username" ILIKE 'NT AUTHORITY\SYSTEM%' OR (""Filename"" ILIKE ENUMERATION('%\Google\Update\%','%\Microsoft\EdgeUpdate\%','%\Adobe\ARM\%','%\Apple\MobileDevice\%','%\Zoom\bin\%')) AND (("Target Details" LIKE '%\\Program Files\\%' OR "Target Details" LIKE '%\\Program Files (x86%')\%')))
