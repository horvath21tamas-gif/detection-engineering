ParentImage IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe", "*\\brave.exe", "*\\outlook.exe", "*\\thunderbird.exe", "*\\teams.exe", "*\\slack.exe", "*\\discord.exe") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\mshta.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\certutil.exe", "*\\bitsadmin.exe", "*\\rundll32.exe", "*\\regsvr32.exe", "*\\hh.exe", "*\\scrcons.exe") OR CommandLine IN ("*-enc*", "*http*", "*DownloadString*", "*Invoke-WebRequest*", "*-ExecutionPolicy Bypass*", "*javascript:*", "*vbscript:*", "*.jnlp*", "* -e *") NOT (CommandLine IN ("*--type=renderer*", "*--type=utility*", "*--type=gpu-process*", "*\\Google\\Update\\*", "*\\Microsoft\\EdgeUpdate\\*") OR CommandLine IN ("*RemoteAssistance*", "*TeamViewer*"))
