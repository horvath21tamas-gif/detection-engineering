DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\pagodo.exe", "*\ghunt.exe", "*\dork-cli.exe", "*\snakedork.exe")) or (ProcessCommandLine in ("*google-dork*", "*bing-scraper*"))) or (((ProcessCommandLine contains "--headless" and ProcessCommandLine contains "webdriver") and (ProcessCommandLine in ("*google.com/search*", "*bing.com/search*"))) or ((FolderPath in ("*\curl.exe", "*\wget.exe", "*\python.exe", "*\pwsh.exe")) or (ProcessCommandLine contains "site:" and ProcessCommandLine contains "filetype:") or (ProcessCommandLine in ("*intitle:\"index of\"*", "*inurl:admin*"))))) and (not (ParentProcessName endswith "\explorer.exe" and condition =~ "not selection_specialized_tools")) and (not ((ParentProcessName in ("*\code.exe", "*\devenv.exe", "*\idea64.exe")) and (ProcessCommandLine in ("*msdn.microsoft.com*", "*stackoverflow.com*", "*github.com*")))) and (not (ProcessCommandLine in ("*--type=renderer*", "*--type=utility*", "*--type=gpu-process*")))