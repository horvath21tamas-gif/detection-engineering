(process.command_line:(*Get\-PnP* OR *Get\-SPO* OR *Connect\-PnPOnline* OR *Microsoft.SharePoint.PowerShell* OR *\/_api\/web\/lists* OR *\/_api\/search\/query* OR *Export\-PnPListItem* OR *Get\-PnPListItem*)) AND ((process.command_line:(*\ \-All* OR *\ \-Recurse* OR *\ \-PageSize\ 1000* OR *\ \-Limit\ All* OR *\ \-BatchSize\ * OR *\ \-AsJob*)) OR (process.command_line:(*\\Users\\Public\\* OR *\\Windows\\Temp\\* OR *\\AppData\\Local\\Temp\\* OR *\ \-OutFile\ * OR *\ \-Path\ *))) AND ((process.parent.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\w3wp.exe OR *\\explorer.exe OR *\\taskhostw.exe)) AND (winlog.event_data.IntegrityLevel:(Medium OR High))) AND (NOT ((process.executable.caseless:(*C\:\\Program\ Files\\SharePoint\ Online\ Management\ Shell\\* OR *C\:\\Program\ Files\\Microsoft\ SDKs\\SharePoint\\* OR *C\:\\Program\ Files\\Office\\root\\Office* OR *C\:\\Program\ Files\\OneDrive\\*)) OR (user.name:(NT\ AUTHORITY\\SYSTEM* OR DOMAIN\\svc_* OR DOMAIN\\backup_*)) OR (process.command_line:(*OfficeClickToRun.exe* OR *OneDrive.exe* OR *HealthCheck* OR *\ \-\-version* OR *\ \-help*))))
