CommandLine="*portproxy*" CommandLine="*v4tov4*" CommandLine="*connectaddress=*" CommandLine IN ("*10.*", "*192.168.*", "*172.16.*", "*172.17.*", "*172.18.*", "*172.19.*", "*172.2*", "*172.3*") CommandLine IN ("*listenaddress=0.0.0.0*", "*listenport=*", "*connectport=*") Image IN ("*\\netsh.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\plink.exe", "*\\socat.exe") NOT (CommandLine IN ("*127.0.0.1*", "*::1*", "*C:\\Program Files\\Docker*", "*C:\\Program Files\\WSL*", "*C:\\Windows\\System32\\WSL*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
