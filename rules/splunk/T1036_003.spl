OriginalFileName IN ("Cmd.Exe", "PowerShell.EXE", "pwsh.dll", "wscript.exe", "cscript.exe", "mshta.exe", "regsvr32.exe", "rundll32.exe", "certutil.exe", "bitsadmin.exe", "schtasks.exe", "net.exe", "net1.exe", "scrcons.exe") NOT (Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\regsvr32.exe", "*\\rundll32.exe", "*\\certutil.exe", "*\\bitsadmin.exe", "*\\schtasks.exe", "*\\net.exe", "*\\net1.exe", "*\\scrcons.exe")) Image IN ("*\\Users\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*\\Public\\*", "*\\AppData\\*") OR NOT (Image IN ("C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*", "C:\\Windows\\WinSxS\\*") OR username IN ("NT AUTHORITY\\SYSTEM", "NT AUTHORITY\\LOCAL SERVICE", "NT AUTHORITY\\NETWORK SERVICE") OR ParentImage IN ("*\\msiexec.exe", "*\\trustedinstaller.exe"))
