CommandLine IN ("*ipinfo.io*", "*ifconfig.me*", "*icanhazip.com*", "*api.ipify.org*", "*checkip.amazonaws.com*", "*ip-api.com*") OR CommandLine IN ("*Keyboard Layout\\Preload*", "*Control Panel\\International*", "*MUILanguages*", "*GeoID*") OR CommandLine IN ("*Get-Culture*", "*Get-WinSystemLocale*", "*Get-TimeZone*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\wsmprovhost.exe", "*\\httpd.exe") IntegrityLevel="Medium" NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\msiexec.exe", "*\\CcmExec.exe", "*\\svchost.exe") OR CommandLine IN ("*Program Files*", "*Splunk*"))
