DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*FromBase64String*", "*ToBase64String*", "* -decode *", "* -encode *", "*[System.Text.Encoding]::*", "*BXAAR*", "*TVqQA*")) and ProcessCommandLine matches regex "(?i).*[a-z0-9+/]{500,}.*") or ((((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\w3wp.exe", "*\sqlservr.exe")) or (FolderPath in ("*\rundll32.exe", "*\regsvr32.exe", "*\colorcpl.exe"))) and (ProcessCommandLine in ("*FromBase64String*", "*ToBase64String*", "* -decode *", "* -encode *", "*[System.Text.Encoding]::*", "*BXAAR*", "*TVqQA*"))) and (not ((ProcessCommandLine in ("*C:\Windows\System32\wbem\WmiPrvSE.exe*", "*CCM\Cache*", "*Microsoft.Cloud.Data*")) or FolderPath endswith "\powershell_ise.exe" or username =~ "NT AUTHORITY\SYSTEM")))