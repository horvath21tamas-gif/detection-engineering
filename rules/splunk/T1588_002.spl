TargetFilename IN ("*\\nmap*", "*\\nc.exe*", "*\\netcat*", "*\\socat*", "*\\rclone*", "*\\plink*", "*\\mimikatz*", "*\\ngrok*", "*\\chisel*") Image IN ("*\\curl.exe", "*\\wget.exe", "*\\certutil.exe", "*\\bitsadmin.exe", "*\\powershell.exe", "*\\pwsh.exe") NOT (TargetFilename IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*", "*\\Windows\\System32\\*", "*\\Chocolatey\\*") OR (Image IN ("*\\Tanium\\*", "*\\SCCM\\*", "*\\Intune\\*", "*\\Altiris\\*") username="SYSTEM") OR Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe"))
