DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\rundll32.exe" and OriginalFileName =~ "RUNDLL32.EXE") and (IntegrityLevel in ("Low", "Medium")) and ((ProcessCommandLine in ("*javascript:*", "*vbscript:*", "*mshtml,RunHTMLApplication*", "*url.dll,OpenURL*", "*url.dll,FileProtocolHandler*", "*shell32.dll,ShellExec_RunDLL*", "*pcwutl.dll,LaunchApplication*")) or (ProcessCommandLine in ("*http://*", "*https://*", "*\\*")) or (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*")) or ((ProcessCommandLine in ("*.txt*", "*.png*", "*.jpg*", "*.dat*", "*.inf*", "*.tmp*")) and (ProcessCommandLine in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\chrome.exe", "*\msedge.exe")))) and (not ((FolderPath in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*")) and (ParentProcessName in ("*\explorer.exe", "*\svchost.exe")) and (ProcessCommandLine in ("*.cpl*", "*shell32.dll,Control_RunDLL*"))))