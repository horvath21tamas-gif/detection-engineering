SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\WINWORD.EXE','%\EXCEL.EXE','%\POWERPNT.EXE','%\OUTLOOK.EXE','%\MSACCESS.EXE')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\mshta.exe','%\rundll32.exe','%\regsvr32.exe','%\bitsadmin.exe','%\certutil.exe','%\wscript.exe','%\cscript.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%http://%','%https://%','%-enc%','%Invoke-Expression%','%IEX%','%DownloadString%','%FromBase64String%','%/c%','%/r%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Microsoft\Office\%','%\INetCache\%')) AND NOT (("Parent Process CommandLine" LIKE '%\\Addins\\%' OR "Parent Process CommandLine" LIKE '%\\VSTO\\%' OR "Parent Process CommandLine" LIKE '%\\Program Files\\Microsoft Office\\%') OR ("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%'))
