SELECT UTF8(payload) as search_payload from events where (("operationName" LIKE '%User registered security info%' OR "operationName" LIKE '%Admin registered security info%')) AND (("targetResources.modifiedProperties.newValue" LIKE '%StrongAuthenticationPhoneAppDetail%' OR "targetResources.modifiedProperties.newValue" LIKE '%StrongAuthenticationUserDetails%')) AND ("additionalDetails.value"='MFA requirement satisfied by claim in the token' OR NOT (("ipAddress" LIKE '%203.0.113.%' OR "ipAddress" LIKE '%198.51.100.%'))) AND NOT (("initiatedBy.user.userPrincipalName" LIKE '%helpdesk-admin@%' OR "initiatedBy.user.userPrincipalName" LIKE '%it-support@%'))
