SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/kubectl','%/docker','%/crictl','%/podman')) AND (""Process CommandLine"" ILIKE ENUMERATION('% -it %','% -i %','% --interactive %')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/bin/sh%','%/bin/bash%','%/bin/zsh%','%/bin/dash%','%sh%','%bash%')) AND NOT (("UserName" LIKE '%jenkins%' OR "UserName" LIKE '%gitlab-runner%' OR "UserName" LIKE '%github-actions%' OR "UserName" LIKE '%zabbix%' OR "UserName" LIKE '%nagios%') OR ""Process CommandLine"" ILIKE ENUMERATION('%pg_dump%','%mysqldump%','%vacuumdb%','%healthcheck%') OR ""Parent Filename"" ILIKE '%/kubelet')
