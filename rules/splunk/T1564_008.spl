CommandLine IN ("*New-InboxRule*", "*Set-InboxRule*", "*Set-MailboxForwardingConfiguration*") (CommandLine IN ("*DeleteMessage*", "*PermanentDelete*", "*MarkAsRead*", "*MoveToFolder*") CommandLine IN ("*Security*", "*Alert*", "*Password*", "*MFA*", "*Sign-in*", "*Phish*", "*Compromise*", "*Unauthorized*")) OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\msedge.exe", "*\\chrome.exe", "*\\mshta.exe") NOT (username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*Spam*", "*Junk*", "*Internal-Auto-Forward*") OR ParentImage="*\\Windows\\System32\\svchost.exe*")
