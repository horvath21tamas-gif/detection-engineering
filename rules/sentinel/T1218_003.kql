DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where FolderPath endswith "\msiexec.exe" and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\brave.exe", "*\powershell.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe")) or ((ProcessCommandLine in ("*http*", "*ftp*", "* /q*", "* /p *", "* /y *", "* /z *")) and (ProcessCommandLine in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Downloads\*")))) and (not ((ParentProcessName in ("C:\Windows\System32\svchost.exe*", "C:\Windows\CCM\CcmExec.exe*", "C:\Program Files\Microsoft.Management.Services.IntuneWindowsAgent.exe*")) and username =~ "NT AUTHORITY\SYSTEM"))