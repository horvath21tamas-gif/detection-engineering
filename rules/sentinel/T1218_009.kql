DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\regsvcs.exe", "*\regasm.exe")) and (OriginalFileName in ("regsvcs.exe", "RegAsm.exe"))) and (IntegrityLevel in ("Low", "Medium")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*")) or ((ProcessCommandLine in ("* /U *", "* /uninstall *", "* /regfile*")) and ((ProcessCommandLine in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) or (ProcessCommandLine in ("*http://*", "*https://*", "*\\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\powerpnt.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe"))))) and (not ((FolderPath in ("C:\Windows\Microsoft.NET\Framework\*", "C:\Windows\Microsoft.NET\Framework64\*")) and ((ParentProcessName in ("*\msiexec.exe", "*\trustedinstaller.exe")) and IntegrityLevel =~ "High"))) and (not User startswith "NT AUTHORITY\")