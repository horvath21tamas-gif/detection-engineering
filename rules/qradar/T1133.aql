SELECT UTF8(payload) as search_payload from events where "EventID"=4624 AND "Logon Type"=10 AND NOT (("Source IP" LIKE '%10.%' OR "Source IP" LIKE '%192.168.%' OR "Source IP" LIKE '%172.16.%') OR ("Source IP" LIKE '%203.0.113.10%' OR "Source IP" LIKE '%203.0.113.11%')) OR "EventID"=4624 AND "Logon Type"=10 AND (("Source IP" LIKE '%127.0.0.1%' OR "Source IP" LIKE '%::1%') OR "Source IP"='-' OR "Source IP"='')
