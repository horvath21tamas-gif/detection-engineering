(process.command_line:(*user\ \/add* OR *user\ \/ad* OR *New\-LocalUser* OR *New\-ADUser* OR *ad\-user\ \-name*)) AND ((process.parent.executable.caseless:(*\\w3wp.exe OR *\\httpd.exe OR *\\sqlservr.exe OR *\\winword.exe OR *\\powershell.exe)) OR ((NOT ((process.parent.executable.caseless:(*\\CcmExec.exe OR *\\omadmac.exe OR *\\svchost.exe)) AND (process.executable.caseless:(*\\net.exe OR *\\net1.exe)) AND winlog.event_data.username:"NT AUTHORITY\\SYSTEM")) AND (NOT ((process.parent.executable.caseless:(*\\Windows\\Temp\\* OR *\\ConfigMgr\\*)) AND (process.command_line:(*MSSQL$* OR *IIS_*))))))
