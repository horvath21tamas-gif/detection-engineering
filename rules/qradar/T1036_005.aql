SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\cmd.exe%' OR "Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%' OR "Filename" LIKE '%\\robocopy.exe%' OR "Filename" LIKE '%\\xcopy.exe%')) AND (("Process CommandLine" LIKE '%copy %' OR "Process CommandLine" LIKE '%xcopy %' OR "Process CommandLine" LIKE '%robocopy %' OR "Process CommandLine" LIKE '%Copy-Item%')) AND (("Process CommandLine" LIKE '%\\svchost.exe%' OR "Process CommandLine" LIKE '%\\lsass.exe%' OR "Process CommandLine" LIKE '%\\services.exe%' OR "Process CommandLine" LIKE '%\\explorer.exe%' OR "Process CommandLine" LIKE '%\\winlogon.exe%' OR "Process CommandLine" LIKE '%\\csrss.exe%' OR "Process CommandLine" LIKE '%\\smss.exe%')) AND (("Process CommandLine" LIKE '%C:\\Windows\\System32\\%' OR "Process CommandLine" LIKE '%C:\\Windows\\SysWOW64\\%')) AND (("Process CommandLine" LIKE '%\\Users\\%' OR "Process CommandLine" LIKE '%\\AppData\\%' OR "Process CommandLine" LIKE '%\\Temp\\%' OR "Process CommandLine" LIKE '%\\ProgramData\\%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\Installer\\%' OR "ParentImage" LIKE '%\\Microsoft Configuration Manager\\%' OR "ParentImage" LIKE '%\\Windows\\CCM\\%' OR "ParentImage" LIKE '%\\PDQ\\%' OR "ParentImage" LIKE '%\\Ivanti\\%' OR "ParentImage" LIKE '%\\ManageEngine\\%' OR "ParentImage" LIKE '%\\Tanium\\%' OR "ParentImage" LIKE '%\\Setup\\%' OR "ParentImage" LIKE '%\\Update\\%'))
