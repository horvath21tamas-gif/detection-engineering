SELECT username, "Filename", "Parent Filename", Process "Process CommandLine", ParentCommandLine, Integrity Level, Process Path, File Hash from events where (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\acrord32.exe','%\acrobat.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\rundll32.exe','%\mshta.exe','%\regsvr32.exe','%\schtasks.exe','%\fodhelper.exe','%\eventvwr.exe','%\computerdefaults.exe','%\whoami.exe','%\net.exe','%\net1.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-encodedcommand%','% bypass%','% hidden%','%http://%','%https://%','%FromBase64String%','%DownloadString%','%Invoke-Expression%','%IEX %') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%runas%','% /savecred%','%token::elevate%','%uac%')) AND (("Integrity Level" LIKE '%High%' OR "Integrity Level" LIKE '%System%'))) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%--type=renderer%','%--type=utility%','%--type=gpu-process%','%--type=extension%','%Microsoft\EdgeUpdate%') OR (""Filename"" ILIKE ENUMERATION('%\WerFault.exe','%\conhost.exe')) AND "ParentCommandLine" ILIKE '%TrustedInstaller.exe%')
