(Image="*\\bcdedit.exe" CommandLine="* /set*" CommandLine="*safeboot*" CommandLine IN ("*minimal*", "*network*", "*alternateshell*", "*{current}*", "*{default}*")) OR (Image IN ("*\\reg.exe", "*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*\\System\\CurrentControlSet\\Control\\SafeBoot\\Minimal\\*", "*\\System\\CurrentControlSet\\Control\\SafeBoot\\Network\\*") CommandLine IN ("* delete *", "* /f*", "*Set-ItemProperty*", "*Remove-Item*", "* 0x0*", "* /d 0*")) OR (Image="*\\shutdown.exe" CommandLine="* /r*" CommandLine="* /f*" CommandLine="* /t 0*") OR CommandLine IN ("*Restart-Computer -Force*", "*ExitWindowsEx*") IntegrityLevel IN ("High", "System") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe", "*\\php-cgi.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\wmiprvse.exe", "*\\psexesvc.exe") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*") NOT (username IN ("NT AUTHORITY\\SYSTEM", "NT AUTHORITY\\LOCAL SERVICE", "NT AUTHORITY\\NETWORK SERVICE") ParentImage IN ("*\\services.exe*", "*\\svchost.exe*", "*\\CcmExec.exe*", "*\\TrustedInstaller.exe*", "*\\Program Files\\Microsoft Monitoring Agent\\*") CommandLine IN ("*reagentc.exe*", "*SystemReset.exe*", "*ResetThisPC*", "*WindowsRecovery*")) | table Image,ParentImage,CommandLine,IntegrityLevel,User,Hashes
