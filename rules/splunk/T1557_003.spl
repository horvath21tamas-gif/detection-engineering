CommandLine IN ("* --dns *", "* --gateway *", "* --lease *", "* -d *", "*spoof*", "*rogue*") OR Image IN ("*\\python.exe", "*\\pythonw.exe", "*\\powershell.exe") OR CommandLine IN ("*Responder*", "*bettercap*", "*ettercap*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*") NOT ((Image IN ("*\\Program Files\\VMware\\*", "*\\Program Files\\Oracle\\VirtualBox\\*", "*\\Program Files\\Docker\\*") username="NT AUTHORITY\\SYSTEM") OR (Image="*\\System32\\svchost.exe" CommandLine="*dhcpssvc*"))
