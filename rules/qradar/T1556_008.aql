SELECT UTF8(payload) as search_payload from events where (("targetResources.displayName" LIKE '%AnyConnect%' OR "targetResources.displayName" LIKE '%FortiGate%' OR "targetResources.displayName" LIKE '%GlobalProtect%' OR "targetResources.displayName" LIKE '%Check Point%' OR "targetResources.displayName" LIKE '%Pulse Secure%' OR "targetResources.displayName" LIKE '%F5 Big-IP%' OR "targetResources.displayName" LIKE '%Palo Alto%') OR "operationName"='Update conditional access policy' AND "targetResources.displayName" ILIKE '%MFA%' OR ("operationName" LIKE '%Add owner to application%' OR "operationName" LIKE '%Update application – Certificates and secrets management%' OR "operationName" LIKE '%Add credential%' OR "operationName" LIKE '%Update service principal credentials%')) AND NOT ((("initiatedBy.userPrincipalName" LIKE '%admin_secure@company.com%' OR "initiatedBy.userPrincipalName" LIKE '%itops@company.com%')) AND (("userAgent" LIKE '%HashiCorp/%' OR "userAgent" LIKE '%Ansible%' OR "userAgent" LIKE '%Terraform/%')))
