DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath endswith "\netsh.exe" and (ProcessCommandLine in ("*trace start*", "*capture=yes*", "*report=yes*"))) or (FolderPath endswith "\pktmon.exe" and (ProcessCommandLine in ("*start*", "*capture*", "*--etw*")))) or (ProcessCommandLine in ("*npcap*", "*winpcap*", "*packet.dll*", "*wpcap.dll*", "*ndiscap.sys*")) or ((FolderPath in ("*\tshark.exe", "*\windump.exe", "*\ettercap.exe", "*\bettercap.exe", "*\dsniff.exe")) or (ProcessCommandLine in ("*responder*", "*scapy*", "*-i eth0*")))) and (FolderPath in ("*\Users\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (not ((FolderPath in ("*\Program Files\Wireshark\*", "*\Program Files\Microsoft Message Analyzer\*", "*\Windows\System32\wbem\wmiprvse.exe*")) and User =~ "NT AUTHORITY\SYSTEM"))