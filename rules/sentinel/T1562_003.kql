DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and ProcessCommandLine contains "Set-PSReadLineOption") and (ProcessCommandLine in ("*$false*", "*$null*", "*\"\"*", "*/dev/null*"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*-enc*", "*-EncodedCommand*"))) or (FolderPath endswith "\reg.exe" and (ProcessCommandLine contains "add" and ProcessCommandLine contains "HKCU\Software\Microsoft\Windows\CurrentVersion\Console" and ProcessCommandLine contains "HistoryBufferSize") and (ProcessCommandLine in ("* 0*", "*/d 0*"))) or (ProcessCommandLine in ("*\ConsoleHost_history.txt*", "*\AppData\Roaming\Microsoft\Windows\PowerShell\PSReadLine\*", "*\.bash_history*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe", "*\mshta.exe", "*\rundll32.exe")) or (not ((ParentProcessName in ("*\Common7\IDE\devenv.exe*", "*\Microsoft VS Code\Code.exe*", "*\JetBrains\*")) or (User startswith "NT AUTHORITY" and ParentProcessName endswith "\services.exe") or (ProcessCommandLine in ("*AppData\Local\Temp\SDI*", "*Chocolatey*", "*SCCM*")))))