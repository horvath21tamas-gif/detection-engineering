CommandLine IN ("*[System.IO.MemoryStream]*", "*System.Convert]::ToBase64*", "*.ReadBytes(*", "*.ReadAllBytes(*", "*Get-Content -Encoding Byte*", "*FromBase64String(*", "*Compress-Archive*", "*System.IO.Compression*", "*GZipStream*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\regsvcs.exe", "*\\mshta.exe", "*\\certutil.exe", "*\\wmic.exe", "*\\cscript.exe", "*\\wscript.exe") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\wmiprvse.exe", "*\\wsmprovhost.exe", "*\\svchost.exe") IntegrityLevel="Medium" NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*Windows\\Logs*", "*softwareupdate*", "*defender*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
