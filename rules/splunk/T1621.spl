CommandLine IN ("*AADInternals*", "*MSAL.PS*", "*Okta.Auth*", "*puppeteer*", "*selenium-webdriver*", "*Playwright*") OR CommandLine IN ("*Invoke-AADIntMFAFlood*", "*while($true)*", "*for($i=0*", "*.ShowPasswordPrompt*", "*Send-PushNotification*") OR CommandLine IN ("*-WindowStyle Hidden*", "*-ExecutionPolicy Bypass*", "*-NonInteractive*") ParentImage IN ("*\\chrome.exe", "*\\msedge.exe", "*\\winword.exe", "*\\excel.exe", "*\\taskeng.exe") NOT (Image IN ("*\\Program Files\\Microsoft Azure AD Connect\\*", "*\\Program Files\\Microsoft Azure AD Sync\\*") username="NT AUTHORITY\\SYSTEM")
