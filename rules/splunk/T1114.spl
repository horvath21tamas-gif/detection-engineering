(CommandLine IN ("*New-Object -ComObject Outlook.Application*", "*CreateObject(\"Outlook.Application\")*", "*GetDefaultFolder(6)*", "*GetDefaultFolder(5)*", "*.GetNamespace(\"MAPI\")*") CommandLine IN ("*.SaveAs(*", "*.Attachments*", "*ContentFilter*", "*New-MailboxExportRequest*")) OR (CommandLine IN ("*.SaveAs(*", "*.Attachments*", "*ContentFilter*", "*New-MailboxExportRequest*") CommandLine IN ("* -WindowStyle Hidden*", "*SilentlyContinue*", "*.Display = $false*") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\mshta.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\Microsoft Office\\*", "*C:\\Program Files (x86)\\Microsoft Office\\*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*HealthCheck.ps1*", "*Add-in*")))
