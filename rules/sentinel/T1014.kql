DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\kdmapper.exe", "*\kdu.exe", "*\drvmap.exe", "*\gdriver.exe")) or (ProcessCommandLine contains "type= kernel" and (ProcessCommandLine in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*", "*\Downloads\*", "*\Desktop\*"))) or ((ProcessCommandLine in ("*RTCore64.sys*", "*gdrv.sys*", "*ene.sys*", "*WinRing0.sys*", "*procexp.sys*")) and (ProcessCommandLine in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*", "*\Downloads\*", "*\Desktop\*")))) and (not ((FolderPath in ("C:\Windows\System32\msiexec.exe*", "C:\Windows\System32\DriverStore\*", "C:\Windows\System32\drvinst.exe*")) and User =~ "NT AUTHORITY\SYSTEM"))