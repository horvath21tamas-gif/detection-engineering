SELECT UTF8(payload) as search_payload from events where "Filename" IMATCHES '(\\AppData\\Roaming\\Microsoft\\Word\\STARTUP\\|\\AppData\\Roaming\\Microsoft\\Excel\\XLSTART\\|\\AppData\\Local\\Microsoft\\Office\\AddIns\\)' AND "Filename" IMATCHES '(\.wll|\.xll)$' AND ""Filename"" IMATCHES '(msiexec\.exe|OfficeClickToRun\.exe|setup\.exe|powershell\.exe|cmd\.exe|browser\.exe|outlook\.exe)$' AND NOT ("Filename" IMATCHES '(\\Adobe\\|\\Webex\\)' AND ""Filename"" IMATCHES '^(C:\\Program Files\\|C:\\Program Files \(x86\)\\)')
