SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%get-signin-token%','%r=signin%','%sts get-session-token%','%gcloud auth print-access-token%','%okta-auth-token%','%portal.azure.com%','%account.google.com/ServiceLogin%','%login.microsoftonline.com%') OR (""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%--incognito%','%--new-window%','%--app=%','%console.aws.amazon.com%','%portal.azure.com%','%cloud.google.com%','%okta.com%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\httpd.exe','%\sqlservr.exe','%\taskhostw.exe','%\explorer.exe')) AND ""Parent Filename"" ILIKE '%\AppData\Local\Temp\%' AND (("Parent Process CommandLine" LIKE '%-NonInteractive%' OR "Parent Process CommandLine" LIKE '%-EncodedCommand%' OR "Parent Process CommandLine" LIKE '%/c powershell%')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-NonInteractive%','%-EncodedCommand%','%/c%'))) AND NOT (("Process "Process CommandLine"" ILIKE ENUMERATION('%sso login%','%login --use-device-code%','%az login%','%aws sso login%')) AND (("Computer Name" LIKE '%ADMIN-VDI-%' OR "Computer Name" LIKE '%DEV-VM-%')))
