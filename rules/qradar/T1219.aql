SELECT UTF8(payload) as search_payload from events where (("Service Name " LIKE '%PSEXECSVC%' OR "Service Name " LIKE '%PAExec%' OR "Service Name " LIKE '%RemComSvc%' OR "Service Name " LIKE '%CSEXEC%' OR "Service Name " LIKE '%ATSVC%')) AND NOT (("Machine ID" LIKE '%MGMT-%' OR "Machine ID" LIKE '%SCCM-%' OR "Machine ID" LIKE '%DEPLOY-%' OR "Machine ID" LIKE '%ADMIN-%') OR ("UserName" LIKE '%svc_%' OR "UserName" LIKE '%admin_%' OR "UserName" LIKE '%deploy%' OR "UserName" LIKE '%sccm%' OR "UserName" LIKE '%ansible%' OR "UserName" LIKE '%pdq%') OR ("Filename" LIKE '%\\Windows\\CCM\\%' OR "Filename" LIKE '%\\Microsoft Configuration Manager\\%' OR "Filename" LIKE '%\\PDQ\\%' OR "Filename" LIKE '%\\Ivanti\\%' OR "Filename" LIKE '%\\ManageEngine\\%' OR "Filename" LIKE '%\\Tanium\\%'))
