SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\logman.exe' AND "Process "Process CommandLine"" ILIKE '% stop %' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%EventLog-System%','%EventLog-Security%','%Microsoft-Windows-DotNETRuntime%','%Microsoft-Windows-Web-Http%','%NT Kernel Logger%','%Circular Kernel Context Logger%')) OR ""Filename"" ILIKE '%\logman.exe' AND "Process "Process CommandLine"" ILIKE '% delete %' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%EventLog%','%Kernel%','%trace%')) OR ""Filename"" ILIKE '%\wecutil.exe' AND "Process "Process CommandLine"" ILIKE '% /e:false%' OR ""Filename"" ILIKE '%\wecutil.exe' AND "Process "Process CommandLine"" ILIKE '% ds %' AND "Process "Process CommandLine"" ILIKE '%Subscription%' OR ""Filename"" ILIKE '%\netsh.exe' AND "Process "Process CommandLine"" ILIKE '%advfirewall%' AND "Process "Process CommandLine"" ILIKE '%add rule%' AND "Process "Process CommandLine"" ILIKE '%block%' AND "Process "Process CommandLine"" ILIKE '%remoteport=443%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%remoteip=%','%defender%','%security%','%edr%','%telemetry%','%crowdstrike%','%sentinel%','%carbonblack%')) OR ""Filename"" ILIKE '%\powershell.exe' AND "Process "Process CommandLine"" ILIKE '%New-NetFirewallRule%' AND "Process "Process CommandLine"" ILIKE '%-Action Block%' AND "Process "Process CommandLine"" ILIKE '%-Direction Outbound%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%443%','%defender%','%security%','%edr%','%telemetry%','%crowdstrike%','%sentinel%','%carbonblack%'))) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%Microsoft Monitoring Agent%','%SplunkUniversalForwarder%','%AzureMonitorAgent%','%Elastic Agent%','%SCOM%','%Defender for Endpoint%','%Docker%')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND ""Parent Filename"" ILIKE '%\services.exe') AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\w3wp.exe','%\rundll32.exe','%\mshta.exe'))
