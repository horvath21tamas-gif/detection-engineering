DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (User startswith "NT AUTHORITY\" and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (FolderPath in ("*\python.exe", "*\pythonw.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe"))) and ((FolderPath endswith "\reg.exe" and (ProcessCommandLine in ("*HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters*", "*IPEnableRouter*", "*1*"))) or (ProcessCommandLine in ("* -interface *", "* -i *", "* -r *", "* -f *", "* -force*", "* -LLMNR *", "* -NBTNS *", "* -m arp*", "* --spoof *", "*arpspoof*", "*Responder*", "*Inveigh*", "*mitm6*", "*SMBRelay*")))) and (not ((ParentProcessName in ("*\VMware\*", "*\Oracle\VirtualBox\*", "*\Docker\*", "*\Hyper-V\*")) or ((FolderPath in ("*\Cisco\AnyConnect\*", "*\OpenVPN\*", "*\WireGuard\*")) and username =~ "NT AUTHORITY\SYSTEM")))