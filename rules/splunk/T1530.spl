Image IN ("*\\aws.exe", "*\\az.exe", "*\\gsutil.exe", "*\\rclone.exe", "*\\mc.exe") CommandLine IN ("*--access-key*", "*--secret-key*", "*--connection-string*", "*SharedAccessSignature*", "*--account-key*") OR CommandLine IN ("* s3 sync *", "* storage blob download-batch *", "* cp --recursive *", "* cp -r *", "* ls -R *", "* --include \"*.*\"*") ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\nginx.exe", "*\\powershell.exe", "*\\cmd.exe") IntegrityLevel="Medium" NOT (CommandLine IN ("*Azure-Log-Collector*", "*C:\\Program Files\\Microsoft SDKs\\*", "*cloud-init*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\Jenkins\\*")
