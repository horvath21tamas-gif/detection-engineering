SELECT UTF8(payload) as search_payload from events where ("Parent"Filename"" ILIKE ENUMERATION('%\WINWORD.EXE','%\EXCEL.EXE','%\POWERPNT.EXE','%\OUTLOOK.EXE','%\MSACCESS.EXE')) AND (("Filename" LIKE '%\cmd.exe%' OR "Filename" LIKE '%\powershell.exe%' OR "Filename" LIKE '%\pwsh.exe%' OR "Filename" LIKE '%\mshta.exe%' OR "Filename" LIKE '%\rundll32.exe%' OR "Filename" LIKE '%\regsvr32.exe%' OR "Filename" LIKE '%\bitsadmin.exe%' OR "Filename" LIKE '%\certutil.exe%'))
