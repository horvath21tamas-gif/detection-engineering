CommandLine IN ("*securityd*", "*keychain.db*") Image IN ("*/lldb", "*/gcore", "*/vmmap", "*/heap", "*/frida-server") OR CommandLine IN ("*attach*", "*memory read*", "*dump*", "*save*", "*--pid*", "*-p*") OR (Image IN ("*/Users/*", "*/tmp/*", "*/var/tmp/*", "*/Library/Caches/*") Image IN ("*/python3", "*/python", "*/ruby", "*/node")) NOT (ParentImage IN ("*/usr/bin/sysdiagnose", "*/usr/libexec/periodic-wrapper", "*/System/Library/CoreServices/ReportCrash", "*/usr/bin/spindump") OR ParentImage="*/Applications/Xcode.app/*")
