DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("*Get-Recipient -ResultSize Unlimited*", "*Get-Mailbox -ResultSize Unlimited*", "*Get-GlobalAddressList*", "*Get-AddressList*", "*Get-ADUser -Properties ProxyAddresses*")) or (ProcessCommandLine in ("*Microsoft\Outlook\*.xml*", "*profiles.ini*", "*Identity.xml*"))) and (ProcessCommandLine in ("* | Export-Csv*", "* > *", "*base64*", "*ConvertTo-Json*", "* | clip*"))) or (((ProcessCommandLine in ("*Get-Recipient -ResultSize Unlimited*", "*Get-Mailbox -ResultSize Unlimited*", "*Get-GlobalAddressList*", "*Get-AddressList*", "*Get-ADUser -Properties ProxyAddresses*")) and (ParentProcessName in ("*\httpd.exe", "*\sqlservr.exe", "*\wsmprovhost.exe", "*\winword.exe", "*\excel.exe"))) and (not (User =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Exchange Server\bin\*", "*\Program Files\Veritas\*", "*\Program Files\Veeam\*")))))