DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (Message in ("*copy tftp flash*", "*copy ftp flash*", "*request system software add*", "*update firmware*", "*boot system flash*", "*install activate*", "*request platform software*")) and (Message in ("*tftp*", "*unauthenticated*", "*unknown source*", "*checksum failed*", "*hash mismatch*", "*signature validation failed*", "*untrusted image*", "*corrupt image*")) and (not ((SourceIP in ("10.50.0.10", "10.50.0.11", "10.50.0.12")) or (Message in ("*copy running-config*", "*copy startup-config*", "*archive config*", "*save config*"))))