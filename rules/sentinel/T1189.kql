DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ParentProcessName in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\brave.exe", "*\opera.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\mshta.exe", "*\cscript.exe", "*\wscript.exe", "*\certutil.exe", "*\scrcons.exe", "*\regsvr32.exe", "*\rundll32.exe")) and (not ((ProcessCommandLine in ("*--type=renderer*", "*--type=gpu-process*", "*--type=utility*", "*--type=crashpad-handler*", "*--type=extension*")) or (ProcessCommandLine in ("*dw20.exe*", "*ie_to_edge_stub.exe*")) or (FolderPath in ("*\Google\Update\*", "*\Microsoft\EdgeUpdate\*"))))