SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/kubectl','%/k3s','%/docker','%/crictl','%/nerdctl','%/oc')) AND (""Process CommandLine"" ILIKE ENUMERATION('%auth can-i%','%get secrets%','%describe pod%','%describe deployment%','%get nodes%','%get svc%','%get configmaps%','%inspect%','%logs%','%exec%')) AND ((""Parent Filename"" ILIKE ENUMERATION('%/www-data%','%/nginx%','%/httpd%','%/php-fpm%','%/python%','%/node%')) AND (("UserName" LIKE '%root%' OR "UserName" LIKE '%www-data%' OR "UserName" LIKE '%nginx%')) OR ""Process CommandLine"" ILIKE ENUMERATION('%--format json%','%-o json%','% | jq%','% > %','%--all-namespaces%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%/usr/bin/kubelet%','%/datadog-agent%','%/prometheus%','%/telegraf%','%/rancher%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%get pods --watch%','%--version%','%metrics-server%')))
