SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/systemctl','%/systemd-analyze')) AND (""Process CommandLine"" ILIKE ENUMERATION('%enable%','%start%','%daemon-reload%','%--user%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%base64%','%curl%','%wget%','%python%','%perl%','%ruby%','%nc %','%sh -c%','%/tmp/%','%/var/tmp/%','%/dev/tcp/%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/apt','%/yum','%/dnf','%/dpkg','%/ansible-playbook','%/salt-minion') OR "username"='root' AND (""Process CommandLine"" ILIKE ENUMERATION('%apt-daily%','%motd-news%','%logrotate%')))
