((process.command_line:(*Resolve\-DnsName* OR *\[System.Net.Dns\]\:\:* OR *nslookup* OR *dnscmd* OR *\-querytype* OR *\-Retry* OR *while\(* OR *for\(* OR *Start\-Sleep*)) AND (process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\rundll32.exe OR *\\mshta.exe OR *\\cmd.exe))) OR ((process.command_line:/(?i).*[a-z0-9]{18,}\.(top|xyz|pw|icu|bid|monster|live|club|ga|tk|cf|ml|buzz|online)$/ AND (process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\rundll32.exe OR *\\mshta.exe OR *\\cmd.exe))) AND (NOT ((process.command_line:(*C\:\\Program\ Files\\* OR *Microsoft\\Azure* OR *internal.corp* OR *Check\-Connectivity* OR *domain\-verification* OR *update.microsoft.com*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM" OR (process.parent.executable.caseless:(*\\services.exe OR *\\explorer.exe)))))
