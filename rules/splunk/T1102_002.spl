CommandLine IN ("*/sendMessage*", "*/getUpdates*", "*chat.postMessage*", "*files.upload*", "*/webhooks/*", "*invocations*", "*channels.messages*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*", "*\\PerfLogs\\*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\curl.exe", "*\\rundll32.exe", "*\\certutil.exe", "*\\cmd.exe") CommandLine IN ("*api.telegram.org*", "*slack.com/api*", "*discord.com/api*", "*api.github.com*", "*graph.microsoft.com*") NOT (Image IN ("*\\Local\\Discord\\app-*", "*\\Local\\slack\\app-*", "*\\Program Files\\Microsoft\\Teams*", "*\\Program Files\\*") OR CommandLine="*127.0.0.1*" OR username="NT AUTHORITY\\SYSTEM")
