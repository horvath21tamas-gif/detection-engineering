SELECT SrcIp, UriStem, UriQuery, Status, UserAgent from events where (("SrcIp" LIKE '%1.%' OR "SrcIp" LIKE '%2.%' OR "SrcIp" LIKE '%3.%' OR "SrcIp" LIKE '%4.%' OR "SrcIp" LIKE '%5.%' OR "SrcIp" LIKE '%6.%' OR "SrcIp" LIKE '%7.%' OR "SrcIp" LIKE '%8.%' OR "SrcIp" LIKE '%9.%')) AND (("UriStem" LIKE '%/login%' OR "UriStem" LIKE '%/signin%' OR "UriStem" LIKE '%/auth%' OR "UriStem" LIKE '%/admin%' OR "UriStem" LIKE '%/administrator%' OR "UriStem" LIKE '%/wp-login%' OR "UriStem" LIKE '%/wp-admin%' OR "UriStem" LIKE '%/account%' OR "UriStem" LIKE '%/user%')) AND (("UriQuery" LIKE '%user=%' OR "UriQuery" LIKE '%username=%' OR "UriQuery" LIKE '%login=%' OR "UriQuery" LIKE '%email=%' OR "UriQuery" LIKE '%account=%')) AND (("Status" LIKE '%401%' OR "Status" LIKE '%403%' OR "Status" LIKE '%404%')) AND (("UserAgent" LIKE '%python%' OR "UserAgent" LIKE '%curl%' OR "UserAgent" LIKE '%wget%' OR "UserAgent" LIKE '%httpclient%' OR "UserAgent" LIKE '%go-http-client%' OR "UserAgent" LIKE '%libwww%' OR "UserAgent" LIKE '%scrapy%')) AND NOT (("UserAgent" LIKE '%Mozilla%' OR "UserAgent" LIKE '%Chrome%' OR "UserAgent" LIKE '%Safari%' OR "UserAgent" LIKE '%Firefox%' OR "UserAgent" LIKE '%Edge%') OR ("UserAgent" LIKE '%nessus%' OR "UserAgent" LIKE '%qualys%' OR "UserAgent" LIKE '%openvas%' OR "UserAgent" LIKE '%acunetix%' OR "UserAgent" LIKE '%nikto%' OR "UserAgent" LIKE '%nuclei%' OR "UserAgent" LIKE '%zap%' OR "UserAgent" LIKE '%burp%') OR ("UriStem" LIKE '%.css%' OR "UriStem" LIKE '%.js%' OR "UriStem" LIKE '%.png%' OR "UriStem" LIKE '%.jpg%' OR "UriStem" LIKE '%.ico%' OR "UriStem" LIKE '%.svg%' OR "UriStem" LIKE '%.woff%' OR "UriStem" LIKE '%.json%'))
