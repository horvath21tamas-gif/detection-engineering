DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*/PlistBuddy", "*/defaults", "*/plutil")) and ((ProcessCommandLine in ("*RunAtLoad*", "*ProgramArguments*", "*StartCalendarInterval*", "*KeepAlive*", "*Label*", "*LaunchEvents*")) or (ProcessCommandLine in ("*/LaunchAgents*", "*/LaunchDaemons*", "*/Preferences/com.apple.loginitems.plist*", "*/Library/StartupItems*"))) and ((ParentProcessName in ("*/Safari.app/*", "*/Google Chrome.app/*", "*/Microsoft Word.app/*", "*/Terminal.app/*", "*/iTerm.app/*")) or (not ((FolderPath in ("/usr/sbin/softwareupdate*", "/System/Library/PrivateFrameworks/*")) and (ParentProcessName in ("/System/Library/CoreServices/*", "/usr/libexec/xpcproxy*")))))