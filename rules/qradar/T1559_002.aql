SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\cscript.exe','%\wscript.exe','%\mshta.exe','%\rundll32.exe','%\regsvr32.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%DDEAUTO%','%DDE %','%/c start%','%http%','%powershell -e%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%workbook%','%dde_link%','%RTD%') OR ""Parent Filename"" ILIKE '%Program Files%')
