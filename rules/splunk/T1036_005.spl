Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\robocopy.exe", "*\\xcopy.exe") CommandLine IN ("*copy *", "*xcopy *", "*robocopy *", "*Copy-Item*") CommandLine IN ("*\\svchost.exe*", "*\\lsass.exe*", "*\\services.exe*", "*\\explorer.exe*", "*\\winlogon.exe*", "*\\csrss.exe*", "*\\smss.exe*") CommandLine IN ("*C:\\Windows\\System32\\*", "*C:\\Windows\\SysWOW64\\*") CommandLine IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*") NOT (User IN ("*NT AUTHORITY\\SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*") OR ParentImage IN ("*\\Windows\\Installer\\*", "*\\Microsoft Configuration Manager\\*", "*\\Windows\\CCM\\*", "*\\PDQ\\*", "*\\Ivanti\\*", "*\\ManageEngine\\*", "*\\Tanium\\*", "*\\Setup\\*", "*\\Update\\*"))
