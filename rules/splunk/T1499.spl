CommandLine IN ("* /f /im lsass.exe*", "* /f /im csrss.exe*", "* /f /im wininit.exe*", "* /f /im smss.exe*", "* /f /im services.exe*") OR CommandLine IN ("*while($true)*", "*::MemoryStream*", "*foreach($i in 1..1000000)*", "* -Recursive*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\outlook.exe") OR Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe", "*\\TiWorker.exe") OR CommandLine IN ("*HealthCheck*", "*Diagnostic*"))
