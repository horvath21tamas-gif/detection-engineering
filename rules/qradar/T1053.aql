SELECT UTF8(payload) as search_payload from events where (("Image" LIKE '%\schtasks.exe%' OR "Image" LIKE '%\at.exe%' OR "Image" LIKE '%\powershell.exe%' OR "Image" LIKE '%\cmd.exe%')) AND (("Process CommandLine" LIKE '%schtasks%' OR "Process CommandLine" LIKE '%/create%' OR "Process CommandLine" LIKE '%/sc%' OR "Process CommandLine" LIKE '%Register-ScheduledTask%' OR "Process CommandLine" LIKE '%New-ScheduledTask%' OR "Process CommandLine" LIKE '%at %')) AND (("Process CommandLine" LIKE '%\AppData\%' OR "Process CommandLine" LIKE '%\Users\Public\%' OR "Process CommandLine" LIKE '%\ProgramData\%' OR "Process CommandLine" LIKE '%\Temp\%' OR "Process CommandLine" LIKE '%powershell%' OR "Process CommandLine" LIKE '%cmd.exe%' OR "Process CommandLine" LIKE '%wscript%' OR "Process CommandLine" LIKE '%cscript%' OR "Process CommandLine" LIKE '%mshta%' OR "Process CommandLine" LIKE '%rundll32%' OR "Process CommandLine" LIKE '%.ps1%' OR "Process CommandLine" LIKE '%.vbs%' OR "Process CommandLine" LIKE '%.js%')) AND NOT (("username" LIKE '%SYSTEM%' OR "username" LIKE '%LOCAL SERVICE%' OR "username" LIKE '%NETWORK SERVICE%') OR ("Process CommandLine" LIKE '%\Microsoft\Windows\%' OR "Process CommandLine" LIKE '%Windows Defender%' OR "Process CommandLine" LIKE '%OneDrive%' OR "Process CommandLine" LIKE '%GoogleUpdate%' OR "Process CommandLine" LIKE '%Adobe%'))
