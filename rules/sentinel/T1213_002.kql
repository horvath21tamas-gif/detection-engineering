DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*Get-PnP*", "*Get-SPO*", "*Connect-PnPOnline*", "*Microsoft.SharePoint.PowerShell*", "*/_api/web/lists*", "*/_api/search/query*", "*Export-PnPListItem*", "*Get-PnPListItem*")) and ((ProcessCommandLine in ("* -All*", "* -Recurse*", "* -PageSize 1000*", "* -Limit All*", "* -BatchSize *", "* -AsJob*")) or (ProcessCommandLine in ("*\Users\Public\*", "*\Windows\Temp\*", "*\AppData\Local\Temp\*", "* -OutFile *", "* -Path *"))) and ((ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\w3wp.exe", "*\explorer.exe", "*\taskhostw.exe")) and (IntegrityLevel in ("Medium", "High"))) and (not ((FolderPath in ("*C:\Program Files\SharePoint Online Management Shell\*", "*C:\Program Files\Microsoft SDKs\SharePoint\*", "*C:\Program Files\Office\root\Office*", "*C:\Program Files\OneDrive\*")) or (User in ("NT AUTHORITY\SYSTEM*", "DOMAIN\svc_*", "DOMAIN\backup_*")) or (ProcessCommandLine in ("*OfficeClickToRun.exe*", "*OneDrive.exe*", "*HealthCheck*", "* --version*", "* -help*"))))