(Image="*\\certutil.exe" CommandLine IN ("*-decode*", "*-decodehex*")) OR (Image IN ("*\\expand.exe", "*\\extrac32.exe") CommandLine IN ("*.txt*", "*.jpg*", "*.png*", "*.xml*", "*.log*")) ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\nginx.exe", "*\\httpd.exe", "*\\mshta.exe") OR (CommandLine IN ("*\\Users\\*", "*\\Temp\\*", "*\\AppData\\*", "*.exe*", "*.dll*", "*.vbs*", "*.ps1*") NOT (ParentImage IN ("*\\Windows\\servicing\\TrustedInstaller.exe*", "*\\CcmExec.exe*", "*\\Package Cache\\*") OR Image IN ("*\\Program Files\\*", "*\\Windows\\System32\\*") OR CommandLine="*Microsoft\\Windows\\SoftwareDistribution*"))
