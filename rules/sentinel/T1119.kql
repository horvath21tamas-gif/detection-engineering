DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("* -Recurse *", "* /s *", "* -Include *.*", "* -Filter *.*", "*copy *.*")) and (ProcessCommandLine in ("*.doc*", "*.pdf*", "*.xls*", "*.pst*", "*.key*", "*.msg*", "*.pfx*", "*.rdp*")) and (ProcessCommandLine in ("*\Users\Public*", "*\Windows\Temp*", "*\AppData\Local\Temp*", "*C:\ProgramData*")) and ((ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\powershell.exe", "*\cmd.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Program Files\Microsoft Monitoring Agent\*", "*C:\Windows\CCM\*", "*\OneDrive.exe*")) or (ProcessCommandLine in ("* -Filter *.log*", "*HealthCheck*")) or User =~ "NT AUTHORITY\SYSTEM"))