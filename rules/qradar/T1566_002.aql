SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\brave.exe','%\opera.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\scrcons.exe','%\regsvr32.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Downloads\%','%\AppData\Local\Temp\%','%\Users\Public\%','%C:\Windows\Temp\%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%--type=%','%crashpad-handler%','%--extension-process%','%\Google\Update\%','%\Microsoft\EdgeUpdate\%') OR (""Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\setup.exe','%\install.exe')) AND "Process "Process CommandLine"" ILIKE '%C:\Program Files%')
