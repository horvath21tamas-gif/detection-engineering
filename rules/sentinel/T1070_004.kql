DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath endswith "\fsutil.exe" and (ProcessCommandLine in ("*usn*", "*deletejournal*"))) or (ProcessCommandLine in ("*\Windows\Prefetch\*", "*\Windows\AppCompat\Programs\Amcache.hve*", "*\System32\config\journal*"))) or ((FolderPath in ("*\sdelete.exe", "*\sdelete64.exe")) or (FolderPath endswith "\cipher.exe" and ProcessCommandLine contains " /w") or (FolderPath endswith "\powershell.exe" and (ProcessCommandLine in ("*Remove-Item*", "* -Recurse*", "* -Force*"))))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\w3wp.exe", "*\sqlservr.exe", "*\powershell.exe", "*\cmd.exe")) or (not ((FolderPath in ("*\cleanmgr.exe", "*\dism.exe")) or (ParentProcessName in ("*\msiexec.exe", "*\TiWorker.exe")) or ProcessCommandLine contains "\Windows\SoftwareDistribution\Download" or User startswith "NT AUTHORITY\")))