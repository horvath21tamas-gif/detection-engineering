DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\rundll32.exe" or OriginalFileName =~ "RUNDLL32.EXE") and ((ProcessCommandLine in ("*javascript:*", "*vbscript:*", "*url.dll,OpenURL*", "*url.dll,FileProtocolHandler*", "*pcwutl.dll,LaunchApplication*", "*shell32.dll,Control_RunDLL*")) or ((ProcessCommandLine in ("*\AppData\*", "*\Users\Public\*", "*\Temp\*", "*\Downloads\*", "*.txt*", "*.png*", "*.jpg*", "*.dat*", "*.inf*")) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\powershell.exe", "*\cmd.exe", "*\wscript.exe", "*\mshta.exe")))) and (not ((ProcessCommandLine in ("*C:\Windows\System32\*", "*C:\Windows\SysWOW64\*", "*C:\Windows\WinSxS\*")) and ParentProcessName endswith "\explorer.exe" and username =~ "NT AUTHORITY\SYSTEM"))