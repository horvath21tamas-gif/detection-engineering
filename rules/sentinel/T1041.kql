DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("* [System.IO.MemoryStream]*", "* [System.Convert]::ToBase64*", "* .ReadBytes(*", "* .ReadAllBytes(*", "*Compress-Archive*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\rundll32.exe", "*\regsvcs.exe", "*\mshta.exe", "*\certutil.exe")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\wmiprvse.exe", "*\svchost.exe"))) and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*Windows\Logs*", "*softwareupdate*")) or username =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))