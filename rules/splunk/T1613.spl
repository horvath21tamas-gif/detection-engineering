Image IN ("*/kubectl", "*/docker", "*/crictl", "*/nerdctl") CommandLine IN ("*auth can-i*", "*get secrets*", "*describe pod*", "*inspect*", "*get nodes*") (ParentImage IN ("*/www-data*", "*/nginx*", "*/httpd*", "*/php-fpm*", "*/python*") username="root") OR CommandLine IN ("*--format json*", "*-o json*", "* | jq*", "* > *") NOT (Image IN ("*/usr/bin/kubelet*", "*/datadog-agent*") CommandLine IN ("*get pods --watch*", "*--version*"))
