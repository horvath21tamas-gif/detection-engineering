SELECT SrcIp, Method, UriStem, UriQuery, Status, UserAgent from events where (("SrcIp" LIKE '%1.%' OR "SrcIp" LIKE '%2.%' OR "SrcIp" LIKE '%3.%' OR "SrcIp" LIKE '%4.%' OR "SrcIp" LIKE '%5.%' OR "SrcIp" LIKE '%6.%' OR "SrcIp" LIKE '%7.%' OR "SrcIp" LIKE '%8.%' OR "SrcIp" LIKE '%9.%')) AND (("UriStem" LIKE '%/login%' OR "UriStem" LIKE '%/signin%' OR "UriStem" LIKE '%/auth%' OR "UriStem" LIKE '%/account%' OR "UriStem" LIKE '%/user%' OR "UriStem" LIKE '%/users%' OR "UriStem" LIKE '%/password%' OR "UriStem" LIKE '%/forgot%' OR "UriStem" LIKE '%/reset%')) AND (("UriQuery" LIKE '%user=%' OR "UriQuery" LIKE '%username=%' OR "UriQuery" LIKE '%email=%' OR "UriQuery" LIKE '%login=%' OR "UriQuery" LIKE '%account=%' OR "UriQuery" LIKE '%upn=%' OR "UriQuery" LIKE '%principal=%')) AND (("Method" LIKE '%GET%' OR "Method" LIKE '%POST%')) AND (("UserAgent" LIKE '%curl%' OR "UserAgent" LIKE '%wget%' OR "UserAgent" LIKE '%python%' OR "UserAgent" LIKE '%go-http-client%' OR "UserAgent" LIKE '%httpclient%' OR "UserAgent" LIKE '%axios%' OR "UserAgent" LIKE '%requests%' OR "UserAgent" LIKE '%scanner%' OR "UserAgent" LIKE '%probe%')) AND (("Status" LIKE '%401%' OR "Status" LIKE '%403%' OR "Status" LIKE '%404%')) AND NOT (("UserAgent" LIKE '%Mozilla%' OR "UserAgent" LIKE '%Chrome%' OR "UserAgent" LIKE '%Firefox%' OR "UserAgent" LIKE '%Safari%' OR "UserAgent" LIKE '%Edge%') OR ("UriStem" LIKE '%/sso%' OR "UriStem" LIKE '%/oauth%' OR "UriStem" LIKE '%/openid%' OR "UriStem" LIKE '%/saml%' OR "UriStem" LIKE '%/idp%' OR "UriStem" LIKE '%/federation%') OR ("UserAgent" LIKE '%nessus%' OR "UserAgent" LIKE '%qualys%' OR "UserAgent" LIKE '%openvas%' OR "UserAgent" LIKE '%acunetix%' OR "UserAgent" LIKE '%nuclei%' OR "UserAgent" LIKE '%zabbix%' OR "UserAgent" LIKE '%prometheus%' OR "UserAgent" LIKE '%uptime%' OR "UserAgent" LIKE '%pingdom%' OR "UserAgent" LIKE '%datadog%' OR "UserAgent" LIKE '%newrelic%') OR ("UriStem" LIKE '%.css%' OR "UriStem" LIKE '%.js%' OR "UriStem" LIKE '%.png%' OR "UriStem" LIKE '%.jpg%' OR "UriStem" LIKE '%.svg%' OR "UriStem" LIKE '%.ico%' OR "UriStem" LIKE '%.woff%' OR "UriStem" LIKE '%.woff2%'))
