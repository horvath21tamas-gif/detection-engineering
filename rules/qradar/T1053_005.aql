SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\schtasks.exe' AND "Process CommandLine" ILIKE '%/create%' AND (("Process CommandLine" LIKE '%powershell%' OR "Process CommandLine" LIKE '%pwsh%')) AND (("Process CommandLine" LIKE '%-enc%' OR "Process CommandLine" LIKE '%-encodedcommand%' OR "Process CommandLine" LIKE '%-nop%' OR "Process CommandLine" LIKE '%-w hidden%' OR "Process CommandLine" LIKE '%-executionpolicy bypass%') OR ("Process CommandLine" LIKE '%\\Users\\%' OR "Process CommandLine" LIKE '%\\AppData\\%' OR "Process CommandLine" LIKE '%\\Temp\\%' OR "Process CommandLine" LIKE '%\\ProgramData\\%')) AND (("ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\powershell.exe%' OR "ParentImage" LIKE '%\\pwsh.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\mshta.exe%' OR "ParentImage" LIKE '%\\WINWORD.EXE%' OR "ParentImage" LIKE '%\\EXCEL.EXE%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\CCM\\%' OR "ParentImage" LIKE '%\\Microsoft Configuration Manager\\%' OR "ParentImage" LIKE '%\\SCCM\\%' OR "ParentImage" LIKE '%\\Tanium\\%' OR "ParentImage" LIKE '%\\PDQ\\%' OR "ParentImage" LIKE '%\\Ivanti\\%' OR "ParentImage" LIKE '%\\ManageEngine\\%' OR "ParentImage" LIKE '%\\Veeam\\%' OR "ParentImage" LIKE '%\\Acronis\\%' OR "ParentImage" LIKE '%\\Backup\\%'))
