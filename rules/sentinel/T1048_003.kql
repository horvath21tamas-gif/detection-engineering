DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("* -type=TXT*", "* -querytype=TXT*", "* -q=TXT*", "* -class=IN*")) or ProcessCommandLine match "(*i)nslookup.*[A-Za-z0-9+/=]{30,}\." or (ProcessCommandLine contains "ping " and ProcessCommandLine match ".* -l (1[0-9]{3}|[2-9][0-9]{3}).*")) and (((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\certutil.exe", "*\nslookup.exe"))) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\wscript.exe", "*\cscript.exe"))) and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*microsoft.com*", "*127.0.0.1*", "*localhost*")) or username =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))