(CommandLine IN ("*AADInternals*", "*MSAL.PS*", "*Okta.Auth*", "*Connect-AzureAD*", "*Connect-MgGraph*", "*AcquireToken*", "*DeviceCodeCredential*") CommandLine IN ("*Invoke-AADIntMFAFlood*", "*while($true)*", "*for($i=0*", "*Start-Sleep*", "*Send-PushNotification*", "*ApproveSignIn*", "*ShowPasswordPrompt*")) OR (CommandLine IN ("*puppeteer*", "*selenium-webdriver*", "*Playwright*", "*--headless*", "*--disable-gpu*", "*--remote-debugging-port*") CommandLine IN ("*-WindowStyle Hidden*", "*-ExecutionPolicy Bypass*", "*-NonInteractive*", "*-EncodedCommand*")) CommandLine IN ("*-WindowStyle Hidden*", "*-ExecutionPolicy Bypass*", "*-NonInteractive*", "*-EncodedCommand*") OR ParentImage IN ("*\\wsmprovhost.exe", "*\\psexesvc.exe", "*\\taskeng.exe", "*\\schtasks.exe") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe") OR Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*") NOT (Image IN ("*\\Microsoft Azure AD Connect\\*", "*\\Microsoft Azure AD Sync\\*", "*\\OneDrive\\*")) NOT (User IN ("NT AUTHORITY\\*", "NT SERVICE\\*")) NOT (ParentImage="*\\explorer.exe" CommandLine IN ("*Connect-MgGraph -Scopes*", "*Connect-AzureAD*"))
