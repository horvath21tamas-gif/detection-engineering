DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*BluetoothLEAdvertisement*", "*BluetoothLEManufacturerData*", "*ManufacturerId*", "*DataSection*", "*Publisher.Start()*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\python.exe", "*\csc.exe")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\explorer.exe"))) and (not ((FolderPath in ("*\Program Files\*", "*\System32\svchost.exe*")) or (ProcessCommandLine in ("*Microsoft.YourPhone*", "*NearbySharing*")) or User =~ "NT AUTHORITY\SYSTEM"))