SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%BEGIN RSA PRIVATE%','%BEGIN DSA PRIVATE%','%BEGIN EC PRIVATE%','%BEGIN OPENSSH PRIVATE%','%BEGIN PGP PRIVATE%','%BEGIN PRIVATE KEY%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%.ppk%','%.pem%','%.key%','%.pfx%','%.p12%','%id_rsa%','%id_dsa%','%id_ed25519%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\.ssh\%','%\AppData\Roaming\Microsoft\Crypto\%','%\ProgramData\Microsoft\Crypto\%','%\Users\%','%\inetpub\%','%\OpenSSL\%','%\CertEnroll\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%findstr%','%/s%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%dir%','%/s%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Get-ChildItem%','%-Recurse%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%where%','%/r%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%grep%','%-r%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%base64%','%certutil -encode%','%Export-PfxCertificate%','%Get-Content%','%gc %','% | clip%','% > %','%scp %','%curl %','%Invoke-WebRequest%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-EncodedCommand%','%IEX%','%Invoke-Expression%') OR (""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\psexesvc.exe','%\wmiprvse.exe','%\cmd.exe','%\powershell.exe','%\httpd.exe','%\php-cgi.exe')) AND (""Filename"" ILIKE ENUMERATION('%\findstr.exe','%\powershell.exe','%\cmd.exe','%\grep.exe'))) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\OpenSSH\ssh-agent.exe%','%\Git\usr\bin\ssh.exe%','%\Microsoft Visual Studio\%','%\Windows\System32\certutil.exe%')) AND ""Parent Filename"" ILIKE '%\explorer.exe' AND "username" ILIKE '%NT AUTHORITY%') AND NOT (""Filename"" ILIKE '%\mmc.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%certlm.msc%','%certmgr.msc%')))
