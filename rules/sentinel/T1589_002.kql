DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (SrcIp in ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*")) and (UriStem in ("*/api/users*", "*/api/employees*", "*/api/profiles*", "*/directory*", "*/people*", "*/staff*", "*/team*", "*/search/users*", "*/lookup*")) and (UriQuery in ("*email=*", "*user=*", "*username=*", "*name=*", "*employee*", "*account*")) and Method =~ "GET" and (UserAgent in ("*curl*", "*wget*", "*python*", "*requests*", "*go-http-client*", "*httpclient*", "*libwww*", "*axios*", "*scanner*", "*probe*")) and (Status in (200, 206)) and (not ((UserAgent in ("*Mozilla*", "*Chrome*", "*Firefox*", "*Safari*", "*Edge*", "*HeadlessChrome*")) or (UserAgent in ("*Googlebot*", "*Bingbot*", "*Slurp*", "*DuckDuckBot*", "*Yandex*", "*Baiduspider*", "*Ahrefs*", "*Semrush*", "*MJ12bot*")) or (UserAgent in ("*uptime*", "*pingdom*", "*datadog*", "*newrelic*", "*zabbix*", "*prometheus*"))))