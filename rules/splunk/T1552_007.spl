CommandLine IN ("*/var/run/secrets/kubernetes.io/serviceaccount*", "*/run/secrets/*", "*.docker/config.json*", "*/etc/kubernetes/admin.conf*", "*secret.yml*") OR (CommandLine="*env*" CommandLine="*grep*") OR (CommandLine="*printenv*" CommandLine="*token*") OR (CommandLine="*cat*" CommandLine="*base64*") OR CommandLine="*export*" ParentImage IN ("*/sh", "*/bash", "*/zsh", "*/dash", "*/kubectl") ParentImage IN ("*/nginx*", "*/httpd*", "*/php*") NOT (CommandLine IN ("*/usr/local/bin/docker-entrypoint.sh*", "*/init.sh*") username="fluentd" Image="*/usr/bin/promtail*")
