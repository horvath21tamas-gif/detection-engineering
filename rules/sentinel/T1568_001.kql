DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*ipconfig /flushdns*", "*Clear-DnsClientCache*", "*Remove-DnsClientCache*", "*Flush-DnsClientCache*")) and (ProcessCommandLine in ("*Resolve-DnsName*", "*[System.Net.Dns]::*", "*while(*", "*for(*", "*Start-Sleep*", "*-RetryCount*", "*-Timeout*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\regsvr32.exe", "*\mshta.exe")) and (not ((ProcessCommandLine in ("*\Program Files\*", "*Microsoft\Azure*", "*HealthCheck*", "*Chocolatey*", "*_vlmcs._tcp*")) or username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\services.exe", "*\explorer.exe"))))