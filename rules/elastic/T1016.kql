((process.executable:(*\\ipconfig.exe OR *\\route.exe OR *\\nbtstat.exe OR *\\arp.exe OR *\\netsh.exe)) OR (process.command_line:(*Get\-NetIPAddress* OR *Get\-NetRoute* OR *Get\-NetNeighbor* OR *interface\ show*))) AND ((process.command_line:(*\ \/all* OR *\ print* OR *\ \-a* OR *\ \/displaydns*)) OR ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\httpd.exe OR *\\wsmprovhost.exe)) AND winlog.event_data.IntegrityLevel:Medium) OR (process.command_line:(*\ \>\ * OR *ConvertTo\-Json* OR *Export\-Csv*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\svchost.exe OR *\\CcmExec.exe OR *\\msiexec.exe)) OR process.command_line:*Program\ Files*))
