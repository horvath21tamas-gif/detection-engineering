SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\openssl.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% s_client%','% x509%','% -text%')) OR ""Filename"" ILIKE '%\certutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -dump%','% -viewstore%','% -user%')) OR ""Filename"" ILIKE '%\powershell.exe' AND "Process "Process CommandLine"" ILIKE '%Get-ChildItem -Path Cert:%' OR "Process "Process CommandLine"" ILIKE ENUMERATION('%.pfx%','%.p12%','%.pem%','%exportable%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('% -verify%','% -v %','% -silent%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe','%\CcmExec.exe','%\TrustedInstaller.exe')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%localhost%','%dev.local%'))
