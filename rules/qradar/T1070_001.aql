SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\wevtutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%cl Security%','%cl "Security"%','%clear-log Security%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\SCCM\%','%\Tanium\%','%\Splunk\%','%\Elastic\%','%\NXLog\%','%\OSSEC\%','%\QRadar\%','%\LogRhythm\%'))
