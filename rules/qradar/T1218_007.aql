SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\msiexec.exe' AND (("Process CommandLine" LIKE '%http://%' OR "Process CommandLine" LIKE '%https://%' OR "Process CommandLine" LIKE '%/i%')) AND (("Process CommandLine" LIKE '%/quiet%' OR "Process CommandLine" LIKE '%/qn%' OR "Process CommandLine" LIKE '%/norestart%')) AND (("ParentImage" LIKE '%\\powershell.exe%' OR "ParentImage" LIKE '%\\pwsh.exe%' OR "ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\mshta.exe%' OR "ParentImage" LIKE '%\\rundll32.exe%')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\CCM\\%' OR "ParentImage" LIKE '%\\Microsoft Configuration Manager\\%' OR "ParentImage" LIKE '%\\PDQ\\%' OR "ParentImage" LIKE '%\\Ivanti\\%' OR "ParentImage" LIKE '%\\ManageEngine\\%' OR "ParentImage" LIKE '%\\Tanium\\%' OR "ParentImage" LIKE '%\\Intune\\%') OR ("ParentImage" LIKE '%\\Google\\Update\\%' OR "ParentImage" LIKE '%\\Microsoft\\EdgeUpdate\\%' OR "ParentImage" LIKE '%\\Adobe\\%' OR "ParentImage" LIKE '%\\Mozilla\\%' OR "ParentImage" LIKE '%\\Zoom\\%' OR "ParentImage" LIKE '%\\Slack\\%' OR "ParentImage" LIKE '%\\Cisco\\%'))
