
| rex field=Details "(?<DetailsMatch>DWORD \\(0x0000000[01]\\))"
| eval DetailsCondition=if(isnotnull(DetailsMatch), "true", "false")
| rex field=Image "(?<ImageMatch>(winword\\.exe|excel\\.exe|outlook\\.exe|svchost\\.exe|msiexec\\.exe|powershell\\.exe|cmd\\.exe|reg\\.exe|wscript\\.exe|cscript\\.exe)$)"
| eval ImageCondition=if(isnotnull(ImageMatch), "true", "false")
| search DetailsCondition="true" OR ImageCondition="true"
| regex TargetObject="\\\\Software\\\\Microsoft\\\\Office\\\\.*\\\\Security\\\\(VBAWarnings|Trusted Locations\\\\|Trusted Documents\\\\DisableTrustedDocuments|BlockContentExecutionFromInternet)$"
| regex Details!="(\\\\\\\\InternalStorage\\\\Templates|C:\\\\Program Files\\\\)"
