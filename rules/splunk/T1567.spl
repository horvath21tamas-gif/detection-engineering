Image IN ("*\\rclone.exe", "*\\megatools.exe", "*\\mega-put.exe", "*\\rcloud.exe") OR CommandLine IN ("*discordapp.com/api/webhooks*", "*api.telegram.org/bot*") CommandLine IN ("* --config *", "* --no-check-certificate*", "* --bwlimit *", "* sync *", "* copy --ignore-existing*") OR CommandLine IN ("*mega.nz*", "*transfer.sh*", "*webhook.site*", "*pastebin.com*", "*file.io*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\rundll32.exe") NOT (Image="*\\Program Files\\*" OR CommandLine IN ("*127.0.0.1*", "*localhost*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
