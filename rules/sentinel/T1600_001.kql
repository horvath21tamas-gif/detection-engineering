DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\bcdedit.exe" and (ProcessCommandLine in ("*nointegritychecks*", "*testsigning*", "*disable-elam-drivers*", "*nx AlwaysOff*", "*bootstatuspolicy ignoreallfailures*"))) or ((ProcessCommandLine in ("*ci.dll*", "*ntoskrnl.exe*", "*lsasrv.dll*", "*winload.efi*", "*winresume.efi*")) and (FolderPath in ("*\Users\*", "*\AppData\Local\Temp\*", "*\Downloads\*", "*\Desktop\*"))) or (ProcessCommandLine in ("*KDU.exe*", "*EfiGuard*", "*TDL.exe*", "*DSEFix*", "*BcdPatcher*"))) and (not (((ParentProcessName in ("*\msiexec.exe", "*\TrustedInstaller.exe", "*\TiWorker.exe", "*\explorer.exe")) and username =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\Program Files\Dell\*", "*\Program Files\HP\*", "*\Program Files\Lenovo\*", "*\Program Files (x86)\Lenovo\*"))))