((process.executable:(*\\diskpart.exe OR *\\powershell.exe OR *\\pwsh.exe)) OR (process.command_line:(*Mount\-VHD* OR *Mount\-DiskImage* OR *attach\ vdisk* OR *create\ vdisk*))) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\chrome.exe OR *\\msedge.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\mshta.exe)) OR ((process.command_line:(*\\Users\\* OR *\\Downloads\\* OR *\\Temp\\* OR *\\AppData\\* OR *.iso* OR *.vhd* OR *.vhdx*)) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\Windows\\System32\\svchost.exe* OR *\\Program\ Files\\Hyper\-V\\* OR *\\Program\ Files\\Microsoft\ Visual\ Studio\\* OR *\\CcmExec.exe*)) OR (process.command_line:(*Program\ Files* OR *WindowsImageBackup*))))))
