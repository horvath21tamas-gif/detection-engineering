(Message:(*import\-target* OR *export\-target* OR *ip\ route\ vrf* OR *switchport\ mode\ trunk* OR *vlan\-stacking* OR *brctl\ addif* OR *set\ protocols\ evpn*)) AND ((Message:(*native\ vlan* OR *permit\ any* OR *allow\-all* OR *no\ shutdown*)) OR (Message:(*line\ vty* OR *console* OR *ssh\-session*))) AND (NOT ((SourceIP:(10.50.0.10 OR 10.50.0.11)) OR (Message:(*switchport\ mode\ access* OR *description\ *))))
