TargetImage IN ("*\\explorer.exe", "*\\dwm.exe", "*\\taskhostw.exe", "*\\csrss.exe") GrantedAccess IN ("*0x1fffff*", "*0x28*", "*0x20*") NOT ((SourceImage IN ("*\\Visual Studio\\*", "*\\WinDbg\\*", "*\\Windows Defender\\*", "*\\CrowdStrike\\*", "*\\SentinelOne\\*", "*\\CarbonBlack\\*", "*\\Tanium\\*") SourceImage IN ("*\\procmon.exe", "*\\procexp.exe", "*\\taskmgr.exe")) OR SourceUsername="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\explorer.exe", "*\\services.exe")) | table Time,SourceImage,SourceUsername,ParentImage,TargetImage,GrantedAccess,ProcessId,ThreadId
