SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\outlook.exe','%\thunderbird.exe','%\msedge.exe','%\chrome.exe','%\firefox.exe','%\teams.exe','%\slack.exe','%\whatsapp.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\scrcons.exe','%\certutil.exe','%\regsvr32.exe','%\rundll32.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\AppData\Local\Microsoft\Windows\INetCache\%','%\Downloads\%','%\Users\Public\%','%C:\Windows\Temp\%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%--type=%','%gpu-process%','%utility%','%crashpad-handler%') OR ""Filename"" ILIKE '%\Common Files\Microsoft Shared\ClickToRun\%' OR "Process "Process CommandLine"" ILIKE ENUMERATION('%--update%','%--checkInstall%'))
