SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('%NOPASSWD:%','%ALL=(ALL)%','%timestamp_timeout%') OR ""Process CommandLine"" ILIKE '%sudo %' OR ""Process CommandLine"" ILIKE ENUMERATION('%sudo -l%','%sudo -n -l%')) AND (""Parent Filename"" ILIKE ENUMERATION('%/apache2','%/nginx','%/php-fpm','%/node') OR NOT ((""Parent Filename"" ILIKE ENUMERATION('%/ansible-playbook','%/puppet','%/salt-minion','%/chef-client')) AND "username"='root'))
