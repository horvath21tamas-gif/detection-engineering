(Image IN ("*\\net.exe", "*\\net1.exe") CommandLine="*use*" CommandLine="*/delete*" CommandLine IN ("*", "* /y*", "* /yes*")) OR (Image="*\\cmdkey.exe" CommandLine="* /delete*") OR (Image="*\\vaultcmd.exe" CommandLine="* /delete*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\w3wp.exe", "*\\powershell.exe") OR NOT ((username="NT AUTHORITY\\SYSTEM" ParentImage="*\\services.exe") OR CommandLine IN ("*logon.bat*", "*netlogon*", "*policy*") OR ParentImage="*\\explorer.exe")
