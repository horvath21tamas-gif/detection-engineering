
| rex field=CommandLine "(?<CommandLineMatch>\\\\\\\\[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\\\.*\\$)"
| eval CommandLineCondition=if(isnotnull(CommandLineMatch), "true", "false")
| search CommandLine IN ("*@80\\*", "*@SSL\\*", "*davwwwroot*", "*\\*\\IPC$*") OR CommandLine IN ("*EfsRpcOpenFileRaw*", "*RpcRemoteFindFirstPrinterChangeNotification*", "*lsarpc*", "*efsrpc*") OR CommandLineCondition="true" Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Downloads\\*") Image IN ("*\\powershell.exe", "*\\cmd.exe", "*\\python.exe", "*\\rundll32.exe") NOT (CommandLine IN ("*\\SYSVOL\\*", "*\\NETLOGON\\*") ParentImage IN ("*\\services.exe", "*\\svchost.exe") username="NT AUTHORITY\\SYSTEM")
