SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\aws.exe','%\az.cmd','%\gcloud.cmd','%\gsutil.py','%\rclone.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%s3 ls%','%s3api list-objects%','%s3api list-object-versions%','%storage blob list%','%storage container list%','%storage ls%','%storage objects list%','%ls -R%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%--recursive%','%--query%','%--output json%','% | jq%','% > %','%| Out-File%','%base64%') OR ""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wsmprovhost.exe','%\httpd.exe','%\taskeng.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Temp\%','%\ProgramData\%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\Veeam\%','%\Commvault\%','%\terraform.exe%','%\azcopy.exe%','%\rclone.exe%')) AND (("UserName" LIKE '%NT AUTHORITY\\%' OR "UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%svc-backup%' OR "UserName" LIKE '%svc-automation%'))) AND NOT (("UserName" LIKE '%cloudadmin%' OR "UserName" LIKE '%svc-cloudops%' OR "UserName" LIKE '%svc-storage%'))
