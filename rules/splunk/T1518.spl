Image IN ("*\\wmic.exe", "*\\reg.exe") OR CommandLine IN ("*Get-Package*", "*Get-ItemProperty*", "*product get name*", "*software list*") CommandLine IN ("*defender*", "*sentinel*", "*crowdstrike*", "*falcon*", "*carbonblack*", "*fireeye*", "*tanium*", "*sophos*", "*symantec*", "*kaspersky*", "*mcafee*") OR CommandLine IN ("* > *", "*ConvertTo-Json*", "*Export-Csv*", "*findstr*") OR (ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe", "*\\excel.exe") IntegrityLevel="Medium") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\CcmExec.exe", "*\\svchost.exe", "*\\msiexec.exe") OR CommandLine IN ("*Program Files*", "*Google\\Update*"))
