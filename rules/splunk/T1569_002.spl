Image="*\\sc.exe" OR OriginalFileName="sc.exe" OR Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("* create *", "* config *", "* binPath*", "*New-Service*", "*Set-Service*") CommandLine IN ("*:\\Windows\\Temp\\*", "*:\\Users\\Public\\*", "*:\\ProgramData\\*", "*\\AppData\\Local\\Temp\\*", "*admin$*", "*c$*") OR CommandLine IN ("*cmd.exe /c*", "*powershell.exe -enc*", "* -ExecutionPolicy Bypass *") OR ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\psexesvc.exe", "*\\httpd.exe", "*\\nginx.exe", "*\\php-cgi.exe") NOT (ParentImage IN ("*\\msiexec.exe", "*\\TrustedInstaller.exe", "*\\CcmExec.exe", "*\\GMSCAgent.exe") OR (username="NT AUTHORITY\\SYSTEM" CommandLine="*C:\\Windows\\System32\\*"))
