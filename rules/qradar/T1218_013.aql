SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\rundll32.exe' AND "ImageName"='RUNDLL32.EXE' AND (("Integrity Level" LIKE '%Low%' OR "Integrity Level" LIKE '%Medium%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%javascript:%','%vbscript:%','%mshtml,RunHTMLApplication%','%url.dll,OpenURL%','%url.dll,FileProtocolHandler%','%shell32.dll,ShellExec_RunDLL%','%pcwutl.dll,LaunchApplication%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%http://%','%https://%','%\\%') OR ""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\ProgramData\%') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%.txt%','%.png%','%.jpg%','%.dat%','%.inf%','%.tmp%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Downloads\%','%\Public\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\chrome.exe','%\msedge.exe'))) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\System32\%','C:\Windows\SysWOW64\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\explorer.exe','%\svchost.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.cpl%','%shell32.dll,Control_RunDLL%')))
