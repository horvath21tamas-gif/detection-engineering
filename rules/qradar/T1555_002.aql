SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('%securityd%','%keychain.db%')) AND (""Filename"" ILIKE ENUMERATION('%/lldb','%/gcore','%/vmmap','%/heap','%/frida-server') OR ""Process CommandLine"" ILIKE ENUMERATION('%attach%','%memory read%','%dump%','%save%','%--pid%','%-p%') OR (""Filename"" ILIKE ENUMERATION('%/Users/%','%/tmp/%','%/var/tmp/%','%/Library/Caches/%')) AND (""Filename"" ILIKE ENUMERATION('%/python3','%/python','%/ruby','%/node'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/usr/bin/sysdiagnose','%/usr/libexec/periodic-wrapper','%/System/Library/CoreServices/ReportCrash','%/usr/bin/spindump') OR ""Parent Filename"" ILIKE '%/Applications/Xcode.app/%')
