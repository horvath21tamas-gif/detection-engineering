CommandLine IN ("*listenport=*", "*connectaddress=*") OR CommandLine IN ("* -socks5 *", "* -reverse *", "* -L:*", "* -R:*", "* --proxy-server=*") Image IN ("*\\netsh.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\regsvr32.exe") NOT (CommandLine IN ("*C:\\Program Files\\Docker*", "*C:\\Program Files\\WSL*", "*127.0.0.1*", "*::1*") username="NT AUTHORITY\\SYSTEM" ParentImage="*\\services.exe")
