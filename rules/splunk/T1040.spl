(Image="*\\netsh.exe" CommandLine IN ("*trace start*", "*capture=yes*", "*report=yes*")) OR (Image="*\\pktmon.exe" CommandLine IN ("*start*", "*capture*", "*--etw*")) OR CommandLine IN ("*npcap*", "*winpcap*", "*packet.dll*", "*wpcap.dll*", "*ndiscap.sys*") OR Image IN ("*\\tshark.exe", "*\\windump.exe", "*\\ettercap.exe", "*\\bettercap.exe", "*\\dsniff.exe") OR CommandLine IN ("*responder*", "*scapy*", "*-i eth0*") Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*") NOT (Image IN ("*\\Program Files\\Wireshark\\*", "*\\Program Files\\Microsoft Message Analyzer\\*", "*\\Windows\\System32\\wbem\\wmiprvse.exe*") username="NT AUTHORITY\\SYSTEM")
