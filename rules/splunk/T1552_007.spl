CommandLine IN ("*/var/run/secrets/kubernetes.io/serviceaccount*", "*/run/secrets/*", "*/etc/kubernetes/admin.conf*", "*/root/.kube/config*", "*.docker/config.json*", "*/.aws/credentials*", "*/.azure/*", "*/.config/gcloud/*") OR CommandLine IN ("*token*", "*authorization*", "*kubeconfig*", "*client-secret*", "*access_key*", "*secret_key*") OR CommandLine IN ("*env*", "*|*") OR CommandLine IN ("*printenv*", "*|*") OR CommandLine IN ("*set*", "*|*") OR CommandLine IN ("*export*", "*|*") OR CommandLine IN ("*cat*", "*base64*") OR CommandLine IN ("*cat*", "*grep*") OR CommandLine IN ("*xxd*", "*hexdump*") (Image IN ("*/sh", "*/bash", "*/dash", "*/zsh") CommandLine IN ("*-i*", "*-c*")) OR ParentImage IN ("*/nginx", "*/httpd", "*/apache2", "*/php-fpm", "*/node", "*/gunicorn", "*/uwsgi") OR ParentImage IN ("*kubectl*", "*containerd*", "*docker*", "*cri-o*") NOT (CommandLine IN ("*docker-entrypoint.sh*", "*/init.sh*", "*/usr/local/bin/start.sh*") Image IN ("*/usr/bin/promtail*", "*/usr/bin/fluentd*", "*/usr/bin/telegraf*", "*/pause*") username IN ("fluentd", "root"))
