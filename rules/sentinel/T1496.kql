DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*stratum+tcp://*", "*stratum+ssl://*", "*--url=*", "*--user=*", "*--pass=*", "*--algo=*", "*--donate-level=*", "*cryptonight*", "*nicehash*")) and ((ProcessCommandLine in ("*--cpu-max-threads-hint*", "*--cpu-no-yield*", "*--randomx-1gb-pages*", "*--cuda-devices*", "*--opencl-platform*")) or ((FolderPath in ("*\AppData\Local\Temp\*", "*\AppData\Roaming\*", "*\Users\Public\*", "*\ProgramData\*", "*\Windows\Temp\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\powershell.exe", "*\cmd.exe"))))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*Azure*", "*Telemetry*", "*Diagnostic*"))))