SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\aws.exe','%\az.exe','%\gcloud.exe','%\gsutil.exe','%\snowball.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% s3 sync %','% storage copy %','% cp %','% --access-key %','% --secret-key %','% --profile %','% --request-payer %','% --no-sign-request %','% make-public %','% bucket-to-bucket%','% gs://%') OR (""Filename"" ILIKE ENUMERATION('%\Users\%','%\Temp\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpoint.exe','%\httpd.exe','%\php-cgi.exe','%\rundll32.exe','%\taskhostw.exe')) AND (("Parent Process CommandLine" LIKE '%-EncodedCommand%' OR "Parent Process CommandLine" LIKE '%-NonInteractive%'))) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\services.exe','%\explorer.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% terraform %','% ansible %','% Jenkins %','% CI/CD %')) AND "username" ILIKE 'NT AUTHORITY\%')
