source="WinEventLog:System" eventName IN ("AuthorizeSecurityGroupIngress", "CreateSecurityGroup", "DeleteSecurityGroup", "PutManagedRuleSet", "UpdateFirewall") requestParameters.ipPermissions.items.ipRanges.items.cidrIp IN ("0.0.0.0/0", "::/0") requestParameters.ipPermissions.items.ipProtocol="-1" userIdentity.type="Root" OR userAgent IN ("*kali*", "*python-requests*", "*curl*", "*postman*") NOT (userIdentity.arn IN ("*role/Terraform-Execution-Role*", "*role/AWS-CloudFormation-Stack*", "*role/Azure-DevOps-Service-Principal*") sourceIPAddress="10.0.0.0/8")
