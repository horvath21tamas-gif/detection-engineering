Image IN ("*\\notepad.exe", "*\\calc.exe", "*\\mspaint.exe", "*\\colorcpl.exe", "*\\spoolsv.exe", "*\\winver.exe", "*\\scrcons.exe") OR (Image IN ("*\\rundll32.exe", "*\\regsvr32.exe", "*\\mshta.exe", "*\\certutil.exe") CommandLine IN ("*http*", "*ftp*")) OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powershell.exe", "*\\cmd.exe") NOT (Image IN ("*\\chrome.exe*", "*\\msedge.exe*", "*\\firefox.exe*", "*\\brave.exe*") OR (DestinationHostname IN ("*.microsoft.com", "*.windowsupdate.com", "*.digicert.com", "*.amazontrust.com") DestinationPort IN (135, 139, 445)))
