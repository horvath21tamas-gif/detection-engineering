Image IN ("*\\aws.exe", "*\\az.cmd", "*\\gcloud.cmd") CommandLine IN ("*iam list-users*", "*iam list-roles*", "*ad user list*", "*ad group list*", "*projects get-iam-policy*") CommandLine IN ("*--query*", "*--output json*", "* | jq*", "* | grep*", "* > *") OR ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wsmprovhost.exe") NOT (ParentImage IN ("*\\Jenkins\\*", "*\\GitLab-Runner\\*", "*\\Terraform\\*") username="NT AUTHORITY\\SYSTEM")
