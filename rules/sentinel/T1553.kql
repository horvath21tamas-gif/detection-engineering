DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((((FolderPath in ("*\certutil.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("* -addstore *", "* -importcert *", "* -installcert *", "* Import-Certificate *"))) and (ProcessCommandLine in ("* Root*", "* AuthRoot*", "* TrustedPublisher*")) and (ProcessCommandLine in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Downloads\*", "*\Desktop\*"))) or ((ProcessCommandLine in ("*SaveZoneInformation*", "*LowRiskFileTypes*", "*Zone.Identifier*")) and (ProcessCommandLine in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Downloads\*", "*\Desktop\*")))) and (not ((ParentProcessName in ("C:\Windows\System32\msiexec.exe*", "C:\Program Files\Microsoft Endpoint Manager\*")) and User =~ "NT AUTHORITY\SYSTEM"))