SELECT UTF8(payload) as search_payload from events where (("Message" LIKE '%import-target%' OR "Message" LIKE '%export-target%' OR "Message" LIKE '%ip route vrf%' OR "Message" LIKE '%switchport mode trunk%' OR "Message" LIKE '%vlan-stacking%' OR "Message" LIKE '%brctl addif%' OR "Message" LIKE '%set protocols evpn%')) AND (("Message" LIKE '%native vlan%' OR "Message" LIKE '%permit any%' OR "Message" LIKE '%allow-all%' OR "Message" LIKE '%no shutdown%') OR ("Message" LIKE '%line vty%' OR "Message" LIKE '%console%' OR "Message" LIKE '%ssh-session%')) AND NOT (("SourceIP" LIKE '%10.50.0.10%' OR "SourceIP" LIKE '%10.50.0.11%') OR ("Message" LIKE '%switchport mode access%' OR "Message" LIKE '%description %'))
