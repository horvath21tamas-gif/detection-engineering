DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ParentProcessName in ("*\explorer.exe", "*\chrome.exe", "*\msedge.exe", "*\brave.exe", "*\firefox.exe", "*\WINWORD.EXE", "*\EXCEL.EXE", "*\POWERPNT.EXE")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\rundll32.exe", "*\mshta.exe", "*\regsvr32.exe", "*\schtasks.exe", "*\sc.exe")) and User =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*")) and (not ((ParentProcessName in ("*\Windows\Installer\*", "*\Microsoft Configuration Manager\*", "*\Windows\CCM\*", "*\PDQ\*", "*\Ivanti\*", "*\ManageEngine\*", "*\Tanium\*", "*\Dell\*", "*\HP\*", "*\Lenovo\*")) or (ParentProcessName in ("*\consent.exe", "*\services.exe", "*\svchost.exe"))))