DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*runas /token*", "*make_token*", "*steal_token*", "*Invoke-TokenManipulation*", "*CPAU.exe*", "*load_privilege*")) or ((ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\cscript.exe", "*\wscript.exe")) and User contains "SYSTEM" and LogonId =~ "0x3e7")) and (not (((ParentProcessName in ("*\services.exe", "*\wininit.exe", "*\lsass.exe", "*\winlogon.exe")) or (FolderPath in ("*\conhost.exe", "*\WerFault.exe", "*\WmiPrvSE.exe")) or ParentProcessCommandLine contains "svchost.exe -k") or (FolderPath in ("*\Program Files\Windows Defender\*", "*\Program Files\CrowdStrike\*", "*\SentinelOne\*"))))