SELECT UTF8(payload) as search_payload from events where "Target Object"='HKLM\SYSTEM\CurrentControlSet\Control\Lsa\Notification Packages' AND "Target Details" ILIKE '%.dll%' AND (("Target Details" LIKE '%\\Users\\%' OR "Target Details" LIKE '%\\Users\\Public\\%' OR "Target Details" LIKE '%\\ProgramData\\%' OR "Target Details" LIKE '%\\AppData\\%' OR "Target Details" LIKE '%\\Temp\\%')) AND NOT (("Target Details" LIKE '%\\Windows\\System32\\%' OR "Target Details" LIKE '%\\Windows\\SysWOW64\\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\Windows\System32\lsass.exe%','%\Windows\System32\services.exe%','%\Windows\System32\msiexec.exe%','%\Windows\servicing\%','%\Windows\System32\dism.exe%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT SERVICE\\TrustedInstaller%'))
