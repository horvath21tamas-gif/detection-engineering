SELECT Time, user_name, operation_name, request_parameters, user_agent, mfa_authenticated, resource_id, subscription_id, tenant_id, source_ip from events where (("operation_name" LIKE '%ModifySnapshotAttribute%' OR "operation_name" LIKE '%SharedSnapshot%' OR "operation_name" LIKE '%SetSnapshotPermissions%' OR "operation_name" LIKE '%CopySnapshot%' OR "operation_name" LIKE '%ShareSnapshot%' OR "operation_name" LIKE '%UpdateSnapshotAccess%')) AND (("request_parameters" LIKE '%all%' OR "request_parameters" LIKE '%Add.UserId%' OR "request_parameters" LIKE '%grantee%' OR "request_parameters" LIKE '%public%' OR "request_parameters" LIKE '%external-account%' OR "request_parameters" LIKE '%everyone%') OR "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%boto3%' OR "user_agent" LIKE '%curl%' OR "user_agent" LIKE '%postman%' OR "user_agent" LIKE '%Terraform%' OR "user_agent" LIKE '%Pulumi%'))) AND NOT ((("user_name" LIKE '%svc-veeam%' OR "user_name" LIKE '%svc-commvault%' OR "user_name" LIKE '%backup-agent%' OR "user_name" LIKE '%svc-packer%' OR "user_name" LIKE '%svc-azure-backup%')) AND "source_ip"='10.0.0.0/8')
