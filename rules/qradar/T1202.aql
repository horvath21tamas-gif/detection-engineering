SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\pcalua.exe' AND "Process "Process CommandLine"" ILIKE '% -a %' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.exe%','%.ps1%','%.bat%','%.vbs%','%.dll%')) OR ""Filename"" ILIKE '%\forfiles.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%cmd%','%powershell%','%pwsh%','%regsvr32%','%mshta%','%bitsadmin%','%wscript%','%cscript%')) OR ""Filename"" ILIKE '%\conhost.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -- %','% -e %'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\powerpnt.exe','%\chrome.exe','%\msedge.exe','%\w3wp.exe','%\sqlservr.exe','%\php-cgi.exe')) AND NOT ("username" ILIKE 'NT AUTHORITY\%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\msiexec.exe','%\TiWorker.exe','%\explorer.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Windows\SoftwareDistribution\%','%Program Files%')) AND ""Filename"" ILIKE '%\Windows\System32\%')
