SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\control.exe' AND "ImageName"='control.exe' AND (("Integrity Level" LIKE '%Low%' OR "Integrity Level" LIKE '%Medium%')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\ProgramData\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe','%\chrome.exe','%\msedge.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%http://%','%https://%','%\\%') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Public\%','%\Downloads\%','%\PerfLogs\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.dll%','%.tmp%','%.dat%','%.png%','%.jpg%','%.txt%'))) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\System32\%','C:\Windows\SysWOW64\%')) AND ""Parent Filename"" ILIKE '%\explorer.exe' AND "Integrity Level"='High' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.cpl%','%C:\Windows\System32\%'))) AND NOT "username" ILIKE 'NT AUTHORITY\%'
