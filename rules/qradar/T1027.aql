SELECT UTF8(payload) as search_payload from events where (processname LIKE ('%\powershell.exe','%\pwsh.exe')) AND (processcommandline LIKE ('%-enc%','%-encodedcommand%')) AND (processcommandline LIKE ('%Invoke-WebRequest%','%iwr%','%wget%','%curl%','%DownloadString%','%DownloadFile%','%Net.WebClient%')) 