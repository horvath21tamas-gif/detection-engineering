SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\powercfg.exe' OR "ImageName"='PowerCfg.exe') AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -hibernate off%','% -x %','% -setacvalueindex %','% -requestsoverride %','% SCHEME_MIN %') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% 0%','% 000%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\psexec.exe')) AND NOT (""Parent Filename"" ILIKE '%C:\Windows\System32\SystemSettingsAdminFlows.exe%' OR "Process "Process CommandLine"" ILIKE '%monitor-timeout-ac%')
