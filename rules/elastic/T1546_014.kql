winlog.channel:Microsoft\-Windows\-Sysmon\/Operational AND (((winlog.event_data.Operation:Created AND (winlog.event_data.ConsumerType:(CommandLineEventConsumer OR ActiveScriptEventConsumer))) AND ((process.executable:(*powershell* OR *cmd.exe* OR *mshta* OR *regsvr32* OR *scrcons.exe* OR *C\:\\Users\\* OR *C\:\\Windows\\Temp\\*)) OR (winlog.event_data.Query:(*SELECT\ *\ FROM\ __InstanceModificationEvent\ WITHIN* OR *SELECT\ *\ FROM\ Win32_LocalTime*)))) AND (NOT (((process.executable:(*\\CcmExec.exe OR *\\TaniumClient.exe OR *\\MonitoringHost.exe OR *\\ltsvc.exe)) AND winlog.event_data.username:NT\ AUTHORITY\\SYSTEM) OR (winlog.event_data.Name:(SCM\ Event\ Log\ Consumer OR BVTConsumer)))))
