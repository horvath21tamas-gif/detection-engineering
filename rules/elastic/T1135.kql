((process.executable:(*\\Snaffler.exe OR *\\SharpShares.exe OR *\\PowerView.ps1 OR *\\net.exe OR *\\net1.exe)) OR (process.command_line:(*view* OR *Invoke\-ShareFinder* OR *Get\-NetShare* OR *Find\-DomainShare*))) AND ((process.command_line:(*\ \/domain* OR *\ \/all* OR *\ \-ComputerName* OR *foreach* OR *\\\\*)) OR (process.command_line:(*password* OR *confidential* OR *backup* OR *config* OR *credentials* OR *key*)) OR ((process.parent.executable:(*\\cmd.exe OR *\\powershell.exe OR *\\wsmprovhost.exe OR *\\httpd.exe OR *\\winword.exe)) AND winlog.event_data.IntegrityLevel:Medium)) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.executable:(*\\Program\ Files\\Tanium\\* OR *\\Program\ Files\\Splunk\\* OR *\\Windows\\System32\\CcmExec.exe*)) OR process.command_line:*net\ share*))
