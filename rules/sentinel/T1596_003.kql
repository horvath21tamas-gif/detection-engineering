DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\amass.exe", "*\subfinder.exe", "*\findomain.exe", "*\assetfinder.exe", "*\massdns.exe")) or (ProcessCommandLine in ("* -d *", "* -passive*", "* -config*"))) or ((FolderPath in ("*\curl.exe", "*\wget.exe", "*\python.exe", "*\powershell.exe", "*\pwsh.exe")) or (ProcessCommandLine in ("*api.securitytrails.com*", "*api.passivetotal.org*", "*api.riskiq.net*", "*api.binaryedge.io*", "*otx.alienvault.com/api*", "*pdns*", "*history*")))) and (not ((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe")) or ParentProcessName endswith "\explorer.exe")) and (not ((ProcessCommandLine in ("nslookup ", "ping ", "tracert ")) or (FolderPath in ("*\Cisco\AnyConnect\*", "*\GlobalProtect\*", "*\Fortinet\*")))) and (not ((User in ("*svc_soc*", "*adm_net*")) and FolderPath contains "\Nmap\"))