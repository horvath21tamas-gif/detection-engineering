DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("*Get-ADUser -Filter *", "*Get-ADUser -Filter \"Enabled -eq*", "*Get-ADGroupMember -Identity \"Domain Admins\"*", "*dsquery user -limit 0*")) or (ProcessCommandLine in ("*net user /domain*", "*net group /domain*"))) or (ProcessCommandLine in ("*(&(objectCategory=person)(objectClass=user))*", "*distinguishedName*", "*userPrincipalName*", "*samaccountname*"))) and (not ((FolderPath in ("*\Lansweeper\*", "*\Tanium\*", "*\SCCM\*")) or (ParentProcessName in ("*\miiserver.exe", "*\Microsoft.IdentityManagement.Service.exe")))) and (not ((ParentProcessName in ("*\mmc.exe", "*\ServerManager.exe")) or username =~ "NT AUTHORITY\SYSTEM"))