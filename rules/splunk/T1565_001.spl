Image IN ("*\\sed.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\sqlite3.exe", "*\\wevtutil.exe", "*\\attrib.exe") CommandLine IN ("* -replace *", "* s/*", "* UPDATE *", "* DELETE FROM *", "* clear-log *", "* cl *", "*Set-Content*", "*Out-File*") CommandLine IN ("*.config*", "*.db*", "*\\System32\\config\\*", "*\\System32\\winevt\\*", "*hosts*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\explorer.exe") NOT (ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe") OR CommandLine="*Program Files*" OR username="NT AUTHORITY\\SYSTEM") | table Time,SourceImage,ParentImage,CommandLine,SourceUsername
