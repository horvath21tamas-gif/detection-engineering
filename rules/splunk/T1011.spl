Image IN ("*\\fsquirt.exe", "*\\bttransfer.exe", "*\\BTTray.exe") OR CommandLine IN ("*Bluetooth.Radio*", "*System.Net.Sockets.AddressFamily::BlueTooth*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powershell.exe", "*\\wscript.exe", "*\\cmd.exe", "*\\schtasks.exe") OR CommandLine IN ("*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*", "* -send*", "* /send*") NOT (ParentImage="*\\explorer.exe" OR Image="*\\Program Files\\*" OR username="NT AUTHORITY\\SYSTEM")
