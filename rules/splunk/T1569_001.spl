CommandLine IN ("*/Library/LaunchDaemons/*", "*/Library/LaunchAgents/*") ParentImage IN ("*/bash", "*/sh", "*/zsh", "*/python", "*/curl", "*/wget", "*/nc") OR CommandLine IN ("*curl *", "*wget *", "*base64*", "*bash -i*", "*/dev/tcp/*", "*chmod +x*", "*/tmp/*") NOT (ParentImage IN ("*/installd", "*/pkgutil", "*/Software Update", "*/managedclient") OR CommandLine IN ("*com.apple.*", "*com.microsoft.*", "*com.google.*", "*com.jamf.*"))
