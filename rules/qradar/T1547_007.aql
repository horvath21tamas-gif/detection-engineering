SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\User Data\\Default\\Preferences%' OR "Filename" LIKE '%\\User Data\\Default\\Secure Preferences%' OR "Filename" LIKE '%\\User Data\\Default\\Current Session%' OR "Filename" LIKE '%\\User Data\\Default\\Last Session%' OR "Filename" LIKE '%\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\brave.exe','%\opera.exe') OR (""Filename"" ILIKE ENUMERATION('%\C:\Windows\System32\robocopy.exe','%\C:\Windows\System32\xcopy.exe')) AND (""Filename"" ILIKE ENUMERATION('%\Microsoft\EdgeUpdate\%','%\Google\Update\%'))) OR ""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\cscript.exe','%\wscript.exe','%\python.exe')
