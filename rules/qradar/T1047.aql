SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\wmic.exe' AND (("Process CommandLine" LIKE '%/node:%' OR "Process CommandLine" LIKE '%process%' OR "Process CommandLine" LIKE '%call%' OR "Process CommandLine" LIKE '%create%')) AND (("Process CommandLine" LIKE '%cmd.exe%' OR "Process CommandLine" LIKE '%powershell.exe%' OR "Process CommandLine" LIKE '%pwsh.exe%' OR "Process CommandLine" LIKE '%rundll32.exe%' OR "Process CommandLine" LIKE '%mshta.exe%' OR "Process CommandLine" LIKE '%regsvr32.exe%' OR "Process CommandLine" LIKE '%bitsadmin%' OR "Process CommandLine" LIKE '%certutil%')) AND (("ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\powershell.exe%' OR "ParentImage" LIKE '%\\pwsh.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\WINWORD.EXE%' OR "ParentImage" LIKE '%\\EXCEL.EXE%' OR "ParentImage" LIKE '%\\POWERPNT.EXE%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\CCM\\%' OR "ParentImage" LIKE '%\\Microsoft Configuration Manager\\%' OR "ParentImage" LIKE '%\\SCCM\\%' OR "ParentImage" LIKE '%\\Tanium\\%' OR "ParentImage" LIKE '%\\PDQ\\%' OR "ParentImage" LIKE '%\\Ivanti\\%' OR "ParentImage" LIKE '%\\ManageEngine\\%' OR "ParentImage" LIKE '%\\Ansible\\%' OR "ParentImage" LIKE '%\\SaltStack\\%' OR "ParentImage" LIKE '%\\Puppet\\%'))
