CommandLine IN ("*api.github.com*", "*raw.githubusercontent.com*", "*api.telegram.org*", "*discord.com/api/webhooks*", "*pastebin.com/raw/*", "*gist.githubusercontent.com*", "*drive.google.com/uc*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\curl.exe", "*\\certutil.exe", "*\\bitsadmin.exe", "*\\rundll32.exe", "*\\regsvr32.exe", "*\\mshta.exe") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Windows\\Temp\\*", "*\\Users\\Public\\*") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*chocolatey*", "*scoop*", "*winget*") OR username="NT AUTHORITY\\SYSTEM")
