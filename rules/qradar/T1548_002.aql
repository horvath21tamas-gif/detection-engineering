SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\fodhelper.exe' AND (("Integrity Level" LIKE '%High%' OR "Integrity Level" LIKE '%System%')) AND "ParentImage" ILIKE '%\fodhelper.exe' AND (("Filename" LIKE '%\\cmd.exe%' OR "Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%' OR "Filename" LIKE '%\\rundll32.exe%' OR "Filename" LIKE '%\\mshta.exe%' OR "Filename" LIKE '%\\wscript.exe%' OR "Filename" LIKE '%\\cscript.exe%' OR "Filename" LIKE '%\\regsvr32.exe%' OR "Filename" LIKE '%\\python.exe%')) AND NOT ("username" ILIKE '%SYSTEM%' OR ("Filename" LIKE '%\\Windows\\CCM\\%' OR "Filename" LIKE '%\\Microsoft Configuration Manager\\%' OR "Filename" LIKE '%\\PDQ\\%' OR "Filename" LIKE '%\\Ivanti\\%'))
