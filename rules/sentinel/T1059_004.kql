DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*/sh", "*/bash", "*/zsh", "*/dash", "*/ash")) and ((ParentProcessName in ("*/httpd", "*/apache2", "*/nginx", "*/php-fpm", "*/python", "*/node", "*/mysqld", "*/postgres", "*/redis-server")) or ((ProcessCommandLine in ("*/dev/tcp/*", "*/dev/udp/*", "*interactive*", "*>&*", "*0>&1*")) or (ProcessCommandLine contains "curl" and ProcessCommandLine contains "|" and ProcessCommandLine contains "sh") or (ProcessCommandLine contains "wget" and ProcessCommandLine contains "-O-"))) and (not ((ParentProcessName in ("*/systemd", "*/sbin/init")) or (ProcessCommandLine in ("*/var/lib/apt/*", "*/tmp/terraform_*", "*logrotate*")) or (User =~ "root" and ParentProcessName =~ "/usr/sbin/sshd")))