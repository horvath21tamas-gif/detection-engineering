source="WinEventLog:Microsoft-Windows-Sysmon/Operational" (EventCode=10 TargetImage IN ("*\\lsass.exe", "*\\svchost.exe", "*\\explorer.exe", "*\\browser.exe") GrantedAccess IN ("0x1F1FFF", "0x1F3FFF", "0x1438")) OR (EventCode=8 SourceImage IN ("*\\Users\\*", "*\\Temp\\*", "*\\AppData\\*") condition="selection_remote_thread and NOT (SourceProcessId == TargetProcessId)") SourceImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powershell.exe", "*\\rundll32.exe") NOT (SourceImage IN ("*\\CcmExec.exe", "*\\MsMpEng.exe", "*\\Taskmgr.exe", "*\\Sysmon.exe") OR CallTrace="*unknown*" OR username="NT AUTHORITY\\SYSTEM")
