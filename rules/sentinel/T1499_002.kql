DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\sc.exe", "*\powershell.exe", "*\pwsh.exe", "*\net.exe", "*\net1.exe")) and (ProcessCommandLine in ("*stop *", "*config *", "*start= disabled*", "*binpath=*", "*Stop-Service*", "*Set-Service*", "* -Status Stopped*", "* -StartupType Disabled*")) and (ProcessCommandLine in ("*WinDefend*", "*MpsSvc*", "*EventLog*", "*RpcSs*", "*LanmanServer*", "*SDRSVC*", "*VSS*", "*Schedule*", "*W32Time*", "*BITS*")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\rundll32.exe", "*\httpd.exe", "*\nginx.exe")) and (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*", "*\Downloads\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\CcmExec.exe", "*\msiexec.exe", "*\TiWorker.exe", "*\TrustedInstaller.exe")) and (ProcessCommandLine in ("*HealthCheck*", "*Update*", "*Diagnostic*", "*Patch*", "*Maintenance*"))))