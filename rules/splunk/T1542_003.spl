Image IN ("*\\mountvol.exe", "*\\bcdedit.exe") OR OriginalFileName IN ("mountvol.exe", "bcdedit.exe") CommandLine IN ("* /s*", "*nointegritychecks*", "*testsigning*", "*loadoptions DDISABLE_INTEGRITY_CHECKS*", "*path \\EFI\\*", "*recoveryenabled no*") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\psexec.exe", "*\\python.exe") Image IN ("*\\Users\\*", "*\\Temp\\*") NOT (ParentImage="*\\svchost.exe" OR Image="*C:\\Windows\\System32\\SystemSettingsAdminFlows.exe*" OR CommandLine="*recoverysequence*")
