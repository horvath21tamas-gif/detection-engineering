((process.executable.caseless:(*\\net.exe OR *\\net1.exe OR *\\whoami.exe OR *\\quser.exe OR *\\qwinsta.exe)) AND (process.command_line:(*Get\-LocalUser* OR *Get\-LocalGroup* OR *Win32_UserAccount* OR *Win32_Group*))) AND (process.command_line:(*\ user* OR *\ localgroup* OR *\ \/all* OR *\ \/groups*)) AND ((process.parent.executable.caseless:(*\\httpd.exe OR *\\nginx.exe OR *\\wsmprovhost.exe OR *\\psexesvc.exe OR *\\php\-cgi.exe OR *\\sqlservr.exe)) AND (process.executable.caseless:(*\\AppData\\Local\\Temp\\* OR *\\Users\\Public\\*))) AND (NOT (winlog.event_data.username:"NT AUTHORITY\\SYSTEM" AND (process.parent.executable.caseless:(*\\Windows\\System32\\msiexec.exe* OR *\\Windows\\System32\\svchost.exe*))))
