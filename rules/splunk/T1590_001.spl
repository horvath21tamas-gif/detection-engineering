(Image="*\\ipconfig.exe" CommandLine IN ("* /all*", "* /displaydns*")) OR (Image="*\\route.exe" CommandLine="* print*") OR (Image="*\\arp.exe" CommandLine="* -a*") OR (Image="*\\netsh.exe" CommandLine="* interface ipv4 show*") OR CommandLine IN ("*ifconfig.me*", "*icanhazip.com*", "*ident.me*", "*api.ipify.org*", "*checkip.amazonaws.com*") NOT (username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\services.exe", "*\\svchost.exe", "*\\msiexec.exe")) NOT (Image="*\\AppData\\Local\\Temp\\*" CommandLine IN ("*--check-connection*", "*--update*"))
