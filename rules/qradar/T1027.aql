SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\pwsh.exe%')) AND (("Process CommandLine" LIKE '%-enc%' OR "Process CommandLine" LIKE '%-encodedcommand%')) AND (("Process CommandLine" LIKE '%Invoke-WebRequest%' OR "Process CommandLine" LIKE '%iwr%' OR "Process CommandLine" LIKE '%wget%' OR "Process CommandLine" LIKE '%curl%' OR "Process CommandLine" LIKE '%DownloadString%' OR "Process CommandLine" LIKE '%DownloadFile%' OR "Process CommandLine" LIKE '%Net.WebClient%'))