(process.executable:(*\\shutdown.exe OR *\\init.exe OR *\\powershell.exe OR *\\pwsh.exe)) AND (process.command_line:*\ \/a* AND (process.command_line:*\ \/f* AND process.command_line:*\ \/t\ 0*)) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\chrome.exe OR *\\msedge.exe OR *\\httpd.exe OR *\\rundll32.exe OR *\\wscript.exe OR *\\cscript.exe)) OR (process.executable:(*\\Temp\\* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\CcmExec.exe OR *\\TiWorker.exe OR *\\msiexec.exe OR *\\svchost.exe)) OR (process.command_line:(*HealthCheck* OR *Diagnostic* OR *AzureAD*))))
