Image IN ("*\\strip.exe", "*\\sstrip.exe", "*\\objcopy.exe", "*\\llvm-strip.exe") CommandLine IN ("* --strip-all*", "* --strip-debug*", "* --remove-section*", "* -s *", "* -S *", "* /NODEBUG*") OR CommandLine IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Windows\\Temp\\*", "*\\PerfLogs\\*", "*\\Downloads\\*") OR ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\nginx.exe", "*\\httpd.exe") NOT (Image IN ("*\\Visual Studio\\*", "*\\Jenkins\\*", "*\\GitLab-Runner\\*", "*\\Azure Pipelines\\*") User IN ("*svc-build*", "*cicd*", "*builder*"))
