SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\cmd.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%net user%','%net localgroup%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/add%','%/delete%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%administrators%','%remote desktop users%','%domain admins%','%enterprise admins%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\WINWORD.EXE','%\EXCEL.EXE','%\POWERPNT.EXE','%\OUTLOOK.EXE','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Tanium\%'))
