CommandLine IN ("*New-InboxRule*", "*Set-InboxRule*", "*Set-MailboxForwardingConfiguration*", "*Remove-InboxRule*") (CommandLine IN ("*DeleteMessage*", "*PermanentDelete*", "*MarkAsRead*", "*MoveToFolder*", "*ForwardTo*") CommandLine IN ("*Security*", "*Alert*", "*Password*", "*MFA*", "*Sign-in*", "*Phish*", "*Compromise*", "*Unauthorized*", "*Breach*")) OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\msedge.exe", "*\\chrome.exe", "*\\mshta.exe", "*\\powershell.exe") NOT (username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*Spam*", "*Junk*", "*Internal-Auto-Forward*") OR ParentImage IN ("*\\Windows\\System32\\svchost.exe*", "*\\ExchangeManagementShell\\*")) | table Time,SourceImage,ParentImage,CommandLine,SourceUsername,TargetMailbox
