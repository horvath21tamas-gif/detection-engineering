(Image="*/journalctl" CommandLine IN ("*--vacuum-time*", "*--vacuum-size*", "*--rotate*", "*--flush*")) OR (Image IN ("*/truncate", "*/shred", "*/tee") CommandLine IN ("*auth.log*", "*secure*", "*syslog*", "*wtmp*", "*lastlog*")) ParentImage IN ("*/apache2", "*/nginx", "*/httpd", "*/php-fpm", "*/python*", "*/perl", "*/node") OR NOT (ParentImage IN ("*/logrotate", "*/systemd") OR CommandLine IN ("*logrotate.conf*", "*/var/lib/docker/containers*") OR (username="root" ParentImage="*/ansible"))
