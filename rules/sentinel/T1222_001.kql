DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\icacls.exe", "*\takeown.exe", "*\cacls.exe", "*\attrib.exe")) and (ProcessCommandLine in ("*:f*", "* /grant*", "*Everyone:*", "*Authenticated Users:*", "*/setowner*", "*/inheritance:r*", "* +r *")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\mshta.exe", "*\wscript.exe", "*\cscript.exe", "*\httpd.exe", "*\nginx.exe", "*\sqlservr.exe")) or (FolderPath in ("*\Users\*", "*\Temp\*", "*\AppData\*", "*\Downloads\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\Windows\servicing\TrustedInstaller.exe*", "*\CcmExec.exe*", "*\Program Files\Microsoft Visual Studio\*")) or (ProcessCommandLine in ("*Microsoft\Windows\SoftwareDistribution*", "*AppData\Local\Packages*", "*\_Installer*"))))