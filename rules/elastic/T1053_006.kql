(Image:(*\/systemctl OR *\/systemd\-analyze)) AND ((CommandLine:(*\/tmp\/* OR *\/var\/tmp\/* OR *\/dev\/shm\/* OR *\/home\/* OR *\/root\/* OR *\/dev\/tcp\/*)) OR (CommandLine:(*ExecStart\=* OR *Restart\=always* OR *base64* OR *curl* OR *wget*)) OR (ParentImage:(*\/bash OR *\/sh OR *\/zsh OR *\/python OR *\/apache2 OR *\/nginx OR *\/php))) AND (NOT ((ParentImage:(*\/ansible OR *\/salt\-minion OR *\/puppet OR *\/chef\-client OR *\/dpkg OR *\/apt OR *\/yum OR *\/dnf)) OR (username:root AND CommandLine:*daemon\-reload*)))
