(process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\wscript.exe OR *\\cscript.exe)) AND (process.command_line:(*while\($true\)* OR *for\(;;\)* OR *\:\:MemoryStream* OR *AllocHGlobal* OR *foreach\($i\ in\ 1..1gb\)* OR *\:loop*)) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\httpd.exe OR *\\rundll32.exe OR *\\outlook.exe)) OR (process.executable:(*\\Temp\\* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\CcmExec.exe OR *\\msiexec.exe OR *\\devenv.exe)) OR (process.command_line:(*HealthCheck* OR *Diagnostic* OR *AzureAD*))))
