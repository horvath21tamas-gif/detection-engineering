DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (operation_name in ("*ModifySnapshotAttribute*", "*SharedSnapshot*", "*SetSnapshotPermissions*", "*CopySnapshot*", "*ShareSnapshot*", "*UpdateSnapshotAccess*")) and ((request_parameters in ("*all*", "*Add.UserId*", "*grantee*", "*public*", "*external-account*", "*everyone*")) or (mfa_authenticated =~ "false" and (user_agent in ("*kali*", "*python-requests*", "*boto3*", "*curl*", "*postman*", "*Terraform*", "*Pulumi*")))) and (not ((user_name in ("svc-veeam*", "svc-commvault*", "backup-agent*", "svc-packer*", "svc-azure-backup*")) and source_ip =~ "10.0.0.0/8"))