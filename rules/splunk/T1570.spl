Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\robocopy.exe", "*\\xcopy.exe", "*\\bitsadmin.exe", "*\\certutil.exe", "*\\curl.exe") CommandLine IN ("*\\C$\\*", "*\\ADMIN$\\*", "*\\IPC$\\*", "*admin$*", "*c$*") CommandLine IN ("*.exe*", "*.dll*", "*.ps1*", "*.vbs*", "*.bat*", "*.zip*", "*.7z*", "*.vhd*", "*.iso*") NOT (Image IN ("*\\CcmExec.exe", "*\\msiexec.exe") OR CommandLine IN ("*\\SoftwareDistribution\\*", "*\\HealthCheck\\*", "*AppData\\Local\\Google\\Chrome*") OR username="NT AUTHORITY\\SYSTEM")
