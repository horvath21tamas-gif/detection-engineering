DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*BEGIN RSA PRIVATE*", "*BEGIN DSA PRIVATE*", "*BEGIN EC PRIVATE*", "*BEGIN OPENSSH PRIVATE*", "*BEGIN PGP PRIVATE*", "*BEGIN PRIVATE KEY*")) or (ProcessCommandLine in ("*.ppk*", "*.pem*", "*.key*", "*.pfx*", "*.p12*", "*id_rsa*", "*id_dsa*", "*id_ed25519*"))) and (ProcessCommandLine in ("*\.ssh\*", "*\AppData\Roaming\Microsoft\Crypto\*", "*\ProgramData\Microsoft\Crypto\*", "*\Users\*", "*\inetpub\*", "*\OpenSSL\*", "*\CertEnroll\*")) and (((ProcessCommandLine in ("*findstr*", "*/s*")) or (ProcessCommandLine in ("*dir*", "*/s*")) or (ProcessCommandLine in ("*Get-ChildItem*", "*-Recurse*")) or (ProcessCommandLine in ("*where*", "*/r*")) or (ProcessCommandLine in ("*grep*", "*-r*"))) or (ProcessCommandLine in ("*base64*", "*certutil -encode*", "*Export-PfxCertificate*", "*Get-Content*", "*gc *", "* | clip*", "* > *", "*scp *", "*curl *", "*Invoke-WebRequest*")) or (ProcessCommandLine in ("*-enc*", "*-EncodedCommand*", "*IEX*", "*Invoke-Expression*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\psexesvc.exe", "*\wmiprvse.exe", "*\cmd.exe", "*\powershell.exe", "*\httpd.exe", "*\php-cgi.exe")) and (FolderPath in ("*\findstr.exe", "*\powershell.exe", "*\cmd.exe", "*\grep.exe")))) and (not (User in ("*NT AUTHORITY\SYSTEM*", "*NT AUTHORITY\LOCAL SERVICE*", "*NT AUTHORITY\NETWORK SERVICE*"))) and (not ((FolderPath in ("*\OpenSSH\ssh-agent.exe*", "*\Git\usr\bin\ssh.exe*", "*\Microsoft Visual Studio\*", "*\Windows\System32\certutil.exe*")) and ParentProcessName endswith "\explorer.exe" and User contains "NT AUTHORITY")) and (not (FolderPath endswith "\mmc.exe" and (ProcessCommandLine in ("*certlm.msc*", "*certmgr.msc*"))))