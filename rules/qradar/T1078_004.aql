SELECT UTF8(payload) as search_payload from events where "properties.status.errorCode"=0 AND ((("properties.userPrincipalName" LIKE '%admin%' OR "properties.userPrincipalName" LIKE '%sync_%' OR "properties.userPrincipalName" LIKE '%global%')) AND "properties.authenticationRequirement"='singleFactorAuthentication' OR ("properties.userAgent" LIKE '%python-requests%' OR "properties.userAgent" LIKE '%curl%' OR "properties.userAgent" LIKE '%Postman%' OR "properties.userAgent" LIKE '%PowerShell%')) AND NOT ("properties.ipAddress"='1.2.3.4' AND "properties.location.city"='Budapest' OR "properties.authenticationProtocol"='servicePrincipal')
