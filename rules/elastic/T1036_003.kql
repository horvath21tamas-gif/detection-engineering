(process.pe.original_file_name:(Cmd.Exe OR PowerShell.EXE OR pwsh.dll OR wscript.exe OR cscript.exe OR mshta.exe OR regsvr32.exe OR rundll32.exe OR certutil.exe OR bitsadmin.exe OR schtasks.exe OR net.exe OR net1.exe OR scrcons.exe)) AND (NOT (process.executable:(*\\cmd.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\mshta.exe OR *\\regsvr32.exe OR *\\rundll32.exe OR *\\certutil.exe OR *\\bitsadmin.exe OR *\\schtasks.exe OR *\\net.exe OR *\\net1.exe OR *\\scrcons.exe))) AND ((process.executable:(*\\Users\\* OR *\\ProgramData\\* OR *\\Temp\\* OR *\\Public\\* OR *\\AppData\\*)) OR (NOT ((process.executable:(C\:\\Windows\\System32\\* OR C\:\\Windows\\SysWOW64\\* OR C\:\\Windows\\WinSxS\\*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR process.parent.executable:*\\msiexec.exe)))
