SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\wscript.exe','%\cscript.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.js%','%.jse%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\brave.exe','%\outlook.exe','%\winword.exe','%\excel.exe','%\mshta.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\Public\%','%\AppData\Local\Temp\%','%\Downloads\%','%C:\ProgramData\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% -e:jscript%','%http%','%xmlhttp%','%adodb.stream%','% -b%')) AND NOT ("Process "Process CommandLine"" ILIKE '%C:\Windows\System32\%' OR ""Parent Filename"" ILIKE '%\services.exe' OR "Process "Process CommandLine"" ILIKE '%UevAgent.js%')
