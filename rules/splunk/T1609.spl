Image IN ("*/kubectl", "*/docker", "*/crictl", "*/podman") CommandLine IN ("* -it *", "* -i *", "* --interactive *") CommandLine IN ("*/bin/sh*", "*/bin/bash*", "*/bin/zsh*", "*/bin/dash*", "*sh*", "*bash*") NOT (username IN ("jenkins", "gitlab-runner", "github-actions", "zabbix", "nagios") OR CommandLine IN ("*pg_dump*", "*mysqldump*", "*vacuumdb*", "*healthcheck*") OR ParentImage="*/kubelet")
