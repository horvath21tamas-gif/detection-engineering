Image IN ("*\\ipconfig.exe", "*\\route.exe", "*\\nbtstat.exe", "*\\arp.exe", "*\\netsh.exe") OR CommandLine IN ("*Get-NetIPAddress*", "*Get-NetRoute*", "*Get-NetNeighbor*", "*interface show*") CommandLine IN ("* /all*", "* print*", "* -a*", "* /displaydns*") OR (ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\httpd.exe", "*\\wsmprovhost.exe") IntegrityLevel="Medium") OR CommandLine IN ("* > *", "*ConvertTo-Json*", "*Export-Csv*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\svchost.exe", "*\\CcmExec.exe", "*\\msiexec.exe") OR CommandLine="*Program Files*")
