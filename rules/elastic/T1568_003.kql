(process.command_line:(*\ \-querytype\ TXT* OR *\ \-q\ TXT* OR *Resolve\-DnsName* OR *\ \-Type\ TXT*)) AND (process.command_line:(*\[Convert\]\:\:* OR *\ \-bxor* OR *.Substring\(* OR *.Split\(* OR *\ \[int\]*)) AND (process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\rundll32.exe)) AND (NOT ((process.command_line:(*_vlmcs._tcp* OR *chocolatey* OR *domain\-verification*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR process.parent.executable:*\\services.exe))
