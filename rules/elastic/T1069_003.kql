(operationName:(Get\ group OR List\ groups OR Get\ members\ of\ group OR ListGroupPolicies OR v1.compute.instanceGroups.list)) AND ((requestParameters:(*$expand* OR *$select* OR *\-\-all* OR *\-\-filter*)) OR (userAgent:(*python\-requests* OR *Go\-http\-client* OR *Postman* OR *Roadtools* OR *MicroBurst*))) AND (src_ip_is_external:true OR user_agent_is_bot:true) AND (NOT (userIdentity_type:AssumedRole AND (userAgent:(*Terraform* OR *PrismaCloud* OR *Wiz.io* OR *Azure\-Sentinel*))))
