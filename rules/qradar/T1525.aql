SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/docker','%/podman','%/containerd','%/ctr','%/crictl')) AND (""Process CommandLine"" ILIKE ENUMERATION('% run %','% create %','% start %')) AND (""Process CommandLine"" ILIKE ENUMERATION('%docker.io/%','%ghcr.io/%','%quay.io/%','%registry.hub.docker.com/%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%:latest%','%:dev%','%:test%','%:debug%')) AND NOT (""Process CommandLine"" ILIKE ENUMERATION('%registry.corp.local/%','%harbor.prod.local/%','%acr.company.com/%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/jenkins%','%/gitlab-runner%','%/github-actions%','%/azure-pipelines%','%/tekton%')) AND NOT (""Process CommandLine"" ILIKE ENUMERATION('%kube-system%','%istio-system%','%monitoring%')) AND NOT (("Hostname" LIKE '%build%' OR "Hostname" LIKE '%ci%' OR "Hostname" LIKE '%runner%'))
