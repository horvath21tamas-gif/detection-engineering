DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*ipinfo.io*", "*ifconfig.me*", "*icanhazip.com*", "*api.ipify.org*", "*checkip.amazonaws.com*", "*ip-api.com*")) or (ProcessCommandLine in ("*Keyboard Layout\Preload*", "*Control Panel\International*", "*MUILanguages*", "*GeoID*")) or (ProcessCommandLine in ("*Get-Culture*", "*Get-WinSystemLocale*", "*Get-TimeZone*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\wsmprovhost.exe", "*\httpd.exe")) and IntegrityLevel =~ "Medium") and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\msiexec.exe", "*\CcmExec.exe", "*\svchost.exe")) or (ProcessCommandLine in ("*Program Files*", "*Splunk*"))))