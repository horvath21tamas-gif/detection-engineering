SELECT username, "Filename", "Parent Filename", Process "Process CommandLine", Integrity Level, Process Path, File Hash from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%/rest/api/space%','%/rest/api/content%','%/doexportpage.action%','%/exportword%','%pages/viewpage.action%pageId=%','%/pages/exportpdf.action%','%/pages/exportword.action%')) AND (""Filename"" ILIKE ENUMERATION('%\curl.exe','%\wget.exe','%\powershell.exe','%\pwsh.exe','%\python.exe','%\confluence-cli.exe','%\node.exe','%\java.exe')) AND ((""Parent Filename"" ILIKE ENUMERATION('%\w3wp.exe','%\httpd.exe','%\winword.exe','%\excel.exe','%\rundll32.exe','%\cmd.exe','%\taskhostw.exe')) AND (("Integrity Level" LIKE '%Medium%' OR "Integrity Level" LIKE '%High%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('% > %','% -OutFile %','% -o %','%\Users\Public\%','%\Temp\%','%\AppData\Local\Temp\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%C:\Program Files\Atlassian\%','%C:\Program Files (x86)\Atlassian\%') OR ("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%DOMAIN\\svc_%' OR "UserName" LIKE '%DOMAIN\\backup_%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%confluence-healthcheck%','%inventory-agent%','%--version%','%-help%'))
