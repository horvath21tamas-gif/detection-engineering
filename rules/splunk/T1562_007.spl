eventName IN ("AuthorizeSecurityGroupIngress", "AuthorizeSecurityGroupEgress", "RevokeSecurityGroupIngress", "RevokeSecurityGroupEgress", "CreateSecurityGroup", "DeleteSecurityGroup") OR eventName IN ("CreateNetworkAclEntry", "ReplaceNetworkAclEntry", "DeleteNetworkAclEntry") OR eventName IN ("UpdateWebACL", "PutWebACL", "DeleteWebACL", "UpdateRuleGroup") (requestParameters.ipPermissions.items.ipRanges.items.cidrIp="0.0.0.0/0" requestParameters.ipPermissions.items.ipv6Ranges.items.cidrIpv6="::/0") OR requestParameters.ipPermissions.items.ipProtocol="-1" OR (requestParameters.ipPermissions.items.fromPort IN (22, 3389, 5985, 5986) requestParameters.ipPermissions.items.toPort IN (22, 3389, 5985, 5986)) userIdentity.type="Root" OR userIdentity.sessionContext.attributes.mfaAuthenticated="false" OR userAgent IN ("*python-requests*", "*curl*", "*wget*", "*kali*", "*postman*", "*bot*") OR userAgent="*aws-cli*" NOT (userIdentity.arn IN ("*role/Terraform*", "*role/CloudFormation*", "*role/AWSServiceRole*", "*role/SecurityAutomation*", "*role/OrganizationAccountAccessRole*") OR userIdentity.invokedBy IN ("autoscaling.amazonaws.com", "elasticloadbalancing.amazonaws.com")) | table eventTime,eventName,userIdentity.arn,userIdentity.type,sourceIPAddress,userAgent,requestParameters,awsRegion
