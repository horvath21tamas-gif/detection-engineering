DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\docker.exe", "*\dockerd.exe", "*\VBoxManage.exe", "*\VBoxHeadless.exe", "*\vmrun.exe", "*\vmware-kvm.exe", "*\vboxmanage.exe", "*\qemu-system-x86_64.exe")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe", "*\php-cgi.exe", "*\httpd.exe", "*\nginx.exe", "*\mshta.exe", "*\powershell.exe", "*\cmd.exe")) or ((ProcessCommandLine in ("*--rm*", "*--privileged*", "*--net=host*", "*--entrypoint*", "*--device*", "*nogui*", "*startvm*", "* -it *", "*--detach*")) and (not ((ParentProcessName in ("*\Common7\IDE\devenv.exe*", "*\bin\code.exe*", "*\Program Files\Docker\*", "*\Program Files\VMware\*", "*\Program Files\VirtualBox\*")) or (ProcessCommandLine in ("*docker-desktop*", "*docker-compose*", "*minikube*", "*vagrant*"))))))