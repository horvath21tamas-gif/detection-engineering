SrcIp IN ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*") UriStem IN ("*/cgi-bin*", "*/status*", "*/system*", "*/device*", "*/version*", "*/firmware*", "*/diagnostic*", "*/setup*", "*/admin*", "*/mgmt*", "*/management*") UriQuery IN ("*firmware*", "*version*", "*build*", "*model*", "*hardware*", "*platform*") UserAgent IN ("*curl*", "*wget*", "*python*", "*httpclient*", "*go-http-client*", "*libwww*", "*probe*") NOT (UserAgent IN ("*Mozilla*", "*Chrome*", "*Safari*", "*Firefox*", "*Edge*") OR UserAgent IN ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nikto*", "*nuclei*", "*zap*", "*zabbix*", "*uptime*", "*pingdom*") OR (UriStem IN ("*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.woff", "*.woff2", "*.json") UriStem="*/api*")) | table SrcIp,UriStem,UriQuery,UserAgent,Status
