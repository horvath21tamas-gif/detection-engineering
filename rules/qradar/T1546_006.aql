SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/optool','%/insert_dylib','%/yololib','%/patcho') OR ""Process CommandLine"" ILIKE ENUMERATION('%LC_LOAD_DYLIB%','%install_name_tool -add_rpath%') OR ""Process CommandLine"" ILIKE ENUMERATION('%/tmp/%','%/Users/Shared/%','%/Library/Caches/%','%/Downloads/%','%.hidden/%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('/Applications/Xcode.app/%','/Library/Developer/%')) AND (""Filename"" ILIKE ENUMERATION('%/usr/bin/codesign','%/usr/bin/xcodebuild','%/usr/bin/ld')) AND "username"='root' OR ""Filename"" ILIKE ENUMERATION('%/installd','%/softwareupdated'))
