Image IN ("*\\aws.exe", "*\\az.exe", "*\\gcloud.exe", "*\\mgc.exe") OR CommandLine IN ("* create-access-key*", "* update-login-profile*", "* create-service-principal*", "* add-password*", "* delete-virtual-mfa-device*", "* authentication-method-create*") NOT (User IN ("*svc_iam_provisioner*", "*adm_cloud_identity*", "*entra_admin_deploy*") Image IN ("*\\ManagementConsole\\*", "*\\Program Files\\Terraform\\*")) NOT (ParentImage IN ("*\\code.exe", "*\\devenv.exe", "*\\idea64.exe")) NOT (ParentImage="*\\explorer.exe" condition="not selection_cloud_identity_ops")
