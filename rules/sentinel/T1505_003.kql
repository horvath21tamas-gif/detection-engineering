DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((['cs-method'] in ("POST", "PUT", "PATCH")) and (['cs-uri-stem'] in ("*/uploads/*", "*/upload/*", "*/files/*", "*/images/*", "*/tmp/*", "*/data/*", "*/public/*")) and (['cs-uri-stem'] in ("*.php", "*.phtml", "*.php5", "*.asp", "*.aspx", "*.jsp", "*.ashx", "*.cgi", "*.pl"))) or (((['cs-uri-stem'] in ("*.php", "*.phtml", "*.php5", "*.asp", "*.aspx", "*.jsp", "*.ashx", "*.cgi", "*.pl")) and (['cs-uri-query'] in ("*cmd=*", "*exec=*", "*system=*", "*powershell=*", "*whoami*", "*net user*", "*id*", "*uname*", "*curl *", "*wget *", "*base64*", "*eval(*", "*shell=*")) and (['sc-status'] in (200, 201, 202)) and (['cs-user-agent'] in ("*curl*", "*wget*", "*python*", "*powershell*", "*httpclient*", "*libwww*", "*java*", "*perl*"))) and (not (['cs-uri-stem'] in ("*/wp-admin/*", "*/wp-json/*", "*/administrator/*", "*/api/*", "*/rest/*", "*/media/*", "*/uploads/plugins/*", "*/uploads/themes/*"))))