DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\sherlock.exe", "*\maigret.exe", "*\ghunt.exe", "*\twint.exe")) or (ProcessCommandLine in ("*socialscan*", "*linkedintools*", "*instagram-scraper*"))) or (((ProcessCommandLine contains "--headless" and ProcessCommandLine contains "webdriver") and (ProcessCommandLine in ("*linkedin.com/in/*", "*twitter.com/*", "*facebook.com/profile*"))) and ((FolderPath in ("*\python.exe", "*\node.exe", "*\curl.exe")) or (ProcessCommandLine in ("*api.linkedin.com*", "*api.twitter.com*", "*/users/lookup*", "*search_user*"))))) and (not (ParentProcessName endswith "\explorer.exe" and condition =~ "not selection_specialized_tools")) and (not (FolderPath in ("*\LinkedInRecruiter\*", "*\Hootsuite\*", "*\Buffer\*", "*\Salesforce\*"))) and (not username =~ "NT AUTHORITY\SYSTEM")