SELECT UTF8(payload) as search_payload from events where (("name" LIKE '%/etc/pam.d/%' OR "name" LIKE '%/lib/security/%' OR "name" LIKE '%/lib64/security/%' OR "name" LIKE '%/usr/lib/security/%' OR "name" LIKE '%/usr/lib64/security/%')) AND (("nametype" LIKE '%CREATE%' OR "nametype" LIKE '%DELETE%') OR ""Filename"" ILIKE ENUMERATION('%/vim','%/nano','%/sed','%/awk','%/python%','%/perl','%/insmod')) AND NOT ((""Filename"" ILIKE ENUMERATION('%/apt','%/dpkg','%/yum','%/dnf','%/rpm','%/pam-auth-update')) AND (""Filename"" ILIKE ENUMERATION('%/ansible/%','%/salt-minion%','%/chef-client%','%/puppet%')) OR ""Parent Filename"" ILIKE '%/unattended-upgrade')
