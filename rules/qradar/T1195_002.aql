SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\3CXDesktopApp.exe','%\SolarWinds.BusinessLayerHost.exe','%\sqlservr.exe','%\vboxmsi.exe','%\anydesk.exe','%\teamviewer.exe','%\slack.exe','%\zoom.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\whoami.exe','%\net.exe','%\ipconfig.exe','%\nltest.exe','%\nslookup.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% -enc %','% -w hidden %','%Invoke-WebRequest%','%DownloadString%','%http%','%/domain%')) AND NOT (""Filename"" ILIKE '%\Program Files\%' OR "Process "Process CommandLine"" ILIKE '%setup%' OR "Process "Process CommandLine"" ILIKE '%install%')
