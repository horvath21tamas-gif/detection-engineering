Message IN ("*nat (inside,outside)*", "*static-nat*", "*set system bridge*", "*add bridge-group*", "*port-forwarding*", "*virtual-server*", "*set nat source*", "*set vip*", "*set policy route*") Message IN ("*port 22*", "*port 3389*", "*port 445*", "*port 5985*", "*port 3306*", "*port 5432*", "*port 5900*") Message IN ("*web-console*", "*http-admin*", "*ssh-session*", "*local-user*", "*console*", "*telnet-session*") NOT (SourceIP IN ("10.50.0.10", "10.50.0.11", "10.50.0.12") OR Message IN ("*vpn-pool*", "*dynamic-pat*", "*ipsec-nat-t*", "*ssl-vpn*")) | table Time,SourceIP,User,Interface,PolicyID,Message,Port,VIP
