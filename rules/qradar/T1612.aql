SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/docker','%/docker-compose','%/buildah','%/podman','%/kaniko')) AND (""Process CommandLine"" ILIKE ENUMERATION('% build %','% build-image %','% build-using-dockerfile %','% buildx build %')) AND (""Parent Filename"" ILIKE ENUMERATION('%/nginx','%/apache2','%/httpd','%/php-fpm','%/python','%/node','%/java','%/redis-server','%/mysqld','%/httpd.worker') OR (""Process CommandLine"" ILIKE ENUMERATION('% -f -%','% http://%','% https://%','%--no-cache%','%--privileged%','%--secret%','%--ssh%')) AND NOT ((("UserName" LIKE '%jenkins%' OR "UserName" LIKE '%gitlab-runner%' OR "UserName" LIKE '%github-actions%' OR "UserName" LIKE '%root%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/home/jenkins%','%/var/lib/gitlab-runner%','%/home/github-actions%','%/home/gitlab-runner%'))))
