SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND "Process "Process CommandLine"" ILIKE '%Set-PSReadLineOption%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%$false%','%$null%','%"%','%/dev/null%')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-EncodedCommand%')) OR ""Filename"" ILIKE '%\reg.exe' AND "Process "Process CommandLine"" ILIKE '%add%' AND "Process "Process CommandLine"" ILIKE '%HKCU\Software\Microsoft\Windows\CurrentVersion\Console%' AND "Process "Process CommandLine"" ILIKE '%HistoryBufferSize%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% 0%','%/d 0%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\ConsoleHost_history.txt%','%\AppData\Roaming\Microsoft\Windows\PowerShell\PSReadLine\%','%\.bash_history%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\w3wp.exe','%\mshta.exe','%\rundll32.exe') OR NOT (""Parent Filename"" ILIKE ENUMERATION('%\Common7\IDE\devenv.exe%','%\Microsoft VS Code\Code.exe%','%\JetBrains\%') OR "username" ILIKE 'NT AUTHORITY%' AND ""Parent Filename"" ILIKE '%\services.exe' OR "Process "Process CommandLine"" ILIKE ENUMERATION('%AppData\Local\Temp\SDI%','%Chocolatey%','%SCCM%')))
