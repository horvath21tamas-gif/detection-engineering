((eventName:(StopLogging OR DeleteTrail OR DeleteEventDataStore)) OR (eventName:UpdateTrail AND (requestParameters.enableLogFileValidation:false OR requestParameters.kmsKeyId:"")) OR ((eventName:(PutEventSelectors OR UpdateEventDataStore)) AND requestParameters.includeManagementEvents:false) OR ((eventSource:s3.amazonaws.com AND (eventName:(DeleteBucket OR PutBucketLifecycleConfiguration OR PutBucketVersioning OR PutBucketPolicy))) AND (requestParameters.bucketName:(*log* OR *trail* OR *audit* OR *security* OR *telemetry*)))) AND (userIdentity.type:Root OR userIdentity.sessionContext.attributes.mfaAuthenticated:false OR (userAgent:(*python\-requests* OR *curl* OR *wget* OR *kali* OR *postman* OR *bot*)) OR userAgent:*aws\-cli*) AND (NOT ((userIdentity.arn:(*role\/Terraform* OR *role\/CloudFormation* OR *role\/Security\-Automation* OR *role\/OrganizationAccountAccessRole* OR *role\/AWSServiceRoleForCloudTrail*)) OR (userIdentity.invokedBy:(cloudtrail.amazonaws.com OR config.amazonaws.com))))
