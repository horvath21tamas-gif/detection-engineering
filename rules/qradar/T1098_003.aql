SELECT UTF8(payload) as search_payload from events where "operationName"='Update application – Certificates and secrets management ' AND (("targetResources.modifiedProperties.displayName" LIKE '%KeyDescription%' OR "targetResources.modifiedProperties.displayName" LIKE '%Public Key%')) AND "initiatedBy.user.userPrincipalName" ILIKE '%' AND NOT (("initiatedBy.app.displayName" LIKE '%Microsoft App-Registration-Service%' OR "initiatedBy.app.displayName" LIKE '%Azure Active Directory Connector%' OR "initiatedBy.app.displayName" LIKE '%Azure Key Vault%') OR ("initiatedBy.user.userPrincipalName" LIKE '%svc-terraform%' OR "initiatedBy.user.userPrincipalName" LIKE '%github-actions%' OR "initiatedBy.user.userPrincipalName" LIKE '%devops-spn%'))
