DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\sc.exe", "*\net.exe", "*\net1.exe", "*\powershell.exe", "*\pwsh.exe", "*\taskkill.exe")) and (ProcessCommandLine in ("*stop*", "*Stop-Service*", "*Set-Service*", "* -f *", "* -im *")) and (ProcessCommandLine in ("*WinDefend*", "*MpsSvc*", "*EventLog*", "*VSS*", "*Sentinel*", "*CrowdStrike*", "*Sophos*", "*SepMasterService*", "*CylanceSvc*", "*MeSvc*")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\chrome.exe", "*\rundll32.exe", "*\outlook.exe", "*\wscript.exe", "*\cscript.exe")) and (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\CcmExec.exe", "*\msiexec.exe", "*\TiWorker.exe")) and (ProcessCommandLine in ("*Update*", "*HealthCheck*", "*Diagnostic*"))))