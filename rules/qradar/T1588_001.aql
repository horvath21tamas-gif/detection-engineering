SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%redline%' OR "Filename" LIKE '%lumma%' OR "Filename" LIKE '%stealer%' OR "Filename" LIKE '%agenttesla%' OR "Filename" LIKE '%remcos%' OR "Filename" LIKE '%cobaltstrike%' OR "Filename" LIKE '%brutenratel%' OR "Filename" LIKE '%ransomware%') OR ("Filename" LIKE '%.iso%' OR "Filename" LIKE '%.vhd%' OR "Filename" LIKE '%.vhdx%' OR "Filename" LIKE '%.img%' OR "Filename" LIKE '%.cab%')) AND (""Filename"" ILIKE ENUMERATION('%\certutil.exe','%\bitsadmin.exe','%\curl.exe','%\wget.exe','%\powershell.exe','%\pwsh.exe')) AND NOT ((("Filename" LIKE '%\\Windows\\SoftwareDistribution\\%' OR "Filename" LIKE '%\\Program Files\\%' OR "Filename" LIKE '%\\Program Files (x86%')\%')) AND "username" ILIKE '%SYSTEM%' OR ""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe'))
