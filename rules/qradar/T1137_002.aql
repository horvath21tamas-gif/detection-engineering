SELECT UTF8(payload) as search_payload from events where "Target Object" IMATCHES '\\Software\\Microsoft\\Office\\.*\\Office Test\\Special\\Defrag$' AND ("Target Details" IMATCHES '(\\AppData\\Local\\|\\AppData\\Roaming\\|C:\\Users\\Public\\|C:\\Windows\\Temp\\|\\Downloads\\|\\\\)' OR ""Filename"" IMATCHES '(powershell\.exe|pwsh\.exe|cmd\.exe|reg\.exe|cscript\.exe|wscript\.exe|rundll32\.exe)$') AND NOT ("Target Details" IMATCHES '(C:\\Program Files\\|C:\\Program Files \(x86\)\\)' OR ""Filename"" IMATCHES '(msiexec\.exe|OfficeClickToRun\.exe)$')
