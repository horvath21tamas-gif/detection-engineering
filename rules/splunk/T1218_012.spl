Image="*\\verclsid.exe" OR OriginalFileName="verclsid.exe" ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\powershell.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\chrome.exe") OR CommandLine IN ("* /S *", "* /C *", "*{*") NOT (ParentImage IN ("*\\explorer.exe", "*\\svchost.exe", "*\\SearchIndexer.exe") username="NT AUTHORITY\\SYSTEM")
