SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Search-Mailbox%','%New-MailboxSearch%','%Export-Mailbox%','% -DeleteContent%','% -Force%','% -Purge%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Security%','%Alert%','%Phish%','%Login%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\w3wp.exe','%\winword.exe','%\excel.exe','%\mshta.exe','%\php-cgi.exe','%\powershell.exe','%\cmd.exe') OR NOT ("username" ILIKE 'NT AUTHORITY\%' OR "Process "Process CommandLine"" ILIKE ENUMERATION('%Discovery Management%','%Compliance%','%Retention%') OR ""Parent Filename"" ILIKE '%\ExSetup.exe'))
