DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\reg.exe" and ProcessCommandLine contains "1") or (ProcessCommandLine in ("*arpspoof*", "*bettercap*", "*ettercap*", "* -i *", "* -t *", "* -m arp*", "*.sniff*"))) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (FolderPath in ("*\python.exe", "*\pythonw.exe", "*\powershell.exe"))) and (not (((ParentProcessName in ("*\Program Files\VMware\*", "*\Program Files\Oracle\VirtualBox\*")) and User =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\Program Files\Wireshark\*", "*\Program Files\Cisco\*", "*\System32\nbtstat.exe*", "*\System32\pathping.exe*"))))