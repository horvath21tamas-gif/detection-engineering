Image IN ("*\\diskpart.exe", "*\\dd.exe", "*\\format.com", "*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*\\.\\PhysicalDrive*", "*\\.\\Harddisk*", "*clean*", "*delete partition*", "*Clear-Disk*", "*Remove-Partition*", "*if=/dev/zero*", "*if=/dev/urandom*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\explorer.exe") OR Image IN ("*\\Temp\\*", "*\\Users\\*") NOT (ParentImage IN ("*\\msiexec.exe", "*\\CcmExec.exe", "*\\setup.exe") OR CommandLine IN ("*vds.exe*", "*127.0.0.1*") OR username="NT AUTHORITY\\SYSTEM")
