SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%/journalctl' AND (""Process CommandLine"" ILIKE ENUMERATION('%--vacuum-time%','%--vacuum-size%','%--rotate%','%--flush%')) OR (""Filename"" ILIKE ENUMERATION('%/truncate','%/shred','%/tee')) AND (""Process CommandLine"" ILIKE ENUMERATION('%auth.log%','%secure%','%syslog%','%wtmp%','%lastlog%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%/apache2','%/nginx','%/httpd','%/php-fpm','%/python%','%/perl','%/node') OR NOT (""Parent Filename"" ILIKE ENUMERATION('%/logrotate','%/systemd') OR ""Process CommandLine"" ILIKE ENUMERATION('%logrotate.conf%','%/var/lib/docker/containers%') OR "username"='root' AND ""Parent Filename"" ILIKE '%/ansible'))
