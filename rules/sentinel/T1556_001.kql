DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where TargetObject =~ "HKLM\SYSTEM\CurrentControlSet\Control\Lsa\Security Packages" and Details contains ".dll" and (Details in ("*\Users\*", "*\Users\Public\*", "*\ProgramData\*", "*\AppData\*", "*\Temp\*")) and (not (Details in ("*\Windows\System32\*", "*\Windows\SysWOW64\*"))) and (not (FolderPath in ("*\Windows\System32\lsass.exe*", "*\Windows\System32\services.exe*", "*\Windows\System32\msiexec.exe*", "*\Windows\servicing\*", "*\Windows\System32\dism.exe*"))) and (not (User in ("*NT AUTHORITY\SYSTEM*", "*NT SERVICE\TrustedInstaller*")))