SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\brave.exe','%\outlook.exe','%\thunderbird.exe','%\teams.exe','%\slack.exe','%\discord.exe')) AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\mshta.exe','%\wscript.exe','%\cscript.exe','%\certutil.exe','%\bitsadmin.exe','%\rundll32.exe','%\regsvr32.exe','%\hh.exe','%\scrcons.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%http%','%DownloadString%','%Invoke-WebRequest%','%-ExecutionPolicy Bypass%','%javascript:%','%vbscript:%','%.jnlp%','% -e %')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%--type=renderer%','%--type=utility%','%--type=gpu-process%','%\Google\Update\%','%\Microsoft\EdgeUpdate\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%RemoteAssistance%','%TeamViewer%'))
