operationName IN ("*Get group*", "*List groups*", "*Get members of group*", "*ListGroupPolicies*", "*v1.compute.instanceGroups.list*") requestParameters IN ("*$expand*", "*$select*", "*--all*", "*--filter*") OR userAgent IN ("*python-requests*", "*Go-http-client*", "*Postman*", "*Roadtools*", "*MicroBurst*") src_ip_is_external=true OR user_agent_is_bot=true NOT (userIdentity_type="AssumedRole" userAgent IN ("*Terraform*", "*PrismaCloud*", "*Wiz.io*", "*Azure-Sentinel*"))
