(ParentImage IN ("*\\outlook.exe", "*\\teams.exe", "*\\slack.exe") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe") CommandLine IN ("*redirect_uri=*", "*client_id=*", "*response_type=token*", "*login_hint=*", "*verify-account*", "*password-reset*", "*azure-edge.net*")) OR (Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe") CommandLine IN ("*--incognito*", "*--inprivate*", "*--new-window*", "*--headless*") CommandLine IN ("*redirect_uri=*", "*client_id=*", "*response_type=token*", "*login_hint=*", "*verify-account*", "*password-reset*", "*azure-edge.net*") NOT (CommandLine IN ("*login.microsoftonline.com*", "*okta.com*", "*duosecurity.com*", "*auth.*")) NOT (CommandLine IN ("*office.com/setup*", "*akamai.net*", "*windowsupdate.com*")) NOT (CommandLine IN ("*.local*", "*.lan*", "*http://10.*", "*http://192.168.*")))
