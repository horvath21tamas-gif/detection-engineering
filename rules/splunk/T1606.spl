CommandLine IN ("*goldensaml*", "*asreproast*", "*Get-AADIntAccessToken*", "*roadtoken*", "*cloud::google*", "*cloud::aws*") OR CommandLine IN ("*dpapi::masterkey*", "*crypt::unprotect*") OR Image IN ("*\\mimikatz.exe", "*\\pypykatz.exe") OR (CommandLine IN ("*select *", "*password_value*", "*token*", "*cookie*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*")) NOT (Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe", "*\\teams.exe", "*\\slack.exe") ParentImage="*\\Program Files\\*")
