DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\flashrom.exe", "*\fwupdmgr.exe", "*\AfuEfix64.exe", "*\H2OFFT-W.exe", "*\WinFlash.exe", "*\wbemtest.exe")) or (ProcessCommandLine in ("*--flash*", "*-w *", "*/forceit*", "*\.\PhysicalDrive*", "*\.\Scsi*", "*WmiInternal*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\chrome.exe", "*\rundll32.exe")) and (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\System32\svchost.exe*", "*\CcmExec.exe*")) or (FolderPath in ("*\Dell\CommandUpdate\*", "*\Lenovo\SystemUpdate\*", "*\HP\SoftPaq\*", "*\WindowsUpdateBox.exe*"))))