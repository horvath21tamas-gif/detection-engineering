Image IN ("*\\7z.exe", "*\\7za.exe", "*\\rar.exe", "*\\WinRAR.exe", "*\\tar.exe", "*\\powershell.exe", "*\\pwsh.exe") OR OriginalFileName IN ("7z.exe", "7za.exe", "Rar.exe", "tar.exe", "PowerShell.EXE") CommandLine IN ("* a *", "* -a*", "* -cf *", "*Compress-Archive*", "*New-Object System.IO.Compression*") CommandLine IN ("* -p*", "* -hp*", "* -v*", "* -mhe=on*", "* -sdel*") OR CommandLine IN ("*\\AppData\\*", "*\\Temp\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*C:\\PerfLogs\\*") NOT (ParentImage IN ("*\\msiexec.exe", "*\\CcmExec.exe") CommandLine="*\\Microsoft\\Windows\\SoftwareDistribution\\*")
