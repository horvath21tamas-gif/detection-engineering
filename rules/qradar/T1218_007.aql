SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\msiexec.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%http://%','%https://%','%/i%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/quiet%','%/qn%','%/norestart%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Tanium\%','%\Intune\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Google\Update\%','%\Microsoft\EdgeUpdate\%','%\Adobe\%','%\Mozilla\%','%\Zoom\%','%\Slack\%','%\Cisco\%'))
