Image IN ("*\\hping3.exe", "*\\loic.exe", "*\\hoic.exe", "*\\iperf.exe", "*\\iperf3.exe", "*\\nping.exe", "*\\pktmon.exe") CommandLine IN ("* --flood*", "* --syn*", "* --udp*", "* -u -b 0*", "* -i u*", "* --icmp*", "* --rand-source*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\chrome.exe", "*\\rundll32.exe", "*\\outlook.exe") OR Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR Image IN ("*\\Program Files\\NetworkMonitoring\\*", "*\\Azure\\*") OR CommandLine IN ("*Speedtest*", "*HealthCheck*"))
