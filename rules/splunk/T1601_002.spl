Message IN ("*software install*", "*request system software add*", "*firmware upgrade*", "*boot system flash*", "*install activate*", "*request platform software*") Message IN ("*tftp://*", "*http://*", "*ftp://*", "*.bin*", "*.tar*") OR Message IN ("*signature validation failed*", "*hash mismatch*", "*invalid image signature*", "*checksum error*", "*not a trusted image*") NOT (SourceIP IN ("10.50.0.10", "10.50.0.11") OR Message IN ("*scp://*", "*https://*", "*sftp://*"))
