((process.executable:*\\schtasks.exe AND process.command_line:*\ \/tn\ *) OR (process.executable:*\\sc.exe AND process.command_line:*\ delete\ *) OR ((process.executable:(*\\powershell.exe OR *\\pwsh.exe)) AND (process.command_line:(*\ \-Confirm\:$false* OR *\ \-Force*)))) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\chrome.exe OR *\\msedge.exe OR *\\w3wp.exe OR *\\sqlservr.exe OR *\\java.exe OR *\\php\-cgi.exe)) AND (NOT ((process.parent.executable:(*\\msiexec.exe OR *\\GoogleUpdate.exe OR *\\MicrosoftEdgeUpdate.exe)) OR (process.command_line:(*Windows\\System32\\SystemReset.exe* OR *Telemetry*)) OR (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND process.parent.executable:*\\services.exe))))
