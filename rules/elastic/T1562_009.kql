((process.executable:*\\bcdedit.exe AND (process.command_line:(*\{current\}* OR *\{default\}*))) OR (process.command_line:(*delete* OR *0x0*)) OR (process.executable:*\\shutdown.exe AND (process.command_line:*\ \/r* AND process.command_line:*\ \/f* AND process.command_line:*\ \/t\ 0*))) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\powershell.exe OR *\\cmd.exe OR *\\w3wp.exe)) OR (NOT ((winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND process.parent.executable:*\\services.exe) OR (process.command_line:(*reagentc.exe* OR *SystemReset.exe*)) OR process.parent.executable:*\\msiexec.exe)))
