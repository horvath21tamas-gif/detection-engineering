(Image="*\\wevtutil.exe" CommandLine IN ("*Security*", "*System*", "*Setup*", "*PowerShell*")) OR (Image="*\\fsutil.exe" CommandLine="*usn*" CommandLine="*deletejournal*") OR CommandLine IN ("*del *", "*Remove-Item*") OR CommandLine IN ("*\\Windows\\Prefetch\\*", "*\\System32\\config\\Journal*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\w3wp.exe", "*\\powershell.exe") OR NOT ((username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\services.exe", "*\\svchost.exe", "*\\msiexec.exe")) OR CommandLine IN ("*cleanmgr.exe*", "*CCM\\Temp*", "*HealthCheck*"))
