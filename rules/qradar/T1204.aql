SELECT UTF8(payload) as search_payload from events where ("Parent("Filename" LIKE '%\WINWORD.EXE%' OR "Filename" LIKE '%\EXCEL.EXE%' OR "Filename" LIKE '%\POWERPNT.EXE%' OR "Filename" LIKE '%\OUTLOOK.EXE%' OR "Filename" LIKE '%\MSACCESS.EXE%')) AND (("Filename" LIKE '%\cmd.exe%' OR "Filename" LIKE '%\powershell.exe%' OR "Filename" LIKE '%\pwsh.exe%' OR "Filename" LIKE '%\mshta.exe%' OR "Filename" LIKE '%\rundll32.exe%' OR "Filename" LIKE '%\regsvr32.exe%' OR "Filename" LIKE '%\bitsadmin.exe%' OR "Filename" LIKE '%\certutil.exe%'))
