Image IN ("*\\hdparm.exe", "*\\nvflash.exe", "*\\mlxfwmanager.exe", "*\\wd-fw-update.exe") OriginalFileName IN ("hdparm.exe", "nvflash.exe", "FPTW64.exe") CommandLine IN ("* -f *", "* --write*", "* -update*", "* -s *") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\wscript.exe") Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Public\\*") NOT (Image IN ("*C:\\Program Files\\*", "*C:\\Program Files (x86)\\*") OR ParentImage="*\\svchost.exe" OR username="NT AUTHORITY\\SYSTEM")
