DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*rest/api/*", "*api/v2/spaces*", "*api/v2/pages*", "*rest/api/2/issue*", "*_vti_bin/lists.asmx*", "*Get-SPO*", "*export-sharepoint*", "*Get-PnP*", "*/wiki/pages/viewpage*", "*.wiki.git*")) and ((ProcessCommandLine in ("*export*", "*backup*", "*download-all*", "*recursive*", "*dump*", "*--mirror*", "*--all*", "*--depth*", "*clone*", "*archive*")) or (ProcessCommandLine in ("*\Users\*", "*\Temp\*", "*\AppData\Local\Temp\*", "*\Public\*", "*-OutFile*", "*>*"))) and ((ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\w3wp.exe", "*\httpd.exe", "*\python.exe", "*\node.exe")) and (IntegrityLevel in ("Medium", "High"))) and (not ((FolderPath in ("*C:\Program Files\Atlassian\*", "*C:\Program Files\Microsoft Monitoring Agent\*", "*C:\Windows\CCM\*", "*C:\Program Files\Elastic\*", "*C:\Program Files\Splunk\*")) or (User in ("NT AUTHORITY\SYSTEM*", "DOMAIN\svc_*", "DOMAIN\backup_*")) or (ProcessCommandLine in ("*healthcheck*", "*ping*", "*--version*", "*-help*"))))