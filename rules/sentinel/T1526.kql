DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\aws.exe", "*\az.cmd", "*\gcloud.cmd")) and (ProcessCommandLine in ("*lambda list-functions*", "*secretsmanager list-secrets*", "*eks list-clusters*", "*keyvault list*", "*webapp list*", "*functionapp list*", "*functions list*", "*container clusters list*")) and ((ProcessCommandLine in ("*--query*", "*--output json*", "* | jq*", "* | base64*", "* > *", "* | clip*")) or (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\httpd.exe"))) and (not ((ParentProcessName in ("*\Jenkins\*", "*\GitLab-Runner\*", "*\Terraform\*", "*\Ansible\*")) and User =~ "NT AUTHORITY\SYSTEM"))