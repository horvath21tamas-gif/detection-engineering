DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine =~ "(steal_token|impersonate|incognito|make_token|token::elevate|token::revert)" and FolderPath =~ "(\incognito\.exe|\mimikatz\.exe)$") or (ParentProcessName =~ "(powershell\.exe|pwsh\.exe|cmd\.exe|cscript\.exe|wscript\.exe)$" and User =~ "SYSTEM" and LogonId =~ "0x3e7") or (TargetImage =~ "lsass\.exe$" and GrantedAccess =~ "0x1438")) and (not (ParentProcessName =~ "(services\.exe|wininit\.exe|winlogon\.exe|lsass\.exe)$" or FolderPath =~ "\Windows\System32\wbem\WmiPrvSE\.exe" or UserName =~ "NT AUTHORITY\SYSTEM"))