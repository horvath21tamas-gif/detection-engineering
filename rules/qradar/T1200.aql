SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\mshta.exe','%\conhost.exe')) AND "Process "Process CommandLine"" ILIKE '% -w %' AND "Process "Process CommandLine"" ILIKE '% hidden %' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -enc %','% -nop %','% -noni %','% Invoke-Execution %','% .DownloadString%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\explorer.exe','%\taskhostw.exe')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%Netlogon%','%Sysvol%','%HealthCheck%') OR ""Parent Filename"" ILIKE ENUMERATION('%\AppData\Local\Programs\Microsoft VS Code\%','%\Common7\IDE\devenv.exe%'))
