process.command_line:*cpassword* AND ((process.executable:(*\\findstr.exe OR *\\grep.exe OR *\\powershell.exe OR *\\cmd.exe)) OR (process.command_line:(*Get\-GPPPassword* OR *Select\-String* OR *type\ *))) AND (process.command_line:(*SYSVOL* OR *Policies* OR *Groups.xml* OR *ScheduledTasks.xml*)) AND (process.parent.executable:(*\\cmd.exe OR *\\powershell.exe OR *\\wsmprovhost.exe OR *\\psexesvc.exe)) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND (process.executable:(*\\svchost.exe OR *\\taskhostw.exe))))
