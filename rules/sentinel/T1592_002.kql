DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (SrcIp in ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*")) and (Method in ("GET", "HEAD")) and (UriStem in ("*/version*", "*/about*", "*/status*", "*/info*", "*/build*", "*/debug*", "*/admin*", "*/server-info*", "*/actuator*", "*/metrics*")) and (UriQuery in ("*version*", "*build*", "*release*", "*software*", "*application*", "*component*", "*module*", "*plugin*", "*stack*")) and (UserAgent in ("*curl*", "*wget*", "*python*", "*httpclient*", "*go-http-client*", "*libwww*", "*scanner*", "*probe*")) and (Status in (200, 401, 403, 404)) and (not ((UserAgent in ("*Mozilla*", "*Chrome*", "*Safari*", "*Firefox*", "*Edge*")) or (UserAgent in ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nikto*", "*nuclei*", "*zap*", "*zabbix*", "*prometheus*", "*uptime*", "*pingdom*")) or ((UriStem in ("*/api*", "*/health*")) and (UriStem in ("*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.woff", "*.woff2", "*.json")))))