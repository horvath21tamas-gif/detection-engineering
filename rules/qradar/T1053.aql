SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\schtasks.exe','%\at.exe','%\powershell.exe','%\cmd.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%schtasks%','%/create%','%/sc%','%Register-ScheduledTask%','%New-ScheduledTask%','%at %')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\%','%\Users\Public\%','%\ProgramData\%','%\Temp\%','%powershell%','%cmd.exe%','%wscript%','%cscript%','%mshta%','%rundll32%','%.ps1%','%.vbs%','%.js%')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Microsoft\Windows\%','%Windows Defender%','%OneDrive%','%GoogleUpdate%','%Adobe%'))
