DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*/wiki/display/*", "*/wiki/spaces/*", "*/wiki/pages/viewpage*", "*/rest/api/content*", "*/rest/api/content*expand=body*", "*/exportword*", "*/exportpdf*", "*stackoverflow.com/c/*", "*.wiki.git*", "*/_git/*", "*/docs/*", "*/knowledgebase/*", "*/kb/*")) and (FolderPath in ("*\wget.exe", "*\curl.exe", "*\httrack.exe", "*\python.exe", "*\git.exe", "*\powershell.exe", "*\node.exe", "*\pwsh.exe")) and ((ProcessCommandLine in ("* --mirror*", "* --recursive*", "* -r *", "* --level *", "* --convert-links*", "* --page-requisites*", "* --no-parent*", "* --accept pdf*", "* --accept doc*", "* --accept zip*", "* clone *", "* archive *", "* --depth *", "* --bare*")) or ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\services.exe", "*\w3wp.exe")) and (IntegrityLevel in ("Medium", "High"))) or (ProcessCommandLine in ("*.zip*", "*.7z*", "*.tar*", "*.gz*", "* -o *", "* --output *", "* --output-document=*"))) and (not ((FolderPath in ("*C:\Program Files\Elastic\*", "*C:\Program Files\Splunk\*", "*C:\Program Files\Backup*", "*C:\Program Files\Atlassian\*")) or (User in ("NT AUTHORITY\*", "DOMAIN\svc_*", "DOMAIN\backup_*")) or (ProcessCommandLine in ("* --version*", "* healthcheck*", "* status*", "* --help*"))))