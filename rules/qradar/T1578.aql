SELECT Time, user_name, operation_name, request_parameters, user_agent, mfa_authenticated, resource_id, subscription_id, tenant_id, source_ip from events where (("operation_name" LIKE '%DeleteSnapshot%' OR "operation_name" LIKE '%ModifyInstanceAttribute%' OR "operation_name" LIKE '%RevokeSecurityGroupIngress%' OR "operation_name" LIKE '%AuthorizeSecurityGroupIngress%' OR "operation_name" LIKE '%DeleteVpcPeeringConnection%' OR "operation_name" LIKE '%ModifyNetworkAcl%' OR "operation_name" LIKE '%ModifyImageAttribute%' OR "operation_name" LIKE '%CopySnapshot%' OR "operation_name" LIKE '%SetSnapshotPermissions%')) AND (("request_parameters" LIKE '%0.0.0.0/0%' OR "request_parameters" LIKE '%::/0%' OR "request_parameters" LIKE '%all%' OR "request_parameters" LIKE '%public%' OR "request_parameters" LIKE '%grantee%' OR "request_parameters" LIKE '%Add.UserId%') OR "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%curl%' OR "user_agent" LIKE '%postman%' OR "user_agent" LIKE '%boto3%'))) AND NOT (("user_name" LIKE '%svc-terraform%' OR "user_name" LIKE '%svc-ansible%' OR "user_name" LIKE '%svc-packer%' OR "user_name" LIKE '%svc-github-actions%') OR ("user_name" LIKE '%system-internal%' OR "user_name" LIKE '%cloud-controller%' OR "user_name" LIKE '%service-linked-role%'))
