DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*/systemctl", "*/systemd-analyze")) and ((ProcessCommandLine in ("*/tmp/*", "*/var/tmp/*", "*/dev/shm/*", "*/home/*", "*/root/*", "*/dev/tcp/*")) or (ProcessCommandLine in ("*ExecStart=*", "*Restart=always*", "*base64*", "*curl*", "*wget*")) or (ParentProcessName in ("*/bash", "*/sh", "*/zsh", "*/python", "*/apache2", "*/nginx", "*/php"))) and (not ((ParentProcessName in ("*/ansible", "*/salt-minion", "*/puppet", "*/chef-client", "*/dpkg", "*/apt", "*/yum", "*/dnf")) or (User =~ "root" and ProcessCommandLine contains "daemon-reload")))