Image IN ("*\\Snaffler.exe", "*\\SharpShares.exe", "*\\PowerView.ps1", "*\\net.exe", "*\\net1.exe") OR CommandLine IN ("*view*", "*Invoke-ShareFinder*", "*Get-NetShare*", "*Find-DomainShare*") CommandLine IN ("* /domain*", "* /all*", "* -ComputerName*", "*foreach*", "*\\\\*") OR CommandLine IN ("*password*", "*confidential*", "*backup*", "*config*", "*credentials*", "*key*") OR (ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe") IntegrityLevel="Medium") NOT (username="NT AUTHORITY\\SYSTEM" OR Image IN ("*\\Program Files\\Tanium\\*", "*\\Program Files\\Splunk\\*", "*\\Windows\\System32\\CcmExec.exe*") OR CommandLine="*net share*")
