SELECT SrcIp, DestIp, DestPort, Action, Status from events where (("SrcIp" LIKE '%1.%' OR "SrcIp" LIKE '%2.%' OR "SrcIp" LIKE '%3.%' OR "SrcIp" LIKE '%4.%' OR "SrcIp" LIKE '%5.%' OR "SrcIp" LIKE '%6.%' OR "SrcIp" LIKE '%7.%' OR "SrcIp" LIKE '%8.%' OR "SrcIp" LIKE '%9.%')) AND (("Action" LIKE '%deny%' OR "Action" LIKE '%drop%' OR "Action" LIKE '%reset%')) AND "Protocol"='tcp' AND (("Status" LIKE '%400%' OR "Status" LIKE '%401%' OR "Status" LIKE '%403%' OR "Status" LIKE '%404%' OR "Status" LIKE '%408%' OR "Status" LIKE '%444%' OR "Status" LIKE '%499%')) AND NOT (("DestIp" LIKE '%10.%' OR "DestIp" LIKE '%192.168.%' OR "DestIp" LIKE '%172.16.%' OR "DestIp" LIKE '%172.17.%' OR "DestIp" LIKE '%172.18.%' OR "DestIp" LIKE '%172.19.%' OR "DestIp" LIKE '%172.20.%' OR "DestIp" LIKE '%172.21.%' OR "DestIp" LIKE '%172.22.%' OR "DestIp" LIKE '%172.23.%' OR "DestIp" LIKE '%172.24.%' OR "DestIp" LIKE '%172.25.%' OR "DestIp" LIKE '%172.26.%' OR "DestIp" LIKE '%172.27.%' OR "DestIp" LIKE '%172.28.%' OR "DestIp" LIKE '%172.29.%' OR "DestIp" LIKE '%172.30.%' OR "DestIp" LIKE '%172.31.%') OR ("UserAgent" LIKE '%nessus%' OR "UserAgent" LIKE '%qualys%' OR "UserAgent" LIKE '%openvas%' OR "UserAgent" LIKE '%acunetix%' OR "UserAgent" LIKE '%burp%' OR "UserAgent" LIKE '%nikto%' OR "UserAgent" LIKE '%zabbix%' OR "UserAgent" LIKE '%nagios%') OR ("UserAgent" LIKE '%googlebot%' OR "UserAgent" LIKE '%bingbot%' OR "UserAgent" LIKE '%yandex%' OR "UserAgent" LIKE '%ahrefs%' OR "UserAgent" LIKE '%semrush%' OR "UserAgent" LIKE '%uptimerobot%' OR "UserAgent" LIKE '%pingdom%') OR ("SrcIp" LIKE '%34.%' OR "SrcIp" LIKE '%35.%' OR "SrcIp" LIKE '%52.%' OR "SrcIp" LIKE '%54.%'))
