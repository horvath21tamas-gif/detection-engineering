DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*get-signin-token*", "*r=signin*", "*sts get-session-token*", "*gcloud auth print-access-token*", "*okta-auth-token*", "*portal.azure.com*", "*account.google.com/ServiceLogin*", "*login.microsoftonline.com*")) or (((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe")) and (ProcessCommandLine in ("*--incognito*", "*--new-window*", "*--app=*", "*console.aws.amazon.com*", "*portal.azure.com*", "*cloud.google.com*", "*okta.com*"))) and ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\sqlservr.exe", "*\taskhostw.exe", "*\explorer.exe")) and ParentProcessName contains "\AppData\Local\Temp\" and (ParentProcessCommandLine in ("*-NonInteractive*", "*-EncodedCommand*", "*/c powershell*")))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe")) and (ProcessCommandLine in ("*-NonInteractive*", "*-EncodedCommand*", "*/c*")))) and (not ((ProcessCommandLine in ("*sso login*", "*login --use-device-code*", "*az login*", "*aws sso login*")) and (ComputerName in ("*ADMIN-VDI-*", "*DEV-VM-*"))))