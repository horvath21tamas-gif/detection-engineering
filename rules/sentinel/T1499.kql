DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("* /f /im lsass.exe*", "* /f /im csrss.exe*", "* /f /im wininit.exe*", "* /f /im smss.exe*", "* /f /im services.exe*")) or (ProcessCommandLine in ("*while($true)*", "*::MemoryStream*", "*foreach($i in 1..1000000)*", "* -Recursive*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\rundll32.exe", "*\outlook.exe")) or (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\CcmExec.exe", "*\msiexec.exe", "*\TiWorker.exe")) or (ProcessCommandLine in ("*HealthCheck*", "*Diagnostic*"))))