SELECT Time, SourceIP, User, Interface, PolicyID, Message, Port, VIP from events where (("Message" LIKE '%nat (inside%' OR "Message" LIKE '%outside%')%','%static-nat%','%set system bridge%','%add bridge-group%','%port-forwarding%','%virtual-server%','%set nat source%','%set vip%','%set policy route%')) AND (("Message" LIKE '%port 22%' OR "Message" LIKE '%port 3389%' OR "Message" LIKE '%port 445%' OR "Message" LIKE '%port 5985%' OR "Message" LIKE '%port 3306%' OR "Message" LIKE '%port 5432%' OR "Message" LIKE '%port 5900%')) AND (("Message" LIKE '%web-console%' OR "Message" LIKE '%http-admin%' OR "Message" LIKE '%ssh-session%' OR "Message" LIKE '%local-user%' OR "Message" LIKE '%console%' OR "Message" LIKE '%telnet-session%')) AND NOT (("SourceIP" LIKE '%10.50.0.10%' OR "SourceIP" LIKE '%10.50.0.11%' OR "SourceIP" LIKE '%10.50.0.12%') OR ("Message" LIKE '%vpn-pool%' OR "Message" LIKE '%dynamic-pat%' OR "Message" LIKE '%ipsec-nat-t%' OR "Message" LIKE '%ssl-vpn%'))
