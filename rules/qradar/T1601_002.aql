SELECT Time, SourceIP, DestinationIP, Message from events where (("Message" LIKE '%software install%' OR "Message" LIKE '%request system software add%' OR "Message" LIKE '%firmware upgrade%' OR "Message" LIKE '%boot system flash%' OR "Message" LIKE '%install activate%' OR "Message" LIKE '%request platform software%' OR "Message" LIKE '%request system firmware%' OR "Message" LIKE '%request image install%')) AND (("Message" LIKE '%tftp://%' OR "Message" LIKE '%ftp://%' OR "Message" LIKE '%http://%' OR "Message" LIKE '%.bin%' OR "Message" LIKE '%.tar%' OR "Message" LIKE '%.img%') OR ("Message" LIKE '%signature validation failed%' OR "Message" LIKE '%hash mismatch%' OR "Message" LIKE '%invalid image signature%' OR "Message" LIKE '%checksum error%' OR "Message" LIKE '%not a trusted image%' OR "Message" LIKE '%image verification failed%')) AND NOT ((("SourceIP" LIKE '%10.50.0.10%' OR "SourceIP" LIKE '%10.50.0.11%' OR "SourceIP" LIKE '%10.50.0.12%')) AND (("Message" LIKE '%scp://%' OR "Message" LIKE '%sftp://%' OR "Message" LIKE '%https://%' OR "Message" LIKE '%signed image%' OR "Message" LIKE '%trusted repository%')))
