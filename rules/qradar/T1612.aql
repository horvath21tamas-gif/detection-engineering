SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/docker','%/podman','%/buildah','%/kaniko')) AND (""Process CommandLine"" ILIKE ENUMERATION('% build %','% build-using-dockerfile %','% build-image %')) AND (""Parent Filename"" ILIKE ENUMERATION('%/nginx','%/apache2','%/httpd','%/php-fpm','%/python','%/node','%/java','%/redis-server') OR (""Process CommandLine"" ILIKE ENUMERATION('% -f -%','%http://%','%https://%','%--no-cache%','%--privileged%')) AND NOT ((("UserName" LIKE '%jenkins%' OR "UserName" LIKE '%gitlab-runner%' OR "UserName" LIKE '%github-actions%' OR "UserName" LIKE '%root%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/home/jenkins%','%/var/lib/gitlab-runner%'))))
