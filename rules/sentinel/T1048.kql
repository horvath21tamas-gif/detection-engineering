DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\plink.exe", "*\pscp.exe", "*\ncat.exe", "*\nc.exe", "*\socat.exe", "*\iodine.exe", "*\ssh.exe", "*\curl.exe", "*\wget.exe")) and (ProcessCommandLine in ("* -R *", "* -L *", "* -D *", "* -X *", "* -N *", "* -ssh*", "* -proxy*", "* -listen*", "* -connect*"))) or ProcessCommandLine matches regex "(?i).* -l ([5-9][0-9]{2,}|[1-9][0-9]{3,}).*") and (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*", "*\PerfLogs\*")) and IntegrityLevel =~ "Medium" and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*127.0.0.1*", "*localhost*", "*intranet*")) or username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\services.exe", "*\svchost.exe"))))