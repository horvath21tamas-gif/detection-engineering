SELECT UTF8(payload) as search_payload from events where (("URL" LIKE '%<script%' OR "URL" LIKE '%</script%' OR "URL" LIKE '%<svg%' OR "URL" LIKE '%<iframe%' OR "URL" LIKE '%javascript:%' OR "URL" LIKE '%onerror=%' OR "URL" LIKE '%onload=%' OR "URL" LIKE '%3cscript%' OR "URL" LIKE '%3csvg%' OR "URL" LIKE '%3ciframe%' OR "URL" LIKE '%6a%61%76%61%73%63%72%69%70%74%') OR "RequestMethod"='POST' AND (("URL" LIKE '%<script%' OR "URL" LIKE '%javascript:%' OR "URL" LIKE '%onerror=%'))) AND (("sc-status" LIKE '%200%' OR "sc-status" LIKE '%403%' OR "sc-status" LIKE '%500%')) AND NOT (("cs-user-agent" LIKE '%sqlmap%' OR "cs-user-agent" LIKE '%nikto%' OR "cs-user-agent" LIKE '%acunetix%' OR "cs-user-agent" LIKE '%burp%' OR "cs-user-agent" LIKE '%nessus%' OR "cs-user-agent" LIKE '%zap%' OR "cs-user-agent" LIKE '%w3af%') OR ("cs-uri-stem" LIKE '%.js%' OR "cs-uri-stem" LIKE '%.css%' OR "cs-uri-stem" LIKE '%.png%' OR "cs-uri-stem" LIKE '%.jpg%' OR "cs-uri-stem" LIKE '%.gif%' OR "cs-uri-stem" LIKE '%.svg%'))
