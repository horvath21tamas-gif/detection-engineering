Image IN ("*\\aws.exe", "*\\az.exe", "*\\gcloud.exe") OR CommandLine IN ("* create-vpc*", "* create-internet-gateway*", "* create-vpc-peering-connection*", "* network vnet create*", "* compute networks create*") OR (Image IN ("*\\terraform.exe", "*\\pulumi.exe") CommandLine IN ("*aws_vpc*", "*aws_internet_gateway*", "*aws_vpc_peering_connection*", "*azurerm_virtual_network*", "*google_compute_network*")) NOT (User IN ("*svc_terraform_network*", "*adm_netops_deploy*") OR Image IN ("*\\Program Files\\Terraform\\*", "*\\actions-runner\\*")) NOT (ParentImage IN ("*\\code.exe", "*\\devenv.exe", "*\\idea64.exe")) NOT (ParentImage="*\\explorer.exe" condition="not selection_network_ops")
