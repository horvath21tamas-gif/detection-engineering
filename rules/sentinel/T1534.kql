DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ParentProcessName endswith "\outlook.exe" and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\cscript.exe", "*\wscript.exe", "*\rundll32.exe", "*\mshta.exe"))) and ((ProcessCommandLine in ("* /a *", "* /c ipm.note*", "* /m *", "*outlook.application*")) or (ProcessCommandLine in ("*.iso*", "*.vhd*", "*.img*", "*.htm*", "*.html*", "*.lnk*", "*.zip*", "*\*")))) or ((ParentProcessName in ("*\browser.exe", "*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\httpd.exe", "*\php-cgi.exe", "*\explorer.exe /embedding")) and (not ((ProcessCommandLine in ("*C:\Program Files\Microsoft Office*", "*Adobe\Acrobat*", "*Salesforce*", "*Zoom*", "*Teams*")) and User startswith "NT AUTHORITY\" and (FolderPath in ("*\conhost.exe", "*\explorer.exe")))))