DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((((ProcessCommandLine contains "kerberos::golden" and ProcessCommandLine contains "/service:") or (FolderPath endswith "\rubeus.exe" and (ProcessCommandLine contains "silver" and ProcessCommandLine contains "/service:"))) or ((ProcessCommandLine in ("*/service:cifs*", "*/service:http*", "*/service:mssql*", "*/service:ldap*", "*/spn:cifs/*", "*/spn:http/*", "*/spn:mssql*", "*/spn:ldap*")) and (ProcessCommandLine in ("*/rc4:*", "*/aes128:*", "*/aes256:*")) and (ProcessCommandLine in ("*/sid:*", "*S-1-5-21-*")))) and (ProcessCommandLine in ("*/ptt*", "*kerberos::ptt*"))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\wmiprvse.exe", "*\psexesvc.exe", "*\httpd.exe", "*\w3wp.exe", "*\mshta.exe", "*\rundll32.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*"))) and (not (User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe")))) and (not (FolderPath in ("*\Microsoft Monitoring Agent\*", "*\Azure\*", "*\RSAT\*")))