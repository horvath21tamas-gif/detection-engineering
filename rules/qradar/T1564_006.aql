SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\docker.exe','%\dockerd.exe','%\VBoxManage.exe','%\VBoxHeadless.exe','%\vmrun.exe','%\vmware-kvm.exe')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\w3wp.exe','%\php-cgi.exe','%\httpd.exe','%\nginx.exe','%\mshta.exe') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%--rm%','%--privileged%','%--net=host%','%--entrypoint%','%nogui%','%startvm%','% -it %')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\Common7\IDE\devenv.exe%','%\bin\code.exe%','%\Program Files\Docker\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%docker-desktop%','%docker-compose%','%Minikube%')))
