SELECT UTF8(payload) as search_payload from events where ((processname LIKE '%\schtasks.exe' OR processname LIKE '%\at.exe' OR processname LIKE '%\powershell.exe' OR processname LIKE '%\cmd.exe')) AND ((processcommandline LIKE '%schtasks%' OR processcommandline LIKE '%/create%' OR processcommandline LIKE '%/sc%' OR processcommandline LIKE '%Register-ScheduledTask%' OR processcommandline LIKE '%New-ScheduledTask%' OR processcommandline LIKE '%at %')) AND ((processcommandline LIKE '%\AppData\%' OR processcommandline LIKE '%\Users\Public\%' OR processcommandline LIKE '%\ProgramData\%' OR processcommandline LIKE '%\Temp\%' OR processcommandline LIKE '%powershell%' OR processcommandline LIKE '%cmd.exe%' OR processcommandline LIKE '%wscript%' OR processcommandline LIKE '%cscript%' OR processcommandline LIKE '%mshta%' OR processcommandline LIKE '%rundll32%' OR processcommandline LIKE '%.ps1%' OR processcommandline LIKE '%.vbs%' OR processcommandline LIKE '%.js%')) AND NOT ((username LIKE '%SYSTEM%' OR username LIKE '%LOCAL SERVICE%' OR username LIKE '%NETWORK SERVICE%') OR (processcommandline LIKE '%\Microsoft\Windows\%' OR processcommandline LIKE '%Windows Defender%' OR processcommandline LIKE '%OneDrive%' OR processcommandline LIKE '%GoogleUpdate%' OR processcommandline LIKE '%Adobe%'))
