DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath endswith "\netsh.exe" and (ProcessCommandLine in ("*trace start*", "*capture=yes*", "*report=yes*", "*persistent=yes*"))) or (FolderPath endswith "\pktmon.exe" and (ProcessCommandLine in ("*start*", "*capture*", "*--etw*", "*--pkt-size*")))) or (ProcessCommandLine in ("*npcap*", "*winpcap*", "*packet.dll*", "*wpcap.dll*", "*ndiscap.sys*", "*npf.sys*")) or ((FolderPath in ("*\tshark.exe", "*\windump.exe", "*\ettercap.exe", "*\bettercap.exe", "*\dsniff.exe", "*\tcpdump.exe")) and (ProcessCommandLine in ("*-i *", "*--interface*", "*responder*", "*scapy*", "*-w *")))) and (FolderPath in ("*\Users\*", "*\Temp\*", "*\Downloads\*", "*\Public\*", "*\AppData\*")) and IntegrityLevel =~ "Medium" and (not ((FolderPath in ("*\Program Files\Wireshark\*", "*\Program Files\Npcap\*", "*\Program Files\Microsoft Message Analyzer\*")) or (ParentProcessName in ("*\services.exe", "*\svchost.exe")) or username =~ "NT AUTHORITY\SYSTEM"))