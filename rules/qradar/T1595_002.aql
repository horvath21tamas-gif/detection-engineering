SELECT SrcIp, UriStem, UriQuery, Status, UserAgent from events where (("SrcIp" LIKE '%1.%' OR "SrcIp" LIKE '%2.%' OR "SrcIp" LIKE '%3.%' OR "SrcIp" LIKE '%4.%' OR "SrcIp" LIKE '%5.%' OR "SrcIp" LIKE '%6.%' OR "SrcIp" LIKE '%7.%' OR "SrcIp" LIKE '%8.%' OR "SrcIp" LIKE '%9.%')) AND (("Status" LIKE '%400%' OR "Status" LIKE '%401%' OR "Status" LIKE '%403%' OR "Status" LIKE '%404%' OR "Status" LIKE '%405%' OR "Status" LIKE '%500%' OR "Status" LIKE '%502%' OR "Status" LIKE '%503%')) AND (("UserAgent" LIKE '%nuclei%' OR "UserAgent" LIKE '%sqlmap%' OR "UserAgent" LIKE '%nikto%' OR "UserAgent" LIKE '%acunetix%' OR "UserAgent" LIKE '%wpscan%' OR "UserAgent" LIKE '%zgrab%') OR (("UriStem" LIKE '%/.env%' OR "UriStem" LIKE '%/.git%' OR "UriStem" LIKE '%/vendor/phpunit%' OR "UriStem" LIKE '%/phpmyadmin%' OR "UriStem" LIKE '%/cgi-bin%' OR "UriStem" LIKE '%/wp-config%' OR "UriStem" LIKE '%/wp-admin%' OR "UriStem" LIKE '%/actuator%' OR "UriStem" LIKE '%/console%')) AND (("UriQuery" LIKE '%../%' OR "UriQuery" LIKE '%2e%2e%' OR "UriQuery" LIKE '%cmd=%' OR "UriQuery" LIKE '%exec=%' OR "UriQuery" LIKE '%shell%' OR "UriQuery" LIKE '%whoami%' OR "UriQuery" LIKE '%id=%' OR "UriQuery" LIKE '%base64%' OR "UriQuery" LIKE '%payload=%'))) AND NOT (("UserAgent" LIKE '%googlebot%' OR "UserAgent" LIKE '%bingbot%' OR "UserAgent" LIKE '%uptimerobot%' OR "UserAgent" LIKE '%pingdom%' OR "UserAgent" LIKE '%statuscake%' OR "UserAgent" LIKE '%datadog%' OR "UserAgent" LIKE '%newrelic%') OR ("SrcIp" LIKE '%203.0.113.10%' OR "SrcIp" LIKE '%203.0.113.11%'))
