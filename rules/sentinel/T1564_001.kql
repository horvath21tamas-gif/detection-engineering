DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where FolderPath endswith "\attrib.exe" and (ProcessCommandLine contains " +h" and ProcessCommandLine contains " +s") and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\mshta.exe", "*\powershell.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe")) or (ProcessCommandLine in ("*\Users\Public\*", "*\Windows\Temp\*", "*\AppData\Roaming\*", "*\AppData\Local\Temp\*", "*\Downloads\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\Windows\servicing\TrustedInstaller.exe*", "*\CcmExec.exe*", "*\Windows\System32\wbem\WMIC.exe*")) and (ProcessCommandLine in ("*desktop.ini*", "*attrib +h +s system32*", "*Program Files*"))))