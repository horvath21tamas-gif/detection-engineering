DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where TargetFilename endswith ".exe" and (TargetFilename in ("*\ProgramData\*", "*\Users\Public\*", "*\AppData\*", "*\Temp\*")) and (not (TargetFilename in ("*\Windows\*", "*\Program Files\*", "*\Program Files (x86)\*"))) and FolderPath endswith ".exe" and (not (FolderPath in ("*\Windows\System32\*", "*\Windows\SysWOW64\*", "*\Windows\servicing\*", "*\Windows\Installer\*"))) and (EventType in ("FileOverwrite", "FileModify", "Rename"))