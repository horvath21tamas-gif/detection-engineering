((process.command_line:(*proxy\-user\=* OR *proxy\-password\=* OR *http\-proxy\-user\=* OR *https\-proxy\-pass\=* OR *\ \-U\ * OR *\ \-P\ *)) OR ((process.command_line:(*\-\-proxy\-pac\-url\=* OR *\-\-proxy\-server\=http* OR *\ \-setproxy\ * OR *\ \-proxybaseurl\:*)) AND ((process.parent.executable:(*\\cmd.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\cscript.exe OR *\\wscript.exe)) AND (process.executable:(*\\certutil.exe OR *\\bitsadmin.exe OR *\\curl.exe OR *\\rundll32.exe OR *\\regsvr32.exe))))) AND (NOT ((process.executable:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) AND (process.command_line:(*localhost* OR *127.0.0.1* OR *microsoft.com* OR *windowsupdate*)) AND winlog.event_data.username:NT\ AUTHORITY\\SYSTEM))
