(SrcIp:(1.* OR 2.* OR 3.* OR 4.* OR 5.* OR 6.* OR 7.* OR 8.* OR 9.*)) AND (UriStem:(*\/system* OR *\/hardware* OR *\/device* OR *\/diagnostics* OR *\/status* OR *\/mgmt* OR *\/management* OR *\/admin* OR *\/cgi\-bin*)) AND (UriQuery:(*cpu* OR *cores* OR *architecture* OR *arch* OR *model* OR *vendor* OR *manufacturer* OR *serial* OR *board* OR *chip* OR *memory* OR *ram*)) AND (UserAgent:(*curl* OR *wget* OR *python* OR *httpclient* OR *go\-http\-client* OR *libwww* OR *probe*)) AND (NOT ((UserAgent:(*Mozilla* OR *Chrome* OR *Safari* OR *Firefox* OR *Edge*)) OR (UserAgent:(*nessus* OR *qualys* OR *openvas* OR *acunetix* OR *nikto* OR *nuclei* OR *zap* OR *zabbix* OR *uptime* OR *pingdom*)) OR ((UriStem:(*.css OR *.js OR *.png OR *.jpg OR *.svg OR *.ico OR *.woff OR *.woff2 OR *.json)) AND UriStem:*\/api*)))
