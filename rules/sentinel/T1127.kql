| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\msbuild.exe", "*\csc.exe", "*\jsc.exe", "*\vbc.exe")) or (OriginalFileName in ("MSBuild.exe", "csc.exe", "jsc.exe", "vbc.exe"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\wmiprvse.exe", "*\mshta.exe")) or (ProcessCommandLine in ("*http*", "*\*", "*\AppData\*", "*\Temp\*", "*\Users\Public\*"))) and (not ((ParentProcessName in ("*\Microsoft Visual Studio\*", "*\Common7\IDE\*", "*\BuildAgent\*", "*\Jenkins\*")) and (ProcessCommandLine in ("*C:\Program Files (x86)\Microsoft Visual Studio*", "*C:\Windows\Microsoft.NET\Framework*"))))