(Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\mshta.exe", "*\\rundll32.exe") DestinationPort IN (21, 22, 69, 990)) OR CommandLine IN ("* -s:*", "*put *", "*get *", "*.DownloadFile(*", "*Net.FtpWebRequest*") OR (ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe") DestinationPort IN (21, 22, 69, 990)) NOT (Image IN ("*\\Veeam\\*", "*\\WinSCP\\*") DestinationIP IN ("10.0.0.0/8", "192.168.0.0/16", "172.16.0.0/12") username="NT AUTHORITY\\SYSTEM")
