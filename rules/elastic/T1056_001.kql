(((process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\rundll32.exe OR *\\regsvr32.exe OR *\\mshta.exe OR *\\cscript.exe OR *\\wscript.exe)) AND (process.command_line:(*SetWindowsHook* OR *GetAsyncKeyState* OR *GetKeyboardState* OR *user32.dll*))) OR (process.command_line:(*\\AppData\\* OR *\\Temp\\* OR *\\Public\\*))) AND (NOT ((process.executable:(*\\Windows\\System32\\* OR *\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) OR ((process.executable:(*\\AnyDesk.exe OR *\\TeamViewer.exe OR *\\tv_w32.exe OR *\\RemoteDesktopManager.exe)) AND user.name:NT\ AUTHORITY\\*)))
