SELECT UTF8(payload) as search_payload from events where (("Target Object" LIKE '%SYSTEM\\CurrentControlSet\\Services\\TermService\\Parameters\\ServiceDll%' OR "Target Object" LIKE '%SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\Providers\\%')) AND (("Target Details" LIKE '%\\Users\\%' OR "Target Details" LIKE '%\\Temp\\%' OR "Target Details" LIKE '%\\AppData\\%' OR "Target Details" LIKE '%\\ProgramData\\%' OR "Target Details" LIKE '%\\Public\\%' OR "Target Details" LIKE '%\\PerfLogs\\%' OR "Target Details" LIKE '%\\Downloads\\%') OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\reg.exe','%\net.exe','%\python.exe')) AND (""Parent Filename"" ILIKE ENUMERATION('%\explorer.exe','%\wsmprovhost.exe','%\httpd.exe'))) AND NOT ((("Target Details" LIKE '%\\System32\\termsrv.dll%' OR "Target Details" LIKE '%\\System32\\rdpcorets.dll%')) AND (""Filename"" ILIKE ENUMERATION('%\Windows\servicing\TrustedInstaller.exe%','%\Windows\System32\svchost.exe%')))
