SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\7z.exe','%\7za.exe','%\winrar.exe','%\rar.exe','%\tar.exe','%\zip.exe') OR ("ImageName" LIKE '%7z.exe%' OR "ImageName" LIKE '%7za.exe%' OR "ImageName" LIKE '%WinRAR.exe%' OR "ImageName" LIKE '%rar.exe%' OR "ImageName" LIKE '%tar.exe%' OR "ImageName" LIKE '%zip.exe%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% a %','% -cf %','% -czf %','%.zip%','%.rar%','%.7z%','%.tar%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -p%','% -hp%') OR "Process "Process CommandLine"" ILIKE '% -v%' OR "Process "Process CommandLine"" ILIKE '% -sdel%') AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Desktop\%','%\Documents\%','%\Downloads\%','%\AppData\Local\Microsoft\Outlook\%','%C:\inetpub\%','%C:\Users\Public\%','%\ProgramData\%')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Compress-Archive%','%-DestinationPath%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Desktop\%','%\Documents\%','%\Downloads\%','%\AppData\Local\Microsoft\Outlook\%','%C:\inetpub\%','%C:\Users\Public\%','%\ProgramData\%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\mshta.exe','%\w3wp.exe','%\httpd.exe','%\rundll32.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\Veeam\%','%\Veritas\%','%\Commvault\%','%\Backup\%')) AND NOT (""Filename"" ILIKE ENUMERATION('C:\Program Files\Microsoft Monitoring Agent\%','C:\Program Files\Splunk\%','C:\Program Files\Elastic\%'))
