DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (TargetFilename in ("*\Microsoft.PowerShell_profile.ps1", "*\profile.ps1")) and ((FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe")) or (ParentProcessName in ("*\w3wp.exe", "*\sqlservr.exe", "*\nginx.exe", "*\apache.exe"))) and (not ((FolderPath in ("*\notepad.exe", "*\notepad++.exe", "*\code.exe", "*\code - insid.exe", "*\powershell_ise.exe", "*\sublime_text.exe", "*\explorer.exe")) or ((FolderPath in ("*\msiexec.exe", "*\trustedinstaller.exe", "*\choco.exe")) and username =~ "NT AUTHORITY\SYSTEM")))