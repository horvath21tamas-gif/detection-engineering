source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode IN (19, 20, 21) Destination="*CommandLineEventConsumer*" OR Destination="*ActiveScriptEventConsumer*" OR CommandLine IN ("*powershell*", "* -enc *", "* -e *", "*bypass*", "*iex(*", "*WScript.Shell*", "*system.net.webclient*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*") OR Image IN ("*\\powershell.exe", "*\\cmd.exe", "*\\w3wp.exe", "*\\winword.exe", "*\\excel.exe") NOT ((Image IN ("*\\CcmExec.exe", "*\\MonitoringHost.exe", "*\\svchost.exe", "*\\msiexec.exe") username="NT AUTHORITY\\SYSTEM") OR CommandLine IN ("*Inventory*", "*UpdateChecker*", "*HealthCheck*"))
