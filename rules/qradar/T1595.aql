SELECT SrcIp, Method, UriStem, Status, UserAgent from events where (("SrcIp" LIKE '%1.%' OR "SrcIp" LIKE '%2.%' OR "SrcIp" LIKE '%3.%' OR "SrcIp" LIKE '%4.%' OR "SrcIp" LIKE '%5.%' OR "SrcIp" LIKE '%6.%' OR "SrcIp" LIKE '%7.%' OR "SrcIp" LIKE '%8.%' OR "SrcIp" LIKE '%9.%')) AND (("Method" LIKE '%GET%' OR "Method" LIKE '%HEAD%' OR "Method" LIKE '%OPTIONS%')) AND (("UriStem" LIKE '%/admin%' OR "UriStem" LIKE '%/login%' OR "UriStem" LIKE '%/config%' OR "UriStem" LIKE '%/setup%' OR "UriStem" LIKE '%/debug%' OR "UriStem" LIKE '%/test%' OR "UriStem" LIKE '%/backup%' OR "UriStem" LIKE '%/old%' OR "UriStem" LIKE '%/dev%' OR "UriStem" LIKE '%/server-status%' OR "UriStem" LIKE '%/phpinfo%' OR "UriStem" LIKE '%/.git%' OR "UriStem" LIKE '%/.env%' OR "UriStem" LIKE '%/wp-admin%' OR "UriStem" LIKE '%/actuator%')) AND (("UserAgent" LIKE '%curl%' OR "UserAgent" LIKE '%wget%' OR "UserAgent" LIKE '%python%' OR "UserAgent" LIKE '%go-http-client%' OR "UserAgent" LIKE '%libwww%' OR "UserAgent" LIKE '%scanner%' OR "UserAgent" LIKE '%probe%' OR "UserAgent" LIKE '%masscan%' OR "UserAgent" LIKE '%nmap%' OR "UserAgent" LIKE '%zgrab%' OR "UserAgent" LIKE '%httpclient%' OR "UserAgent" LIKE '%axios%' OR "UserAgent" LIKE '%requests%')) AND (("Status" LIKE '%200%' OR "Status" LIKE '%301%' OR "Status" LIKE '%302%' OR "Status" LIKE '%401%' OR "Status" LIKE '%403%' OR "Status" LIKE '%404%')) AND NOT (("UserAgent" LIKE '%Mozilla%' OR "UserAgent" LIKE '%Chrome%' OR "UserAgent" LIKE '%Firefox%' OR "UserAgent" LIKE '%Safari%' OR "UserAgent" LIKE '%Edge%') OR ("UserAgent" LIKE '%nessus%' OR "UserAgent" LIKE '%qualys%' OR "UserAgent" LIKE '%openvas%' OR "UserAgent" LIKE '%acunetix%' OR "UserAgent" LIKE '%nikto%' OR "UserAgent" LIKE '%nuclei%' OR "UserAgent" LIKE '%zabbix%' OR "UserAgent" LIKE '%prometheus%' OR "UserAgent" LIKE '%uptime%' OR "UserAgent" LIKE '%pingdom%' OR "UserAgent" LIKE '%datadog%' OR "UserAgent" LIKE '%newrelic%') OR (("UriStem" LIKE '%/health%' OR "UriStem" LIKE '%/metrics%' OR "UriStem" LIKE '%/status/health%' OR "UriStem" LIKE '%/api%')) AND (("UriStem" LIKE '%.css%' OR "UriStem" LIKE '%.js%' OR "UriStem" LIKE '%.png%' OR "UriStem" LIKE '%.jpg%' OR "UriStem" LIKE '%.svg%' OR "UriStem" LIKE '%.ico%' OR "UriStem" LIKE '%.woff%' OR "UriStem" LIKE '%.woff2%' OR "UriStem" LIKE '%.map%')))
