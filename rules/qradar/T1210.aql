SELECT username, "Filename", "Parent Filename", Process "Process CommandLine", ParentCommandLine, Integrity Level, Process Path, LogonId, File Hash from events where (""Parent Filename"" ILIKE ENUMERATION('%\spoolsv.exe','%\services.exe','%\svchost.exe','%\lsass.exe','%\wmiprvse.exe','%\sqlservr.exe','%\w3wp.exe','%\umworkerprocess.exe','%\winrm.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\mshta.exe','%\rundll32.exe','%\regsvr32.exe','%\certutil.exe','%\bitsadmin.exe','%\scrcons.exe','%\whoami.exe','%\net.exe','%\net1.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -nop%','% -w hidden%','% -enc%','% -encodedcommand%','%bypass%','%iex(%','%Invoke-Expression%','%DownloadString%','%FromBase64String%','%net user /add%','%net localgroup administrators%') OR (""Filename"" ILIKE ENUMERATION('%\AppData\%','%\Temp\%','%\Users\Public\%','%\PerfLogs\%')) AND (("Process Path" LIKE '%\\AppData\\%' OR "Process Path" LIKE '%\\Temp\\%')) OR (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%NETWORK SERVICE%' OR "UserName" LIKE '%LOCAL SERVICE%')) AND (("Integrity Level" LIKE '%High%' OR "Integrity Level" LIKE '%System%'))) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%C:\Windows\System32\wbem\WmiPrvSE.exe%','%C:\Windows\ccmcache\%','%\HealthCheck\%','%sccm%','%pdqdeploy%') OR ("Parent Process CommandLine" LIKE '%winrm%' OR "Parent Process CommandLine" LIKE '%ansible%') OR ""Filename"" ILIKE ENUMERATION('%\Program Files\Microsoft Monitoring Agent\%','%\Program Files\Elastic\%','%\Program Files\Splunk\%'))
