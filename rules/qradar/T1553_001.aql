SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%/spctl' AND (""Process CommandLine"" ILIKE ENUMERATION('%--master-disable%','%label-disable%')) OR ""Filename"" ILIKE '%/xattr' AND (""Process CommandLine"" ILIKE ENUMERATION('%-d com.apple.quarantine%','%-rc com.apple.quarantine%')) AND (""Parent Filename"" ILIKE ENUMERATION('%/sh','%/bash','%/zsh','%/python','%/php')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/tmp/%','%/Users/Shared/%','%/private/var/tmp/%','%/Downloads/%'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('/System/Library/%','/usr/sbin/softwareupdate%','/Applications/Xcode.app/%'))
