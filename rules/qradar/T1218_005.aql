SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\mshta.exe' AND (("Process CommandLine" LIKE '%http://%' OR "Process CommandLine" LIKE '%https://%' OR "Process CommandLine" LIKE '%.hta%' OR "Process CommandLine" LIKE '%javascript:%' OR "Process CommandLine" LIKE '%vbscript:%')) AND (("ParentImage" LIKE '%\\powershell.exe%' OR "ParentImage" LIKE '%\\pwsh.exe%' OR "ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\rundll32.exe%')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\Installer\\%' OR "ParentImage" LIKE '%\\Program Files\\%' OR "ParentImage" LIKE '%\\Program Files (x86%')\%','%\Microsoft Configuration Manager\%','%\Windows\CCM\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Tanium\%'))
