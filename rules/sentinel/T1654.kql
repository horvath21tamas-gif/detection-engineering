DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (["*"] contains "selection_wevtutil_binary and selection_wevtutil_enum" or ["*"] contains "selection_powershell_binary and selection_powershell_enum") and ((ParentProcessName in ("*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\rundll32.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\w3wp.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\ProgramData\*", "*\Windows\Temp\*")) or IntegrityLevel =~ "Medium") and (not (FolderPath in ("*\SplunkUniversalForwarder\*", "*\Elastic\Agent\*", "*\Program Files\Microsoft Monitoring Agent\*", "*\Windows\System32\CcmExec.exe*"))) and (not (User in ("NT AUTHORITY\*", "NT SERVICE\*"))) and (not (ProcessCommandLine in ("*Get-WinEvent -FilterHashtable*", "*-MaxEvents*", "*-ComputerName*")))