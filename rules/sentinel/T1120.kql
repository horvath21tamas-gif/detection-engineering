DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath =~ "(wmic\.exe|pnputil\.exe|driverquery\.exe|devcon\.exe)$" and ProcessCommandLine =~ "(Get-PnpDevice|Get-WmiObject|gwmi)") and (ProcessCommandLine =~ "(Win32_USBController|Win32_DiskDrive|Win32_NetworkAdapter|USBSTOR|/enum-devices|/deviceid)" or ProcessCommandLine =~ "(>\s|ConvertTo-Json|format-list)" or (ParentProcessName =~ "(cmd\.exe|powershell\.exe|wsmprovhost\.exe|httpd\.exe|winword\.exe)$" and IntegrityLevel =~ "Medium")) and (not (username =~ "NT AUTHORITY\SYSTEM" and ParentProcessName =~ "(svchost\.exe|msiexec\.exe)$" and ProcessCommandLine contains "Program Files"))