SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\svchost.exe','%\rundll32.exe','%\regsvr32.exe','%\msiexec.exe','%\cmd.exe')) AND (("LoadedImage" LIKE '%\\Users\\Public\\%' OR "LoadedImage" LIKE '%\\AppData\\Local\\Temp\\%' OR "LoadedImage" LIKE '%\\Downloads\\%' OR "LoadedImage" LIKE '%C:\\ProgramData\\%' OR "LoadedImage" LIKE '%\\Desktop\\%')) AND NOT (("LoadedImage" LIKE '%\\Microsoft\\Teams\\%' OR "LoadedImage" LIKE '%\\AppData\\Local\\Discord\\%' OR "LoadedImage" LIKE '%\\Microsoft\\OneDrive\\%') OR ""Filename"" ILIKE ENUMERATION('%C:\Windows\System32\%','%C:\Program Files\%','%C:\Program Files (x86)\%'))
