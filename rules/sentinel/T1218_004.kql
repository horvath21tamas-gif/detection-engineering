DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\InstallUtil.exe" and OriginalFileName =~ "InstallUtil.exe") and (IntegrityLevel in ("Low", "Medium")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*")) or ((ProcessCommandLine in ("* /u *", "* /uninstall *", "* /LogToConsole=false*", "* /logfile=*")) and ((ProcessCommandLine in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*", "*\Downloads\*", "*\PerfLogs\*")) or (ProcessCommandLine in ("*http://*", "*https://*", "*\\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe"))))) and (not ((FolderPath in ("C:\Windows\Microsoft.NET\Framework\*", "C:\Windows\Microsoft.NET\Framework64\*")) and ((ParentProcessName in ("*\msiexec.exe", "*\trustedinstaller.exe")) and IntegrityLevel =~ "High"))) and (not User startswith "NT AUTHORITY\")