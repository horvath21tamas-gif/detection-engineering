DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (Message in ("*software install*", "*request system software add*", "*firmware upgrade*", "*boot system flash*", "*install activate*", "*request platform software*")) and ((Message in ("*tftp://*", "*http://*", "*ftp://*", "*.bin*", "*.tar*")) or (Message in ("*signature validation failed*", "*hash mismatch*", "*invalid image signature*", "*checksum error*", "*not a trusted image*"))) and (not ((SourceIP in ("10.50.0.10", "10.50.0.11")) or (Message in ("*scp://*", "*https://*", "*sftp://*"))))