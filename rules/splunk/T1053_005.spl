Image="*\\schtasks.exe" CommandLine="*/create*" CommandLine IN ("*powershell*", "*pwsh*") CommandLine IN ("*-enc*", "*-encodedcommand*", "*-nop*", "*-w hidden*", "*-executionpolicy bypass*") OR CommandLine IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\WINWORD.EXE", "*\\EXCEL.EXE") NOT (User IN ("*NT AUTHORITY\\SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*") OR ParentImage IN ("*\\Windows\\CCM\\*", "*\\Microsoft Configuration Manager\\*", "*\\SCCM\\*", "*\\Tanium\\*", "*\\PDQ\\*", "*\\Ivanti\\*", "*\\ManageEngine\\*", "*\\Veeam\\*", "*\\Acronis\\*", "*\\Backup\\*"))
