DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and ProcessCommandLine contains "Set-PSReadLineOption") and (ProcessCommandLine in ("*$false*", "*$null*", "*\"\"*", "*/dev/null*"))) or (((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*-enc *", "*-EncodedCommand*"))) and (ProcessCommandLine in ("*PSReadLine*", "*ConsoleHost_history*", "*HistorySavePath*", "*SaveNothing*"))) or (FolderPath endswith "\reg.exe" and (ProcessCommandLine contains " add " and ProcessCommandLine contains "HKCU\Software\Microsoft\Windows\CurrentVersion\Console" and ProcessCommandLine contains "HistoryBufferSize") and (ProcessCommandLine in ("* 0*", "*/d 0*"))) or (ProcessCommandLine in ("*\ConsoleHost_history.txt*", "*\PSReadLine\*", "*\.bash_history*"))) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe", "*\mshta.exe", "*\rundll32.exe")) and (not (ParentProcessName in ("*\Common7\IDE\devenv.exe*", "*\Microsoft VS Code\Code.exe*", "*\JetBrains\*"))) and (not (User startswith "NT AUTHORITY" and ParentProcessName endswith "\services.exe")) and (not (ProcessCommandLine in ("*Chocolatey*", "*SCCM*", "*Intune*", "*AppData\Local\Temp\SDI*")))