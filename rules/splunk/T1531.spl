Image IN ("*\\net.exe", "*\\net1.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe") CommandLine IN ("* user *", "*Remove-LocalUser*", "*Remove-ADUser*", "*Disable-LocalUser*", "*Disable-ADAccount*", "*Set-LocalUser -AccountExpires*") CommandLine IN ("* /delete*", "* /active:no*", "* /logoff*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\explorer.exe") NOT (CommandLine IN ("*Add-LocalUser*", "* /add*") OR ParentImage="*\\msiexec.exe" OR username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*WDAGUtilityAccount*", "*DefaultAccount*"))
