Image IN ("*/az", "*/aws", "*/gcloud", "*/kubectl") CommandLine IN ("*list-access-keys*", "*export-credentials*", "*get-secret*") OR CommandLine IN ("*stop-logging*", "*delete-trail*", "*disable-policy*", "*delete-flow-log*") OR CommandLine IN ("*make-public*", "*add-iam-policy-binding*", "*modify-instance-attribute --attribute disableApiTermination*", "*create-presigned-url*") NOT (username IN ("deployment-service-account", "terraform-runner") OR CommandLine IN ("*--describe*", "*--list*"))
