CommandLine IN ("* -Recurse *", "* /s *", "* -Include *.*", "* -Filter *.*", "*copy *.*") CommandLine IN ("*.doc*", "*.pdf*", "*.xls*", "*.pst*", "*.key*", "*.msg*", "*.pfx*", "*.rdp*") CommandLine IN ("*\\Users\\Public*", "*\\Windows\\Temp*", "*\\AppData\\Local\\Temp*", "*C:\\ProgramData*") ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\powershell.exe", "*\\cmd.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\Microsoft Monitoring Agent\\*", "*C:\\Windows\\CCM\\*", "*\\OneDrive.exe*") OR CommandLine IN ("* -Filter *.log*", "*HealthCheck*") OR username="NT AUTHORITY\\SYSTEM")
