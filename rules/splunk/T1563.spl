Image="*\\tscon.exe" OriginalFileName="tscon.exe" CommandLine IN ("* /dest:*", "* /password*", "*dest:console*", "*rdp-tcp#*", "* /shadow*", "* /control*") OR (ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\psexesvc.exe", "*\\wsmprovhost.exe", "*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\w3wp.exe") IntegrityLevel="System") NOT (ParentImage IN ("*\\svchost.exe", "*\\rdpinit.exe", "*\\winlogon.exe", "*\\termsrv.dll") CommandLine IN ("*Citrix*", "*VMware*", "*vmsvga*", "*C:\\Program Files\\*") username IN ("NT AUTHORITY\\SYSTEM", "NT AUTHORITY\\NETWORK SERVICE")) | table Time,Image,ParentImage,CommandLine,User,IntegrityLevel,LogonId
