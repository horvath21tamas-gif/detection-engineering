Image IN ("*\\docker.exe", "*\\dockerd.exe", "*\\VBoxManage.exe", "*\\VBoxHeadless.exe", "*\\vmrun.exe", "*\\vmware-kvm.exe") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe", "*\\php-cgi.exe", "*\\httpd.exe", "*\\nginx.exe", "*\\mshta.exe") OR (CommandLine IN ("*--rm*", "*--privileged*", "*--net=host*", "*--entrypoint*", "*nogui*", "*startvm*", "* -it *") NOT (ParentImage IN ("*\\Common7\\IDE\\devenv.exe*", "*\\bin\\code.exe*", "*\\Program Files\\Docker\\*") OR CommandLine IN ("*docker-desktop*", "*docker-compose*", "*Minikube*")))
