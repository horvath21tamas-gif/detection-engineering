DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*cpassword*", "*password=*", "*pwd=*", "*userPassword*", "*SecureString*", "*ConvertTo-SecureString*", "*Get-GPPPassword*", "*unattend.xml*", "*sysprep.xml*", "*web.config*", "*Groups.xml*", "*ScheduledTasks.xml*", "*Services.xml*")) and (ProcessCommandLine in ("*\SYSVOL\*", "*\Policies\*", "*\Windows\Panther\*", "*\Windows\System32\sysprep\*", "*\inetpub\wwwroot\*", "*\ProgramData\*", "*\Users\*")) and (((FolderPath in ("*\findstr.exe", "*\find.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\grep.exe")) and (ProcessCommandLine in ("*Select-String*", "*Get-ChildItem*", "*dir *", "*type *", "*gc *"))) or (ProcessCommandLine in ("*-enc*", "*-EncodedCommand*", "*IEX*", "*Invoke-Expression*", "*DownloadString*")) or (ParentProcessName in ("*\wsmprovhost.exe", "*\psexesvc.exe", "*\wmiprvse.exe"))) and (not (User in ("*NT AUTHORITY\SYSTEM*", "*NT AUTHORITY\LOCAL SERVICE*", "*NT AUTHORITY\NETWORK SERVICE*"))) and (not ((FolderPath in ("*\svchost.exe", "*\taskhostw.exe", "*\gpscript.exe")) and User startswith "NT AUTHORITY\SYSTEM"))