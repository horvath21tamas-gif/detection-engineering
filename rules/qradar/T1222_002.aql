SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/chmod','%/chown','%/chattr')) AND ((""Process CommandLine"" ILIKE ENUMERATION('%+s%','%u+s%','%+i%','%+a%','%777%','%666%','% +x %')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/tmp/%','%/dev/shm/%','%/var/tmp/%')) OR ""Process CommandLine"" ILIKE ENUMERATION('%/etc/shadow%','%/etc/sudoers%','%/etc/passwd%','%/root/.ssh%','%/var/spool/cron%','%/etc/crontab%','%/bin/sh%','%/bin/bash%') OR ("UserName" LIKE '%www-data%' OR "UserName" LIKE '%apache%' OR "UserName" LIKE '%nginx%' OR "UserName" LIKE '%nobody%' OR "UserName" LIKE '%mysql%' OR "UserName" LIKE '%postgres%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/bin/apt','%/bin/dpkg','%/bin/yum','%/bin/dnf','%/bin/rpm','%/sbin/cloud-init') OR ""Process CommandLine"" ILIKE ENUMERATION('% --help%','% --version%'))
