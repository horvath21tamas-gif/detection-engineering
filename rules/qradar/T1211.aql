SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\firefox.exe','%\msedge.exe','%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\AcroRd32.exe','%\Acrobat.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\schtasks.exe','%\reg.exe','%\whoami.exe','%\net.exe','%\net1.exe')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%--type=renderer%','%--type=utility%','%--type=gpu-process%','%--type=extension%','%Microsoft\EdgeUpdate%') OR ""Filename"" ILIKE ENUMERATION('%\Windows\System32\WerFault.exe%','%\Windows\System32\conhost.exe%') OR "ParentCommandLine" ILIKE '%TrustedInstaller.exe%') OR (""Parent Filename"" ILIKE ENUMERATION('%\chrome.exe','%\firefox.exe','%\msedge.exe','%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\AcroRd32.exe','%\Acrobat.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-encodedcommand%','%bypass%','%hidden%','%http%'))
