DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Downloads\*", "*\Desktop\*", "*\PerfLogs\*")) and (ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe"))) and ((FolderPath endswith "\certutil.exe" and (ProcessCommandLine in ("*Root*", "*AuthRoot*", "*TrustedPublisher*"))) or (ProcessCommandLine in ("*State*", "*0x00023e00*", "*LowRiskFileTypes*"))) and (not (((ParentProcessName in ("*\msiexec.exe", "*\TrustedInstaller.exe", "*\CcmExec.exe", "*\gpscript.exe")) and username =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*"))))