((process.executable.caseless:(*\\ssh.exe OR *\\sshd.exe)) OR (process.pe.original_file_name:(ssh.exe OR sshd.exe))) AND ((process.command_line:(*\ \-L\ * OR *\ \-R\ * OR *\ \-D\ * OR *\ \-N* OR *\ \-f*)) OR ((process.parent.executable.caseless:(*\\cmd.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\httpd.exe OR *\\winword.exe)) AND (process.command_line:(*StrictHostKeyChecking\=no* OR *UserKnownHostsFile\=\/dev\/null*))) OR (process.parent.executable.caseless:*\\sshd.exe AND (process.command_line:(*\ \-enc\ * OR *\ \-w\ hidden* OR *IEX* OR *DownloadString*)))) AND (NOT ((process.parent.executable.caseless:(*\\Git\\* OR *\\VSCode\\* OR *\\JetBrains\\*)) OR (process.command_line:(*git\-upload\-pack* OR *git\-receive\-pack* OR *vscode\-remote*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM"))
