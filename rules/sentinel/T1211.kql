DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ParentProcessName in ("*\chrome.exe", "*\firefox.exe", "*\msedge.exe", "*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\AcroRd32.exe", "*\Acrobat.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\schtasks.exe", "*\reg.exe", "*\whoami.exe", "*\net.exe", "*\net1.exe")) and (not ((ProcessCommandLine in ("*--type=renderer*", "*--type=utility*", "*--type=gpu-process*", "*--type=extension*", "*Microsoft\EdgeUpdate*")) or (FolderPath in ("*\Windows\System32\WerFault.exe*", "*\Windows\System32\conhost.exe*")) or ParentProcessCommandLine contains "TrustedInstaller.exe"))) or ((ParentProcessName in ("*\chrome.exe", "*\firefox.exe", "*\msedge.exe", "*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\AcroRd32.exe", "*\Acrobat.exe")) and (ProcessCommandLine in ("*-enc*", "*-encodedcommand*", "*bypass*", "*hidden*", "*http*")))