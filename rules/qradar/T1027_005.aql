SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%sigthief%','%copy-signature%','%osslsigncode%','%deltasig%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%petools %','%sethc.exe%','%strings -d%','%strip -s%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\Public\%','%\AppData\Local\Temp\%','%\Windows\Temp\%','%\PerfLogs\%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Microsoft SDKs\%','%\Windows Kits\%','%\Visual Studio\%')) AND "Process "Process CommandLine"" ILIKE '%signtool.exe sign%' OR ("UserName" LIKE '%svc-build%' OR "UserName" LIKE '%cicd%'))
