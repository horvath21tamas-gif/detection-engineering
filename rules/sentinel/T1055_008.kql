DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (type =~ "SYSCALL" and syscall =~ "ptrace" and (a0 in ("*0x4*", "*0x5*", "*0x10*"))) and ((exe in ("*/bin/python*", "*/bin/php*", "*/bin/perl*", "*/bin/node*", "*/usr/sbin/nginx*", "*/usr/sbin/apache*", "*/usr/bin/socat*", "*/usr/bin/nc*")) or (not ((exe in ("*/usr/bin/gdb*", "*/usr/bin/strace*", "*/usr/bin/ltrace*", "*/usr/bin/auditd*", "*/opt/datadog/agent*")) and auid =~ "4294967295")))