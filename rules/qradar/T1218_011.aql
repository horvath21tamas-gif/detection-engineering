SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\rundll32.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%javascript:%','%RunHTMLApplication%','%mshtml,%','%http://%','%https://%','%scrobj.dll%','%shell32.dll,ShellExec_RunDLL%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Downloads\%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Windows\System32\%','%\Windows\SysWOW64\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\Installer\%','%\Program Files\%','%\Program Files (x86)\%','%\DriverStore\%','%\Dell\%','%\HP\%','%\Lenovo\%','%\Intel\%'))
