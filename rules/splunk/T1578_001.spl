operation_name IN ("*RunInstances*", "*Microsoft.Compute/virtualMachines/write*", "*v1.compute.instances.insert*") request_parameters IN ("*p3.*", "*p4.*", "*g4.*", "*c5.24xlarge*", "*Standard_ND*", "*Standard_NC*", "*n1-highcpu-*") OR (mfa_authenticated="false" user_agent IN ("*kali*", "*python-requests*", "*boto3*", "*postman*")) NOT (user_name IN ("svc-terraform*", "svc-github-actions*", "aws-autoscaling*") OR user_name="*system-internal*")
