Image IN ("*\\dd.exe", "*\\sdelete.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe") CommandLine IN ("*\\.\\PhysicalDrive*", "*\\.\\Harddisk*", "*if=/dev/zero*", "*if=/dev/urandom*", "*of=\\.\\*", "* -z *", "* -p *", "*Clear-Disk*", "*Initialize-Disk*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\explorer.exe") OR Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\msiexec.exe", "*\\CcmExec.exe", "*\\setup.exe") OR CommandLine IN ("*Program Files*", "*vds.exe*"))
