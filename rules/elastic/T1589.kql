(SrcIp:(1.* OR 2.* OR 3.* OR 4.* OR 5.* OR 6.* OR 7.* OR 8.* OR 9.*)) AND (UriStem:(*\/login* OR *\/signin* OR *\/auth* OR *\/account* OR *\/user* OR *\/users* OR *\/password* OR *\/forgot* OR *\/reset*)) AND (UriQuery:(*user\=* OR *username\=* OR *email\=* OR *login\=* OR *account\=* OR *upn\=* OR *principal\=*)) AND (Method:(GET OR POST)) AND (UserAgent:(*curl* OR *wget* OR *python* OR *go\-http\-client* OR *httpclient* OR *axios* OR *requests* OR *scanner* OR *probe*)) AND (Status:(401 OR 403 OR 404)) AND (NOT ((UserAgent:(*Mozilla* OR *Chrome* OR *Firefox* OR *Safari* OR *Edge*)) OR (UriStem:(*\/sso* OR *\/oauth* OR *\/openid* OR *\/saml* OR *\/idp* OR *\/federation*)) OR (UserAgent:(*nessus* OR *qualys* OR *openvas* OR *acunetix* OR *nuclei* OR *zabbix* OR *prometheus* OR *uptime* OR *pingdom* OR *datadog* OR *newrelic*)) OR (UriStem:(*.css OR *.js OR *.png OR *.jpg OR *.svg OR *.ico OR *.woff OR *.woff2))))
