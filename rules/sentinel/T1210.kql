DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ParentProcessName in ("*\spoolsv.exe", "*\services.exe", "*\svchost.exe", "*\lsass.exe", "*\wmiprvse.exe", "*\sqlservr.exe", "*\w3wp.exe", "*\umworkerprocess.exe", "*\winrm.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\mshta.exe", "*\rundll32.exe", "*\regsvr32.exe", "*\certutil.exe", "*\bitsadmin.exe", "*\scrcons.exe", "*\whoami.exe", "*\net.exe", "*\net1.exe")) and ((ProcessCommandLine in ("* -nop*", "* -w hidden*", "* -enc*", "* -encodedcommand*", "*bypass*", "*iex(*", "*Invoke-Expression*", "*DownloadString*", "*FromBase64String*", "*net user /add*", "*net localgroup administrators*")) or ((FolderPath in ("*\AppData\*", "*\Temp\*", "*\Users\Public\*", "*\PerfLogs\*")) and (CurrentDirectory in ("*\AppData\*", "*\Temp\*"))) or ((User in ("*SYSTEM*", "*NETWORK SERVICE*", "*LOCAL SERVICE*")) and (IntegrityLevel in ("High", "System")))) and (not ((ProcessCommandLine in ("*C:\Windows\System32\wbem\WmiPrvSE.exe*", "*C:\Windows\ccmcache\*", "*\HealthCheck\*", "*sccm*", "*pdqdeploy*")) or (ParentProcessCommandLine in ("*winrm*", "*ansible*")) or (FolderPath in ("*\Program Files\Microsoft Monitoring Agent\*", "*\Program Files\Elastic\*", "*\Program Files\Splunk\*"))))