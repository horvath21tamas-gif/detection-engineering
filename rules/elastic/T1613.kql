(Image:(*\/kubectl OR *\/k3s OR *\/docker OR *\/crictl OR *\/nerdctl OR *\/oc)) AND (CommandLine:(*auth\ can\-i* OR *get\ secrets* OR *describe\ pod* OR *describe\ deployment* OR *get\ nodes* OR *get\ svc* OR *get\ configmaps* OR *inspect* OR *logs* OR *exec*)) AND (((ParentImage:(*\/www\-data* OR *\/nginx* OR *\/httpd* OR *\/php\-fpm* OR *\/python* OR *\/node*)) AND (username:(root OR www\-data OR nginx))) OR (CommandLine:(*\-\-format\ json* OR *\-o\ json* OR *\ \|\ jq* OR *\ \>\ * OR *\-\-all\-namespaces*))) AND (NOT ((Image:(*\/usr\/bin\/kubelet* OR *\/datadog\-agent* OR *\/prometheus* OR *\/telegraf* OR *\/rancher*)) AND (CommandLine:(*get\ pods\ \-\-watch* OR *\-\-version* OR *metrics\-server*))))
