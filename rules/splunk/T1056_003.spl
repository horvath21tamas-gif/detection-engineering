(Image="*\\certutil.exe" CommandLine IN ("*-exportPFX*", "*-user -export*", "*-p *")) OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*Export-PfxCertificate*", "*Export-Certificate*", "* -Password*")) OR CommandLine IN ("*crypto::certificates*", "*crypto::keys*", "*patch*", "*certificates /pvk*") OR CommandLine IN ("*copy *", "*move *", "*type *") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") NOT (Image IN ("*\\Windows\\System32\\certsrv.exe*", "*\\Windows\\System32\\certmgr.dll*") OR ParentImage IN ("*\\services.exe", "*\\svchost.exe") OR User="NT AUTHORITY\\*")
