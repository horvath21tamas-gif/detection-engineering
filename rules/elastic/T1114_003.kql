(process.command_line:(*New\-InboxRule* OR *Set\-InboxRule* OR *New\-TransportRule* OR *Set\-Mailbox*)) AND ((process.command_line:(*\-ForwardTo* OR *\-ForwardAsAttachmentTo* OR *\-RedirectTo* OR *\-ForwardingSmtpAddress*)) AND (process.command_line:(*@gmail.com* OR *@outlook.com* OR *@protonmail.* OR *@tutanota.* OR *.ru* OR *.top* OR *.zip*))) AND ((process.command_line:(*password* OR *invoice* OR *számla* OR *transfer* OR *bank* OR *confidential*)) OR ((process.parent.executable.caseless:(*\\powershell.exe OR *\\w3wp.exe OR *\\cmd.exe)) AND winlog.event_data.IntegrityLevel:Medium)) AND (NOT ((process.command_line:(*@sajatdomain.hu* OR *HealthCheck*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM" OR process.command_line:*Standard_Admin_Script.ps1*))
