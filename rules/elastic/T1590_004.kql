(((process.executable:*\\openssl.exe AND (process.command_line:(*\ s_client* OR *\ x509* OR *\ \-text*))) OR (process.executable:*\\certutil.exe AND (process.command_line:(*\ \-dump* OR *\ \-viewstore* OR *\ \-user*))) OR (process.executable:*\\powershell.exe AND process.command_line:*Get\-ChildItem\ \-Path\ Cert\:*)) OR (process.command_line:(*.pfx* OR *.p12* OR *.pem* OR *exportable*))) AND (NOT (process.command_line:(*\ \-verify* OR *\ \-v\ * OR *\ \-silent*))) AND (NOT (process.parent.executable:(*\\services.exe OR *\\svchost.exe OR *\\CcmExec.exe OR *\\TrustedInstaller.exe))) AND (NOT (process.command_line:(*localhost* OR *dev.local*)))
