GrantedAccess IN ("*0x1410*", "*0x1411*", "*0x1438*", "*0x143a*", "*0x1F1FFF*") CallTrace="*unknown*" TargetImage IN ("*\\lsass.exe", "*\\svchost.exe", "*\\explorer.exe", "*\\winlogon.exe", "*\\spoolsv.exe") SourceImage IN ("*\\Users\\*", "*\\Temp\\*", "*\\AppData\\*") NOT (SourceProcessName="C:\\Windows\\System32\\csrss.exe" OR SourceImage IN ("*\\MsMpEng.exe", "*\\CcmExec.exe") OR CallTrace IN ("*clr.dll+*", "*wer.dll+*", "*ntdll.dll+LdrpWorkItem*") OR condition="SourceProcessName == TargetImage")
