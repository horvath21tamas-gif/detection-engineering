SELECT UTF8(payload) as search_payload from events where (("operationName" LIKE '%Update application – Certificates and secrets management %' OR "operationName" LIKE '%Add service principal credentials%')) AND "result"='success' AND NOT (("initiatedBy.app.displayName" LIKE '%Microsoft App-Registration-Service%' OR "initiatedBy.app.displayName" LIKE '%Azure Resource Manager%') OR ("initiatedBy.user.userPrincipalName" LIKE '%svc-terraform%' OR "initiatedBy.user.userPrincipalName" LIKE '%github-actions%' OR "initiatedBy.user.userPrincipalName" LIKE '%devops-pipeline%') OR ("targetResources.displayName" LIKE '%Office 365%' OR "targetResources.displayName" LIKE '%Microsoft Teams%' OR "targetResources.displayName" LIKE '%Azure Monitor%'))
