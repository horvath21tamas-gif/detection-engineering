Image IN ("*\\curl.exe", "*\\wget.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\python.exe") CommandLine IN ("*api-ssl.bitly.com*", "*api.tinyurl.com*", "*api.rebrandly.com*", "*api.shorte.st*", "*cutt.ly/api*") CommandLine IN ("*.exe*", "*.zip*", "*.iso*", "*.vhd*", "*.msi*", "*.js*") NOT (UserName IN ("*svc_marketing*", "*svc_social*", "*svc_devops*", "*admin_automated*") OR ParentImage IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe") OR Image IN ("*\\AppData\\Local\\slack\\*", "*\\AppData\\Local\\Microsoft\\Teams\\*"))
