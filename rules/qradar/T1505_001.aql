SELECT UTF8(payload) as search_payload from events where ""Parent Filename"" ILIKE '%\sqlservr.exe' AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\bitsadmin.exe','%\certutil.exe','%\net.exe','%\net1.exe','%\whoami.exe','%\systeminfo.exe','%\nltest.exe','%\scrcons.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%sp_configure%','%xp_cmdshell%','%RECONFIGURE%','%show advanced options%','%Ole Automation Procedures%')) AND NOT (""Parent Filename"" ILIKE '%\sqlagent.exe' OR ""Filename"" ILIKE '%\Microsoft SQL Server\...\Setup\%' AND "Process "Process CommandLine"" ILIKE '%sqlagent.exe -i%')
