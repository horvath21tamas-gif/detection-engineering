DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (TargetFilename in ("*\AppData\Roaming\Microsoft\Word\STARTUP\*", "*\AppData\Roaming\Microsoft\Excel\XLSTART\*", "*\AppData\Local\Microsoft\Office\AddIns\*")) and (TargetFilename in ("*.wll", "*.xll")) and (FolderPath in ("*\powershell.exe", "*\cmd.exe", "*\browser.exe", "*\outlook.exe")) and (not ((TargetFilename in ("*\Adobe\*", "*\Webex\*")) and (FolderPath in ("*C:\Program Files\*", "*C:\Program Files (x86)\*"))))