SELECT UTF8(payload) as search_payload from events where (("Integrity Level" LIKE '%System%' OR "Integrity Level" LIKE '%High%')) AND "username" ILIKE '%NT AUTHORITY\SYSTEM%' AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\Downloads\%','%\AppData\Local\Temp\%','%\Windows\Temp\%','%\PerfLogs\%','%\ProgramData\%')) AND (""Filename"" ILIKE ENUMERATION('%\setup.exe','%\install.exe','%\update.exe','%\msiexec.exe','%\cmd.exe','%\powershell.exe')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\CcmExec.exe','%\TaniumClient.exe','%\MonitoringHost.exe','%\ManagementAgent.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Windows\ccmcache\%','%\Windows\SoftwareDistribution\%','%\Windows\System32\DriverStore\%')) OR ""Filename"" ILIKE ENUMERATION('%\Google\Update\%','%\Microsoft\EdgeUpdate\%'))
