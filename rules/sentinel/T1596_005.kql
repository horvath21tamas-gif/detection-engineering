DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\shodan.exe", "*\censys.exe", "*\greynoise.exe", "*\zoomeye.exe")) or (ProcessCommandLine in ("* host *", "* stats *", "* facets *", "* ip.addr:*"))) or ((FolderPath in ("*\curl.exe", "*\wget.exe", "*\python.exe", "*\pwsh.exe")) or (ProcessCommandLine in ("*api.shodan.io/shodan/host/*", "*api.greynoise.io/v2/hosts/*", "*api.censys.io/v2/hosts*", "*api.zoomeye.org/host/*", "*viz.greynoise.io*")))) and (not ((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe")) or ParentProcessName endswith "\explorer.exe")) and (not ((ProcessCommandLine in ("*ping *", "*tracert *", "*nslookup *", "*netstat *")) or condition =~ "not selection_specialized_tools")) and (not (username =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\SentinelOne\*", "*\CrowdStrike\*", "*\Microsoft Security Client\*", "*\Cylance\*"))))