DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((((FolderPath in ("*\7z.exe", "*\7za.exe", "*\winrar.exe", "*\rar.exe", "*\tar.exe", "*\zip.exe")) or (OriginalFileName in ("7z.exe", "7za.exe", "WinRAR.exe", "rar.exe", "tar.exe", "zip.exe"))) and (ProcessCommandLine in ("* a *", "* -cf *", "* -czf *", "*.zip*", "*.rar*", "*.7z*", "*.tar*")) and ((ProcessCommandLine in ("* -p*", "* -hp*")) or ProcessCommandLine contains " -v" or ProcessCommandLine contains " -sdel") and (ProcessCommandLine in ("*\Desktop\*", "*\Documents\*", "*\Downloads\*", "*\AppData\Local\Microsoft\Outlook\*", "*C:\inetpub\*", "*C:\Users\Public\*", "*\ProgramData\*"))) or (((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Compress-Archive*", "*-DestinationPath*"))) and (ProcessCommandLine in ("*\Desktop\*", "*\Documents\*", "*\Downloads\*", "*\AppData\Local\Microsoft\Outlook\*", "*C:\inetpub\*", "*C:\Users\Public\*", "*\ProgramData\*")))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\mshta.exe", "*\w3wp.exe", "*\httpd.exe", "*\rundll32.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*"))) and (not (User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe")))) and (not (ParentProcessName in ("*\Veeam\*", "*\Veritas\*", "*\Commvault\*", "*\Backup\*"))) and (not (FolderPath in ("C:\Program Files\Microsoft Monitoring Agent\*", "C:\Program Files\Splunk\*", "C:\Program Files\Elastic\*")))