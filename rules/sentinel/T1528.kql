DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*\.azure\accessTokens.json*", "*\.azure\azureProfile.json*", "*\.aws\credentials*", "*\.aws\config*", "*\.config\gcloud\*")) or (ProcessCommandLine in ("*\User Data\Local State*", "*\User Data\Default\Cookies*", "*\User Data\Default\Network\Cookies*", "*\User Data\Default\Login Data*")) or ((FolderPath in ("*\curl.exe", "*\powershell.exe", "*\pwsh.exe", "*\certutil.exe", "*\sqlite3.exe", "*\python.exe")) and (ProcessCommandLine in ("*roadtools*", "*extract-token*", "*cookie-stealer*", "*copy-item*", "*Invoke-WebRequest*", "*Base64*")))) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\explorer.exe", "*\taskhostw.exe")) and (FolderPath in ("*\type.exe", "*\findstr.exe", "*\copy.exe", "*\robocopy.exe"))) and (not ((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\brave.exe", "*\opera.exe")) or (FolderPath in ("*\Google\Cloud SDK\*", "*\Amazon\AWSCLIV2\*", "*\Microsoft SDKs\Azure\*", "*\HashiCorp\Terraform\*"))))