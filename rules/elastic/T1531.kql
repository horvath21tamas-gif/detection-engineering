(process.executable:(*\\net.exe OR *\\net1.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe)) AND (process.command_line:(*\ user\ * OR *Remove\-LocalUser* OR *Remove\-ADUser* OR *Disable\-LocalUser* OR *Disable\-ADAccount* OR *Set\-LocalUser\ \-AccountExpires*)) AND (process.command_line:(*\ \/delete* OR *\ \/active\:no* OR *\ \/logoff*)) AND (process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\httpd.exe OR *\\rundll32.exe OR *\\explorer.exe)) AND (NOT ((process.command_line:(*Add\-LocalUser* OR *\ \/add*)) OR process.parent.executable:*\\msiexec.exe OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.command_line:(*WDAGUtilityAccount* OR *DefaultAccount*))))
