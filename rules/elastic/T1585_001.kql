(destination.domain:(*facebook.com\/reg* OR *accounts.google.com\/signup* OR *twitter.com\/i\/flow\/signup* OR *linkedin.com\/signup* OR *instagram.com\/accounts\/emailsignup* OR *reddit.com\/register*)) AND ((process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\python.exe OR *\\curl.exe OR *\\wget.exe)) OR (NOT (process.executable.caseless:(*\\chrome.exe OR *\\msedge.exe OR *\\firefox.exe OR *\\brave.exe))))
