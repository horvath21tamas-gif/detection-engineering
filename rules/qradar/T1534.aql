SELECT UTF8(payload) as search_payload from events where ""Parent Filename"" ILIKE '%\outlook.exe' AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\cscript.exe','%\wscript.exe','%\rundll32.exe','%\mshta.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% /a %','% /c ipm.note%','% /m %','%outlook.application%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%.iso%','%.vhd%','%.img%','%.htm%','%.html%','%.lnk%','%.zip%','%\%')) OR (""Parent Filename"" ILIKE ENUMERATION('%\browser.exe','%\chrome.exe','%\msedge.exe','%\firefox.exe','%\httpd.exe','%\php-cgi.exe','%\explorer.exe /embedding')) AND NOT (("Process "Process CommandLine"" ILIKE ENUMERATION('%C:\Program Files\Microsoft Office%','%Adobe\Acrobat%','%Salesforce%','%Zoom%','%Teams%')) AND "username" ILIKE 'NT AUTHORITY\%' AND (""Filename"" ILIKE ENUMERATION('%\conhost.exe','%\explorer.exe')))
