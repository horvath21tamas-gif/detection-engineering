(Image IN ("*\\certutil.exe", "*\\certmgr.exe", "*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("* Root*", "* AuthRoot*", "* TrustedPublisher*", "* Cert:\\LocalMachine\\Root*", "* Cert:\\CurrentUser\\Root*") CommandLine IN ("* -f*", "* -enterprise*", "* -user*", "* -silent*") OR CommandLine IN ("*\\AppData\\*", "*\\Users\\Public\\*", "*\\Downloads\\*", "*\\Desktop\\*", "*\\Temp\\*", "*\\ProgramData\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\acrord32.exe", "*\\mshta.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\regsvr32.exe")) OR (CommandLine IN ("*Zone.Identifier*", "*SaveZoneInformation*", "*LowRiskFileTypes*", "*Unblock-File*", "*streams.exe -d*") CommandLine IN ("*\\AppData\\*", "*\\Users\\Public\\*", "*\\Downloads\\*", "*\\Desktop\\*", "*\\Temp\\*", "*\\ProgramData\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\acrord32.exe", "*\\mshta.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\regsvr32.exe") OR NOT (User IN ("*NT AUTHORITY\\SYSTEM*", "*NT AUTHORITY\\LOCAL SERVICE*", "*NT AUTHORITY\\NETWORK SERVICE*"))) NOT (ParentImage IN ("C:\\Windows\\System32\\msiexec.exe*", "C:\\Windows\\System32\\svchost.exe*", "C:\\Windows\\servicing\\TrustedInstaller.exe*", "C:\\Program Files\\Microsoft Endpoint Manager\\*", "C:\\Program Files\\Microsoft Configuration Manager\\*") User="NT AUTHORITY\\SYSTEM*")
