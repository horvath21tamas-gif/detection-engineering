Image="*\\regsvr32.exe" CommandLine IN ("*/i:*", "*/n*", "*/s*", "*scrobj.dll*", "*.sct*", "*http://*", "*https://*") CommandLine IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*") OR ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe") NOT (ParentImage IN ("*\\Windows\\Installer\\*", "*\\Program Files\\*", "*\\Program Files (x86)\\*", "*\\Microsoft\\EdgeUpdate\\*", "*\\Google\\Update\\*", "*\\Adobe\\*", "*\\Mozilla\\*", "*\\Citrix\\*") OR User IN ("*SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*"))
