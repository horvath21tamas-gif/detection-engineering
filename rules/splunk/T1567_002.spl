Image IN ("*\\rclone.exe", "*\\megatools.exe", "*\\mega-put.exe", "*\\pcloud.exe") CommandLine IN ("* upload *", "* sync *", "* --ignore-existing*") CommandLine IN ("* --config *", "* --no-check-certificate*", "* --bwlimit *", "* --include *") OR CommandLine IN ("*mega.nz*", "*dropboxapi.com*", "*googleapis.com/upload*", "*pcloud.com*", "*transfer.sh*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\rundll32.exe", "*\\powershell.exe") NOT (Image IN ("*\\Program Files\\*", "*\\System32\\OneDrive.exe*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe") | table Time,SourceImage,ParentImage,CommandLine,ProcessId,SourceUsername,DestinationUrl
