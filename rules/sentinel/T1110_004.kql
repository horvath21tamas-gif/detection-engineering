DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*combo*", "*proxylist*", "*capture*", "*threads*", "*SentryMBA*", "*OpenBullet*")) or (ProcessCommandLine in ("*user:pass*", "*wordlist*", "*passlist*", "*accounts.txt*", "*combos.txt*"))) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (FolderPath in ("*\python.exe", "*\pythonw.exe", "*\node.exe", "*\powershell.exe"))) and (not ((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\brave.exe")) and (ParentProcessName in ("*\Program Files\*", "*\Windows\System32\*")) and User =~ "NT AUTHORITY\SYSTEM"))