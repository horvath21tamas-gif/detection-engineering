SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\hh.exe','%\winhlp32.exe','%\extracticon.exe','%\rc.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-decompile%','%its:%','%ms-its:%','%mk:@MSITStore:%','%javascript:%','%vbscript:%') OR ""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\mshta.exe','%\powershell.exe') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\Public\%','%\Downloads\%','%\Temp\%','%\AppData\%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\Program Files\%','%\Program Files (x86)\%','%\Windows\System32\svchost.exe%') OR "Process "Process CommandLine"" ILIKE '%ms-help://%'))
