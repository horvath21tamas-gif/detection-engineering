DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where TargetObject contains "\Services\DHCPServer\Parameters\Options\" and (TargetObject in ("*\066*", "*\067*")) and (Details in ("*.efi*", "*.bin*", "*.pxe*", "*.com*")) and (FolderPath in ("*\dhcpssvc.exe", "*\mmc.exe", "*\svchost.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\netsh.exe", "*\reg.exe")) and (not (username =~ "NT AUTHORITY\NETWORK SERVICE" or FolderPath contains "C:\Windows\System32\"))