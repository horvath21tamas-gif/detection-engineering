DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\aws.exe", "*\az.cmd", "*\gcloud.cmd", "*\gsutil.py")) and (ProcessCommandLine in ("*s3 ls*", "*s3api list-objects*", "*s3api list-object-versions*", "*storage blob list*", "*storage container list*", "*storage ls*", "*storage objects list*")) and ((ProcessCommandLine in ("*--recursive*", "*--query*", "*--output json*", "* | jq*", "* > *", "*base64*")) or (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\httpd.exe"))) and (not ((ParentProcessName in ("*\Veeam\*", "*\Commvault\*", "*\rclone.exe*", "*\terraform.exe*")) and User =~ "NT AUTHORITY\SYSTEM"))