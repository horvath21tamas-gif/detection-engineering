DestinationHostname IN ("*facebook.com/reg*", "*accounts.google.com/signup*", "*twitter.com/i/flow/signup*", "*linkedin.com/signup*", "*instagram.com/accounts/emailsignup*", "*reddit.com/register*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\python.exe", "*\\curl.exe", "*\\wget.exe") OR NOT (Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe", "*\\brave.exe"))
