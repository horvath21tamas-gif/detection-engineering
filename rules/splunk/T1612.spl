Image IN ("*/docker", "*/podman", "*/buildah", "*/kaniko") CommandLine IN ("* build *", "* build-using-dockerfile *", "* build-image *") ParentImage IN ("*/nginx", "*/apache2", "*/httpd", "*/php-fpm", "*/python", "*/node", "*/java", "*/redis-server") OR (CommandLine IN ("* -f -*", "*http://*", "*https://*", "*--no-cache*", "*--privileged*") NOT (username IN ("jenkins", "gitlab-runner", "github-actions", "root") CommandLine IN ("*/home/jenkins*", "*/var/lib/gitlab-runner*")))
