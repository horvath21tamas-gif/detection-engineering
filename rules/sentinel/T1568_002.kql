DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*Resolve-DnsName*", "*[System.Net.Dns]::*", "*ErrorAction SilentlyContinue*", "*ErrorAction 0*", "*nslookup*", "*-q*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\mshta.exe", "*\certutil.exe", "*\bitsadmin.exe"))) or ((ProcessCommandLine matches regex "(?i).*[a-z0-9]{12,}\\.(top|xyz|pw|icu|bid|monster|live|ga|tk|cf|ml|buzz|online|club|site).*" and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\mshta.exe", "*\certutil.exe", "*\bitsadmin.exe"))) and (not ((ProcessCommandLine in ("*\Program Files\*", "*Microsoft\Azure*", "*internal.corp*", "*update.microsoft.com*", "*chocolatey*", "*acme-challenge*", "*_vlmcs._tcp*")) or username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\services.exe", "*\explorer.exe")))))