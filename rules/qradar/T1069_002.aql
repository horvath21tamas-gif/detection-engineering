SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\adfind.exe','%\net.exe','%\net1.exe','%\dsquery.exe','%\SharpHound.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Get-DomainGroup%','%Get-ADGroup%','%search -filter%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Domain Admins%','%Enterprise Admins%','%Schema Admins%','%Remote Desktop Users%','% /domain%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%ConvertTo-Json%','% -Properties %','% -CSV %','% > %') OR (""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\httpd.exe','%\winword.exe')) AND "Integrity Level"='Medium') AND NOT ("username" ILIKE 'NT AUTHORITY\%' OR "Computer Name" ILIKE '%DC-%' OR ""Parent Filename"" ILIKE ENUMERATION('%\Program Files\Tanium\%','%\Windows\System32\CcmExec.exe%') OR "Process "Process CommandLine"" ILIKE '%Get-ADGroupMember -Identity%')
