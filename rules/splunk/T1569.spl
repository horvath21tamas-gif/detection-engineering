Image="*\\sc.exe" OR OriginalFileName="sc.exe" OR Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("* create *", "* config *", "* binPath*", "*New-Service*", "*Set-Service*") CommandLine IN ("*:\\Windows\\Temp\\*", "*:\\Users\\Public\\*", "*:\\ProgramData\\*", "*\\AppData\\Local\\Temp\\*", "*admin$*", "*c$*", "*\\127.0.0.1\\*") OR CommandLine IN ("*cmd.exe /c*", "*cmd.exe /k*", "*powershell.exe -enc*", "* -ExecutionPolicy Bypass *") NOT (ParentImage IN ("*\\msiexec.exe", "*\\TrustedInstaller.exe", "*\\CcmExec.exe") OR (username="NT AUTHORITY\\SYSTEM" CommandLine="*C:\\Windows\\System32\\*"))
