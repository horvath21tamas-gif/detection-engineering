((Image:*\/journalctl AND (CommandLine:(*\-\-vacuum\-time* OR *\-\-vacuum\-size* OR *\-\-rotate* OR *\-\-flush*))) OR ((Image:(*\/truncate OR *\/shred OR *\/tee)) AND (CommandLine:(*auth.log* OR *secure* OR *syslog* OR *wtmp* OR *lastlog*)))) AND ((ParentImage:(*\/apache2 OR *\/nginx OR *\/httpd OR *\/php\-fpm OR *\/python* OR *\/perl OR *\/node)) OR (NOT ((ParentImage:(*\/logrotate OR *\/systemd)) OR (CommandLine:(*logrotate.conf* OR *\/var\/lib\/docker\/containers*)) OR (username:root AND ParentImage:*\/ansible))))
