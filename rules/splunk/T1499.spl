CommandLine IN ("* /f /im lsass.exe*", "* /f /im csrss.exe*", "* /f /im wininit.exe*", "* /f /im smss.exe*", "* /f /im services.exe*") OR CommandLine IN ("*while($true)*", "*for(;;)*", "*::MemoryStream*", "*AllocHGlobal*", "*foreach($i in 1..1gb)*", "*:loop*", "*-Recursive*", "*Get-Random*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\rundll32.exe", "*\\httpd.exe", "*\\nginx.exe", "*\\apache.exe") Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*", "*\\Downloads\\*") NOT (username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe", "*\\TiWorker.exe", "*\\TrustedInstaller.exe") CommandLine IN ("*HealthCheck*", "*Diagnostic*", "*Update*", "*Patch*", "*Maintenance*"))
