DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*goldensaml*", "*asreproast*", "*Get-AADIntAccessToken*", "*roadtoken*", "*cloud::google*", "*cloud::aws*")) or ((ProcessCommandLine in ("*dpapi::masterkey*", "*crypt::unprotect*")) or (FolderPath in ("*\mimikatz.exe", "*\pypykatz.exe"))) or ((ProcessCommandLine in ("*select *", "*password_value*", "*token*", "*cookie*")) and (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*")))) and (not ((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\teams.exe", "*\slack.exe")) and ParentProcessName contains "\Program Files\"))