DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (GrantedAccess in ("*0x1410*", "*0x1411*", "*0x1438*", "*0x143a*", "*0x1F1FFF*")) and (TargetImage in ("*\explorer.exe", "*\taskmgr.exe", "*\mmc.exe", "*\dllhost.exe")) and CallTrace contains "unknown" and (SourceImage in ("*\Users\*", "*\Temp\*", "*\AppData\*")) and (not (SourceProcessName =~ "C:\Windows\System32\csrss.exe" or (SourceImage in ("*\MsMpEng.exe", "*\CcmExec.exe")) or (CallTrace in ("*comctl32.dll+*", "*user32.dll+*", "*ntdll.dll+LdrpWorkItem*")) or condition =~ "SourceProcessName == TargetImage"))