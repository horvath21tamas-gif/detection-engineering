SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('%--privileged%','%--cap-add=SYS_ADMIN%','%--cap-add=SYS_PTRACE%','%--pid=host%','%--net=host%','%--ipc=host%','%--security-opt=seccomp=unconfined%','%--security-opt=apparmor=unconfined%') OR ""Process CommandLine"" ILIKE ENUMERATION('%-v /:/%','%-v /proc:/proc%','%-v /sys:/sys%','%-v /var/run/docker.sock:/var/run/docker.sock%','%-v /run/containerd:/run/containerd%','%-v /etc/kubernetes:/etc/kubernetes%','%-v /root/.ssh:/root/.ssh%')) AND (""Parent Filename"" ILIKE ENUMERATION('%/bash','%/sh','%/zsh','%/python','%/ruby','%/php','%/node')) AND NOT ((""Filename"" ILIKE ENUMERATION('%kube-proxy%','%calico/node%','%cilium%','%datadog/agent%','%node-exporter%','%istio-proxy%','%fluentd%','%prometheus%')) AND "username"='root')
