SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-encodedcommand%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-nop%','%-noni%','%-windowstyle hidden%','%-w hidden%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Invoke-WebRequest%','%iwr %','%wget %','%curl %','%DownloadString%','%DownloadFile%','%Net.WebClient%','%http://%','%https://%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%IEX%','%Invoke-Expression%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\Installer\%','%\Microsoft Configuration Manager\%','%\Windows\CCM\%','%\PDQ\%','%\Ivanti\%','%\Tanium\%','%\ManageEngine\%','%\Automation\%','%\Scripts\%'))
