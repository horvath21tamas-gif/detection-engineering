SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%\Environment\UserInitMprLogonScript%' AND (("Target Details" LIKE '%powershell%' OR "Target Details" LIKE '%pwsh%' OR "Target Details" LIKE '%cmd.exe%' OR "Target Details" LIKE '%mshta%' OR "Target Details" LIKE '%cscript%' OR "Target Details" LIKE '%wscript%' OR "Target Details" LIKE '%rundll32%' OR "Target Details" LIKE '%regsvr32%' OR "Target Details" LIKE '%bitsadmin%' OR "Target Details" LIKE '%certutil%') OR ("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%:\\Windows\\Temp\\%' OR "Target Details" LIKE '%AppData\\%' OR "Target Details" LIKE '%C:\\PerfLogs\\%')) AND NOT ((("Target Details" LIKE '%\\NETLOGON\\%' OR "Target Details" LIKE '%\\Scripts\\Logon%')) AND (("Target Details" LIKE '%C:\\Windows\\System32\\%' OR "Target Details" LIKE '%C:\\Program Files\\%')) OR ""Filename"" ILIKE ENUMERATION('%\System32\gpupdate.exe','%\System32\reg.exe','%\trustedinstaller.exe'))
