Image IN ("*\\netsh.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\reg.exe", "*\\cmd.exe") CommandLine IN ("*set dns*", "*set proxy*", "*winhttp set proxy*", "*AutoConfigURL*", "*ProxyServer*", "*ProxyEnable*", "*Internet Settings*") OR CommandLine IN ("* >> *", "*Set-Content*", "*Add-Content*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\explorer.exe") NOT (ParentImage IN ("*\\msiexec.exe", "*\\CcmExec.exe") OR CommandLine IN ("*127.0.0.1*", "*localhost*") OR username="NT AUTHORITY\\SYSTEM")
