SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\acrord32.exe','%\acrobat.exe','%\7zFM.exe','%\winrar.exe')) AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\certutil.exe','%\rundll32.exe','%\regsvr32.exe','%\scrcons.exe','%\bitsadmin.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','% -w hidden%','%DownloadString%','%Invoke-WebRequest%','%http%','%javascript:%','%vbscript:%','%GlobalTemp%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\Local\Microsoft\Office\%','%Template.dotm%') OR ""Parent Filename"" ILIKE '%C:\Program Files\%')
