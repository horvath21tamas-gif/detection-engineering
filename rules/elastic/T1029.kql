winlog.channel:Security AND (((winlog.event_data.EventData:(*\\rclone.exe* OR *\\bitsadmin.exe* OR *\\certutil.exe* OR *\\megatools.exe* OR *curl\ * OR *powershell*)) AND ((winlog.event_data.EventData:(*\ sync\ * OR *\ upload\ * OR *\ \-post\ * OR *\ \-transfer\ * OR *\ \-ExecutionPolicy\ Bypass\ * OR *WebClient.UploadFile*)) OR (winlog.event_data.EventData:(*\<Interval\>PT5M\<\/Interval\>* OR *\<Interval\>PT10M\<\/Interval\>* OR *\<StartBoundary\>202\[0\-9\]\-\[0\-9\]\{2\}\-\[0\-9\]\{2\}T0\[0\-3\]\:*)))) AND (NOT ((winlog.event_data.EventData:(*\\Windows\\System32\\Tasks\\Microsoft* OR *\\Program\ Files\\*)) OR user.name:SYSTEM OR winlog.event_data.EventData:*Telemetry*)))
