SELECT SrcIp, UriStem, UriQuery, UserAgent, Status from events where (("SrcIp" LIKE '%1.%' OR "SrcIp" LIKE '%2.%' OR "SrcIp" LIKE '%3.%' OR "SrcIp" LIKE '%4.%' OR "SrcIp" LIKE '%5.%' OR "SrcIp" LIKE '%6.%' OR "SrcIp" LIKE '%7.%' OR "SrcIp" LIKE '%8.%' OR "SrcIp" LIKE '%9.%')) AND (("UriStem" LIKE '%/cgi-bin%' OR "UriStem" LIKE '%/status%' OR "UriStem" LIKE '%/system%' OR "UriStem" LIKE '%/device%' OR "UriStem" LIKE '%/version%' OR "UriStem" LIKE '%/firmware%' OR "UriStem" LIKE '%/diagnostic%' OR "UriStem" LIKE '%/setup%' OR "UriStem" LIKE '%/admin%' OR "UriStem" LIKE '%/mgmt%' OR "UriStem" LIKE '%/management%')) AND (("UriQuery" LIKE '%firmware%' OR "UriQuery" LIKE '%version%' OR "UriQuery" LIKE '%build%' OR "UriQuery" LIKE '%model%' OR "UriQuery" LIKE '%hardware%' OR "UriQuery" LIKE '%platform%')) AND (("UserAgent" LIKE '%curl%' OR "UserAgent" LIKE '%wget%' OR "UserAgent" LIKE '%python%' OR "UserAgent" LIKE '%httpclient%' OR "UserAgent" LIKE '%go-http-client%' OR "UserAgent" LIKE '%libwww%' OR "UserAgent" LIKE '%probe%')) AND NOT (("UserAgent" LIKE '%Mozilla%' OR "UserAgent" LIKE '%Chrome%' OR "UserAgent" LIKE '%Safari%' OR "UserAgent" LIKE '%Firefox%' OR "UserAgent" LIKE '%Edge%') OR ("UserAgent" LIKE '%nessus%' OR "UserAgent" LIKE '%qualys%' OR "UserAgent" LIKE '%openvas%' OR "UserAgent" LIKE '%acunetix%' OR "UserAgent" LIKE '%nikto%' OR "UserAgent" LIKE '%nuclei%' OR "UserAgent" LIKE '%zap%' OR "UserAgent" LIKE '%zabbix%' OR "UserAgent" LIKE '%uptime%' OR "UserAgent" LIKE '%pingdom%') OR (("UriStem" LIKE '%.css%' OR "UriStem" LIKE '%.js%' OR "UriStem" LIKE '%.png%' OR "UriStem" LIKE '%.jpg%' OR "UriStem" LIKE '%.svg%' OR "UriStem" LIKE '%.ico%' OR "UriStem" LIKE '%.woff%' OR "UriStem" LIKE '%.woff2%' OR "UriStem" LIKE '%.json%')) AND "UriStem" ILIKE '%/api%')
