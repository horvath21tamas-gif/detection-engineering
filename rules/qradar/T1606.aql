SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%goldensaml%','%asreproast%','%Get-AADIntAccessToken%','%roadtoken%','%cloud::google%','%cloud::aws%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%dpapi::masterkey%','%crypt::unprotect%') OR ""Filename"" ILIKE ENUMERATION('%\mimikatz.exe','%\pypykatz.exe') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%select %','%password_value%','%token%','%cookie%')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%'))) AND NOT ((""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\teams.exe','%\slack.exe')) AND ""Parent Filename"" ILIKE '%\Program Files\%')
