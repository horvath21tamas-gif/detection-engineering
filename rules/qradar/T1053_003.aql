SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/echo','%/tee','%/sed','%/cat','%/printf')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/etc/cron.d/%','%/etc/cron.daily/%','%/etc/cron.hourly/%','%/etc/cron.monthly/%','%/etc/cron.weekly/%','%/var/spool/cron/%','%/etc/crontab%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%bash -i%','%python%','%curl%','%wget%','%base64%','%/dev/tcp/%','%nc %','%chmod +x%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/ansible','%/salt-minion','%/puppet','%/chef-client') OR "username"='root' AND (""Parent Filename"" ILIKE ENUMERATION('%/dpkg','%/rpm','%/apt')))
