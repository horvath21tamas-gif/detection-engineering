SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\vssadmin.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%delete shadows%','%delete shadow%','%/all%','%/quiet%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Veeam\%','%\Acronis\%','%\Commvault\%','%\Veritas\%','%\Dell\%','%\Microsoft Azure Backup\%','%\Datto\%'))
