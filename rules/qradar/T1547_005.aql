SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%\Control\Lsa\Security Packages' AND (NOT (("Target Details" LIKE '%kerberos%' OR "Target Details" LIKE '%msv1_0%' OR "Target Details" LIKE '%schannel%' OR "Target Details" LIKE '%wdigest%' OR "Target Details" LIKE '%tspkg%' OR "Target Details" LIKE '%pku2u%' OR "Target Details" LIKE '%livessp%' OR "Target Details" LIKE '%cloudap%' OR "Target Details" LIKE '%negotiate%')) OR ("Target Details" LIKE '%:\\%' OR "Target Details" LIKE '%.dll%' OR "Target Details" LIKE '%mimilib%' OR "Target Details" LIKE '%ssp%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\trustedinstaller.exe','%\System32\msiexec.exe','%\System32\setupsrv.exe'))
