DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*\Network\Cookies*", "*\cookies.sqlite*", "*\Login Data*")) or (ProcessCommandLine in ("*os_crypt*", "*crypt32.dll*", "*unprotect*", "* -key *")) or ((ProcessCommandLine in ("*evilginx*", "*modlishka*", "*muraena*", "*phishlets*")) or (FolderPath in ("*\roadtools.exe", "*\aad-token.exe")))) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*")) and (FolderPath in ("*\powershell.exe", "*\python.exe", "*\node.exe"))) and (not ((FolderPath in ("*\Program Files\Google\Chrome\*", "*\Program Files (x86)\Microsoft\Edge\*", "*\Program Files\Mozilla Firefox\*")) and ParentProcessName endswith "\services.exe" and username =~ "NT AUTHORITY\SYSTEM"))