SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\diskpart.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% clean%','% clean all%')) OR ""Filename"" ILIKE '%\diskpart.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% delete partition%','% delete volume%')) OR ""Filename"" ILIKE '%\dd.exe' AND "Process "Process CommandLine"" ILIKE '%of=\.\PhysicalDrive%' AND "Process "Process CommandLine"" ILIKE '%bs=512%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%count=1%','%if=/dev/zero%','%if=/dev/urandom%')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND "Process "Process CommandLine"" ILIKE '%Clear-Disk%' AND "Process "Process CommandLine"" ILIKE '%-RemoveData%' AND "Process "Process CommandLine"" ILIKE '%-Confirm:$false%' OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND "Process "Process CommandLine"" ILIKE '%Remove-Partition%' AND "Process "Process CommandLine"" ILIKE '%-Confirm:$false%') AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\w3wp.exe','%\httpd.exe','%\mshta.exe','%\rundll32.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe','%\vds.exe'))) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\CcmExec.exe','%\msiexec.exe','%\setup.exe')) AND (""Parent Filename"" ILIKE ENUMERATION('%\ConfigurationManager\%','%\IntuneManagementExtension\%'))) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%diskpart /s%','%\deployment\scripts\%','%\imaging\%'))
