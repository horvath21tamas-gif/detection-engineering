DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\curl.exe", "*\wget.exe", "*\powershell.exe", "*\pwsh.exe", "*\bitsadmin.exe", "*\certutil.exe")) and ((ProcessCommandLine in ("* -F *", "* --data-binary*", "* -T *", "* -k*", "* --insecure*", "*UploadFile(*", "*PutAsync(*", "*PostAsync(*")) or ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\explorer.exe")))) and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*microsoft.com*", "*office.com*", "*127.0.0.1*")) or username =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))