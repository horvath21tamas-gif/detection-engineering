SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\strip.exe','%\sstrip.exe','%\objcopy.exe','%\llvm-strip.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% --strip-all%','% --strip-debug%','% --remove-section%','% -s %','% -S %','% /NODEBUG%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%','%\PerfLogs\%','%\Downloads\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\nginx.exe','%\httpd.exe')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Visual Studio\%','%\Jenkins\%','%\GitLab-Runner\%','%\Azure Pipelines\%')) AND (("UserName" LIKE '%svc-build%' OR "UserName" LIKE '%cicd%' OR "UserName" LIKE '%builder%')))
