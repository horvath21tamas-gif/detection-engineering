SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\regsvr32.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/i:%','%/n%','%/s%','%scrobj.dll%','%.sct%','%http://%','%https://%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Downloads\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\Windows\Installer\%','%\Program Files\%','%\Program Files (x86)\%','%\Microsoft\EdgeUpdate\%','%\Google\Update\%','%\Adobe\%','%\Mozilla\%','%\Citrix\%') OR ("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%'))
