DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*Resolve-DnsName*", "*[System.Net.Dns]::*", "*ErrorAction SilentlyContinue*", "*ErrorAction 0*", "*nslookup*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\mshta.exe"))) or ((ProcessCommandLine matches regex "(?i).*[a-z0-9]{18,}\\.(top|xyz|pw|icu|bid|monster|live|ga|tk|cf|ml|buzz|online).*" and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\mshta.exe"))) and (not ((ProcessCommandLine in ("*\Program Files\*", "*Microsoft\Azure*", "*internal.corp*", "*update.microsoft.com*")) or User =~ "NT AUTHORITY\SYSTEM")))