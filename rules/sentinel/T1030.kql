DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("* [System.IO.File]::OpenRead*", "*.Read(*", "* [System.Convert]::ToBase64*", "* -Split *", "* [byte[]]*")) or (ProcessCommandLine in ("* -v*", "* -m0*", "* -sdel*", "* -rn*"))) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\csc.exe", "*\certutil.exe"))) and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*Windows\Logs*", "*NuGet*")) or (username in ("NT AUTHORITY\SYSTEM", "NT AUTHORITY\LOCAL SERVICE", "NT AUTHORITY\NETWORK SERVICE"))))