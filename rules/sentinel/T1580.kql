DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\aws.exe", "*\az.cmd", "*\gcloud.cmd", "*\oci.exe", "*\ibmcloud.exe")) and (ProcessCommandLine in ("*ec2 describe-instances*", "*ec2 describe-security-groups*", "*s3 ls*", "*rds describe-db-instances*", "*vm list*", "*compute instances list*", "*network vnet list*", "*storage account list*", "*buckets list*", "*projects list*")) and ((ProcessCommandLine in ("*--query*", "*--output json*", "* | jq*", "* | base64*", "* > *", "*>>*", "*| ConvertTo-Json*", "*| Out-File*")) or (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\explorer.exe"))) and (not ((ParentProcessName in ("*\Jenkins\*", "*\GitLab-Runner\*", "*\Terraform\*", "*\Ansible\*", "*\Pulumi\*", "*\Octopus\*")) and username =~ "NT AUTHORITY\SYSTEM"))