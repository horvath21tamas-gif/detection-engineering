(Image IN ("*\\wmic.exe", "*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*Win32_BaseBoard*", "*Win32_BIOS*", "*Win32_ComputerSystem*", "*Win32_ComputerSystemProduct*", "*csproduct get uuid*", "*bios get serialnumber*") CommandLine IN ("*VMware*", "*VirtualBox*", "*VBOX*", "*QEMU*", "*Xen*", "*KVM*", "*Hyper-V*")) OR (Image IN ("*\\cmd.exe", "*\\powershell.exe") CommandLine IN ("*getmac*", "*ipconfig /all*", "*arp -a*", "*get-netadapter*", "*netsh interface show interface*") CommandLine IN ("*00-05-69*", "*00-0C-29*", "*00-50-56*", "*08-00-27*")) OR CommandLine IN ("*VBoxGuest*", "*vboxservice*", "*vmtoolsd*", "*vmmouse*", "*vmhgfs*", "*vboxguest.sys*", "*vmsrvc*", "*\\System32\\drivers\\*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\mshta.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\acrord32.exe", "*\\w3wp.exe") OR Image IN ("*\\AppData\\Local\\Temp\\*", "*\\AppData\\Roaming\\*", "*\\Users\\Public\\*", "*\\Downloads\\*") IntegrityLevel IN ("Medium", "High") NOT (Image IN ("*\\Program Files\\Lansweeper\\*", "*\\Program Files\\SCCM\\*", "*\\Program Files\\Tanium\\*", "*\\Program Files\\Qualys\\*", "*\\Program Files\\Microsoft Monitoring Agent\\*") OR (username IN ("NT AUTHORITY\\SYSTEM", "NT AUTHORITY\\NETWORK SERVICE") ParentImage IN ("*\\Windows\\System32\\services.exe*", "*\\svchost.exe*"))) | table Image,ParentImage,CommandLine,IntegrityLevel,User,Hashes
