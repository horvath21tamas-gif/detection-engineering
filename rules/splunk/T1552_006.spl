CommandLine IN ("*cpassword*", "*password=*", "*pwd=*", "*userPassword*", "*SecureString*", "*ConvertTo-SecureString*", "*Get-GPPPassword*", "*unattend.xml*", "*sysprep.xml*", "*web.config*", "*Groups.xml*", "*ScheduledTasks.xml*", "*Services.xml*") CommandLine IN ("*\\SYSVOL\\*", "*\\Policies\\*", "*\\Windows\\Panther\\*", "*\\Windows\\System32\\sysprep\\*", "*\\inetpub\\wwwroot\\*", "*\\ProgramData\\*", "*\\Users\\*") (Image IN ("*\\findstr.exe", "*\\find.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\grep.exe") CommandLine IN ("*Select-String*", "*Get-ChildItem*", "*dir *", "*type *", "*gc *")) OR CommandLine IN ("*-enc*", "*-EncodedCommand*", "*IEX*", "*Invoke-Expression*", "*DownloadString*") OR ParentImage IN ("*\\wsmprovhost.exe", "*\\psexesvc.exe", "*\\wmiprvse.exe") NOT (User IN ("*NT AUTHORITY\\SYSTEM*", "*NT AUTHORITY\\LOCAL SERVICE*", "*NT AUTHORITY\\NETWORK SERVICE*")) NOT (Image IN ("*\\svchost.exe", "*\\taskhostw.exe", "*\\gpscript.exe") User="NT AUTHORITY\\SYSTEM*")
