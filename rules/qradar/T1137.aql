SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%\Software\Microsoft\Office\%' AND (("Target Object" LIKE '%\\Addins\\LoadBehavior%' OR "Target Object" LIKE '%\\Options\\OPEN%' OR "Target Object" LIKE '%\\Outlook\\WebView\\URL%' OR "Target Object" LIKE '%\\Security\\Trusted Documents\\TrustRecords%')) AND (("Target Details" LIKE '%\\AppData\\Local\\Temp\\%' OR "Target Details" LIKE '%C:\\Users\\Public\\%' OR "Target Details" LIKE '%\\Downloads\\%' OR "Target Details" LIKE '%http%') OR ""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\reg.exe','%\bitsadmin.exe')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\setup.exe','%\OfficeClickToRun.exe')) AND (("Target Details" LIKE '%C:\\Program Files\\%' OR "Target Details" LIKE '%C:\\Program Files (x86%')\%')))
