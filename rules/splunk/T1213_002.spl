CommandLine IN ("*Get-PnP*", "*Get-SPO*", "*Microsoft.SharePoint.PowerShell*", "*/_api/web/lists*", "*/_api/search/query*", "*Connect-PnPOnline*") CommandLine IN ("* -All*", "* -Recurse*", "* -PageSize 1000*", "* -Limit All*", "*Export-PnPListItem*") OR CommandLine IN ("*\\Users\\Public\\*", "*\\Windows\\Temp\\*", "*\\AppData\\Local\\Temp\\*", "* -OutFile *") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\w3wp.exe", "*\\explorer.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\SharePoint Online Management Shell\\*", "*C:\\Program Files\\Microsoft SDKs\\SharePoint\\*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*OneDrive.exe*", "*OfficeClickToRun.exe*"))
