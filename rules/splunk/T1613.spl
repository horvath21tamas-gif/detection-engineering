Image IN ("*/kubectl", "*/k3s", "*/docker", "*/crictl", "*/nerdctl", "*/oc") CommandLine IN ("*auth can-i*", "*get secrets*", "*describe pod*", "*describe deployment*", "*get nodes*", "*get svc*", "*get configmaps*", "*inspect*", "*logs*", "*exec*") (ParentImage IN ("*/www-data*", "*/nginx*", "*/httpd*", "*/php-fpm*", "*/python*", "*/node*") username IN ("root", "www-data", "nginx")) OR CommandLine IN ("*--format json*", "*-o json*", "* | jq*", "* > *", "*--all-namespaces*") NOT (Image IN ("*/usr/bin/kubelet*", "*/datadog-agent*", "*/prometheus*", "*/telegraf*", "*/rancher*") CommandLine IN ("*get pods --watch*", "*--version*", "*metrics-server*"))
