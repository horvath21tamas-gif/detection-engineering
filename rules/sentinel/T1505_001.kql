DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ParentProcessName endswith "\sqlservr.exe" and ((FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\bitsadmin.exe", "*\certutil.exe", "*\net.exe", "*\net1.exe", "*\whoami.exe", "*\systeminfo.exe", "*\nltest.exe", "*\scrcons.exe", "*\cscript.exe", "*\wscript.exe", "*\rundll32.exe")) or (ProcessCommandLine in ("*sp_configure*", "*xp_cmdshell*", "*RECONFIGURE*", "*show advanced options*", "*Ole Automation Procedures*", "*CREATE ASSEMBLY*", "*ALTER ASSEMBLY*"))) and (not (ParentProcessName endswith "\sqlagent.exe" or ((FolderPath in ("*\Microsoft SQL Server\Setup\*", "*\Microsoft SQL Server\MSSQL\Setup\*")) and ProcessCommandLine contains "sqlagent.exe -i")))