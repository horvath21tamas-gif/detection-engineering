SELECT UTF8(payload) as search_payload from events where (("operation_name" LIKE '%AuthorizeSecurityGroupIngress%' OR "operation_name" LIKE '%CreateNetworkAclEntry%' OR "operation_name" LIKE '%Microsoft.Network/networkSecurityGroups/securityRules/write%' OR "operation_name" LIKE '%v1.compute.networks.updatePolicy%')) AND (("request_parameters" LIKE '%0.0.0.0/0%' OR "request_parameters" LIKE '%::/0%' OR "request_parameters" LIKE '%all%' OR "request_parameters" LIKE '%any%')) AND (("request_parameters" LIKE '%22%' OR "request_parameters" LIKE '%3389%' OR "request_parameters" LIKE '%445%' OR "request_parameters" LIKE '%5985%' OR "request_parameters" LIKE '%3306%' OR "request_parameters" LIKE '%5432%' OR "request_parameters" LIKE '%1433%') OR "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%boto3%' OR "user_agent" LIKE '%postman%' OR "user_agent" LIKE '%curl%'))) AND NOT (("user_name" LIKE '%svc-terraform%' OR "user_name" LIKE '%svc-ansible%' OR "user_name" LIKE '%cloud-formation-manager%') OR ("user_name" LIKE '%system-internal%' OR "user_name" LIKE '%elasticloadbalancing%'))
