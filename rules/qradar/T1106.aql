SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\acrord32.exe')) AND (""Filename"" ILIKE ENUMERATION('%\csc.exe','%\msbuild.exe','%\installutil.exe','%\regsvcs.exe','%\regasm.exe','%\cvtres.exe')) OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%NtCreateSection%','%NtMapViewOfSection%','%NtWriteVirtualMemory%','%NtQueueApcThread%','%ZwMapViewOfSection%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%Microsoft Visual Studio%','%Windows\Microsoft.NET\Framework%') OR "Process "Process CommandLine"" ILIKE '%Microsoft.Workflow.Compiler%')
