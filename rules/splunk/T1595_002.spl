SrcIp IN ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*") Status IN (400, 401, 403, 404, 405, 500, 502, 503) UserAgent IN ("*nuclei*", "*sqlmap*", "*nikto*", "*acunetix*", "*wpscan*", "*zgrab*") OR (UriStem IN ("*/.env*", "*/.git*", "*/vendor/phpunit*", "*/phpmyadmin*", "*/cgi-bin*", "*/wp-config*", "*/wp-admin*", "*/actuator*", "*/console*") UriQuery IN ("*../*", "*%2e%2e*", "*cmd=*", "*exec=*", "*shell*", "*whoami*", "*id=*", "*base64*", "*payload=*")) NOT (UserAgent IN ("*googlebot*", "*bingbot*", "*uptimerobot*", "*pingdom*", "*statuscake*", "*datadog*", "*newrelic*") OR SrcIp IN ("203.0.113.10", "203.0.113.11")) | table SrcIp,UriStem,UriQuery,Status,UserAgent
