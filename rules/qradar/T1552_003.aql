SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%.bash_history%','%.zsh_history%','%.fish_history%','%ConsoleHost_history.txt%','%.mysql_history%','%.psql_history%','%.python_history%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%base64%','%certutil -encode%','%curl %','%wget %','%nc %','%scp %','% > %','%>>%','% | clip%','%Invoke-WebRequest%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-EncodedCommand%','%IEX%','%Invoke-Expression%') OR ""Parent Filename"" ILIKE ENUMERATION('%\httpd.exe','%\nginx.exe','%\php-cgi.exe','%\wsmprovhost.exe','%\psexesvc.exe','%\wmiprvse.exe','%\cmd.exe','%\powershell.exe')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\bash.exe','%\zsh.exe','%\conhost.exe','%\cmd.exe'))
