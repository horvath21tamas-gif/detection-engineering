(process.executable.caseless:(*\\notepad.exe OR *\\calc.exe OR *\\winver.exe OR *\\spoolsv.exe OR *\\rundll32.exe OR *\\regsvr32.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe)) AND (dns.question.name:\^.\{64,255\}\\..*$ OR (winlog.event_data.QueryType:(16 OR 10 OR 33))) AND (winlog.event_data.IntegrityLevel:Medium AND (winlog.event_data.CommandLine:(*\-enc* OR *nslookup*))) AND (NOT ((dns.question.name:(*.microsoft.com OR *.windowsupdate.com OR *.google.com OR *.azure.com OR *.cloudfront.net OR *.akamaized.net)) AND (process.executable.caseless:(*\\chrome.exe* OR *\\msedge.exe* OR *\\firefox.exe* OR *\\svchost.exe*))))
