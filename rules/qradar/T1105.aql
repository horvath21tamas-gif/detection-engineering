SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\bitsadmin.exe%' OR "Filename" LIKE '%\\certutil.exe%')) AND (("Process CommandLine" LIKE '%Invoke-WebRequest%' OR "Process CommandLine" LIKE '%IEX%' OR "Process CommandLine" LIKE '%DownloadFile%'))
