DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\net.exe", "*\net1.exe", "*\whoami.exe", "*\quser.exe", "*\qwinsta.exe")) or (ProcessCommandLine in ("*Get-LocalUser*", "*Get-LocalGroup*", "*Win32_UserAccount*", "*Win32_Group*"))) and (ProcessCommandLine in ("* user*", "* localgroup*", "* /all*", "* /groups*")) and ((ParentProcessName in ("*\httpd.exe", "*\nginx.exe", "*\wsmprovhost.exe", "*\psexesvc.exe", "*\php-cgi.exe", "*\sqlservr.exe")) and (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\Windows\System32\msiexec.exe*", "*\Windows\System32\svchost.exe*"))))