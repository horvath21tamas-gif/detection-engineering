DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*System.IO.Compression*", "*IO.Compression.FileSystem*", "*GzipStream*", "*BrotliStream*", "*ZipArchive*"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine contains "Compress-Archive" and ProcessCommandLine contains "-DestinationPath"))) and (ProcessCommandLine in ("*\Desktop\*", "*\Documents\*", "*\Downloads\*", "*\AppData\Local\Microsoft\Outlook\*", "*C:\inetpub\*", "*C:\Users\Public\*", "*\ProgramData\*")) and (ProcessCommandLine in ("*.zip*", "*.gz*", "*.tar*", "*.dat*", "*.tmp*"))) and ((ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe", "*\rundll32.exe", "*\mshta.exe", "*\cmd.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*"))) and (not (User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe")))) and (not (FolderPath in ("C:\Program Files\Microsoft Monitoring Agent\*", "C:\Program Files\Azure\*", "C:\Program Files\Splunk\*", "C:\Program Files\Elastic\*"))) and (not (ParentProcessName in ("*\Visual Studio\*", "*\AzureDevOps\*", "*\Jenkins\*", "*\GitLab\*")))