DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ParentProcessName in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\winword.exe", "*\excel.exe", "*\outlook.exe")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\mshta.exe", "*\cmd.exe"))) or (ProcessCommandLine in ("*System.Windows.Forms.Form*", "*Windows.Forms.TextBox*", "*PasswordChar*", "*.ShowDialog()*", "*TopMost = $true*", "*credui.dll*")) or (ProcessCommandLine in ("*PromptForCredential*", "*Get-Credential*", "*Net.NetworkCredential*"))) and (not (((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or User startswith "NT AUTHORITY\") or (ProcessCommandLine in ("*--type=utility*", "*--type=renderer*"))))