ParentImage="*\\sqlservr.exe" Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\bitsadmin.exe", "*\\certutil.exe", "*\\net.exe", "*\\net1.exe", "*\\whoami.exe", "*\\systeminfo.exe", "*\\nltest.exe", "*\\scrcons.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\rundll32.exe") OR CommandLine IN ("*sp_configure*", "*xp_cmdshell*", "*RECONFIGURE*", "*show advanced options*", "*Ole Automation Procedures*", "*CREATE ASSEMBLY*", "*ALTER ASSEMBLY*") NOT (ParentImage="*\\sqlagent.exe" OR (Image IN ("*\\Microsoft SQL Server\\Setup\\*", "*\\Microsoft SQL Server\\MSSQL\\Setup\\*") CommandLine="*sqlagent.exe -i*"))
