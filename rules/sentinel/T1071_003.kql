DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\notepad.exe", "*\calc.exe", "*\mspaint.exe", "*\winver.exe", "*\spoolsv.exe", "*\colorcpl.exe", "*\scrcons.exe")) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cscript.exe", "*\wscript.exe", "*\rundll32.exe")) and (ProcessCommandLine in ("*Send-MailMessage*", "*Net.Mail.SmtpClient*", "*System.Net.Mail*", "*.Credentials*"))) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe"))) and (RemotePort in (25, 465, 587, 993, 995)) and (not ((FolderPath in ("*\outlook.exe", "*\thunderbird.exe", "*\msedgewebview2.exe")) or (DestinationIP in ("10.0.0.0/8", "192.168.0.0/16")) or User =~ "NT AUTHORITY\SYSTEM"))