Image IN ("*\\curl.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\certutil.exe", "*\\bitsadmin.exe") CommandLine IN ("*pastebin.com/api/api_post.php*", "*api.pastebin.com*", "*ghostbin.co/paste*", "*hastebin.com/documents*", "*controlc.com/index.php*", "*rentry.co/api*") CommandLine IN ("*Get-Clipboard*", "*pbpaste*", "*api_dev_key*", "*api_paste_code*", "* -d *", "* --data*", "*Invoke-RestMethod*") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\rundll32.exe", "*\\explorer.exe") NOT (Image="*\\Program Files\\*" OR CommandLine IN ("* --version*", "* --help*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
