SELECT UTF8(payload) as search_payload from events where ("Image" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\powershell_ise.exe') OR "ImageName" ILIKE ENUMERATION('PowerShell.EXE','pwsh.dll','powershell_ise.EXE')) AND (("Process CommandLine" ILIKE ENUMERATION('%Set-MpPreference%','%Add-MpPreference%')) AND ("Process CommandLine" ILIKE ENUMERATION('%DisableRealtimeMonitoring%','%DisableBehaviorMonitoring%','%DisableIOAVProtection%','%ExclusionPath%','%ExclusionExtension%','%ExclusionProcess%','%MAPSReporting%','%SubmitSamplesConsent%') OR "Process CommandLine" ILIKE ENUMERATION('%1%','%$true%','%NeverSend%')) OR "Process CommandLine" ILIKE ENUMERATION('% -disablere%','% -excl%')) AND NOT (("ParentImage" ILIKE ENUMERATION('%\CcmExec.exe','%\Gpscript.exe')) AND "Process CommandLine" ILIKE '%Specific_Safe_Admin_Script.ps1%')
