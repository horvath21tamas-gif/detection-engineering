(ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\nginx.exe", "*\\php-cgi.exe", "*\\tomcat.exe") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\whoami.exe", "*\\net.exe", "*\\nltest.exe")) OR Image IN ("*\\chisel.exe", "*\\frpc.exe", "*\\ngrok.exe", "*\\gost.exe", "*\\nps.exe") OR CommandLine IN ("* -proxy *", "* -tunnel *", "* -secret *") NOT (User IN ("*svc_monitoring*", "*adm_sysadmin_deploy*") Image IN ("*\\Windows\\System32\\OpenSSH\\*", "*\\Program Files\\Datadog\\*")) NOT (ParentImage="*\\code.exe" CommandLine IN ("*localhost*", "*127.0.0.1*")) NOT (ParentImage="*\\explorer.exe" condition="not selection_tunnel_tools")
