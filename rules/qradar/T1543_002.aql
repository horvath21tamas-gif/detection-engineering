SELECT UTF8(payload) as search_payload from events where (("TargetFilename" LIKE '%/etc/systemd/system/%' OR "TargetFilename" LIKE '%/usr/lib/systemd/system/%' OR "TargetFilename" LIKE '%/lib/systemd/system/%' OR "TargetFilename" LIKE '%/.config/systemd/user/%')) AND "TargetFilename" ILIKE '%.service' AND (""Filename"" ILIKE ENUMERATION('%/bash','%/sh','%/zsh','%/python3','%/perl','%/curl','%/wget','%/nc','%/php') OR ""Process CommandLine"" ILIKE ENUMERATION('%ExecStart=/tmp/%','%ExecStart=/dev/shm/%','%ExecStart=/var/tmp/%','%ExecStart=python%','%ExecStart=perl%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%/ansible-playbook','%/chef-client','%/salt-minion','%/puppet','%/dpkg','%/apt-get','%/dnf','%/yum')) AND "username"='root')
