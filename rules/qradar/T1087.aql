SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\cmd.exe' AND (("Process CommandLine" LIKE '%net user%' OR "Process CommandLine" LIKE '%net localgroup%')) AND (("Process CommandLine" LIKE '%/add%' OR "Process CommandLine" LIKE '%/delete%') OR ("Process CommandLine" LIKE '%administrators%' OR "Process CommandLine" LIKE '%remote desktop users%' OR "Process CommandLine" LIKE '%domain admins%' OR "Process CommandLine" LIKE '%enterprise admins%')) AND (("ParentImage" LIKE '%\\WINWORD.EXE%' OR "ParentImage" LIKE '%\\EXCEL.EXE%' OR "ParentImage" LIKE '%\\POWERPNT.EXE%' OR "ParentImage" LIKE '%\\OUTLOOK.EXE%' OR "ParentImage" LIKE '%\\powershell.exe%' OR "ParentImage" LIKE '%\\pwsh.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\mshta.exe%')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\CCM\\%' OR "ParentImage" LIKE '%\\Microsoft Configuration Manager\\%' OR "ParentImage" LIKE '%\\PDQ\\%' OR "ParentImage" LIKE '%\\Ivanti\\%' OR "ParentImage" LIKE '%\\ManageEngine\\%' OR "ParentImage" LIKE '%\\Tanium\\%'))
