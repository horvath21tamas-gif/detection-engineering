Image IN ("*\\flashrom.exe", "*\\FPTW64.exe", "*\\AFUWINx64.exe", "*\\UEFITool.exe") OriginalFileName IN ("flashrom.exe", "FPTW64.exe", "AFUWINx64.exe", "UEFITool.exe") CommandLine IN ("* /d *", "* /f *", "* /p *", "* -write*", "* -save*", "* /capsule*", "* /program*", "* /flash*", "*-image*") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe") Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\Desktop\\*") NOT (Image IN ("*C:\\Program Files\\*", "*C:\\Program Files (x86)\\*") ParentImage="*\\svchost.exe" username="NT AUTHORITY\\SYSTEM")
