DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((Parentprocessname =~ "(lsass\.exe|lsm\.exe|csrss\.exe|wininit\.exe|smss\.exe|spoolsv\.exe)$" and processname =~ "(cmd\.exe|powershell\.exe|pwsh\.exe|wscript\.exe|cscript\.exe|sh\.exe|bash\.exe|scrcons\.exe)$") or (Parentprocessname =~ "(chrome\.exe|msedge\.exe|winword\.exe|excel\.exe)$" and processname =~ "(whoami\.exe|nltest\.exe|net\.exe|net1\.exe|ipconfig\.exe)$")) and (not ((processname =~ "(WerFault\.exe|conhost\.exe|csc\.exe)$" or Parentprocesscommandline =~ "svchost\.exe -k" or username =~ "NT AUTHORITY\SYSTEM") or Parentprocessname =~ "(wmiprvse\.exe|taskhostw\.exe|svchost\.exe)$"))