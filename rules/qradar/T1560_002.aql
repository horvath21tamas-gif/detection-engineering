SELECT UTF8(payload) as search_payload from events where ((""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%System.IO.Compression%','%IO.Compression.FileSystem%','%GzipStream%','%BrotliStream%','%ZipArchive%')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND "Process "Process CommandLine"" ILIKE '%Compress-Archive%' AND "Process "Process CommandLine"" ILIKE '%-DestinationPath%') AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Desktop\%','%\Documents\%','%\Downloads\%','%\AppData\Local\Microsoft\Outlook\%','%C:\inetpub\%','%C:\Users\Public\%','%\ProgramData\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%.zip%','%.gz%','%.tar%','%.dat%','%.tmp%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\w3wp.exe','%\httpd.exe','%\winword.exe','%\excel.exe','%\rundll32.exe','%\mshta.exe','%\cmd.exe') OR ""Filename"" ILIKE ENUMERATION('%\AppData\Local\Temp\%','%\Users\Public\%','%\Windows\Temp\%')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe'))) AND NOT (""Filename"" ILIKE ENUMERATION('C:\Program Files\Microsoft Monitoring Agent\%','C:\Program Files\Azure\%','C:\Program Files\Splunk\%','C:\Program Files\Elastic\%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\Visual Studio\%','%\AzureDevOps\%','%\Jenkins\%','%\GitLab\%'))
