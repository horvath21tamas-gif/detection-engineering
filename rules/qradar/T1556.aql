SELECT UTF8(payload) as search_payload from events where (("Target Object" LIKE '%HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa%' OR "Target Object" LIKE '%HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders%' OR "Target Object" LIKE '%HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Authentication%')) AND (("Target Object" LIKE '%\\Authentication Packages%' OR "Target Object" LIKE '%\\Security Packages%' OR "Target Object" LIKE '%\\Providers%' OR "Target Object" LIKE '%\\Credential Providers%')) AND "Target Details" ILIKE '%.dll%' AND (("Target Details" LIKE '%\\Users\\%' OR "Target Details" LIKE '%\\Users\\Public\\%' OR "Target Details" LIKE '%\\ProgramData\\%' OR "Target Details" LIKE '%\\AppData\\%' OR "Target Details" LIKE '%\\Temp\\%')) AND NOT (("Target Details" LIKE '%\\Windows\\System32\\%' OR "Target Details" LIKE '%\\Windows\\SysWOW64\\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\Windows\System32\lsass.exe%','%\Windows\System32\services.exe%','%\Windows\System32\msiexec.exe%','%\Windows\servicing\%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT SERVICE\\TrustedInstaller%'))
