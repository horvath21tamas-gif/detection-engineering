SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%\SYSVOL\%','%\SYSVOL\%','%\Policies\%','%\%\SYSVOL\%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%cpassword%','%Get-GPPPassword%','%gpp-decrypt%','%Groups.xml%','%ScheduledTasks.xml%','%Services.xml%')) AND ((""Filename"" ILIKE ENUMERATION('%\findstr.exe','%\find.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\grep.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Select-String%','%Get-ChildItem%','%dir %','%type %','%gc %')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-EncodedCommand%','%IEX%','%Invoke-Expression%') OR ""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\psexesvc.exe','%\wmiprvse.exe','%\cmd.exe','%\powershell.exe')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT AUTHORITY\\LOCAL SERVICE%' OR "UserName" LIKE '%NT AUTHORITY\\NETWORK SERVICE%')) AND NOT (""Filename"" ILIKE '%\svchost.exe' AND "username" ILIKE 'NT AUTHORITY\SYSTEM%')
