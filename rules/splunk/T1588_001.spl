TargetFilename IN ("*redline*", "*lumma*", "*stealer*", "*agenttesla*", "*remcos*", "*cobaltstrike*", "*brutenratel*", "*ransomware*") OR TargetFilename IN ("*.iso", "*.vhd", "*.vhdx", "*.img", "*.cab") Image IN ("*\\certutil.exe", "*\\bitsadmin.exe", "*\\curl.exe", "*\\wget.exe", "*\\powershell.exe", "*\\pwsh.exe") NOT ((TargetFilename IN ("*\\Windows\\SoftwareDistribution\\*", "*\\Program Files\\*", "*\\Program Files (x86)\\*") User="*SYSTEM*") OR Image IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe"))
