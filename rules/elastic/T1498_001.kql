(process.executable:(*\\hping3.exe OR *\\loic.exe OR *\\hoic.exe OR *\\iperf.exe OR *\\iperf3.exe OR *\\nping.exe OR *\\pktmon.exe)) AND (process.command_line:(*\-\-flood* OR *\-\-syn* OR *\-\-udp* OR *\-u\ \-b\ 0* OR *\-i\ u* OR *\-\-icmp* OR *\-\-rand\-source*)) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\httpd.exe OR *\\chrome.exe OR *\\rundll32.exe OR *\\outlook.exe)) AND (process.executable:(*\\Temp\\* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.executable:(*\\Program\ Files\\NetworkMonitoring\\* OR *\\Azure\\*)) OR (process.command_line:(*Speedtest* OR *HealthCheck*))))
