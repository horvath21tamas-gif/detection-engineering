DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (TargetObject contains "\Software\Microsoft\Office\" and (TargetObject in ("*\Outlook\WebView\URL", "*\Outlook\Security\EnableRoamingFolderHomepages", "*\Outlook\Security\EnableExternalFolderHomepages"))) and ((Details in ("*http*", "*script*", "*file://*", "*C:\Users\Public*", "*C:\Windows\Temp*")) or (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\reg.exe", "*\cscript.exe", "*\wscript.exe"))) and (not ((Details in ("*https://outlook.office365.com*", "*res://*")) and FolderPath endswith "\gpscript.exe"))