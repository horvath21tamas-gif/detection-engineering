SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%Get-AADIntAccessToken%','%roadtoken%','%sekurlsa::cloudap%','%Get-MsGraphToken%','%Request-AzureADToken%') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Microsoft\TokenBroker\%','%\Microsoft\IdentityCRL\%','%\Local Storage\leveldb%')) AND (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\cscript.exe','%\python.exe')) OR (""Filename"" ILIKE ENUMERATION('%\curl.exe','%\wget.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Bearer %','%X-MS-RefreshToken%','%access_token%'))) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Azure-CLI\%','%\Microsoft SDKs\Azure\%')) AND ""Parent Filename"" ILIKE '%\svchost.exe' OR (""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe')) AND "Process "Process CommandLine"" ILIKE '%--type=utility%')
