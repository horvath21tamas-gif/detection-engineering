CommandLine IN ("*ipconfig /flushdns*", "*Clear-DnsClientCache*", "*Remove-DnsClientCache*", "*Flush-DnsClientCache*") CommandLine IN ("*Resolve-DnsName*", "*[System.Net.Dns]::*", "*while(*", "*for(*", "*Start-Sleep*", "*-RetryCount*", "*-Timeout*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\regsvr32.exe", "*\\mshta.exe") NOT (CommandLine IN ("*\\Program Files\\*", "*Microsoft\\Azure*", "*HealthCheck*", "*Chocolatey*", "*_vlmcs._tcp*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\services.exe", "*\\explorer.exe")) | table Time,SourceImage,ParentImage,CommandLine,ProcessId,SourceUsername,DestinationDomain,DestinationIp
