DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((TargetObject matches regex "SCHANNEL\\\\Protocols\\\\TLS 1\\.2\\\\Client\\\\Enabled" or TargetObject matches regex "SCHANNEL\\\\Protocols\\\\TLS 1\\.3\\\\Client\\\\Enabled" or TargetObject matches regex "\\\\.NETFramework\\\\v\\d+\\.\\d+\\\\System\\.Net\\.ServicePointManager\\.SecurityProtocol") and (Details in ("0x00000000", "0x00000030", "0x000000C0"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*ServerCertificateValidationCallback*", "*CheckCertificateRevocationList = $false*", "*[Net.ServicePointManager]::SecurityProtocol =*", "*[System.Net.ServicePointManager]::SecurityProtocol*")))) and ((FolderPath in ("*\Users\*", "*\AppData\Local\Temp\*", "*\Downloads\*", "*\Public\*", "*\Desktop\*")) and (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe"))) and (not (((FolderPath in ("*\msiexec.exe", "*\TrustedInstaller.exe", "*\CcmExec.exe")) and username =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\Google\Chrome\Application\*", "*\Microsoft\Edge\Application\*", "*\Mozilla Firefox\*"))))