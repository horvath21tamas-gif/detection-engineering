SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%SOFTWARE\Microsoft\Netsh%' AND (("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%:\\Windows\\Temp\\%' OR "Target Details" LIKE '%AppData\\%' OR "Target Details" LIKE '%C:\\PerfLogs\\%') OR ""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\reg.exe','%\mshta.exe','%\wscript.exe')) AND NOT (""Filename"" ILIKE ENUMERATION('%\trustedinstaller.exe','%\System32\msiexec.exe','%\System32\netsh.exe') OR "Target Details" ILIKE 'C:\Windows\System32\%' AND "Target Details" ILIKE '%C:\Program Files\%')
