DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*dir /s /b*", "*findstr /s /i /p*", "*where /r *", "*Get-ChildItem -Path C:\ -Recurse*", "*gci -r -include*")) and ((ProcessCommandLine in ("*.kdbx*", "*id_rsa*", "*.key*", "*.pgp*", "*personal.xls*", "*passwords*", "*credentials*", "*.config*", "*.wallet*")) or (ProcessCommandLine in ("*Compress-Archive*", "*7z.exe a*", "*tar.exe -c*", "*rar.exe a*", "*zip -r*"))) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\httpd.exe", "*\explorer.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Program Files\Microsoft VS Code\*", "*C:\Program Files\Everything\*", "*C:\Windows\CCM\*", "*C:\Program Files\Splunk\*")) or username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*SoftwareDistribution*", "*node_modules*"))))