Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*-enc*", "*-encodedcommand*") CommandLine IN ("*-nop*", "*-noni*", "*-windowstyle hidden*", "*-w hidden*") CommandLine IN ("*Invoke-WebRequest*", "*iwr *", "*wget *", "*curl *", "*DownloadString*", "*DownloadFile*", "*Net.WebClient*", "*http://*", "*https://*") CommandLine IN ("*IEX*", "*Invoke-Expression*") NOT (User IN ("*NT AUTHORITY\\SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*") OR ParentImage IN ("*\\Windows\\Installer\\*", "*\\Microsoft Configuration Manager\\*", "*\\Windows\\CCM\\*", "*\\PDQ\\*", "*\\Ivanti\\*", "*\\Tanium\\*", "*\\ManageEngine\\*", "*\\Automation\\*", "*\\Scripts\\*"))
