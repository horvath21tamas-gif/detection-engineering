DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\net.exe", "*\net1.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe")) and (ProcessCommandLine in ("* user *", "*Remove-LocalUser*", "*Remove-ADUser*", "*Disable-LocalUser*", "*Disable-ADAccount*", "*Set-LocalUser -AccountExpires*")) and (ProcessCommandLine in ("* /delete*", "* /active:no*", "* /logoff*")) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\rundll32.exe", "*\explorer.exe")) and (not ((ProcessCommandLine in ("*Add-LocalUser*", "* /add*")) or ParentProcessName endswith "\msiexec.exe" or username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*WDAGUtilityAccount*", "*DefaultAccount*"))))