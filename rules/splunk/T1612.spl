Image IN ("*/docker", "*/docker-compose", "*/buildah", "*/podman", "*/kaniko") CommandLine IN ("* build *", "* build-image *", "* build-using-dockerfile *", "* buildx build *") ParentImage IN ("*/nginx", "*/apache2", "*/httpd", "*/php-fpm", "*/python", "*/node", "*/java", "*/redis-server", "*/mysqld", "*/httpd.worker") OR (CommandLine IN ("* -f -*", "* http://*", "* https://*", "*--no-cache*", "*--privileged*", "*--secret*", "*--ssh*") NOT (username IN ("jenkins", "gitlab-runner", "github-actions", "root") CommandLine IN ("*/home/jenkins*", "*/var/lib/gitlab-runner*", "*/home/github-actions*", "*/home/gitlab-runner*")))
