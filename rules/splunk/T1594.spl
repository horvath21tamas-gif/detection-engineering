Image IN ("*\\trufflehog.exe", "*\\gitleaks.exe", "*\\git-robber.exe", "*\\shhgit.exe", "*\\ripsecrets.exe") OR CommandLine IN ("*github-dorks*", "*git-dump*", "*--scan-all*") OR Image IN ("*\\curl.exe", "*\\wget.exe", "*\\python.exe", "*\\pwsh.exe") OR (CommandLine="*api.github.com*" CommandLine="*/search/*") OR CommandLine IN ("*.env*", "*id_rsa*", "*aws_access_key*", "*connectionstring*") NOT (CommandLine IN ("*git clone*", "*git pull*", "*git fetch*", "*git push*")) NOT (ParentImage IN ("*\\code.exe", "*\\devenv.exe", "*\\idea64.exe")) NOT (ParentImage="*\\explorer.exe" condition="not selection_specialized_tools") NOT (User IN ("*svc_jenkins*", "*svc_devsecops*", "*github-actions*"))
