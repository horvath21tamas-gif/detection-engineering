SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\rdpinit.exe','%\rdpclip.exe','%\wfshell.exe','%\ctxsi.exe','%\vpnui.exe','%\TeamViewer.exe','%\AnyDesk.exe')) AND (""Filename"" ILIKE ENUMERATION('%\nltest.exe','%\whoami.exe','%\net.exe','%\net1.exe','%\qwinsta.exe','%\nslookup.exe','%\arp.exe','%\nbtstat.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% /domain%','% /all%','% /groups%','%dclist%','%trust_dom%','%all-ad-servers%')) AND NOT ("Process "Process CommandLine"" ILIKE '%C:\Windows\System32\GroupPolicy\Machine\Scripts\%' OR ""Filename"" ILIKE '%\gpupdate.exe' OR ""Parent Filename"" ILIKE '%\services.exe')
