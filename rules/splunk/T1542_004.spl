Image IN ("*\\flashrom.exe", "*\\FPTW64.exe", "*\\AFUWINx64.exe", "*\\UEFITool.exe") OR OriginalFileName IN ("FPTW64.exe", "flashrom.exe", "AFUWINx64.exe", "UEFITool.exe") CommandLine IN ("* /d *", "* /f *", "* /p *", "* -write*", "* -save*", "* /capsule*") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe") OR Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Downloads\\*") NOT (Image IN ("*C:\\Program Files\\*", "*C:\\Program Files (x86)\\*") OR ParentImage="*\\svchost.exe" OR username="NT AUTHORITY\\SYSTEM")
