(Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("* -DeleteContent*", "* -Force*", "* -Purge*")) OR CommandLine IN ("*Security*", "*Alert*", "*Phish*", "*Login*") ParentImage IN ("*\\w3wp.exe", "*\\winword.exe", "*\\excel.exe", "*\\mshta.exe", "*\\php-cgi.exe") OR NOT (username="NT AUTHORITY\\SYSTEM" OR CommandLine IN ("*Discovery Management*", "*Compliance*", "*Retention*") OR ParentImage="*\\ExSetup.exe")
