DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("*--dns*", "*--gateway*", "*--lease*", "*--dhcp*", "*dhcp-server*", "*rogue*", "*spoof*")) and (FolderPath in ("*\python.exe", "*\pythonw.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe"))) or (ProcessCommandLine in ("*Responder*", "*bettercap*", "*ettercap*", "*Inveigh*", "*mitm6*"))) and (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and User startswith "NT AUTHORITY\" and (not ((FolderPath in ("C:\Program Files\VMware\*", "C:\Program Files (x86)\VMware\*", "C:\Program Files\Oracle\VirtualBox\*", "C:\Program Files\Docker\*", "C:\Program Files\Microsoft\Hyper-V\*")) or (FolderPath endswith "\System32\svchost.exe" and ProcessCommandLine contains "dhcpssvc") or (FolderPath in ("*\Program Files\Microsoft Configuration Manager\*", "*\Program Files\Wireshark\*", "*\Program Files\nmap\*"))))