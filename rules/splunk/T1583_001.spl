Image IN ("*\\terraform.exe", "*\\pulumi.exe", "*\\aws.exe", "*\\az.exe", "*\\doctl.exe", "*\\gcloud.exe") OR CommandLine IN ("* apply*", "* run-instances*", "* vm create*", "* droplets create*", "* compute instances create*") OR Image IN ("*\\python.exe", "*\\curl.exe") OR (CommandLine="*http*" CommandLine="*api.*") OR CommandLine IN ("*/v2/droplets*", "*ec2.amazonaws.com*", "*management.azure.com*") NOT (User IN ("*svc_jenkins*", "*svc_terraform*", "*gitlab_runner*", "*adm_infra_deploy*") Image IN ("*\\Program Files\\Terraform\\*", "*\\actions-runner\\*")) NOT (ParentImage IN ("*\\code.exe", "*\\devenv.exe", "*\\idea64.exe")) NOT (ParentImage="*\\explorer.exe" condition="not selection_provisioning_ops")
