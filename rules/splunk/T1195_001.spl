ParentImage IN ("*\\node.exe", "*\\npm.cmd", "*\\python.exe", "*\\pip.exe", "*\\msbuild.exe", "*\\dotnet.exe", "*\\csc.exe", "*\\cmake.exe") Image IN ("*\\whoami.exe", "*\\net.exe", "*\\net1.exe", "*\\ipconfig.exe", "*\\nltest.exe", "*\\systeminfo.exe", "*\\nslookup.exe", "*\\certutil.exe") OR CommandLine IN ("*curl *", "*wget *", "*Invoke-WebRequest*", "*DownloadString*", "*env*", "*base64*") NOT (CommandLine="*\\node_modules\\.bin\\*" OR Image="*\\AppData\\Local\\npm-cache\\*" OR Image="*\\site-packages\\*" OR CommandLine="*setup.py install*")
