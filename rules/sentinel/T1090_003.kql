DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("* --SocksPort *", "* --ControlPort *", "* --DataDirectory *", "* -socks5-chain *", "* -forward-chain *", "*proxychains*")) and ((FolderPath in ("*\AppData\*", "*\Temp\*", "*\Users\Public\*", "*\ProgramData\*", "*\Windows\Temp\*")) or (FolderPath in ("*\tor.exe", "*\gost.exe", "*\proxychains.exe", "*\powershell.exe", "*\rundll32.exe"))) and (not ((FolderPath in ("*\Program Files\Tor Browser\*", "*\Program Files\BraveSoftware\*", "*\Program Files (x86)\*")) or ProcessCommandLine contains "127.0.0.1" or User =~ "NT AUTHORITY\SYSTEM"))