SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\verclsid.exe' AND "ImageName"='verclsid.exe' AND (("Integrity Level" LIKE '%Low%' OR "Integrity Level" LIKE '%Medium%')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\ProgramData\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe','%\chrome.exe','%\msedge.exe') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('% /S %','% /C %','%{%','%}%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Public\%'))) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\System32\%','C:\Windows\SysWOW64\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\explorer.exe','%\svchost.exe','%\SearchIndexer.exe')) AND "Integrity Level"='High' OR "username" ILIKE 'NT AUTHORITY\%')
