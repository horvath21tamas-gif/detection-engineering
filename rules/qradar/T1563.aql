SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\tscon.exe' OR "ImageName"='tscon.exe') AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% /dest:%','% /password:%','%dest:console%') OR (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\psexesvc.exe','%\wsmprovhost.exe','%\httpd.exe')) AND "Integrity Level"='System') AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\svchost.exe','%\rdpinit.exe') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%vmsvga%','%Citrix%'))
