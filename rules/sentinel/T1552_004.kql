DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*BEGIN RSA PRIVATE*", "*BEGIN DSA PRIVATE*", "*BEGIN EC PRIVATE*", "*BEGIN OPENSSH PRIVATE*", "*BEGIN PGP PRIVATE*", "*BEGIN PRIVATE KEY*")) or (ProcessCommandLine in ("*.ppk*", "*.pem*", "*.key*", "*.pfx*", "*id_rsa*"))) and ((ProcessCommandLine in ("*findstr*", "*/s*")) or (ProcessCommandLine in ("*grep*", "*-r*")) or (ProcessCommandLine contains "Get-ChildItem" and ProcessCommandLine contains "-Recurse")) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\psexesvc.exe", "*\httpd.exe")) and (FolderPath in ("*\findstr.exe", "*\grep.exe", "*\powershell.exe"))) and (not (username =~ "NT AUTHORITY\SYSTEM" and (FolderPath in ("*\OpenSSH\ssh-agent.exe*", "*\Git\usr\bin\ssh.exe*", "*\Microsoft Visual Studio\*", "*\Windows\System32\certutil.exe*"))))