(process.command_line:(*New\-Object\ \-ComObject\ Outlook.Application* OR *CreateObject\(\"Outlook.Application\"\)* OR *.GetNamespace\(\"MAPI\"\)* OR *GetDefaultFolder\(6\)* OR *GetDefaultFolder\(5\)*)) AND (process.command_line:(*.SaveAs* OR *.Attachments* OR *.Visible\ \=\ $false* OR *.Display\ \=\ 0* OR *SilentlyContinue*)) AND ((process.parent.executable.caseless:(*\\powershell.exe OR *\\cmd.exe OR *\\cscript.exe OR *\\wscript.exe OR *\\mshta.exe)) AND winlog.event_data.IntegrityLevel:Medium) AND (NOT ((process.executable.caseless:(*C\:\\Program\ Files\\Microsoft\ Office\\* OR *C\:\\Program\ Files\ \(x86\)\\Microsoft\ Office\\*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM" OR (process.command_line:(*HealthCheck.ps1* OR *SignatureUpdater* OR *Outlook_Integration*))))
