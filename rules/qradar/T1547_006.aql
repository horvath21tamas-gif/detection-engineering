SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%System\CurrentControlSet\Services\%' AND "Target Object" ILIKE '%\ImagePath' AND "Target Details" ILIKE '%.sys' AND (("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%:\\Windows\\Temp\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%C:\\PerfLogs\\%' OR "Target Details" LIKE '%\\%') OR ""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\reg.exe','%\sc.exe')) AND NOT (""Filename"" ILIKE ENUMERATION('%\trustedinstaller.exe','%\System32\msiexec.exe','%\System32\DriverStore\FileRepository\'))
