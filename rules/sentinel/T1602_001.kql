DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*\C$\*", "*\ADMIN$\*", "*\IPC$\*", "*\print$\*", "*\fax$\*", "*net use*", "*New-PSDrive*")) and ((ProcessCommandLine in ("*.zip*", "*.7z*", "*.rar*", "*.docx*", "*.xlsx*", "*.kdbx*", "*.pst*", "*lsass*", "*ntds.dit*")) or ((FolderPath in ("*\robocopy.exe", "*\xcopy.exe", "*\powershell.exe", "*\pwsh.exe", "*\certutil.exe", "*\bitsadmin.exe", "*\7z.exe", "*\rar.exe")) and (ProcessCommandLine in ("*Compress-Archive*", "* /s *", "* /e *"))) or (ProcessCommandLine in ("*\Users\Public\*", "*\AppData\Local\Temp\*", "*\Windows\Temp\*", "*\PerfLogs\*", "*:\$Recycle.Bin\*")) or (ProcessCommandLine in ("*dir /s*", "*ls -Recurse*", "*findstr*", "*select-string*", "*grep*", "* /s *", "* /e *")) or ((ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\nginx.exe", "*\sqlservr.exe", "*\scrcons.exe", "*\winword.exe", "*\excel.exe")) and IntegrityLevel =~ "Medium")) and (not (((FolderPath in ("*C:\Windows\System32\wbem\WmiPrvSE.exe*", "*C:\Windows\CCM\CcmExec.exe*", "*C:\Program Files\Veeam\*", "*C:\Program Files\Common Files\Microsoft Shared\ClickToRun\*")) and (ProcessCommandLine in ("*SoftwareDistribution*", "*CCMCACHE*"))) or username =~ "NT AUTHORITY\SYSTEM"))