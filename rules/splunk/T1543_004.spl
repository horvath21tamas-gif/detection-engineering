TargetFilename="/Library/LaunchDaemons/*" TargetFilename="*.plist" Image IN ("*/bash", "*/zsh", "*/sh", "*/python3", "*/curl", "*/wget", "*/perl", "*/ruby") OR CommandLine IN ("*/tmp/*", "*/Users/Shared/*", "*base64*", "*nc -e*") NOT ((Image IN ("*/installd", "*/package_script_service", "*/softwareupdated", "*/jamf", "*/kandji-agent") username="root") OR TargetCodeSignature IN ("*Developer ID Application: Google LLC*", "*Developer ID Application: Microsoft Corporation*", "*Software Signing*"))
