
| rex field=CommandLine "(?<CommandLineMatch>(?i).*(\\s(0|1|2)\\b).*)"
| eval CommandLineCondition=if(isnotnull(CommandLineMatch), "true", "false")
| search (Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("* -version 2*", "* -ver 2*", "* -v 2*", "* -Version 2.0*") CommandLine IN ("* -enc*", "* -encodedcommand*", "*FromBase64String*", "*IEX *", "*Invoke-Expression*") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*")) OR (Image IN ("*\\reg.exe", "*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*LmCompatibilityLevel*", "*NtlmMinClientSec*", "*NtlmMinServerSec*", "*RestrictSendingNTLMTraffic*") CommandLineCondition="true") OR CommandLine IN ("*SchUseStrongCrypto*", "*SystemDefaultTlsVersions*", "*SSL 2.0*", "*SSL 3.0*") OR CommandLine IN ("*DisableAntiSpyware*", "*DisableRealtimeMonitoring*", "*Set-MpPreference*") IntegrityLevel IN ("Medium", "High", "System") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe", "*\\php-cgi.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\wmiprvse.exe") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*") NOT (username IN ("NT AUTHORITY\\SYSTEM", "NT AUTHORITY\\NETWORK SERVICE") ParentImage IN ("*\\services.exe*", "*\\svchost.exe*", "*\\CcmExec.exe*", "*\\Program Files\\Microsoft Monitoring Agent\\*") CommandLine IN ("*AzureAD*", "*Exchange*", "*Intune*", "*ConfigurationManager*")) | table Image,ParentImage,CommandLine,IntegrityLevel,User,Hashes
