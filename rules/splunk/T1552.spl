CommandLine IN ("*password=*", "*pwd=*", "*connectionstring*", "*access_key*", "*secret_key*", "*id_rsa*", "*id_dsa*", "*id_ed25519*", "*amzn.mws*", "*BEGIN RSA PRIVATE*", "*BEGIN OPENSSH PRIVATE*", "*BEGIN PGP PRIVATE*") OR (CommandLine IN ("*findstr*", "*/s*", "*/i*") OR CommandLine IN ("*grep*", "*-r*") OR CommandLine IN ("*Get-ChildItem*", "*-Recurse*", "*-Include*") OR CommandLine IN ("*dir*", "*/s*") OR CommandLine IN ("*where*", "*/r*") CommandLine IN ("*.config*", "*.xml*", "*.ini*", "*.yml*", "*.env*", "*.bak*", "*.old*", "*.history*", "*ConsoleHost_history*", "*.aws\\credentials*", "*.ssh\\*", "*.azure\\*", "*.docker\\config.json*")) ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\httpd.exe", "*\\php-cgi.exe", "*\\nginx.exe") Image IN ("*\\findstr.exe", "*\\grep.exe", "*\\powershell.exe") CommandLine IN ("*base64*", "*certutil -encode*", "* > *", "*>>*", "* | clip*", "*curl *", "*wget *", "*scp *", "*Invoke-WebRequest*", "*-enc*", "*-EncodedCommand*", "*IEX*", "*Invoke-Expression*") OR NOT (User IN ("*NT AUTHORITY\\SYSTEM*", "*NT AUTHORITY\\LOCAL SERVICE*", "*NT AUTHORITY\\NETWORK SERVICE*")) NOT (Image IN ("*\\Windows\\System32\\SearchIndexer.exe*", "*\\Microsoft Visual Studio\\*", "*\\Git\\usr\\bin\\grep.exe*", "*\\explorer.exe*") ParentImage="*\\explorer.exe")
