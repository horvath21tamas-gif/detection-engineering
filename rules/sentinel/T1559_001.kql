DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (PipeName in ("*\msagent_*", "*\postex_*", "*\status_*", "*\psexec*", "*\paexec*", "*\remcom*", "*\lsadump*", "*\cachedump*", "*\win_svc*", "*\mypipe*")) or ((PipeName matches regex "^\\\\+[a-f0-9]{8,12}$" and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\powershell_ise.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\mshta.exe")) and (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wscript.exe", "*\cscript.exe"))) and (not (((FolderPath in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*")) and (PipeName in ("*\lsass*", "*\ntsvcs*", "*\scerpc*", "*\epmapper*", "*\atsvc*", "*\spoolss*", "*\srvsvc*"))) or (FolderPath in ("*\vmtoolsd.exe", "*\vboxservice.exe", "*\docker.exe")) or ((FolderPath in ("*\chrome.exe", "*\msedge.exe")) and PipeName matches regex "^\\\\+(chrome|edge|mojo)"))))