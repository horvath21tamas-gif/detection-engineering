(CommandLine IN ("*Remove-Item*", "*Set-Content*", "*Clear-Content*", "*streams.exe*", "*xattr*", "*delete*") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\winword.exe", "*\\excel.exe")) OR CommandLine IN ("*reg add*", "*Set-ItemProperty*") CommandLine IN ("*\\Downloads\\*", "*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Desktop\\*") NOT (Image IN ("C:\\Windows\\System32\\msiexec.exe*", "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe*", "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe*") username="NT AUTHORITY\\SYSTEM")
