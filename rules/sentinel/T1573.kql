DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*AesManaged*", "*RijndaelManaged*", "*CryptoStream*", "*CreateEncryptor*", "*ICryptoTransform*")) and (ProcessCommandLine in ("*Net.Sockets.TcpClient*", "*Net.Sockets.Socket*", "*IO.MemoryStream*")) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe")) and (not ((ProcessCommandLine in ("*C:\Program Files\*", "*Microsoft\Azure*", "*HealthCheck*")) or username =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))