DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ServiceName in ("PSEXECSVC", "PAExec", "RemComSvc", "CSEXEC", "ATSVC")) and (not ((Computer in ("MGMT-*", "SCCM-*", "DEPLOY-*", "ADMIN-*")) or (User in ("*svc_*", "*admin_*", "*deploy*", "*sccm*", "*ansible*", "*pdq*")) or (FolderPath in ("*\Windows\CCM\*", "*\Microsoft Configuration Manager\*", "*\PDQ\*", "*\Ivanti\*", "*\ManageEngine\*", "*\Tanium\*"))))