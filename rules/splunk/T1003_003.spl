(Image="*\\ntdsutil.exe" CommandLine IN ("*ac i ntds*", "* ifm*", "*create f*", "*create h*")) OR (Image="*\\diskshadow.exe" CommandLine="* /s *") OR (Image="*\\esentutl.exe" CommandLine IN ("*/y*", "*/vss*", "*ntds.dit*")) ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wsmprovhost.exe", "*\\psexesvc.exe") OR CommandLine IN ("*\\AppData\\*", "*\\Temp\\*", "*C:\\PerfLogs\\*", "*C:\\Users\\Public\\*", "*\\*") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") username="NT AUTHORITY\\SYSTEM")
