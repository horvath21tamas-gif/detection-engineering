SELECT UTF8(payload) as search_payload from events where (("RequestMethod" LIKE '%POST%' OR "RequestMethod" LIKE '%PUT%')) AND (("cs-uri-stem" LIKE '%.php%' OR "cs-uri-stem" LIKE '%.asp%' OR "cs-uri-stem" LIKE '%.aspx%' OR "cs-uri-stem" LIKE '%.jsp%' OR "cs-uri-stem" LIKE '%.phtml%')) AND (("URL" LIKE '%cmd=%' OR "URL" LIKE '%exec=%' OR "URL" LIKE '%powershell=%' OR "URL" LIKE '%whoami%' OR "URL" LIKE '%net user%' OR "URL" LIKE '%command=%' OR "URL" LIKE '%shell%' OR "URL" LIKE '%curl%' OR "URL" LIKE '%wget%'))