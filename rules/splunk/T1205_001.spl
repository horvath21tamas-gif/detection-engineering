Image IN ("*\\tcpdump.exe", "*\\windump.exe", "*\\scapy.exe", "*\\nmap.exe") OR OriginalFileName IN ("tcpdump.exe", "windump.exe", "scapy.exe") OR CommandLine IN ("*advfirewall firewall add rule*", "*action=allow*", "*protocol=UDP*", "*protocol=ICMP*", "*localport=any*") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe") Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\AppData\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR Image="*C:\\Windows\\System32\\svchost.exe*" OR CommandLine="*description=*")
