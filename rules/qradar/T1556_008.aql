SELECT UTF8(payload) as search_payload from events where (("targetResources.displayName" LIKE '%AnyConnect%' OR "targetResources.displayName" LIKE '%FortiGate%' OR "targetResources.displayName" LIKE '%GlobalProtect%' OR "targetResources.displayName" LIKE '%Check Point%' OR "targetResources.displayName" LIKE '%Pulse Secure%' OR "targetResources.displayName" LIKE '%F5 Big-IP%') OR "operationName"='Update conditional access policy' AND "targetResources.displayName" ILIKE '%MFA%' OR ("operationName" LIKE '%Add owner to application%' OR "operationName" LIKE '%Update application – Certificates and secrets management%')) AND NOT ("initiatedBy.userPrincipalName" ILIKE '%admin_secure@company.com' AND (("userAgent" LIKE '%HashiCorp/1.0%' OR "userAgent" LIKE '%Ansible%')))
