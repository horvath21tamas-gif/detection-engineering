DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\python.exe", "*\pythonw.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*LLMNR*", "*NBTNS*", "*mDNS*", "*Responder*", "*Inveigh*"))) or (((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (ProcessCommandLine in ("*LLMNR*", "*NBTNS*", "*mDNS*", "*Responder*", "*Inveigh*"))) and (not (((FolderPath in ("*\svchost.exe", "*\lsass.exe", "*\System32\nbtstat.exe")) and username =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\Program Files\Wireshark\*", "*\Program Files\Nmap\*", "*\Program Files\CrowdStrike\*")))))