CommandLine IN ("*rest/api/*", "*api/v2/spaces*", "*api/v2/pages*", "*rest/api/2/issue*", "*_vti_bin/lists.asmx*", "*Get-SPO*", "*export-sharepoint*", "*Get-PnP*", "*/wiki/pages/viewpage*", "*.wiki.git*") CommandLine IN ("*export*", "*backup*", "*download-all*", "*recursive*", "*dump*", "*--mirror*", "*--all*", "*--depth*", "*clone*", "*archive*") OR CommandLine IN ("*\\Users\\*", "*\\Temp\\*", "*\\AppData\\Local\\Temp\\*", "*\\Public\\*", "*-OutFile*", "*>*") ParentImage IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\w3wp.exe", "*\\httpd.exe", "*\\python.exe", "*\\node.exe") IntegrityLevel IN ("Medium", "High") NOT (Image IN ("*C:\\Program Files\\Atlassian\\*", "*C:\\Program Files\\Microsoft Monitoring Agent\\*", "*C:\\Windows\\CCM\\*", "*C:\\Program Files\\Elastic\\*", "*C:\\Program Files\\Splunk\\*") OR User IN ("NT AUTHORITY\\SYSTEM*", "DOMAIN\\svc_*", "DOMAIN\\backup_*") OR CommandLine IN ("*healthcheck*", "*ping*", "*--version*", "*-help*")) | table User,Image,ParentImage,CommandLine,IntegrityLevel,CurrentDirectory,Hashes
