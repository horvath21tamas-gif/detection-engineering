Image IN ("*/docker", "*/podman", "*/containerd", "*/ctr", "*/crictl") CommandLine IN ("* run *", "* create *", "* start *") CommandLine IN ("*docker.io/*", "*ghcr.io/*", "*quay.io/*", "*registry.hub.docker.com/*") CommandLine IN ("*:latest*", "*:dev*", "*:test*", "*:debug*") NOT (CommandLine IN ("*registry.corp.local/*", "*harbor.prod.local/*", "*acr.company.com/*")) NOT (ParentImage IN ("*/jenkins*", "*/gitlab-runner*", "*/github-actions*", "*/azure-pipelines*", "*/tekton*")) NOT (CommandLine IN ("*kube-system*", "*istio-system*", "*monitoring*")) NOT (Hostname IN ("*build*", "*ci*", "*runner*"))
