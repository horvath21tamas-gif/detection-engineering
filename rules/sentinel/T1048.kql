DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("* -l 14*", "* -s 14*", "* -R *", "* -L *", "* -D *", "* -X *", "* -N *")) or (FolderPath in ("*\plink.exe", "*\pscp.exe", "*\ncat.exe", "*\nc.exe", "*\socat.exe", "*\iodine.exe"))) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*", "*\PerfLogs\*")) and ProcessCommandLine contains " -pw ") and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*127.0.0.1*", "*localhost*")) or User =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))