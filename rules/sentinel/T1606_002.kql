DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*goldensaml*", "*roadtools*", "*roadtoken*", "*AADInternals*", "*Get-AADIntAccessToken*", "*New-AADIntSAMLToken*", "*Invoke-AADInt*", "*TokenSmith*", "*SAMLSigner*", "*OAuth2Client*")) or (ProcessCommandLine in ("*adfs::dump*", "*adfs::audittrust*", "*Export-AdfsCertificate*", "*Get-AdfsProperties*", "*Get-AdfsCertificate*", "*Microsoft.IdentityServer.Service*", "*ADFSSRV*", "*\ADFS\Configuration*")) or (ProcessCommandLine in ("*sqlcmd*", "*SELECT * FROM IdentityServerPolicy*", "*microsoft##wid*", "*WID*", "*Get-WmiObject -Namespace root\ADFS*")) or (ProcessCommandLine in ("*-exportPFX*", "*-exportp12*", "*Export-PfxCertificate*", "*certutil -store my*", "*certutil -exportPFX*", "*certlm.msc*", "*.pfx*", "*.p12*")) or (ProcessCommandLine in ("*dpapi::masterkey*", "*crypto::certificates*", "*crypto::export*", "*sekurlsa::dpapi*", "*SharpDPAPI*")) or (FolderPath in ("*\mimikatz.exe", "*\pypykatz.exe", "*\Rubeus.exe", "*\SharpDPAPI.exe", "*\Certify.exe"))) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*")) and (ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wsmprovhost.exe", "*\winword.exe", "*\excel.exe")) and IntegrityLevel =~ "Medium") and (not (((FolderPath in ("*\Microsoft.IdentityServer.ServiceHost.exe", "*\Microsoft.IdentityServer.Service.exe", "*\miiserver.exe")) and username =~ "NT AUTHORITY\SYSTEM") or ((ProcessCommandLine in ("*Connect-MgGraph*", "*Connect-AzureAD*", "*az login*", "*Get-MgUser*", "*Get-AzureADUser*")) and ParentProcessName endswith "\explorer.exe")))