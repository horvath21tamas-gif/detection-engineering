Image IN ("*\\aws.exe", "*\\az.exe", "*\\gsutil.exe", "*\\gcloud.exe", "*\\snowball.exe") CommandLine IN ("* s3 sync *", "* storage copy *", "* --access-key *", "* --profile *", "* --request-payer *", "* --no-sign-request *", "* make-public *") OR Image IN ("*\\Users\\*", "*\\Temp\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\php-cgi.exe", "*\\rundll32.exe") NOT (ParentImage IN ("*\\msiexec.exe", "*\\services.exe") OR CommandLine IN ("* terraform *", "* ansible *", "* Jenkins *") OR username="NT AUTHORITY\\SYSTEM")
