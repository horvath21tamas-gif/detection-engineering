(Image="*\\netsh.exe" CommandLine IN ("*trace start*", "*capture=yes*", "*report=yes*", "*persistent=yes*")) OR (Image="*\\pktmon.exe" CommandLine IN ("*start*", "*capture*", "*--etw*", "*--pkt-size*")) OR CommandLine IN ("*npcap*", "*winpcap*", "*packet.dll*", "*wpcap.dll*", "*ndiscap.sys*", "*npf.sys*") OR (Image IN ("*\\tshark.exe", "*\\windump.exe", "*\\ettercap.exe", "*\\bettercap.exe", "*\\dsniff.exe", "*\\tcpdump.exe") CommandLine IN ("*-i *", "*--interface*", "*responder*", "*scapy*", "*-w *")) Image IN ("*\\Users\\*", "*\\Temp\\*", "*\\Downloads\\*", "*\\Public\\*", "*\\AppData\\*") IntegrityLevel="Medium" NOT (Image IN ("*\\Program Files\\Wireshark\\*", "*\\Program Files\\Npcap\\*", "*\\Program Files\\Microsoft Message Analyzer\\*") OR ParentImage IN ("*\\services.exe", "*\\svchost.exe") OR username="NT AUTHORITY\\SYSTEM")
