(process.executable:(*\\vmtoolsd.exe OR *\\vboxmanage.exe OR *\\vboxguest.exe OR *\\hyperv\-daemons.exe OR *\\vmmem.exe)) AND ((process.parent.executable:(*\\cmd.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe)) OR (process.command_line:(*debug\-vm* OR *dump\-guest\-memory* OR *hypercall* OR *\-\-cpuid* OR *in\-out\-instruction* OR *guest\-property*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\services.exe OR *\\svchost.exe))))
