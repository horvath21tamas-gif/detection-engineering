SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon%' AND (("Target Object" LIKE '%\\Userinit%' OR "Target Object" LIKE '%\\Shell%')) AND ("Target Object" ILIKE '%\Userinit' AND (("Target Details" LIKE '%.exe%' OR "Target Details" LIKE '%.dll%' OR "Target Details" LIKE '%.ps1%' OR "Target Details" LIKE '%.bat%')) OR "Target Object" ILIKE '%\Shell' AND "Target Details" ILIKE '%explorer.exe%' OR ("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%C:\\PerfLogs\\%' OR "Target Details" LIKE '%\\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\trustedinstaller.exe','%\msiexec.exe','%\C:\Windows\System32\oobe\msoobe.exe'))
