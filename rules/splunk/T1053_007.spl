Image IN ("*/systemctl", "*/systemd-analyze") CommandLine IN ("*enable*", "*start*", "*daemon-reload*", "*--user*") CommandLine IN ("*base64*", "*curl*", "*wget*", "*python*", "*perl*", "*ruby*", "*nc *", "*sh -c*", "*/tmp/*", "*/var/tmp/*", "*/dev/tcp/*") NOT (ParentImage IN ("*/apt", "*/yum", "*/dnf", "*/dpkg", "*/ansible-playbook", "*/salt-minion") OR (username="root" CommandLine IN ("*apt-daily*", "*motd-news*", "*logrotate*")))
