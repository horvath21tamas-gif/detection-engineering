SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\sdbinst.exe' OR "ImageName"='sdbinst.exe') AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%:\Users\%','%:\ProgramData\%','%:\Windows\Temp\%','%:\Temp\%','%C:\PerfLogs\%') OR ""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\cscript.exe','%\wscript.exe','%\mshta.exe')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\trustedinstaller.exe')) AND "Process "Process CommandLine"" ILIKE '% -u %' AND (""Parent Filename"" ILIKE ENUMERATION('%\AppData\Local\Microsoft\Teams\%','%\AppData\Local\Google\Update\%')))
