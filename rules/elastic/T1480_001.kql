((process.command_line:(*csproduct\ get\ uuid* OR *diskdrive\ get\ serialnumber* OR *bios\ get\ serialnumber* OR *MachineGuid*)) OR (process.command_line:(*get\-adpdmomainsid* OR *objectSid* OR *machineObjectGuid*))) AND ((process.executable:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Downloads\\* OR *\\Public\\*)) OR (process.parent.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\mshta.exe OR *\\winword.exe OR *\\excel.exe))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.executable:(*\\Windows\\System32\\wbem\\WmiPrvSE.exe* OR *\\Windows\\System32\\svchost.exe* OR *\\Program\ Files\\Microsoft\ Monitoring\ Agent\\* OR *\\Program\ Files\\Tanium\\* OR *\\Program\ Files\ \(x86\)\\Kaspersky\ Lab\\*)) OR (process.command_line:(*InTune* OR *AzureAD*))))
