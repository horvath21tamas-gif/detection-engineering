CommandLine IN ("* [System.IO.File]::OpenRead*", "*.Read(*", "* [System.Convert]::ToBase64*", "* -Split *", "* [byte[]]*") OR CommandLine IN ("* -v*", "* -m0*", "* -sdel*", "* -rn*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\csc.exe", "*\\certutil.exe") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*Windows\\Logs*", "*NuGet*") OR username="NT AUTHORITY\\SYSTEM")
