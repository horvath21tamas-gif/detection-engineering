Image IN ("*\\aws.exe", "*\\az.exe", "*\\gcloud.exe") OR CommandLine IN ("* configure *", "* login *", "* account set *", "* iam create-user*", "* adsp *") OR Image IN ("*\\python.exe", "*\\pwsh.exe", "*\\node.exe") OR (CommandLine="*boto3*" CommandLine="*.credentials*") OR CommandLine IN ("*DefaultAzureCredential*", "*GoogleCredentials*") NOT (User IN ("*svc_jenkins*", "*svc_terraform*", "*ansible_worker*") OR Image IN ("*\\Terraform\\*", "*\\Jenkins\\*")) NOT (ParentImage IN ("*\\code.exe", "*\\devenv.exe", "*\\idea64.exe")) NOT username="NT AUTHORITY\\SYSTEM"
