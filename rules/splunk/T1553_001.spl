(Image="*/spctl" CommandLine IN ("*--master-disable*", "*label-disable*")) OR (Image="*/xattr" CommandLine IN ("*-d com.apple.quarantine*", "*-rc com.apple.quarantine*") ParentImage IN ("*/sh", "*/bash", "*/zsh", "*/python", "*/php") CommandLine IN ("*/tmp/*", "*/Users/Shared/*", "*/private/var/tmp/*", "*/Downloads/*")) NOT (ParentImage IN ("/System/Library/*", "/usr/sbin/softwareupdate*", "/Applications/Xcode.app/*"))
