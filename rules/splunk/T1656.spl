(Image="*\\runas.exe" CommandLine IN ("*cmd*", "*powershell*", "*pwsh*", "*temp*", "*\\*")) OR (Image IN ("*\\net.exe", "*\\net1.exe", "*\\powershell.exe") CommandLine IN ("*CEO*", "*CFO*", "*Chief*", "*Admin*", "*Support*", "*Helpdesk*")) ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\w3wp.exe") OR NOT (Image IN ("*\\Program Files\\Remote Monitoring\\*", "*\\Windows\\System32\\CompMgmtLauncher.exe*") OR username="NT AUTHORITY\\SYSTEM" OR CommandLine="*SmartCard*")
