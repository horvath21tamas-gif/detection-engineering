(Image="*\\wevtutil.exe" CommandLine="* /e:false*" CommandLine="* /q*") OR CommandLine IN ("*sc  config eventlog start= disabled*", "*sc.exe  config eventlog start= disabled*", "*net stop \"event log\"*", "*net stop eventlog*", "*Set-Service -Name eventlog -Status Stopped*") OR CommandLine="*0x0*" ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\w3wp.exe", "*\\powershell.exe") OR NOT ((username="NT AUTHORITY\\SYSTEM" ParentImage IN ("*\\services.exe", "*\\svchost.exe", "*\\msiexec.exe")) OR CommandLine IN ("*\\Program Files\\*", "*TrustedInstaller*"))
