CommandLine IN ("*[System.IO.File]::ReadAllBytes*", "*WriteAllBytes*", "*MemoryStream*", "*.ToArray()*", "*b64*") CommandLine IN ("*bxor*", "*-bxor*", "*0x*", "*[Convert]::ToBase64String*") CommandLine IN ("*foreach*", "*Get-ChildItem*", "*-Recurse*", "*-Include*") ParentImage IN ("*\\w3wp.exe", "*\\httpd.exe", "*\\powershell.exe", "*\\cmd.exe") IntegrityLevel="Medium" NOT (Image IN ("*C:\\Program Files\\Microsoft Monitoring Agent\\*", "*C:\\Program Files\\Splunk\\*") OR CommandLine IN ("*HealthCheck*", "*Telemetry*") OR username="NT AUTHORITY\\SYSTEM")
