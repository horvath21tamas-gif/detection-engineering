DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine =~ "(avicap32\.dll|capCreateCaptureWindow|ksuser\.dll|mfplat\.dll|Windows\.Media\.Capture)" or (FolderPath =~ "(ffmpeg\.exe|vlc\.exe)$" and ProcessCommandLine =~ "(-dshow|-f dshow|-video_size|capture)")) and (ParentProcessName =~ "(powershell\.exe|cmd\.exe|w3wp\.exe|rundll32\.exe|regsvr32\.exe)$" and IntegrityLevel =~ "Medium") and (not (FolderPath =~ "(Microsoft Teams|Zoom\.exe|Webex\.exe|Slack\.exe|CameraSettingsUIHost\.exe)" and ProcessCommandLine =~ "(skype\.exe)" and username =~ "NT AUTHORITY\SYSTEM"))