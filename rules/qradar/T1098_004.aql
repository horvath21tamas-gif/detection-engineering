SELECT UTF8(payload) as search_payload from events where "operationNameValue"='Microsoft.Authorization/roleAssignments/write' AND "statusValue"='Success' AND (("properties.requestbody" LIKE '%8e3af657-a8ff-443c-a75c-2fe8c4bcb635%' OR "properties.requestbody" LIKE '%b24988ac-6180-42a0-ab88-20f7382dd24c%' OR "properties.requestbody" LIKE '%18d7d81d-022d-446a-b976-5d3f57fbe149%' OR "properties.requestbody" LIKE '%fdd26090-ad57-4cfb-8440-41a33b7d652d%')) AND "caller" ILIKE '%@%' AND NOT (("caller" LIKE '%MS-PIM%' OR "caller" LIKE '%Azure Privileged Identity Management%' OR "caller" LIKE '%ms-pim@microsoft.com%') OR ("caller" LIKE '%svc-terraform%' OR "caller" LIKE '%github-actions%' OR "caller" LIKE '%azure-devops-deployment%'))
