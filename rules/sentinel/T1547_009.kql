DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (TargetFilename in ("*\Microsoft\Windows\Start Menu\Programs\Startup\*", "*\AppData\Roaming\Microsoft\Internet Explorer\Quick Launch\User Pinned\TaskBar\*", "*\Desktop\*")) and TargetFilename endswith ".lnk" and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\bitsadmin.exe", "*\certutil.exe", "*\rundll32.exe")) and (not ((FolderPath in ("*\msiexec.exe", "*\trustedinstaller.exe", "*\is-*.tmp", "*\setup.exe")) and (FolderPath in ("*\AppData\Local\Microsoft\Teams\*", "*\AppData\Local\Google\Update\*"))))