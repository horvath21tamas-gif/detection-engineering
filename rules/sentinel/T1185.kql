DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (TargetFilename in ("*\Default\Cookies*", "*\Default\Network\Cookies*", "*\Profiles\*.default-release\cookies.sqlite*", "*\Local State*")) and ((FolderPath in ("*\Users\*", "*\Temp\*", "*\AppData\Local\*", "*\AppData\Roaming\*", "*\Public\*")) or (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\cscript.exe", "*\wscript.exe", "*\python.exe"))) and (not ((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\brave.exe", "*\opera.exe")) or ((FolderPath in ("C:\Program Files\*", "C:\Program Files (x86)\*", "C:\Windows\System32\*")) or User =~ "NT AUTHORITY\SYSTEM")))