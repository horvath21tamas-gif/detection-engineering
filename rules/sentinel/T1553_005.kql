DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine contains ":Zone.Identifier" and (ProcessCommandLine in ("*Remove-Item*", "*Set-Content*", "*Clear-Content*", "*streams.exe*", "*cmd /c del*", "*powershell -command*", "*del *")) and (ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe"))) or (ProcessCommandLine in ("*reg add*", "*reg delete*", "*Set-ItemProperty*"))) and (ProcessCommandLine in ("*\Downloads\*", "*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Desktop\*")) and (not ((FolderPath in ("*\msiexec.exe", "*\setup.exe", "*\chrome.exe", "*\msedge.exe")) and username =~ "NT AUTHORITY\SYSTEM"))