winlog.channel:Microsoft\-Windows\-Sysmon\/Operational AND (((winlog.event_data.StartFunction:(*LoadLibraryA* OR *LoadLibraryW*)) OR (NOT _exists_:winlog.event_data.StartModule)) AND (winlog.event_data.TargetImage:(*\\lsass.exe OR *\\svchost.exe OR *\\explorer.exe OR *\\winlogon.exe OR *\\spoolsv.exe)) AND (NOT (winlog.event_data.Sourceprocessname:C\:\\Windows\\System32\\csrss.exe OR (process.executable:(*\\MsMpEng.exe OR *\\CcmExec.exe)) OR (winlog.event_data.Sourceusername:NT\ AUTHORITY\\SYSTEM AND winlog.event_data.Targetprocessname:C\:\\Windows\\System32\\svchost.exe))))
