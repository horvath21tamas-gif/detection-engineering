SELECT UTF8(payload) as search_payload from events where (("Process "Process CommandLine"" ILIKE ENUMERATION('%asreproast%','% /user:%')) AND ""Filename"" ILIKE '%\rubeus.exe' OR "Process "Process CommandLine"" ILIKE ENUMERATION('%GetNPUsers%','%-no-pass%','%-format hashcat%','%-format john%') OR "Process "Process CommandLine"" ILIKE '%Get-DomainUser%' AND "Process "Process CommandLine"" ILIKE '%DONT_REQ_PREAUTH%' OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%1.2.840.113556.1.4.803:=4194304%','%userAccountControl:1.2.840.113556.1.4.803:=4194304%','%-band 4194304%','%0x400000%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%/format:hashcat%','%/format:john%','%/outfile:%','%.hash%','%.txt%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wsmprovhost.exe','%\wmiprvse.exe','%\httpd.exe','%\w3wp.exe','%\mshta.exe','%\rundll32.exe')) AND NOT ("username" ILIKE 'NT AUTHORITY%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe','%\lsass.exe'))) AND NOT (""Filename"" ILIKE ENUMERATION('%\RSAT\%','%\Active Directory\%','%\Microsoft Monitoring Agent\%'))
