DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\reg.exe", "*\wmic.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Get-Culture*", "*Get-WinSystemLocale*", "*Get-KeyboardLayout*", "*os get MUILanguages*", "*Get-ItemProperty*"))) or (ProcessCommandLine in ("*Keyboard Layout\Preload*", "*Control Panel\International*", "*00000409*", "*00000419*", "*00000422*", "*00000423*"))) and (((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\powershell.exe")) and IntegrityLevel =~ "Medium") or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Temp\*")) or (ProcessCommandLine in ("*findstr*", "*select-string*", "* > *", "*| Out-File*", "*ConvertTo-Json*", "*Export-Csv*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\msiexec.exe", "*\CcmExec.exe", "*\svchost.exe")) or (ProcessCommandLine in ("*Program Files*", "*\Windows\System32\*"))))