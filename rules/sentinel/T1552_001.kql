DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*findstr*", "*/s*")) or (ProcessCommandLine in ("*grep*", "*-r*")) or (ProcessCommandLine in ("*Get-ChildItem*", "*-Recurse*")) or (ProcessCommandLine in ("*dir*", "*/s*")) or (ProcessCommandLine in ("*where*", "*/r*"))) and (ProcessCommandLine in ("*.config*", "*.xml*", "*.json*", "*.yml*", "*.env*", "*.unattend*", "*.git\config*", "*.aws\credentials*", "*.azure\azureProfile.json*", "*id_rsa*", "*id_dsa*", "*id_ed25519*", "*password=*", "*access_key*", "*secret_key*")) and (((ParentProcessName in ("*\wsmprovhost.exe", "*\psexesvc.exe", "*\httpd.exe", "*\php-cgi.exe", "*\nginx.exe", "*\powershell.exe", "*\cmd.exe")) and (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*"))) or (ProcessCommandLine in ("*base64*", "*certutil -encode*", "* > *", "*>>*", "* | clip*", "*curl *", "*wget *", "*scp *", "*Invoke-WebRequest*", "*-enc*", "*-EncodedCommand*", "*IEX*", "*Invoke-Expression*"))) and (not (User in ("*NT AUTHORITY\SYSTEM*", "*NT AUTHORITY\LOCAL SERVICE*", "*NT AUTHORITY\NETWORK SERVICE*"))) and (not ((FolderPath in ("*\Windows\System32\SearchIndexer.exe*", "*\Windows\System32\CompatTelRunner.exe*", "*\Microsoft Visual Studio\*", "*\Git\usr\bin\git.exe*")) and ParentProcessName endswith "\explorer.exe"))