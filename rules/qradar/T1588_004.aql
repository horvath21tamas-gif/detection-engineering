SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\certutil.exe','%\certmgr.exe','%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-addstore%','%Import-Certificate%','%-importCertificate%','%Install-Certificate%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% Root%','% AuthRoot%','% Disallowed%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\msiexec.exe','%\CcmExec.exe','%\setup.exe')) AND "username" ILIKE '%SYSTEM%' OR ""Filename"" ILIKE ENUMERATION('%\SentinelOne\%','%\CrowdStrike\%','%\Cisco\AnyConnect\%'))
