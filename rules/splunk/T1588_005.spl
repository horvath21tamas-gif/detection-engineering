TargetFilename IN ("*CVE-20*", "*\\exploit*", "*\\poc_code*", "*\\lpe_x64*", "*\\rce_exploit*", "*\\cve_20*", "*\\metasploit*", "*\\msfvenom*") Image IN ("*\\curl.exe", "*\\wget.exe", "*\\certutil.exe", "*\\bitsadmin.exe", "*\\powershell.exe", "*\\pwsh.exe") NOT (TargetFilename IN ("*\\src\\*", "*\\repos\\*", "*\\github.com\\*", "*\\Visual Studio\\*", "*\\node_modules\\*", "*\\pip-install-*", "*\\AppData\\Local\\Temp\\build-*") OR (Image IN ("*\\Nessus\\*", "*\\Qualys\\*", "*\\Rapid7\\*") UserName IN ("*SVC_Scanner*", "*SYSTEM*")))
