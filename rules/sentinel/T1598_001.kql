DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ParentProcessName in ("*\outlook.exe", "*\teams.exe", "*\slack.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe"))) and (ProcessCommandLine in ("*redirect_uri=*", "*client_id=*", "*response_type=token*", "*login_hint=*", "*verify-account*", "*password-reset*", "*azure-edge.net*"))) or ((((FolderPath in ("*\chrome.exe", "*\msedge.exe", "*\firefox.exe")) and (ProcessCommandLine in ("*--incognito*", "*--inprivate*", "*--new-window*", "*--headless*"))) and (ProcessCommandLine in ("*redirect_uri=*", "*client_id=*", "*response_type=token*", "*login_hint=*", "*verify-account*", "*password-reset*", "*azure-edge.net*")) and (not (ProcessCommandLine in ("*login.microsoftonline.com*", "*okta.com*", "*duosecurity.com*", "*auth.*")))) and (not (ProcessCommandLine in ("*office.com/setup*", "*akamai.net*", "*windowsupdate.com*"))) and (not (ProcessCommandLine in ("*.local*", "*.lan*", "*http://10.*", "*http://192.168.*"))))