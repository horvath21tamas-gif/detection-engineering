SELECT UTF8(payload) as search_payload from events where ("Image" ILIKE ENUMERATION('%\schtasks.exe','%\at.exe','%\powershell.exe','%\cmd.exe')) AND ("Process CommandLine" ILIKE ENUMERATION('%schtasks%','%/create%','%/sc%','%Register-ScheduledTask%','%New-ScheduledTask%','%at %')) AND ("Process CommandLine" ILIKE ENUMERATION('%\AppData\%','%\Users\Public\%','%\ProgramData\%','%\Temp\%','%powershell%','%cmd.exe%','%wscript%','%cscript%','%mshta%','%rundll32%','%.ps1%','%.vbs%','%.js%')) AND NOT ("username" ILIKE ENUMERATION('%SYSTEM%','%LOCAL SERVICE%','%NETWORK SERVICE%') OR "Process CommandLine" ILIKE ENUMERATION('%\Microsoft\Windows\%','%Windows Defender%','%OneDrive%','%GoogleUpdate%','%Adobe%'))
