Image IN ("*\\curl.exe", "*\\wget.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\bitsadmin.exe", "*\\certutil.exe") CommandLine IN ("* -F *", "* --data-binary*", "* -T *", "* --upload-file*", "*UploadFile(*", "*PutAsync(*", "*PostAsync(*", "*Invoke-WebRequest*", "*Invoke-RestMethod*") OR CommandLine IN ("* -k*", "* --insecure*", "* -SkipCertificateCheck*", "* -UseBasicParsing*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\explorer.exe") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*microsoft.com*", "*office.com*", "*windowsupdate.com*", "*127.0.0.1*", "*localhost*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
