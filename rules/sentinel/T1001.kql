DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*GetPixel*", "*LockBits*", "*Bitmap.new*", "*System.Drawing.*", "*windowscodecs.dll*")) and ((FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\rundll32.exe", "*\mshta.exe", "*\cscript.exe", "*\wscript.exe")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\w3wp.exe"))) and (not ((FolderPath in ("*\Adobe\*", "*\Microsoft Office\*", "*\PhotosApp.exe*", "*\Snagit\*")) and ProcessCommandLine contains "C:\Program Files\" and username =~ "NT AUTHORITY\SYSTEM"))