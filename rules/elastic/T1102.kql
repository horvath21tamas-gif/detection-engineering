(process.command_line:(*api.github.com* OR *raw.githubusercontent.com* OR *api.telegram.org* OR *discord.com\/api\/webhooks* OR *pastebin.com\/raw\/* OR *gist.githubusercontent.com* OR *drive.google.com\/uc*)) AND ((process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\curl.exe OR *\\certutil.exe OR *\\bitsadmin.exe OR *\\rundll32.exe OR *\\regsvr32.exe OR *\\mshta.exe)) OR (process.executable.caseless:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Windows\\Temp\\* OR *\\Users\\Public\\*))) AND (NOT ((process.executable.caseless:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) AND (process.command_line:(*chocolatey* OR *scoop* OR *winget*)) AND winlog.event_data.username:"NT AUTHORITY\\SYSTEM"))
