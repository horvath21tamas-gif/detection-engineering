SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/kubectl','%/docker','%/crictl','%/nerdctl')) AND (""Process CommandLine"" ILIKE ENUMERATION('%auth can-i%','%get secrets%','%describe pod%','%inspect%','%get nodes%')) AND ((""Parent Filename"" ILIKE ENUMERATION('%/www-data%','%/nginx%','%/httpd%','%/php-fpm%','%/python%')) AND "username"='root' OR ""Process CommandLine"" ILIKE ENUMERATION('%--format json%','%-o json%','% | jq%','% > %')) AND NOT ((""Filename"" ILIKE ENUMERATION('%/usr/bin/kubelet%','%/datadog-agent%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%get pods --watch%','%--version%')))
