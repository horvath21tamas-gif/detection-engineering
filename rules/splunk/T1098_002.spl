Operation IN ("Add-MailboxPermission", "Add-RecipientPermission") AccessRights IN ("*FullAccess*", "*SendAs*", "*SendOnBehalf*") UserId="*admin-*" OR ClientIPAddress="*10.50.*" OR TargetUser IN ("*ceo*", "*cfo*", "*director*", "*legal*", "*finance*") NOT ((UserId IN ("NT AUTHORITY\\SYSTEM", "Microsoft.Exchange.ServiceMS") UserAgent="*ExchangeConfiguration/15*") OR UserId IN ("*svc-backup-cloud*", "*it-automation-principal*"))
