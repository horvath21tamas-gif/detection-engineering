SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\wsmprovhost.exe','%\installutil.exe','%\regasm.exe','%\regsvcs.exe','%\mshta.exe','%\dotnet.exe')) AND "Process "Process CommandLine"" ILIKE '%COR_ENABLE_PROFILING=1%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%COR_PROFILER=%','%COR_PROFILER_PATH=%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\Users\Public\%','%\AppData\%','%\Temp\%','%\ProgramData\%')) AND NOT ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Windows\Microsoft.NET\%','%\Program Files\Microsoft Visual Studio\%','%\Program Files (x86)\Microsoft Visual Studio\%','%\VSPerf%','%\PerfWatson%','%\Application Insights%','%\Datadog%','%\NewRelic%','%\Dynatrace%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\devenv.exe','%\vsjitdebugger.exe','%\msbuild.exe','%\vstest.console.exe','%\dotnet-test.exe')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell_ise.exe'))
