((process.command_line:(*\[System.IO.File\]\:\:ReadAllBytes* OR *WriteAllBytes* OR *MemoryStream* OR *.ToArray\(\)* OR *b64*)) AND (process.command_line:(*bxor* OR *\-bxor* OR *0x* OR *\[Convert\]\:\:ToBase64String*)) AND (process.command_line:(*foreach* OR *Get\-ChildItem* OR *\-Recurse* OR *\-Include*))) AND ((process.parent.executable:(*\\w3wp.exe OR *\\httpd.exe OR *\\powershell.exe OR *\\cmd.exe)) AND winlog.event_data.IntegrityLevel:Medium) AND (NOT ((process.executable:(*C\:\\Program\ Files\\Microsoft\ Monitoring\ Agent\\* OR *C\:\\Program\ Files\\Splunk\\*)) OR (process.command_line:(*HealthCheck* OR *Telemetry*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM))
