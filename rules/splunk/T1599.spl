Message IN ("*nat (inside,outside)*", "*static-nat*", "*set system bridge*", "*add bridge-group*", "*port-forwarding*", "*virtual-server*") Message IN ("*port 22*", "*port 3389*", "*port 445*", "*port 5985*", "*port 3306*") Message IN ("*web-console*", "*http-admin*", "*ssh-session*", "*local-user*") NOT (SourceIP IN ("10.50.0.10", "10.50.0.11") OR Message IN ("*vpn-pool*", "*dynamic-pat*", "*ipsec-nat-t*"))
