SELECT UTF8(payload) as search_payload from events where (("Target Object" LIKE '%\\Software\\Microsoft\\Office\\Outlook\\Addins\\%' OR "Target Object" LIKE '%\\Software\\Classes\\CLSID\\%' OR "Target Object" LIKE '%\\Software\\Microsoft\\Windows Messaging Subsystem\\MSMapiApps%')) AND (("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%:\\Windows\\Temp\\%' OR "Target Details" LIKE '%C:\\PerfLogs\\%') OR ""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\reg.exe','%\cscript.exe','%\wscript.exe','%\mshta.exe')) AND NOT (""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe') OR ("Target Details" LIKE '%C:\\Program Files\\%' OR "Target Details" LIKE '%C:\\Program Files (x86%')\%'))
