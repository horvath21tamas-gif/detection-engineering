SELECT UTF8(payload) as search_payload from events where (""Process CommandLine"" ILIKE ENUMERATION('%LD_PRELOAD=%','%LD_LIBRARY_PATH=%')) AND (""Filename"" ILIKE ENUMERATION('%/sudo','%/pkexec','%/su','%/mount','%/umount','%/passwd','%/chsh','%/newgrp')) AND (""Process CommandLine"" ILIKE ENUMERATION('%.so%','%/tmp/%','%/var/tmp/%','%/dev/shm/%','%/home/%','%/run/user/%')) AND NOT (""Process CommandLine"" ILIKE ENUMERATION('%/lib/%','%/lib64/%','%/usr/lib/%','%/usr/lib64/%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/bash','%/zsh','%/fish'))
