DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((((FolderPath in ("*\reg.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("* add *", "*Set-ItemProperty*", "*New-ItemProperty*"))) and (ProcessCommandLine in ("*Control Panel\Desktop\Wallpaper*", "*Microsoft\Windows\CurrentVersion\Policies\System*", "*legalnoticecaption*", "*legalnoticetext*"))) or ((FolderPath in ("*\cmd.exe", "*\xcopy.exe", "*\robocopy.exe")) and (ProcessCommandLine in ("*Windows\Web\Wallpaper*", "*.jpg*", "*.png*", "* /y*")))) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\rundll32.exe", "*\explorer.exe")) and (not ((ParentProcessName in ("*\CcmExec.exe", "*\gpscript.exe")) or ProcessCommandLine contains "company_logo" or username =~ "NT AUTHORITY\SYSTEM"))