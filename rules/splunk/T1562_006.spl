(Image="*\\logman.exe" CommandLine="* stop *" CommandLine IN ("*EventLog-System*", "*EventLog-Security*", "*Microsoft-Windows-DotNETRuntime*", "*Microsoft-Windows-Web-Http*", "*NT Kernel Logger*", "*Circular Kernel Context Logger*")) OR (Image="*\\logman.exe" CommandLine="* delete *" CommandLine IN ("*EventLog*", "*Kernel*", "*trace*")) OR (Image="*\\wecutil.exe" CommandLine="* /e:false*") OR (Image="*\\wecutil.exe" CommandLine="* ds *" CommandLine="*Subscription*") OR (Image="*\\netsh.exe" CommandLine="*advfirewall*" CommandLine="*add rule*" CommandLine="*block*" CommandLine="*remoteport=443*" CommandLine IN ("*remoteip=*", "*defender*", "*security*", "*edr*", "*telemetry*", "*crowdstrike*", "*sentinel*", "*carbonblack*")) OR (Image="*\\powershell.exe" CommandLine="*New-NetFirewallRule*" CommandLine="*-Action Block*" CommandLine="*-Direction Outbound*" CommandLine IN ("*443*", "*defender*", "*security*", "*edr*", "*telemetry*", "*crowdstrike*", "*sentinel*", "*carbonblack*")) NOT (CommandLine IN ("*Microsoft Monitoring Agent*", "*SplunkUniversalForwarder*", "*AzureMonitorAgent*", "*Elastic Agent*", "*SCOM*", "*Defender for Endpoint*", "*Docker*")) NOT (User="NT AUTHORITY*" ParentImage="*\\services.exe") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe", "*\\rundll32.exe", "*\\mshta.exe")
