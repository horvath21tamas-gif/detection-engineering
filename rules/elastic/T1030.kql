((process.command_line:(*\ \[System.IO.File\]\:\:OpenRead* OR *.Read\(* OR *\ \[System.Convert\]\:\:ToBase64* OR *\ \-Split\ * OR *\ \[byte\[\]\]*)) OR (process.command_line:(*\ \-v* OR *\ \-m0* OR *\ \-sdel* OR *\ \-rn*))) AND ((process.executable.caseless:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Public\\*)) AND (process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\csc.exe OR *\\certutil.exe))) AND (NOT ((process.executable.caseless:(*\\Program\ Files\\* OR *\\Program\ Files\ \(x86\)\\*)) OR (process.command_line:(*Windows\\Logs* OR *NuGet*)) OR (winlog.event_data.username:("NT AUTHORITY\\SYSTEM" OR "NT AUTHORITY\\LOCAL SERVICE" OR "NT AUTHORITY\\NETWORK SERVICE"))))
