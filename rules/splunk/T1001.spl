CommandLine IN ("*GetPixel*", "*LockBits*", "*Bitmap.new*", "*System.Drawing.*", "*windowscodecs.dll*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\mshta.exe", "*\\cscript.exe", "*\\wscript.exe") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\w3wp.exe") NOT (Image IN ("*\\Adobe\\*", "*\\Microsoft Office\\*", "*\\PhotosApp.exe*", "*\\Snagit\\*") CommandLine="*C:\\Program Files\\*" username="NT AUTHORITY\\SYSTEM")
