SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%/PlistBuddy','%/defaults','%/plutil')) AND (""Process CommandLine"" ILIKE ENUMERATION('%RunAtLoad%','%ProgramArguments%','%StartCalendarInterval%','%KeepAlive%','%Label%','%LaunchEvents%') OR ""Process CommandLine"" ILIKE ENUMERATION('%/LaunchAgents%','%/LaunchDaemons%','%/Preferences/com.apple.loginitems.plist%','%/Library/StartupItems%')) AND (""Parent Filename"" ILIKE ENUMERATION('%/Safari.app/%','%/Google Chrome.app/%','%/Microsoft Word.app/%','%/Terminal.app/%','%/iTerm.app/%') OR NOT ((""Filename"" ILIKE ENUMERATION('/usr/sbin/softwareupdate%','/System/Library/PrivateFrameworks/%')) AND (""Parent Filename"" ILIKE ENUMERATION('/System/Library/CoreServices/%','/usr/libexec/xpcproxy%'))))
