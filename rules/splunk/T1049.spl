Image IN ("*\\netstat.exe", "*\\net.exe", "*\\net1.exe", "*\\nbtstat.exe", "*\\arp.exe") OR CommandLine IN ("*Get-NetTCPConnection*", "*Get-NetUDPEndpoint*", "*Get-NetIPAddress*", "*Get-NetRoute*", "*net session*", "*net use*", "*net view*") CommandLine IN ("* -ano*", "* -na *", "* -p tcp*", "* -s *", "* /domain*") OR (ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\httpd.exe", "*\\wsmprovhost.exe") IntegrityLevel="Medium") OR CommandLine IN ("*findstr*", "*select-string*", "* > *", "* >> *", "*ConvertTo-Json*", "*Out-File*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\svchost.exe", "*\\CcmExec.exe", "*\\msiexec.exe") OR CommandLine IN ("*Program Files*", "*Splunk*", "*healthcheck*"))
