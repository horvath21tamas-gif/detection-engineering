GrantedAccess IN ("*0x1410*", "*0x1411*", "*0x1438*", "*0x143a*", "*0x1F1FFF*") TargetImage IN ("*\\explorer.exe", "*\\taskmgr.exe", "*\\mmc.exe", "*\\dllhost.exe") CallTrace="*unknown*" SourceImage IN ("*\\Users\\*", "*\\Temp\\*", "*\\AppData\\*") NOT (SourceProcessName="C:\\Windows\\System32\\csrss.exe" OR SourceImage IN ("*\\MsMpEng.exe", "*\\CcmExec.exe") OR CallTrace IN ("*comctl32.dll+*", "*user32.dll+*", "*ntdll.dll+LdrpWorkItem*") OR condition="SourceProcessName == TargetImage")
