SELECT Time, SourceImage, "Parent Filename", Process "Process CommandLine", SourceUsername from events where (""Filename"" ILIKE ENUMERATION('%\docker.exe','%\dockerd.exe','%\VBoxManage.exe','%\VBoxHeadless.exe','%\vmrun.exe','%\vmware-kvm.exe','%\vboxmanage.exe','%\qemu-system-x86_64.exe')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\w3wp.exe','%\php-cgi.exe','%\httpd.exe','%\nginx.exe','%\mshta.exe','%\powershell.exe','%\cmd.exe') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%--rm%','%--privileged%','%--net=host%','%--entrypoint%','%--device%','%nogui%','%startvm%','% -it %','%--detach%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\Common7\IDE\devenv.exe%','%\bin\code.exe%','%\Program Files\Docker\%','%\Program Files\VMware\%','%\Program Files\VirtualBox\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%docker-desktop%','%docker-compose%','%minikube%','%vagrant%')))
