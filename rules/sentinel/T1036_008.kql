DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\wscript.exe", "*\cscript.exe", "*\powershell.exe", "*\pwsh.exe", "*\regsvr32.exe", "*\mshta.exe", "*\rundll32.exe")) and (ProcessCommandLine in ("*.jpg*", "*.jpeg*", "*.png*", "*.gif*", "*.txt*", "*.log*", "*.pdf*", "*.docx*", "*.xlsx*", "*.tmp*", "*.ini*", "*.dat*", "*.cfg*"))) and ((ProcessCommandLine in ("*\Users\*", "*\ProgramData\*", "*\Temp\*", "*\Windows\Temp\*", "*\Downloads\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\winrar.exe", "*\7zFM.exe", "*\explorer.exe"))) and (not ((username =~ "NT AUTHORITY\SYSTEM" and ParentProcessName endswith "\services.exe") or (ProcessCommandLine in ("*C:\Windows\ccmcache\*", "*healthcheck.txt*", "*Telemetry*")) or ParentProcessName endswith "\msiexec.exe"))