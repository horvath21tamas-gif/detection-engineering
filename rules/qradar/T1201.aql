SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\net.exe','%\net1.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%accounts%','%Get-DomainPolicy%','%Get-ADDefaultDomainPasswordPolicy%','%Get-ADFineGrainedPasswordPolicy%','%Get-ADAccountResultantPasswordPolicy%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%lockoutthreshold%','%minpwdlength%','%lockoutduration%','%pwdcomplexity%','%maxpwdage%','%minpwdage%','%historycount%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% > %','%ConvertTo-Json%','%Export-Csv%','%Out-File%') OR (""Parent Filename"" ILIKE ENUMERATION('%\wsmprovhost.exe','%\httpd.exe','%\winword.exe','%\excel.exe','%\powershell.exe','%\pwsh.exe')) AND "Integrity Level"='Medium') AND NOT ("username" ILIKE 'NT AUTHORITY\%' AND "Computer Name" ILIKE '%DC-%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%logon.bat%','%Program Files%','%GroupPolicy%')) AND ""Filename"" ILIKE '%\Windows\System32\%')
