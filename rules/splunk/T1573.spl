CommandLine IN ("*AesManaged*", "*RijndaelManaged*", "*CryptoStream*", "*CreateEncryptor*", "*ICryptoTransform*", "*CreateDecryptor*") CommandLine IN ("*Net.Sockets.TcpClient*", "*Net.Sockets.Socket*", "*IO.MemoryStream*", "*NetworkStream*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe") NOT (CommandLine IN ("*C:\\Program Files\\*", "*Microsoft\\Azure*", "*HealthCheck*", "*SoftwareDistribution*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\services.exe", "*\\explorer.exe")) | table Time,SourceImage,SourceUsername,ParentImage,CommandLine,ProcessId,ThreadId
