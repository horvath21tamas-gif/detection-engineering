(process.command_line:(SigmaRegularExpression\(regexp\=SigmaString\(\['\(',\ \<SpecialChars.WILDCARD_SINGLE\:\ 2\>,\ 'i\)\(\[\\s\\t,;\]\{50,\}\)'\]\),\ flags\=set\(\)\) OR SigmaRegularExpression\(regexp\=SigmaString\(\['\(',\ \<SpecialChars.WILDCARD_SINGLE\:\ 2\>,\ 'i\)\(set\\s\+\[a\-z0\-9\]\{1,3\}\=\\s',\ \<SpecialChars.WILDCARD_MULTI\:\ 1\>,\ '\[\^\&\]\{1,5\}\&\[\\s\\t\]',\ \<SpecialChars.WILDCARD_MULTI\:\ 1\>,\ '\)\{8,\}'\]\),\ flags\=set\(\)\) OR SigmaRegularExpression\(regexp\=SigmaString\(\['\(',\ \<SpecialChars.WILDCARD_SINGLE\:\ 2\>,\ 'i\)\(\[\\%\\\!\\\^\\`\]\{3,\}.',\ \<SpecialChars.WILDCARD_MULTI\:\ 1\>,\ '\)\{5,\}'\]\),\ flags\=set\(\)\))) AND (process.executable:(*\\powershell.exe OR *\\cmd.exe OR *\\cscript.exe OR *\\wscript.exe OR *\\mshta.exe OR *\\rundll32.exe)) AND (NOT ((process.executable:(*\\Windows\\System32\\wbem\\WmiPrvSE.exe* OR *\\Program\ Files\\* OR *\\Windows\\System32\\msiexec.exe*)) OR (process.command_line:(*Microsoft.Cloud.Data* OR *chocolatey*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM))
