SELECT UTF8(payload) as search_payload from events where "TargetImage" ILIKE '%\lsass.exe' AND (("Granted Access" LIKE '%0x10%' OR "Granted Access" LIKE '%0x30%' OR "Granted Access" LIKE '%0x50%' OR "Granted Access" LIKE '%0x1fffff%')) AND (("Image" LIKE '%\procdump.exe%' OR "Image" LIKE '%\rundll32.exe%' OR "Image" LIKE '%\taskmgr.exe%'))
