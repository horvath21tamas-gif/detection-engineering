DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\flashrom.exe", "*\FPTW64.exe", "*\AFUWINx64.exe", "*\UEFITool.exe")) and (OriginalFileName in ("flashrom.exe", "FPTW64.exe", "AFUWINx64.exe", "UEFITool.exe"))) and (ProcessCommandLine in ("* /d *", "* /f *", "* /p *", "* -write*", "* -save*", "* /capsule*", "* /program*", "* /flash*", "*-image*")) and ((ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe")) and (FolderPath in ("*\Users\*", "*\Temp\*", "*\Downloads\*", "*\Desktop\*"))) and (not ((FolderPath in ("*C:\Program Files\*", "*C:\Program Files (x86)\*")) and ParentProcessName endswith "\svchost.exe" and username =~ "NT AUTHORITY\SYSTEM"))