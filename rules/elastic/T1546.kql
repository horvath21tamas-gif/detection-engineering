winlog.channel:Microsoft\-Windows\-Sysmon\/Operational AND ((event.code:(19 OR 20 OR 21)) AND ((process.executable.caseless:*CommandLineEventConsumer* OR process.executable.caseless:*ActiveScriptEventConsumer* OR (winlog.event_data.CommandLine:(*powershell* OR *\ \-enc\ * OR *\ \-e\ * OR *bypass* OR *iex\(* OR *WScript.Shell* OR *system.net.webclient* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\*))) OR (process.executable.caseless:(*\\powershell.exe OR *\\cmd.exe OR *\\w3wp.exe OR *\\winword.exe OR *\\excel.exe))) AND (NOT (((process.executable.caseless:(*\\CcmExec.exe OR *\\MonitoringHost.exe OR *\\svchost.exe OR *\\msiexec.exe)) AND winlog.event_data.username:"NT AUTHORITY\\SYSTEM") OR (winlog.event_data.CommandLine:(*Inventory* OR *UpdateChecker* OR *HealthCheck*)))))
