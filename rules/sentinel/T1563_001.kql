DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\tscon.exe" and OriginalFileName =~ "tscon.exe") and ((ProcessCommandLine in ("* /dest:console*", "*dest:rdp-tcp#*", "* /password*")) or ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\psexesvc.exe", "*\wsmprovhost.exe", "*\winword.exe")) and IntegrityLevel =~ "System")) and (not ((ParentProcessName in ("*\svchost.exe", "*\winlogon.exe")) and (ProcessCommandLine in ("*vmsvga*", "*Citrix*", "*C:\Program Files\*")) and username =~ "NT AUTHORITY\NETWORK SERVICE"))