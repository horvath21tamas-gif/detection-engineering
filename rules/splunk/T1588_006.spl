TargetFilename IN ("*pentest_final_report*", "*internal_audit_security*", "*vulnerability_assessment*", "*exploit_chain*", "*0day_poc*", "*zero-day_research*", "*exploit_writeup*") Image IN ("*\\curl.exe", "*\\wget.exe", "*\\certutil.exe", "*\\powershell.exe", "*\\pwsh.exe") NOT ((TargetFilename IN ("*\\Compliance\\*", "*\\GRC_Reports\\*", "*\\Security_Audit_20*") UserName IN ("*sec_admin*", "*audit_user*", "*compliance_mgr*") Image IN ("*\\SharePoint.exe*", "*\\OneDrive.exe*")) OR Image IN ("*\\chrome.exe", "*\\msedge.exe"))
