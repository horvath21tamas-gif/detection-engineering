(Image IN ("*\\nltest.exe", "*\\dsquery.exe") CommandLine IN ("*/domain_trusts*", "*/all_trusts*", "*trustedDomain*")) OR CommandLine IN ("*Get-DomainTrust*", "*Get-NetForest*", "*Get-NetDomainTrust*", "*Invoke-Recon*", "*LDAP://*") CommandLine IN ("* > *", "*ConvertTo-Json*", "*Export-Csv*", "* -o *", "*zip*") OR NOT (ComputerName IN ("*DC-*", "*ADM-*", "*SERVER-*") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\httpd.exe")) NOT (username="NT AUTHORITY\\SYSTEM" Image="*\\Windows\\System32\\CcmExec.exe*")
