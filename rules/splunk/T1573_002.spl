CommandLine IN ("*ServerCertificateValidationCallback*", "*return $true*", "*[Net.ServicePointManager]::Expect100Continue*", "*[Net.ServicePointManager]::SecurityProtocol*", "*SecurityProtocolType]::Tls12*") OR CommandLine IN ("*RSACryptoServiceProvider*", "*FromXmlString*", "*ImportSubjectPublicKeyInfo*", "*X509Certificate2*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\rundll32.exe", "*\\regsvr32.exe") NOT (CommandLine IN ("*C:\\Program Files\\*", "*Microsoft\\Azure*", "*HealthCheck*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\services.exe", "*\\explorer.exe")) | table Time,SourceImage,SourceUsername,ParentImage,CommandLine,ProcessId,ThreadId
