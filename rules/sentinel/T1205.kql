DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath endswith "\netsh.exe" or OriginalFileName =~ "netsh.exe") and (ProcessCommandLine in ("*advfirewall firewall add rule*", "*action=allow*", "*protocol=UDP*", "*protocol=ICMP*", "*localport=any*"))) or ((FolderPath in ("*\tcpdump.exe", "*\windump.exe", "*\scapy.exe", "*\nmap.exe")) or (ProcessCommandLine in ("* -i *", "*sniffer*")))) and ((ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe")) and (FolderPath in ("*\Users\*", "*\Temp\*", "*\Downloads\*"))) and (not (FolderPath contains "C:\Windows\System32\svchost.exe" or username =~ "NT AUTHORITY\SYSTEM" or ProcessCommandLine contains "description="))