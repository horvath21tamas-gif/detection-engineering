SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%\.azure\accessTokens.json%','%\.azure\azureProfile.json%','%\.aws\credentials%','%\.aws\config%','%\.config\gcloud\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\User Data\Local State%','%\User Data\Default\Cookies%','%\User Data\Default\Network\Cookies%','%\User Data\Default\Login Data%') OR (""Filename"" ILIKE ENUMERATION('%\curl.exe','%\powershell.exe','%\pwsh.exe','%\certutil.exe','%\sqlite3.exe','%\python.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%roadtools%','%extract-token%','%cookie-stealer%','%copy-item%','%Invoke-WebRequest%','%Base64%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\wsmprovhost.exe','%\explorer.exe','%\taskhostw.exe')) AND (""Filename"" ILIKE ENUMERATION('%\type.exe','%\findstr.exe','%\copy.exe','%\robocopy.exe')) AND NOT (""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe','%\brave.exe','%\opera.exe') OR ""Filename"" ILIKE ENUMERATION('%\Google\Cloud SDK\%','%\Amazon\AWSCLIV2\%','%\Microsoft SDKs\Azure\%','%\HashiCorp\Terraform\%'))
