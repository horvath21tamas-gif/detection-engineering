hash="" Image IN ("*\\Users\\*", "*\\ProgramData\\*", "*\\Windows\\Temp\\*", "*\\AppData\\Local\\Temp\\*") ParentImage IN ("*\\powershell.exe", "*\\cmd.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\rundll32.exe", "*\\mshta.exe") NOT (ParentImage IN ("*\\Google\\Update\\*", "*\\Microsoft\\EdgeUpdate\\*", "*\\Windows\\servicing\\TrustedInstaller.exe*") OR Image IN ("*\\Program Files\\*", "*\\Windows\\System32\\*") OR Company="Microsoft Corporation")
