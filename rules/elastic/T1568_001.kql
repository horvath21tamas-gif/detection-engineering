(process.command_line:(*ipconfig\ \/flushdns* OR *Clear\-DnsClientCache* OR *Remove\-DnsClientCache* OR *Flush\-DnsClientCache*)) AND (process.command_line:(*Resolve\-DnsName* OR *\[System.Net.Dns\]\:\:* OR *while\(* OR *for\(* OR *Start\-Sleep* OR *\-RetryCount* OR *\-Timeout*)) AND (process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\rundll32.exe OR *\\regsvr32.exe OR *\\mshta.exe)) AND (NOT ((process.command_line:(*\\Program\ Files\\* OR *Microsoft\\Azure* OR *HealthCheck* OR *Chocolatey* OR *_vlmcs._tcp*)) OR winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.parent.executable:(*\\services.exe OR *\\explorer.exe))))
