DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\wscript.exe", "*\cscript.exe")) and (OriginalFileName in ("wscript.exe", "cscript.exe"))) and ProcessCommandLine contains "pubprn.vbs" and (IntegrityLevel in ("Low", "Medium")) and ((ProcessCommandLine in ("*script:*", "*http://*", "*https://*", "*soap:*", "*\\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\powershell.exe", "*\pwsh.exe")) or (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*"))) and (not ((ParentProcessName in ("*\explorer.exe", "*\svchost.exe")) and ProcessCommandLine contains "127.0.0.1" and username =~ "NT AUTHORITY\SYSTEM"))