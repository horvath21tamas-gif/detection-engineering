DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((EventID =~ 10 and (TargetImage in ("*\lsass.exe", "*\svchost.exe", "*\explorer.exe", "*\browser.exe")) and (GrantedAccess in ("0x1F1FFF", "0x1F3FFF", "0x1438"))) or (EventID =~ 8 and (SourceImage in ("*\Users\*", "*\Temp\*", "*\AppData\*")) and condition =~ "selection_remote_thread and NOT (SourceProcessId == TargetProcessId)")) and (SourceImage in ("*\winword.exe", "*\excel.exe", "*\powershell.exe", "*\rundll32.exe")) and (not ((SourceImage in ("*\CcmExec.exe", "*\MsMpEng.exe", "*\Taskmgr.exe", "*\Sysmon.exe")) or CallTrace contains "unknown" or User =~ "NT AUTHORITY\SYSTEM"))