Image IN ("*/systemctl", "*/systemd-analyze") CommandLine IN ("*/tmp/*", "*/var/tmp/*", "*/dev/shm/*", "*/home/*", "*/root/*", "*/dev/tcp/*") OR CommandLine IN ("*ExecStart=*", "*Restart=always*", "*base64*", "*curl*", "*wget*") OR ParentImage IN ("*/bash", "*/sh", "*/zsh", "*/python", "*/apache2", "*/nginx", "*/php") NOT (ParentImage IN ("*/ansible", "*/salt-minion", "*/puppet", "*/chef-client", "*/dpkg", "*/apt", "*/yum", "*/dnf") OR (username="root" CommandLine="*daemon-reload*"))
