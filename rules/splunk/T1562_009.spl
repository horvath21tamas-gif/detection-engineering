(Image="*\\bcdedit.exe" CommandLine IN ("*{current}*", "*{default}*")) OR CommandLine IN ("*delete*", "*0x0*") OR (Image="*\\shutdown.exe" CommandLine="* /r*" CommandLine="* /f*" CommandLine="* /t 0*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powershell.exe", "*\\cmd.exe", "*\\w3wp.exe") OR NOT ((username="NT AUTHORITY\\SYSTEM" ParentImage="*\\services.exe") OR CommandLine IN ("*reagentc.exe*", "*SystemReset.exe*") OR ParentImage="*\\msiexec.exe")
