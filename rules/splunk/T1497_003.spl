Image IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Downloads\\*", "*\\Desktop\\*", "*\\PerfLogs\\*") (CommandLine IN ("*ping 127.0.0.1 -n *", "*ping ::1 -n *") processcommandline=".* -n (*:[1-9][0-9]{2,}|[1-9][0-9]{3,}).*") OR (CommandLine IN ("*choice /t*", "*choice /d y /t*") processcommandline=".* /t (*:[6-9][0-9]|[1-9][0-9]{2,}).*") OR (CommandLine="*timeout /t*" processcommandline=".* /t (*:[1-9][0-9]{2,}).*") NOT ((ParentImage IN ("*\\msiexec.exe", "*\\TrustedInstaller.exe", "*\\CcmExec.exe") username="NT AUTHORITY\\SYSTEM") OR CommandLine IN ("*net use*", "*subst*", "*net time*"))
