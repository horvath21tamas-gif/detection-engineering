DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*New-Object -ComObject Outlook.Application*", "*CreateObject(\"Outlook.Application\")*", "*GetDefaultFolder(6)*", "*GetDefaultFolder(5)*", "*.GetNamespace(\"MAPI\")*")) and (ProcessCommandLine in ("*.SaveAs(*", "*.Attachments*", "*ContentFilter*", "*New-MailboxExportRequest*"))) or (((ProcessCommandLine in ("*.SaveAs(*", "*.Attachments*", "*ContentFilter*", "*New-MailboxExportRequest*")) and (ProcessCommandLine in ("* -WindowStyle Hidden*", "*SilentlyContinue*", "*.Display = $false*"))) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\cscript.exe", "*\wscript.exe", "*\mshta.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Program Files\Microsoft Office\*", "*C:\Program Files (x86)\Microsoft Office\*")) or username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*HealthCheck.ps1*", "*Add-in*")))))