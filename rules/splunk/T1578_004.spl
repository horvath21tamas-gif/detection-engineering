operation_name IN ("*ModifyImageAttribute*", "*CopyImage*", "*Microsoft.Compute/images/write*", "*v1.compute.images.setLabels*") request_parameters IN ("*all*", "*public*", "*grantee*") OR (mfa_authenticated="false" user_agent IN ("*kali*", "*python-requests*", "*boto3*", "*curl*", "*postman*")) NOT (user_name IN ("svc-packer*", "svc-terraform*", "image-pipeline-admin*", "azure-image-builder*") OR user_name IN ("*system-internal*", "*service-linked-role*"))
