DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*goldensaml*", "*asreproast*", "*Get-AADIntAccessToken*", "*roadtoken*", "*Invoke-SelfSignedCertificate*", "*cloud::google*", "*cloud::aws*")) or ((ProcessCommandLine in ("*dpapi::masterkey*", "*crypt::unprotect*", "*ProtectedData.Unprotect*")) and (FolderPath in ("*\mimikatz.exe", "*\pypykatz.exe"))) or ((ProcessCommandLine in ("*select *", "*password_value*", "*token*", "*cookie*", "*encrypted_key*")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\python.exe", "*\cscript.exe", "*\wscript.exe"))))) and (not ((FolderPath in ("*\Program Files\Google\Chrome\*", "*\Program Files (x86)\Google\Chrome\*", "*\Program Files (x86)\Microsoft\Edge\*", "*\Program Files\Mozilla Firefox\*", "*\Program Files\BraveSoftware\*", "*\Program Files\Opera\*")) or (FolderPath in ("*\Microsoft\Teams\*", "*\Slack\*", "*\Discord\*", "*\OneDrive\*")) or (ProcessCommandLine in ("*Connect-MgGraph*", "*az login*", "*Connect-AzureAD*")) or (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\services.exe", "*\MsMpEng.exe", "*\svchost.exe")))))