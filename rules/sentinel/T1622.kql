DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (GrantedAccess in ("0x400", "0x410", "0x1400", "0x1F1FFF")) and CallTrace contains "unknown" and ((CallTrace in ("*IsDebuggerPresent*", "*CheckRemoteDebuggerPresent*", "*NtQueryInformationProcess*", "*OutputDebugString*")) or (SourceImage in ("*\Users\*", "*\Temp\*", "*\AppData\*", "*\Downloads\*"))) and (not ((SourceImage in ("*\devenv.exe", "*\windbg.exe", "*\x64dbg.exe", "*\code.exe", "*\pycharm64.exe")) and SourceImage =~ "C:\Windows\System32\csrss.exe" and CallTrace contains "clr.dll+"))