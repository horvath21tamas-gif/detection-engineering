TargetObject="*\\Environment\\UserInitMprLogonScript*" Details IN ("*powershell*", "*pwsh*", "*cmd.exe*", "*mshta*", "*cscript*", "*wscript*", "*rundll32*", "*regsvr32*", "*bitsadmin*", "*certutil*") OR Details IN ("*:\\Users\\*", "*:\\ProgramData\\*", "*:\\Temp\\*", "*:\\Windows\\Temp\\*", "*AppData\\*", "*C:\\PerfLogs\\*") NOT ((Details IN ("*\\NETLOGON\\*", "*\\Scripts\\Logon*") Details IN ("C:\\Windows\\System32\\*", "C:\\Program Files\\*")) OR Image IN ("*\\System32\\gpupdate.exe", "*\\System32\\reg.exe", "*\\trustedinstaller.exe"))
