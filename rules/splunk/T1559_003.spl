Image IN ("*\\vmtoolsd.exe", "*\\vboxmanage.exe", "*\\vboxguest.exe", "*\\hyperv-daemons.exe", "*\\vmmem.exe") ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe") OR CommandLine IN ("*debug-vm*", "*dump-guest-memory*", "*hypercall*", "*--cpuid*", "*in-out-instruction*", "*guest-property*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\services.exe", "*\\svchost.exe"))
