CommandLine IN ("*LD_PRELOAD=*", "*LD_LIBRARY_PATH=*") Image IN ("*/sudo", "*/pkexec", "*/su", "*/mount", "*/umount", "*/passwd", "*/chsh", "*/newgrp") CommandLine IN ("*.so*", "*/tmp/*", "*/var/tmp/*", "*/dev/shm/*", "*/home/*", "*/run/user/*") NOT (CommandLine IN ("*/lib/*", "*/lib64/*", "*/usr/lib/*", "*/usr/lib64/*")) NOT (ParentImage IN ("*/bash", "*/zsh", "*/fish"))
