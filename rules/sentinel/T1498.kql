DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\hping3.exe", "*\loic.exe", "*\hoic.exe", "*\iperf.exe", "*\iperf3.exe", "*\pktmon.exe")) and (ProcessCommandLine in ("* --flood*", "* --rand-source*", "* -u -b *", "* --syn*", "* --udp*", "* -i u1*")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\chrome.exe", "*\rundll32.exe", "*\outlook.exe")) or (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (FolderPath in ("*\Program Files\NetworkMonitoring\*", "*\Azure\*")) or (ProcessCommandLine in ("*Speedtest*", "*HealthCheck*"))))