SELECT UTF8(payload) as search_payload from events where ""Process CommandLine"" ILIKE '%PATH=%' AND (""Process CommandLine"" ILIKE ENUMERATION('PATH=/tmp:%','PATH=/var/tmp:%','PATH=/dev/shm:%','PATH=/home/%','PATH=/run/user/%')) AND (""Filename"" ILIKE ENUMERATION('%/sudo','%/pkexec','%/su','%/mount','%/umount','%/passwd','%/chsh','%/newgrp','%/crontab')) AND (""Process CommandLine"" ILIKE ENUMERATION('% sudo %','% pkexec %','% su %','% mount %','% umount %','% passwd %','% chsh %','% newgrp %','% crontab %')) AND NOT (""Process CommandLine"" ILIKE ENUMERATION('%secure_path=%','%/usr/sbin:/usr/bin:/sbin:/bin%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/bash','%/zsh','%/fish','%/tmux','%/screen'))
