DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\netstat.exe", "*\net.exe", "*\net1.exe", "*\nbtstat.exe", "*\arp.exe")) or (ProcessCommandLine in ("*Get-NetTCPConnection*", "*Get-NetUDPEndpoint*", "*Get-NetIPAddress*", "*Get-NetRoute*", "*net session*", "*net use*", "*net view*"))) and ((ProcessCommandLine in ("* -ano*", "* -na *", "* -p tcp*", "* -s *", "* /domain*")) or ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\httpd.exe", "*\wsmprovhost.exe")) and IntegrityLevel =~ "Medium") or (ProcessCommandLine in ("*findstr*", "*select-string*", "* > *", "* >> *", "*ConvertTo-Json*", "*Out-File*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\svchost.exe", "*\CcmExec.exe", "*\msiexec.exe")) or (ProcessCommandLine in ("*Program Files*", "*Splunk*", "*healthcheck*"))))