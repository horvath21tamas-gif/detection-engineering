SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%.bash_history%','%.zsh_history%','%ConsoleHost_history.txt%','%.mysql_history%','%.psql_history%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%base64%','%curl%','%wget%','%nc %','%scp %','% > %','% | clip%') OR ""Parent Filename"" ILIKE ENUMERATION('%\httpd.exe','%\nginx.exe','%\php-cgi.exe','%\wsmprovhost.exe','%\psexesvc.exe')) AND NOT (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\bash.exe','%\zsh.exe','%\conhost.exe'))
