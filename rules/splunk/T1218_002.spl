Image="*\\control.exe" OR OriginalFileName="control.exe" ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\powershell.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe") OR CommandLine IN ("*\\Users\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*\\Public\\*", "*\\PerfLogs\\*", "*\\*") OR CommandLine IN ("*.dll*", "*.tmp*", "*.dat*", "*.png*") NOT (ParentImage="*\\explorer.exe" CommandLine="*C:\\Windows\\System32\\*" username="NT AUTHORITY\\SYSTEM")
