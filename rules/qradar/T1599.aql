SELECT UTF8(payload) as search_payload from events where (("Message" LIKE '%nat (inside%' OR "Message" LIKE '%outside%')%','%static-nat%','%set system bridge%','%add bridge-group%','%port-forwarding%','%virtual-server%')) AND (("Message" LIKE '%port 22%' OR "Message" LIKE '%port 3389%' OR "Message" LIKE '%port 445%' OR "Message" LIKE '%port 5985%' OR "Message" LIKE '%port 3306%')) AND (("Message" LIKE '%web-console%' OR "Message" LIKE '%http-admin%' OR "Message" LIKE '%ssh-session%' OR "Message" LIKE '%local-user%')) AND NOT (("SourceIP" LIKE '%10.50.0.10%' OR "SourceIP" LIKE '%10.50.0.11%') OR ("Message" LIKE '%vpn-pool%' OR "Message" LIKE '%dynamic-pat%' OR "Message" LIKE '%ipsec-nat-t%'))
