SELECT username, "Filename", "Parent Filename", Process "Process CommandLine", Integrity Level, Process Path, File Hash from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%/wiki/display/%','%/wiki/spaces/%','%/wiki/pages/viewpage%','%/rest/api/content%','%/rest/api/content%expand=body%','%/exportword%','%/exportpdf%','%stackoverflow.com/c/%','%.wiki.git%','%/_git/%','%/docs/%','%/knowledgebase/%','%/kb/%')) AND (""Filename"" ILIKE ENUMERATION('%\wget.exe','%\curl.exe','%\httrack.exe','%\python.exe','%\git.exe','%\powershell.exe','%\node.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% --mirror%','% --recursive%','% -r %','% --level %','% --convert-links%','% --page-requisites%','% --no-parent%','% --accept pdf%','% --accept doc%','% --accept zip%','% clone %','% archive %','% --depth %','% --bare%') OR (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\services.exe','%\w3wp.exe')) AND (("Integrity Level" LIKE '%Medium%' OR "Integrity Level" LIKE '%High%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%.zip%','%.7z%','%.tar%','%.gz%','% -o %','% --output %','% --output-document=%')) AND NOT (""Filename"" ILIKE ENUMERATION('%C:\Program Files\Elastic\%','%C:\Program Files\Splunk\%','%C:\Program Files\Backup%','%C:\Program Files\Atlassian\%') OR ("UserName" LIKE '%NT AUTHORITY\\%' OR "UserName" LIKE '%DOMAIN\\svc_%' OR "UserName" LIKE '%DOMAIN\\backup_%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('% --version%','% healthcheck%','% status%','% --help%'))
