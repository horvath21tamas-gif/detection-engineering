(ParentImage="*\\outlook.exe" Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\rundll32.exe") CommandLine IN ("* /a *", "* /c ipm.note*", "* /m *", "*outlook.application*") OR CommandLine="*\\*") OR (ParentImage IN ("*\\browser.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\httpd.exe") NOT (CommandLine IN ("*C:\\Program Files\\Microsoft Office*", "*Adobe\\Acrobat*", "*Salesforce*", "*Zoom*") OR username="NT AUTHORITY\\SYSTEM" OR Image="*\\conhost.exe"))
