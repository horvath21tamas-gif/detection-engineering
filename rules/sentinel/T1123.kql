DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*winmm.dll,mciSendString*", "*record*", "*save*", "*open new type waveaudio*")) or (ProcessCommandLine in ("*Get-MicrophoneAudio*", "*Start-AudioCapture*", "*waveInStart*", "*naudio*"))) and ((FolderPath in ("*\powershell.exe", "*\cmd.exe", "*\rundll32.exe", "*\mshta.exe", "*\wscript.exe")) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*\Teams.exe*", "*\Zoom.exe*", "*\webex*", "*\slack.exe*", "*\discord.exe*", "*\whatsapp.exe*")) or FolderPath startswith "C:\Program Files\Google\Chrome\" or FolderPath startswith "C:\Program Files (x86)\Microsoft\Edge\"))