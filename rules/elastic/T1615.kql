((process.executable:(*\\gpresult.exe OR *\\Get\-GPO.exe)) OR (process.command_line:(*Get\-DomainGPO* OR *Get\-NetGPO* OR *SharpGPOAbuse* OR *Find\-GPO*))) AND ((process.command_line:(*\ \/h\ * OR *\ \/x\ * OR *\ \/z\ * OR *ConvertTo\-Json* OR *Export\-Csv*)) OR ((process.parent.executable:(*\\wsmprovhost.exe OR *\\httpd.exe OR *\\winword.exe)) AND winlog.event_data.IntegrityLevel:Medium)) AND (NOT (process.command_line:*\ \/r* AND winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND process.parent.executable:*\\CcmExec.exe*))
