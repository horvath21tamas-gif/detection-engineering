source="WinEventLog:Security" (EventCode=4624 LogonType=9 LogonProcessName="seclogo" AuthenticationPackage="Negotiate") OR (EventCode IN (4768, 4769) TicketEncryptionType="0x17") OR (EventCode=4624 LogonType=3 AuthenticationPackage="NTLM" IpAddress IN ("127.0.0.1", "::1")) NOT (TargetUserName="*$" OR SubjectUserName="*$" OR ProcessName IN ("*\\Windows\\System32\\svchost.exe*", "*\\Windows\\System32\\lsass.exe*"))
