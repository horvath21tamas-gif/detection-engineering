("cs-method" IN ("POST", "PUT") "cs-uri-stem" IN ("*/uploads/*", "*/upload/*", "*/files/*", "*/images/*", "*/tmp/*", "*/data/*") "cs-uri-stem" IN ("*.php", "*.phtml", "*.php5", "*.asp", "*.aspx", "*.jsp")) OR ("cs-uri-stem" IN ("*.php", "*.phtml", "*.php5", "*.asp", "*.aspx", "*.jsp") "cs-uri-query" IN ("*cmd=*", "*exec=*", "*system=*", "*powershell=*", "*whoami*", "*net user*", "*uname*", "*id*", "*curl *", "*wget *") "sc-status"=200 "cs-user-agent" IN ("*curl*", "*wget*", "*python*", "*powershell*", "*httpclient*", "*libwww*") NOT ("cs-uri-stem" IN ("*/wp-admin/*", "*/wp-json/*", "*/administrator/*", "*/api/*", "*/rest/*")))
