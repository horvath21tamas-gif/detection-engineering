Operation IN ("New-Mailbox", "Add-MailboxPermission", "Set-Mailbox", "New-InboxRule") Parameters IN ("*AccessRights=FullAccess*", "*ForwardingAddress*", "*ForwardingSmtpAddress*", "*DeliverToMailboxAndForward=True*") OR ClientInfoString IN ("*Client=Microsoft.Exchange.Management*", "*PowerShell*", "*Custom-Context-Script*") NOT (ClientInfoString="*Client=MSExchangeRPC*" OR UserId IN ("*SVC_Okta*", "*AzureADConnect*", "*Sync_*"))
