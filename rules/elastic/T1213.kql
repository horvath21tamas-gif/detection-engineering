(process.command_line:(*rest\/api\/* OR *api\/v2\/spaces* OR *api\/v2\/pages* OR *rest\/api\/2\/issue* OR *_vti_bin\/lists.asmx* OR *Get\-SPO* OR *export\-sharepoint* OR *Get\-PnP* OR *\/wiki\/pages\/viewpage* OR *.wiki.git*)) AND ((process.command_line:(*export* OR *backup* OR *download\-all* OR *recursive* OR *dump* OR *\-\-mirror* OR *\-\-all* OR *\-\-depth* OR *clone* OR *archive*)) OR (process.command_line:(*\\Users\\* OR *\\Temp\\* OR *\\AppData\\Local\\Temp\\* OR *\\Public\\* OR *\-OutFile* OR *\>*))) AND ((process.parent.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\w3wp.exe OR *\\httpd.exe OR *\\python.exe OR *\\node.exe)) AND (winlog.event_data.IntegrityLevel:(Medium OR High))) AND (NOT ((process.executable.caseless:(*C\:\\Program\ Files\\Atlassian\\* OR *C\:\\Program\ Files\\Microsoft\ Monitoring\ Agent\\* OR *C\:\\Windows\\CCM\\* OR *C\:\\Program\ Files\\Elastic\\* OR *C\:\\Program\ Files\\Splunk\\*)) OR (user.name:(NT\ AUTHORITY\\SYSTEM* OR DOMAIN\\svc_* OR DOMAIN\\backup_*)) OR (process.command_line:(*healthcheck* OR *ping* OR *\-\-version* OR *\-help*))))
