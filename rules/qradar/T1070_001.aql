SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\wevtutil.exe' AND (("Process CommandLine" LIKE '%cl Security%' OR "Process CommandLine" LIKE '%cl "Security"%' OR "Process CommandLine" LIKE '%clear-log Security%')) AND (("ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\powershell.exe%' OR "ParentImage" LIKE '%\\pwsh.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\mshta.exe%' OR "ParentImage" LIKE '%\\rundll32.exe%')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Windows\\CCM\\%' OR "ParentImage" LIKE '%\\Microsoft Configuration Manager\\%' OR "ParentImage" LIKE '%\\SCCM\\%' OR "ParentImage" LIKE '%\\Tanium\\%' OR "ParentImage" LIKE '%\\Splunk\\%' OR "ParentImage" LIKE '%\\Elastic\\%' OR "ParentImage" LIKE '%\\NXLog\\%' OR "ParentImage" LIKE '%\\OSSEC\\%' OR "ParentImage" LIKE '%\\QRadar\\%' OR "ParentImage" LIKE '%\\LogRhythm\\%'))
