SELECT Time, user_name, Message, SourceIP from events where (("Message" LIKE '%mount -o remount%' OR "Message" LIKE '%rw%' OR "Message" LIKE '%mount -uw%' OR "Message" LIKE '%config-transaction start%' OR "Message" LIKE '%config-transaction commit%') OR ("Message" LIKE '%xxd %' OR "Message" LIKE '%dd if=%' OR "Message" LIKE '%insmod%' OR "Message" LIKE '%gdb %' OR "Message" LIKE '%setenforce 0%' OR "Message" LIKE '%objcopy %' OR "Message" LIKE '%strip %' OR "Message" LIKE '%modprobe %')) AND (("Message" LIKE '%/bin/%' OR "Message" LIKE '%/sbin/%' OR "Message" LIKE '%/lib/modules/%' OR "Message" LIKE '%/boot/%' OR "Message" LIKE '%/usr/local/bin/%' OR "Message" LIKE '%/usr/local/sbin/%')) AND NOT (("user_name" LIKE '%svc-system-update%' OR "user_name" LIKE '%installer%' OR "user_name" LIKE '%root-maintenance%') OR ("Message" LIKE '%show %' OR "Message" LIKE '%cat %' OR "Message" LIKE '%grep %' OR "Message" LIKE '%ls %' OR "Message" LIKE '%find %'))
