DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((ProcessCommandLine in ("*Remove-Item*", "*Set-Content*", "*Clear-Content*", "*streams.exe*", "*xattr*", "*delete*")) and (ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\winword.exe", "*\excel.exe"))) or (ProcessCommandLine in ("*reg add*", "*Set-ItemProperty*"))) and (ProcessCommandLine in ("*\Downloads\*", "*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Desktop\*")) and (not ((FolderPath in ("C:\Windows\System32\msiexec.exe*", "C:\Program Files\Google\Chrome\Application\chrome.exe*", "C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe*")) and User =~ "NT AUTHORITY\SYSTEM"))