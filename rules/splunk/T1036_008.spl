Image IN ("*\\wscript.exe", "*\\cscript.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\regsvr32.exe", "*\\mshta.exe", "*\\rundll32.exe") CommandLine IN ("*.jpg*", "*.jpeg*", "*.png*", "*.gif*", "*.txt*", "*.log*", "*.pdf*", "*.docx*", "*.xlsx*", "*.tmp*", "*.ini*", "*.dat*", "*.cfg*") CommandLine IN ("*\\Users\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*\\Windows\\Temp\\*", "*\\Downloads\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\winrar.exe", "*\\7zFM.exe", "*\\explorer.exe") NOT ((username="NT AUTHORITY\\SYSTEM" ParentImage="*\\services.exe") OR CommandLine IN ("*C:\\Windows\\ccmcache\\*", "*healthcheck.txt*", "*Telemetry*") OR ParentImage="*\\msiexec.exe")
