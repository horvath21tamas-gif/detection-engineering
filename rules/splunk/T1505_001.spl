ParentImage="*\\sqlservr.exe" Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\bitsadmin.exe", "*\\certutil.exe", "*\\net.exe", "*\\net1.exe", "*\\whoami.exe", "*\\systeminfo.exe", "*\\nltest.exe", "*\\scrcons.exe") OR CommandLine IN ("*sp_configure*", "*xp_cmdshell*", "*RECONFIGURE*", "*show advanced options*", "*Ole Automation Procedures*") NOT (ParentImage="*\\sqlagent.exe" OR (Image="*\\Microsoft SQL Server\\...\\Setup\\*" CommandLine="*sqlagent.exe -i*"))
