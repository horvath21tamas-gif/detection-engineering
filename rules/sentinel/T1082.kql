DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\systeminfo.exe", "*\wmic.exe")) or (ProcessCommandLine in ("*Get-ComputerInfo*", "*os get*", "*qfe list*", "*baseboard get*"))) and (((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\powershell.exe")) and IntegrityLevel =~ "Medium") or (ProcessCommandLine in ("* > *", "*ConvertTo-Json*", "*findstr*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\CcmExec.exe", "*\svchost.exe", "*\msiexec.exe")) or (ProcessCommandLine in ("*Program Files*", "*Google\Update*"))))