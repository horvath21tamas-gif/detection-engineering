DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (SrcIp in ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*")) and (Method in ("GET", "HEAD", "OPTIONS")) and (UriStem in ("*/admin*", "*/login*", "*/config*", "*/setup*", "*/debug*", "*/test*", "*/backup*", "*/old*", "*/dev*", "*/server-status*", "*/phpinfo*", "*/.git*", "*/.env*", "*/wp-admin*", "*/actuator*")) and (UserAgent in ("*curl*", "*wget*", "*python*", "*go-http-client*", "*libwww*", "*scanner*", "*probe*", "*masscan*", "*nmap*", "*zgrab*", "*httpclient*", "*axios*", "*requests*")) and (Status in (200, 301, 302, 401, 403, 404)) and (not ((UserAgent in ("*Mozilla*", "*Chrome*", "*Firefox*", "*Safari*", "*Edge*")) or (UserAgent in ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nikto*", "*nuclei*", "*zabbix*", "*prometheus*", "*uptime*", "*pingdom*", "*datadog*", "*newrelic*")) or ((UriStem in ("*/health*", "*/metrics*", "*/status/health*", "*/api*")) and (UriStem in ("*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.woff", "*.woff2", "*.map")))))