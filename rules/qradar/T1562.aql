SELECT UTF8(payload) as search_payload from events where ("Image" ILIKE ENUMERATION('%\net.exe','%\net1.exe','%\sc.exe','%\powershell.exe','%\pwsh.exe','%\taskkill.exe') OR "ImageName" ILIKE ENUMERATION('net.exe','net1.exe','sc.exe','PowerShell.EXE','taskkill.exe')) AND ("Process CommandLine" ILIKE ENUMERATION('%stop%','%delete%','%disable%','%kill%','%/F%')) AND ("Process CommandLine" ILIKE ENUMERATION('%WinDefend%','%MpsSvc%','%Sense%','%MsSense%','%SentinelAgent%','%CarbonBlack%','%CylanceSvc%','%CrowdStrike%','%Symantec%','%Sophos%','%McAfee%')) AND NOT ("ParentImage" ILIKE ENUMERATION('%\CcmExec.exe','%\Gpscript.exe'))
