SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%\vssadmin.exe' AND (("Process CommandLine" LIKE '%delete shadows%' OR "Process CommandLine" LIKE '%delete shadow%' OR "Process CommandLine" LIKE '%/all%' OR "Process CommandLine" LIKE '%/quiet%')) AND (("ParentImage" LIKE '%\\cmd.exe%' OR "ParentImage" LIKE '%\\powershell.exe%' OR "ParentImage" LIKE '%\\pwsh.exe%' OR "ParentImage" LIKE '%\\wscript.exe%' OR "ParentImage" LIKE '%\\cscript.exe%' OR "ParentImage" LIKE '%\\mshta.exe%' OR "ParentImage" LIKE '%\\rundll32.exe%')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ("ParentImage" LIKE '%\\Veeam\\%' OR "ParentImage" LIKE '%\\Acronis\\%' OR "ParentImage" LIKE '%\\Commvault\\%' OR "ParentImage" LIKE '%\\Veritas\\%' OR "ParentImage" LIKE '%\\Dell\\%' OR "ParentImage" LIKE '%\\Microsoft Azure Backup\\%' OR "ParentImage" LIKE '%\\Datto\\%'))
