DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\nircmd.exe", "*\python.exe", "*\wscript.exe")) and ((ProcessCommandLine in ("*Get-Clipboard*", "*Set-Clipboard*", "*System.Windows.Forms.Clipboard*", "*WriteProcessMemory*", "*regex*")) and (ProcessCommandLine in ("*invoice*", "*payment*", "*bank_statement*", "*iban*", "*.pdf*", "*.xlsx*"))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\rundll32.exe", "*\msedge.exe", "*\chrome.exe")) or (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (User =~ "NT AUTHORITY\SYSTEM" or FolderPath contains "\Program Files\" or (ProcessCommandLine in ("*Inventory*", "*Backup*", "*SignService*"))))