DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\shutdown.exe", "*\init.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine contains " /a" and (ProcessCommandLine contains " /f" and ProcessCommandLine contains " /t 0")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\httpd.exe", "*\rundll32.exe", "*\wscript.exe", "*\cscript.exe")) or (FolderPath in ("*\Temp\*", "*\Users\Public\*", "*\AppData\Local\Temp\*"))) and (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\CcmExec.exe", "*\TiWorker.exe", "*\msiexec.exe", "*\svchost.exe")) or (ProcessCommandLine in ("*HealthCheck*", "*Diagnostic*", "*AzureAD*"))))