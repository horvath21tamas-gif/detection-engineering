(Image="*\\openssl.exe" CommandLine IN ("* s_client*", "* x509*", "* -text*")) OR (Image="*\\certutil.exe" CommandLine IN ("* -dump*", "* -viewstore*", "* -user*")) OR (Image="*\\powershell.exe" CommandLine="*Get-ChildItem -Path Cert:*") OR CommandLine IN ("*.pfx*", "*.p12*", "*.pem*", "*exportable*") NOT (CommandLine IN ("* -verify*", "* -v *", "* -silent*")) NOT (ParentImage IN ("*\\services.exe", "*\\svchost.exe", "*\\CcmExec.exe", "*\\TrustedInstaller.exe")) NOT (CommandLine IN ("*localhost*", "*dev.local*"))
