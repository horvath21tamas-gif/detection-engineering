((CommandLine:(*\-\-privileged* OR *\-\-cap\-add\=SYS_ADMIN* OR *\-\-cap\-add\=SYS_PTRACE* OR *\-\-pid\=host* OR *\-\-net\=host* OR *\-\-ipc\=host* OR *\-\-security\-opt\=seccomp\=unconfined* OR *\-\-security\-opt\=apparmor\=unconfined*)) OR (CommandLine:(*\-v\ \/\:\/* OR *\-v\ \/proc\:\/proc* OR *\-v\ \/sys\:\/sys* OR *\-v\ \/var\/run\/docker.sock\:\/var\/run\/docker.sock* OR *\-v\ \/run\/containerd\:\/run\/containerd* OR *\-v\ \/etc\/kubernetes\:\/etc\/kubernetes* OR *\-v\ \/root\/.ssh\:\/root\/.ssh*))) AND (ParentImage:(*\/bash OR *\/sh OR *\/zsh OR *\/python OR *\/ruby OR *\/php OR *\/node)) AND (NOT ((Image:(*kube\-proxy* OR *calico\/node* OR *cilium* OR *datadog\/agent* OR *node\-exporter* OR *istio\-proxy* OR *fluentd* OR *prometheus*)) AND username:root))
