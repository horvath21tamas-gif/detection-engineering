DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\wmic.exe", "*\tasklist.exe", "*\sc.exe", "*\reg.exe", "*\net.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*Get-Process*", "*Get-Service*", "*Get-ItemProperty*", "*tasklist*", "*sc query*", "*reg query*", "*net start*", "*findstr*", "*grep*"))) and ((ProcessCommandLine in ("*defender*", "*sentinel*", "*falcon*", "*crowdstrike*", "*carbonblack*", "*fireeye*", "*cylance*", "*sophos*", "*antivirus*", "*firewall*", "*edr*", "*hip*", "*sandbox*")) or (ProcessCommandLine in ("*VBOX*", "*VMWARE*", "*VirtualBox*", "*Guest Additions*", "*Hyper-V*", "*VirtualMachine*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\powerpoint.exe")) and IntegrityLevel =~ "Medium")) and (not (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\CcmExec.exe", "*\svchost.exe", "*\services.exe")) and (ProcessCommandLine in ("*Program Files*", "*Google\Update*", "*Windows Defender*", "*Microsoft Security*"))))