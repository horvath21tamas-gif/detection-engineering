SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\schtasks.exe' AND "Process "Process CommandLine"" ILIKE '%/create%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%powershell%','%pwsh%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-encodedcommand%','%-nop%','%-w hidden%','%-executionpolicy bypass%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\ProgramData\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\WINWORD.EXE','%\EXCEL.EXE')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\SCCM\%','%\Tanium\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Veeam\%','%\Acronis\%','%\Backup\%'))
