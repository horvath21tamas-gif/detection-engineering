SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%\hh.exe' AND "ImageName"='hh.exe' AND (("Integrity Level" LIKE '%Low%' OR "Integrity Level" LIKE '%Medium%')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\ProgramData\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%http://%','%https://%','%ftp://%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%its:%','%mk:@MSITStore%','%ms-its:%') OR "Process "Process CommandLine"" ILIKE '%-decompile%' OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Public\%','%\Downloads\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe','%\outlook.exe','%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe','%\chrome.exe','%\msedge.exe')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%.txt%','%.jpg%','%.png%','%.dat%','%.tmp%')) AND NOT ((""Filename"" ILIKE ENUMERATION('C:\Windows\System32\%','C:\Windows\SysWOW64\%')) AND (""Parent Filename"" ILIKE ENUMERATION('C:\Program Files\%','C:\Program Files (x86)\%')) AND "Integrity Level"='High') AND NOT "username" ILIKE 'NT AUTHORITY\%'
