DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*/kubectl", "*/k3s", "*/docker", "*/crictl", "*/nerdctl", "*/oc")) and (ProcessCommandLine in ("*auth can-i*", "*get secrets*", "*describe pod*", "*describe deployment*", "*get nodes*", "*get svc*", "*get configmaps*", "*inspect*", "*logs*", "*exec*")) and (((ParentProcessName in ("*/www-data*", "*/nginx*", "*/httpd*", "*/php-fpm*", "*/python*", "*/node*")) and (username in ("root", "www-data", "nginx"))) or (ProcessCommandLine in ("*--format json*", "*-o json*", "* | jq*", "* > *", "*--all-namespaces*"))) and (not ((FolderPath in ("*/usr/bin/kubelet*", "*/datadog-agent*", "*/prometheus*", "*/telegraf*", "*/rancher*")) and (ProcessCommandLine in ("*get pods --watch*", "*--version*", "*metrics-server*"))))