SELECT UTF8(payload) as search_payload from events where (""Parent Filename"" ILIKE ENUMERATION('%\teams.exe','%\slack.exe','%\discord.exe','%\webex.exe','%\zoom.exe','%\whatsapp.exe','%\linkedin.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\scrcons.exe','%\regsvr32.exe','%\rundll32.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Downloads\%','%\AppData\Local\Temp\%','%\Users\Public\%','%C:\Windows\Temp\%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\chrome.exe','%\msedge.exe','%\firefox.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%--type=%','%squirrel%','%--update%','%--checkInstall%','%notification%')) OR ""Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\powerpnt.exe'))
