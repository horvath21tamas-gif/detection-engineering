Image IN ("*/optool", "*/insert_dylib", "*/yololib", "*/patcho") OR CommandLine IN ("*LC_LOAD_DYLIB*", "*install_name_tool -add_rpath*") OR CommandLine IN ("*/tmp/*", "*/Users/Shared/*", "*/Library/Caches/*", "*/Downloads/*", "*.hidden/*") NOT ((ParentImage IN ("/Applications/Xcode.app/*", "/Library/Developer/*") Image IN ("*/usr/bin/codesign", "*/usr/bin/xcodebuild", "*/usr/bin/ld") username="root") OR Image IN ("*/installd", "*/softwareupdated"))
