SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\bitsadmin.exe','%\certutil.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%http://%','%https://%','%Invoke-WebRequest%','%iwr %','%DownloadFile%','%bitsadmin /transfer%','%certutil -urlcache%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%IEX%','%Invoke-Expression%','%| iex%','%-enc%','%FromBase64String%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\AppData\%','%\Temp\%','%\Downloads\%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\WINWORD.EXE','%\EXCEL.EXE','%\POWERPNT.EXE','%\OUTLOOK.EXE','%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe')) AND NOT (("UserName" LIKE '%SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Tanium\%','%\Intune\%','%\Microsoft\EdgeUpdate\%','%\Google\Update\%'))
