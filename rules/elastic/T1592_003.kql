(SrcIp:(1.* OR 2.* OR 3.* OR 4.* OR 5.* OR 6.* OR 7.* OR 8.* OR 9.*)) AND (UriStem:(*\/cgi\-bin* OR *\/status* OR *\/system* OR *\/device* OR *\/version* OR *\/firmware* OR *\/diagnostic* OR *\/setup* OR *\/admin* OR *\/mgmt* OR *\/management*)) AND (UriQuery:(*firmware* OR *version* OR *build* OR *model* OR *hardware* OR *platform*)) AND (UserAgent:(*curl* OR *wget* OR *python* OR *httpclient* OR *go\-http\-client* OR *libwww* OR *probe*)) AND (NOT ((UserAgent:(*Mozilla* OR *Chrome* OR *Safari* OR *Firefox* OR *Edge*)) OR (UserAgent:(*nessus* OR *qualys* OR *openvas* OR *acunetix* OR *nikto* OR *nuclei* OR *zap* OR *zabbix* OR *uptime* OR *pingdom*)) OR ((UriStem:(*.css OR *.js OR *.png OR *.jpg OR *.svg OR *.ico OR *.woff OR *.woff2 OR *.json)) AND UriStem:*\/api*)))
