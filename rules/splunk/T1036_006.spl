(Image IN ("*.exe *", "*.com *", "*.scr *", "*.pif *") CommandLine IN ("*.exe  *", "*.exe \"*", "*.exe /*")) OR Image IN ("*Windows \\*", "*System32 \\*", "*Program Files \\*", "*AppData \\*") Image IN ("*\\Users\\*", "*\\Public\\*", "*\\Temp\\*", "*\\Downloads\\*") NOT (Image IN ("C:\\Windows\\System32\\*", "C:\\Windows\\WinSxS\\*", "C:\\Windows\\SoftwareDistribution\\*") OR username IN ("NT AUTHORITY\\SYSTEM", "NT AUTHORITY\\LOCAL SERVICE", "NT AUTHORITY\\NETWORK SERVICE") OR ParentImage IN ("*\\msiexec.exe", "*\\trustedinstaller.exe"))
