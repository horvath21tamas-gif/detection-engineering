SELECT UTF8(payload) as search_payload from events where (("Operation" LIKE '%Add-MailboxPermission%' OR "Operation" LIKE '%Add-RecipientPermission%')) AND (("AccessRights" LIKE '%FullAccess%' OR "AccessRights" LIKE '%SendAs%' OR "AccessRights" LIKE '%SendOnBehalf%')) AND ("UserId" ILIKE '%admin-%' OR "ClientIPAddress" ILIKE '%10.50.%' OR ("TargetUser" LIKE '%ceo%' OR "TargetUser" LIKE '%cfo%' OR "TargetUser" LIKE '%director%' OR "TargetUser" LIKE '%legal%' OR "TargetUser" LIKE '%finance%')) AND NOT ((("UserId" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserId" LIKE '%Microsoft.Exchange.ServiceMS%')) AND "UserAgent" ILIKE '%ExchangeConfiguration/15%' OR ("UserId" LIKE '%svc-backup-cloud%' OR "UserId" LIKE '%it-automation-principal%'))
