Image IN ("*\\pscp.exe", "*\\psftp.exe", "*\\scp.exe", "*\\sftp.exe", "*\\rclone.exe", "*\\winscp.com", "*\\winscp.exe") CommandLine IN ("*@*", "*sftp://*", "*scp://*", "*://*", "*:22*", "*:2222*") CommandLine IN ("* -pw *", "* -i *", "* -batch*", "* -hostkey *", "* -P *", "* -r *", "* copy *", "* sync *", "* move *", "* mirror*", "* /command *", "* /script=*") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\powershell.exe", "*\\cmd.exe") NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR CommandLine IN ("*127.0.0.1*", "*localhost*", "*internal-sftp*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\services.exe")
