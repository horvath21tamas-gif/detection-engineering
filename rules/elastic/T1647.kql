(Image:(*\/PlistBuddy OR *\/defaults OR *\/plutil OR *\/launchctl)) AND ((CommandLine:(*\/Library\/LaunchAgents\/* OR *\/Library\/LaunchDaemons\/* OR *\/Users\/* OR *\/System\/Library\/LaunchAgents\/* OR *\/System\/Library\/LaunchDaemons\/* OR *\/Library\/StartupItems\/*)) OR (CommandLine:(*RunAtLoad* OR *ProgramArguments* OR *KeepAlive* OR *StartInterval* OR *StartCalendarInterval* OR *LaunchEvents* OR *Label* OR *WatchPaths* OR *QueueDirectories*)) OR (CommandLine:(*bootstrap* OR *bootout* OR *load\ * OR *unload\ *))) AND ((ParentImage:(*\/Safari.app\/* OR *\/Google\ Chrome.app\/* OR *\/Microsoft\ Word.app\/* OR *\/Microsoft\ Excel.app\/* OR *\/Mail.app\/* OR *\/zoom.us.app\/* OR *\/Slack.app\/*)) OR (ParentImage:(*\/bash OR *\/zsh OR *\/sh OR *\/osascript)) OR (User:*root* AND IntegrityLevel:Medium)) AND (NOT (Image:(\/usr\/sbin\/softwareupdate* OR \/System\/Library\/* OR \/usr\/libexec\/*))) AND (NOT (Image:(*\/Jamf\/* OR *\/Intune\/* OR *\/Kandji\/* OR *\/Mosyle\/*)))
