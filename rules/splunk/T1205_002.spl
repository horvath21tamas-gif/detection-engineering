(Image IN ("*\\netsh.exe", "*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*wfp*", "*callout*", "*add-filter*", "*add callout*", "*fwpm*", "*netsh wfp*", "*netsh advfirewall*")) OR (Image IN ("*\\sc.exe", "*\\reg.exe") CommandLine="*create*" CommandLine="*type=*" CommandLine="*kernel*" CommandLine IN ("*\\Temp\\*", "*\\AppData\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*")) ParentImage IN ("*\\services.exe", "*\\svchost.exe", "*\\TrustedInstaller.exe", "*\\msiexec.exe") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\python.exe", "*\\wscript.exe", "*\\cscript.exe") NOT (Image IN ("*\\Program Files\\Windows Defender\\*", "*\\Program Files\\CrowdStrike\\*", "*\\Program Files\\SentinelOne\\*", "*\\Program Files\\Microsoft Security\\*") User="NT AUTHORITY\\*")
