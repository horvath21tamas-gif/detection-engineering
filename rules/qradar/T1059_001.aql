SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-enc%','%-encodedcommand%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-nop%','%-w hidden%','%-windowstyle hidden%','%-executionpolicy bypass%','%FromBase64String%','%IEX%','%Invoke-Expression%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\cmd.exe','%\wscript.exe','%\cscript.exe','%\mshta.exe','%\rundll32.exe','%\WINWORD.EXE','%\EXCEL.EXE','%\POWERPNT.EXE')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%LOCAL SERVICE%' OR "UserName" LIKE '%NETWORK SERVICE%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Windows\CCM\%','%\Microsoft Configuration Manager\%','%\SCCM\%','%\Tanium\%','%\PDQ\%','%\Ivanti\%','%\ManageEngine\%','%\Intune\%','%\Elastic\%','%\Splunk\%'))
