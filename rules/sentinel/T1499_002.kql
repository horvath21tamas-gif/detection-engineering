DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\sc.exe", "*\powershell.exe", "*\pwsh.exe", "*\net.exe", "*\net1.exe")) and (ProcessCommandLine in ("*stop *", "*config *", "*start= disabled*", "*binpath=*", "*Stop-Service*", "*Set-Service*", "* -Status Stopped*", "* -StartupType Disabled*")) and (ProcessCommandLine in ("*WinDefend*", "*MpsSvc*", "*EventLog*", "*RpcSs*", "*LanmanServer*", "*SDRSVC*", "*VSS*")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\httpd.exe", "*\rundll32.exe", "*\outlook.exe")) or (FolderPath in ("*\Temp\*", "*\Users\Public\*"))) and (not (User =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\CcmExec.exe", "*\msiexec.exe", "*\TiWorker.exe")) or (ProcessCommandLine in ("*HealthCheck*", "*Update*", "*Diagnostic*"))))