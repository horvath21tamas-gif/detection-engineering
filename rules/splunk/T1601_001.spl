Message IN ("*mount -o remount,rw*", "*mount -uw*", "*config-transaction start*", "*config-transaction commit*") OR Message IN ("*xxd *", "*dd if=*", "*insmod*", "*gdb *", "*setenforce 0*", "*objcopy *", "*strip *", "*modprobe *") Message IN ("*/bin/*", "*/sbin/*", "*/lib/modules/*", "*/boot/*", "*/usr/local/bin/*", "*/usr/local/sbin/*") NOT (user_name IN ("svc-system-update*", "installer*", "root-maintenance*") OR Message IN ("*show *", "*cat *", "*grep *", "*ls *", "*find *")) | table Time,user_name,Message,SourceIP
