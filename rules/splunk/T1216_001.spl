Image IN ("*\\wscript.exe", "*\\cscript.exe") OriginalFileName IN ("wscript.exe", "cscript.exe") CommandLine="*pubprn.vbs*" IntegrityLevel IN ("Low", "Medium") CommandLine IN ("*script:*", "*http://*", "*https://*", "*soap:*", "*\\\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\powershell.exe", "*\\pwsh.exe") OR Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*") NOT (ParentImage IN ("*\\explorer.exe", "*\\svchost.exe") CommandLine="*127.0.0.1*" username="NT AUTHORITY\\SYSTEM")
