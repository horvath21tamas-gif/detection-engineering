SELECT UTF8(payload) as search_payload from events where (("RequestMethod" LIKE '%POST%' OR "RequestMethod" LIKE '%PUT%')) AND (("cs-uri-stem" LIKE '%/uploads/%' OR "cs-uri-stem" LIKE '%/upload/%' OR "cs-uri-stem" LIKE '%/files/%' OR "cs-uri-stem" LIKE '%/images/%' OR "cs-uri-stem" LIKE '%/tmp/%' OR "cs-uri-stem" LIKE '%/data/%')) AND (("cs-uri-stem" LIKE '%.php%' OR "cs-uri-stem" LIKE '%.phtml%' OR "cs-uri-stem" LIKE '%.php5%' OR "cs-uri-stem" LIKE '%.asp%' OR "cs-uri-stem" LIKE '%.aspx%' OR "cs-uri-stem" LIKE '%.jsp%')) OR (("cs-uri-stem" LIKE '%.php%' OR "cs-uri-stem" LIKE '%.phtml%' OR "cs-uri-stem" LIKE '%.php5%' OR "cs-uri-stem" LIKE '%.asp%' OR "cs-uri-stem" LIKE '%.aspx%' OR "cs-uri-stem" LIKE '%.jsp%')) AND (("URL" LIKE '%cmd=%' OR "URL" LIKE '%exec=%' OR "URL" LIKE '%system=%' OR "URL" LIKE '%powershell=%' OR "URL" LIKE '%whoami%' OR "URL" LIKE '%net user%' OR "URL" LIKE '%uname%' OR "URL" LIKE '%id%' OR "URL" LIKE '%curl %' OR "URL" LIKE '%wget %')) AND "sc-status"=200 AND (("cs-user-agent" LIKE '%curl%' OR "cs-user-agent" LIKE '%wget%' OR "cs-user-agent" LIKE '%python%' OR "cs-user-agent" LIKE '%powershell%' OR "cs-user-agent" LIKE '%httpclient%' OR "cs-user-agent" LIKE '%libwww%')) AND NOT (("cs-uri-stem" LIKE '%/wp-admin/%' OR "cs-uri-stem" LIKE '%/wp-json/%' OR "cs-uri-stem" LIKE '%/administrator/%' OR "cs-uri-stem" LIKE '%/api/%' OR "cs-uri-stem" LIKE '%/rest/%'))
