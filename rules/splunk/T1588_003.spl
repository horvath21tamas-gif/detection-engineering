(Image="*\\certutil.exe" CommandLine IN ("*-exportPFX*", "*-p *", "*-p=*")) OR (Image="*\\certutil.exe" CommandLine IN ("*-urlcache*", "*-addstore*")) OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*Export-PfxCertificate*", "*Import-PfxCertificate*", "*Set-AuthenticodeSignature*")) NOT (ParentImage IN ("*\\mmc.exe", "*\\ServerManager.exe", "*\\svchost.exe") OR (Image IN ("*\\Jenkins\\*", "*\\AzureDevOps\\*", "*\\MSBuild\\*") User="*SVC_Build*"))
