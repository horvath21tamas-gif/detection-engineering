(process.executable:(*\\powershell.exe OR *\\pwsh.exe OR *\\cmd.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\python.exe OR *\\ruby.exe)) AND (process.command_line:(*while\($true\)* OR *for\(;;\)* OR *\:loop* OR *foreach\($i\ in\ 1..1gb\)* OR *AllocHGlobal* OR *\:\:MemoryStream* OR *New\-Object\ System.Collections.ArrayList* OR *Start\-Job* OR *Start\-ThreadJob* OR *Thread.Sleep*)) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\powerpnt.exe OR *\\httpd.exe OR *\\nginx.exe OR *\\rundll32.exe OR *\\explorer.exe)) AND (process.executable:(*\\Temp\\* OR *\\Users\\Public\\* OR *\\AppData\\Local\\Temp\\*))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM AND (process.parent.executable:(*\\CcmExec.exe OR *\\msiexec.exe OR *\\devenv.exe OR *\\powershellISE.exe)) AND (process.command_line:(*HealthCheck* OR *Diagnostic* OR *AzureAD* OR *System\ Center* OR *Test\-Connection*))))
