SELECT UTF8(payload) as search_payload from events where ("LoadedImage" LIKE ('%\user32.dll','%\advapi32.dll','%\win32u.dll')) AND processname LIKE '%.exe' AND NOT (processname LIKE ('C:\Windows\System32\%','C:\Windows\SysWOW64\%')) AND NOT (processname LIKE ('%\explorer.exe','%\chrome.exe','%\msedge.exe','%\firefox.exe','%\teams.exe')) 