((process.executable:(*\\net.exe OR *\\net1.exe)) OR (process.command_line:(*accounts* OR *Get\-DomainPolicy* OR *Get\-ADDefaultDomainPasswordPolicy* OR *Get\-ADFineGrainedPasswordPolicy*))) AND ((process.command_line:(*lockoutthreshold* OR *minpwdlength* OR *lockoutduration* OR *pwdcomplexity*)) OR (process.command_line:(*\ \>\ * OR *ConvertTo\-Json* OR *Export\-Csv*)) OR ((process.parent.executable:(*\\wsmprovhost.exe OR *\\httpd.exe OR *\\winword.exe OR *\\powershell.exe)) AND winlog.event_data.IntegrityLevel:Medium)) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR winlog.computer_name:*DC\-* OR (process.command_line:(*logon.bat* OR *Program\ Files*))))
