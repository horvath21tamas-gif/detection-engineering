SELECT Time, SourceIP, DestinationIP, user_name, Message from events where (("Message" LIKE '%copy tftp flash%' OR "Message" LIKE '%copy ftp flash%' OR "Message" LIKE '%request system software add%' OR "Message" LIKE '%update firmware%' OR "Message" LIKE '%boot system flash%' OR "Message" LIKE '%install activate%' OR "Message" LIKE '%request platform software%')) AND (("Message" LIKE '%tftp%' OR "Message" LIKE '%unauthenticated%' OR "Message" LIKE '%unknown source%' OR "Message" LIKE '%checksum failed%' OR "Message" LIKE '%hash mismatch%' OR "Message" LIKE '%signature validation failed%' OR "Message" LIKE '%untrusted image%' OR "Message" LIKE '%corrupt image%')) AND NOT (("SourceIP" LIKE '%10.50.0.10%' OR "SourceIP" LIKE '%10.50.0.11%' OR "SourceIP" LIKE '%10.50.0.12%') OR ("Message" LIKE '%copy running-config%' OR "Message" LIKE '%copy startup-config%' OR "Message" LIKE '%archive config%' OR "Message" LIKE '%save config%'))
