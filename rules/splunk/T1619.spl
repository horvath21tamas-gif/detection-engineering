Image IN ("*\\aws.exe", "*\\az.cmd", "*\\gcloud.cmd", "*\\gsutil.py") CommandLine IN ("*s3 ls*", "*s3api list-objects*", "*s3api list-object-versions*", "*storage blob list*", "*storage container list*", "*storage ls*", "*storage objects list*") CommandLine IN ("*--recursive*", "*--query*", "*--output json*", "* | jq*", "* > *", "*base64*") OR ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wsmprovhost.exe", "*\\httpd.exe") NOT (ParentImage IN ("*\\Veeam\\*", "*\\Commvault\\*", "*\\rclone.exe*", "*\\terraform.exe*") username="NT AUTHORITY\\SYSTEM")
