Image IN ("*\\wmic.exe", "*\\pnputil.exe", "*\\driverquery.exe", "*\\devcon.exe") OR CommandLine IN ("*Get-PnpDevice*", "*Get-WmiObject*", "*gwmi *") CommandLine IN ("*Win32_USBController*", "*Win32_DiskDrive*", "*Win32_NetworkAdapter*", "*USBSTOR*", "* /enum-devices*", "* /deviceid*") OR CommandLine IN ("* > *", "*ConvertTo-Json*", "*format-list*") OR (ParentImage IN ("*\\cmd.exe", "*\\powershell.exe", "*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe") IntegrityLevel="Medium") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\svchost.exe", "*\\msiexec.exe") OR CommandLine="*Program Files*")
