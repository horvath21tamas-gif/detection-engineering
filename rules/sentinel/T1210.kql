DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ParentProcessName in ("*\spoolsv.exe", "*\lsass.exe", "*\services.exe", "*\sqlservr.exe", "*\umworkerprocess.exe", "*\w3wp.exe")) and ((ProcessCommandLine in ("* -nop*", "* -w hidden*", "* -enc*", "*bypass*", "*iex(*", "*net user /add*")) or (FolderPath in ("*\AppData\*", "*\Temp\*", "*\Users\Public\*", "*\PerfLogs\*")) or (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\mshta.exe", "*\rundll32.exe", "*\werfault.exe", "*\certutil.exe", "*\scrcons.exe"))) and (not ((ProcessCommandLine in ("*C:\Windows\System32\wbem\WmiPrvSE.exe*", "*C:\Windows\ccmcache\*", "*\HealthCheck\*")) or ParentProcessCommandLine contains "winrm" or username =~ "NT AUTHORITY\NETWORK SERVICE"))