DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((['cs-method'] in ("POST", "PUT")) and (['cs-uri-stem'] in ("*/uploads/*", "*/upload/*", "*/files/*", "*/images/*", "*/tmp/*", "*/data/*")) and (['cs-uri-stem'] in ("*.php", "*.phtml", "*.php5", "*.asp", "*.aspx", "*.jsp"))) or (((['cs-uri-stem'] in ("*.php", "*.phtml", "*.php5", "*.asp", "*.aspx", "*.jsp")) and (['cs-uri-query'] in ("*cmd=*", "*exec=*", "*system=*", "*powershell=*", "*whoami*", "*net user*", "*uname*", "*id*", "*curl *", "*wget *")) and ['sc-status'] =~ 200 and (['cs-user-agent'] in ("*curl*", "*wget*", "*python*", "*powershell*", "*httpclient*", "*libwww*"))) and (not (['cs-uri-stem'] in ("*/wp-admin/*", "*/wp-json/*", "*/administrator/*", "*/api/*", "*/rest/*"))))