DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("* -Recurse*", "* /s *", "* -Include *", "* -Filter *", "*robocopy*", "*xcopy*")) and (ProcessCommandLine in ("*\\*", "*net use*", "*net view*")) and (ProcessCommandLine in ("*.doc*", "*.pdf*", "*.xls*", "*.pst*", "*.kdbx*", "*.key*", "*.config*", "*id_rsa*")) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\rundll32.exe", "*\explorer.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Program Files\Microsoft System Center\*", "*C:\Windows\CCM\*", "*C:\Program Files\Veritas\*", "*C:\Program Files\Commvault\*")) or (ProcessCommandLine in ("*SoftwareDistribution*", "*.log*")) or User =~ "NT AUTHORITY\SYSTEM"))