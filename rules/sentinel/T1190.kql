DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((['cs-uri-query'] in ("*<script*", "*</script*", "*<svg*", "*<iframe*", "*javascript:*", "*onerror=*", "*onload=*", "*%3cscript*", "*%3csvg*", "*%3ciframe*", "*%6a%61%76%61%73%63%72%69%70%74*")) or (['cs-method'] =~ "POST" and (['cs-uri-query'] in ("*<script*", "*javascript:*", "*onerror=*")))) and (['sc-status'] in (200, 403, 500)) and (not ((['cs-user-agent'] in ("*sqlmap*", "*nikto*", "*acunetix*", "*burp*", "*nessus*", "*zap*", "*w3af*")) or (['cs-uri-stem'] in ("*.js", "*.css", "*.png", "*.jpg", "*.gif", "*.svg"))))