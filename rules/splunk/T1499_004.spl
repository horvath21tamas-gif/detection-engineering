Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe") CommandLine IN ("*while($true)*", "*for(;;)*", "*::MemoryStream*", "*AllocHGlobal*", "*foreach($i in 1..1gb)*", "*:loop*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\outlook.exe") OR Image IN ("*\\Temp\\*", "*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe", "*\\devenv.exe") OR CommandLine IN ("*HealthCheck*", "*Diagnostic*", "*AzureAD*"))
