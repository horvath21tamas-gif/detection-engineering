ParentImage="*\\msiexec.exe" ParentCommandLine IN ("*\\Users\\*", "*\\Downloads\\*", "*\\Desktop\\*", "*\\AppData\\Local\\Temp\\*", "*\\Windows\\Temp\\*", "*\\PerfLogs\\*") Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\bitsadmin.exe", "*\\certutil.exe", "*\\mshta.exe", "*\\regsvr32.exe", "*\\scrcons.exe", "*\\rundll32.exe") OR CommandLine IN ("*http*", "*ftp*", "*-enc*", "*-ExecutionPolicy Bypass*", "*DownloadString*", "*Invoke-WebRequest*") NOT (ParentCommandLine IN ("*C:\\Windows\\ccmcache\\*", "*C:\\Windows\\IME\\*", "*C:\\Program Files\\*", "*C:\\Program Files (x86)\\*") username="NT AUTHORITY\\SYSTEM")
