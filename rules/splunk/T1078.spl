source="WinEventLog:Security" EventCode=4624 Status="0x0"
| rex field=IpAddress "(?<IpAddressMatch>^(?!127\\.|192\\.168\\.|10\\.).*)"
| eval IpAddressCondition=if(isnotnull(IpAddressMatch), "true", "false")
| search LogonType IN (3, 10, 8) (TargetUserName="svc_*" LogonType=10) OR (TargetUserName="*admin*" IpAddressCondition="true") NOT (WorkstationName="INFRA-MONITOR-*" OR IpAddress IN ("::1", "127.0.0.1") OR TargetUserName="svc_vulnerability_scanner")
