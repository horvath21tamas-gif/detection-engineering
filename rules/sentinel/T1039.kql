DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*\\*", "*net use*", "*net view*", "*dir \\*", "*dir /s /b*", "*Get-ChildItem -Recurse*", "*Get-SmbShare*", "*Get-SmbMapping*", "*robocopy \\*", "*findstr /s /i*")) and ((ProcessCommandLine in ("* > *", "* >> *", "* -OutFile *", "*Compress-Archive*", "*System.IO.Compression*", "*7z.exe a*", "*rar.exe a*", "*tar.exe -c*", "*copy \\*", "*move \\*")) or (ProcessCommandLine in ("*.kdbx*", "*.xlsx*", "*.xls*", "*.docx*", "*.pdf*", "*.pst*", "*.bak*", "*id_rsa*", "*id_dsa*", "*password*", "*confidential*", "*finance*", "*hr*"))) and ((ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\w3wp.exe", "*\httpd.exe", "*\rundll32.exe", "*\wmiprvse.exe")) and IntegrityLevel =~ "Medium") and (not ((FolderPath in ("*C:\Program Files\Veritas\*", "*C:\Program Files\Commvault\*", "*C:\Program Files\Veeam\*", "*C:\Windows\CCM\*")) or (ParentProcessName in ("*\services.exe", "*\svchost.exe")) or username =~ "NT AUTHORITY\SYSTEM" or (ProcessCommandLine in ("*SoftwareDistribution*", "*backup*"))))