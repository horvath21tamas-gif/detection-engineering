SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\wmic.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%root\subscription%','%__EventFilter%','%CommandLineEventConsumer%','%FilterToConsumerBinding%')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Register-WmiEvent%','%Set-WmiInstance%','%New-CimInstance%','%root\subscription%'))) AND NOT ("username" ILIKE '%SYSTEM%' OR ""Filename"" ILIKE ENUMERATION('%\Microsoft Monitoring Agent\%','%\SCOM\%','%\System Center\%','%\Tanium\%','%\Qualys\%','%\CrowdStrike\%','%\SentinelOne\%','%\SplunkUniversalForwarder\%','%\Datadog\%','%\Elastic\Agent\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%HealthCheck%','%Inventory%','%Monitoring%'))
