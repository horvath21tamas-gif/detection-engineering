DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*.exe *", "*.com *", "*.scr *", "*.pif *")) or (ProcessCommandLine in ("*.exe  *", "*.exe \"*", "*.exe /*"))) or (FolderPath in ("*Windows \*", "*System32 \*", "*Program Files \*", "*AppData \*"))) and ((FolderPath in ("*\Users\*", "*\Public\*", "*\Temp\*", "*\Downloads\*")) or (not ((FolderPath in ("C:\Windows\System32\*", "C:\Windows\WinSxS\*", "C:\Windows\SoftwareDistribution\*")) or username =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\msiexec.exe")))