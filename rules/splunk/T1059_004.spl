Image IN ("*/sh", "*/bash", "*/zsh", "*/dash") (ParentImage IN ("*/httpd", "*/apache2", "*/nginx", "*/php-fpm", "*/node", "*/python", "*/java") username IN ("www-data", "apache", "nginx", "nobody")) OR CommandLine IN ("*/dev/tcp/*", "*/dev/udp/*", "*>&*", "*0>&1*") OR (CommandLine="*curl*" CommandLine="*|*" CommandLine="*sh*") OR (CommandLine="*wget*" CommandLine="*|*" CommandLine="*bash*") NOT (ParentImage IN ("*/systemd", "*/sbin/init") OR CommandLine IN ("*/var/lib/apt/*", "*logrotate*", "*/usr/bin/mandb*") OR (username="root" Parentprocessname="/usr/sbin/sshd"))
