TargetFilename IN ("/etc/rc.local*", "/etc/rc.d/*", "/etc/init.d/*", "/etc/update-rc.d/*", "/usr/lib/systemd/system-generators/*") Image IN ("*/python", "*/python3", "*/perl", "*/ruby", "*/lua", "*/bash", "*/sh", "*/nc", "*/socat", "*/curl", "*/wget") OR CommandLine IN ("*>>*", "*tee -a*", "*sed -i*") NOT ((ParentImage IN ("*/apt", "*/dpkg", "*/yum", "*/dnf", "*/rpm", "*/zypper", "*/pacman") Image IN ("*/frontend", "*/preinst", "*/postinst")) OR Image IN ("*/ansible/*", "*/salt/*", "*/puppet/*"))
