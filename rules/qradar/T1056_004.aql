SELECT UTF8(payload) as search_payload from events where "Image" ILIKE '%.exe' AND (("LoadedImage" LIKE '%\\user32.dll%' OR "LoadedImage" LIKE '%\\advapi32.dll%' OR "LoadedImage" LIKE '%\\win32u.dll%')) AND (("LoadedImage" LIKE '%user32.dll%' OR "LoadedImage" LIKE '%advapi32.dll%')) AND (("Filename" LIKE '%\\Users\\%' OR "Filename" LIKE '%\\AppData\\%' OR "Filename" LIKE '%\\Temp\\%' OR "Filename" LIKE '%\\ProgramData\\%')) AND NOT (("Filename" LIKE '%C:\\Windows\\System32\\%' OR "Filename" LIKE '%C:\\Windows\\SysWOW64\\%') OR ("Filename" LIKE '%\\explorer.exe%' OR "Filename" LIKE '%\\chrome.exe%' OR "Filename" LIKE '%\\msedge.exe%' OR "Filename" LIKE '%\\firefox.exe%' OR "Filename" LIKE '%\\teams.exe%' OR "Filename" LIKE '%\\outlook.exe%' OR "Filename" LIKE '%\\slack.exe%' OR "Filename" LIKE '%\\zoom.exe%') OR ("Filename" LIKE '%\\Accessibility\\%' OR "Filename" LIKE '%\\Screen Recorder\\%' OR "Filename" LIKE '%\\ScreenCapture\\%' OR "Filename" LIKE '%\\Security\\%' OR "Filename" LIKE '%\\Antivirus\\%' OR "Filename" LIKE '%\\EDR\\%' OR "Filename" LIKE '%\\Defender\\%' OR "Filename" LIKE '%\\CrowdStrike\\%' OR "Filename" LIKE '%\\SentinelOne\\%'))
