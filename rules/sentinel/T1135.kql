DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\Snaffler.exe", "*\SharpShares.exe", "*\PowerView.ps1", "*\net.exe", "*\net1.exe")) or (ProcessCommandLine in ("*view*", "*Invoke-ShareFinder*", "*Get-NetShare*", "*Find-DomainShare*"))) and ((ProcessCommandLine in ("* /domain*", "* /all*", "* -ComputerName*", "*foreach*", "*\\*")) or (ProcessCommandLine in ("*password*", "*confidential*", "*backup*", "*config*", "*credentials*", "*key*")) or ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe")) and IntegrityLevel =~ "Medium")) and (not (username =~ "NT AUTHORITY\SYSTEM" or (FolderPath in ("*\Program Files\Tanium\*", "*\Program Files\Splunk\*", "*\Windows\System32\CcmExec.exe*")) or ProcessCommandLine contains "net share"))