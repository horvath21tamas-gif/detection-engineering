SELECT UTF8(payload) as search_payload from events where ""Filename"" ILIKE '%/System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/Resources/kickstart' AND (""Process CommandLine"" ILIKE ENUMERATION('%-activate%','%-allowAccessFor -allUsers%','%-privs -all%','%-clientopts -setmenuextra -menuextra no%')) AND (""Parent Filename"" ILIKE ENUMERATION('%/sh','%/bash','%/zsh','%/python','%/perl','%/ruby','%/curl')) AND "username"='root' AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/usr/libexec/admd','%/usr/local/jamf/bin/jamf','%/usr/local/bin/kandji') OR ""Process CommandLine"" ILIKE ENUMERATION('%-get_status%','%-users mdm_admin%'))
