SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\wevtutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Security%','%System%','%Setup%','%PowerShell%')) OR ""Filename"" ILIKE '%\fsutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%usn%','%deletejournal%')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%del %','%Remove-Item%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%\Windows\Prefetch\%','%\System32\config\Journal%')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\w3wp.exe','%\powershell.exe','%\cmd.exe') OR NOT ("username" ILIKE 'NT AUTHORITY\%' AND (""Parent Filename"" ILIKE ENUMERATION('%\services.exe','%\svchost.exe','%\msiexec.exe')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('%cleanmgr.exe%','%CCM\Temp%','%HealthCheck%')))
