Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*-enc*", "*-encodedcommand*") CommandLine IN ("*-nop*", "*-w hidden*", "*-windowstyle hidden*", "*-executionpolicy bypass*", "*FromBase64String*", "*IEX*", "*Invoke-Expression*") ParentImage IN ("*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\WINWORD.EXE", "*\\EXCEL.EXE", "*\\POWERPNT.EXE") NOT (User IN ("*NT AUTHORITY\\SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*") OR ParentImage IN ("*\\Windows\\CCM\\*", "*\\Microsoft Configuration Manager\\*", "*\\SCCM\\*", "*\\Tanium\\*", "*\\PDQ\\*", "*\\Ivanti\\*", "*\\ManageEngine\\*", "*\\Intune\\*", "*\\Elastic\\*", "*\\Splunk\\*"))
