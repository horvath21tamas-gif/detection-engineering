DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*System.Windows.Forms*", "*System.Drawing*", "*Microsoft.VisualBasic.Interaction*"))) or (ProcessCommandLine in ("*OTP*", "*MFA*", "*Hitelesito*", "*kod*", "*Verification*"))) and (not ((ParentProcessName in ("*\CcmExec.exe", "*\SidecarAgent.exe", "*\ManagementAgent.exe")) and username =~ "NT AUTHORITY\SYSTEM")) and (not (FolderPath in ("*\Windows\AdminArsenal\*", "*\Windows\System32\GroupPolicy\Machine\Scripts\*")))) or ((FolderPath endswith "\msg.exe" and (ProcessCommandLine in ("*approve*", "*confirm*", "*megerosites*", "*fogadja el*"))) and (not (ProcessCommandLine in ("*update*", "*upgrade*", "*check-for-updates*"))))