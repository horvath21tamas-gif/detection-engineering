DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\nmap.exe", "*\portqry.exe", "*\telnet.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\netstat.exe")) and ((ProcessCommandLine in ("*foreach*", "*ForEach-Object*", "*for /L*", "*1..254*", "*1..255*", "*Test-NetConnection*", "*System.Net.Sockets.TcpClient*", "*New-Object Net.Sockets.TcpClient*")) or ProcessCommandLine matches regex "(?i).*(10\\.|172\\.16\\.|192\\.168\\.).*(\\/24|\\/16).*" or ((ProcessCommandLine in ("*-Port 445*", "*-Port 3389*", "*-Port 5985*", "*-Port 22*", "*-Port 80*", "*-p 445*", "*-p 3389*", "*-p 22*", "*-p 1-1024*", "*-p-*")) and ((ParentProcessName in ("*\cmd.exe", "*\powershell.exe", "*\wsmprovhost.exe", "*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\httpd.exe")) and IntegrityLevel =~ "Medium"))) and username contains "\" and (not username =~ "NT AUTHORITY\SYSTEM") and (not ((FolderPath in ("*\Program Files\Zabbix\*", "*\Program Files\Tanium\*", "*\Program Files\Nessus\*")) or (ParentProcessName in ("*\services.exe", "*\svchost.exe")) or (ProcessCommandLine in ("*healthcheck*", "*monitor*"))))