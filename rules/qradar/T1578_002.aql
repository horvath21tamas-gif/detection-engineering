SELECT UTF8(payload) as search_payload from events where (("operation_name" LIKE '%ModifySnapshotAttribute%' OR "operation_name" LIKE '%SharedSnapshot%' OR "operation_name" LIKE '%SetSnapshotPermissions%' OR "operation_name" LIKE '%CopySnapshot%')) AND (("request_parameters" LIKE '%all%' OR "request_parameters" LIKE '%Add.UserId%' OR "request_parameters" LIKE '%grantee%' OR "request_parameters" LIKE '%public%') OR "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%boto3%'))) AND NOT ((("user_name" LIKE '%svc-veeam%' OR "user_name" LIKE '%svc-commvault%' OR "user_name" LIKE '%backup-agent%')) AND "source_ip"='10.0.0.0/8')
