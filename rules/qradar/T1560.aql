SELECT UTF8(payload) as search_payload from events where ("Image" ILIKE ENUMERATION('%\7z.exe','%\7za.exe','%\rar.exe','%\WinRAR.exe','%\tar.exe','%\powershell.exe','%\pwsh.exe') OR "ImageName" ILIKE ENUMERATION('7z.exe','7za.exe','Rar.exe','tar.exe','PowerShell.EXE')) AND ("Process CommandLine" ILIKE ENUMERATION('% a %','% -a%','% -cf %','%Compress-Archive%','%New-Object System.IO.Compression%')) AND ("Process CommandLine" ILIKE ENUMERATION('% -p%','% -hp%','% -v%','% -mhe=on%','% -sdel%') OR "Process CommandLine" ILIKE ENUMERATION('%\AppData\%','%\Temp\%','%\Users\Public\%','%\ProgramData\%','%C:\PerfLogs\%')) AND NOT (("ParentImage" ILIKE ENUMERATION('%\msiexec.exe','%\CcmExec.exe')) AND "Process CommandLine" ILIKE '%\Microsoft\Windows\SoftwareDistribution\%')
