SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%Classes\CLSID\%' AND (("Target Object" LIKE '%\\InprocServer32\\(Default%')','%\LocalServer32\(Default)')) AND (("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%:\\Windows\\Temp\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%.tmp%' OR "Target Details" LIKE '%.bat%' OR "Target Details" LIKE '%.ps1%') OR ("Target Details" LIKE '%scrobj.dll%' OR "Target Details" LIKE '%comsvcs.dll%' OR "Target Details" LIKE '%script:%')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\Microsoft\OneDrive\OneDrive.exe','%\Microsoft\Teams\current\Teams.exe','%\Office16\OUTLOOK.EXE','%\System32\msiexec.exe','%\trustedinstaller.exe')) AND (("Target Details" LIKE '%\\AppData\\Local\\Microsoft\\OneDrive\\%' OR "Target Details" LIKE '%\\AppData\\Local\\Microsoft\\Teams\\%' OR "Target Details" LIKE '%\\AppData\\Local\\Microsoft\\Office\\%')))
