SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%System\CurrentControlSet\Control\Session Manager\AppCertDlls%' AND (("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%:\\Windows\\Temp\\%' OR "Target Details" LIKE '%C:\\PerfLogs\\%') OR ""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\reg.exe','%\cscript.exe','%\wscript.exe')) AND NOT ((""Filename"" ILIKE ENUMERATION('%\trustedinstaller.exe','%\System32\msiexec.exe')) AND (""Filename"" ILIKE ENUMERATION('%C:\$WINDOWS.~BT\%','%C:\Windows\System32\oobe\%')))
