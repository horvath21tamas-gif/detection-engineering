DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine =~ "(runas /token|make_token|steal_token|Invoke-TokenManipulation|CPAU\.exe|load_privilege)" or (ParentProcessName =~ "(powershell\.exe|pwsh\.exe|cmd\.exe|cscript\.exe|wscript\.exe)$" and User =~ "SYSTEM" and LogonId =~ "0x3e7")) and (not ((ParentProcessName =~ "(services\.exe|wininit\.exe|lsass\.exe|winlogon\.exe)$" or FolderPath =~ "(conhost\.exe|WerFault\.exe|WmiPrvSE\.exe)$" or ParentProcessCommandLine matches regex "svchost\\.exe -k") or FolderPath =~ "(\Program Files\Windows Defender\|\Program Files\CrowdStrike\|\SentinelOne\)"))