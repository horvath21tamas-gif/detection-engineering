DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\upx.exe", "*\mpress.exe", "*\aspack.exe", "*\pecompact.exe", "*\fsg.exe", "*\themida.exe")) and ((ProcessCommandLine in ("* -9*", "* --ultra-brute*", "* --brute*", "* -f*", "* -o *")) or (ProcessCommandLine in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*", "*\Downloads\*", "*\Desktop\*")) or (ParentProcessName in ("*\powershell.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe"))) and (not ((FolderPath in ("*\Visual Studio\*", "*\Jenkins\*", "*\GitLab-Runner\*")) and (ParentProcessName in ("*\msbuild.exe*", "*\devenv.exe*")))) and (not (User in ("*svc-build*", "*cicd*")))