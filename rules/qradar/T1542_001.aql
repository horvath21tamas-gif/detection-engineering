SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\flashrom.exe','%\FPTW64.exe','%\AfuEfix64.exe','%\InsydeFlash.exe') OR ("ImageName" LIKE '%flashrom.exe%' OR "ImageName" LIKE '%FPTW64.exe%' OR "ImageName" LIKE '%amifldrv64.sys%') OR ""Filename"" ILIKE '%\sc.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%type= kernel%','%binpath=%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe')) AND (""Filename"" ILIKE ENUMERATION('%temp%','%public%','%download%')) AND NOT ((""Parent Filename"" ILIKE ENUMERATION('%\Dell\CommandUpdate\%','%\Lenovo\SystemUpdate\%','%\HP\HP Support Assistant\%')) AND ""Filename"" ILIKE '%C:\Windows\System32\SystemSettingsAdminFlows.exe%')
