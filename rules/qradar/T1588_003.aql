SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\certutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-exportPFX%','%-p %','%-p=%')) OR ""Filename"" ILIKE '%\certutil.exe' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%-urlcache%','%-addstore%')) OR (""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%Export-PfxCertificate%','%Import-PfxCertificate%','%Set-AuthenticodeSignature%'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\mmc.exe','%\ServerManager.exe','%\svchost.exe') OR (""Filename"" ILIKE ENUMERATION('%\Jenkins\%','%\AzureDevOps\%','%\MSBuild\%')) AND "username" ILIKE '%SVC_Build%')
