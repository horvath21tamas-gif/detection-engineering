DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\tcpdump.exe", "*\windump.exe", "*\scapy.exe", "*\nmap.exe", "*\hping.exe")) and (OriginalFileName in ("tcpdump.exe", "windump.exe", "scapy.exe", "nmap.exe", "hping.exe"))) or ((ProcessCommandLine contains "advfirewall firewall add rule" and ProcessCommandLine contains "action=allow" and ProcessCommandLine contains "protocol=UDP") and (ProcessCommandLine in ("*protocol=ICMP*", "*localport=any*", "*remoteport=any*")))) and ((ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe")) and (FolderPath in ("*\Users\*", "*\Temp\*", "*\Downloads\*", "*\AppData\*", "*\ProgramData\*"))) and (not (User startswith "NT AUTHORITY\" and (FolderPath in ("*\Windows\System32\svchost.exe*", "*\Program Files\Windows Defender\*", "*\Program Files\CrowdStrike\*", "*\Program Files\SentinelOne\*")) and ProcessCommandLine contains "description="))