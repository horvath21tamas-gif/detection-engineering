DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*-enc*", "*-encodedcommand*"))) and (ProcessCommandLine in ("*Invoke-WebRequest*", "*iwr*", "*wget*", "*curl*", "*DownloadString*", "*DownloadFile*", "*Net.WebClient*"))