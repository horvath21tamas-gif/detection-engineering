CommandLine IN ("*user /add /domain*", "*user /ad /domain*", "*New-ADUser*", "*dsadd user*") ParentImage IN ("*\\wsmprovhost.exe", "*\\psexesvc.exe", "*\\wmiprvse.exe", "*\\w3wp.exe", "*\\powershell.exe") OR (NOT (ParentImage IN ("*\\mmc.exe", "*\\dsac.exe", "*\\ServerManager.exe") User IN ("*svc_iam*", "*svc_hr_sync*")) NOT (Image IN ("*\\lsass.exe", "*\\services.exe") username="NT AUTHORITY\\SYSTEM"))
