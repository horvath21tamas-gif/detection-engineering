SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%\Software\Microsoft\Office\%' AND (("Target Object" LIKE '%\\Security\\VBAWarnings%' OR "Target Object" LIKE '%\\Security\\Trusted Locations\\%' OR "Target Object" LIKE '%\\Security\\Trusted Documents\\DisableTrustedDocuments%' OR "Target Object" LIKE '%\\Security\\BlockContentExecutionFromInternet%')) AND (("Target Details" LIKE '%DWORD (0x00000001%')','DWORD (0x00000000)') OR ""Filename"" ILIKE ENUMERATION('%\powershell.exe','%\cmd.exe','%\reg.exe','%\wscript.exe','%\cscript.exe')) AND NOT (("Target Details" LIKE '%\\InternalStorage\\Templates%' OR "Target Details" LIKE '%C:\\Program Files\\%'))
