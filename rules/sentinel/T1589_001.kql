DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (SrcIp in ("1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "8.*", "9.*")) and (UriStem in ("*/api/auth*", "*/api/login*", "*/api/token*", "*/api/session*", "*/api/password*", "*/auth/api*", "*/v1/auth*", "*/v2/auth*")) and (RequestBody in ("*username*", "*email*", "*password*", "*pass*", "*pwd*", "*secret*")) and Method =~ "POST" and (UserAgent in ("*curl*", "*wget*", "*python*", "*requests*", "*go-http-client*", "*httpclient*", "*axios*", "*libwww*", "*scanner*", "*probe*")) and (Status in (401, 403, 404, 422)) and (not ((UserAgent in ("*Mozilla*", "*Chrome*", "*Firefox*", "*Safari*", "*Edge*", "*HeadlessChrome*")) or (UriStem in ("*/sso*", "*/oauth*", "*/openid*", "*/saml*", "*/idp*", "*/federation*")) or (UserAgent in ("*nessus*", "*qualys*", "*openvas*", "*acunetix*", "*nuclei*", "*zabbix*", "*prometheus*", "*uptime*", "*pingdom*", "*datadog*", "*newrelic*"))))