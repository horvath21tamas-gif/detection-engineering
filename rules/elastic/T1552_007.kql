((CommandLine:(*\/var\/run\/secrets\/kubernetes.io\/serviceaccount* OR *\/run\/secrets\/* OR *\/etc\/kubernetes\/admin.conf* OR *\/root\/.kube\/config* OR *.docker\/config.json* OR *\/.aws\/credentials* OR *\/.azure\/* OR *\/.config\/gcloud\/*)) OR (CommandLine:(*token* OR *authorization* OR *kubeconfig* OR *client\-secret* OR *access_key* OR *secret_key*)) OR ((CommandLine:(*env* OR *\|*)) OR (CommandLine:(*printenv* OR *\|*)) OR (CommandLine:(*set* OR *\|*)) OR (CommandLine:(*export* OR *\|*))) OR ((CommandLine:(*cat* OR *base64*)) OR (CommandLine:(*cat* OR *grep*)) OR (CommandLine:(*xxd* OR *hexdump*)))) AND (((Image:(*\/sh OR *\/bash OR *\/dash OR *\/zsh)) AND (CommandLine:(*\-i* OR *\-c*))) OR (ParentImage:(*\/nginx OR *\/httpd OR *\/apache2 OR *\/php\-fpm OR *\/node OR *\/gunicorn OR *\/uwsgi)) OR (ParentImage:(*kubectl* OR *containerd* OR *docker* OR *cri\-o*))) AND (NOT ((CommandLine:(*docker\-entrypoint.sh* OR *\/init.sh* OR *\/usr\/local\/bin\/start.sh*)) AND (Image:(*\/usr\/bin\/promtail* OR *\/usr\/bin\/fluentd* OR *\/usr\/bin\/telegraf* OR *\/pause*)) AND (username:(fluentd OR root))))
