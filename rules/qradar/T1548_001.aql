SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%/chmod' AND (""Process CommandLine"" ILIKE ENUMERATION('%u+s%','%g+s%','%4755%','%4777%','%2755%','%4000%','%2000%')) AND (""Process CommandLine"" ILIKE ENUMERATION('%/tmp/%','%/dev/shm/%','%/var/tmp/%','%/home/%','%/run/%') OR ""Parent Filename"" ILIKE ENUMERATION('%/bash','%/zsh','%/sh')) OR ""Filename"" ILIKE '%/find' AND (""Process CommandLine"" ILIKE ENUMERATION('%-perm -4000%','%-perm -2000%'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/apt','%/dpkg','%/yum','%/dnf','%/rpm','%/ansible','%/puppet') OR "username"='root')
