DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (((FolderPath in ("*\flashrom.exe", "*\FPTW64.exe", "*\AfuEfix64.exe", "*\InsydeFlash.exe")) and (OriginalFileName in ("flashrom.exe", "FPTW64.exe", "amifldrv64.sys"))) or (FolderPath endswith "\sc.exe" and (ProcessCommandLine in ("* create *", "* type= kernel*", "* binpath=*")))) and ((ParentProcessName in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe")) and (FolderPath in ("*\temp\*", "*\public\*", "*\download\*"))) and (not ((ParentProcessName in ("*\Dell\CommandUpdate\*", "*\Lenovo\SystemUpdate\*", "*\HP\HP Support Assistant\*")) and FolderPath contains "C:\Windows\System32\SystemSettingsAdminFlows.exe"))