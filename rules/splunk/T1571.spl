Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\mshta.exe", "*\\regsvr32.exe", "*\\certutil.exe", "*\\scrcons.exe", "*\\bitsadmin.exe") NOT (DestinationPort IN (53, 80, 443, 8080, 8443, 5985, 5986)) NOT (DestinationIp IN ("10.*", "192.168.*", "172.16.*", "172.17.*", "172.18.*", "172.19.*", "172.2*", "172.3*", "127.*", "169.254.*")) NOT (Image IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*") OR username="NT AUTHORITY\\SYSTEM")
