Image="*\\control.exe" OriginalFileName="control.exe" IntegrityLevel IN ("Low", "Medium") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\chrome.exe", "*\\msedge.exe") OR CommandLine IN ("*http://*", "*https://*", "*\\\\*") OR (CommandLine IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*", "*\\Downloads\\*", "*\\PerfLogs\\*") CommandLine IN ("*.dll*", "*.tmp*", "*.dat*", "*.png*", "*.jpg*", "*.txt*")) NOT (Image IN ("C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*") ParentImage="*\\explorer.exe" IntegrityLevel="High" CommandLine IN ("*.cpl*", "*C:\\Windows\\System32\\*")) NOT User="NT AUTHORITY\\*"
