winlog.channel:Security AND (((event.code:4624 AND winlog.event_data.LogonType:9 AND winlog.event_data.LogonProcessName:seclogo AND winlog.event_data.AuthenticationPackage:Negotiate) OR ((event.code:(4768 OR 4769)) AND winlog.event_data.TicketEncryptionType:0x17) OR (event.code:4624 AND winlog.event_data.LogonType:3 AND winlog.event_data.AuthenticationPackage:NTLM AND (source.ip:(127.0.0.1 OR \:\:1)))) AND (NOT (winlog.event_data.TargetUserName:*$ OR user.name:*$ OR (process.executable:(*\\Windows\\System32\\svchost.exe* OR *\\Windows\\System32\\lsass.exe*)))))
