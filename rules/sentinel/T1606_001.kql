DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*\Network\Cookies*", "*\User Data\Default\Cookies*", "*\User Data\Profile *", "*\Local State*", "*\Login Data*", "*\Web Data*", "*\cookies.sqlite*", "*key4.db*")) and ((ProcessCommandLine in ("*sqlite3*", "*.dump*", "*select host_key*", "*select encrypted_value*", "*esentutl*", "*/y *", "*copy *", "*type *", "*Get-Content*")) or (ProcessCommandLine in ("*os_crypt*", "*encrypted_key*", "*CryptUnprotectData*", "*ProtectedData.Unprotect*", "*FromBase64String*", "*DPAPI*", "*System.Security.Cryptography*")) or (ProcessCommandLine in ("*ChromeGrabber*", "*CookieGrabber*", "*EdgeCookies*", "*BrowserStealer*", "*RedLine*", "*Vidar*", "*Raccoon*")))) and (((FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\python.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe")) and (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\wsmprovhost.exe", "*\chrome.exe", "*\msedge.exe")) and IntegrityLevel =~ "Medium") or (FolderPath in ("*\Users\*", "*\AppData\Local\Temp\*", "*\Downloads\*", "*\Public\*")) or (ProcessCommandLine in ("*\Users\Public\*", "*\AppData\Local\Temp\*", "*\Windows\Temp\*", "*.zip*", "*.7z*", "*.rar*", "*Compress-Archive*"))) and (not ((FolderPath in ("*\Program Files\Google\Chrome\*", "*\Program Files (x86)\Google\Chrome\*", "*\Program Files (x86)\Microsoft\Edge\*", "*\Program Files\Mozilla Firefox\*", "*\Program Files\BraveSoftware\*", "*\Program Files\Opera\*")) or (FolderPath in ("*\Microsoft\Teams\*", "*\Slack\*", "*\Discord\*", "*\OneDrive\*")) or (username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\services.exe", "*\MsMpEng.exe", "*\svchost.exe")))))