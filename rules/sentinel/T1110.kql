DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("* -P *", "* -L *", "* -p *", "* -u *", "*passlist*", "*userlist*", "*wordlist*", "*.dic*", "*.lst*")) or ((FolderPath in ("*\net.exe", "*\net1.exe", "*\cmd.exe", "*\powershell.exe")) and (ProcessCommandLine in ("*use *", "*Test-ComputerSecureChannel*", "*New-Object System.DirectoryServices.DirectoryEntry*", "*LogonUser*")))) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Downloads\*", "*\Public\*")) and (FolderPath in ("*\python.exe", "*\pythonw.exe"))) and (not (((ParentProcessName in ("*\Program Files\Microsoft Azure AD Connect\*", "*\Program Files\Puppet Labs\*", "*\Program Files\Ansible\*")) and username =~ "NT AUTHORITY\SYSTEM") or (FolderPath in ("*\chrome.exe", "*\msedge.exe"))))