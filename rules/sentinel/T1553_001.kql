DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "/spctl" and ProcessCommandLine contains "assess") or ((FolderPath endswith "/xattr" and (ProcessCommandLine in ("*-d com.apple.quarantine*", "*-rc com.apple.quarantine*", "*--delete com.apple.quarantine*"))) and (ProcessCommandLine in ("*/tmp/*", "*/private/var/tmp/*", "*/Users/Shared/*", "*/Downloads/*", "*/Volumes/*", "*/Library/Application Support/*")) and ((ParentProcessName in ("*/sh", "*/bash", "*/zsh", "*/python", "*/python3", "*/perl", "*/php", "*/osascript", "*/launchctl", "*/cron")) or (ParentProcessName in ("*/Microsoft Word", "*/Microsoft Excel", "*/Preview", "*/Google Chrome", "*/Safari"))))) and (not ((ParentProcessName in ("/System/Library/*", "/usr/libexec/*", "/usr/sbin/softwareupdate*", "/Applications/Xcode.app/*", "/Applications/Install *")) and (FolderPath in ("/usr/bin/codesign*", "/usr/bin/productbuild*")))) and (not (ParentProcessName in ("*/Terminal", "*/iTerm2")))