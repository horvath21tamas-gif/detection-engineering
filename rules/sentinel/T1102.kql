DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ProcessCommandLine in ("*api.github.com*", "*raw.githubusercontent.com*", "*api.telegram.org*", "*discord.com/api/webhooks*", "*pastebin.com/raw/*", "*gist.githubusercontent.com*", "*drive.google.com/uc*")) and ((FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\curl.exe", "*\certutil.exe", "*\bitsadmin.exe", "*\rundll32.exe", "*\regsvr32.exe", "*\mshta.exe")) or (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Windows\Temp\*", "*\Users\Public\*"))) and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*chocolatey*", "*scoop*", "*winget*")) or User =~ "NT AUTHORITY\SYSTEM"))