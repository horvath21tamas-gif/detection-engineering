Image IN ("*\\sc.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\net.exe", "*\\net1.exe") CommandLine IN ("*stop *", "*config *", "*start= disabled*", "*binpath=*", "*Stop-Service*", "*Set-Service*", "* -Status Stopped*", "* -StartupType Disabled*") CommandLine IN ("*WinDefend*", "*MpsSvc*", "*EventLog*", "*RpcSs*", "*LanmanServer*", "*SDRSVC*", "*VSS*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\httpd.exe", "*\\rundll32.exe", "*\\outlook.exe") OR Image IN ("*\\Temp\\*", "*\\Users\\Public\\*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\CcmExec.exe", "*\\msiexec.exe", "*\\TiWorker.exe") OR CommandLine IN ("*HealthCheck*", "*Update*", "*Diagnostic*"))
