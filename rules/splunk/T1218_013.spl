Image="*\\rundll32.exe" OR OriginalFileName="RUNDLL32.EXE" CommandLine IN ("*javascript:*", "*vbscript:*", "*url.dll,OpenURL*", "*url.dll,FileProtocolHandler*", "*pcwutl.dll,LaunchApplication*", "*shell32.dll,Control_RunDLL*") OR (CommandLine IN ("*\\AppData\\*", "*\\Users\\Public\\*", "*\\Temp\\*", "*\\Downloads\\*", "*.txt*", "*.png*", "*.jpg*", "*.dat*", "*.inf*") ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\powershell.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\mshta.exe")) NOT (CommandLine IN ("*C:\\Windows\\System32\\*", "*C:\\Windows\\SysWOW64\\*", "*C:\\Windows\\WinSxS\\*") ParentImage="*\\explorer.exe" username="NT AUTHORITY\\SYSTEM")
