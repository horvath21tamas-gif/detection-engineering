(winlog.event_data.processname:\(wmic\\.exe\|pnputil\\.exe\|driverquery\\.exe\|devcon\\.exe\)$ AND winlog.event_data.processcommandline:\(Get\-PnpDevice\|Get\-WmiObject\|gwmi\)) AND (winlog.event_data.processcommandline:\(Win32_USBController\|Win32_DiskDrive\|Win32_NetworkAdapter\|USBSTOR\|\/enum\-devices\|\/deviceid\) OR winlog.event_data.processcommandline:\(\>\\s\|ConvertTo\-Json\|format\-list\) OR (winlog.event_data.Parentprocessname:\(cmd\\.exe\|powershell\\.exe\|wsmprovhost\\.exe\|httpd\\.exe\|winword\\.exe\)$ AND winlog.event_data.IntegrityLevel:Medium)) AND (NOT (winlog.event_data.username:"NT AUTHORITY\\SYSTEM" AND winlog.event_data.Parentprocessname:\(svchost\\.exe\|msiexec\\.exe\)$ AND process.command_line:*Program\ Files*))
