DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath endswith "\odbcconf.exe" and OriginalFileName =~ "odbcconf.exe") and (IntegrityLevel in ("Low", "Medium")) and ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\ProgramData\*")) or ((ProcessCommandLine in ("*REGSVR*", "*regsvr*", "*/a*", "*{REGSVR*")) and ((ProcessCommandLine in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*", "*\Downloads\*")) or (ProcessCommandLine in ("*http://*", "*https://*", "*\\*")) or (ProcessCommandLine in ("*.txt*", "*.dat*", "*.png*", "*.tmp*", "*.inf*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\powershell.exe", "*\pwsh.exe", "*\cmd.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe", "*\rundll32.exe", "*\chrome.exe", "*\msedge.exe"))))) and (not ((FolderPath in ("C:\Windows\System32\*", "C:\Windows\SysWOW64\*")) and ((ParentProcessName in ("*\msiexec.exe", "*\trustedinstaller.exe")) and IntegrityLevel =~ "High"))) and (not User startswith "NT AUTHORITY\")