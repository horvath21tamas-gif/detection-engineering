SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE 'HKLM\SYSTEM\CurrentControlSet\Services\%' AND (("Target Object" LIKE '%\\ImagePath%' OR "Target Object" LIKE '%\\ServiceDll%' OR "Target Object" LIKE '%\\Parameters\\ServiceDll%')) AND (("Target Details" LIKE '%.exe%' OR "Target Details" LIKE '%.dll%')) AND (("Target Details" LIKE '%\\Users\\%' OR "Target Details" LIKE '%\\ProgramData\\%' OR "Target Details" LIKE '%\\AppData\\%' OR "Target Details" LIKE '%\\Temp\\%')) AND NOT (("Target Details" LIKE '%\\Windows\\%' OR "Target Details" LIKE '%\\Program Files\\%' OR "Target Details" LIKE '%\\Program Files (x86%')\%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\Windows\System32\services.exe%','%\Windows\System32\svchost.exe%','%\Windows\System32\msiexec.exe%','%\Windows\servicing\%')) AND NOT (("UserName" LIKE '%NT AUTHORITY\\SYSTEM%' OR "UserName" LIKE '%NT SERVICE\\TrustedInstaller%'))
