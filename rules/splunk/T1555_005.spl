CommandLine IN ("*.kdbx*", "*.opvault*", "*.agilekeychain*", "*vault.db*", "*key3.db*", "*key4.db*") CommandLine IN ("*copy *", "*type *", "*7z*", "*rar*", "*zip*", "*esentutl*") OR Image="*\\sqlite3.exe" OR (Image IN ("*\\Users\\*", "*\\AppData\\Local\\Temp\\*", "*\\Public\\*") Image IN ("*\\powershell.exe", "*\\cmd.exe", "*\\python.exe")) NOT ((Image IN ("*\\Program Files\\KeePass*", "*\\Program Files\\1Password*", "*\\Program Files\\Bitwarden*") ParentImage IN ("*\\services.exe", "*\\svchost.exe") username="NT AUTHORITY\\SYSTEM") OR Image IN ("*\\OneDrive.exe", "*\\Dropbox.exe"))
