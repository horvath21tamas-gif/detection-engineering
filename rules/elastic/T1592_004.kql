(SrcIp:(1.* OR 2.* OR 3.* OR 4.* OR 5.* OR 6.* OR 7.* OR 8.* OR 9.*)) AND (HttpMethod:(HEAD OR OPTIONS OR TRACE)) AND (UriStem:(\/ OR \/index OR \/login OR \/admin)) AND (UserAgent:(*curl* OR *wget* OR *python* OR *httpclient* OR *go\-http\-client* OR *libwww* OR *probe* OR *scanner*)) AND (RequestHeaders:(*Accept\-Language* OR *Accept\-Encoding* OR *X\-Forwarded\-For* OR *Forwarded* OR *Via*)) AND (NOT ((UserAgent:(*Mozilla* OR *Chrome* OR *Safari* OR *Firefox* OR *Edge*)) OR (UserAgent:(*nessus* OR *qualys* OR *openvas* OR *acunetix* OR *nikto* OR *nuclei* OR *zap* OR *zabbix* OR *uptime* OR *pingdom*)) OR (UriStem:(*.css OR *.js OR *.png OR *.jpg OR *.svg OR *.ico OR *.woff OR *.woff2 OR *.json OR *\/api))))
