DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\bcdedit.exe" and ((ProcessCommandLine contains " /set" and ProcessCommandLine contains "safeboot") and (ProcessCommandLine in ("*minimal*", "*network*", "*alternateshell*", "*{current}*", "*{default}*")))) or ((FolderPath in ("*\reg.exe", "*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine in ("*\System\CurrentControlSet\Control\SafeBoot\Minimal\*", "*\System\CurrentControlSet\Control\SafeBoot\Network\*")) and (ProcessCommandLine in ("* delete *", "* /f*", "*Set-ItemProperty*", "*Remove-Item*", "* 0x0*", "* /d 0*"))) or (FolderPath endswith "\shutdown.exe" and (ProcessCommandLine contains " /r" and ProcessCommandLine contains " /f" and ProcessCommandLine contains " /t 0")) or (ProcessCommandLine in ("*Restart-Computer -Force*", "*ExitWindowsEx*"))) and (IntegrityLevel in ("High", "System")) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe", "*\php-cgi.exe", "*\mshta.exe", "*\rundll32.exe", "*\wmiprvse.exe", "*\psexesvc.exe")) or (FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*"))) and (not ((username in ("NT AUTHORITY\SYSTEM", "NT AUTHORITY\LOCAL SERVICE", "NT AUTHORITY\NETWORK SERVICE")) and (ParentProcessName in ("*\services.exe*", "*\svchost.exe*", "*\CcmExec.exe*", "*\TrustedInstaller.exe*", "*\Program Files\Microsoft Monitoring Agent\*")) and (ProcessCommandLine in ("*reagentc.exe*", "*SystemReset.exe*", "*ResetThisPC*", "*WindowsRecovery*"))))