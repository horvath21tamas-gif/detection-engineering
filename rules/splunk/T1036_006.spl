Image IN ("*.exe *", "*.com *", "*.scr *", "*.pif *") OR CommandLine IN ("*.exe  *", "*.exe \"*", "*.exe /*") OR Image IN ("*Windows \\*", "*System32 \\*", "*Program Files \\*", "*AppData \\*") Image IN ("*\\Users\\*", "*\\Public\\*", "*\\Temp\\*", "*\\Downloads\\*") OR NOT (Image IN ("C:\\Windows\\System32\\*", "C:\\Windows\\WinSxS\\*", "C:\\Windows\\SoftwareDistribution\\*") OR username="NT AUTHORITY\\SYSTEM" OR ParentImage="*\\msiexec.exe")
