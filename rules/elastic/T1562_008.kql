winlog.channel:System AND (((winlog.event_data.eventName:(StopLogging OR DeleteTrail OR DeleteEventBus OR DeleteDiagnosticSetting)) OR (winlog.event_data.eventName:UpdateTrail AND (winlog.event_data.requestParameters:(EnableLogFileValidation\:\ false OR KmsKeyId\:\ \"\"))) OR ((winlog.event_data.eventName:(DeleteBucket OR PutBucketLifecycleConfiguration OR PutBucketVersioning)) AND (requestParameters.bucketName:(*log* OR *audit* OR *trail* OR *telemetry*)))) AND ((userIdentity.type:Root OR (NOT _exists_:userIdentity.sessionContext.sessionIssuer.userName) OR (winlog.event_data.userAgent:(*python\-requests* OR *kali* OR *bot*))) AND (NOT ((userIdentity.arn:(*role\/Terraform\-Execution\-Policy* OR *role\/Security\-ReadOnly\-Auditor* OR *role\/OrganizationAccountAccessRole*)) AND winlog.event_data.sourceIPAddress:10.0.0.0\/8))))
