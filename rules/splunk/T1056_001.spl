(Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\rundll32.exe", "*\\regsvr32.exe", "*\\mshta.exe", "*\\cscript.exe", "*\\wscript.exe") CommandLine IN ("*SetWindowsHook*", "*GetAsyncKeyState*", "*GetKeyboardState*", "*user32.dll*")) OR CommandLine IN ("*\\AppData\\*", "*\\Temp\\*", "*\\Public\\*") NOT (Image IN ("*\\Windows\\System32\\*", "*\\Program Files\\*", "*\\Program Files (x86)\\*") OR (Image IN ("*\\AnyDesk.exe", "*\\TeamViewer.exe", "*\\tv_w32.exe", "*\\RemoteDesktopManager.exe") username="NT AUTHORITY\\SYSTEM"))
