SELECT UTF8(payload) as search_payload from events where ("Process "Process CommandLine"" ILIKE ENUMERATION('%/Library/LaunchDaemons/%','%/Library/LaunchAgents/%')) AND (""Parent Filename"" ILIKE ENUMERATION('%/bash','%/sh','%/zsh','%/python','%/curl','%/wget','%/nc') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%curl %','%wget %','%base64%','%bash -i%','%/dev/tcp/%','%chmod +x%','%/tmp/%')) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%/installd','%/pkgutil','%/Software Update','%/managedclient') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%com.apple.%','%com.microsoft.%','%com.google.%','%com.jamf.%'))
