SELECT SrcIp, Method, UriStem, UriQuery, Status, UserAgent from events where (("SrcIp" LIKE '%1.%' OR "SrcIp" LIKE '%2.%' OR "SrcIp" LIKE '%3.%' OR "SrcIp" LIKE '%4.%' OR "SrcIp" LIKE '%5.%' OR "SrcIp" LIKE '%6.%' OR "SrcIp" LIKE '%7.%' OR "SrcIp" LIKE '%8.%' OR "SrcIp" LIKE '%9.%')) AND (("UriStem" LIKE '%/api/users%' OR "UriStem" LIKE '%/api/employees%' OR "UriStem" LIKE '%/api/profiles%' OR "UriStem" LIKE '%/directory%' OR "UriStem" LIKE '%/people%' OR "UriStem" LIKE '%/staff%' OR "UriStem" LIKE '%/team%' OR "UriStem" LIKE '%/search/users%' OR "UriStem" LIKE '%/lookup%')) AND (("UriQuery" LIKE '%email=%' OR "UriQuery" LIKE '%user=%' OR "UriQuery" LIKE '%username=%' OR "UriQuery" LIKE '%name=%' OR "UriQuery" LIKE '%employee%' OR "UriQuery" LIKE '%account%')) AND "Method"='GET' AND (("UserAgent" LIKE '%curl%' OR "UserAgent" LIKE '%wget%' OR "UserAgent" LIKE '%python%' OR "UserAgent" LIKE '%requests%' OR "UserAgent" LIKE '%go-http-client%' OR "UserAgent" LIKE '%httpclient%' OR "UserAgent" LIKE '%libwww%' OR "UserAgent" LIKE '%axios%' OR "UserAgent" LIKE '%scanner%' OR "UserAgent" LIKE '%probe%')) AND (("Status" LIKE '%200%' OR "Status" LIKE '%206%')) AND NOT (("UserAgent" LIKE '%Mozilla%' OR "UserAgent" LIKE '%Chrome%' OR "UserAgent" LIKE '%Firefox%' OR "UserAgent" LIKE '%Safari%' OR "UserAgent" LIKE '%Edge%' OR "UserAgent" LIKE '%HeadlessChrome%') OR ("UserAgent" LIKE '%Googlebot%' OR "UserAgent" LIKE '%Bingbot%' OR "UserAgent" LIKE '%Slurp%' OR "UserAgent" LIKE '%DuckDuckBot%' OR "UserAgent" LIKE '%Yandex%' OR "UserAgent" LIKE '%Baiduspider%' OR "UserAgent" LIKE '%Ahrefs%' OR "UserAgent" LIKE '%Semrush%' OR "UserAgent" LIKE '%MJ12bot%') OR ("UserAgent" LIKE '%uptime%' OR "UserAgent" LIKE '%pingdom%' OR "UserAgent" LIKE '%datadog%' OR "UserAgent" LIKE '%newrelic%' OR "UserAgent" LIKE '%zabbix%' OR "UserAgent" LIKE '%prometheus%'))
