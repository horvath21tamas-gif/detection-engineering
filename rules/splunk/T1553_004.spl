Image IN ("*\\certutil.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\certmgr.exe") CommandLine IN ("* Root*", "* AuthRoot*", "* -s *") CommandLine IN ("* -f *", "* -user *", "* -enterprise *") OR CommandLine IN ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Downloads\\*", "*\\Desktop\\*", "*\\PerfLogs\\*") NOT (ParentImage IN ("C:\\Windows\\System32\\gpscript.exe*", "C:\\Windows\\System32\\svchost.exe*", "C:\\Windows\\servicing\\TrustedInstaller.exe*") username="NT AUTHORITY\\SYSTEM")
