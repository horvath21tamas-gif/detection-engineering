DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\dd.exe" and (ProcessCommandLine contains "of=\.\PhysicalDrive" and ProcessCommandLine contains "bs=512") and (ProcessCommandLine in ("*count=1*", "*if=/dev/zero*", "*if=/dev/urandom*"))) or ((ProcessCommandLine in ("*\.\PhysicalDrive*", "*\.\Harddisk*", "*\.\Volume{*")) and ((FolderPath endswith "\diskpart.exe" and (ProcessCommandLine in ("* clean*", "* clean all*"))) or (FolderPath endswith "\diskpart.exe" and (ProcessCommandLine in ("* delete partition*", "* delete volume*"))) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine contains "Clear-Disk" and ProcessCommandLine contains "-RemoveData" and ProcessCommandLine contains "-Confirm:$false")) or ((FolderPath in ("*\powershell.exe", "*\pwsh.exe")) and (ProcessCommandLine contains "Remove-Partition" and ProcessCommandLine contains "-Confirm:$false"))))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe", "*\httpd.exe", "*\mshta.exe", "*\rundll32.exe")) or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Windows\Temp\*"))) and (not (User startswith "NT AUTHORITY" and (ParentProcessName in ("*\services.exe", "*\svchost.exe", "*\vds.exe")))) and (not ((ParentProcessName in ("*\CcmExec.exe", "*\msiexec.exe", "*\setup.exe")) and (ParentProcessName in ("*\ConfigurationManager\*", "*\IntuneManagementExtension\*")))) and (not (ProcessCommandLine in ("*diskpart /s*", "*\deployment\scripts\*", "*\imaging\*")))