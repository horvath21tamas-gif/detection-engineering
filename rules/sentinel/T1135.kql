DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath matches regex "(Snaffler\\.exe|SharpShares\\.exe|PowerView\\.ps1|net\\.exe|net1\\.exe)$" and ProcessCommandLine matches regex "(view|Invoke-ShareFinder|Get-NetShare|Find-DomainShare)") and (ProcessCommandLine matches regex "( /domain| /all| -ComputerName|foreach|\\\\\\\\\\\\\\\\\\*)" or ProcessCommandLine matches regex "(password|confidential|backup|config|credentials|key)" or (ParentProcessName matches regex "(cmd\\.exe|powershell\\.exe|wsmprovhost\\.exe|httpd\\.exe|winword\\.exe)$" and IntegrityLevel =~ "Medium")) and (not (username =~ "NT AUTHORITY\SYSTEM" or FolderPath matches regex "(\\\\Program Files\\\\Tanium\\\\|\\\\Program Files\\\\Splunk\\\\|\\\\Windows\\\\System32\\\\CcmExec\\.exe)$" or ProcessCommandLine matches regex "net share"))