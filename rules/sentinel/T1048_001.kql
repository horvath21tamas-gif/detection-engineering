DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\pscp.exe", "*\psftp.exe", "*\scp.exe", "*\sftp.exe", "*\rclone.exe", "*\winscp.com")) and ((ProcessCommandLine in ("* -pw *", "* -batch*", "* -hostkey *", "* -ls *", "*copy*", "*sync*")) or ((FolderPath in ("*\Users\*", "*\AppData\*", "*\Temp\*", "*\Public\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\powershell.exe")))) and (not ((FolderPath in ("*\Program Files\*", "*\Program Files (x86)\*")) or (ProcessCommandLine in ("*127.0.0.1*", "*localhost*")) or User =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))