Image IN ("*\\sls.exe", "*\\sam.exe", "*\\func.exe", "*\\serverless.exe") OR CommandLine IN ("* deploy*", "* create-function*", "* functions deploy*", "* invoke*") OR (Image IN ("*\\terraform.exe", "*\\pulumi.exe") CommandLine IN ("*aws_lambda_function*", "*azurerm_function_app*", "*google_cloudfunctions_function*")) NOT (User IN ("*svc_jenkins*", "*svc_github_actions*", "*adm_devops_deploy*") OR Image IN ("*\\Program Files\\Terraform\\*", "*\\actions-runner\\*")) NOT (ParentImage IN ("*\\code.exe", "*\\devenv.exe", "*\\idea64.exe")) NOT (ParentImage="*\\explorer.exe" condition="not selection_serverless_tools")
