Image IN ("*\\curl.exe", "*\\wget.exe", "*\\rclone.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\scp.exe") CommandLine IN ("*chisel*", "*mimikatz*", "*ngrok*", "*socat*", "*nmap*", "*bloodhound*", "*rclone*") CommandLine IN ("* -F *", "* --upload-file *", "* s3 cp *", "* copy *", "* Invoke-RestMethod *", "* -Method Post *") CommandLine IN ("*\\Users\\Public\\*", "*\\AppData\\Local\\Temp\\*", "*\\Windows\\Temp\\*", "*\\Desktop\\*") NOT ((UserName IN ("*svc_deploy*", "*it_admin_global*", "*build_agent*") ParentImage IN ("*\\Program Files\\*", "*\\Windows\\System32\\services.exe*")) OR ParentImage IN ("*\\chrome.exe", "*\\msedge.exe"))
