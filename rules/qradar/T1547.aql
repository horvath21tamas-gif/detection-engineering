SELECT UTF8(payload) as search_payload from events where (("Filename" LIKE '%\\reg.exe%' OR "Filename" LIKE '%\\powershell.exe%' OR "Filename" LIKE '%\\cmd.exe%' OR "Filename" LIKE '%\\wscript.exe%' OR "Filename" LIKE '%\\cscript.exe%' OR "Filename" LIKE '%\\mshta.exe%' OR "Filename" LIKE '%\\schtasks.exe%')) AND (("Process CommandLine" LIKE '%\\Microsoft\\Windows\\CurrentVersion\\Run%' OR "Process CommandLine" LIKE '%\\Microsoft\\Windows\\CurrentVersion\\RunOnce%' OR "Process CommandLine" LIKE '%\\Microsoft\\Windows\\CurrentVersion\\RunService%' OR "Process CommandLine" LIKE '%\\Group Policy\\Scripts%' OR "Process CommandLine" LIKE '%\\Start Menu\\Programs\\Startup%')) AND (("Process CommandLine" LIKE '%\\AppData\\Local\\Temp\\%' OR "Process CommandLine" LIKE '%\\Users\\Public\\%' OR "Process CommandLine" LIKE '%\\ProgramData\\%' OR "Process CommandLine" LIKE '%C:\\Windows\\Temp\\%' OR "Process CommandLine" LIKE '%http%')) AND NOT (("Process CommandLine" LIKE '%\\Microsoft\\Windows\\CloudExperienceHost%' OR "Process CommandLine" LIKE '%OneDrive.exe%' OR "Process CommandLine" LIKE '%Teams.exe%' OR "Process CommandLine" LIKE '%AdobeCollabSync.exe%' OR "Process CommandLine" LIKE '%GoogleUpdate.exe%'))