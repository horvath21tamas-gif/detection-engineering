(Image:(*\/PlistBuddy OR *\/defaults OR *\/plutil)) AND ((CommandLine:(*RunAtLoad* OR *ProgramArguments* OR *StartCalendarInterval* OR *KeepAlive* OR *Label* OR *LaunchEvents*)) OR (CommandLine:(*\/LaunchAgents* OR *\/LaunchDaemons* OR *\/Preferences\/com.apple.loginitems.plist* OR *\/Library\/StartupItems*))) AND ((ParentImage:(*\/Safari.app\/* OR *\/Google\ Chrome.app\/* OR *\/Microsoft\ Word.app\/* OR *\/Terminal.app\/* OR *\/iTerm.app\/*)) OR (NOT ((Image:(\/usr\/sbin\/softwareupdate* OR \/System\/Library\/PrivateFrameworks\/*)) AND (ParentImage:(\/System\/Library\/CoreServices\/* OR \/usr\/libexec\/xpcproxy*)))))
