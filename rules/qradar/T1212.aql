SELECT username, "Filename", "Parent Filename", Process "Process CommandLine", Integrity Level, Process Path, File Hash from events where ((""Parent Filename"" ILIKE ENUMERATION('%\lsass.exe','%\logonui.exe','%\lsm.exe','%\spoolsv.exe')) AND (""Filename"" ILIKE ENUMERATION('%\cmd.exe','%\powershell.exe','%\pwsh.exe','%\net.exe','%\whoami.exe','%\nltest.exe','%\rundll32.exe','%\mimikatz.exe')) OR "Process "Process CommandLine"" ILIKE ENUMERATION('% -inject %','% -leak %','% --pipe %','%reflectiveloader%','%sekurlsa%','%lsass::memory%','%procdump%','%SharpDump%','%Invoke-Mimikatz%') OR ""Parent Filename"" ILIKE ENUMERATION('%\Users\%','%\AppData\Local\Temp\%','%\Downloads\%','%\Public\%')) AND NOT (""Filename"" ILIKE '%\WerFault.exe' AND ""Parent Filename"" ILIKE '%\lsass.exe' OR (""Filename"" ILIKE ENUMERATION('%\CrowdStrike\%','%\SentinelOne\%','%\Windows Defender\%','%\Microsoft Defender ATP\%','%\CarbonBlack\%')) AND "username" ILIKE 'NT AUTHORITY\SYSTEM%')
