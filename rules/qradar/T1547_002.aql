SELECT UTF8(payload) as search_payload from events where "Target Object" ILIKE '%\Control\Lsa\Authentication Packages' AND (NOT (("Target Details" LIKE '%msv1_0%' OR "Target Details" LIKE '%kerberos%' OR "Target Details" LIKE '%tspkg%' OR "Target Details" LIKE '%pku2u%' OR "Target Details" LIKE '%livessp%' OR "Target Details" LIKE '%cloudap%' OR "Target Details" LIKE '%wdigest%' OR "Target Details" LIKE '%negotiate%')) OR ("Target Details" LIKE '%:\\Users\\%' OR "Target Details" LIKE '%:\\ProgramData\\%' OR "Target Details" LIKE '%:\\Temp\\%' OR "Target Details" LIKE '%:\\Windows\\Temp\\%' OR "Target Details" LIKE '%.ps1%' OR "Target Details" LIKE '%.exe%')) AND NOT (""Filename"" ILIKE ENUMERATION('%\C:\Windows\servicing\TrustedInstaller.exe','%\System32\msiexec.exe'))
