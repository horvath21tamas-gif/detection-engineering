DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*VBAWarnings*", "*AccessVBOM*", "*ExtensionHardness*", "*TrustRecords*")) or ((FolderPath in ("*\scrcons.exe", "*\wscript.exe", "*\cscript.exe", "*\mshta.exe")) or (ProcessCommandLine in ("*ExecuteExcel4Macro*", "*VBAProject.bin*")))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe")) or (not (username =~ "NT AUTHORITY\SYSTEM" or (ParentProcessName in ("*\Windows\System32\svchost.exe*", "*\Windows\CCM\CcmExec.exe*")) or (ProcessCommandLine in ("*\Program Files\*", "*\Program Files (x86)\*")))))