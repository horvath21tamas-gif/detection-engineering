Image IN ("*\\adfind.exe", "*\\net.exe", "*\\net1.exe", "*\\dsquery.exe", "*\\SharpHound.exe") CommandLine IN ("*Get-DomainGroup*", "*Get-ADGroup*", "*search -filter*") CommandLine IN ("*Domain Admins*", "*Enterprise Admins*", "*Schema Admins*", "*Remote Desktop Users*", "* /domain*") OR CommandLine IN ("*ConvertTo-Json*", "* -Properties *", "* -CSV *", "* > *") OR (ParentImage IN ("*\\wsmprovhost.exe", "*\\httpd.exe", "*\\winword.exe") IntegrityLevel="Medium") NOT (User="NT AUTHORITY\\*" OR ComputerName="*DC-*" OR ParentImage IN ("*\\Program Files\\Tanium\\*", "*\\Windows\\System32\\CcmExec.exe*") OR CommandLine="*Get-ADGroupMember -Identity*")
