Image IN ("*\\hh.exe", "*\\winhlp32.exe", "*\\extracticon.exe", "*\\rc.exe") CommandLine IN ("*-decompile*", "*its:*", "*ms-its:*", "*mk:@MSITStore:*", "*javascript:*", "*vbscript:*") OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\mshta.exe", "*\\powershell.exe") OR (CommandLine IN ("*\\Users\\Public\\*", "*\\Downloads\\*", "*\\Temp\\*", "*\\AppData\\*") NOT (ParentImage IN ("*\\Program Files\\*", "*\\Program Files (x86)\\*", "*\\Windows\\System32\\svchost.exe*") OR CommandLine="*ms-help://*")) | table Time,SourceImage,ParentImage,CommandLine,SourceUsername
