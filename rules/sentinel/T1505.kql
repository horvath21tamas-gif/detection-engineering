DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (ParentProcessName in ("*\w3wp.exe", "*\httpd.exe", "*\nginx.exe", "*\php-cgi.exe", "*\tomcat.exe", "*\java.exe")) and (FolderPath in ("*\cmd.exe", "*\powershell.exe", "*\pwsh.exe", "*\sh.exe", "*\bash.exe", "*\whoami.exe", "*\net.exe", "*\net1.exe", "*\ipconfig.exe", "*\certutil.exe", "*\bitsadmin.exe", "*\systeminfo.exe", "*\nltest.exe", "*\netstat.exe", "*\curl.exe", "*\wget.exe", "*\rundll32.exe", "*\cscript.exe", "*\wscript.exe")) and (not (((FolderPath in ("*\csc.exe", "*\cvtres.exe")) and (ProcessCommandLine in ("*\Windows\Microsoft.NET\Framework*", "*\Temporary ASP.NET Files\*"))) or ((ProcessCommandLine in ("*appcmd.exe list config*", "*iisreset.exe*")) and username =~ "NT AUTHORITY\SYSTEM") or ((ParentProcessName in ("*\Jenkins\*", "*\GitLab-Runner\*", "*\Terraform\*", "*\Ansible\*")) and username =~ "NT AUTHORITY\SYSTEM")))