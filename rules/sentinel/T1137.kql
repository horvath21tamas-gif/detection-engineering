DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where TargetObject matches regex "\\\\Software\\\\Microsoft\\\\Office\\\\.*\\\\(Addins\\\\LoadBehavior|Options\\\\OPEN|Outlook\\\\WebView\\\\URL|Security\\\\Trusted Documents\\\\TrustRecords)$" and (Details matches regex "(\\\\AppData\\\\Local\\\\Temp\\\\|C:\\\\Users\\\\Public\\\\|\\\\Downloads\\\\|http)" or FolderPath matches regex "(powershell\\.exe|cmd\\.exe|wscript\\.exe|cscript\\.exe|reg\\.exe|bitsadmin\\.exe)$") and (not (FolderPath matches regex "(msiexec\\.exe|setup\\.exe|OfficeClickToRun\\.exe)$" and Details matches regex "(C:\\\\Program Files\\\\|C:\\\\Program Files \\(x86\\)\\\\)"))