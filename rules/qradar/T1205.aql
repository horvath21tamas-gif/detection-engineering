SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE '%\netsh.exe' AND "ImageName"='netsh.exe' AND "Process "Process CommandLine"" ILIKE '%advfirewall firewall add rule%' AND "Process "Process CommandLine"" ILIKE '%action=allow%' AND "Process "Process CommandLine"" ILIKE '%protocol=UDP%' AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%protocol=ICMP%','%localport=any%','%remoteport=any%')) OR (""Filename"" ILIKE ENUMERATION('%\tcpdump.exe','%\windump.exe','%\scapy.exe','%\nmap.exe','%\hping.exe')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('% -i %','%sniffer%','%npcap%','%winpcap%'))) AND (""Parent Filename"" ILIKE ENUMERATION('%\powershell.exe','%\pwsh.exe','%\cmd.exe','%\wscript.exe','%\cscript.exe')) AND (""Filename"" ILIKE ENUMERATION('%\Users\%','%\Temp\%','%\Downloads\%','%\AppData\%','%\ProgramData\%')) AND NOT ("username" ILIKE 'NT AUTHORITY\%' AND (""Filename"" ILIKE ENUMERATION('%\Windows\System32\svchost.exe%','%\Program Files\Windows Defender\%','%\Program Files\CrowdStrike\%','%\Program Files\SentinelOne\%')) AND "Process "Process CommandLine"" ILIKE '%description=%')
