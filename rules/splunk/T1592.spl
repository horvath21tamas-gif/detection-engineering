Image IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wmic.exe") CommandLine IN ("*systeminfo*", "*hostname*", "*whoami*", "*wmic os*", "*wmic computersystem*", "*wmic bios*", "*Get-ComputerInfo*", "*Get-CimInstance*", "*Get-WmiObject*", "*ver*", "*echo %PROCESSOR_ARCHITECTURE%*") CommandLine IN ("*&*", "*&&*", "*;*", "*|*") ParentImage IN ("*\\explorer.exe", "*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\wscript.exe", "*\\cscript.exe") NOT (User IN ("*SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*") OR Image IN ("*\\Windows\\CCM\\*", "*\\SCCM\\*", "*\\PDQ\\*", "*\\Ivanti\\*", "*\\ManageEngine\\*", "*\\TanService\\*", "*\\CarbonBlack\\*", "*\\CrowdStrike\\*", "*\\Defender\\*")) | table User,Image,ParentImage,CommandLine,Hostname
