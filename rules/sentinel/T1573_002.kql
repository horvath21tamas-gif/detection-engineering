DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((ProcessCommandLine in ("*ServerCertificateValidationCallback*", "*return $true*", "*ServicePointManager]::Expect100Continue*", "*SecurityProtocolType]::Tls12*")) or (ProcessCommandLine in ("*RSACryptoServiceProvider*", "*FromXmlString*", "*ImportSubjectPublicKeyInfo*", "*X509Certificate2*"))) and (FolderPath in ("*\powershell.exe", "*\pwsh.exe", "*\wscript.exe", "*\cscript.exe", "*\rundll32.exe", "*\regsvr32.exe")) and (not ((ProcessCommandLine in ("*C:\Program Files\*", "*Microsoft\Azure*", "*HealthCheck*")) or username =~ "NT AUTHORITY\SYSTEM" or ParentProcessName endswith "\services.exe"))