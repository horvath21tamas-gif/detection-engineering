Image IN ("*\\reg.exe", "*\\wmic.exe") OR CommandLine IN ("*Get-Culture*", "*Get-WinSystemLocale*", "*Get-KeyboardLayout*", "*os get MUILanguages*") OR CommandLine IN ("*Keyboard Layout\\Preload*", "*Control Panel\\International*", "*00000419*", "*00000422*", "*00000423*") (ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\wsmprovhost.exe", "*\\httpd.exe", "*\\powershell.exe") IntegrityLevel="Medium") OR CommandLine IN ("*findstr*", "*select-string*", "* > *", "*ConvertTo-Json*") NOT (username="NT AUTHORITY\\SYSTEM" OR ParentImage IN ("*\\msiexec.exe", "*\\CcmExec.exe", "*\\svchost.exe") OR CommandLine="*Program Files*")
