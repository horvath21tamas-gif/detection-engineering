DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where (FolderPath in ("*\wscript.exe", "*\cscript.exe", "*\powershell.exe", "*\pwsh.exe", "*\regsvr32.exe", "*\mshta.exe", "*\rundll32.exe")) and (ProcessCommandLine in ("*.jpg*", "*.jpeg*", "*.png*", "*.gif*", "*.txt*", "*.log*", "*.pdf*", "*.doc*", "*.docx*", "*.xls*", "*.xlsx*", "*.ppt*", "*.pptx*", "*.tmp*", "*.ini*", "*.dat*", "*.cfg*")) and ((ProcessCommandLine in ("*\Users\*", "*\Downloads\*", "*\Temp\*", "*\Windows\Temp\*", "*\ProgramData\*")) or (ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\powerpnt.exe", "*\outlook.exe", "*\chrome.exe", "*\msedge.exe", "*\firefox.exe", "*\winrar.exe", "*\7zFM.exe", "*\explorer.exe"))) and (not (((username in ("NT AUTHORITY\SYSTEM", "NT AUTHORITY\LOCAL SERVICE", "NT AUTHORITY\NETWORK SERVICE")) and ParentProcessName endswith "\services.exe") or (ParentProcessName in ("*\msiexec.exe", "*\trustedinstaller.exe")) or (ProcessCommandLine in ("*C:\Windows\ccmcache\*", "*healthcheck.txt*", "*Telemetry*"))))