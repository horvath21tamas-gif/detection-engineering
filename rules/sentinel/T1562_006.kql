DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath endswith "\logman.exe" and ProcessCommandLine contains "stop" and (ProcessCommandLine in ("*EventLog-System*", "*EventLog-Security*", "*Microsoft-Windows-DotNETRuntime*", "*Microsoft-Windows-Web-Http*", "*NT Kernel Logger*", "*Circular Kernel Context Logger*"))) or (FolderPath endswith "\logman.exe" and ProcessCommandLine contains "delete" and (ProcessCommandLine in ("*EventLog*", "*Kernel*"))) or (FolderPath endswith "\wecutil.exe" and ProcessCommandLine contains " /e:false") or (FolderPath endswith "\wecutil.exe" and ProcessCommandLine contains " ds ") or ((FolderPath in ("*\netsh.exe", "*\powershell.exe")) and (ProcessCommandLine contains "firewall" and ProcessCommandLine contains "add rule" and ProcessCommandLine contains "block" and ProcessCommandLine contains "remoteport=443") and (ProcessCommandLine in ("*remoteip=*", "*security*", "*defender*", "*crowdstrike*", "*sentinel*", "*carbonblack*", "*edr*", "*telemetry*")))) and ((ParentProcessName in ("*\winword.exe", "*\excel.exe", "*\outlook.exe", "*\w3wp.exe", "*\powershell.exe", "*\cmd.exe", "*\rundll32.exe")) or (not ((ProcessCommandLine in ("*Microsoft Monitoring Agent*", "*SplunkUniversalForwarder*", "*AzureMonitorAgent*", "*Elastic Agent*", "*Docker*")) or (User startswith "NT AUTHORITY" and ParentProcessName endswith "\services.exe"))))