(ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\chrome.exe", "*\\msedge.exe", "*\\acrord32.exe") Image IN ("*\\csc.exe", "*\\msbuild.exe", "*\\installutil.exe", "*\\regsvcs.exe", "*\\regasm.exe", "*\\cvtres.exe")) OR (CommandLine IN ("*NtCreateSection*", "*NtMapViewOfSection*", "*NtWriteVirtualMemory*", "*NtQueueApcThread*", "*ZwMapViewOfSection*") NOT (ParentImage IN ("*Microsoft Visual Studio*", "*Windows\\Microsoft.NET\\Framework*") OR CommandLine="*Microsoft.Workflow.Compiler*"))
