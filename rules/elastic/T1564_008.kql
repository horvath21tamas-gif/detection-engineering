(process.command_line:(*New\-InboxRule* OR *Set\-InboxRule* OR *Set\-MailboxForwardingConfiguration*)) AND (((process.command_line:(*DeleteMessage* OR *PermanentDelete* OR *MarkAsRead* OR *MoveToFolder*)) AND (process.command_line:(*Security* OR *Alert* OR *Password* OR *MFA* OR *Sign\-in* OR *Phish* OR *Compromise* OR *Unauthorized*))) OR (process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\outlook.exe OR *\\msedge.exe OR *\\chrome.exe OR *\\mshta.exe))) AND (NOT (winlog.event_data.username:NT\ AUTHORITY\\SYSTEM OR (process.command_line:(*Spam* OR *Junk* OR *Internal\-Auto\-Forward*)) OR process.parent.executable:*\\Windows\\System32\\svchost.exe*))
