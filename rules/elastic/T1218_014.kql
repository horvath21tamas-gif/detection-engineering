(process.executable:*\\mmc.exe OR process.pe.original_file_name:mmc.exe) AND ((process.parent.executable:(*\\winword.exe OR *\\excel.exe OR *\\powerpnt.exe OR *\\outlook.exe OR *\\chrome.exe OR *\\msedge.exe OR *\\powershell.exe OR *\\cmd.exe OR *\\wscript.exe OR *\\cscript.exe)) OR (process.command_line:(*\\Users\\* OR *\\AppData\\* OR *\\Temp\\* OR *\\Public\\* OR *\\Downloads\\* OR *\\* OR *http*))) AND (NOT (process.parent.executable:*\\explorer.exe AND process.command_line:*C\:\\Windows\\System32\\* AND user.name:*Admin*))
