SELECT UTF8(payload) as search_payload from events where (""Filename"" ILIKE ENUMERATION('%\WindowsSandbox.exe','%\wsl.exe','%\wslhost.exe','%\vmcompute.exe')) AND (""Parent Filename"" ILIKE ENUMERATION('%\winword.exe','%\excel.exe','%\outlook.exe','%\chrome.exe','%\msedge.exe','%\mshta.exe','%\sqlservr.exe') OR ("Process "Process CommandLine"" ILIKE ENUMERATION('%.wsb%','%--exec%','% -e %','%--mount%','%HostFolder%','%LogonCommand%')) AND ("Process "Process CommandLine"" ILIKE ENUMERATION('%\Users\%','%\Downloads\%','%\Temp\%','%\AppData\%'))) AND NOT (""Parent Filename"" ILIKE ENUMERATION('%\Common7\IDE\devenv.exe%','%\bin\code.exe%','%\Program Files\Docker\%') OR "Process "Process CommandLine"" ILIKE ENUMERATION('%docker-desktop%','%Microsoft.WSL%'))
