DeviceProcessEvents
| where TimeGenerated > ago(24h)
union *
| where ((FolderPath in ("*\gpresult.exe", "*\Get-GPO.exe", "*\powershell.exe")) and (ProcessCommandLine in ("*Get-DomainGPO*", "*Get-NetGPO*", "*SharpGPOAbuse*", "*Find-GPO*", "*Get-GPOReport*", "*Import-Module GroupPolicy*"))) and ((ProcessCommandLine in ("* /h *", "* /x *", "* /z *", "*ConvertTo-Json*", "*Export-Csv*", "*Export-Clixml*", "* > *", "*| Out-File*")) or ((ParentProcessName in ("*\wsmprovhost.exe", "*\httpd.exe", "*\winword.exe", "*\excel.exe")) and IntegrityLevel =~ "Medium") or (FolderPath in ("*\AppData\Local\Temp\*", "*\Users\Public\*", "*\Temp\*"))) and (not ((ProcessCommandLine in ("* /r*", "*/Scope*", "*/SCCM*")) and username =~ "NT AUTHORITY\SYSTEM" and (ParentProcessName in ("*\CcmExec.exe*", "*\IntuneManagementExtension\*"))))