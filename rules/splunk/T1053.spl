Image IN ("*\\schtasks.exe", "*\\at.exe", "*\\powershell.exe", "*\\cmd.exe") CommandLine IN ("*schtasks*", "*/create*", "*/sc*", "*Register-ScheduledTask*", "*New-ScheduledTask*", "*at *") CommandLine IN ("*\\AppData\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*powershell*", "*cmd.exe*", "*wscript*", "*cscript*", "*mshta*", "*rundll32*", "*.ps1*", "*.vbs*", "*.js*") NOT (User IN ("*SYSTEM*", "*LOCAL SERVICE*", "*NETWORK SERVICE*") OR CommandLine IN ("*\\Microsoft\\Windows\\*", "*Windows Defender*", "*OneDrive*", "*GoogleUpdate*", "*Adobe*"))
