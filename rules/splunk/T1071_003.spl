Image IN ("*\\notepad.exe", "*\\calc.exe", "*\\mspaint.exe", "*\\winver.exe", "*\\spoolsv.exe", "*\\colorcpl.exe", "*\\scrcons.exe") OR (Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\cscript.exe", "*\\wscript.exe", "*\\rundll32.exe") CommandLine IN ("*Send-MailMessage*", "*Net.Mail.SmtpClient*", "*System.Net.Mail*", "*.Credentials*")) OR ParentImage IN ("*\\winword.exe", "*\\excel.exe", "*\\outlook.exe", "*\\w3wp.exe") DestinationPort IN (25, 465, 587, 993, 995) NOT (Image IN ("*\\outlook.exe", "*\\thunderbird.exe", "*\\msedgewebview2.exe") OR DestinationIP IN ("10.0.0.0/8", "192.168.0.0/16") OR username="NT AUTHORITY\\SYSTEM")
