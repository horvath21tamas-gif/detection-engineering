(Image="*\\vaultcmd.exe" CommandLine IN ("* /list*", "* /show*") CommandLine IN ("* > *", "* >> *", "* | *", "*clip*")) OR CommandLine IN ("*VaultEnumerateItems*", "*VaultGetItem*", "*Windows.Security.Credentials.PasswordVault*", "*Get-VaultCredential*") Image IN ("*\\Users\\*", "*\\AppData\\*", "*\\Temp\\*", "*\\Downloads\\*") Image IN ("*\\powershell.exe", "*\\pwsh.exe", "*\\python.exe", "*\\cscript.exe", "*\\wscript.exe") NOT (ParentImage IN ("*\\chrome.exe", "*\\msedge.exe", "*\\firefox.exe") OR (ParentImage IN ("*\\services.exe", "*\\msiexec.exe", "*\\TrustedInstaller.exe") username="NT AUTHORITY\\SYSTEM"))
