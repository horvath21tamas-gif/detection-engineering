(process.command_line:(*\ \-querytype\ TXT* OR *\ \-q\ TXT* OR *Resolve\-DnsName* OR *\ \-Type\ TXT* OR *\ \-Type\ SRV* OR *\ \-querytype\ SRV*)) AND (process.command_line:(*\[Convert\]\:\:* OR *\ \-bxor* OR *.Substring\(* OR *.Split\(* OR *\ \[int\]* OR *\ \[byte\]* OR *.ToCharArray\(*)) AND (process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe OR *\\cscript.exe OR *\\rundll32.exe OR *\\mshta.exe)) AND (NOT ((process.command_line:(*_vlmcs._tcp* OR *chocolatey* OR *domain\-verification* OR *letsencrypt* OR *acme\-challenge*)) OR winlog.event_data.username:"NT AUTHORITY\\SYSTEM" OR (process.parent.executable.caseless:(*\\services.exe OR *\\explorer.exe))))
