SELECT UTF8(payload) as search_payload from events where (("operation_name" LIKE '%RunInstances%' OR "operation_name" LIKE '%Microsoft.Compute/virtualMachines/write%' OR "operation_name" LIKE '%v1.compute.instances.insert%')) AND (("request_parameters" LIKE '%p3.%' OR "request_parameters" LIKE '%p4.%' OR "request_parameters" LIKE '%g4.%' OR "request_parameters" LIKE '%c5.24xlarge%' OR "request_parameters" LIKE '%Standard_ND%' OR "request_parameters" LIKE '%Standard_NC%' OR "request_parameters" LIKE '%n1-highcpu-%') OR "mfa_authenticated"='false' AND (("user_agent" LIKE '%kali%' OR "user_agent" LIKE '%python-requests%' OR "user_agent" LIKE '%boto3%' OR "user_agent" LIKE '%postman%'))) AND NOT (("user_name" LIKE '%svc-terraform%' OR "user_name" LIKE '%svc-github-actions%' OR "user_name" LIKE '%aws-autoscaling%') OR "user_name" ILIKE '%system-internal%')
